commands from package.json, env var conventions, common task cookbook\n4. Tested by scaffolding a greenfield project and confirming Claude Code navigates it without clarifying questions","createdAt":"2026-03-28T20:42:39Z","includesCreatedEdit":false,"isMinimized":false,"minimizedReason":"","reactionGroups":[],"url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/2#issuecomment-4148779593","viewerDidAuthor":false},{"id":"IC_kwDORx6c0M73S6p7","author":{"login":"sungdark"},"authorAssociation":"NONE","body":"/opire try","createdAt":"2026-03-28T22:30:14Z","includesCreatedEdit":false,"isMinimized":false,"minimizedReason":"","reactionGroups":[],"url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/2#issuecomment-4148931195","viewerDidAuthor":false},{"id":"IC_kwDORx6c0M73S9oQ","author":{"login":"sungdark"},"authorAssociation":"NONE","body":"我来认领！\n\n收款地址：eB51DWp1uECrLZRLsE2cnyZUzfRWvzUzaJzkatTpQV9","createdAt":"2026-03-28T22:39:38Z","includesCreatedEdit":false,"isMinimized":false,"minimizedReason":"","reactionGroups":[],"url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/2#issuecomment-4148943376","viewerDidAuthor":false},{"id":"IC_kwDORx6c0M73TKUP","author":{"login":"alexbthundiyil-spec"},"authorAssociation":"NONE","body":"/opire try","createdAt":"2026-03-28T23:16:49Z","includesCreatedEdit":false,"isMinimized":false,"minimizedReason":"","reactionGroups":[],"url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/2#issuecomment-4148995343","viewerDidAuthor":false},{"id":"IC_kwDORx6c0M73UcGn","author":{"login":"zicaiw625"},"authorAssociation":"NONE","body":"/opire try\nWallet: 0xdC92109cD9cCa556ba090a482E1cae99A066eaC4","createdAt":"2026-03-29T03:24:15Z","includesCreatedEdit":false,"isMinimized":false,"minimizedReason":"","reactionGroups":[],"url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/2#issuecomment-4149330343","viewerDidAuthor":false},{"id":"