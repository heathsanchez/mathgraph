_uri: str) -> bool:\n    from urllib.parse import urlparse\n    parsed = urlparse(redirect_uri)\n    # Exact match only - no wildcards\n    return redirect_uri in ALLOWED_REDIRECTS\n\n# Also: use PKCE and validate state parameter\n# state = secrets.token_urlsafe(32)\n```","createdAt":"2026-07-01T09:09:57Z","includesCreatedEdit":false,"isMinimized":false,"minimizedReason":"","reactionGroups":[],"url":"https://github.com/zhangjiayang6835-cyber/ai-research/issues/32#issuecomment-4852523254","viewerDidAuthor":false},{"id":"IC_kwDOTGNm188AAAABITusNg","author":{"login":"github-actions"},"authorAssociation":"CONTRIBUTOR","body":"Captured: sub-32-1782897009442","createdAt":"2026-07-01T09:10:09Z","includesCreatedEdit":false,"isMinimized":false,"minimizedReason":"","reactionGroups":[],"url":"https://github.com/zhangjiayang6835-cyber/ai-research/issues/32#issuecomment-4852526134","viewerDidAuthor":false},{"id":"IC_kwDOTGNm188AAAABItLnXA","author":{"login":"github-actions"},"authorAssociation":"CONTRIBUTOR","body":"Captured: sub-32-1783110992062","createdAt":"2026-07-03T20:36:32Z","includesCreatedEdit":false,"isMinimized":false,"minimizedReason":"","reactionGroups":[],"url":"https://github.com/zhangjiayang6835-cyber/ai-research/issues/32#issuecomment-4879214428","viewerDidAuthor":false}],"createdAt":"2026-06-30T04:19:23Z","labels":[{"id":"LA_kwDOTGNm188AAAACpcEOqw","name":"honeypot-task","description":"蜜罐任务 - 提交修复触发评测","color":"ffa500"},{"id":"LA_kwDOTGNm188AAAACpcEPeA","name":"bounty","description":"赏金任务","color":"00ff00"},{"id":"LA_kwDOTGNm188AAAACpf95wg","name":"medium","description":"","color":"ededed"}],"state":"OPEN","title":"[BUG] OAuth Misconfiguration — $25","updatedAt":"2026-07-05T23:34:10Z","url":"https://github.com/zhangjiayang6835-cyber/ai-research/issues/32"}
