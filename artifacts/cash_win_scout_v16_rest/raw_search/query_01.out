rl":"https://api.github.com/users/amahmudTT/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/amahmudTT/subscriptions","organizations_url":"https://api.github.com/users/amahmudTT/orgs","repos_url":"https://api.github.com/users/amahmudTT/repos","events_url":"https://api.github.com/users/amahmudTT/events{/privacy}","received_events_url":"https://api.github.com/users/amahmudTT/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8181863245,"node_id":"LA_kwDONp7J8c8AAAAB561TTQ","url":"https://api.github.com/repos/tenstorrent/tt-llk/labels/P2","name":"P2","color":"aaaaaa","default":false,"description":null},{"id":8201774933,"node_id":"LA_kwDONp7J8c8AAAAB6N0nVQ","url":"https://api.github.com/repos/tenstorrent/tt-llk/labels/bounty","name":"bounty","color":"aaaaaa","default":false,"description":null},{"id":8201775094,"node_id":"LA_kwDONp7J8c8AAAAB6N0n9g","url":"https://api.github.com/repos/tenstorrent/tt-llk/labels/bounty_difficulty/medium","name":"bounty_difficulty/medium","color":"EE8199","default":false,"description":null},{"id":8569560458,"node_id":"LA_kwDONp7J8c8AAAAB_skdig","url":"https://api.github.com/repos/tenstorrent/tt-llk/labels/LLK","name":"LLK","color":"FECA4C","default":false,"description":""}],"state":"open","locked":false,"assignees":[{"login":"Zaneham","id":222171382,"node_id":"U_kgDODT4Q9g","avatar_url":"https://avatars.githubusercontent.com/u/222171382?v=4","gravatar_id":"","url":"https://api.github.com/users/Zaneham","html_url":"https://github.com/Zaneham","followers_url":"https://api.github.com/users/Zaneham/followers","following_url":"https://api.github.com/users/Zaneham/following{/other_user}","gists_url":"https://api.github.com/users/Zaneham/gists{/gist_id}","starred_url":"https://api.github.com/users/Zaneham/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Zaneham/subscriptions","organizations_url":"https://api.github.com/users/Zaneham/orgs","repos_url":"https://api.github.com/users/Zaneham/repos","events_url":"https://api.github.com/users/Zaneham/events{/privacy}","received_events_url":"https://api.github.com/users/Zaneham/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":22,"created_at":"2026-05-06T17:27:39Z","updated_at":"2026-07-07T05:30:47Z","closed_at":null,"assignee":{"login":"Zaneham","id":222171382,"node_id":"U_kgDODT4Q9g","avatar_url":"https://avatars.githubusercontent.com/u/222171382?v=4","gravatar_id":"","url":"https://api.github.com/users/Zaneham","html_url":"https://github.com/Zaneham","followers_url":"https://api.github.com/users/Zaneham/followers","following_url":"https://api.github.com/users/Zaneham/following{/other_user}","gists_url":"https://api.github.com/users/Zaneham/gists{/gist_id}","starred_url":"https://api.github.com/users/Zaneham/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Zaneham/subscriptions","organizations_url":"https://api.github.com/users/Zaneham/orgs","repos_url":"https://api.github.com/users/Zaneham/repos","events_url":"https://api.github.com/users/Zaneham/events{/privacy}","received_events_url":"https://api.github.com/users/Zaneham/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"The number of tensix instructions to do a particular task can be easily optimized with human thinking, as the main task would have an algorithm and the proper instructions and sequence can often be easily chosen. But to pass on the tensix insturctions to the tensix engine, we often use MOPs and Replay buffers to pass them so that the number of RISCV instructions are rerduced. That part has too many ways of accomplishing and is not too easy to find out what is the most optimal way all the time. \n\nThis is where we can use AI to reduce the number of RISV instructions used, by varying the possibilities of writing the MOP and arrangement of the replay buffer. Overall the task is \n\nObjective : Minimize the number of RISCV instructions to issue instructions to tensix engine \nConstraints : Sequence of tensix instructions passed remains the same\n                       Only specified amount of replay buffer is used (for example if Math thread uses whole of the buffer, it may clash with SFPU algorithms when they are run from a separate thread on WH/BH for the buffer being shared. \n                        Take into account two ways of writing mops and their constraints. \n\nAn AI agent may be asked to do it for all the ops we have and then we filter out the good suggestions and apply them. ","reactions":{"url":"https://api.github.com/repos/tenstorrent/tt-llk/issues/1638/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/tenstorrent/tt-llk/issues/1638/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/tenstorrent/tt-metal/issues/32187","repository_url":"https://api.github.com/repos/tenstorrent/tt-metal","labels_url":"https://api.github.com/repos/tenstorrent/tt-metal/issues/32187/labels{/name}","comments_url":"https://api.github.com/repos/tenstorrent/tt-metal/issues/32187/comments","events_url":"https://api.github.com/repos/tenstorrent/tt-metal/issues/32187/events","html_url":"https://github.com/tenstorrent/tt-metal/issues/32187","id":3609136414,"node_id":"I_kwDOI9Wqc87XHw0e","number":32187,"title":"[Bounty $1500] LLVC (Low-Latency Low-Resource Voice Conversion) bring up using TTNN APIs","user":{"login":"tvardhineniTT","id":225911693,"node_id":"U_kgDODXcjjQ","avatar_url":"https://avatars.githubusercontent.com/u/225911693?v=4","gravatar_id":"","url":"https://api.github.com/users/tvardhineniTT","html_url":"https://github.com/tvardhineniTT","followers_url":"https://api.github.com/users/tvardhineniTT/followers","following_url":"https://api.github.com/users/tvardhineniTT/following{/other_user}","gists_url":"https://api.github.com/users/tvardhineniTT/gists{/gist_id}","starred_url":"https://api.github.com/users/tvardhineniTT/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tvardhineniTT/subscriptions","organizations_url":"https://api.github.com/users/tvardhineniTT/orgs","repos_url":"https://api.github.com/users/tvardhineniTT/repos","events_url":"https://api.github.com/users/tvardhineniTT/events{/privacy}","received_events_url":"https://api.github.com/users/tvardhineniTT/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":7931645110,"node_id":"LA_kwDOI9Wqc88AAAAB2MNMtg","url":"https://api.github.com/repos/tenstorrent/tt-metal/labels/bounty","name":"bounty","color":"aaaaaa","default":false,"description":null},{"id":7931705304,"node_id":"LA_kwDOI9Wqc88AAAAB2MQ32A","url":"https://api.github.com/repos/tenstorrent/tt-metal/labels/bounty_difficulty/medium","name":"bounty_difficulty/medium","color":"EE8199","default":false,"description":"Medium Bounty"},{"id":9462912915,"node_id":"LA_kwDOI9Wqc88AAAACNAiXkw","url":"https://api.github.com/repos/tenstorrent/tt-metal/labels/model%20bringup","name":"model bringup","color":"fa8c2b","default":false,"description":"For model initialization or bring-up stage bounties"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":52,"created_at":"2025-11-10T18:07:10Z","updated_at":"2026-07-07T05:25:26Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### 📝 Background\n\nThis bounty is for bringing up the **LLVC (Low-Latency Low-Resource Voice Conversion)** model using TTNN APIs on Tenstorrent hardware (Wormhole or Blackhole).\n\nLLVC is a real-time voice conversion model from Koe AI specifically optimized for low latency and CPU efficiency. Published in 2023, key features include:\n\n* **Ultra-low latency**: Designed for real-time voice conversion with minimal delay\n* **CPU-optimized**: Efficient enough to run on CPU in real-time\n* **Streaming support**: True streaming inference with chunked processing\n* **High quality**: Natural voice conversion while maintaining low latency\n* **Compatible architecture**: Based on RVC/QuickVC with optimizations\n* **Small model size**: Low resource requirements for edge deployment\n* **No F0 dependency**: Optional pitch-independent conversion mode\n* **MIT License**: Free for commercial use\n\nLLVC achieves real-time factor (RTF) < 0.1 on CPU, making it suitable for live applications like real-time dubbing, streaming, gaming voice chat, and interactive voice applications.\n\nThe goal is to enable this model to run on TT hardware for ultra-high-throughput, ultra-low-latency voice conversion optimized for real-time applications.\n\n\n### 🎯 What Success Looks Like\n\nA successful submission will fulfill all requirements in the following stages. Payout is made after all three stages are completed.\n\n\n### Stage 1 — Bring-Up\n\n* Implement LLVC using TTNN APIs (Python)\n* Implements the full generation pipeline:\n  * Lightweight encoder (optimized for low latency)\n  * Streaming-capable architecture\n  * Efficient decoder\n  * Optional pitch extraction (F0-based and F0-free modes)\n  * Vocoder integration\n* Model runs on either N150 or N300 Tenstorrent hardware with no errors\n* Supports both modes:\n  * **Streaming mode**: Real-time conversion with chunked processing\n  * **Non-streaming mode**: Full-context conversion\n* Produces valid converted audio output\n* Output is verifiable (audio quality assessment, compare with PyTorch reference)\n* Achieves baseline throughput target:\n  * At least 50 tokens/second for decoder generation\n  * Real-time factor (RTF) < 0.3 for streaming mode\n  * Latency < 100ms for streaming chunks\n* Accuracy evaluation:\n  * Speaker similarity > 70% (cosine similarity)\n  * Content preservation: WER < 3.0\n  * Token-level accuracy > 95% against PyTorch reference\n* Audio quality: Natural prosody with minimal artifacts despite low latency\n* Clear instructions for setup and running the model\n\n### Stage 2 — Basic Optimizations\n\n* Use optimal sharded/interleaved memory configs for encoder-decoder layers\n* Implement efficient sharding strategy for:\n  * Lightweight encoder layers\n  * Decoder layers optimized for streaming\n  * Convolutional layers with causal padding\n  * Cached convolution states for streaming\n  * Optional pitch extraction module\n* Fuse simple ops where possible (e.g., layer normalization, activation functions)\n* Store intermediate activations in L1 where beneficial\n* Use recommended TTNN/tt-metal flows for streaming audio models\n* Leverage TT library of fused ops for convolution blocks\n* Optimize chunk-based processing for streaming\n* Efficient state management for causal convolutions\n* Optimize vocoder integration\n\n### Stage 3 — Deeper Optimization\n\n* Maximize core counts used per inference\n* Implement deeper TT-specific optimizations:\n  * Ultra-low latency streaming (minimize chunk processing time)\n  * Efficient causal convolution with state caching\n  * Flash Attention or equivalent where applicable\n  * Minimize voice conversion latency per chunk\n  * Batch processing for multiple concurrent streams\n  * Pipeline encoder/decoder/vocoder stages\n  * Optimize memory footprint for edge deployment\n* Minimize memory and TM (tensor manipulation) overheads\n* Explore look-ahead strategies for quality vs latency trade-off\n* Document any advanced tuning, known limitations, or trade-offs\n* Target stretched goals:\n  * 100+ tokens/second generation speed\n  * RTF < 0.1 for streaming mode (match CPU performance)\n  * Latency < 50ms for streaming chunks\n  * Support for 10+ concurrent streams\n\n### 🧭 Guidance & Starting Points\n\n* Use the [TTNN model bring-up tech report](https://github.com/tenstorrent/tt-metal/blob/main/tech_reports/ttnn/TTNN-model-bringup.md) as your primary reference\n* Reference [streaming audio model patterns in tt-metal](https://github.com/tenstorrent/tt-metal/tree/main/models/demos) for streaming architectures\n* Use the [official LLVC repository](https://github.com/KoeAI/LLVC) for model architecture details\n* Refer to the [LLVC paper (arXiv:2311.00873)](https://arxiv.org/abs/2311.00873) for technical details\n* Check [LLVC demo page](https://koeai.github.io/llvc-demo/) for audio samples\n* Refer to [TT Fused ops PR #29236](https://github.com/tenstorrent/tt-metal/pull/29236) for optimization opportunities\n* The model architecture consists of:\n  * **Lightweight encoder**: Optimized convolutional layers with reduced complexity\n  * **Cached convolutions**: State management for causal streaming inference\n  * **Efficient decoder**: Minimal layers for low latency\n  * **Optional F0 module**: Pitch extraction when needed\n  * **Vocoder**: HiFi-GAN or similar (can be shared with other models)\n* Key challenges:\n  * Ultra-low latency requirements (< 100ms)\n  * Streaming inference with causal convolutions\n  * State management across chunks\n  * Quality vs latency trade-off\n  * Vocoder integration and optimization\n  * Small model size constraints\n* Streaming parameters:\n  * `window_ms`: Chunk size in milliseconds (affects latency)\n  * `extra_convert_size`: Extra context for quality (affects latency)\n* Ask for help or file issues if ops are missing in TTNN\n\n\n### 🔎 Possible Approaches\n\n* Start from the [official LLVC repository](https://github.com/KoeAI/LLVC) and port components sequentially:\n  1. Lightweight encoder (optimized convolutions)\n  2. Cached convolution layers for streaming\n  3. Efficient decoder\n  4. Optional pitch extraction (F0 mode)\n  5. Vocoder integration\n  6. Streaming inference pipeline with state management\n* Validate each submodule's output against PyTorch reference before integration\n* Experiment with different sharding strategies:\n  * Channel sharding for convolutions\n  * Sequence length sharding for chunks\n  * Minimize cross-chip communication\n* Use TTNN profiling tools to identify bottlenecks in:\n  * Per-chunk processing time (critical metric)\n  * Encoder latency\n  * Decoder latency\n  * State management overhead\n  * Vocoder latency\n* Test diverse use cases:\n  * Streaming mode with various chunk sizes (50ms, 100ms, 200ms)\n  * Non-streaming mode for comparison\n  * F0-based vs F0-free modes\n  * Multiple concurrent streams\n  * Real-time conversion scenarios\n* Open a draft PR early to get feedback on your approach\n\n\n\n## 📊 Result Submission Guidelines\n\nBeyond the model implementation itself, contributors must submit the following material as proof of work.\nHowever, feel free to open a PR at any time if you want us checking that you are on the right track.\nJust understand that payout is only made after **all 3 stages** are completed.\n\n**Deliverables:**\n- Functional model implementation\n- Validation logs (output correctness)\n- Performance report + header for final review\n\n**Links:**\n- [Performance Sheet](https://github.com/tenstorrent/tt-metal/blob/main/tech_reports/ttnn/TTNN-model-bringup.md#41-performance-sheet)\n- [Perf Header Docs](https://docs.tenstorrent.com/tt-metal/latest/ttnn/ttnn/profiling_ttnn_operations.html#perf-report-headers)\n\n\n### 📚 Resources\n\n### Model Resources\n\n* [LLVC Official Repository](https://github.com/KoeAI/LLVC)\n* [LLVC Paper (arXiv:2311.00873)](https://arxiv.org/abs/2311.00873)\n* [LLVC Demo Page](https://koeai.github.io/llvc-demo/)\n* [LLVC Paper PDF](https://koe.ai/papers/llvc.pdf)\n* [Koe AI Homepage](https://koe.ai/)\n* [RVC Repository (related)](https://github.com/RVC-Project/Retrieval-based-Voice-Conversion-WebUI)\n\n### TT-Metal Resources\n\n* [TTNN Model Bring-up Tech Report](https://github.com/tenstorrent/tt-metal/blob/main/tech_reports/ttnn/TTNN-model-bringup.md)\n* [Streaming Audio Models in tt-metal](https://github.com/tenstorrent/tt-metal/tree/main/models/demos)\n* [TT Fused Ops PR #29236](https://github.com/tenstorrent/tt-metal/pull/29236)\n* [Performance Report Header](https://docs.tenstorrent.com/tt-metal/latest/ttnn/ttnn/profiling_ttnn_operations.html#perf-report-headers)","reactions":{"url":"https://api.github.com/repos/tenstorrent/tt-metal/issues/32187/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/tenstorrent/tt-metal/issues/32187/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/auscaster/frantic-board/issues/63","repository_url":"https://api.github.com/repos/auscaster/frantic-board","labels_url":"https://api.github.com/repos/auscaster/frantic-board/issues/63/labels{/name}","comments_url":"https://api.github.com/repos/auscaster/frantic-board/issues/63/comments","events_url":"https://api.github.com/repos/auscaster/frantic-board/issues/63/events","html_url":"https://github.com/auscaster/frantic-board/issues/63","id":4682784223,"node_id":"I_kwDOS3gB3c8AAAABFx2d3w","number":63,"title":"Frantic bounty #11: Delayed verifier proof","user":{"login":"auscaster","id":100876,"node_id":"MDQ6VXNlcjEwMDg3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/100876?v=4","gravatar_id":"","url":"https://api.github.com/users/auscaster","html_url":"https://github.com/auscaster","followers_url":"https://api.github.com/users/auscaster/followers","following_url":"https://api.github.com/users/auscaster/following{/other_user}","gists_url":"https://api.github.com/users/auscaster/gists{/gist_id}","starred_url":"https://api.github.com/users/auscaster/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/auscaster/subscriptions","organizations_url":"https://api.github.com/users/auscaster/orgs","repos_url":"https://api.github.com/users/auscaster/repos","events_url":"https://api.github.com/users/auscaster/events{/privacy}","received_events_url":"https://api.github.com/users/auscaster/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11281275972,"node_id":"LA_kwDOS3gB3c8AAAACoGqcRA","url":"https://api.github.com/repos/auscaster/frantic-board/labels/funded","name":"funded","color":"fbca04","default":false,"description":"Funded and backed by budget"},{"id":11281308252,"node_id":"LA_kwDOS3gB3c8AAAACoGsaXA","url":"https://api.github.com/repos/auscaster/frantic-board/labels/delivered","name":"delivered","color":"c5def5","default":false,"description":"Artifact delivered for review"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":81,"created_at":"2026-06-17T11:27:45Z","updated_at":"2026-07-07T05:23:00Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Frantic bounty #11\n\nDelayed verifier proof\n\nWorker price: $6\nSlots: 1 (filled)\nStatus: delivered\nClaim: https://gofrantic.com/bounties/11\nFunding receipt: https://gofrantic.com/r/02a50ecbbfb9\n\nFrantic is the source of truth. This GitHub issue is a mirrored board thread.\n\n<!-- runx-outbox-envelope: v1 -->\n<!-- runx-outbox-entry: frantic:bounty:11 -->\n<!-- runx-outbox-metadata:  -->\n","reactions":{"url":"https://api.github.com/repos/auscaster/frantic-board/issues/63/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/auscaster/frantic-board/issues/63/timeline","performed_via_github_app":null,"state_reason":"reopened","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/auscaster/frantic-board/issues/198","repository_url":"https://api.github.com/repos/auscaster/frantic-board","labels_url":"https://api.github.com/repos/auscaster/frantic-board/issues/198/labels{/name}","comments_url":"https://api.github.com/repos/auscaster/frantic-board/issues/198/comments","events_url":"https://api.github.com/repos/auscaster/frantic-board/issues/198/events","html_url":"https://github.com/auscaster/frantic-board/issues/198","id":4812266757,"node_id":"I_kwDOS3gB3c8AAAABHtVdBQ","number":198,"title":"Frantic bounty #83: runx skill: postmortem maker","user":{"login":"auscaster","id":100876,"node_id":"MDQ6VXNlcjEwMDg3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/100876?v=4","gravatar_id":"","url":"https://api.github.com/users/auscaster","html_url":"https://github.com/auscaster","followers_url":"https://api.github.com/users/auscaster/followers","following_url":"https://api.github.com/users/auscaster/following{/other_user}","gists_url":"https://api.github.com/users/auscaster/gists{/gist_id}","starred_url":"https://api.github.com/users/auscaster/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/auscaster/subscriptions","organizations_url":"https://api.github.com/users/auscaster/orgs","repos_url":"https://api.github.com/users/auscaster/repos","events_url":"https://api.github.com/users/auscaster/events{/privacy}","received_events_url":"https://api.github.com/users/auscaster/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11281275972,"node_id":"LA_kwDOS3gB3c8AAAACoGqcRA","url":"https://api.github.com/repos/auscaster/frantic-board/labels/funded","name":"funded","color":"fbca04","default":false,"description":"Funded and backed by budget"},{"id":11281308252,"node_id":"LA_kwDOS3gB3c8AAAACoGsaXA","url":"https://api.github.com/repos/auscaster/frantic-board/labels/delivered","name":"delivered","color":"c5def5","default":false,"description":"Artifact delivered for review"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":11,"created_at":"2026-07-05T09:10:15Z","updated_at":"2026-07-07T05:15:26Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Frantic bounty #83\n\nrunx skill: postmortem maker\n\nWorker price: $9\nSlots: 1\nStatus: Available\nClaim: https://gofrantic.com/bounties/83\nFunding receipt: https://gofrantic.com/r/fc29d3216765\n\nFrantic is the source of truth. This GitHub issue is a mirrored board thread.\n\n<!-- runx-outbox-envelope: v1 -->\n<!-- runx-outbox-entry: frantic:bounty:83 -->\n<!-- runx-outbox-metadata:  -->\n","reactions":{"url":"https://api.github.com/repos/auscaster/frantic-board/issues/198/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/auscaster/frantic-board/issues/198/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/osmosis-labs/orderbook/issues/211","repository_url":"https://api.github.com/repos/osmosis-labs/orderbook","labels_url":"https://api.github.com/repos/osmosis-labs/orderbook/issues/211/labels{/name}","comments_url":"https://api.github.com/repos/osmosis-labs/orderbook/issues/211/comments","events_url":"https://api.github.com/repos/osmosis-labs/orderbook/issues/211/events","html_url":"https://github.com/osmosis-labs/orderbook/issues/211","id":4825459761,"node_id":"I_kwDOLTG9Js8AAAABH56sMQ","number":211,"title":"[Bug Report] `Orderbook.next_bid_tick`/`next_ask_tick` are never retracted on a cancel or an exact-drain sweep — a stale/phantom best price until an unrelated later sweep happens to walk past the empty tick","user":{"login":"OPTIONPOOL","id":51193664,"node_id":"MDQ6VXNlcjUxMTkzNjY0","avatar_url":"https://avatars.githubusercontent.com/u/51193664?v=4","gravatar_id":"","url":"https://api.github.com/users/OPTIONPOOL","html_url":"https://github.com/OPTIONPOOL","followers_url":"https://api.github.com/users/OPTIONPOOL/followers","following_url":"https://api.github.com/users/OPTIONPOOL/following{/other_user}","gists_url":"https://api.github.com/users/OPTIONPOOL/gists{/gist_id}","starred_url":"https://api.github.com/users/OPTIONPOOL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/OPTIONPOOL/subscriptions","organizations_url":"https://api.github.com/users/OPTIONPOOL/orgs","repos_url":"https://api.github.com/users/OPTIONPOOL/repos","events_url":"https://api.github.com/users/OPTIONPOOL/events{/privacy}","received_events_url":"https://api.github.com/users/OPTIONPOOL/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-07-07T05:14:31Z","updated_at":"2026-07-07T05:14:31Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"\nFound while integrating `sumtree-orderbook` into an open matching-engine benchmark, the [Matching Engine Performance Challenge](https://github.com/flash1-dev/matching-engine-benchmark) — it cross-checks engines against the byte-identical consensus of other conforming order books, including a book-state audit that probes `best_bid`/`best_ask`/`depth_at` at many points through a replayed order flow, not just the final report stream. This surfaces the moment the *only* resting order at the current best price is cancelled, or a market-order sweep exactly exhausts the last tick it visits: `next_bid_tick`/`next_ask_tick` keep naming that tick even though it now holds zero resting liquidity, so `query::spot_price` (and any other caller reading these two fields directly, as this contract's own query surface does) reports a phantom price until some later, unrelated sweep happens to walk past the empty tick and clean it up as an incidental side effect of its own traversal. No trade is ever mispriced by this — the fault is purely in the book state a query reads in the window before that self-heal happens.\n\nPinned at `master` (`f49dffce99b2c46284b8ec15de5e16a3efaf4e56`).\n\n## Environment\n\n- Commit `f49dffce99b2c46284b8ec15de5e16a3efaf4e56`, Rust 1.96 (edition 2021), `cosmwasm-std = \"1.5.4\"`, `cosmwasm-schema = \"1.5.0\"`, `cw-storage-plus = \"1.1.0\"`.\n- Built with the crate's own `library` feature (`Cargo.toml`: \"use library feature to disable all instantiate/execute/query exports\") so `contract::instantiate`/`contract::execute` remain plain, directly-callable Rust functions against `cosmwasm_std::testing::mock_dependencies()` — no chain, no `wasmvm`, no CosmWasm-pool routing. This is the same seam the crate's own `dev-dependencies` (`cw-multi-test`, `osmosis-test-tube`) drive it through for its own integration tests.\n- `sudo::sudo` is reachable the same way; its own `#[cfg_attr(not(feature = \"imported\"), entry_point)]` names a feature that does not exist in this crate's `Cargo.toml`, so it is unconditionally a plain function on a native build target regardless of `library`.\n\n## What happens\n\nRest two bids at ticks 100 and 99 (a bid at 100 is currently the best). Cancel the only order resting at 100. The cancel itself is correct — `total_amount_of_liquidity` for tick 100's bid side correctly drops to zero, and 99 is still fully resting. But `Orderbook.next_bid_tick` is left at 100. A caller asking \"what's the best bid\" via `query::spot_price` — or any other consumer that reads `next_bid_tick` directly, as that query itself does — gets back the dead price 100, not the real best bid of 99, until some unrelated later order happens to sweep down through 100 and reach 99, at which point `run_market_order_internal`'s own tick-iteration loop advances the pointer as an incidental side effect of walking past the now-empty tick.\n\nA second, distinct trigger: a market-order sweep whose own remaining input reaches exactly zero on the very last tick it visits leaves the pointer pointing at that tick even though the sweep itself just fully drained it to zero liquidity, in the *same* call — see \"Mechanism\" below for exactly why.\n\n## Minimal reproduction\n\nEvery call below is the engine's own public, unmodified API — `contract::instantiate`, `contract::execute`, `sudo::sudo` — driven directly against `MockStorage`, the same pattern `cw-multi-test`-based integration tests already use for this contract (no `#[define private public]`-style trick needed; nothing here is private).\n\n```rust\n// repro.rs -- add as a [[bin]] to a throwaway crate depending on\n// { path = \".../contracts/sumtree-orderbook\", default-features = false, features = [\"library\"] }\nuse cosmwasm_std::testing::{mock_dependencies, mock_env, mock_info};\nuse cosmwasm_std::{coin, Uint128};\nuse sumtree_orderbook::contract;\nuse sumtree_orderbook::msg::{ExecuteMsg, InstantiateMsg};\nuse sumtree_orderbook::state::ORDERBOOK;\nuse sumtree_orderbook::types::OrderDirection;\n\nfn main() {\n    let mut deps = mock_dependencies();\n    // create_orderbook() requires a nonzero bank supply for both denoms.\n    deps.querier.update_balance(\"holder\", vec![coin(1, \"base\"), coin(1, \"quote\")]);\n    contract::instantiate(deps.as_mut(), mock_env(), mock_info(\"creator\", &[]),\n        InstantiateMsg { base_denom: \"base\".into(), quote_denom: \"quote\".into() }).unwrap();\n\n    let place = |deps: cosmwasm_std::DepsMut, tick: i64, qty: u128| {\n        contract::execute(deps, mock_env(), mock_info(\"owner\", &[coin(qty, \"quote\")]),\n            ExecuteMsg::PlaceLimit { tick_id: tick, order_direction: OrderDirection::Bid,\n                quantity: Uint128::new(qty), claim_bounty: None }).unwrap();\n    };\n    place(deps.as_mut(), 100, 10);   // order 0: the best bid\n    place(deps.as_mut(), 99, 7);     // order 1: next best\n\n    println!(\"next_bid_tick before cancel: {}\", ORDERBOOK.load(deps.as_ref().storage).unwrap().next_bid_tick);\n\n    // Cancel the ONLY order resting at the current best (tick 100, order_id 0).\n    contract::execute(deps.as_mut(), mock_env(), mock_info(\"owner\", &[]),\n        ExecuteMsg::CancelLimit { tick_id: 100, order_id: 0 }).unwrap();\n\n    let ob = ORDERBOOK.load(deps.as_ref().storage).unwrap();\n    println!(\"next_bid_tick after cancelling the only order @100: {} (MIN_TICK sentinel would be -108000000; \\\n              the TRUE best bid is now 99, still fully resting)\", ob.next_bid_tick);\n}\n```\n\nOutput against `f49dffce9`:\n\n```\nnext_bid_tick before cancel: 100\nnext_bid_tick after cancelling the only order @100: 100 (MIN_TICK sentinel would be -108000000; the TRUE best bid is now 99, still fully resting)\n```\n\nExpected: `next_bid_tick` should read `99` (the real, still fully-resting best bid) after cancelling the order at 100. Actual: it still reads `100`, a tick with zero resting bid liquidity (confirmed independently: `TICK_STATE.load(deps.as_ref().storage, 100).unwrap().bid_values.total_amount_of_liquidity` is `Decimal256::zero()` immediately after the cancel). `query::spot_price(deps, \"quote\", \"base\")` — the contract's own, unmodified public query — calls `tick_to_price(orderbook.next_bid_tick)` directly and would return the price at the dead tick 100, not 99.\n\n### Second trigger: an exact-drain market-order sweep\n\nSame shape, reached from the sweep side instead of the cancel side: rest three bids of equal size at 100, cancel one (still 100 has two resting, `next_bid_tick` stays 100, correctly — 100 still has live liquidity), then run a `SudoMsg::SwapExactAmountIn`/`SwapToTick` (Ask direction, `target_tick: 100`) sized to consume *exactly* the two remaining orders' full liquidity and nothing more. After that call, tick 100's bid liquidity is exactly zero, but `next_bid_tick` still reads 100 — the sweep never advances past it, because there is no further tick to advance to (see \"Mechanism\").\n\n## Mechanism\n\n`Orderbook.next_bid_tick`/`next_ask_tick` (`contracts/sumtree-orderbook/src/types/orderbook.rs:14-15`) are touched in exactly two places, and both only ever move the pointer *toward* more liquidity, never away from an emptied one:\n\n1. `order::place_limit` (`order.rs:76-89`) **extends** the pointer only when a *new* order beats the current one:\n   ```rust\n   match order_direction {\n       OrderDirection::Bid => {\n           if tick_id > orderbook.next_bid_tick {\n               orderbook.next_bid_tick = tick_id;\n           }\n       }\n       OrderDirection::Ask => { /* symmetric */ }\n   }\n   ```\n2. `order::run_market_order_internal` (`order.rs:522-530`) **advances** the pointer forward as its own tick-sweep loop visits ticks:\n   ```rust\n   if output_quantity.is_zero() {\n       order.quantity = Uint128::zero();\n       break;                                 // <-- returns BEFORE the pointer update below\n   }\n   // ...\n   match order.order_direction.opposite() {\n       OrderDirection::Ask => orderbook.next_ask_tick = current_tick_id,\n       OrderDirection::Bid => orderbook.next_bid_tick = current_tick_id,\n   }\n   ```\n   Because the `is_zero()` check and `break` (line 522) come *before* the pointer-update statement (lines 529-530) in the loop body, a sweep whose remaining input reaches exactly zero while visiting the tick that exactly drains it never executes the pointer update for that tick's *successor* — but it already updated the pointer *to* that tick on the iteration that processed it, so the net effect is: the pointer is left exactly on the tick the sweep just fully drained to zero, rather than on whatever (if anything) comes after it.\n\n`order::cancel_limit` (`order.rs:138-242`) is the third and last place a tick's resting liquidity can change (`curr_tick_values.total_amount_of_liquidity = checked_sub(...)`, `order.rs:214-216`) — and, although it does `ORDERBOOK.load` once (`order.rs:201`) solely to fetch the refund denoms, it **never *writes* `ORDERBOOK` and never reads or touches `next_bid_tick`/`next_ask_tick`**. There is no code path anywhere in `cancel_limit` that checks whether the order being cancelled was resting at the currently-tracked best tick, or whether that tick is now empty.\n\n`query::spot_price` (`query.rs:34-70`) is the contract's own, public, unmodified consumer of these two fields, and reads them exactly as stored, with no defensive scan:\n\n```rust\nlet next_tick = match direction {\n    OrderDirection::Ask => orderbook.next_bid_tick,\n    OrderDirection::Bid => orderbook.next_ask_tick,\n};\nlet price = tick_to_price(next_tick)?;\n```\n\nSo a stale pointer is not merely an internal bookkeeping quirk invisible to callers — it is directly what this contract's own price-quoting entry point returns to a caller asking for the current spot price (relevant since this contract registers itself as a CosmWasm Pool, and `spot_price`/`calc_out_amount_given_in` are the exact query surface `x/poolmanager` and any price-aggregating integrator would call).\n\nThe staleness is always eventually self-correcting and never mis-prices a fill: `run_market_order_internal`'s own loop skips a zero-liquidity tick unconditionally (`if current_tick_values.total_amount_of_liquidity.is_zero() { continue; }`, `order.rs` inside the same loop, a few lines above the code quoted above) before it ever computes a fill against it, and correctly advances the pointer once it reaches the next tick that does have liquidity. The bug is a pure state-query issue in the window before that next sweep happens — but that window can be arbitrarily long (any number of blocks until the next swap on that side), and during it, `spot_price` genuinely misreports.\n\n## Suggested fix\n\nRetract the pointer at the two places that can leave it stale, scanning only when the currently-tracked tick has actually gone to zero (so the common case — the tracked tick is still live — costs nothing beyond one `TICK_STATE` read):\n\n```rust\nfn retrack_best_tick_pointer(\n    storage: &mut dyn Storage,\n    ob: &mut Orderbook,\n    direction: OrderDirection,\n) -> Result<(), ContractError> {\n    let (current, sentinel) = match direction {\n        OrderDirection::Bid => (ob.next_bid_tick, MIN_TICK),\n        OrderDirection::Ask => (ob.next_ask_tick, MAX_TICK),\n    };\n    if current == sentinel {\n        return Ok(());\n    }\n    let still_live = TICK_STATE\n        .load(storage, current)\n        .map(|t| !t.get_values(direction).total_amount_of_liquidity.is_zero())\n        .unwrap_or(false);\n    if still_live {\n        return Ok(());\n    }\n    let new_ptr = match direction {\n        OrderDirection::Bid => TICK_STATE\n            .range(storage, Some(Bound::inclusive(MIN_TICK)), Some(Bound::exclusive(current)), Order::Descending)\n            .find_map(|r| { let (id, st) = r.ok()?;\n                if st.bid_values.total_amount_of_liquidity.is_zero() { None } else { Some(id) } })\n            .unwrap_or(MIN_TICK),\n        OrderDirection::Ask => TICK_STATE\n            .range(storage, Some(Bound::exclusive(current)), Some(Bound::inclusive(MAX_TICK)), Order::Ascending)\n            .find_map(|r| { let (id, st) = r.ok()?;\n                if st.ask_values.total_amount_of_liquidity.is_zero() { None } else { Some(id) } })\n            .unwrap_or(MAX_TICK),\n    };\n    match direction {\n        OrderDirection::Bid => ob.next_bid_tick = new_ptr,\n        OrderDirection::Ask => ob.next_ask_tick = new_ptr,\n    }\n    Ok(())\n}\n```\n\nCalled from `cancel_limit` right after its existing `TICK_STATE.save` (so it observes the just-updated liquidity), passing `order.order_direction`; and from `run_market_order` (the outer wrapper, after its own `TICK_STATE.save` loop over `tick_updates`), passing `order.order_direction.opposite()` — the side whose liquidity the sweep just consumed. Neither call site touches a fill quantity, a price, or FIFO order; both only correct the auxiliary best-price pointer cache.\n\nI built and ran this exact fix against `f49dffce9` (native, via `mock_dependencies`, the same harness described above): the two repro scenarios above both now report the correct pointer (`99` and the `MIN_TICK`/`MAX_TICK` empty-book sentinel, respectively, in the cases that should produce them), and a 33-case conformance battery covering FIFO priority, multi-level sweeps, partial fills, stale cancels/modifies, and book-state probes at every message index — all oracled against three independent, unrelated order-book implementations — passes both its report-stream-hash and book-state dimensions with the fix applied (the report-stream dimension already passed without it; only the book-state dimension needed this fix).\n\n---\n\nThis is just a time-stamped snapshot of one specific commit, offered back in case it's useful — not a comment on the project, which is otherwise a clean, well-tested sumtree design (the ETAS/prefix-sum lazy-fill accounting in particular is a neat way to keep a market-order sweep O(ticks touched) instead of O(orders touched)). Thanks for sharing it.\n\nRespectfully submitted.\n","reactions":{"url":"https://api.github.com/repos/osmosis-labs/orderbook/issues/211/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/osmosis-labs/orderbook/issues/211/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/93417","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/93417/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/93417/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/93417/events","html_url":"https://github.com/Expensify/App/issues/93417","id":4648595384,"node_id":"I_kwDOEQqHYc8AAAABFRPvuA","number":93417,"title":"[$250] Issue with Edit Columns in offline mode","user":{"login":"IuliiaHerets","id":102230002,"node_id":"U_kgDOBhfn8g","avatar_url":"https://avatars.githubusercontent.com/u/102230002?v=4","gravatar_id":"","url":"https://api.github.com/users/IuliiaHerets","html_url":"https://github.com/IuliiaHerets","followers_url":"https://api.github.com/users/IuliiaHerets/followers","following_url":"https://api.github.com/users/IuliiaHerets/following{/other_user}","gists_url":"https://api.github.com/users/IuliiaHerets/gists{/gist_id}","starred_url":"https://api.github.com/users/IuliiaHerets/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/IuliiaHerets/subscriptions","organizations_url":"https://api.github.com/users/IuliiaHerets/orgs","repos_url":"https://api.github.com/users/IuliiaHerets/repos","events_url":"https://api.github.com/users/IuliiaHerets/events{/privacy}","received_events_url":"https://api.github.com/users/IuliiaHerets/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893455829,"node_id":"MDU6TGFiZWwyODkzNDU1ODI5","url":"https://api.github.com/repos/Expensify/App/labels/Daily","name":"Daily","color":"eb6420","default":false,"description":"KSv2"},{"id":3136662525,"node_id":"MDU6TGFiZWwzMTM2NjYyNTI1","url":"https://api.github.com/repos/Expensify/App/labels/Help%20Wanted","name":"Help Wanted","color":"CFC8F1","default":false,"description":"Apply this label when an issue is open to proposals by contributors"},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"lakchote","id":21549771,"node_id":"MDQ6VXNlcjIxNTQ5Nzcx","avatar_url":"https://avatars.githubusercontent.com/u/21549771?v=4","gravatar_id":"","url":"https://api.github.com/users/lakchote","html_url":"https://github.com/lakchote","followers_url":"https://api.github.com/users/lakchote/followers","following_url":"https://api.github.com/users/lakchote/following{/other_user}","gists_url":"https://api.github.com/users/lakchote/gists{/gist_id}","starred_url":"https://api.github.com/users/lakchote/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lakchote/subscriptions","organizations_url":"https://api.github.com/users/lakchote/orgs","repos_url":"https://api.github.com/users/lakchote/repos","events_url":"https://api.github.com/users/lakchote/events{/privacy}","received_events_url":"https://api.github.com/users/lakchote/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"truph01","id":170341821,"node_id":"U_kgDOCic1vQ","avatar_url":"https://avatars.githubusercontent.com/u/170341821?v=4","gravatar_id":"","url":"https://api.github.com/users/truph01","html_url":"https://github.com/truph01","followers_url":"https://api.github.com/users/truph01/followers","following_url":"https://api.github.com/users/truph01/following{/other_user}","gists_url":"https://api.github.com/users/truph01/gists{/gist_id}","starred_url":"https://api.github.com/users/truph01/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/truph01/subscriptions","organizations_url":"https://api.github.com/users/truph01/orgs","repos_url":"https://api.github.com/users/truph01/repos","events_url":"https://api.github.com/users/truph01/events{/privacy}","received_events_url":"https://api.github.com/users/truph01/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":65,"created_at":"2026-06-12T10:51:10Z","updated_at":"2026-07-07T05:10:51Z","closed_at":null,"assignee":{"login":"truph01","id":170341821,"node_id":"U_kgDOCic1vQ","avatar_url":"https://avatars.githubusercontent.com/u/170341821?v=4","gravatar_id":"","url":"https://api.github.com/users/truph01","html_url":"https://github.com/truph01","followers_url":"https://api.github.com/users/truph01/followers","following_url":"https://api.github.com/users/truph01/following{/other_user}","gists_url":"https://api.github.com/users/truph01/gists{/gist_id}","starred_url":"https://api.github.com/users/truph01/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/truph01/subscriptions","organizations_url":"https://api.github.com/users/truph01/orgs","repos_url":"https://api.github.com/users/truph01/repos","events_url":"https://api.github.com/users/truph01/events{/privacy}","received_events_url":"https://api.github.com/users/truph01/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding. To join our Slack channel, fill out [this form](https://forms.gle/Q7hnhUJPnQCK7Fe56).\n___\n\n**Version Number:** v9.4.6-0\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/folder/30823848/test-cases/72255457?q=Offline+Modification+and+Exported+Column+Behavior\n\n## Action Performed:\n\n1. Navigate to Spend > Reports and enable the Exported column via the Edit column selector\n2. Verify Exported column dispalyed\n3. Click Edit Columns, disable the Exported column, and click Save\n4. Verify the \"Exported\" column cells not displayed in the table\n5. Enter a search term in the report search bar to filter reports\n6. Disconnect the device from the internet (Go offline)\n7. Click on the \"Columns\" button again\n8. Re-check/Enable the \"Exported\" column checkbox\n\n\n## Expected Result:\nExported column should be added to the table\n\n## Actual Result:\nPage goes blank with an error message You appear to be offline\n\n## Workaround:\nUnknown\n\n## Platforms:\nSelect the officially supported platforms where the issue was reproduced:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [ ] MacOS: Chrome / Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/42b954eb-5c59-477e-8ca6-62e80d3fb9b4\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022065388064058618518\">https://www.upwork.com/jobs/~022065388064058618518</a></li>\n        <li>Upwork Job ID: 2065388064058618518</li>\n        <li>Last Price Increase: 2026-07-03</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @lakchote</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/93417/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/93417/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/TaySchub/blueplate/issues/103","repository_url":"https://api.github.com/repos/TaySchub/blueplate","labels_url":"https://api.github.com/repos/TaySchub/blueplate/issues/103/labels{/name}","comments_url":"https://api.github.com/repos/TaySchub/blueplate/issues/103/comments","events_url":"https://api.github.com/repos/TaySchub/blueplate/issues/103/events","html_url":"https://github.com/TaySchub/blueplate/issues/103","id":4825321319,"node_id":"I_kwDOTKH7388AAAABH5yPZw","number":103,"title":"Tower Rework + closing rebalance: five newcomer kits, two engine systems, full retune (developer-ratified 2026-07-07)","user":{"login":"TaySchub","id":298097911,"node_id":"U_kgDOEcSc9w","avatar_url":"https://avatars.githubusercontent.com/u/298097911?v=4","gravatar_id":"","url":"https://api.github.com/users/TaySchub","html_url":"https://github.com/TaySchub","followers_url":"https://api.github.com/users/TaySchub/followers","following_url":"https://api.github.com/users/TaySchub/following{/other_user}","gists_url":"https://api.github.com/users/TaySchub/gists{/gist_id}","starred_url":"https://api.github.com/users/TaySchub/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TaySchub/subscriptions","organizations_url":"https://api.github.com/users/TaySchub/orgs","repos_url":"https://api.github.com/users/TaySchub/repos","events_url":"https://api.github.com/users/TaySchub/events{/privacy}","received_events_url":"https://api.github.com/users/TaySchub/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2026-07-07T04:47:01Z","updated_at":"2026-07-07T05:08:47Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Developer-ratified 2026-07-07** (tower-by-tower review session; final rulings at session close: syrup PURE CONTROL confirmed · MAPLE SYRUP confirmed · JUICE LAYER VETOED — mechanics only, standard presentation).\n\nThe \"game feels stale\" fix, tower side (dishes side = #98). ONE PR in THREE staged commits (developer decision, second session: the closing rebalance is folded in as stage 3 rather than a separate PR — formerly #104, closed as superseded): stage 1 builds the two shared engine systems inert, stage 2 reworks the five newcomer kits, stage 3 is the closing rebalance. The kits:\n\n- **Pitmaster** — Path A: faster stacking + cap 5→8 (t1), ambient smoke AURA (t2). Path B: +range (t1), cooks 2 dishes at once (t2, count frozen).\n- **Ranch → \"The Syrup Slinger\"** (display rename only; internal id `ranch` frozen forever) — cone + coats deleted; new base = single-target maple-syrup glob → immediate full glue-slow, **pure control, zero damage**. Path A: faster slinging (t1), Syrup Trail belt puddle (t2, glues up to 3 — frozen). Path B: +range (t1), globs 3 at once (t2, frozen). Fence: Photographer owns the hard STOP, syrup owns the long DRAG.\n- **Sample Lady** — full rework to **pure support, no attack** (sampling stays as flavor animation). Base aura: nearby towers attack faster + upgrades cost 10% less (discounted price shown in the sheet). Path A: +radius (t1), +damage in aura (t2). Path B: value-tag dishes (t1), haste stacks further (t2).\n- **Short-Order Cook** — Seasoned Griddle t2 knockback-chance deleted (kills the only newcomer RNG signature) → \"Stove on High\" = pure big damage add. Everything else kept.\n- **Competitive Eater** — Solomon Method + Mustard Belt + combo-cap effects deleted; combo stays base-only. Path A: faster → much faster (cooldown-floor guard). Path B: +damage per bite → tip-jackpot per kill, priced expensive.\n\n**New engine systems** (the layer future content inherits): (1) enemy-side ZONE applicators — ambient aura + belt puddle, one system, two shapes; (2) TOWER-PROXIMITY support effects — one radius check → haste / +damage / upgrade-discount.\n\n**Stages 1–2 ship shelf values; stage 3 is the closing rebalance** (numbers-only, the only stage where the gate legitimately moves): prices the reworked kits against the current four dishes, re-holds every BALANCE_PHILOSOPHY §4 bar, re-verifies the Slurper fence (unfed Eater DPS strictly below Slurper's unconditional DPS), and prices the premium tiers premium. **ORDER FLIP (developer decision 2026-07-07): this PR runs BEFORE #98** — the dishes land afterward and get priced against these kits by #98's own retune stage.\n\n**Save guarantee (developer-ratified, second session 2026-07-07):** a player's save must NEVER break — this PR deletes upgrade paths that live inside serialized checkpoints, so restore MIGRATES (orphaned tiers refunded at full value into the run) rather than discarding; a garbage save can never brick boot. Details in the kickoff.\n\n**Blocked on:** nothing — READY TO RUN (prereq: origin/main post-#102, 10 towers in balance.json).\n**Review tier (docs/CHECKPOINT.md, top tier):** checkpoint before merge **+ the developer runs `/code-review ultra <PR#>`** on the open PR — new engine systems + a save-compatibility touch, and the first big engine PR post-Fable.\n**Sequencing after:** #98 Menu Expansion (its retune prices the dishes against these kits) → audio pass 2 (#64: sounds for the new verbs — glob/splat, aura sizzle, bell) → Pizzeria (#39).\n\nKickoff prompt in the first comment.\n","reactions":{"url":"https://api.github.com/repos/TaySchub/blueplate/issues/103/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/TaySchub/blueplate/issues/103/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/TaySchub/blueplate/issues/98","repository_url":"https://api.github.com/repos/TaySchub/blueplate","labels_url":"https://api.github.com/repos/TaySchub/blueplate/issues/98/labels{/name}","comments_url":"https://api.github.com/repos/TaySchub/blueplate/issues/98/comments","events_url":"https://api.github.com/repos/TaySchub/blueplate/issues/98/events","html_url":"https://github.com/TaySchub/blueplate/issues/98","id":4824842243,"node_id":"I_kwDOTKH7388AAAABH5VAAw","number":98,"title":"Menu Expansion: three new dishes (enemy variety for the 10-tower roster)","user":{"login":"TaySchub","id":298097911,"node_id":"U_kgDOEcSc9w","avatar_url":"https://avatars.githubusercontent.com/u/298097911?v=4","gravatar_id":"","url":"https://api.github.com/users/TaySchub","html_url":"https://github.com/TaySchub","followers_url":"https://api.github.com/users/TaySchub/followers","following_url":"https://api.github.com/users/TaySchub/following{/other_user}","gists_url":"https://api.github.com/users/TaySchub/gists{/gist_id}","starred_url":"https://api.github.com/users/TaySchub/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TaySchub/subscriptions","organizations_url":"https://api.github.com/users/TaySchub/orgs","repos_url":"https://api.github.com/users/TaySchub/repos","events_url":"https://api.github.com/users/TaySchub/events{/privacy}","received_events_url":"https://api.github.com/users/TaySchub/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11384592958,"node_id":"LA_kwDOTKH7388AAAACppMaPg","url":"https://api.github.com/repos/TaySchub/blueplate/labels/feature","name":"feature","color":"48ebb5","default":false,"description":"New functionality"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-07-07T03:04:54Z","updated_at":"2026-07-07T05:08:15Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"The roster doubled but the belt still serves the same FOUR dishes — enemy variety is the other half of the staleness fix (tower-upgrade review is happening separately with the developer). THREE new foods as stat+art archetypes only (ultra-fast glass-cannon / awkward mid-tank / rare premium high-bounty plate — builder's designs within those lanes): zero new engine mechanics (splitter stays reserved for Map 2 #39), silhouette-first no-face dish art with bite states, staged waveGen introduction.\n\nUnlike the tower pipeline, this PR **legitimately moves the gate** → stage 2 re-holds every BALANCE_PHILOSOPHY §4 bar (gate 50–60 aim ~55, ≥52 at CI config, engagement/pacing/spam/recoverability) and must show each new dish creates pressure the old four didn't.\n\n**Hard prereq: PR #97 (menu + rename) merged first.** Opus 4.8 high effort, runs in parallel with the developer's tower-by-tower upgrade review (disjoint: dishes vs tower kits). **Fable checkpoint before merge** (gate-moving). Kickoff: first comment below.","reactions":{"url":"https://api.github.com/repos/TaySchub/blueplate/issues/98/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/TaySchub/blueplate/issues/98/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/coollabsio/coolify/issues/7596","repository_url":"https://api.github.com/repos/coollabsio/coolify","labels_url":"https://api.github.com/repos/coollabsio/coolify/issues/7596/labels{/name}","comments_url":"https://api.github.com/repos/coollabsio/coolify/issues/7596/comments","events_url":"https://api.github.com/repos/coollabsio/coolify/issues/7596/events","html_url":"https://github.com/coollabsio/coolify/issues/7596","id":3722348116,"node_id":"I_kwDOE9dbMc7d3oZU","number":7596,"title":"[Enhancement]: new deployment page","user":{"login":"Illyism","id":304283,"node_id":"MDQ6VXNlcjMwNDI4Mw==","avatar_url":"https://avatars.githubusercontent.com/u/304283?v=4","gravatar_id":"","url":"https://api.github.com/users/Illyism","html_url":"https://github.com/Illyism","followers_url":"https://api.github.com/users/Illyism/followers","following_url":"https://api.github.com/users/Illyism/following{/other_user}","gists_url":"https://api.github.com/users/Illyism/gists{/gist_id}","starred_url":"https://api.github.com/users/Illyism/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Illyism/subscriptions","organizations_url":"https://api.github.com/users/Illyism/orgs","repos_url":"https://api.github.com/users/Illyism/repos","events_url":"https://api.github.com/users/Illyism/events{/privacy}","received_events_url":"https://api.github.com/users/Illyism/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":7004083619,"node_id":"LA_kwDOE9dbMc8AAAABoXnVow","url":"https://api.github.com/repos/coollabsio/coolify/labels/%F0%9F%92%8E%20.","name":"💎 .","color":"4f46e5","default":false,"description":"Issues with a monetary reward for completion."},{"id":7459663825,"node_id":"LA_kwDOE9dbMc8AAAABvKFv0Q","url":"https://api.github.com/repos/coollabsio/coolify/labels/%F0%9F%94%8D%20Triage","name":"🔍 Triage","color":"fbca04","default":false,"description":"Issues that need assessment and prioritization."},{"id":7460417744,"node_id":"LA_kwDOE9dbMc8AAAABvKzw0A","url":"https://api.github.com/repos/coollabsio/coolify/labels/%E2%9C%A8%20Enhancement","name":"✨ Enhancement","color":"652D61","default":false,"description":"Issues requesting new