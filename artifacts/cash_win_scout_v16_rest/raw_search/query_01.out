","site_admin":false},"labels":[{"id":10822128665,"node_id":"LA_kwDOSP_2Ts8AAAAChQyUGQ","url":"https://api.github.com/repos/Ikalus1988/MisakaNet/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":11232462358,"node_id":"LA_kwDOSP_2Ts8AAAACnYHGFg","url":"https://api.github.com/repos/Ikalus1988/MisakaNet/labels/ready","name":"ready","color":"ededed","default":false,"description":null},{"id":11237994585,"node_id":"LA_kwDOSP_2Ts8AAAACndYwWQ","url":"https://api.github.com/repos/Ikalus1988/MisakaNet/labels/area:lessons","name":"area:lessons","color":"ededed","default":false,"description":null},{"id":11434125812,"node_id":"LA_kwDOSP_2Ts8AAAACqYbp9A","url":"https://api.github.com/repos/Ikalus1988/MisakaNet/labels/agent-friendly","name":"agent-friendly","color":"0e8a16","default":false,"description":"Issue has clear file path, commands, and expected output"},{"id":11434125952,"node_id":"LA_kwDOSP_2Ts8AAAACqYbqgA","url":"https://api.github.com/repos/Ikalus1988/MisakaNet/labels/one-file","name":"one-file","color":"d4c5f9","default":false,"description":"Fix touches exactly one file"},{"id":11434126067,"node_id":"LA_kwDOSP_2Ts8AAAACqYbq8w","url":"https://api.github.com/repos/Ikalus1988/MisakaNet/labels/no-credentials","name":"no-credentials","color":"77eebb","default":false,"description":"No Cloudflare/GH token needed to complete"},{"id":11435132748,"node_id":"LA_kwDOSP_2Ts8AAAACqZZHTA","url":"https://api.github.com/repos/Ikalus1988/MisakaNet/labels/zero-bounty","name":"zero-bounty","color":"fbca04","default":false,"description":"Zero monetary reward — merge credit + leaderboard only"},{"id":11435169129,"node_id":"LA_kwDOSP_2Ts8AAAACqZbVaQ","url":"https://api.github.com/repos/Ikalus1988/MisakaNet/labels/has-test","name":"has-test","color":"0e8a16","default":false,"description":"Issue includes validation/test commands"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-07-06T15:15:45Z","updated_at":"2026-07-07T06:26:40Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Zero-bounty agent task\n\nThis is a **zero-bounty** MisakaNet task.\nMerge earns credit. No monetary bounty.\n\n## Task\n\nFix frontmatter for exactly one lesson:\n\n`lessons/contrib/agent-manual-update-timeout.md`\n\n## Scope\n\nOnly edit this file. Do not change generated files. Do not rewrite the lesson content. Do not touch unrelated docs or workflows.\n\n## Acceptance Criteria\n\n- [ ] Frontmatter is standard YAML with: title, domain, tags, status, source\n- [ ] The original lesson content is preserved\n- [ ] Only the target file is changed\n- [ ] Commands pass:\n\n```\nPYTHONIOENCODING=utf-8 python scripts/validate_lessons.py lessons/contrib/agent-manual-update-timeout.md\npython scripts/score_lessons.py lessons/contrib/agent-manual-update-timeout.md\n```\n\n## PR Instructions\n\nComment `/claim` before working. In PR body: `Closes #380` + paste validation output.\n\nThis improves MisakaNet search quality and keeps the 192-lesson OKF/SAG/MCP index reliable for AI agents.","reactions":{"url":"https://api.github.com/repos/Ikalus1988/MisakaNet/issues/380/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Ikalus1988/MisakaNet/issues/380/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/93832","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/93832/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/93832/comments","events_url":"https://