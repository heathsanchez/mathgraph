api.github.com/users/nkdengineer/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":78,"created_at":"2026-04-09T10:51:43Z","updated_at":"2026-07-07T06:22:46Z","closed_at":null,"assignee":{"login":"roryabraham","id":47436092,"node_id":"MDQ6VXNlcjQ3NDM2MDky","avatar_url":"https://avatars.githubusercontent.com/u/47436092?v=4","gravatar_id":"","url":"https://api.github.com/users/roryabraham","html_url":"https://github.com/roryabraham","followers_url":"https://api.github.com/users/roryabraham/followers","following_url":"https://api.github.com/users/roryabraham/following{/other_user}","gists_url":"https://api.github.com/users/roryabraham/gists{/gist_id}","starred_url":"https://api.github.com/users/roryabraham/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/roryabraham/subscriptions","organizations_url":"https://api.github.com/users/roryabraham/orgs","repos_url":"https://api.github.com/users/roryabraham/repos","events_url":"https://api.github.com/users/roryabraham/events{/privacy}","received_events_url":"https://api.github.com/users/roryabraham/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** v9.3.55-0\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/test-runs/TR-17114/folder/13176677/41237662/1317002015\n**Email or phone of affected tester (no customers):** lekima20+642404@gmail.com\n**Issue reported by:** Applause Internal Team\n**Bug source:** Regression TC Execution\n**Device used:** Win 11/Chrome\n**App Component:** Other\n\n## Action Performed:\n1. Open https://staging.new.expensify.com\n2. Create a new user with select option \"Manage my team's expenses\" and complete flow\n3. Navigate to Concierge chat\n4. Click on 'categories\" at the task 'Set up categories and tags'\n5. Add a category\n6. Click on More features and enable Tags\n7. Click on Tags tab and add some tags\n8. Navigate to Concierge chat\n9. Refresh page\n10. Click on the task 'Set up categories and tags'\n\n## Expected Result:\nThe task 'Set up categories and tags' should get auto-checked\n\n## Actual Result:\nThe task 'Set up categories and tags’ isn't auto-checked\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [x] Android: App\n- [ ] Android: mWeb Chrome\n- [x] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [ ] MacOS: Chrome / Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/277219f7-03dc-48ae-ba91-8ceffd58b9b6\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: https://www.upwork.com/jobs/~022042198222552145991</li>\n        <li>Upwork Job ID: 2042198222552145991</li>\n        <li>Last Price Increase: 2026-04-16</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @nkdengineer</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/87482/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/87482/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/commaai/panda/issues/2203","repository_url":"https://api.github.com/repos/commaai/panda","labels_url":"https://api.github.com/repos/commaai/panda/issues/2203/labels{/name}","comments_url":"https://api.github.com/repos/commaai/panda/issues/2203/comments","events_url":"https://api.github.com/repos/commaai/panda/issues/2203/events","html_url":"https://github.com/commaai/panda/issues/2203","id":3073450562,"node_id":"I_kwDOBTb99c63MSJC","number":2203,"title":"Test important GPIO initialization in CI (libpanda)","user":{"login":"robbederks","id":894159,"node_id":"MDQ6VXNlcjg5NDE1OQ==","avatar_url":"https://avatars.githubusercontent.com/u/894159?v=4","gravatar_id":"","url":"https://api.github.com/users/robbederks","html_url":"https://github.com/robbederks","followers_url":"https://api.github.com/users/robbederks/followers","following_url":"https://api.github.com/users/robbederks/following{/other_user}","gists_url":"https://api.github.com/users/robbederks/gists{/gist_id}","starred_url":"https://api.github.com/users/robbederks/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/robbederks/subscriptions","organizations_url":"https://api.github.com/users/robbederks/orgs","repos_url":"https://api.github.com/users/robbederks/repos","events_url":"https://api.github.com/users/robbederks/events{/privacy}","received_events_url":"https://api.github.com/users/robbederks/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":578378652,"node_id":"MDU6TGFiZWw1NzgzNzg2NTI=","url":"https://api.github.com/repos/commaai/panda/labels/enhancement","name":"enhancement","color":"84b6eb","default":true,"description":null},{"id":3633695314,"node_id":"LA_kwDOBTb99c7YlcpS","url":"https://api.github.com/repos/commaai/panda/labels/tests","name":"tests","color":"c2e0c6","default":false,"description":""},{"id":6307600117,"node_id":"LA_kwDOBTb99c8AAAABd_ZW9Q","url":"https://api.github.com/repos/commaai/panda/labels/good%20first%20issue","name":"good first issue","color":"fef2c0","default":true,"description":""}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":4,"created_at":"2025-05-19T11:07:28Z","updated_at":"2026-07-07T06:21:56Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"A good test for PRs that refactor / change parts of the panda initialization ([such as this](https://github.com/commaai/panda/pull/2094)) would be a CI job that asserts GPIO like these are initialized correctly and in a safe order:\n- the SBU line driving / readout\n- the CAN transciever lines (enable + RX/TX alternative functions)\n- SOM reset / bootkick\n- LED\n- ...\n\nThis should be quite easy to do without HITL, by writing a \"simulated\" GPIO hardware block in [fake_stm.h](https://github.com/commaai/panda/blob/471a455789b88a0bf1098e87c49d564da266e890/board/fake_stm.h) and using [libpanda](https://github.com/commaai/panda/tree/471a455789b88a0bf1098e87c49d564da266e890/tests/libpanda).","reactions":{"url":"https://api.github.com/repos/commaai/panda/issues/2203/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/commaai/panda/issues/2203/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3","repository_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty","labels_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/labels{/name}","comments_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/comments","events_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/events","html_url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/3","id":4148310577,"node_id":"I_kwDORx6c0M73QjIx","number":3,"title":"[BOUNTY $100] HOOK: Pre-tool-use hook that blocks destructive bash commands","user":{"login":"claudebounty","id":271393208,"node_id":"U_kgDOEC0huA","avatar_url":"https://avatars.githubusercontent.com/u/271393208?v=4","gravatar_id":"","url":"https://api.github.com/users/claudebounty","html_url":"https://github.com/claudebounty","followers_url":"https://api.github.com/users/claudebounty/followers","following_url":"https://api.github.com/users/claudebounty/following{/other_user}","gists_url":"https://api.github.com/users/claudebounty/gists{/gist_id}","starred_url":"https://api.github.com/users/claudebounty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claudebounty/subscriptions","organizations_url":"https://api.github.com/users/claudebounty/orgs","repos_url":"https://api.github.com/users/claudebounty/repos","events_url":"https://api.github.com/users/claudebounty/events{/privacy}","received_events_url":"https://api.github.com/users/claudebounty/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10532402505,"node_id":"LA_kwDORx6c0M8AAAACc8e1SQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/bounty","name":"bounty","color":"D97706","default":false,"description":"Task with financial reward"},{"id":10532402677,"node_id":"LA_kwDORx6c0M8AAAACc8e19Q","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/hook","name":"hook","color":"DC2626","default":false,"description":"Claude Code hook"},{"id":10532402829,"node_id":"LA_kwDORx6c0M8AAAACc8e2jQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/security","name":"security","color":"B91C1C","default":false,"description":"Security-related"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1356,"created_at":"2026-03-27T00:55:40Z","updated_at":"2026-07-07T06:21:17Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 💰 Bounty: $100 — powered by [Opire](https://opire.dev)\n\n## Description\nCreate a Claude Code `pre-tool-use` hook in Python or bash that intercepts\ndangerous bash commands before they are executed.\n\n## Acceptance Criteria\n- [ ] Hook follows Claude Code hooks format (`~/.claude/hooks/`)\n- [ ] Blocks these patterns: `rm -rf`, `DROP TABLE`, `git push --force`,\n      `TRUNCATE`, `DELETE FROM` without a WHERE clause\n- [ ] Logs every blocked attempt to `~/.claude/hooks/blocked.log`\n      with: timestamp, attempted command, project path\n- [ ] Displays a clear message to Claude explaining why the command was blocked\n- [ ] Does not interfere with normal bash commands\n- [ ] README with installation in 2 commands or fewer\n\n## How to Claim\n1. Comment `/opire try` in this issue\n2. Submit a PR with the hook + README\n3. Payment is released automatically on merge ✅\n\n## Resources\n- Claude Code hooks docs: https://docs.anthropic.com/claude-code/hooks","reactions":{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/c