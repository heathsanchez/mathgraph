{"total_count":8914,"incomplete_results":false,"items":[{"url":"https://api.github.com/repos/AsHfIEXE/Dotify/issues/4","repository_url":"https://api.github.com/repos/AsHfIEXE/Dotify","labels_url":"https://api.github.com/repos/AsHfIEXE/Dotify/issues/4/labels{/name}","comments_url":"https://api.github.com/repos/AsHfIEXE/Dotify/issues/4/comments","events_url":"https://api.github.com/repos/AsHfIEXE/Dotify/issues/4/events","html_url":"https://github.com/AsHfIEXE/Dotify/issues/4","id":4813716983,"node_id":"I_kwDOPMixuc8AAAABHut99w","number":4,"title":"dotify-cli 2.0.0 requires pillow>=12.1.0, but you have pillow 11.3.0 which is incompatible","user":{"login":"thehung2224","id":5288362,"node_id":"MDQ6VXNlcjUyODgzNjI=","avatar_url":"https://avatars.githubusercontent.com/u/5288362?v=4","gravatar_id":"","url":"https://api.github.com/users/thehung2224","html_url":"https://github.com/thehung2224","followers_url":"https://api.github.com/users/thehung2224/followers","following_url":"https://api.github.com/users/thehung2224/following{/other_user}","gists_url":"https://api.github.com/users/thehung2224/gists{/gist_id}","starred_url":"https://api.github.com/users/thehung2224/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thehung2224/subscriptions","organizations_url":"https://api.github.com/users/thehung2224/orgs","repos_url":"https://api.github.com/users/thehung2224/repos","events_url":"https://api.github.com/users/thehung2224/events{/privacy}","received_events_url":"https://api.github.com/users/thehung2224/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8943834357,"node_id":"LA_kwDOPMixuc8AAAACFRgU9Q","url":"https://api.github.com/repos/AsHfIEXE/Dotify/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed"},{"id":8943834364,"node_id":"LA_kwDOPMixuc8AAAACFRgU_A","url":"https://api.github.com/repos/AsHfIEXE/Dotify/labels/good%20first%20issue","name":"go