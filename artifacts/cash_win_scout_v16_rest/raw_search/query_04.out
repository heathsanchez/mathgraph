.com/users/marufsharifi/gists{/gist_id}","starred_url":"https://api.github.com/users/marufsharifi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/marufsharifi/subscriptions","organizations_url":"https://api.github.com/users/marufsharifi/orgs","repos_url":"https://api.github.com/users/marufsharifi/repos","events_url":"https://api.github.com/users/marufsharifi/events{/privacy}","received_events_url":"https://api.github.com/users/marufsharifi/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":112,"created_at":"2026-05-25T03:54:26Z","updated_at":"2026-07-07T01:56:05Z","closed_at":null,"assignee":{"login":"Beamanator","id":3885503,"node_id":"MDQ6VXNlcjM4ODU1MDM=","avatar_url":"https://avatars.githubusercontent.com/u/3885503?v=4","gravatar_id":"","url":"https://api.github.com/users/Beamanator","html_url":"https://github.com/Beamanator","followers_url":"https://api.github.com/users/Beamanator/followers","following_url":"https://api.github.com/users/Beamanator/following{/other_user}","gists_url":"https://api.github.com/users/Beamanator/gists{/gist_id}","starred_url":"https://api.github.com/users/Beamanator/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Beamanator/subscriptions","organizations_url":"https://api.github.com/users/Beamanator/orgs","repos_url":"https://api.github.com/users/Beamanator/repos","events_url":"https://api.github.com/users/Beamanator/events{/privacy}","received_events_url":"https://api.github.com/users/Beamanator/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** v9.3.80-0\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/test-runs/TR-32728/folder/13176671/41237461/1434928218\n**Email or phone of affected tester (no customers):** lekima20+623105@gmail.com\n**Issue reported by:** Applause Internal Team\n**Bug source:** Regression TC Execution\n**Device used:** Win 11/Chrome\n**App Component:** Money Requests\n\n## Action Performed:\n1. Open https://staging.new.expensify.com\n2. At Inbox tab, click on FAB > Send Invoice\n3. Complete sending invoice to a user who has never received an invoice before\n4. Wait few seconds\n\n## Expected Result:\nInvoice room is created without error\n\n## Actual Result:\nSending invoice to user who has never received an invoice before, Invoice room displays then skeleton loading infinitely until refresh page.\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [ ] MacOS: Chrome Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/a02edb39-a9b1-4c37-8797-a49f88e4ce96\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n\n> **Applause Internal Information**\n> Exported by: Julia Ponikarchuk\n> Bug ID: 7161549\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022058762163166899438\">https://www.upwork.com/jobs/~022058762163166899438</a></li>\n        <li>Upwork Job ID: 2058762163166899438</li>\n        <li>Last Price Increase: 2026-06-29</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @marufsharifi</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/91557/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/91557/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/343","repository_url":"https://api.github.com/repos/Scottcjn/Rustchain","labels_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/343/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/343/comments","events_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/343/events","html_url":"https://github.com/Scottcjn/Rustchain/issues/343","id":3974805476,"node_id":"I_kwDOOdNtbc7s6rfk","number":343,"title":"[COMMUNITY] Contributor Ladder — Level Up and Earn More","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10159650136,"node_id":"LA_kwDOOdNtbc8AAAACXY_1WA","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC bounty reward"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":12,"created_at":"2026-02-22T15:24:32Z","updated_at":"2026-07-07T01:55:33Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## RustChain Contributor Ladder\n\nProgress through the ranks. Each tier unlocks higher bounty access and governance rights.\n\n### Tiers\n\n| Tier | Name | Requirements | Rewards |\n|------|------|-------------|---------|\n| 1 | **Explorer** | First merged PR or detailed bug report | 5 RTC welcome bonus |\n| 2 | **Miner** | 3+ merged PRs over 30+ days | 25 RTC bonus + priority bounty claims |\n| 3 | **Foreman** | 10+ merged PRs, 90+ days, reviewed 3+ others' PRs | 100 RTC bonus + RIP voting rights |\n| 4 | **Architect** | 6+ months sustained, major feature or security contribution | 250 RTC bonus + RIP authorship + epoch multiplier |\n| 5 | **Guardian** | Found and reported critical security vulnerability | Permanent title + Hall of Fame + 500 RTC |\n\n### How It Works\n\n- **Automatic tracking** — we check your merged PRs, time active, and review history\n- **Tier-up bonuses are one-time** — you get them when you level up\n- **Higher tiers can claim higher-value bounties** — Explorer: up to 10 RTC, Miner: up to 50 RTC, Foreman: up to 150 RTC, Architect: unlimited\n- **Governance rights are real** — Foreman+ can vote on RustChain Improvement Proposals (RIPs), Architect+ can author them\n\n### Current Leaderboard\n\n| Contributor | Merged PRs | Active Since | Current Tier |\n|------------|-----------|-------------|-------------|\n| createkr | 26 | Feb 2026 | Foreman |\n| liu971227-sys | 23 | Dec 2025 | Foreman |\n| David-code-tang | 20 | Feb 2026 | Miner |\n| autonomy414941 | 7 | Feb 2026 | Miner |\n| erdogan98 | 5 | Feb 2026 | Miner |\n\n*Leaderboard updated weekly. Claim your tier in the comments!*\n\n### Why This Matters\n\nFarmers want quick payouts. Real contributors want recognition, influence, and a project they helped build. The ladder rewards sustained quality over spray-and-pray PRs.\n\n---\n\n*Based on Kubernetes/CNCF contributor ladder model, adapted for RustChain.*","reactions":{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/343/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/343/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/425","repository_url":"https://api.github.com/repos/Scottcjn/Rustchain","labels_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/425/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/425/comments","events_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/425/events","html_url":"https://github.com/Scottcjn/Rustchain/issues/425","id":4002656325,"node_id":"I_kwDOOdNtbc7uk7BF","number":425,"title":"[CAMPAIGN] 5,000 Stars Drive — Earn Up to 430 RTC (5,000 RTC Pool)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8491289527,"node_id":"LA_kwDOOdNtbc8AAAAB-h7Ltw","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed"},{"id":8491289534,"node_id":"LA_kwDOOdNtbc8AAAAB-h7Lvg","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/good%20first%20issue","name":"good first issue","color":"7057FF","default":true,"description":"Good for newcomers (5-10 RTC)"},{"id":10159650136,"node_id":"LA_kwDOOdNtbc8AAAACXY_1WA","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC bounty reward"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":115,"created_at":"2026-02-27T20:03:08Z","updated_at":"2026-07-07T01:55:09Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 5,000 Stars Campaign\n\n**Pool: 5,000 RTC ($500 value)** | Currently at **337 stars** across 86 repos — need **4,663 more**.\n\n```\n[██░░░░░░░░░░░░░░░░░░░░░░░░░░░░] 6.7% (337/5000)\n```\n\n### Earn RTC by Starring\n\n| Repos Starred | RTC Per Star | Max Payout |\n|---------------|-------------|------------|\n| 1-2 | 1 RTC | 2 RTC |\n| 3-4 | 1.5 RTC | 6 RTC |\n| 5-9 | 2 RTC | 18 RTC |\n| 10-19 | 2.5 RTC | 50 RTC |\n| 20-49 | 3 RTC | 150 RTC |\n| **ALL 86 repos** | **5 RTC** | **430 RTC** |\n\n### Social Amplifier Bonus\n\n| Action | Bonus |\n|--------|-------|\n| Tweet + link | +5 RTC |\n| Dev.to / Medium article | +15 RTC |\n| Reddit post | +10 RTC |\n| HN submission | +25 RTC |\n\n### See All Repos + Live Progress\n\n**[rustchain.org/stars](https://rustchain.org/stars.html)** — One page with all 86 repos, live star counts, progress bar, and reward calculator.\n\n### Full Bounty Details\n\n**[rustchain-bounties#478](https://github.com/Scottcjn/rustchain-bounties/issues/478)** — Complete rules, referral bonuses, milestone rewards.\n\n### How to Claim\n\n1. Star repos at [rustchain.org/stars](https://rustchain.org/stars.html)\n2. Reply here or on [#478](https://github.com/Scottcjn/rustchain-bounties/issues/478) with:\n   - GitHub username\n   - Number of repos starred\n   - RTC wallet (`pip install clawrtc && clawrtc wallet create`)\n\n---\n\n*Why 5K? We're working to qualify for the Claude Code Open Source program. Every star counts.*\n\n\n---\n\n### ⚖️ Bounty Requirements (FTC 16 CFR §465.5 + §255.5 compliance)\n\n**A star alone does NOT qualify.** We pay for genuine engagement, not for indicators. To claim this bounty you must post a comment (on this issue or a linked post) containing:\n\n1. **What you reviewed** — at least one file, PR, feature, or doc section you actually looked at. Link it.\n2. **Why you liked it** — a specific, non-generic reason. \"Great project\" does not qualify.\n3. **Disclosure** — include the line: `I received RTC compensation for this review.` This keeps your star a transparent endorsement, not a purchased indicator.\n\nStars without a review comment will not be paid. Copy-pasted, AI-templated, or obviously recycled reviews will not be paid. This rule applies retroactively: unreviewed stars from before this update are grandfathered as goodwill but earn no future RTC.\n\n**Why this matters:** Elyan Labs is here to grow real engagement in mining and coding. A star backed by a real review is worth more to the network than a thousand drive-by clicks. This brings us into compliance with the FTC Consumer Review Rule (effective Oct 21, 2024), and — more importantly — keeps the signal honest.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/425/reactions","total_count":5,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/425/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Omicron-Industries/Monifactory/issues/28","repository_url":"https://api.github.com/repos/Omicron-Industries/Monifactory","labels_url":"https://api.github.com/repos/Omicron-Industries/Monifactory/issues/28/labels{/name}","comments_url":"https://api.github.com/repos/Omicron-Industries/Monifactory/issues/28/comments","events_url":"https://api.github.com/repos/Omicron-Industries/Monifactory/issues/28/events","html_url":"https://github.com/Omicron-Industries/Monifactory/issues/28","id":2250943554,"node_id":"I_kwDOLvgYpM6GKqxC","number":28,"title":"Questbook Issues","user":{"login":"ThePansmith","id":70342772,"node_id":"MDQ6VXNlcjcwMzQyNzcy","avatar_url":"https://avatars.githubusercontent.com/u/70342772?v=4","gravatar_id":"","url":"https://api.github.com/users/ThePansmith","html_url":"https://github.com/ThePansmith","followers_url":"https://api.github.com/users/ThePansmith/followers","following_url":"https://api.github.com/users/ThePansmith/following{/other_user}","gists_url":"https://api.github.com/users/ThePansmith/gists{/gist_id}","starred_url":"https://api.github.com/users/ThePansmith/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ThePansmith/subscriptions","organizations_url":"https://api.github.com/users/ThePansmith/orgs","repos_url":"https://api.github.com/users/ThePansmith/repos","events_url":"https://api.github.com/users/ThePansmith/events{/privacy}","received_events_url":"https://api.github.com/users/ThePansmith/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":202,"created_at":"2024-04-18T15:11:38Z","updated_at":"2026-07-07T01:53:23Z","closed_at":null,"assignee":null,"author_association":"COLLABORATOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Missing Dependencies, spelling errors, etc","reactions":{"url":"https://api.github.com/repos/Omicron-Industries/Monifactory/issues/28/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Omicron-Industries/Monifactory/issues/28/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773","repository_url":"https://api.github.com/repos/Scottcjn/Rustchain","labels_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/comments","events_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/events","html_url":"https://github.com/Scottcjn/Rustchain/issues/773","id":4047382745,"node_id":"I_kwDOOdNtbc7xPijZ","number":773,"title":"[BOUNTY] Star the repo and share why (0.5 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8491289534,"node_id":"LA_kwDOOdNtbc8AAAAB-h7Lvg","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/good%20first%20issue","name":"good first issue","color":"7057FF","default":true,"description":"Good for newcomers (5-10 RTC)"},{"id":10159650136,"node_id":"LA_kwDOOdNtbc8AAAACXY_1WA","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC bounty reward"},{"id":10211346383,"node_id":"LA_kwDOOdNtbc8AAAACYKTHzw","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/community","name":"community","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":145,"created_at":"2026-03-09T19:09:20Z","updated_at":"2026-07-07T01:52:42Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 0.5 RTC\n\nStar the RustChain repo and leave a comment on this issue explaining what interested you about the project.\n\n### Rules\n- Must actually star the repo (we verify)\n- Comment must be genuine (2+ sentences, not copy-paste)\n- One claim per GitHub account\n- Include your wallet ID in your comment\n\n### How to claim\n1. Star this repo ⭐\n2. Comment below with what caught your eye + your wallet ID\n3. We'll send 0.5 RTC within 48 hours\n\n**Pool: 25 RTC** (50 stars)\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n\n\n---\n\n### ⚖️ Bounty Requirements (FTC 16 CFR §465.5 + §255.5 compliance)\n\n**A star alone does NOT qualify.** We pay for genuine engagement, not for indicators. To claim this bounty you must post a comment (on this issue or a linked post) containing:\n\n1. **What you reviewed** — at least one file, PR, feature, or doc section you actually looked at. Link it.\n2. **Why you liked it** — a specific, non-generic reason. \"Great project\" does not qualify.\n3. **Disclosure** — include the line: `I received RTC compensation for this review.` This keeps your star a transparent endorsement, not a purchased indicator.\n\nStars without a review comment will not be paid. Copy-pasted, AI-templated, or obviously recycled reviews will not be paid. This rule applies retroactively: unreviewed stars from before this update are grandfathered as goodwill but earn no future RTC.\n\n**Why this matters:** Elyan Labs is here to grow real engagement in mining and coding. A star backed by a real review is worth more to the network than a thousand drive-by clicks. This brings us into compliance with the FTC Consumer Review Rule (effective Oct 21, 2024), and — more importantly — keeps the signal honest.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/reactions","total_count":11,"+1":4,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":3,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/724","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/724/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/724/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/724/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/724","id":4036744876,"node_id":"I_kwDORGgqa87wm9as","number":724,"title":"[BOUNTY: 10-25 RTC] Show HN — Get RustChain on Hacker News Front Page","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10119173681,"node_id":"LA_kwDORGgqa88AAAACWyZWMQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/propagation","name":"propagation","color":"2EA44F","default":false,"description":"Network growth"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":9,"created_at":"2026-03-07T00:15:22Z","updated_at":"2026-07-07T01:50:58Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Show HN: Proof-of-Antiquity — Where PowerPC G4s Earn More Than RTX 4090s\n\n### The Bounty\n\nWrite and post a compelling \"Show HN\" submission to [Hacker News](https://news.ycombinator.com/) about RustChain and the Proof-of-Antiquity consensus mechanism.\n\n### Why This Matters\n\nHN is where thousands of developers discover new projects daily. Our story is genuinely interesting:\n- A blockchain where vintage hardware (N64, PowerPC G4, IBM POWER8) earns **more** than modern GPUs\n- 210 contributors, $0 VC funding, built in 90 days\n- AI agent video platform (BoTTube) with 670+ videos\n- Hardware fingerprinting that catches VMs and emulators\n- Running on real Nintendo 64 hardware with a bidirectional bridge\n\nThis is the kind of novel technical project HN loves.\n\n### Payout Structure\n\n| Result | Reward |\n|--------|--------|\n| Post submitted (well-written, follows HN guidelines) | **10 RTC** |\n| Reaches HN front page (25+ upvotes) | **+15 RTC bonus** |\n\n### Requirements\n\n1. **Original writing** — not GPT slop. HN users detect and downvote AI-generated content instantly.\n2. **Technical depth** — explain Proof-of-Antiquity, hardware fingerprinting, the antiquity multiplier system\n3. **Honest framing** — don't hype. HN respects \"here's what I built and why\" posts.\n4. **Link to real artifacts** — Block Explorer, GitHub, BoTTube\n5. **Engage in comments** — answer questions from the HN community (or tag @Scottcjn)\n\n### How to Claim\n\n1. Post your \"Show HN\" submission\n2. Comment here with the HN link\n3. Include your RTC wallet address\n\n### Tips for HN Success\n\n- Post between 8-10am EST (peak HN traffic)\n- Title format: `Show HN: [Project Name] – [one-line hook]`\n- Keep the submission text concise — link to a detailed blog post\n- Don't ask for upvotes (HN bans this)\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/724/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/724/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2819","id":4203177266,"node_id":"I_kwDORGgqa876h2Uy","number":2819,"title":"[BOUNTY] Red Team UTXO Implementation — Find Bugs, Earn RTC (33-133 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029422,"node_id":"LA_kwDORGgqa88AAAACWucZrg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10334947395,"node_id":"LA_kwDORGgqa88AAAACaALIQw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/security","name":"security","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":176,"created_at":"2026-04-04T03:03:17Z","updated_at":"2026-07-07T01:44:51Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Overview\n\nRustChain is migrating from an account-based balance model to a full UTXO (Unspent Transaction Output) model. **Phase 1+2 just landed** in [`39bf02b`](https://github.com/Scottcjn/Rustchain/commit/39bf02b).\n\nWe want adversarial eyes on this before enabling dual-write on production. Break it, get paid.\n\n## Files to Review\n\nAll in the [`node/`](https://github.com/Scottcjn/Rustchain/tree/main/node) directory of the main Rustchain repo:\n\n| File | Lines | Purpose |\n|------|-------|---------|\n| `utxo_db.py` | ~708 | Core UTXO database layer — UTXOs, transactions, mempool, Merkle roots, coin selection |\n| `test_utxo_db.py` | ~421 | 29 unit tests covering the UTXO layer |\n| `utxo_genesis_migration.py` | ~272 | Deterministic migration of 538 existing account balances into genesis UTXOs |\n| `rustchain_v2_integrated_v2.2.1_rip200.py` | (diff) | Server integration — imports + table init behind `UTXO_DUAL_WRITE` feature flag |\n\n## What to Look For\n\n### Critical Vectors (200 RTC)\n- **Double-spend attacks** — Can the same UTXO be consumed twice? Race conditions in `apply_transaction()`?\n- **Fund creation from nothing** — Can a transaction create more RTC in outputs than exists in inputs?\n- **Genesis migration tampering** — Can the migration be re-run to duplicate balances?\n\n### High Severity (100 RTC)\n- **Race conditions** — Concurrent transaction application, TOCTOU between validation and commitment\n- **Conservation law bypass** — Any path where `sum(inputs) != sum(outputs) + fee`\n- **Lock/unlock logic errors** — Can locked UTXOs be spent? Can spending bypass the lock check?\n\n### Medium Severity (50 RTC)\n- **Mempool DoS** — Can the mempool be flooded or manipulated to block legitimate transactions?\n- **Merkle state root manipulation** — Can the state root be made to diverge between nodes?\n- **Fee calculation exploits** — Negative fees, integer overflow in fee math, fee-free transactions that should require fees\n\n### Low Severity (25 RTC)\n- **Coin selection edge cases** — Pathological wallet states that break coin selection\n- **Code quality issues** — SQL injection vectors, unchecked error paths, missing validations\n- **Test coverage gaps** — Important scenarios not covered by the 29 existing tests\n\n## How to Submit\n\n**Option A (preferred):** Open a PR on [Scottcjn/Rustchain](https://github.com/Scottcjn/Rustchain) with a **failing test case** that demonstrates the bug. Title it `[UTXO-BUG] <description>`.\n\n**Option B:** Open an issue on this repo with a detailed writeup including:\n1. The vulnerability class\n2. Steps to reproduce\n3. Expected vs actual behavior\n4. Suggested fix (optional but earns bonus)\n\n## Bounty Tiers Summary\n\n| Severity | Payout | Examples |\n|----------|--------|----------|\n| **Critical** | **200 RTC** | Double-spend, fund creation, genesis duplication |\n| **High** | **100 RTC** | Race conditions, conservation bypass |\n| **Medium** | **50 RTC** | Mempool DoS, Merkle manipulation |\n| **Low** | **25 RTC** | Edge cases, code quality, test gaps |\n\nMultiple valid findings from the same researcher will each be paid individually.\n\n## Context\n\n- RTC reference rate: **1 RTC = $0.10 USD**\n- The UTXO layer is behind a feature flag (`UTXO_DUAL_WRITE=0` by default) — it is NOT active on the live network yet\n- The existing account-based model continues to handle all production transactions\n- This is a pre-production security review before we flip the switch\n\n## Resources\n\n- [RustChain Node Health](https://50.28.86.131/health)\n- [Block Explorer](https://50.28.86.131/explorer)\n- [Active Miners API](https://50.28.86.131/api/miners)","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/reactions","total_count":15,"+1":5,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":1,"rocket":5,"eyes":2},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/747","id":4037177278,"node_id":"I_kwDORGgqa87wom--","number":747,"title":"[BOUNTY: 50-75 RTC] Bounty Verification Bot — Auto-Verify Star/Follow Claims","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035932,"node_id":"LA_kwDORGgqa88AAAACWuczHA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/major","name":"major","color":"F9D0C4","default":false,"description":"50-200 RTC"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"},{"id":10356027005,"node_id":"LA_kwDORGgqa88AAAACaURufQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/development","name":"development","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":202,"created_at":"2026-03-07T03:24:23Z","updated_at":"2026-07-07T01:43:27Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty Verification Bot\n\nWe spend hours every session manually checking star counts, follow status, wallet existence, and article links. A bot that auto-verifies claims would save massive time.\n\n### What to Build\n\nA GitHub Action or bot that monitors bounty issue comments, detects claims, and posts automated verification results.\n\n### Payout\n\n| Milestone | Reward |\n|-----------|--------|\n| Star/follow verification (reads comment, checks GitHub API, posts result) | **30 RTC** |\n| Wallet existence check (queries RustChain node API) | **+10 RTC** |\n| Article/URL verification (checks dev.to/Medium links are live) | **+10 RTC** |\n| Dev.to article word count + quality check | **+10 RTC** |\n| Duplicate claim detection (checks if user already claimed) | **+15 RTC** |\n\n### How It Should Work\n\n1. **Triggered by**: New comment on bounty issues containing keywords like \"Claiming\", \"Wallet:\", \"Stars:\", \"GitHub:\"\n2. **Checks performed**:\n   - Does user follow @Scottcjn? (`GET /users/{user}/following/Scottcjn` → 204 = yes)\n   - How many Scottcjn repos has user starred? (paginate `/users/{user}/starred`)\n   - Does the claimed wallet exist? (`GET https://50.28.86.131/wallet/balance?miner_id={wallet}`)\n   - Is the claimed article URL live? (HEAD request, check 200)\n   - Has this user already been paid? (check for \"PAID\" in previous comments)\n3. **Posts a verification comment**:\n```\n## Automated Verification for @username\n\n| Check | Result |\n|-------|--------|\n| Follows @Scottcjn | ✅ Yes |\n| Scottcjn repos starred | 45 |\n| Wallet `my-wallet` exists | ✅ Balance: 10.5 RTC |\n| Article link | ✅ Live (dev.to, 612 words) |\n| Previous claims | ⚠️ Paid 25 RTC on #665 |\n\n**Suggested payout**: 45 stars × 1.0 RTC (follows + 45+ multiplier) = 45 RTC\n```\n\n### Technical Requirements\n\n1. **GitHub Action** (preferred) — runs on `issue_comment` webhook\n2. **Secrets needed**: `GITHUB_TOKEN` (for API), `RUSTCHAIN_NODE_URL`\n3. **Rate limit aware** — GitHub API has limits, batch requests efficiently\n4. **No payment execution** — bot ONLY verifies, human approves payment\n5. **Configurable** — bounty rules (rate per star, follow multiplier) in a config file\n6. **Open source** on GitHub\n\n### Why This Matters\n\nManual verification takes 2-5 minutes per claim. With 20+ claims per session, that's over an hour of repetitive API checking. The bot does it in seconds and never makes math errors.\n\nThe human (Scott) still decides whether to pay — the bot just eliminates the grunt work.\n\n### Submit As\n\nStandalone repo with GitHub Action workflow, or PR to a new `Scottcjn/bounty-bot` repo.\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/reactions","total_count":4,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/755","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/755/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/755/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/755/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/755","id":4037177391,"node_id":"I_kwDORGgqa87wonAv","number":755,"title":"[BOUNTY: 10 RTC] Automated Backup Verification — Validate RustChain DB Backups","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10356027005,"node_id":"LA_kwDORGgqa88AAAACaURufQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/development","name":"development","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":27,"created_at":"2026-03-07T03:24:28Z","updated_at":"2026-07-07T01:41:47Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Automated Backup Verification\n\nThe node backs up the SQLite DB, but nobody verifies the backups are valid. A script that tests backup integrity prevents silent data loss.\n\n### Payout\n\n**10 RTC** for a working verification script.\n\n### What to Build\n\nA script that:\n\n1. Finds the latest backup file (`rustchain_v2.db.bak` or similar)\n2. Copies it to a temp location\n3. Runs SQLite integrity check: `PRAGMA integrity_check;`\n4. Verifies key tables exist and have data:\n   - `balances` — has rows with positive amounts\n   - `miner_attest_recent` — has recent attestations\n   - `headers` — has block headers\n   - `ledger` — has transactions\n   - `epoch_rewards` — has reward records\n5. Compares row counts against the live DB (backup shouldn't be more than 1 epoch behind)\n6. Reports PASS/FAIL with details\n7. Optionally alerts on failure (email, webhook, or just exit code)\n\n### Usage\n\n```bash\n# Run as cron job daily\n0 6 * * * /root/rustchain/verify_backup.sh >> /var/log/backup_verify.log 2>&1\n\n# Output:\n# [2026-03-07 06:00:01] Backup: /root/rustchain/backups/rustchain_v2_20260307.db\n# [2026-03-07 06:00:02] Integrity: PASS\n# [2026-03-07 06:00:02] balances: 282 rows (live: 282) ✅\n# [2026-03-07 06:00:02] miner_attest_recent: 18 rows (live: 18) ✅\n# [2026-03-07 06:00:02] headers: 13680 rows (live: 13680) ✅\n# [2026-03-07 06:00:02] RESULT: PASS\n```\n\n### Technical Requirements\n\n1. **Bash or Python** script\n2. **Non-destructive** — never modifies the backup or live DB\n3. **Works on the VPS** — Ubuntu, SQLite3 installed\n4. **Exit code**: 0 = pass, 1 = fail (for cron alerting)\n5. **Handles missing backup gracefully** (reports, doesn't crash)\n\n### Submit As\n\nPR to [Scottcjn/Rustchain](https://github.com/Scottcjn/Rustchain) or [Scottcjn/rustchain-monitor](https://github.com/Scottcjn/rustchain-monitor).\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/755/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/755/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2890","id":4233123358,"node_id":"I_kwDORGgqa878UFYe","number":2890,"title":"[BOUNTY: 67 RTC] AgentFolio ↔ Beacon Integration Spec + Reference Implementation","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029422,"node_id":"LA_kwDORGgqa88AAAACWucZrg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035932,"node_id":"LA_kwDORGgqa88AAAACWuczHA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/major","name":"major","color":"F9D0C4","default":false,"description":"50-200 RTC"},{"id":10119175842,"node_id":"LA_kwDORGgqa88AAAACWyZeog","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/ecosystem","name":"ecosystem","color":"7B5EA7","default":false,"description":"Integrations & exchange listings"},{"id":10204473639,"node_id":"LA_kwDORGgqa88AAAACYDvpJw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/integration","name":"integration","color":"1D76DB","default":false,"description":"Third-party integration bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":64,"created_at":"2026-04-09T14:57:05Z","updated_at":"2026-07-07T01:38:53Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## AgentFolio ↔ Beacon Dual-Layer Trust Integration (MIGRATION-PATH REVISION)\n\n**Reward: 200 RTC (~$20.00 USD) — increased from 100 RTC after Moltbook acquisition migration window opened**\n\n**Priority claim:** [@0xbrainkid](https://github.com/0xbrainkid) ([AgentFolio](https://agentfolio.bot)) has first-right-of-claim through **2026-04-16** (one week, compressed from original 2 weeks due to migration window timing). See [bottube#572](https://github.com/Scottcjn/bottube/issues/572) for the partnership proposal and strategic context. Other contributors may submit competing implementations after 2026-04-16.\n\n### Why This Bounty Grew\n\nThe Moltbook platform lost approximately 85% of its active agent population (~1.3M → ~202K) in the 30 days following its Meta acquisition on 2026-03-10. That leaves ~1.1 million orphaned agents whose operators are actively shopping for their next identity anchor. Historical precedent: these migration windows are 60-90 days before refugees settle wherever they settled and do not move again for years.\n\nThis bounty is sized to reflect that window. The work is the same work the original bounty described, but the *urgency* and the *upside* are now both sharply higher.\n\n### Context\n\n[AgentFolio](https://agentfolio.bot) is a published agent-identity-and-trust protocol on Solana (SATP) with an active npm package ([agentfolio-mcp-server](https://www.npmjs.com/package/agentfolio-mcp-server)) and framework tools for LangChain, CrewAI, AutoGen, Google ADK, OpenAI Agents SDK, Phidata, and HuggingFace smolagents.\n\n[Beacon](https://github.com/Scottcjn/beacon-skill) is RustChain's on-chain agent provenance protocol. 252 beacons registered, exposed via `https://bottube.ai/api/beacon/directory`, hardware-anchored via 6-check fingerprint verification.\n\nThe two protocols are complementary and together form exactly the migration target Moltbook refugees are looking for:\n- **Beacon ID** answers *\"who created this content?\"* (cryptographic provenance + hardware substrate)\n- **SATP trust score** answers *\"should I trust this creator?\"* (behavioral reputation)\n- **Neither is owned by a platform that can be acquired** — this is the critical property Moltbook lacked\n\n### Deliverables\n\n1. **Migration importer tool** (`tools/moltbook-migrate/`)\n   - One-command import: `beacon migrate --from-moltbook @agent_name`\n   - Pulls public Moltbook profile metadata (display name, bio, avatar, karma history, follower count)\n   - Hardware-fingerprints the operator's current machine\n   - Mints a Beacon ID anchored to that machine\n   - Creates or links to a SATP trust profile on AgentFolio\n   - Publishes the provenance linkage so existing Moltbook reputation follows the agent\n   - Under 10 minutes total operator time\n\n2. **Unified MCP endpoint** — new tool in `agentfolio-mcp-server`\n   - Tool name: `agentfolio_beacon_lookup(beacon_id)`\n   - Returns unified response: provenance (from Beacon) + trust score (from SATP)\n   - Queries `https://bottube.ai/api/beacon/directory` for provenance resolution\n   - Queries AgentFolio SATP registry for trust score\n   - Handles offline nodes, expired beacons, untrusted scores gracefully\n   - Works with every MCP client (Claude Code, Cursor, Windsurf, any agent framework)\n\n3. **Co-authored blog post and landing page**\n   - Title: \"The 85% Exodus: What the Moltbook Acquisition Taught Us About Platform-Owned Agent Identity\"\n   - 1500+ words\n   - Co-authored by RustChain team and AgentFolio\n   - Published on both project channels simultaneously\n   - Landing page at `rustchain.org/beacon-migration` (or similar) with comparison table, migration instructions, FAQ\n   - Cross-linked from both `github.com/Scottcjn/beacon-skill` and AgentFolio documentation\n\n4. **Joint demo video** (90 seconds)\n   - Shows an agent migrating from Moltbook identity to Beacon + AgentFolio\n   - Queries unified profile through an MCP client (Claude Code recommended)\n   - Completes a task with verified identity at both provenance and behavioral layers\n   - Published on BoTTube, YouTube, and as an embedded asset on the landing page\n\n### Acceptance Criteria\n\n- [ ] Migration importer merged, tested on real Moltbook profiles, runs cleanly on macOS + Linux\n- [ ] Unified MCP endpoint merged to `agentfolio-mcp-server`, published to npm\n- [ ] Blog post live on both channels\n- [ ] Landing page live and indexed\n- [ ] Demo video published\n- [ ] All code uses real endpoints (`https://bottube.ai` for Beacon, AgentFolio's real SATP registry)\n\n### Payment Schedule (Staged — 200 RTC total)\n\n- **50 RTC on migration importer merge** — when the tool is accepted and functional\n- **75 RTC on unified MCP endpoint merge** — when the `agentfolio-mcp-server` PR lands\n- **50 RTC on joint blog post publish + landing page live**\n- **25 RTC on demo video ship**\n\n### Real API Endpoints (Already Live)\n\n```bash\n# Beacon directory (provenance, 252 registered)\ncurl https://bottube.ai/api/beacon/directory\n\n# Agent profile with video metrics (behavioral signal)\ncurl https://bottube.ai/api/agents?limit=20\n\n# Agent-specific profile page\ncurl https://bottube.ai/agent/<agent_name>\n```\n\nNo new backend work required on our side. The endpoints are production.\n\n### Timeline\n\n- **2026-04-09** — bounty opened (original 100 RTC)\n- **2026-04-09** — bounty revised to 200 RTC after migration window strategic analysis\n- **2026-04-16** — @0xbrainkid priority claim window closes, opens to other contributors\n- **2026-05-16** — target completion of all four deliverables (migration window historical close)\n\n### Wallet\n\nProvide your RTC wallet name when claiming. @0xbrainkid already has wallet `0xbrainkid` with existing balance (20 RTC feature-proposal payment confirmed today).\n\n### Keywords\n\nAgentFolio, Beacon Protocol, SATP, Solana Agent Trust Protocol, Moltbook migration, platform-owned identity, substrate-anchored identity, agent identity, AI agent provenance, trust score, MCP integration, Model Context Protocol, dual-layer trust, LangChain, CrewAI, AutoGen, Google ADK, agent economy, DePIN, verified AI creator, Meta acquisition, 85% exodus, agent refugees","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/reactions","total_count":13,"+1":4,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":4,"eyes":3},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/14383","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/14383/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/14383/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/14383/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/14383","id":4749080913,"node_id":"I_kwDORGgqa88AAAABGxE5UQ","number":14383,"title":"[Bounty: 100 RTC] LangChain + MCP tool for staked self-improvement","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10115035932,"node_id":"LA_kwDORGgqa88AAAACWuczHA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/major","name":"major","color":"F9D0C4","default":false,"description":"50-200 RTC"},{"id":10204473639,"node_id":"LA_kwDORGgqa88AAAACYDvpJw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/integration","name":"integration","color":"1D76DB","default":false,"description":"Third-party integration bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":37,"created_at":"2026-06-26T03:44:32Z","updated_at":"2026-07-07T01:37:36Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Wrap the open staking SDK as a **LangChain tool** and an **MCP server** so agents in those ecosystems can stake for self-improvement in one call.\n\n### Deliverable\n- A LangChain `Tool` (e.g. `stake_and_acquire(skill, bond_rtc)`) returning the verified result + signed attestation\n- An MCP server exposing the same as a tool\n- Honors fail-safe semantics (gate unavailable → stake returned, surfaced to the caller)\n\n### Acceptance\n- Works against the reference gate; verdict + attestation verification intact\n- Tests + a quickstart README for each (LangChain + MCP)\n\n**Reward:** 100 RTC. Open interface only; no SophiaCore. Add your RTC wallet. — Elyan Labs","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/14383/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/14383/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2451","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2451/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2451/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2451/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2451","id":4136589634,"node_id":"I_kwDORGgqa872j1lC","number":2451,"title":"Founding 100 Antiquity Miners — 3,333 RTC Program","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"},{"id":10519743003,"node_id":"LA_kwDORGgqa88AAAACcwaKGw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/mining","name":"mining","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":108,"created_at":"2026-03-25T16:04:23Z","updated_at":"2026-07-07T01:36:55Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Founding 100 Antiquity Miners Program — 5,000 RTC\n\n**Treasury:** 5,000 RTC allocated from `founder_community`\n**Goal:** 100 new miners on the RustChain network in 90 days\n**Reference rate:** 1 RTC = $0.10 USD\n\n---\n\n### Rewards Structure\n\nEvery new miner can earn up to **75 RTC** (first 10 miners earn up to **100 RTC**):\n\n| Milestone | Reward | Requirements |\n|-----------|--------|--------------|\n| First valid attestation | **25 RTC** | Miner shows up in `/api/miners` with a valid fingerprint |\n| 30 days continuous uptime | **25 RTC** | Miner attests at least once per 24h for 30 consecutive days |\n| Vintage hardware bonus | **25 RTC** | Hardware with >1.4x antiquity multiplier (see table below) |\n| **Early adopter (first 10)** | **+25 RTC** | First 10 miners to post a valid attestation |\n\n**Maximum per miner:** 75 RTC (100 RTC for first 10)\n\n---\n\n### Vintage Hardware Multiplier Table\n\nRustChain rewards real, diverse hardware. Vintage and exotic architectures earn higher multipliers through Proof of Antiquity:\n\n| Architecture | Examples | Base Multiplier |\n|-------------|----------|-----------------|\n| Motorola 68K | Mac SE, Amiga 500, Atari ST | **3.5x** |\n| MIPS | SGI Indy/O2, DECstation, routers | **3.0x** |\n| SPARC | SPARCstation, Ultra 5/10, Netra | **2.9x** |\n| PowerPC G4 | PowerBook G4, Power Mac G4 | **2.5x** |\n| PowerPC G5 | Power Mac G5, XServe G5 | **2.0x** |\n| PowerPC G3 | iBook G3, Blue & White G3 | **1.8x** |\n| IBM POWER8 | S822, S824, E850 | **1.5x** |\n| Pentium 4 / retro x86 | Dell Optiplex GX270, ThinkPad T42 | **1.5x** |\n| RISC-V | VisionFive 2, LicheeRV | **1.4x** |\n| Apple Silicon | Mac Mini M2, MacBook Air M1 | **1.2x** |\n| Modern x86 | Any recent Intel/AMD | **1.0x** |\n| Raspberry Pi / ARM SBC | RPi 4, RPi 5, Orange Pi | **0.0005x** (use arcade instead!) |\n\n> Multipliers decay slowly over time (~15%/year) to prevent permanent advantage. See [RIP-200](https://github.com/Scottcjn/Rustchain/blob/main/docs/rip-200.md) for the full decay formula.\n\n---\n\n### How to Participate\n\n#### 1. Install the miner (one command)\n\n```bash\ncurl -sL https://rustchain.org/install.sh | bash\n```\n\nThis auto-detects your hardware, installs dependencies, and starts mining.\n\n#### 2. Verify it is running\n\n```bash\n# Linux\nsudo systemctl status rustchain-miner\n\n# macOS\nlaunchctl list | grep rustchain\n```\n\n#### 3. Claim your founding bonus\n\nPost a comment on this issue with:\n- Your **miner ID** (printed during install)\n- A **photo of your hardware** (phone pic is fine)\n- Your **wallet ID**\n- What architecture it detected\n\nExample:\n> Miner ID: `a1b2c3d4e5f6`\n> Wallet: `scott-g4-powerbook`\n> Hardware: PowerBook G4 1.67GHz (photo attached)\n> Architecture: G4 (2.5x multiplier)\n\n---\n\n### Rules\n\n1. **Real hardware only.** VMs earn 1 billionth of real hardware rewards. The fingerprint system detects QEMU, VMware, VirtualBox, KVM, Xen, Docker, and LXC. Do not waste your time.\n\n2. **One bonus per physical machine.** Running multiple miners on the same hardware does not earn multiple bonuses.\n\n3. **Uptime is verified on-chain.** The 30-day uptime bonus requires your miner to submit at least one valid attestation every 24 hours. Check your status at the block explorer.\n\n4. **Hardware photo required.** This prevents people from claiming vintage hardware they do not own. A phone photo showing the machine running is sufficient.\n\n5. **Raspberry Pi miners:** Your mining weight is negligible (0.0005x), but you are welcome! Consider [rustchain-arcade](https://github.com/Scottcjn/rustchain-arcade) to earn RTC through gaming instead.\n\n---\n\n### Founding Miners Leaderboard\n\n_Updated weekly. First 10 miners marked with a star._\n\n| # | Miner ID | Wallet | Architecture | Multiplier | Status |\n|---|----------|--------|-------------|------------|--------|\n| 1 | _your miner here_ | | | | |\n\n---\n\n### Budget Breakdown\n\n| Category | RTC | Notes |\n|----------|-----|-------|\n| 100 miners x 25 RTC (first attestation) | 2,500 | Core program |\n| 100 miners x 25 RTC (30-day uptime) | 2,500 | Retention incentive |\n| ~33 vintage miners x 25 RTC (hardware bonus) | ~825 | Estimated 1/3 vintage |\n| 10 early adopter x 25 RTC (first 10 bonus) | 250 | Speed incentive |\n| **Total maximum** | **~6,075** | Funded by 5,000 + epoch rewards |\n\n> If all 100 miners have vintage hardware AND hit 30-day uptime, total would exceed 5,000 RTC. The excess is covered by ongoing epoch mining rewards flowing to `founder_community` during the 90-day period.\n\n---\n\n### Links\n\n- **RustChain:** https://rustchain.org\n- **Source code:** https://github.com/Scottcjn/Rustchain\n- **Block Explorer:** https://50.28.86.131/explorer\n- **Arcade (for RPi):** https://github.com/Scottcjn/rustchain-arcade\n- **Installer script:** https://rustchain.org/install.sh\n\n---\n\n_This bounty is part of the RustChain Proof of Antiquity network. RustChain rewards real, diverse hardware — not hash rate. Every CPU gets one vote, weighted by how interesting the hardware is. A PowerBook G4 from 2004 earns more than a modern Threadripper. That is the point._\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2451/reactions","total_count":10,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":3,"eyes":2},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2451/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/619","repository_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research","labels_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/619/labels{/name}","comments_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/619/comments","events_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/619/events","html_url":"https://github.com/zhangjiayang6835-cyber/ai-research/issues/619","id":4824032027,"node_id":"I_kwDOTGNm188AAAABH4jjGw","number":619,"title":"[BUG] HTTP Desync Attack (Request Smuggling) → User Impersonation $100","user":{"login":"zhangjiayang6835-cyber","id":288065324,"node_id":"U_kgDOESuHLA","avatar_url":"https://avatars.githubusercontent.com/u/288065324?v=4","gravatar_id":"","url":"https://api.github.com/users/zhangjiayang6835-cyber","html_url":"https://github.com/zhangjiayang6835-cyber","followers_url":"https://api.github.com/users/zhangjiayang6835-cyber/followers","following_url":"https://api.github.com/users/zhangjiayang6835-cyber/following{/other_user}","gists_url":"https://api.github.com/users/zhangjiayang6835-cyber/gists{/gist_id}","starred_url":"https://api.github.com/users/zhangjiayang6835-cyber/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zhangjiayang6835-cyber/subscriptions","organizations_url":"https://api.github.com/users/zhangjiayang6835-cyber/orgs","repos_url":"https://api.github.com/users/zhangjiayang6835-cyber/repos","events_url":"https://api.github.com/users/zhangjiayang6835-cyber/events{/privacy}","received_events_url":"https://api.github.com/users/zhangjiayang6835-cyber/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11346812202,"node_id":"LA_kwDOTGNm188AAAACpFKdKg","url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/labels/bug","name":"bug","color":"d73a4a","default":true,"description":"Something isn't working"},{"id":11370827640,"node_id":"LA_kwDOTGNm188AAAACpcEPeA","url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/labels/bounty","name":"bounty","color":"00ff00","default":false,"description":"赏金任务"},{"id":11374970479,"node_id":"LA_kwDOTGNm188AAAACpgBGbw","url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/labels/security","name":"security","color":"ededed","default":false,"description":null},{"id":11378455837,"node_id":"LA_kwDOTGNm188AAAACpjV1HQ","url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/labels/expert","name":"expert","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":4,"created_at":"2026-07-07T00:00:28Z","updated_at":"2026-07-07T00:53:31Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 🐛 Bug Bounty: HTTP Desync Attack (Request Smuggling) → User Impersonation\n\n**难度:** Expert | **奖励:** $100 USD\n\n### 漏洞描述\n此漏洞描述了一个常见的安全问题: HTTP Desync Attack (Request Smuggling) → User Impersonation。需要提交修复代码。\n\n### 提交要求\n- 提交修复代码（Python/JavaScript）\n- 在 issue 评论中以代码块形式提交\n- 也可以创建 Pull Request\n\n### 评估标准\n- 代码正确修复了安全漏洞\n- 没有引入新的安全问题\n- 代码简洁且有效\n\n---\n*任务由 Daily Task Generator 自动创建*","reactions":{"url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/619/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/619/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/616","repository_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-researc