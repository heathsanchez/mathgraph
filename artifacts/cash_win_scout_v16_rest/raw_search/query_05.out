WwxMDMzMjA0MjMz","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/overlay","name":"overlay","color":"444444","default":false,"description":"Steam overlay is involved"},{"id":1100561692,"node_id":"MDU6TGFiZWwxMTAwNTYxNjky","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/XAudio2","name":"XAudio2","color":"FAEBD7","default":false,"description":"Uses the XAudio2 subsystem"},{"id":1113044448,"node_id":"MDU6TGFiZWwxMTEzMDQ0NDQ4","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/Mesa%20drivers","name":"Mesa drivers","color":"dc143c","default":false,"description":"Possibly involves an issue with a Mesa video driver"},{"id":2012203775,"node_id":"MDU6TGFiZWwyMDEyMjAzNzc1","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/AMD%20RADV","name":"AMD RADV","color":"dc143c","default":false,"description":"Possible driver issues with RADV"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":449,"created_at":"2020-05-22T06:31:42Z","updated_at":"2026-07-06T21:55:43Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# Compatibility Report\r\n- Name of the game with compatibility issues: Hunt Showdown\r\n- Steam AppID of the game: 594650\r\n\r\n## System Information\r\n- GPU: AMD Radeon HD5700\r\n- Driver/LLVM version: Mesa 20.2\r\n- Kernel version: 5.6.0-050600-generic\r\n- Link to full system information report as [Gist](https://gist.github.com/r3l0c/4b22617bd4dd5181dd16e06365355a33):\r\n- Proton version: Any version\r\n\r\n## I confirm:\r\n- [x] that I haven't found an existing compatibility report for this game.\r\n- [x] that I have checked whether there are updates for my system available.\r\n\r\n`PROTON_LOG=1 %command%` [steam-594650.log](https://github.com/ValveSoftware/Proton/files/4666409/steam-594650.log)\r\n\r\ngame.log [game.log](https://github.com/ValveSoftware/Proton/files/4666410/game.log)\r\n\r\n\r\n## Symptoms <!-- What's the problem? -->\r\nIf proton version lower 4 then black screen and process info in task manager: kernel wait \"pipe_read\"\r\nif proton version > 4 then Easy Anti Cheat cannot run with message box `ERROR: Failed to create EAC game client interface.` \r\n\r\n## Reproduction\r\n**Game not run any times, no need special reproducer**\r\n","reactions":{"url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/88464","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/88464/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/88464/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/88464/events","html_url":"https://github.com/Expensify/App/issues/88464","id":4304426499,"node_id":"I_kwDOEQqHYc8AAAABAJBWAw","number":88464,"title":"[$250] Invoice - Unexpected error when paying invoice with business account","user":{"login":"jponikarchuk","id":141990088,"node_id":"U_kgDOCHaYyA","avatar_url":"https://avatars.githubusercontent.com/u/141990088?v=4","gravatar_id":"","url":"https://api.github.com/users/jponikarchuk","html_url":"https://github.com/jponikarchuk","followers_url":"https://api.github.com/users/jponikarchuk/followers","following_url":"https://api.github.com/users/jponikarchuk/following{/other_user}","gists_url":"https://api.github.com/users/jponikarchuk/gists{/gist_id}","starred_url":"https://api.github.com/users/jponikarchuk/