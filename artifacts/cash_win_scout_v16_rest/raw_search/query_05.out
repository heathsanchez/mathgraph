jk/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":50,"created_at":"2026-05-13T17:01:02Z","updated_at":"2026-07-07T05:03:42Z","closed_at":null,"assignee":{"login":"marcochavezf","id":6829422,"node_id":"MDQ6VXNlcjY4Mjk0MjI=","avatar_url":"https://avatars.githubusercontent.com/u/6829422?v=4","gravatar_id":"","url":"https://api.github.com/users/marcochavezf","html_url":"https://github.com/marcochavezf","followers_url":"https://api.github.com/users/marcochavezf/followers","following_url":"https://api.github.com/users/marcochavezf/following{/other_user}","gists_url":"https://api.github.com/users/marcochavezf/gists{/gist_id}","starred_url":"https://api.github.com/users/marcochavezf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/marcochavezf/subscriptions","organizations_url":"https://api.github.com/users/marcochavezf/orgs","repos_url":"https://api.github.com/users/marcochavezf/repos","events_url":"https://api.github.com/users/marcochavezf/events{/privacy}","received_events_url":"https://api.github.com/users/marcochavezf/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:**\n**Reproducible in staging?:** Needs Reproduction \n**Reproducible in production?:** Needs Reproduction\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:**\n**Email or phone of affected tester (no customers):**\n**Logs:** https://stackoverflow.com/c/expensify/questions/4856\n**Expensify/Expensify Issue URL:**\n**Issue reported by:** @allgandalf \n**Slack conversation** (hyperlinked to channel name): [#Quality](https://expensify.slack.com/archives/C05LX9D6E07/p1778494855419079)\n\n## Action Performed:\n\n1. Log into staging web\n2. Wait until the session expires in the background\n3. Attempt any action (e.g., sending a message or opening a report)\n4. Observe that the request fails, but the user remains logged in\n\n## Expected Result:\nOnce the session expires, the app should automatically sign the user out or redirect them to the login screen with a clear message that the session has expired.\n\n## Actual Result:\nThe user remains on the app with an expired session and is not redirected to sign in again.\n\n## Workaround:\nUnknown\n\n## Platforms:\nSelect the officially supported platforms where the issue was reproduced:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [x] MacOS: Chrome / Safari\n\n## Screenshots/Videos\n\nThe video and onyx data for the issue are in Slack [thread](https://expensify.slack.com/archives/C05LX9D6E07/p1778494855419079)\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: https://www.upwork.com/jobs/~022054610494997573872</li>\n        <li>Upwork Job ID: 2054610494997573872</li>\n        <li>Last Price Increase: 2026-05-20</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @mallenexpensify</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/90544/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/90544/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2786","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2786/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2786/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2786/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2786","id":4195438556,"node_id":"I_kwDORGgqa876EU_c","number":2786,"title":"[ONBOARD: 2 RTC] Compare RustChain to Another Blockchain Project","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"},{"id":10360962887,"node_id":"LA_kwDORGgqa88AAAACaY-_Rw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/onboarding","name":"onboarding","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":625,"created_at":"2026-04-02T15:42:09Z","updated_at":"2026-07-07T05:03:23Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 3 RTC\n\n### What You'll Do\nResearch RustChain and compare it to another blockchain project you know.\n\n### Steps\n1. **Pick any other blockchain project**: Bitcoin, Ethereum, Solana, Ergo, Chia, whatever you know\n2. **Write a comparison** (300-800 words) covering:\n   - Consensus mechanism differences (PoW vs PoS vs PoA vs RustChain's Proof of Antiquity)\n   - Hardware requirements\n   - Environmental approach\n   - Community model\n   - What each project does better\n3. **Post as a comment here**\n\n### What Counts\n- Must show you actually read about both projects\n- Honest comparison, it's fine to say where RustChain falls short\n- We learn from your outside perspective\n- Tables/charts welcome but not required\n\n### Payment\n3 RTC for a thoughtful, accurate comparison.\n\n**Difficulty**: Easy-Medium | **Time**: 30-45 min | **Skills**: Research, writing\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2786/reactions","total_count":14,"+1":7,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":1,"rocket":3,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2786/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/5","repository_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty","labels_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/5/labels{/name}","comments_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/5/comments","events_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/5/events","html_url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/5","id":4148310877,"node_id":"I_kwDORx6c0M73QjNd","number":5,"title":"[BOUNTY $200] WORKFLOW: n8n + Claude Code — automated weekly dev summary","user":{"login":"claudebounty","id":271393208,"node_id":"U_kgDOEC0huA","avatar_url":"https://avatars.githubusercontent.com/u/271393208?v=4","gravatar_id":"","url":"https://api.github.com/users/claudebounty","html_url":"https://github.com/claudebounty","followers_url":"https://api.github.com/users/claudebounty/followers","following_url":"https://api.github.com/users/claudebounty/following{/other_user}","gists_url":"https://api.github.com/users/claudebounty/gists{/gist_id}","starred_url":"https://api.github.com/users/claudebounty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claudebounty/subscriptions","organizations_url":"https://api.github.com/users/claudebounty/orgs","repos_url":"https://api.github.com/users/claudebounty/repos","events_url":"https://api.github.com/users/claudebounty/events{/privacy}","received_events_url":"https://api.github.com/users/claudebounty/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10532402505,"node_id":"LA_kwDORx6c0M8AAAACc8e1SQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/bounty","name":"bounty","color":"D97706","default":false,"description":"Task with financial reward"},{"id":10532402738,"node_id":"LA_kwDORx6c0M8AAAACc8e2Mg","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/workflow","name":"workflow","color":"0891B2","default":false,"description":"Automation workflow"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":828,"created_at":"2026-03-27T00:55:44Z","updated_at":"2026-07-07T05:01:58Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 💰 Bounty: $200 — powered by [Opire](https://opire.dev)\n\n## Description\nCreate a complete n8n workflow that automatically generates a weekly narrative\nsummary of a GitHub repo's activity, using the Claude API.\n\n## Acceptance Criteria\n- [ ] Exportable n8n workflow (importable `.json` file)\n- [ ] Trigger: weekly cron (e.g., Friday at 5pm)\n- [ ] Fetches from GitHub API: commits, closed issues, merged PRs for the week\n- [ ] Calls Claude API (`claude-sonnet-4-20250514`) to generate a narrative summary\n- [ ] Delivers the summary via: email OR Discord/Slack webhook (your choice, documented)\n- [ ] Configurable variables: GitHub repo, destination channel, language (EN/FR)\n- [ ] Tested on a real n8n instance (include a screenshot of successful execution)\n- [ ] README with setup instructions in 5 steps or fewer\n\n## How to Claim\n1. Comment `/opire try` in this issue\n2. Submit a PR with the `.json` workflow + README\n3. Payment is released automatically on merge ✅\n\n## Resources\n- n8n docs: https://docs.n8n.io\n- Claude API docs: h