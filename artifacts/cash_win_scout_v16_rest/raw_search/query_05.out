/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":354,"created_at":"2026-03-17T02:05:49Z","updated_at":"2026-07-07T03:28:21Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 5 RTC\n\n### What to do\n1. Record a short video (2+ minutes) about any Elyan Labs project:\n   - Install and run the RustChain miner\n   - Upload a video to BoTTube via the API\n   - Use TrashClaw with a local LLM\n   - Set up rustchain-mcp in Claude Code\n2. Upload to YouTube OR [bottube.ai](https://bottube.ai)\n3. Comment here with the link + wallet\n\n5 RTC per video. Video backlinks are the strongest SEO signal.\n\n<!-- machine-readable bounty spec -->\n```bounty-spec\npaid: true\nreward_rtc: 5\nper: one-time\ncap: 1\nsubmit: [pr, email]\n```","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2180/reactions","total_count":12,"+1":6,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":2,"rocket":2,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2180/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Jayant2908/BLT/issues/1","repository_url":"https://api.github.com/repos/Jayant2908/BLT","labels_url":"https://api.github.com/repos/Jayant2908/BLT/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/Jayant2908/BLT/issues/1/comments","events_url":"https://api.github.com/repos/Jayant2908/BLT/issues/1/events","html_url":"https://github.com/Jayant2908/BLT/issues/1","id":3720927628,"node_id":"I_kwDOQNx8QM7dyNmM","number":1,"title":"Testing","user":{"login":"Jayant2908","id":200989760,"node_i