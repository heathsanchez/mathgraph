ts","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** 9.4.7-4\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/folder/13176924/test-cases/41237569\n**Email or phone of affected tester (no customers):** utester+fullstory16061@gmail.com\n**Issue reported by:** Applause Internal Team\n**Bug source:** Regression TC Execution\n**Device used:** MacBook Air 26.5 Chrome, iPhone 15 iOS 26.5\n**App Component:** Other\n\n## Action Performed:\n1. Navigate to new.expensify.com (Production)\n2. Log in with a new account  (e.g utester+fullstory125@gmail.com)\n3. On the onboarding modal select \"Manage my teams expenses\" - 5-10 employees \n4. Do some actions in the app\n5. Close the tab or the app\n6. Navigate to app.fullstory.com\n7. Login with the applausetester@applause.expensifail.com credentials \n8. Click Search - Email is.. \n9. In the filter, enter the email you used in step 2\n10. The email is found, click on it, click Apply filters\n11. Verify the session is displayed\n\n## Expected Result:\nThe email is found and the session is available to watch\n\n## Actual Result:\n\"No matches found\" is shown in fullstory app for the account created on Prod\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [x] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [ ] MacOS: Chrome / Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/f0e9091d-7d1c-4bf3-b515-d4d085106051\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022066927053926040505\">https://www.upwork.com/jobs/~022066927053926040505</a></li>\n        <li>Upwork Job ID: 2066927053926040505</li>\n        <li>Last Price Increase: 2026-06-30</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/93730/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/93730/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743","repository_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty","labels_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743/labels{/name}","comments_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743/comments","events_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743/events","html_url":"https://github.com/SecureBananaLabs/bug-bounty/issues/743","id":4530092639,"node_id":"I_kwDOSfPzA88AAAABDgO6Xw","number":743,"title":"Low Handing Fruit Automation","user":{"login":"claim-reviewer","id":72201398,"node_id":"MDQ6VXNlcjcyMjAxMzk4","avatar_url":"https://avatars.githubusercontent.com/u/72201398?v=4","gravatar_id":"","url":"https://api.github.com/users/claim-reviewer","html_url":"https://github.com/claim-reviewer","followers_url":"https://api.github.com/users/claim-reviewer/followers","following_url":"htt