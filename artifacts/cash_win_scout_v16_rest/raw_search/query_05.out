","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"marcochavezf","id":6829422,"node_id":"MDQ6VXNlcjY4Mjk0MjI=","avatar_url":"https://avatars.githubusercontent.com/u/6829422?v=4","gravatar_id":"","url":"https://api.github.com/users/marcochavezf","html_url":"https://github.com/marcochavezf","followers_url":"https://api.github.com/users/marcochavezf/followers","following_url":"https://api.github.com/users/marcochavezf/following{/other_user}","gists_url":"https://api.github.com/users/marcochavezf/gists{/gist_id}","starred_url":"https://api.github.com/users/marcochavezf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/marcochavezf/subscriptions","organizations_url":"https://api.github.com/users/marcochavezf/orgs","repos_url":"https://api.github.com/users/marcochavezf/repos","events_url":"https://api.github.com/users/marcochavezf/events{/privacy}","received_events_url":"https://api.github.com/users/marcochavezf/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"mallenexpensify","id":22508304,"node_id":"MDQ6VXNlcjIyNTA4MzA0","avatar_url":"https://avatars.githubusercontent.com/u/22508304?v=4","gravatar_id":"","url":"https://api.github.com/users/mallenexpensify","html_url":"https://github.com/mallenexpensify","followers_url":"https://api.github.com/users/mallenexpensify/followers","following_url":"https://api.github.com/users/mallenexpensify/following{/other_user}","gists_url":"https://api.github.com/users/mallenexpensify/gists{/gist_id}","starred_url":"https://api.github.com/users/mallenexpensify/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mallenexpensify/subscriptions","organizations_url":"https://api.github.com/users/mallenexpensify/orgs","repos_url":"https://api.github.com/users/mallenexpensify/repos","events_url":"https://api.github.com/users/mallenexpensify/eve