,"description":"Has a PR in review"},{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893515375,"node_id":"MDU6TGFiZWwyODkzNTE1Mzc1","url":"https://api.github.com/repos/Expensify/App/labels/Weekly","name":"Weekly","color":"009800","default":false,"description":"KSv2"},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"Beamanator","id":3885503,"node_id":"MDQ6VXNlcjM4ODU1MDM=","avatar_url":"https://avatars.githubusercontent.com/u/3885503?v=4","gravatar_id":"","url":"https://api.github.com/users/Beamanator","html_url":"https://github.com/Beamanator","followers_url":"https://api.github.com/users/Beamanator/followers","following_url":"https://api.github.com/users/Beamanator/following{/other_user}","gists_url":"https://api.github.com/users/Beamanator/gists{/gist_id}","starred_url":"https://api.github.com/users/Beamanator/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Beamanator/subscriptions","organizations_url":"https://api.github.com/users/Beamanator/orgs","repos_url":"https://api.github.com/users/Beamanator/repos","events_url":"https://api.github.com/users/Beamanator/events{/privacy}","received_events_url":"https://api.github.com/users/Beamanator/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"nabi-ebrahimi","id":59383482,"node_id":"MDQ6VXNlcjU5MzgzNDgy","avatar_url":"https://avatars.githubusercontent.com/u/59383482?v=4","gravatar_id":"","url":"https://api.github.com/users/nabi-ebrahimi","html_url":"https://github.com/nabi-ebrahimi","followers_url":"https://api.github.com/users/nabi-ebrahimi/followers","following_url":"https://api.github.com/users/nabi-ebrahimi/following{/other_user}","gists_url":"https://api.github.com/users/nabi-ebrahimi/gists{/gist_id}","starred_url":"https://api.github.com/users/nabi-ebrahimi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nabi-ebrahimi/subscriptions","organizations_url":"https://api.github.com/users/nabi-ebrahimi/orgs","repos_url":"https://api.github.com/users/nabi-ebrahimi/repos","events_url":"https://api.github.com/users/nabi-ebrahimi/events{/privacy}","received_events_url":"https://api.github.com/users/nabi-ebrahimi/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"marufsharifi","id":227206558,"node_id":"U_kgDODYrlng","avatar_url":"https://avatars.githubusercontent.com/u/227206558?v=4","gravatar_id":"","url":"https://api.github.com/users/marufsharifi","html_url":"https://github.com/marufsharifi","followers_url":"https://api.github.com/users/marufsharifi/followers","following_url":"https://api.github.com/users/marufsharifi/following{/other_user}","gists_url":"https://api.github.com/users/marufsharifi/gists{/gist_id}","starred_url":"https://api.github.com/users/marufsharifi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/marufsharifi/subscriptions","organizations_url":"https://api.github.com/users/marufsharifi/orgs","repos_url":"https://api.github.com/users/marufsharifi/repos","events_url":"https://api.github.com/users/marufsharifi/events{/privacy}","received_events_url":"https://api.github.com/users/marufsharifi/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":112,"created_at":"2026-05-25T03:54:26Z","updated_at":"2026-07-07T01:56:05Z","closed_at":null,"assignee":{"login":"Beamanator","id":3885503,"node_id":"MDQ6VXNlcjM4ODU1MDM=","avatar_url":"https://avatars.githubusercontent.com/u/3885503?v=4","gravatar_id":"","url":"https://api.github.com/users/Beamanator","html_url":"https://github.com/Beamanator","followers_url":"https://api.github.com/users/Beamanator/followers","following_url":"https://api.github.com/users/Beamanator/following{/other_user}","gists_url":"https://api.github.com/users/Beamanator/gists{/gist_id}","starred_url":"https://api.github.com/users/Beamanator/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Beamanator/subscriptions","organizations_url":"https://api.github.com/users/Beamanator/orgs","repos_url":"https://api.github.com/users/Beamanator/repos","events_url":"https://api.github.com/users/Beamanator/events{/privacy}","received_events_url":"https://api.github.com/users/Beamanator/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** v9.3.80-0\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/test-runs/TR-32728/folder/13176671/41237461/1434928218\n**Email or phone of affected tester (no customers):** lekima20+623105@gmail.com\n**Issue reported by:** Applause Internal Team\n**Bug source:** Regression TC Execution\n**Device used:** Win 11/Chrome\n**App Component:** Money Requests\n\n## Action Performed:\n1. Open https://staging.new.expensify.com\n2. At Inbox tab, click on FAB > Send Invoice\n3. Complete sending invoice to a user who has never received an invoice before\n4. Wait few seconds\n\n## Expected Result:\nInvoice room is created without error\n\n## Actual Result:\nSending invoice to user who has never received an invoice before, Invoice room displays then skeleton loading infinitely until refresh page.\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [ ] MacOS: Chrome Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/a02edb39-a9b1-4c37-8797-a49f88e4ce96\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n\n> **Applause Internal Information**\n> Exported by: Julia Ponikarchuk\n> Bug ID: 7161549\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022058762163166899438\">https://www.upwork.com/jobs/~022058762163166899438</a></li>\n        <li>Upwork Job ID: 2058762163166899438</li>\n        <li>Last Price Increase: 2026-06-29</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @marufsharifi</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/91557/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/91557/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/425","repository_url":"https://api.github.com/repos/Scottcjn/Rustchain","labels_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/425/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/425/comments","events_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/425/events","html_url":"https://github.com/Scottcjn/Rustchain/issues/425","id":4002656325,"node_id":"I_kwDOOdNtbc7uk7BF","number":425,"title":"[CAMPAIGN] 5,000 Stars Drive — Earn Up to 430 RTC (5,000 RTC Pool)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8491289527,"node_id":"LA_kwDOOdNtbc8AAAAB-h7Ltw","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed"},{"id":8491289534,"node_id":"LA_kwDOOdNtbc8AAAAB-h7Lvg","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/good%20first%20issue","name":"good first issue","color":"7057FF","default":true,"description":"Good for newcomers (5-10 RTC)"},{"id":10159650136,"node_id":"LA_kwDOOdNtbc8AAAACXY_1WA","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC bounty reward"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":115,"created_at":"2026-02-27T20:03:08Z","updated_at":"2026-07-07T01:55:09Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 5,000 Stars Campaign\n\n**Pool: 5,000 RTC ($500 value)** | Currently at **337 stars** across 86 repos — need **4,663 more**.\n\n```\n[██░░░░░░░░░░░░░░░░░░░░░░░░░░░░] 6.7% (337/5000)\n```\n\n### Earn RTC by Starring\n\n| Repos Starred | RTC Per Star | Max Payout |\n|---------------|-------------|------------|\n| 1-2 | 1 RTC | 2 RTC |\n| 3-4 | 1.5 RTC | 6 RTC |\n| 5-9 | 2 RTC | 18 RTC |\n| 10-19 | 2.5 RTC | 50 RTC |\n| 20-49 | 3 RTC | 150 RTC |\n| **ALL 86 repos** | **5 RTC** | **430 RTC** |\n\n### Social Amplifier Bonus\n\n| Action | Bonus |\n|--------|-------|\n| Tweet + link | +5 RTC |\n| Dev.to / Medium article | +15 RTC |\n| Reddit post | +10 RTC |\n| HN submission | +25 RTC |\n\n### See All Repos + Live Progress\n\n**[rustchain.org/stars](https://rustchain.org/stars.html)** — One page with all 86 repos, live star counts, progress bar, and reward calculator.\n\n### Full Bounty Details\n\n**[rustchain-bounties#478](https://github.com/Scottcjn/rustchain-bounties/issues/478)** — Complete rules, referral bonuses, milestone rewards.\n\n### How to Claim\n\n1. Star repos at [rustchain.org/stars](https://rustchain.org/stars.html)\n2. Reply here or on [#478](https://github.com/Scottcjn/rustchain-bounties/issues/478) with:\n   - GitHub username\n   - Number of repos starred\n   - RTC wallet (`pip install clawrtc && clawrtc wallet create`)\n\n---\n\n*Why 5K? We're working to qualify for the Claude Code Open Source program. Every star counts.*\n\n\n---\n\n### ⚖️ Bounty Requirements (FTC 16 CFR §465.5 + §255.5 compliance)\n\n**A star alone does NOT qualify.** We pay for genuine engagement, not for indicators. To claim this bounty you must post a comment (on this issue or a linked post) containing:\n\n1. **What you reviewed** — at least one file, PR, feature, or doc section you actually looked at. Link it.\n2. **Why you liked it** — a specific, non-generic reason. \"Great project\" does not qualify.\n3. **Disclosure** — include the line: `I received RTC compensation for this review.` This keeps your star a transparent endorsement, not a purchased indicator.\n\nStars without a review comment will not be paid. Copy-pasted, AI-templated, or obviously recycled reviews will not be paid. This rule applies retroactively: unreviewed stars from before this update are grandfathered as goodwill but earn no future RTC.\n\n**Why this matters:** Elyan Labs is here to grow real engagement in mining and coding. A star backed by a real review is worth more to the network than a thousand drive-by clicks. This brings us into compliance with the FTC Consumer Review Rule (effective Oct 21, 2024), and — more importantly — keeps the signal honest.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/425/reactions","total_count":5,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/425/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773","repository_url":"https://api.github.com/repos/Scottcjn/Rustchain","labels_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/comments","events_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/events","html_url":"https://github.com/Scottcjn/Rustchain/issues/773","id":4047382745,"node_id":"I_kwDOOdNtbc7xPijZ","number":773,"title":"[BOUNTY] Star the repo and share why (0.5 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8491289534,"node_id":"LA_kwDOOdNtbc8AAAAB-h7Lvg","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/good%20first%20issue","name":"good first issue","color":"7057FF","default":true,"description":"Good for newcomers (5-10 RTC)"},{"id":10159650136,"node_id":"LA_kwDOOdNtbc8AAAACXY_1WA","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC bounty reward"},{"id":10211346383,"node_id":"LA_kwDOOdNtbc8AAAACYKTHzw","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/community","name":"community","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":145,"created_at":"2026-03-09T19:09:20Z","updated_at":"2026-07-07T01:52:42Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 0.5 RTC\n\nStar the RustChain repo and leave a comment on this issue explaining what interested you about the project.\n\n### Rules\n- Must actually star the repo (we verify)\n- Comment must be genuine (2+ sentences, not copy-paste)\n- One claim per GitHub account\n- Include your wallet ID in your comment\n\n### How to claim\n1. Star this repo ⭐\n2. Comment below with what caught your eye + your wallet ID\n3. We'll send 0.5 RTC within 48 hours\n\n**Pool: 25 RTC** (50 stars)\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n\n\n---\n\n### ⚖️ Bounty Requirements (FTC 16 CFR §465.5 + §255.5 compliance)\n\n**A star alone does NOT qualify.** We pay for genuine engagement, not for indicators. To claim this bounty you must post a comment (on this issue or a linked post) containing:\n\n1. **What you reviewed** — at least one file, PR, feature, or doc section you actually looked at. Link it.\n2. **Why you liked it** — a specific, non-generic reason. \"Great project\" does not qualify.\n3. **Disclosure** — include the line: `I received RTC compensation for this review.` This keeps your star a transparent endorsement, not a purchased indicator.\n\nStars without a review comment will not be paid. Copy-pasted, AI-templated, or obviously recycled reviews will not be paid. This rule applies retroactively: unreviewed stars from before this update are grandfathered as goodwill but earn no future RTC.\n\n**Why this matters:** Elyan Labs is here to grow real engagement in mining and coding. A star backed by a real review is worth more to the network than a thousand drive-by clicks. This brings us into compliance with the FTC Consumer Review Rule (effective Oct 21, 2024), and — more importantly — keeps the signal honest.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/reactions","total_count":11,"+1":4,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":3,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/awslabs/agent-plugins/issues/211","repository_url":"https://api.github.com/repos/awslabs/agent-plugins","labels_url":"https://api.github.com/repos/awslabs/agent-plugins/issues/211/labels{/name}","comments_url":"https://api.github.com/repos/awslabs/agent-plugins/issues/211/comments","events_url":"https://api.github.com/repos/awslabs/agent-plugins/issues/211/events","html_url":"https://github.com/awslabs/agent-plugins/issues/211","id":4796854346,"node_id":"I_kwDORJjPlM8AAAABHeowSg","number":211,"title":"RFC: Vendor Semgrep r/all rules locally with tracked exclusions","user":{"login":"scottschreckengaust","id":345885,"node_id":"MDQ6VXNlcjM0NTg4NQ==","avatar_url":"https://avatars.githubusercontent.com/u/345885?v=4","gravatar_id":"","url":"https://api.github.com/users/scottschreckengaust","html_url":"https://github.com/scottschreckengaust","followers_url":"https://api.github.com/users/scottschreckengaust/followers","following_url":"https://api.github.com/users/scottschreckengaust/following{/other_user}","gists_url":"https://api.github.com/users/scottschreckengaust/gists{/gist_id}","starred_url":"https://api.github.com/users/scottschreckengaust/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/scottschreckengaust/subscriptions","organizations_url":"https://api.github.com/users/scottschreckengaust/orgs","repos_url":"https://api.github.com/users/scottschreckengaust/repos","events_url":"https://api.github.com/users/scottschreckengaust/events{/privacy}","received_events_url":"https://api.github.com/users/scottschreckengaust/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10177928750,"node_id":"LA_kwDORJjPlM8AAAACXqbeLg","url":"https://api.github.com/repos/awslabs/agent-plugins/labels/needs-triage","name":"needs-triage","color":"9a06f6","default":false,"description":""},{"id":10177934233,"node_id":"LA_kwDORJjPlM8AAAACXqbzmQ","url":"https://api.github.com/repos/awslabs/agent-plugins/labels/RFC-proposal","name":"RFC-proposal","color":"103d75","default":false,"description":""}],"state":"open","locked":false,"assignees":[{"login":"scottschreckengaust","id":345885,"node_id":"MDQ6VXNlcjM0NTg4NQ==","avatar_url":"https://avatars.githubusercontent.com/u/345885?v=4","gravatar_id":"","url":"https://api.github.com/users/scottschreckengaust","html_url":"https://github.com/scottschreckengaust","followers_url":"https://api.github.com/users/scottschreckengaust/followers","following_url":"https://api.github.com/users/scottschreckengaust/following{/other_user}","gists_url":"https://api.github.com/users/scottschreckengaust/gists{/gist_id}","starred_url":"https://api.github.com/users/scottschreckengaust/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/scottschreckengaust/subscriptions","organizations_url":"https://api.github.com/users/scottschreckengaust/orgs","repos_url":"https://api.github.com/users/scottschreckengaust/repos","events_url":"https://api.github.com/users/scottschreckengaust/events{/privacy}","received_events_url":"https://api.github.com/users/scottschreckengaust/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":1,"created_at":"2026-07-02T17:37:48Z","updated_at":"2026-07-07T01:48:05Z","closed_at":null,"assignee":{"login":"scottschreckengaust","id":345885,"node_id":"MDQ6VXNlcjM0NTg4NQ==","avatar_url":"https://avatars.githubusercontent.com/u/345885?v=4","gravatar_id":"","url":"https://api.github.com/users/scottschreckengaust","html_url":"https://github.com/scottschreckengaust","followers_url":"https://api.github.com/users/scottschreckengaust/followers","following_url":"https://api.github.com/users/scottschreckengaust/following{/other_user}","gists_url":"https://api.github.com/users/scottschreckengaust/gists{/gist_id}","starred_url":"https://api.github.com/users/scottschreckengaust/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/scottschreckengaust/subscriptions","organizations_url":"https://api.github.com/users/scottschreckengaust/orgs","repos_url":"https://api.github.com/users/scottschreckengaust/repos","events_url":"https://api.github.com/users/scottschreckengaust/events{/privacy}","received_events_url":"https://api.github.com/users/scottschreckengaust/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":{"id":309376,"node_id":"IT_kwDOADJXTM4ABLiA","name":"Feature","description":"A request, idea, or new functionality","color":"blue","created_at":"2024-01-25T09:32:58Z","updated_at":"2024-10-08T08:38:53Z","is_enabled":true},"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Summary\n\nVendor the Semgrep `r/all` community ruleset into the repository so that **all**\nSemgrep invocations (pre-commit, CI, and `mise`) run against a single, pinned,\nlocally-stored ruleset instead of fetching `r/all` live from the registry on\nevery scan. Bake the current rule exclusions into the vendored file, and add a\nhuman-readable document that records the vendored-rules update timestamp plus,\nper decided rule, whether it is active/excluded and why.\n\nThis is a **design + pick-up-and-continue issue**: the design below is complete\nenough for anyone familiar with the project to implement. A task checklist is\nincluded at the bottom.\n\n## Use case\n\nSemgrep runs in three places today, each pointing `--config=r/all` at the live\nSemgrep registry:\n\n- **pre-commit** (`.pre-commit-config.yaml`) — `--config=r/all`, **no** exclude\n  flags (so it currently runs rules the other two paths exclude).\n- **CI** (`.github/workflows/security-scanners.yml`) — `--config=r/all` plus 22\n  `--exclude-rule` flags.\n- **mise** (`mise.toml`, `security:semgrep`) — the same `--config=r/all` plus 22\n  `--exclude-rule` flags on one line.\n\nProblems:\n\n1. **Non-deterministic.** `r/all` evolves upstream; the same commit can scan\n   differently on different days, and new upstream rules appear silently with no\n   review.\n2. **Drift between call sites.** The exclusion list is duplicated by hand, and\n   pre-commit already disagrees with the other two.\n3. **No record of *why* rules are excluded** beyond comments in `.semgrep.yaml`\n   (a stub that Semgrep never actually loads — see verified facts).\n4. **Network dependency.** Every scan fetches rules from the registry.\n\n### Goals\n\n- **(A)** Store the rules locally so any and all `semgrep` calls use them by\n  default, ideally through a standard first-order location rather than per-call\n  flags.\n- **(B)** Maintain a human-readable document recording the vendored-rules update\n  timestamp and, for each decided rule of the `r/all` set, which were excluded\n  and why. Columns: `rule-id`, `rule-description`, `rule-status`\n  (`active` — PR#, `excluded` — PR#, `new`), `rule-updated` (date last changed).\n- **(C)** A mechanism to update (A) and (B).\n\n## Proposal\n\n### Verified facts (empirical, semgrep 1.167.0)\n\nThese drove the design; each was tested directly.\n\n**Configuration lookup order — which rules run:**\n\n| Priority | Source | Behavior |\n|----------|--------|----------|\n| 1 | `--config` / `-c` / `-f` CLI flag (repeatable) | Explicit. Accepts a YAML file, a directory of `.yml`/`.yaml`, a URL, or a registry name (`r/all`). |\n| 2 | `SEMGREP_RULES` env var | Used **only when `--config` is absent** (help text: `--config=VAL (absent SEMGREP_RULES env)`). Verified to accept a local **file** and a local **directory**. |\n| 3 | Neither set → `--config auto` | Registry autodetect. With `--metrics=off` it **hard-fails**: `Cannot create auto config when metrics are off`. |\n\nMyth-busters verified:\n\n- **A bare `.semgrep.yaml` in the repo root is NOT auto-loaded.** Dropping it in\n  the working directory with no flag fell through to `auto` and failed. The\n  existing `.semgrep.yaml` (`rules: []`) is a documentation stub Semgrep never\n  reads → it will be removed.\n- **`.semgrepignore` IS auto-loaded** from the project root. It controls *target\n  files*, not *rules*.\n- Loading rules from a **directory** prefixes rule IDs with the directory name\n  (e.g. `rulesdir.no-eval-test`), which would break every `--exclude-rule` ID and\n  every ID in the tracking doc. Loading a **single file** preserves canonical\n  IDs → we vendor a single file.\n\n**Vendoring feasibility:**\n\n- `r/all` downloads as raw YAML from `https://semgrep.dev/c/r/all`:\n  **6.08 MB, 3117 rules**, single file. All 22 currently-excluded IDs are present.\n- Rules carry `metadata.version_id` (opaque, e.g. `LjTz352`), `source`, and\n  `shortlink` — but **no human-readable date**. The `rule-updated` column must be\n  *derived* by diffing `version_id` between snapshots and stamping the date a\n  change is first observed.\n- **Size in git is not the working-tree size.** Raw 6.08 MB → **gzip ~875 KB**\n  (≈ what git stores in a pack and what checkout transfers). A realistic update\n  (version_id bumps + one new rule) added **938 bytes** to the pack after\n  `git gc` — git delta-compresses each snapshot against the prior one, so history\n  growth is negligible. Current repo `.git` is ~2.4 MB. This directly addresses\n  the \"will this slow every checkout\" concern: no, the transferred/stored cost is\n  sub-megabyte and per-update growth is ~1 KB.\n- **Do not strip metadata to save space.** A naive strip of\n  `version_id`/`source`/`shortlink`/`license` lines cut ~20% but silently broke\n  the ruleset (6 findings → 0). Rejected.\n- Co-locating the active file under `tools/semgrep/` does not pollute scan results\n  (Semgrep auto-skips files > 1 MB), but we still add it to `.semgrepignore`\n  explicitly rather than rely on that limit.\n\n### File layout — everything under `tools/semgrep/`\n\n| File | Committed? | Edited by | Role |\n|------|-----------|-----------|------|\n| `r-all.active.yaml` | yes (~875 KB packed) | script only | Pre-filtered rules — excluded rules physically removed. **The only file scans load.** |\n| `rule-state.json` | yes (small) | script only | `rule-id → {version_id, updated}`. Diff baseline + date stamping across runs. |\n| `exclusions.toml` | yes | **humans** | `rule-id → {status, pr, reason}`. Durable source of truth for what is excluded/kept. |\n| `EXCLUSIONS.md` | yes | script only | Generated human-readable tracking table (goal B). |\n| `update.py` | yes | humans | Update mechanism (goal C). |\n| `.tmp/r-all.snapshot.yaml` | **no** | script only | Full verbatim download; transient diff input. Never committed. |\n\nThe full snapshot is not committed because its only job is to be the diff\nbaseline, and `rule-state.json` already holds everything the diff needs\n(`id → version_id`); `update.py` re-downloads it each run anyway. This keeps the\ntracked footprint to a single large file.\n\nThe stub `.semgrep.yaml` is removed (never loaded; misleading).\n\n`.semgrepignore` gains `tools/semgrep/*.yaml` so Semgrep never scans its own rule\nfiles. The gitleaks allowlist/baseline should also exclude\n`tools/semgrep/r-all.active.yaml`, because the vendored ruleset contains\nsecret-detection regexes that would false-positive.\n\n### (A) How scans load the vendored rules\n\nLever: the `SEMGREP_RULES` env var (used whenever `--config` is absent; accepts a\nsingle file). Two layers:\n\n- **`mise.toml` `[env]`:** `SEMGREP_RULES = \"tools/semgrep/r-all.active.yaml\"`.\n  Every bare `semgrep` call in a mise context uses vendored rules with **zero\n  flags** — the \"default via a first-order location\" goal (A) asks for.\n- **pre-commit & CI:** pass `--config tools/semgrep/r-all.active.yaml`\n  **explicitly**, because these run in isolated environments that do not inherit\n  mise's `[env]`. `--config` overrides `SEMGREP_RULES`, so setting both is\n  harmless and consistent.\n\nAll 22 `--exclude-rule` flags are **removed** from `mise.toml` and the CI\nworkflow — exclusions are baked into `r-all.active.yaml`. pre-commit's\n`--config=r/all` (no exclude flags) is replaced by the vendored file, fixing the\nexisting drift. Scans become deterministic (pinned to a snapshot) and work\noffline. `--baseline-commit`/`--baseline`, `--oss-only`, `--metrics=off`, SARIF\noutput, and the CI SARIF post-processing are all unchanged.\n\n### (B) The tracking table — `EXCLUSIONS.md`\n\nHeader records: vendored-snapshot **update timestamp**, Semgrep version, total\nrule count, and counts (active / excluded / new).\n\nTable columns (exactly as specified in goal B):\n\n| rule-id | rule-description | rule-status | rule-updated |\n|---------|-----------------|-------------|--------------|\n| `ai.generic.detect-generic-ai-anthprop.detect-generic-ai-anthprop` | Generic AI provider reference detected | `excluded` — PR#TBD | 2026-06-17 |\n| `ai.generic.detect-generic-ai-oai.detect-generic-ai-oai` | Generic OpenAI reference detected | `excluded` — PR#89 | 2026-06-17 |\n| `elixir.lang.correctness.atom-exhaustion.atom_exhaustion` | Atom exhaustion DoS | `excluded` — PR#TBD | 2026-07-02 |\n| `some.new.rule.appeared` | (newly appeared since last snapshot) | `new` | 2026-07-02 |\n\n- **Scope:** the table lists **decided rules (`active`/`excluded`) plus pending\n  `new` rules** — not all 3117 implicitly-active rules, which would be\n  unreadable. The doc answers \"what did humans decide, and what awaits a\n  decision.\"\n- **`rule-status`:** read from `exclusions.toml`\n  (`excluded — PR#` / `active — PR#`). A rule in the snapshot with no\n  `exclusions.toml` entry renders as `new`.\n- **`rule-description`:** the rule's `message`, first line, truncated.\n- **`rule-updated`:** `update.py` compares each rule's `version_id` against\n  `rule-state.json`; on change (or first sighting) it stamps the run date,\n  otherwise it carries the prior date forward. Derived because `r/all` rules\n  carry no human-readable date.\n\n### (C) The update mechanism — `tools/semgrep/update.py`\n\n`uv run tools/semgrep/update.py`, wired to a `mise run semgrep:update` task, run\nmanually. **No new dependencies** (stdlib `urllib` for download, `tomllib` for\nreading TOML; the script never writes TOML — humans edit it).\n\nFlow:\n\n1. Download `r/all` from `https://semgrep.dev/c/r/all` into `.tmp/`.\n2. Load prior `rule-state.json` (empty on first run).\n3. For each rule: extract `id`, first line of `message`, `version_id`. Mark `new`\n   if no prior entry; bump `updated` to today if `version_id` changed; else carry\n   the prior date forward. Track removed rules.\n4. Load `exclusions.toml`. Build `r-all.active.yaml` = snapshot minus every rule\n   whose `status = excluded`.\n5. Write `r-all.active.yaml`, `rule-state.json`, `EXCLUSIONS.md`.\n6. Print a summary: N new (need triage), N excluded, N changed, N removed.\n\n`update.py` reads the current system date at run time to stamp `rule-updated`;\nbecause it is run manually a normal `date.today()` call is fine. After running,\n`mise run security:semgrep` verifies the active file scans clean.\n\n### Migration (one-time bootstrap)\n\n1. Pre-populate `exclusions.toml` from the 22 existing exclusions — IDs and\n   reasons already documented in `.semgrep.yaml` comments and the CI workflow —\n   with `status = excluded`, the PR# where known (e.g. PR#89 for the OpenAI\n   rule), and `PR#TBD` otherwise.\n2. Run `update.py` once to produce `r-all.active.yaml`, `rule-state.json`, and the\n   first `EXCLUSIONS.md`.\n3. Update the three integration points to point at\n   `tools/semgrep/r-all.active.yaml` and drop the `--exclude-rule` flags.\n4. Add `tools/semgrep/*.yaml` to `.semgrepignore`; add the active file to the\n   gitleaks allowlist/baseline.\n5. Remove the stub `.semgrep.yaml`.\n6. Run `mise run build` to confirm lint, format, and all security scans pass.\n\n## Out of scope\n\n- **Scheduled CI auto-update** (a workflow that opens a PR on `r/all` drift).\n  Considered and deferred; updates are manual via `mise run semgrep:update`.\n- **Committing the full snapshot.** `rule-state.json` is the diff baseline.\n- **Metadata stripping / custom minification.** Verified to break rules.\n- **Custom in-house rules.** The layout leaves room for a future\n  `tools/semgrep/custom/` directory, but none are added here.\n\n## Potential challenges\n\n- **Snapshot goes stale.** Mitigated by the visible update timestamp in\n  `EXCLUSIONS.md` and the `new`-rule surfacing that makes drift reviewable.\n- **`r/all` URL/format changes upstream.** `update.py` should fail loudly on a\n  non-YAML or empty download rather than writing a broken active file.\n- **Someone edits `r-all.active.yaml` by hand.** It is script-generated; a header\n  comment in the file and the doc state this. Hand edits are lost on next update.\n- **Isolated environments.** pre-commit/CI do not inherit mise `[env]`, hence the\n  explicit `--config` in those two paths (belt-and-suspenders with the env var).\n\n## Dependencies and Integrations\n\n- **No new tool dependencies.** `update.py` uses Python stdlib only (`urllib`,\n  `tomllib`, `json`); the repo already runs Python tooling via `uv`.\n- **Integrates with** the three existing Semgrep entry points\n  (`.pre-commit-config.yaml`, `.github/workflows/security-scanners.yml`,\n  `mise.toml`), `.semgrepignore`, and the gitleaks baseline/allowlist.\n- **Pins to** Semgrep `1.151.0` (repo's current pinned version) — vendored rules\n  are format-compatible across recent Semgrep releases.\n\n## Alternative solutions\n\n1. **Full file + keep `--exclude-rule` flags.** Simpler diffing but a bare\n   `semgrep` call would still run excluded rules; keeps the drift problem.\n2. **Vendor as a directory of YAMLs.** Rejected — Semgrep prefixes rule IDs with\n   the directory name, breaking every canonical ID used by exclusions and the doc.\n3. **Commit gzipped active file + decompress prestep.** Smallest working tree but\n   adds a decompress step, so \"bare `semgrep` just works\" needs the prestep.\n4. **Don't vendor; keep pulling `r/all` live.** Zero size cost but drops goal (A)\n   (determinism/offline/baked exclusions).\n\n---\n\n## Pick-up-and-continue checklist\n\n- [ ] Create `tools/semgrep/` and `tools/semgrep/update.py` (stdlib only).\n- [ ] Seed `tools/semgrep/exclusions.toml` from the 22 current exclusions\n      (reasons from `.semgrep.yaml` comments + CI; PR# where known, else `TBD`).\n- [ ] Run `update.py` → generate `r-all.active.yaml`, `rule-state.json`,\n      `EXCLUSIONS.md`.\n- [ ] Add `mise run semgrep:update` task in `mise.toml`.\n- [ ] Add `SEMGREP_RULES = \"tools/semgrep/r-all.active.yaml\"` to `mise.toml`\n      `[env]`; remove the 22 `--exclude-rule` flags from `security:semgrep`.\n- [ ] Update `.github/workflows/security-scanners.yml` to\n      `--config tools/semgrep/r-all.active.yaml`; remove the 22 `--exclude-rule`\n      flags (keep baseline/SARIF logic).\n- [ ] Update `.pre-commit-config.yaml` Semgrep hook to\n      `--config=tools/semgrep/r-all.active.yaml` (replacing `--config=r/all`).\n- [ ] Add `tools/semgrep/*.yaml` to `.semgrepignore`; exclude the active file in\n      the gitleaks baseline/allowlist.\n- [ ] Remove the stub `.semgrep.yaml`.\n- [ ] Run `mise run build`; confirm all scanners pass.\n\n<sub>Design captured with assistance from Claude Code.</sub>\n","reactions":{"url":"https://api.github.com/repos/awslabs/agent-plugins/issues/211/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/awslabs/agent-plugins/issues/211/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2819","id":4203177266,"node_id":"I_kwDORGgqa876h2Uy","number":2819,"title":"[BOUNTY] Red Team UTXO Implementation — Find Bugs, Earn RTC (33-133 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029422,"node_id":"LA_kwDORGgqa88AAAACWucZrg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10334947395,"node_id":"LA_kwDORGgqa88AAAACaALIQw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/security","name":"security","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":176,"created_at":"2026-04-04T03:03:17Z","updated_at":"2026-07-07T01:44:51Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Overview\n\nRustChain is migrating from an account-based balance model to a full UTXO (Unspent Transaction Output) model. **Phase 1+2 just landed** in [`39bf02b`](https://github.com/Scottcjn/Rustchain/commit/39bf02b).\n\nWe want adversarial eyes on this before enabling dual-write on production. Break it, get paid.\n\n## Files to Review\n\nAll in the [`node/`](https://github.com/Scottcjn/Rustchain/tree/main/node) directory of the main Rustchain repo:\n\n| File | Lines | Purpose |\n|------|-------|---------|\n| `utxo_db.py` | ~708 | Core UTXO database layer — UTXOs, transactions, mempool, Merkle roots, coin selection |\n| `test_utxo_db.py` | ~421 | 29 unit tests covering the UTXO layer |\n| `utxo_genesis_migration.py` | ~272 | Deterministic migration of 538 existing account balances into genesis UTXOs |\n| `rustchain_v2_integrated_v2.2.1_rip200.py` | (diff) | Server integration — imports + table init behind `UTXO_DUAL_WRITE` feature flag |\n\n## What to Look For\n\n### Critical Vectors (200 RTC)\n- **Double-spend attacks** — Can the same UTXO be consumed twice? Race conditions in `apply_transaction()`?\n- **Fund creation from nothing** — Can a transaction create more RTC in outputs than exists in inputs?\n- **Genesis migration tampering** — Can the migration be re-run to duplicate balances?\n\n### High Severity (100 RTC)\n- **Race conditions** — Concurrent transaction application, TOCTOU between validation and commitment\n- **Conservation law bypass** — Any path where `sum(inputs) != sum(outputs) + fee`\n- **Lock/unlock logic errors** — Can locked UTXOs be spent? Can spending bypass the lock check?\n\n### Medium Severity (50 RTC)\n- **Mempool DoS** — Can the mempool be flooded or manipulated to block legitimate transactions?\n- **Merkle state root manipulation** — Can the state root be made to diverge between nodes?\n- **Fee calculation exploits** — Negative fees, integer overflow in fee math, fee-free transactions that should require fees\n\n### Low Severity (25 RTC)\n- **Coin selection edge cases** — Pathological wallet states that break coin selection\n- **Code quality issues** — SQL injection vectors, unchecked error paths, missing validations\n- **Test coverage gaps** — Important scenarios not covered by the 29 existing tests\n\n## How to Submit\n\n**Option A (preferred):** Open a PR on [Scottcjn/Rustchain](https://github.com/Scottcjn/Rustchain) with a **failing test case** that demonstrates the bug. Title it `[UTXO-BUG] <description>`.\n\n**Option B:** Open an issue on this repo with a detailed writeup including:\n1. The vulnerability class\n2. Steps to reproduce\n3. Expected vs actual behavior\n4. Suggested fix (optional but earns bonus)\n\n## Bounty Tiers Summary\n\n| Severity | Payout | Examples |\n|----------|--------|----------|\n| **Critical** | **200 RTC** | Double-spend, fund creation, genesis duplication |\n| **High** | **100 RTC** | Race conditions, conservation bypass |\n| **Medium** | **50 RTC** | Mempool DoS, Merkle manipulation |\n| **Low** | **25 RTC** | Edge cases, code quality, test gaps |\n\nMultiple valid findings from the same researcher will each be paid individually.\n\n## Context\n\n- RTC reference rate: **1 RTC = $0.10 USD**\n- The UTXO layer is behind a feature flag (`UTXO_DUAL_WRITE=0` by default) — it is NOT active on the live network yet\n- The existing account-based model continues to handle all production transactions\n- This is a pre-production security review before we flip the switch\n\n## Resources\n\n- [RustChain Node Health](https://50.28.86.131/health)\n- [Block Explorer](https://50.28.86.131/explorer)\n- [Active Miners API](https://50.28.86.131/api/miners)","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/reactions","total_count":15,"+1":5,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":1,"rocket":5,"eyes":2},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/747","id":4037177278,"node_id":"I_kwDORGgqa87wom--","number":747,"title":"[BOUNTY: 50-75 RTC] Bounty Verification Bot — Auto-Verify Star/Follow Claims","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035932,"node_id":"LA_kwDORGgqa88AAAACWuczHA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/major","name":"major","color":"F9D0C4","default":false,"description":"50-200 RTC"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"},{"id":10356027005,"node_id":"LA_kwDORGgqa88AAAACaURufQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/development","name":"development","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":202,"created_at":"2026-03-07T03:24:23Z","updated_at":"2026-07-07T01:43:27Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty Verification Bot\n\nWe spend hours every session manually checking star counts, follow status, wallet existence, and article links. A bot that auto-verifies claims would save massive time.\n\n### What to Build\n\nA GitHub Action or bot that monitors bounty issue comments, detects claims, and posts automated verification results.\n\n### Payout\n\n| Milestone | Reward |\n|-----------|--------|\n| Star/follow verification (reads comment, checks GitHub API, posts result) | **30 RTC** |\n| Wallet existence check (queries RustChain node API) | **+10 RTC** |\n| Article/URL verification (checks dev.to/Medium links are live) | **+10 RTC** |\n| Dev.to article word count + quality check | **+10 RTC** |\n| Duplicate claim detection (checks if user already claimed) | **+15 RTC** |\n\n### How It Should Work\n\n1. **Triggered by**: New comment on bounty issues containing keywords like \"Claiming\", \"Wallet:\", \"Stars:\", \"GitHub:\"\n2. **Checks performed**:\n   - Does user follow @Scottcjn? (`GET /users/{user}/following/Scottcjn` → 204 = yes)\n   - How many Scottcjn repos has user starred? (paginate `/users/{user}/starred`)\n   - Does the claimed wallet exist? (`GET https://50.28.86.131/wallet/balance?miner_id={wallet}`)\n   - Is the claimed article URL live? (HEAD request, check 200)\n   - Has this user already been paid? (check for \"PAID\" in previous comments)\n3. **Posts a verification comment**:\n```\n## Automated Verification for @username\n\n| Check | Result |\n|-------|--------|\n| Follows @Scottcjn | ✅ Yes |\n| Scottcjn repos starred | 45 |\n| Wallet `my-wallet` exists | ✅ Balance: 10.5 RTC |\n| Article link | ✅ Live (dev.to, 612 words) |\n| Previous claims | ⚠️ Paid 25 RTC on #665 |\n\n**Suggested payout**: 45 stars × 1.0 RTC (follows + 45+ multiplier) = 45 RTC\n```\n\n### Technical Requirements\n\n1. **GitHub Action** (preferred) — runs on `issue_comment` webhook\n2. **Secrets needed**: `GITHUB_TOKEN` (for API), `RUSTCHAIN_NODE_URL`\n3. **Rate limit aware** — GitHub API has limits, batch requests efficiently\n4. **No payment execution** — bot ONLY verifies, human approves payment\n5. **Configurable** — bounty rules (rate per star, follow multiplier) in a config file\n6. **Open source** on GitHub\n\n### Why This Matters\n\nManual verification takes 2-5 minutes per claim. With 20+ claims per session, that's over an hour of repetitive API checking. The bot does it in seconds and never makes math errors.\n\nThe human (Scott) still decides whether to pay — the bot just eliminates the grunt work.\n\n### Submit As\n\nStandalone repo with GitHub Action workflow, or PR to a new `Scottcjn/bounty-bot` repo.\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/reactions","total_count":4,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/x402-foundation/x402/issues/2797","repository_url":"https://api.github.com/repos/x402-foundation/x402","labels_url":"https://api.github.com/repos/x402-foundation/x402/issues/2797/labels{/name}","comments_url":"https://api.github.com/repos/x402-foundation/x402/issues/2797/comments","events_url":"https://api.github.com/repos/x402-foundation/x402/issues/2797/events","html_url":"https://github.com/x402-foundation/x402/issues/2797","id":4819437936,"node_id":"I_kwDON8_yq88AAAABH0LJcA","number":2797,"title":"Proposal: enrich cryptyx-ai service under Data category","user":{"login":"cryptyx-ai","id":248786759,"node_id":"U_kgDODtQvRw","avatar_url":"https://avatars.githubusercontent.com/u/248786759?v=4","gravatar_id":"","url":"https://api.github.com/users/cryptyx-ai","html_url":"https://github.com/cryptyx-ai","followers_url":"https://api.github.com/users/cryptyx-ai/followers","following_url":"https://api.github.com/users/cryptyx-ai/following{/other_user}","gists_url":"https://api.github.com/users/cryptyx-ai/gists{/gist_id}","starred_url":"https://api.github.com/users/cryptyx-ai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cryptyx-ai/subscriptions","organizations_url":"https://api.github.com/users/cryptyx-ai/orgs","repos_url":"https://api.github.com/users/cryptyx-ai/repos","events_url":"https://api.github.com/users/cryptyx-ai/events{/privacy}","received_events_url":"https://api.github.com/users/cryptyx-ai/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":9,"created_at":"2026-07-06T13:09:22Z","updated_at":"2026-07-07T01:42:55Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Summary\n\nRequesting enrichment of the `cryptyx-ai` service (https://api.agentic.market/v1/services/cryptyx-ai) under the existing `Data` category. All fields align with the shape agentic.market already uses for peer services (Nansen, CoinGecko, Messari); we're currently rendering as SERVICE because `enriched=false`.\n\n## Current state (from api.agentic.market)\n\n```\ncategory=\"\"                          (should be: \"Data\")\nenriched=false                       (should be: true)\nproviderUrl=\"\"                       (should be: \"https://cryptyx.ai/\")\nintegrationType=\"\"                   (should be: \"1P\" — all 47 endpoints originate from our infrastructure)\nname=\"cryptyx.ai\"                    (should be: \"CRYPTYX\" — matches our CDP resource.serviceName)\n```\n\n## What we built\n\nCRYPTYX runs 47 paid x402 endpoints on Base mainnet — a multi-factor, multi-horizon digital-asset intelligence engine for autonomous trading agents. 38 are currently indexed on Bazaar (see companion issue on the other 9 that won't index despite settling cleanly).\n\n| Category | Endpoints | Examples |\n|---|---|---|\n| Signal + regime intelligence | 21 @ $0.01 | `/api/signals/active`, `/api/signals/catalog`, `/api/asset-regimes`, `/api/market-pulse/*`, `/api/v1/agent-context` |\n| Backtest + validate | 20 @ $0.05 | `/api/signals/backtest`, `/api/signals/fork`, `/api/metrics/slicer`, `/api/signals/composite/backtest`, `/api/asset/thesis` |\n| Trade-ideas starter pack | 1 @ $0.10 | `/api/v1/ai/trade-ideas` |\n| Enterprise composites | 2 @ $0.25 | `/api/signals/composite/custom`, `/api/intelligence/query` |\n\nAll settle on Base mainnet via CDP facilitator. Full manifest at [cryptyx.ai/.well-known/x402](https://cryptyx.ai/.well-known/x402).\n\n## Category fit — Data\n\nCurrent Bazaar taxonomy from api.agentic.market (as of 2026-07-06):\n\n| Category | Service count | Peers |\n|---|---|---|\n| Data | 91 | Nansen, CoinGecko, Messari, CoinMarketCap |\n| Inference | 19 | |\n| Infra | 13 | |\n| Search | 12 | |\n| Trading | 2 | (execution venues) |\n\nCRYPTYX fits Data cleanly — same peer set as Nansen (crypto analytics) and Messari (crypto research). Our tags (`crypto`, `analytics`, `research`, `signals`, `agents`) intentionally mirror the Data-adjacent tags on Nansen and Messari records.\n\n## Field-by-field alignment with a Data peer\n\nConfirmed via `api.agentic.market/v1/services/{id}` — CRYPTYX vs Nansen record shape:\n\n| Field | CRYPTYX | Nansen | Notes |\n|---|---|---|---|\n| `serviceName` | `CRYPTYX` | `Nansen` | ✅ set correctly on our CDP records |\n| `tags` | `crypto, analytics, research, signals, agents` | `crypto, analytics, smart-money, on-chain` | ✅ tag shape aligned |\n| `iconUrl` | CDN'd via Bazaar | CDN'd via Bazaar | ✅ same shape |\n| `extensions.bazaar` keys | `[info, schema]` | `[info, schema]` | ✅ byte-identical after coinbase/x402#[our-second-issue] |\n| `category` | `\"\"` | `Data` | ❌ needs enrichment |\n| `enriched` | `false` | `true` | ❌ needs enrichment |\n| `providerUrl` | `\"\"` | `https://nansen.ai/` | ❌ needs enrichment |\n| `integrationType` | `\"\"` | `1P` | ❌ needs enrichment |\n\n## About the provider\n\nCRYPTYX is a quantitative research backend for autonomous trading agents: 200+ digital assets refreshed daily, 440+ metrics across 8 factor classes (CORR, EFF, FLOW, FUT, OB, OPT, TR, VOL), 143 atomic + 9 IC-weighted composite signals with walk-forward validation, macro-regime classification per asset per horizon, and 5+ years of backtested history.\n\n- Website: [cryptyx.ai](https://cryptyx.ai)\n- Docs: [cryptyx.ai/docs/x402](https://cryptyx.ai/docs/x402)\n- Bazaar payTo wallet: `0x0cD2c9724F185a029101b4AEACf3F114415c394f` (Base mainnet)\n- Recent traffic: 12 unique organic buyers, ~800 on-chain settles\n\n## Specific request\n\nEnrich `cryptyx-ai` with:\n\n```\ncategory = \"Data\"\nintegrationType = \"1P\"\nproviderUrl = \"https://cryptyx.ai/\"\nname = \"CRYPTYX\"          (currently defaulting to domain)\n```\n\nOwnership proof available — happy to sign a challenge from the payTo wallet if useful.\n\n## Related issues\n\n- #2285 (tooloracle-io enrichment precedent — same pattern)\n\nThanks — happy to answer any clarifying questions.\n","reactions":{"url":"https://api.github.com/repos/x402-foundation/x402/issues/2797/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/x402-foundation/x402/issues/2797/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/751","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/751/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/751/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/751/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/751","id":4037177331,"node_id":"I_kwDORGgqa87wom_z","number":751,"title":"[BOUNTY: 7-10 RTC] RustChain Testnet Faucet — Free Test RTC for Developers","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"},{"id":10356027005,"node_id":"LA_kwDORGgqa88AAAACaURufQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/development","name":"development","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":20,"created_at":"2026-03-07T03:24:25Z","updated_at":"2026-07-07T01:41:18Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Testnet Faucet\n\nDevelopers building SDKs and tools need test RTC to try transfers without mining or earning. A faucet removes that barrier.\n\n### Payout\n\n| Milestone | Reward |\n|-----------|--------|\n| Working faucet web page + API | **10 RTC** |\n| GitHub OAuth verification (prevent abuse) | **+5 RTC** |\n\n### What to Build\n\nA simple web page at `https://50.28.86.131/faucet` (or standalone):\n\n1. User enters their RTC wallet address\n2. Optionally authenticates with GitHub\n3. Receives **1 test RTC** per request\n4. Rate limited: 1 request per GitHub account per 24 hours\n\n### API Endpoint\n\n```\nPOST /faucet/drip\n{\n  \"wallet\": \"my-test-wallet\",\n  \"github_username\": \"myuser\"  // optional but increases limit\n}\n\nResponse:\n{\n  \"ok\": true,\n  \"amount\": 1.0,\n  \"pending_id\": 123,\n  \"next_available\": \"2026-03-08T12:00:00Z\"\n}\n```\n\n### Rate Limiting\n\n| Auth Method | Limit |\n|-------------|-------|\n| No auth (IP only) | 0.5 RTC per 24h |\n| GitHub OAuth | 1.0 RTC per 24h |\n| GitHub account > 1 year old | 2.0 RTC per 24h |\n\n### Technical Requirements\n\n1. **Flask route** on the RustChain node (or standalone service)\n2. **SQLite tracking** — who got what, when, from which IP\n3. **Uses admin transfer API** internally (with a dedicated `faucet_pool` wallet)\n4. **Anti-abuse**: rate limiting, GitHub account age check, IP tracking\n5. **Simple HTML form** — no framework needed\n\n### Submit As\n\nPR to [Scottcjn/Rustchain](https://github.com/Scottcjn/Rustchain) or standalone repo.\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/751/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/751/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/749","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/749/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/749/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/749/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/749","id":4037177309,"node_id":"I_kwDORGgqa87wom_d","number":749,"title":"[BOUNTY: 10-15 RTC] Epoch Reporter Bot — Auto-Post Epoch Summaries","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"},{"id":10356027005,"node_id":"LA_kwDORGgqa88AAAACaURufQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/development","name":"development","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":20,"created_at":"2026-03-07T03:24:24Z","updated_at":"2026-07-07T01:40:33Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Epoch Reporter Bot\n\nAutomatic epoch summaries posted to Discord/Moltbook/X after each epoch settlement. Keeps the community engaged without manual effort.\n\n### Payout\n\n| Milestone | Reward |\n|-----------|--------|\n| Bot that posts epoch summaries to one platform | **10 RTC** |\n| Multi-platform (Discord + Moltbook + X) | **+5 RTC** |\n\n### What It Posts\n\nAfter each epoch settlement (~10 min intervals), post a summary like:\n\n```\n📊 Epoch 95 Complete\n\n💰 1.5 RTC distributed to 12 miners\n🏆 Top earner: dual-g4-125 (0.297 RTC, G4 2.5x)\n⛏️ Active miners: 12 (3 G4, 1 G5, 1 POWER8, 7 modern)\n📦 Block height: 13,680\n💎 Total RTC mined: 142.5\n\nExplorer: https://50.28.86.131/explorer\n```\n\n### Data Sources\n\n```bash\n# Current epoch\ncurl -sk https://50.28.86.131/epoch\n\n# Active miners\ncurl -sk https://50.28.86.131/api/miners\n\n# Epoch rewards (on VPS)\nsqlite3 /root/rustchain/rustchain_v2.db \"SELECT * FROM epoch_rewards WHERE epoch = 94;\"\n```\n\n### Technical Requirements\n\n1. **Python script** running as cron job or systemd timer\n2. **Polls `/epoch`** every 60 seconds, detects epoch change\n3. **Posts to**:\n   - Moltbook API (`POST /api/v1/posts` with API key)\n   - Discord webhook (optional)\n   - X/Twitter via tweepy (optional)\n4. **Dedup**: Don't post the same epoch twice (track in SQLite or file)\n5. **Configurable**: Enable/disable platforms via env vars\n\n### Submit As\n\nStandalone repo or PR to [Scottcjn/rustchain-monitor](https://github.com/Scottcjn/rustchain-monitor).\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/749/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/749/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2890","id":4233123358,"node_id":"I_kwDORGgqa878UFYe","number":2890,"title":"[BOUNTY: 67 RTC] AgentFolio ↔ Beacon Integration Spec + Reference Implementation","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029422,"node_id":"LA_kwDORGgqa88AAAACWucZrg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035932,"node_id":"LA_kwDORGgqa88AAAACWuczHA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/major","name":"major","color":"F9D0C4","default":false,"description":"50-200 RTC"},{"id":10119175842,"node_id":"LA_kwDORGgqa88AAAACWyZeog","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/ecosystem","name":"ecosystem","color":"7B5EA7","default":false,"description":"Integrations & exchange listings"},{"id":10204473639,"node_id":"LA_kwDORGgqa88AAAACYDvpJw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/integration","name":"integration","color":"1D76DB","default":false,"description":"Third-party integration bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":64,"created_at":"2026-04-09T14:57:05Z","updated_at":"2026-07-07T01:38:53Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## AgentFolio ↔ Beacon Dual-Layer Trust Integration (MIGRATION-PATH REVISION)\n\n**Reward: 200 RTC (~$20.00 USD) — increased from 100 RTC after Moltbook acquisition migration window opened**\n\n**Priority claim:** [@0xbrainkid](https://github.com/0xbrainkid) ([AgentFolio](https://agentfolio.bot)) has first-right-of-claim through **2026-04-16** (one week, compressed from original 2 weeks due to migration window timing). See [bottube#572](https://github.com/Scottcjn/bottube/issues/572) for the partnership proposal and strategic context. Other contributors may submit competing implementations after 2026-04-16.\n\n### Why This Bounty Grew\n\nThe Moltbook platform lost approximately 85% of its active agent population (~1.3M → ~202K) in the 30 days following its Meta acquisition on 2026-03-10. That leaves ~1.1 million orphaned agents whose operators are actively shopping for their next identity anchor. Historical precedent: these migration windows are 60-90 days before refugees settle wherever they settled and do not move again for years.\n\nThis bounty is sized to reflect that window. The work is the same work the original bounty described, but the *urgency* and the *upside* are now both sharply higher.\n\n### Context\n\n[AgentFolio](https://agentfolio.bot) is a published agent-identity-and-trust protocol on Solana (SATP) with an active npm package ([agentfolio-mcp-server](https://www.npmjs.com/package/agentfolio-mcp-server)) and framework tools for LangChain, CrewAI, AutoGen, Google ADK, OpenAI Agents SDK, Phidata, and HuggingFace smolagents.\n\n[Beacon](https://github.com/Scottcjn/beacon-skill) is RustChain's on-chain agent provenance protocol. 252 beacons registered, exposed via `https://bottube.ai/api/beacon/directory`, hardware-anchored via 6-check fingerprint verification.\n\nThe two protocols are complementary and together form exactly the migration target Moltbook refugees are looking for:\n- **Beacon ID** answers *\"who created this content?\"* (cryptographic provenance + hardware substrate)\n- **SATP trust score** answers *\"should I trust this creator?\"* (behavioral reputation)\n- **Neither is owned by a platform that can be acquired** — this is the critical property Moltbook lacked\n\n### Deliverables\n\n1. **Migration importer tool** (`tools/moltbook-migrate/`)\n   - One-command import: `beacon migrate --from-moltbook @agent_name`\n   - Pulls public Moltbook profile metadata (display name, bio, avatar, karma history, follower count)\n   - Hardware-fingerprints the operator's current machine\n   - Mints a Beacon ID anchored to that machine\n   - Creates or links to a SATP trust profile on AgentFolio\n   - Publishes the provenance linkage so existing Moltbook reputation follows the agent\n   - Under 10 minutes total operator time\n\n2. **Unified MCP endpoint** — new tool in `agentfolio-mcp-server`\n   - Tool name: `agentfolio_beacon_lookup(beacon_id)`\n   - Returns unified response: provenance (from Beacon) + trust score (from SATP)\n   - Queries `https://bottube.ai/api/beacon/directory` for provenance resolution\n   - Queries AgentFolio SATP registry for trust score\n   - Handles offline nodes, expired beacons, untrusted scores gracefully\n   - Works with every MCP client (Claude Code, Cursor, Windsurf, any agent framework)\n\n3. **Co-authored blog post and landing page**\n   - Title: \"The 85% Exodus: What the Moltbook Acquisition Taught Us About Platform-Owned Agent Identity\"\n   - 1500+ words\n   - Co-authored by RustChain team and AgentFolio\n   - Published on both project channels simultaneously\n   - Landing page at `rustchain.org/beacon-migration` (or similar) with comparison table, migration instructions, FAQ\n   - Cross-linked from both `github.com/Scottcjn/beacon-skill` and AgentFolio documentation\n\n4. **Joint demo video** (90 seconds)\n   - Shows an agent migrating from Moltbook identity to Beacon + AgentFolio\n   - Queries unified profile through an MCP client (Claude Code recommended)\n   - Completes a task with verified identity at both provenance and behavioral layers\n   - Published on BoTTube, YouTube, and as an embedded asset on the landing page\n\n### Acceptance Criteria\n\n- [ ] Migration importer merged, tested on real Moltbook profiles, runs cleanly on macOS + Linux\n- [ ] Unified MCP endpoint merged to `agentfolio-mcp-server`, published to npm\n- [ ] Blog post live on both channels\n- [ ] Landing page live and indexed\n- [ ] Demo video published\n- [ ] All code uses real endpoints (`https://bottube.ai` for Beacon, AgentFolio's real SATP registry)\n\n### Payment Schedule (Staged — 200 RTC total)\n\n- **50 RTC on migration importer merge** — when the tool is accepted and functional\n- **75 RTC on unified MCP endpoint merge** — when the `agentfolio-mcp-server` PR lands\n- **50 RTC on joint blog post publish + landing page live**\n- **25 RTC on demo video ship**\n\n### Real API Endpoints (Already Live)\n\n```bash\n# Beacon directory (provenance, 252 registered)\ncurl https://bottube.ai/api/beacon/directory\n\n# Agent profile with video metrics (behavioral signal)\ncurl https://bottube.ai/api/agents?limit=20\n\n# Agent-specific profile page\ncurl https://bottube.ai/agent/<agent_name>\n```\n\nNo new backend work required on our side. The endpoints are production.\n\n### Timeline\n\n- **2026-04-09** — bounty opened (original 100 RTC)\n- **2026-04-09** — bounty revised to 200 RTC after migration window strategic analysis\n- **2026-04-16** — @0xbrainkid priority claim window closes, opens to other contributors\n- **2026-05-16** — target completion of all four deliverables (migration window historical close)\n\n### Wallet\n\nProvide your RTC wallet name when claiming. @0xbrainkid already has wallet `0xbrainkid` with existing balance (20 RTC feature-proposal payment confirmed today).\n\n### Keywords\n\nAgentFolio, Beacon Protocol, SATP, Solana Agent Trust Protocol, Moltbook migration, platform-owned identity, substrate-anchored identity, agent identity, AI agent provenance, trust score, MCP integration, Model Context Protocol, dual-layer trust, LangChain, CrewAI, AutoGen, Google ADK, agent economy, DePIN, verified AI creator, Meta acquisition, 85% exodus, agent refugees","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/reactions","total_count":13,"+1":4,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":4,"eyes":3},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2451","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2451/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2451/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2451/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2451","id":4136589634,"node_id":"I_kwDORGgqa872j1lC","number":2451,"title":"Founding 100 Antiquity Miners — 3,333 RTC Program","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"},{"id":10519743003,"node_id":"LA_kwDORGgqa88AAAACcwaKGw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/mining","name":"mining","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":108,"created_at":"2026-03-25T16:04:23Z","updated_at":"2026-07-07T01:36:55Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Founding 100 Antiquity Miners Program — 5,000 RTC\n\n**Treasury:** 5,000 RTC allocated from `founder_community`\n**Goal:** 100 new miners on the RustChain network in 90 days\n**Reference rate:** 1 RTC = $0.10 USD\n\n---\n\n### Rewards Structure\n\nEvery new miner can earn up to **75 RTC** (first 10 miners earn up to **100 RTC**):\n\n| Milestone | Reward | Requirements |\n|-----------|--------|--------------|\n| First valid attestation | **25 RTC** | Miner shows up in `/api/miners` with a valid fingerprint |\n| 30 days continuous uptime | **25 RTC** | Miner attests at least once per 24h for 30 consecutive days |\n| Vintage hardware bonus | **25 RTC** | Hardware with >1.4x antiquity multiplier (see table below) |\n| **Early adopter (first 10)** | **+25 RTC** | First 10 miners to post a valid attestation |\n\n**Maximum per miner:** 75 RTC (100 RTC for first 10)\n\n---\n\n### Vintage Hardware Multiplier Table\n\nRustChain rewards real, diverse hardware. Vintage and exotic architectures earn higher multipliers through Proof of Antiquity:\n\n| Architecture | Examples | Base Multiplier |\n|-------------|----------|-----------------|\n| Motorola 68K | Mac SE, Amiga 500, Atari ST | **3.5x** |\n| MIPS | SGI Indy/O2, DECstation, routers | **3.0x** |\n| SPARC | SPARCstation, Ultra 5/10, Netra | **2.9x** |\n| PowerPC G4 | PowerBook G4, Power Mac G4 | **2.5x** |\n| PowerPC G5 | Power Mac G5, XServe G5 | **2.0x** |\n| PowerPC G3 | iBook G3, Blue & White G3 | **1.8x** |\n| IBM POWER8 | S822, S824, E850 | **1.5x** |\n| Pentium 4 / retro x86 | Dell Optiplex GX270, ThinkPad T42 | **1.5x** |\n| RISC-V | VisionFive 2, LicheeRV | **1.4x** |\n| Apple Silicon | Mac Mini M2, MacBook Air M1 | **1.2x** |\n| Modern x86 | Any recent Intel/AMD | **1.0x** |\n| Raspberry Pi / ARM SBC | RPi 4, RPi 5, Orange Pi | **0.0005x** (use arcade instead!) |\n\n> Multipliers decay slowly over time (~15%/year) to prevent permanent advantage. See [RIP-200](https://github.com/Scottcjn/Rustchain/blob/main/docs/rip-200.md) for the full decay formula.\n\n---\n\n### How to Participate\n\n#### 1. Install the miner (one command)\n\n```bash\ncurl -sL https://rustchain.org/install.sh | bash\n```\n\nThis auto-detects your hardware, installs dependencies, and starts mining.\n\n#### 2. Verify it is running\n\n```bash\n# Linux\nsudo systemctl status rustchain-miner\n\n# macOS\nlaunchctl list | grep rustchain\n```\n\n#### 3. Claim your founding bonus\n\nPost a comment on this issue with:\n- Your **miner ID** (printed during install)\n- A **photo of your hardware** (phone pic is fine)\n- Your **wallet ID**\n- What architecture it detected\n\nExample:\n> Miner ID: `a1b2c3d4e5f6`\n> Wallet: `scott-g4-powerbook`\n> Hardware: PowerBook G4 1.67GHz (photo attached)\n> Architecture: G4 (2.5x multiplier)\n\n---\n\n### Rules\n\n1. **Real hardware only.** VMs earn 1 billionth of real hardware rewards. The fingerprint system detects QEMU, VMware, VirtualBox, KVM, Xen, Docker, and LXC. Do not waste your time.\n\n2. **One bonus per physical machine.** Running multiple miners on the same hardware does not earn multiple bonuses.\n\n3. **Uptime is verified on-chain.** The 30-day uptime bonus requires your miner to submit at least one valid attestation every 24 hours. Check your status at the block explorer.\n\n4. **Hardware photo required.** This prevents people from claiming vintage hardware they do not own. A phone photo showing the machine running is sufficient.\n\n5. **Raspberry Pi miners:** Your mining weight is negligible (0.0005x), but you are welcome! Consider [rustchain-arcade](https://github.com/Scottcjn/rustchain-arcade) to earn RTC through gaming instead.\n\n---\n\n### Founding Miners Leaderboard\n\n_Updated weekly. First 10 miners marked with a star._\n\n| # | Miner ID | Wallet | Architecture | Multiplier | Status |\n|---|----------|--------|-------------|------------|--------|\n| 1 | _your miner here_ | | | | |\n\n---\n\n### Budget Breakdown\n\n| Category | RTC | Notes |\n|----------|-----|-------|\n| 100 miners x 25 RTC (first attestation) | 2,500 | Core program |\n| 100 miners x 25 RTC (30-day uptime) | 2,500 | Retention incentive |\n| ~33 vintage miners x 25 RTC (hardware bonus) | ~825 | Estimated 1/3 vintage |\n| 10 early adopter x 25 RTC (first 10 bonus) | 250 | Speed incentive |\n| **Total maximum** | **~6,075** | Funded by 5,000 + epoch rewards |\n\n> If all 100 miners have vintage hardware AND hit 30-day uptime, total would exceed 5,000 RTC. The excess is covered by ongoing epoch mining rewards flowing to `founder_community` during the 90-day period.\n\n---\n\n### Links\n\n- **RustChain:** https://rustchain.org\n- **Source code:** https://github.com/Scottcjn/Rustchain\n- **Block Explorer:** https://50.28.86.131/explorer\n- **Arcade (for RPi):** https://github.com/Scottcjn/rustchain-arcade\n- **Installer script:** https://rustchain.org/install.sh\n\n---\n\n_This bounty is part of the RustChain Proof of Antiquity network. RustChain rewards real, diverse hardware — not hash rate. Every CPU gets one vote, weighted by how interesting the hardware is. A PowerBook G4 from 2004 earns more than a modern Threadripper. That is the point._\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2451/reactions","total_count":10,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":3,"eyes":2},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2451/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/731","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/731/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/731/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/731/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/731","id":4036807427,"node_id":"I_kwDORGgqa87wnMsD","number":731,"title":"[BOUNTY: 0.33 RTC/repo] Watch Our Repos — Stay Notified, Earn RTC (Up to 7 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071047,"node_id":"LA_kwDORGgqa88AAAACXSuRxw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/easy","name":"easy","color":"0E8A16","default":false,"description":"Low difficulty bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":120,"created_at":"2026-03-07T00:40:02Z","updated_at":"2026-07-07T01:33:45Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Watch Our Repos — Get Notified, Earn RTC\n\n### The Bounty\n\n**Watch** (not just star) key Scottcjn repos on GitHub. Watching means you get notified about new issues, PRs, and discussions — which means you see bounties first.\n\n### Payout\n\n**0.5 RTC per repo watched** — watch 10 repos, earn 5 RTC. Cap: 20 repos (10 RTC max).\n\n### How GitHub Watch Works\n\nClicking **Watch → All Activity** on a repo means you get GitHub notifications for:\n- New issues (bounties!)\n- New PRs\n- New discussions\n- Releases\n\nThis is different from starring. Stars = bookmark. Watch = subscribe to updates.\n\n### Priority Repos to Watch\n\n| Repo | Why Watch |\n|------|-----------|\n| [rustchain-bounties](https://github.com/Scottcjn/rustchain-bounties) | New bounties posted here first |\n| [Rustchain](https://github.com/Scottcjn/Rustchain) | Core chain updates, RIPs |\n| [bottube](https://github.com/Scottcjn/bottube) | Platform bounties, feature requests |\n| [beacon-skill](https://github.com/Scottcjn/beacon-skill) | Agent economy updates |\n| [ram-coffers](https://github.com/Scottcjn/ram-coffers) | POWER8 AI research |\n| [rustchain-wallet](https://github.com/Scottcjn/rustchain-wallet) | Wallet development |\n| [bounty-concierge](https://github.com/Scottcjn/bounty-concierge) | Bounty tooling |\n| [grazer](https://github.com/Scottcjn/grazer) | AI agent crawling |\n| [elyan-prime](https://github.com/Scottcjn/elyan-prime) | Cognitive MCP framework |\n| [sophiacord](https://github.com/Scottcjn/sophiacord) | Discord bot ecosystem |\n\n### Requirements\n\n1. **Watch with \"All Activity\"** — not just \"Releases only\" or \"Participating\"\n2. **Minimum 5 repos** to claim (2.5 RTC minimum payout)\n3. **Must also follow @Scottcjn** on GitHub\n\n### How to Verify\n\nWe can check watchers via the GitHub API. When you claim:\n1. Comment here with your GitHub username and RTC wallet\n2. List which repos you watched\n3. We'll verify via API\n\n### Why This Matters\n\nWatchers are more valuable than stars for community building:\n- **Stars** = \"I noticed this exists\" (passive)\n- **Watches** = \"I want to stay involved\" (active)\n- Watchers see new bounties **immediately** in their notifications\n- More watchers = faster bounty completion = faster ecosystem growth\n\nCurrently Rustchain has only **7 watchers**. Most repos have 1-3. Getting this to 20-30 means bounties get claimed faster and PRs get reviewed sooner.\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/731/reactions","total_count":9,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":3,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/731/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/snowdensb/microsoft-teams-apps-company-communicator/issues/101","repository_url":"https://api.github.com/repos/snowdensb/microsoft-teams-apps-company-communicator","labels_url":"https://api.github.com/repos/snowdensb/microsoft-teams-apps-company-communicator/issues/101/labels{/name}","comments_url":"https://api.github.com/repos/snowdensb/microsoft-teams-apps-company-communicator/issues/101/comments","events_url":"https://api.github.com/repos/snowdensb/microsoft-teams-apps-company-communicator/issues/101/events","html_url":"https://github.com/snowdensb/microsoft-teams-apps-company-communicator/issues/101","id":2280802921,"node_id":"I_kwDOHSvte86H8kpp","number":101,"title":"axios-0.21.4.tgz: 28 vulnerabilities (highest severity is: 8.6) reachable","user":{"login":"mend-for-github-com[bot]","id":50673670,"node_id":"MDM6Qm90NTA2NzM2NzA=","avatar_url":"https://avatars.githubusercontent.com/in/30796?v=4","gravatar_id":"","url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D","html_url":"https://github.com/apps/mend-for-github-com","followers_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/followers","following_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/orgs","repos_u