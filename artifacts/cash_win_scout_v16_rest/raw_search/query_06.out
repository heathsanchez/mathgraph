y}","received_events_url":"https://api.github.com/users/abbasifaizan70/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"aimane-chnaif","id":96077027,"node_id":"U_kgDOBboE4w","avatar_url":"https://avatars.githubusercontent.com/u/96077027?v=4","gravatar_id":"","url":"https://api.github.com/users/aimane-chnaif","html_url":"https://github.com/aimane-chnaif","followers_url":"https://api.github.com/users/aimane-chnaif/followers","following_url":"https://api.github.com/users/aimane-chnaif/following{/other_user}","gists_url":"https://api.github.com/users/aimane-chnaif/gists{/gist_id}","starred_url":"https://api.github.com/users/aimane-chnaif/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aimane-chnaif/subscriptions","organizations_url":"https://api.github.com/users/aimane-chnaif/orgs","repos_url":"https://api.github.com/users/aimane-chnaif/repos","events_url":"https://api.github.com/users/aimane-chnaif/events{/privacy}","received_events_url":"https://api.github.com/users/aimane-chnaif/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":45,"created_at":"2026-02-23T13:01:45Z","updated_at":"2026-07-01T22:00:40Z","closed_at":null,"assignee":{"login":"chuckdries","id":1351436,"node_id":"MDQ6VXNlcjEzNTE0MzY=","avatar_url":"https://avatars.githubusercontent.com/u/1351436?v=4","gravatar_id":"","url":"https://api.github.com/users/chuckdries","html_url":"https://github.com/chuckdries","followers_url":"https://api.github.com/users/chuckdries/followers","following_url":"https://api.github.com/users/chuckdries/following{/other_user}","gists_url":"https://api.github.com/users/chuckdries/gists{/gist_id}","starred_url":"https://api.github.com/users/chuckdries/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chuckdries/subscriptions","organizations_url":"https://api.github.com/users/chuckdries/orgs","repos_url":"https://api.github.com/users/chuckdries/repos","events_url":"https://api.github.com/users/chuckdries/events{/privacy}","received_events_url":"https://api.github.com/users/chuckdries/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Description\n\nTyping into the Inbox search (SearchRouter) freezes the JS thread on mobile. The native back gesture and native scrolling still work, but all JS-driven interactions (navigation buttons, virtualization recalculation) become unresponsive.\n\n## Steps to Reproduce\n\n1. Open the app on a mobile device (iOS or Android)\n2. Tap the search icon in the Inbox\n3. Start typing a search query\n4. Observe that the UI becomes unresponsive\n\n## Expected Behavior\n\nSearch input should remain responsive while filtering results, with no perceptible lag or JS thread blocking.\n\n## Actual Behavior\n\nThe JS thread freezes. Navigation buttons stop working, virtualization bounds don't recalculate. Only native gestures (back swipe, scroll) continue to work.\n\n## Root Cause\n\n`autocompleteQueryValue` in `SearchRouter.tsx` updates immediately on every keystroke (only `textInputValue` is debounced). This triggers synchronous re-computation of:\n\n- `getSearchOptions()` -- filters all reports/personal details\n- `isSearchStringMatch()` -- creates RegExp per word per item\n- `combineOrderingOfReportsAndPersonalDetails()` -- sorts results\n- Multiple `.filter()` chains on tags, categories, currencies, participants\n\n## Suggested Fixes\n\n1. Debounce `autocompleteQueryValue` (or the prop passed to `SearchAutocompleteList`) so filtering doesn't run on every keystroke\n2. Memoize `searchOptions` and `recentReportsOptions` with stable dependencies\n3. Optimize `isSearchStringMatch` -- reuse compiled RegExp objects instead of creating new ones per iteration\n4. Consider moving heavy filtering off the JS thread (InteractionManager, web worker, or native module)\n\n## Platform\n\n- [x] iOS\n- [x] Android\n- [ ] Web (likely affected but less severe)\n\n## Reporter\n\nChuck ([Slack thread](https://expensify.slack.com/archives/C05LX9D6E07/p1771606797669149))\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @abbasifaizan70</details>\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: https://www.upwork.com/jobs/~022025920563596911295</li>\n        <li>Upwork Job ID: 2025920563596911295</li>\n        <li>Last Price Increase: 2026-03-02</li>\n<li>Automatic offers: </li>\n<ul>\n<li>aimane-chnaif | Reviewer | 110717229</li>\n</ul></li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/83207/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/83207/timeline","performed_via_github_app":null,"state_reason":"reopened","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ZSBRybnik/frontend/issues/2184","repository_url":"https://api.github.com/repos/ZSBRybnik/frontend","labels_url":"https://api.github.com/repos/ZSBRybnik/frontend/issues/2184/labels{/name}","comments_url":"https://api.github.com/repos/ZSBRybnik/frontend/issues/2184/comments","events_url":"https://api.github.com/repos/ZSBRybnik/frontend/issues/2184/events","html_url":"https://github.com/ZSBRybnik/frontend/issues/2184","id":2036872265,"node_id":"I_kwDOHl4nr855aDRJ","number":2184,"title":"wallet-adapter-wallets-0.18.10.tgz: 40 vulnerabilities (highest severity is: 9.3)","user":{"login":"mend-bolt-for-github[bot]","id":42819689,"node_id":"MDM6Qm90NDI4MTk2ODk=","avatar_url":"https://avatars.githubusercontent.com/in/16809?v=4","gravatar_id":"","url":"https://api.github.com/users/mend-bolt-for-github%5Bbot%5D","html_url":"https://github.com/apps/mend-bolt-for-github","followers_url":"https://api.github.com/users/mend-bolt-for-github%5Bbot%5D/followers","following_url":"https://api.github.com/users/mend-bolt-for-github%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/mend-bolt-for-github%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/mend-bolt-for-github%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mend-bolt-for-github%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/mend-bolt-for-github%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/mend-bolt-for-github%5Bbot%5D/repos","events_url":"https://api.github.com/users/mend-bolt-for-github%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/mend-bolt-for-github%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[{"id":4700040518,"node_id":"LA_kwDOHl4nr88AAAABGCTtRg","url":"https://api.github.com/repos/ZSBRybnik/frontend/labels/Mend:%20dependency%20security%20vulnerability","name":"Mend: dependency security vulnerability","color":"d1260f","default":false,"description":"Security vulnerability detected by Mend"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2023-12-12T02:46:20Z","updated_at":"2026-07-01T21:50:05Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"<details><summary><img src='https://whitesource-resources.whitesourcesoftware.com/vulnerability_details.png' width=19 height=20> Vulnerable Library - <b>wallet-adapter-wallets-0.18.10.tgz</b></summary>\n\n<p></p>\n<p>Path to dependency file: /pac