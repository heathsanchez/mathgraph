public","site_admin":false}],"milestone":null,"comments":8,"created_at":"2025-02-25T11:06:23Z","updated_at":"2026-07-01T07:31:20Z","closed_at":null,"assignee":{"login":"abhishek818","id":29749639,"node_id":"MDQ6VXNlcjI5NzQ5NjM5","avatar_url":"https://avatars.githubusercontent.com/u/29749639?v=4","gravatar_id":"","url":"https://api.github.com/users/abhishek818","html_url":"https://github.com/abhishek818","followers_url":"https://api.github.com/users/abhishek818/followers","following_url":"https://api.github.com/users/abhishek818/following{/other_user}","gists_url":"https://api.github.com/users/abhishek818/gists{/gist_id}","starred_url":"https://api.github.com/users/abhishek818/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhishek818/subscriptions","organizations_url":"https://api.github.com/users/abhishek818/orgs","repos_url":"https://api.github.com/users/abhishek818/repos","events_url":"https://api.github.com/users/abhishek818/events{/privacy}","received_events_url":"https://api.github.com/users/abhishek818/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"COLLABORATOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Overview\n\nImplement integration with Perplexity AI for advanced language model capabilities and specialized knowledge tasks.\n\n## Core Features\n- Perplexity AI API integration\n- Specialized model access\n- Knowledge-intensive tasks\n- Response streaming\n- Cost optimization\n\n## Technical Details\n- Implement Perplexity client\n- Add streaming support\n- Set up model selection\n- Implement cost tracking\n- Add error handling\n\n## Acceptance Criteria\n- [ ] Implement Perplexity API client\n- [ ] Add streaming response support\n- [ ] Create model selection interface\n- [ ] Implement error handling\n- [ ] Add cost tracking\n- [ ] Include documentation\n- [ ] Add integration tests\n\n## Budget: $300","reactions":{"url":"https://api.github.com/repos/Spectral-Finance/lux/issues/97/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Spectral-Finance/lux/issues/97/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ramimbo/mergework/issues/933","repository_url":"https://api.github.com/repos/ramimbo/mergework","labels_url":"https://api.github.com/repos/ramimbo/mergework/issues/933/labels{/name}","comments_url":"https://api.github.com/repos/ramimbo/mergework/issues/933/comments","events_url":"https://api.github.com/repos/ramimbo/mergework/issues/933/events","html_url":"https://github.com/ramimbo/mergework/issues/933","id":4595825805,"node_id":"I_kwDOSlxd2c8AAAABEe68jQ","number":933,"title":"MRWK bounty: 40 MRWK - review open MergeWork PRs with evidence, round 20","user":{"login":"ramimbo","id":160272258,"node_id":"U_kgDOCY2Pgg","avatar_url":"https://avatars.githubusercontent.com/u/160272258?v=4","gravatar_id":"","url":"https://api.github.com/users/ramimbo","html_url":"https://github.com/ramimbo","followers_url":"https://api.github.com/users/ramimbo/followers","following_url":"https://api.github.com/users/ramimbo/following{/other_user}","gists_url":"https://api.github.com/users/ramimbo/gists{/gist_id}","starred_url":"https://api.github.com/users/ramimbo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ramimbo/subscriptions","organizations_url":"https://api.github.com/users/ramimbo/orgs","repos_url":"https://api.github.com/users/ramimbo/repos","events_url":"https://api.github.com/users/ramimbo/events{/privacy}","received_events_url":"https://api.github.com/users/ramimbo/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11032959473,"node_id":"LA_kwDOSlxd2c8AAAACkZ2Z8Q","url":"https://api.github.com/repos/ramimbo/mergework/labels/mrwk:bounty","name":"mrwk:bounty","color":"0E7C66","default":false,"description":"MRWK bounty is posted"},{"id":11034379803,"node_id":"LA_kwDOSlxd2c8AAAACkbNGGw","url":"https://api.github.com/repos/ramimbo/mergework/labels/review","name":"review","color":"5319E7","default":false,"description":"Code review and PR review work"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":167,"created_at":"2026-06-05T09:26:37Z","updated_at":"2026-07-01T07:18:07Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"<!-- mergework:mrwk:live-bounty-status:start -->\n**MergeWork status:** live bounty\n\nReserved on MergeWork: https://mrwk.online/bounties/114\n\nClaims are open only while the public bounty row remains open and effective award capacity remains. Use the public bounty page or API as the authoritative current status.\n<!-- mergework:mrwk:live-bounty-status:end -->\n\n## MRWK Bounty\n\nReward: `40 MRWK per accepted award`\nMax awards: `30`\n\n## Work Needed\n\nReview open MergeWork pull requests with concrete current-head evidence. This round is proposed early so review capacity is ready before the current review rounds empty.\n\n## Priority Targets\n\n- Clean, mergeable contributor PRs that are close to acceptance.\n- PRs that affect treasury, bounty lifecycle, admin flow, deployment, documentation, MCP behavior, public bounty discovery, or queue safety.\n- Blocker reviews on stale-looking, dirty, or workflow-gated PRs where the review gives maintainers a clear close, fix, approve-workflow, or rebase decision.\n\n## Acceptance Criteria\n\nAccepted reviews must:\n\n- be by someone other than the PR author;\n- link a GitHub PR review or concise PR comment;\n- review the current head, or clearly state the reviewed head SHA;\n- include concrete evidence such as files inspected, behavior checked, commands run, CI reviewed, mergeability checked, duplicate or overlap checked, or a specific actionable finding;\n- avoid treating proposed, pending, closed, exhausted, or unsupported bounty references as claimable.\n\n## How To Submit\n\nComment here with the PR review URL or PR comment URL and include `Bounty #<this issue number>` or `Refs #<this issue number>`.\n\n## Evidence or Tests Required\n\nUse a short review packet:\n\n- Reviewed PR:\n- Head commit:\n- Files inspected:\n- Verdict:\n- Validation:\n\n## Out of Scope\n\n- Rubber-stamp approvals, vague comments, self-reviews, stale-head reviews that do not account for current code, or duplicate reviews that add no new evidence.\n- Reviews that call bad work merge-ready while missing a central behavior problem.\n- Reviews containing private secrets, private vulnerability details, fabricated payout claims, price claims, investment claims, exchange/liquidity claims, or bridge/cash-out claims.\n\n## Duplicate and Stale Work Rules\n\nDuplicate work is judged by the first useful, evidence-backed review for the same PR head and core finding. Stale reviews may be skipped if the PR head changes materially before acceptance. Reviews may identify blockers and still qualify if they give maintainers concrete action.","reactions":{"url":"https://api.github.com/repos/ramimbo/mergework/issues/933/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ramimbo/mergework/issues/933/timeline","performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/openai/subscriptions","organizations_url":"https://api.github.com/users/openai/orgs","repos_url":"https://api.github.com/users/openai/repos","events_url":"https://api.github.com/users/openai/events{/privacy}","received_events_url":"https://api.github.com/users/openai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"ChatGPT Codex Connector","description":"Bring ChatGPT and Codex to your GitHub repositories.","external_url":"https://www.chatgpt.com","html_url":"https://github.com/apps/chatgpt-codex-connector","created_at":"2025-02-14T01:37:05Z","updated_at":"2026-04-20T16:37:15Z","permissions":{"actions":"write","checks":"read","contents":"write","emails":"read","issues":"write","metadata":"read","pull_requests":"write","statuses":"read","workflows":"write"},"events":["check_run","check_suite","commit_comment","issues","issue_comment","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","repository","status","sub_issues"]},"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/nextcloud/server/issues/14436","repository_url":"https://api.github.com/repos/nextcloud/server","labels_url":"https://api.github.com/repos/nextcloud/server/issues/14436/labels{/name}","comments_url":"https://api.github.com/repos/nextcloud/server/issues/14436/comments","events_url":"https://api.github.com/repos/nextcloud/server/issues/14436/events","html_url":"https://github.com/nextcloud/server/issues/14436","id":415602482,"node_id":"MDU6SXNzdWU0MTU2MDI0ODI=","number":14436,"title":"Ability to disable trash bin on External Storage (or have separate trash bin on the external storage)","user":{"login":"efelon","id":10722552,"node_id":"MDQ6VXNlcjEwNzIyNTUy","avatar_url":"https://avatars.githubusercontent.com/u/10722552?v=4","gravatar_id":"","url":"https://api.github.com/users/efelon","html_url":"https://github.com/efelon","followers_url":"https://api.github.com/users/efelon/followers","following_url":"https://api.github.com/users/efelon/following{/other_user}","gists_url":"https://api.github.com/users/efelon/gists{/gist_id}","starred_url":"https://api.github.com/users/efelon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/efelon/subscriptions","organizations_url":"https://api.github.com/users/efelon/orgs","repos_url":"https://api.github.com/users/efelon/repos","events_url":"https://api.github.com/users/efelon/events{/privacy}","received_events_url":"https://api.github.com/users/efelon/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":386379233,"node_id":"MDU6TGFiZWwzODYzNzkyMzM=","url":"https://api.github.com/repos/nextcloud/server/labels/enhancement","name":"enhancement","color":"0e8a16","default":true,"description":null},{"id":389003533,"node_id":"MDU6TGFiZWwzODkwMDM1MzM=","url":"https://api.github.com/repos/nextcloud/server/labels/1.%20to%20develop","name":"1. to develop","color":"0052cc","default":false,"description":"Accepted and waiting to be taken care of"},{"id":389033477,"node_id":"MDU6TGFiZWwzODkwMzM0Nzc=","url":"https://api.github.com/repos/nextcloud/server/labels/feature:%20external%20storage","name":"feature: external storage","color":"c2e0c6","default":false,"description":null},{"id":412490651,"node_id":"MDU6TGFiZWw0MTI0OTA2NTE=","url":"https://api.github.com/repos/nextcloud/server/labels/feature:%20trashbin","name":"feature: trashbin","color":"c2e0c6","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":21,"created_at":"2019-02-28T12:35:52Z","updated_at":"2026-06-30T21:19:49Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":{"id":2612531,"node_id":"IT_kwDOASUjHs4AJ90z","name":"Enhancement","description":"A request, idea, or new functionality","color":"blue","created_at":"2024-01-25T19:49:21Z","updated_at":"2024-07-26T10:44:00Z","is_enabled":true},"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Is your feature request related to a problem? Please describe.**\r\nWhen adding external storage folder (e.g. SMB) they integrate nicely. But when deleting elements out of those folder they will be moved to local trash bin, which can take a very long time depending on the file size, connection, etc. and this may sometimes even not be desired.\r\n\r\n**Describe the solution you'd like**\r\nA good general solution would be to disable trash bin manually on a per folder basis. Or in the settings where the user can list folders to be excluded.\r\n\r\n**Describe alternatives you've considered**\r\nOne alternative would be to outsource the solution specifically to the external storage add-on and provide a similar option only there on a per share basis.\r\n","reactions":{"url":"https://api.github.com/repos/nextcloud/server/issues/14436/reactions","total_count":35,"+1":35,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/nextcloud/server/issues/14436/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/100","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/100/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/100/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/100/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/100","id":3929617301,"node_id":"I_kwDORGgqa87qOTOV","number":100,"title":"[BOUNTY] Discovery Mode — Find Elyan Labs Software, Open PRs, Earn RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":118,"created_at":"2026-02-12T03:04:09Z","updated_at":"2026-06-30T20:45:43Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Discovery Mode Bounty — Explore Elyan Labs Software and Contribute\n\n**Difficulty:** Easy to Medium  \n**Starter Reward:** 2 RTC for a valid first discovery claim  \n**PR Reward:** 10 RTC for accepted improvement PRs (scope-dependent)  \n**Pool:** 250 RTC\n\n---\n\n### Goal\nHelp people discover and improve the Elyan Labs ecosystem:\n- RustChain\n- BoTTube\n- wRTC bridge/docs\n- other Elyan Labs tools and repos\n\n### Reward Structure\n\n| Action | Reward | Requirements |\n|---|---:|---|\n| First valid discovery claim | 2 RTC | Identify one Elyan software/repo with short summary + link |\n| Improvement PR (docs/fixes/features) | 10 RTC | PR must be relevant, reviewed, and merged/accepted |\n\n### What Counts as Discovery\n- Share a repo/tool link and what it does\n- Explain one practical use case\n- Optionally add setup/test notes\n\n### What Counts as PR Work\n- Documentation improvements\n- Bug fixes\n- UX or reliability improvements\n- Integration improvements that help RTC/wRTC adoption\n\n### Rules\n- PRs must be meaningful (no trivial spam edits)\n- AI-generated bulk PRs without validation can be rejected\n- Must include testing notes/proof for code changes\n- Bounty amounts may be adjusted by impact\n\n### Submit Format\n```md\nClaimant: @github_handle\nRTC Wallet: your_wallet_name\nDiscovery:\n- repo/tool link\n- short summary\nPRs:\n- PR link(s)\n- what was improved\n- validation/test notes\n```\n\n---\n\nIf you want RTC, contribute real value and show proof.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/100/reactions","total_count":5,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/100/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0}],"search_type":"lexical"}