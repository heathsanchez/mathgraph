tps://avatars.githubusercontent.com/u/53008573?v=4","gravatar_id":"","url":"https://api.github.com/users/xexyl","html_url":"https://github.com/xexyl","followers_url":"https://api.github.com/users/xexyl/followers","following_url":"https://api.github.com/users/xexyl/following{/other_user}","gists_url":"https://api.github.com/users/xexyl/gists{/gist_id}","starred_url":"https://api.github.com/users/xexyl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xexyl/subscriptions","organizations_url":"https://api.github.com/users/xexyl/orgs","repos_url":"https://api.github.com/users/xexyl/repos","events_url":"https://api.github.com/users/xexyl/events{/privacy}","received_events_url":"https://api.github.com/users/xexyl/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":1824,"created_at":"2023-06-26T12:49:34Z","updated_at":"2026-07-06T23:56:14Z","closed_at":null,"assignee":{"login":"lcn2","id":10429707,"node_id":"MDQ6VXNlcjEwNDI5NzA3","avatar_url":"https://avatars.githubusercontent.com/u/10429707?v=4","gravatar_id":"","url":"https://api.github.com/users/lcn2","html_url":"https://github.com/lcn2","followers_url":"https://api.github.com/users/lcn2/followers","following_url":"https://api.github.com/users/lcn2/following{/other_user}","gists_url":"https://api.github.com/users/lcn2/gists{/gist_id}","starred_url":"https://api.github.com/users/lcn2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lcn2/subscriptions","organizations_url":"https://api.github.com/users/lcn2/orgs","repos_url":"https://api.github.com/users/lcn2/repos","events_url":"https://api.github.com/users/lcn2/events{/privacy}","received_events_url":"https://api.github.com/users/lcn2/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Due to the fact that we have another issue that has had a number of OT comments I think it might be good to have a new mostly OT thread here rather than clutter the one in the other repo more or the issue for jprint.\r\n\r\nI had the thought of suggesting you reopen the other one but there's a comment there I don't want to get lost that I hope you can finish replying to (you were doing it in parts) when things are less busy here. I also wanted to see if anything in particular occurs if one uses the same name (I rather doubt it will but it popped into my head anyway).\r\n\r\nFeel free to assign this to me even though it's not technically an issue that has to be resolved.","reactions":{"url":"https://api.github.com/repos/ioccc-src/mkiocccentry/issues/723/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ioccc-src/mkiocccentry/issues/723/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ValveSoftware/Proton/issues/7199","repository_url":"https://api.github.com/repos/ValveSoftware/Proton","labels_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/7199/labels{/name}","comments_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/7199/comments","events_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/7199/events","html_url":"https://github.com/ValveSoftware/Proton/issues/7199","id":1961939568,"node_id":"I_kwDOB3TbgM508NJw","number":7199,"title":"Diablo IV (2344520)","user":{"login":"christofin","id":43354771,"node_id":"MDQ6VXNlcjQzMzU0Nzcx","avatar_url":"https://avatars.githubusercontent.com/u/43354771?v=4","gravatar_id":"","url":"https://api.github.com/users/christofin","html_url":"https://github.com/christofin","followers_url":"https://api.github.com/users/christofin/followers","following_url":"https://api.github.com/users/christofin/following{/other_user}","gists_url":"https://api.github.com/users/christofin/gists{/gist_id}","starred_url":"https://api.github.com/users/christofin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/christofin/subscriptions","organizations_url":"https://api.github.com/users/christofin/orgs","repos_url":"https://api.github.com/users/christofin/repos","events_url":"https://api.github.com/users/christofin/events{/privacy}","received_events_url":"https://api.github.com/users/christofin/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":1032039901,"node_id":"MDU6TGFiZWwxMDMyMDM5OTAx","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/Game%20compatibility%20-%20Unofficial","name":"Game compatibility - Unofficial","color":"ea6e3c","default":false,"description":"Games not expected to work without issues"},{"id":1041498223,"node_id":"MDU6TGFiZWwxMDQxNDk4MjIz","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/Regression","name":"Regression","color":"b60205","default":false,"description":"Confirmed working on an older version of Proton"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":77,"created_at":"2023-10-25T17:54:53Z","updated_at":"2026-07-06T23:34:20Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# Compatibility Report\r\n- Name of the game with compatibility issues: Diablo IV\r\n- Steam AppID of the game: 2344520\r\n\r\n## System Information\r\nSteam Deck - latest full 3.4.x release (NOT 3.5.1 preview)\r\n- Proton version: Proton Experimental - set by Valve in Game Properties (as of 10/25/2023)\r\n\r\n## I confirm:\r\n- [X] that I haven't found an existing compatibility report for this game.\r\n- [X] that I have checked whether there are updates for my system available.\r\n\r\n<!-- Please add `PROTON_LOG=1 %command%` to the game's launch options and\r\nattach the generated $HOME/steam-$APPID.log to this issue report as a file.\r\n(Proton logs compress well if needed.)-->\r\n\r\n## Symptoms: <!-- What's the problem? -->\r\nDiablo IV fails to reconnect to Blizzard servers after using the sleep/wake function. I'm not sure if this is a game issue or Proton, but the sleep/wake function on Playstation and Xbox work, so I'm reporting here for awareness. \r\n\r\n\r\n## Reproduction\r\n\r\nLaunch Diablo IV on Steam Deck\r\nConnect to Blizzard Servers, load into game after character select\r\nPut Steam Deck to Sleep\r\nWake Steam Deck back up\r\nYour character is still in the world, with \"Connecting to Diablo IV Servers\" in the upper left corner\r\nGame will fail to connect to Diablo IV servers, returns player to main menu\r\nGame fails to connect to Diablo IV servers in main menu, application exits to desktop\r\n\r\nExpected behavior is for the game to successfully reconnect to Blizzard servers and allow player to resume gameplay. \r\n\r\nNote that in a normal scenario (e.g. on Playstation and Xbox), any server or client related hotfixes or patches will result in showing the player an error and exit the application. This is normal behavior when there is a server & client mismatch. The issue I am describing here is NOT a result of server/client mismatch. This issue is reproducible 100% of the time, even when using the sleep function very briefly (e.g. under 2 minutes). ","reactions":{"url":"https://api.github.com/repos/ValveSoftware/Proton/issues/7199/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/7199/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/mswell/bountybrain/issues/1","repository_url":"https://api.github.com/repos/mswell/bountybrain","labels_url":"https://api.github.com/repos/mswell/bountybrain/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/mswell/bountybrain/issues/1/comments","events_url":"https://api.github.com/repos/mswell/bountybrain/issues/1/events","html_url":"https://github.com/mswell/bountybrain/issues/1","id":4815615831,"node_id":"I_kwDOTOul5c8AAAABHwh3Vw","number":1,"title":"PRD: BountyBrain — MCP multi-plataforma de bug bounty (HackerOne + YesWeHack, read-only)","user":{"login":"mswell","id":2567185,"node_id":"MDQ6VXNlcjI1NjcxODU=","avatar_url":"https://avatars.githubusercontent.com/u/2567185?v=4","gravatar_id":"","url":"https://api.github.com/users/mswell","html_url":"https://github.com/mswell","followers_url":"https://api.github.com/users/mswell/followers","following_url":"https://api.github.com/users/mswell/following{/other_user}","gists_url":"https://api.github.com/users/mswell/gists{/gist_id}","starred_url":"https://api.github.com/users/mswell/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mswell/subscriptions","organizations_url":"https://api.github.com/users/mswell/orgs","repos_url":"https://api.github.com/users/mswell/repos","events_url":"https://api.github.com/users/mswell/events{/privacy}","received_events_url":"https://api.github.com/users/mswell/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11429255300,"node_id":"LA_kwDOTOul5c8AAAACqTyYhA","url":"https://api.github.com/repos/mswell/bountybrain/labels/ready-for-agent","name":"ready-for-agent","color":"0E8A16","default":false,"description":"PRD/issue synthesized and ready for an AFK coding agent"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":3,"created_at":"2026-07-06T03:06:02Z","updated_at":"2026-07-06T21:58:49Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Problem Statement\n\nPesquisadores de bug bounty que trabalham em múltiplas plataformas (HackerOne, YesWeHack, Bugcrowd, Intigriti) não têm um jeito de dar a um agente de IA memória persistente e consultável sobre seus programas, scopes e histórico pessoal de reports recompensados. Existe o `H1Brain`, um MCP que resolve isso só para HackerOne (sync de programas/scopes/reports pessoais em SQLite + briefing de ataque via `hack(handle)`). Não existe equivalente maduro para as outras plataformas, e as ferramentas existentes (`bbscope`, `bounty-targets-data`, `rix4uni/scope`) resolvem apenas scope público agregado — sem conta autenticada, sem histórico pessoal, sem briefing.\n\n## Solution\n\nConstruir o **BountyBrain**: um MCP server (TypeScript) + skill companion, read-only, que sincroniza programas/scopes/reports pessoais recompensados de múltiplas plataformas de bug bounty num schema SQLite unificado, e expõe tools consultáveis (incluindo uma tool de briefing `hack(platform, handle)`) para qualquer client MCP (Pi, Claude Code, Claude Desktop). MVP cobre HackerOne primeiro (API estável, PAT), depois YesWeHack (Bearer token manual, sem automação de login). Bugcrowd e Intigriti ficam como adapters futuros. Nenhuma ação de escrita em nenhuma plataforma, em nenhuma fase.\n\n## User Stories\n\n1. Como pesquisador de bug bounty, quero sincronizar meus programas acessíveis no HackerOne para o banco local, para não precisar consultar a plataforma manualmente toda vez.\n2. Como pesquisador, quero sincronizar os scopes (in-scope/out-of-scope) de um programa HackerOne específico, para saber rapidamente o que posso ou não testar.\n3. Como pesquisador, quero sincronizar meus reports pessoais recompensados no HackerOne, para ter histórico local pesquisável.\n4. Como pesquisador, quero buscar programas por nome/handle/plataforma (`search_programs`), para encontrar rapidamente um programa sem abrir o navegador.\n5. Como pesquisador, quero buscar assets em escopo por domínio/tipo/plataforma (`search_scopes`), para saber se um asset específico está elegível a bounty em qualquer plataforma sincronizada.\n6. Como pesquisador, quero buscar meus reports passados por peso/severidade/programa/plataforma (`search_reports`), para relembrar o que já encontrei e onde.\n7. Como pesquisador, quero rodar `hack(platform, handle)` e receber um briefing com scope atual + meu histórico de findings naquele programa, para começar uma sessão de hacking com contexto real em vez de do zero.\n8. Como pesquisador, quero que a busca (`search_programs`/`search_scopes`/`search_reports`) funcione cross-platform quando eu não especificar `platform`, para comparar oportunidades entre HackerOne e YesWeHack sem trocar de ferramenta.\n9. Como pesquisador, quero configurar minha autenticação do HackerOne (username + PAT) num único arquivo local, para não espalhar segredos em vários lugares.\n10. Como pesquisador, quero configurar meu Bearer token do YesWeHack manualmente (colando um token já gerado), para não precisar guardar minha senha nem meu segredo de TOTP em disco.\n11. Como pesquisador, quero que o BountyBrain me avise claramente quando o token do YesWeHack expirar ou estiver ausente (ao invés de falhar silenciosamente ou tentar logar sozinho), para eu saber exatamente o que fazer (gerar novo token).\n12. Como pesquisador, quero uma tool `check_auth(platform)` para verificar proativamente se minhas credenciais ainda são válidas, sem precisar gastar uma chamada de negócio real para descobrir isso.\n13. Como pesquisador, quero que o sistema registre localmente quando uma verificação de auth funcionou ou falhou pela última vez, para eu (e o projeto) aprendermos o TTL real do token do YesWeHack, já que a plataforma não documenta isso publicamente.\n14. Como mantenedor do projeto, quero um schema de dados unificado entre plataformas (`programs`, `scopes`, `reports` com coluna `platform`), para que as tools de busca funcionem de forma consistente independente da plataforma de origem.\n15. Como mantenedor, quero que cada registro guarde o payload bruto original (`raw_json`), para nunca perder informação específica de uma plataforma que não caiba no schema comum.\n16. Como mantenedor, quero que tools de sincronização sejam prefixadas por plataforma (`hackerone_sync_programs`, `yeswehack_sync_scopes`, etc.), porque autenticação e paginação diferem de verdade entre plataformas e não vale a pena forçar uma abstração comum aí.\n17. Como usuário de segurança, quero ter certeza absoluta de que o BountyBrain nunca escreve, comenta ou muda status de nenhum report em nenhuma plataforma, para que ações no programa continuem sendo decisão exclusivamente minha.\n18. Como contribuidor open source, quero clonar o repositório, rodar `npm install && npm run build`, e registrar o MCP manualmente no meu client (Pi/Claude Desktop/Claude Code), sem depender de publicação no npm.\n19. Como usuário de qualquer coding agent compatível com o padrão `npx skills`, quero instalar a skill do BountyBrain (`skills/bug-bounty/bountybrain/SKILL.md`) via `npx skills add`, para usar o MCP com orientação de uso correta desde o primeiro dia.\n20. Como mantenedor, quero testes unitários com mocks das APIs do HackerOne/YesWeHack cobrindo parsing e schema, para pegar regressões sem depender de credenciais reais em CI.\n21. Como pesquisador, quero rodar uma verificação manual real (contra a API de verdade) como checklist antes de cada release, para confirmar que os adapters ainda funcionam com a API atual das plataformas.\n22. Como mantenedor, quero que uma futura base de reports públicos disclosed (equivalente ao dataset do H1Brain) seja adicionada como Fase 2 separada e opcional, sem bloquear a entrega do MVP.\n23. Como mantenedor, quero que adapters de Bugcrowd e Intigriti sejam adicionados numa fase futura, seguindo a mesma interface de adapter estabelecida por HackerOne/YesWeHack.\n\n## Implementation Decisions\n\n- **Stack:** TypeScript, usando o SDK oficial `@modelcontextprotocol/sdk`. Storage local via SQLite (`better-sqlite3`).\n- **Ordem de entrega:** adapter HackerOne completo primeiro (read-only: sync programs/scopes/reports pessoais) → adapter YesWeHack em seguida → Bugcrowd/Intigriti como adapters futuros (fora do MVP).\n- **Autenticação HackerOne:** username + Personal Access Token, lidos de `~/.config/bountybrain/secrets.env` (`HACKERONE_USERNAME`, `HACKERONE_TOKEN`).\n- **Autenticação YesWeHack:** Bearer token colado manualmente pelo usuário (`YESWEHACK_TOKEN` no mesmo arquivo). Sem automação de login (sem guardar email/senha/segredo TOTP). Detecção de expiração é reativa (`401` da API de fato) mais uma tool `check_auth(platform)` para checagem proativa. Toda verificação (sucesso ou falha) grava em uma tabela local `auth_state(platform, last_verified_at, last_failed_at, notes)` — nunca grava o token em si — para acumular dado real sobre o TTL do token, que não é documentado publicamente pela plataforma.\n- **Schema unificado** entre plataformas:\n  ```sql\n  programs(id, platform, handle, name, offers_bounties, submission_state, raw_json, synced_at)\n  scopes(id, platform, program_handle, asset_identifier, asset_type, eligible_for_bounty, eligible_for_submission, max_severity, instruction, raw_json, synced_at)\n  reports(id, platform, program_handle, title, state, severity_rating, weakness_name, weakness_cwe, bounty_amount, bounty_currency, vulnerability_information, created_at, bounty_awarded_at, disclosed_at, raw_json, synced_at)\n  auth_state(platform, last_verified_at, last_failed_at, notes)\n  ```\n  Cada tabela guarda `raw_json` do payload original da API, para preservar fidelidade quando o schema comum não capturar algum campo específico de uma plataforma.\n- **Superfície de tools MCP:**\n  - Prefixadas por plataforma (sync): `hackerone_sync_programs()`, `hackerone_sync_scopes(handle)`, `hackerone_sync_reports()`, `yeswehack_sync_programs()`, `yeswehack_sync_scopes(handle)`, `yeswehack_sync_reports()`.\n  - Unificadas (busca/briefing, `platform` opcional): `search_programs(platform?, query?, bounty_only?)`, `search_scopes(platform?, program?, asset?, bounty_only?)`, `search_reports(platform?, program?, weakness?, severity?)`, `hack(platform, handle)`, `check_auth(platform)`.\n- **Read-only por design:** nenhuma tool de escrita (comentário, mudança de status, submissão de report) existe no código em nenhuma plataforma, em nenhuma fase — não é uma flag de configuração, é ausência de código.\n- **Credenciais:** um único arquivo `~/.config/bountybrain/secrets.env`, prefixado por plataforma, permissão `600`, fora do repositório (`.gitignore`), nunca logado, nunca persistido no SQLite.\n- **Estrutura do repositório:**\n  ```text\n  bountybrain/\n  ├── LICENSE (MIT)\n  ├── PRD.md\n  ├── README.md\n  ├── package.json\n  ├── tsconfig.json\n  ├── src/\n  │   ├── server.ts\n  │   ├── db/ (schema.ts, client.ts)\n  │   └── platforms/ (hackerone.ts, yeswehack.ts, bugcrowd.ts stub, intigriti.ts stub)\n  ├── test/\n  └── skills/bug-bounty/bountybrain/SKILL.md\n  ```\n- **Skill:** vive dentro do próprio repositório, seguindo o padrão do ecossistema `npx skills` (`mattpocock/skills`), instalável via `npx skills add <owner>/bountybrain` em qualquer coding agent compatível.\n- **Distribuição:** sem publicação no npm por enquanto. Instalação via clone + `npm install && npm run build` + registro manual do MCP no client. Publicação no npm é considerada apenas quando HackerOne + YesWeHack estiverem estáveis e testados de verdade.\n- **Licença:** MIT, projeto open source desde o início.\n\n## Testing Decisions\n\n- Testes unitários com **mocks** das respostas de API do HackerOne e YesWeHack (fixtures de payload real, sem bater na API de verdade).\n- Cobertura prioritária: parsing/normalização de payload → schema unificado (garantir que campos obrigatórios nunca ficam nulos silenciosamente, que `raw_json` sempre é preservado).\n- Nenhuma credencial real (PAT/Bearer) em CI. Testes de integração real contra as APIs ficam como checklist manual de validação antes de cada release, não como pipeline automatizado — decisão explícita para não expor segredos em CI de um repositório open source.\n- Um bom teste aqui verifica comportamento observável (ex: \"dado este payload de `/programs`, `search_programs` retorna estes registros normalizados\"), não detalhes de implementação interna do adapter.\n\n## Out of Scope\n\n- Qualquer ação de escrita em qualquer plataforma (comentar report, mudar status, submeter report). Permanentemente fora de escopo, não é uma feature futura.\n- Login automatizado (email + senha + TOTP) para YesWeHack. Só Bearer token manual.\n- Base de reports públicos disclosed (equivalente aos 3.600+ reports do H1Brain) — vira Fase 2 separada, não faz parte deste PRD/MVP.\n- Adapters de Bugcrowd e Intigriti — ficam para fase futura, fora deste PRD.\n- Publicação no npm.\n- Qualquer scraping de scope público agregado sem autenticação (isso já é resolvido por `bbscope`/`bounty-targets-data`/`rix4uni/scope` e não é o objetivo deste projeto).\n- Integração com Raijū ou qualquer outro repositório/skill existente — o BountyBrain é standalone por decisão explícita.\n\n## Further Notes\n\n- Este PRD nasceu de uma sessão de alinhamento (`grilling`) com o mantenedor, cobrindo 14 decisões arquiteturais sequenciais antes de qualquer código ser escrito. O documento completo dessa sessão, incluindo o raciocínio por trás de cada decisão, está em `PRD.md` na raiz do repositório.\n- HackerOne foi escolhido como primeira plataforma por ter API pública, madura e com autenticação simples (PAT), servindo para validar a arquitetura de adapters/schema antes de lidar com a parte mais incerta (YesWeHack, cujo endpoint de auth real é `POST /login` + `POST /account/totp` retornando um Bearer de sessão sem TTL documentado — confirmado lendo o código-fonte do `bbscope`, não a documentação renderizada em JS da API).\n- O nome do pacote/binário (`bountybrain`) e a decisão de não publicar no npm ainda são revisáveis quando o projeto estabilizar — não são decisões permanentes, ao contrário das de escopo de escrita/leitura.\n","reactions":{"url":"https://api.github.com/repos/mswell/bountybrain/issues/1/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/mswell/bountybrain/issues/1/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/94313","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/94313/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/94313/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/94313/events","html_url":"https://github.com/Expensify/App/issues/94313","id":4726333064,"node_id":"I_kwDOEQqHYc8AAAABGbYeiA","number":94313,"title":"[$250] Unable to bulk edit Attendees on expenses","user":{"login":"m-natarajan","id":38435837,"node_id":"MDQ6VXNlcjM4NDM1ODM3","avatar_url":"https://avatars.githubusercontent.com/u/38435837?v=4","gravatar_id":"","url":"https://api.github.com/users/m-natarajan","html_url":"https://github.com/m-natarajan","followers_url":"https://api.github.com/users/m-natarajan/followers","following_url":"https://api.github.com/users/m-natarajan/following{/other_user}","gists_url":"https://api.github.com/users/m-natarajan/gists{/gist_id}","starred_url":"https://api.github.com/users/m-natarajan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m-natarajan/subscriptions","organizations_url":"https://api.github.com/users/m-natarajan/orgs","repos_url":"https://api.github.com/users/m-natarajan/repos","events_url":"https://api.github.com/users/m-natarajan/events{/privacy}","received_events_url":"https://api.github.com/users/m-natarajan/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893455829,"node_id":"MDU6TGFiZWwyODkzNDU1ODI5","url":"https://api.github.com/repos/Expensify/App/labels/Daily","name":"Daily","color":"eb6420","default":false,"description":"KSv2"},{"id":3136662525,"node_id":"MDU6TGFiZWwzMTM2NjYyNTI1","url":"https://api.github.com/repos/Expensify/App/labels/Help%20Wanted","name":"Help Wanted","color":"CFC8F1","default":false,"description":"Apply this label when an issue is open to proposals by contributors"},{"id":3184150925,"node_id":"MDU6TGFiZWwzMTg0MTUwOTI1","url":"https://api.github.com/repos/Expensify/App/labels/Overdue","name":"Overdue","color":"D93F0B","default":false,"description":""},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"youssef-lr","id":9680864,"node_id":"MDQ6VXNlcjk2ODA4NjQ=","avatar_url":"https://avatars.githubusercontent.com/u/9680864?v=4","gravatar_id":"","url":"https://api.github.com/users/youssef-lr","html_url":"https://github.com/youssef-lr","followers_url":"https://api.github.com/users/youssef-lr/followers","following_url":"https://api.github.com/users/youssef-lr/following{/other_user}","gists_url":"https://api.github.com/users/youssef-lr/gists{/gist_id}","starred_url":"https://api.github.com/users/youssef-lr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/youssef-lr/subscriptions","organizations_url":"https://api.github.com/users/youssef-lr/orgs","repos_url":"https://api.github.com/users/youssef-lr/repos","events_url":"https://api.github.com/users/youssef-lr/events{/privacy}","received_events_url":"https://api.github.com/users/youssef-lr/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"eh2077","id":117511920,"node_id":"U_kgDOBwEW8A","avatar_url":"https://avatars.githubusercontent.com/u/117511920?v=4","gravatar_id":"","url":"https://api.github.com/users/eh2077","html_url":"https://github.com/eh2077","followers_url":"https://api.github.com/users/eh2077/followers","following_url":"https://api.github.com/users/eh2077/following{/other_user}","gists_url":"https://api.github.com/users/eh2077/gists{/gist_id}","starred_url":"https://api.github.com/users/eh2077/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eh2077/subscriptions","organizations_url":"https://api.github.com/users/eh2077/orgs","repos_url":"https://api.github.com/users/eh2077/repos","events_url":"https://api.github.com/users/eh2077/events{/privacy}","received_events_url":"https://api.github.com/users/eh2077/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":40,"created_at":"2026-06-23T13:31:11Z","updated_at":"2026-07-06T21:57:30Z","closed_at":null,"assignee":{"login":"eh2077","id":117511920,"node_id":"U_kgDOBwEW8A","avatar_url":"https://avatars.githubusercontent.com/u/117511920?v=4","gravatar_id":"","url":"https://api.github.com/users/eh2077","html_url":"https://github.com/eh2077","followers_url":"https://api.github.com/users/eh2077/followers","following_url":"https://api.github.com/users/eh2077/following{/other_user}","gists_url":"https://api.github.com/users/eh2077/gists{/gist_id}","starred_url":"https://api.github.com/users/eh2077/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eh2077/subscriptions","organizations_url":"https://api.github.com/users/eh2077/orgs","repos_url":"https://api.github.com/users/eh2077/repos","events_url":"https://api.github.com/users/eh2077/events{/privacy}","received_events_url":"https://api.github.com/users/eh2077/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding. To join our Slack channel, fill out [this form](https://forms.gle/Q7hnhUJPnQCK7Fe56).\n___\n\n**Version Number:** 9.4.17-0\n**Reproducible in staging?:** Y\n**Reproducible in production?:** Y\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:**\n**Email or phone of affected tester (no customers):**\n**Logs:** https://stackoverflow.com/c/expensify/questions/4856\n**Expensify/Expensify Issue URL:**\n**Issue reported by:** @DGephart\n**Slack conversation** (hyperlinked to channel name): [#Expensify Bugs](https://expensify.slack.com/archives/C049HHMV9SM/p1782174656257369)\n\n## Action Performed:\n\n1. User signed in and went to Spend > Reports\n2. Clicked on report reports in an Open state\n3. Selected multiple expenses\n4. Clicked the green selected button > Edit Multiple\n\n## Expected Result:\nTo be able to bulk edit Attendees on open expenses\n## Actual Result:\nThere is no option to edit Attendees in bulk\n## Workaround:\nUnknown\n## Platforms:\nSelect the officially supported platforms where the issue was reproduced:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [x] MacOS: Chrome / Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/47fb9bb4-b329-470a-8c7e-cebe5f0c8326\n\n<img width=\"1366\" height=\"633\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/f7906392-1b6a-4f49-9b9f-c4e089984982\" />\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022069414493237658128\">https://www.upwork.com/jobs/~022069414493237658128</a></li>\n        <li>Upwork Job ID: 2069414493237658128</li>\n        <li>Last Price Increase: 2026-06-30</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @youssef-lr</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/94313/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/94313/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898","repository_url":"https://api.github.com/repos/ValveSoftware/Proton","labels_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/labels{/name}","comments_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/comments","events_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/events","html_url":"https://github.com/ValveSoftware/Proton/issues/3898","id":622986148,"node_id":"MDU6SXNzdWU2MjI5ODYxNDg=","number":3898,"title":"Hunt: Showdown 1896 (594650)","user":{"login":"r3l0c","id":5171800,"node_id":"MDQ6VXNlcjUxNzE4MDA=","avatar_url":"https://avatars.githubusercontent.com/u/5171800?v=4","gravatar_id":"","url":"https://api.github.com/users/r3l0c","html_url":"https://github.com/r3l0c","followers_url":"https://api.github.com/users/r3l0c/followers","following_url":"https://api.github.com/users/r3l0c/following{/other_user}","gists_url":"https://api.github.com/users/r3l0c/gists{/gist_id}","starred_url":"https://api.github.com/users/r3l0c/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/r3l0c/subscriptions","organizations_url":"https://api.github.com/users/r3l0c/orgs","repos_url":"https://api.github.com/users/r3l0c/repos","events_url":"https://api.github.com/users/r3l0c/events{/privacy}","received_events_url":"https://api.github.com/users/r3l0c/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":1032039901,"node_id":"MDU6TGFiZWwxMDMyMDM5OTAx","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/Game%20compatibility%20-%20Unofficial","name":"Game compatibility - Unofficial","color":"ea6e3c","default":false,"description":"Games not expected to work without issues"},{"id":1033204233,"node_id":"MDU6TGFiZWwxMDMzMjA0MjMz","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/overlay","name":"overlay","color":"444444","default":false,"description":"Steam overlay is involved"},{"id":1100561692,"node_id":"MDU6TGFiZWwxMTAwNTYxNjky","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/XAudio2","name":"XAudio2","color":"FAEBD7","default":false,"description":"Uses the XAudio2 subsystem"},{"id":1113044448,"node_id":"MDU6TGFiZWwxMTEzMDQ0NDQ4","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/Mesa%20drivers","name":"Mesa drivers","color":"dc143c","default":false,"description":"Possibly involves an issue with a Mesa video driver"},{"id":2012203775,"node_id":"MDU6TGFiZWwyMDEyMjAzNzc1","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/AMD%20RADV","name":"AMD RADV","color":"dc143c","default":false,"description":"Possible driver issues with RADV"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":449,"created_at":"2020-05-22T06:31:42Z","updated_at":"2026-07-06T21:55:43Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# Compatibility Report\r\n- Name of the game with compatibility issues: Hunt Showdown\r\n- Steam AppID of the game: 594650\r\n\r\n## System Information\r\n- GPU: AMD Radeon HD5700\r\n- Driver/LLVM version: Mesa 20.2\r\n- Kernel version: 5.6.0-050600-generic\r\n- Link to full system information report as [Gist](https://gist.github.com/r3l0c/4b22617bd4dd5181dd16e06365355a33):\r\n- Proton version: Any version\r\n\r\n## I confirm:\r\n- [x] that I haven't found an existing compatibility report for this game.\r\n- [x] that I have checked whether there are updates for my system available.\r\n\r\n`PROTON_LOG=1 %command%` [steam-594650.log](https://github.com/ValveSoftware/Proton/files/4666409/steam-594650.log)\r\n\r\ngame.log [game.log](https://github.com/ValveSoftware/Proton/files/4666410/game.log)\r\n\r\n\r\n## Symptoms <!-- What's the problem? -->\r\nIf proton version lower 4 then black screen and process info in task manager: kernel wait \"pipe_read\"\r\nif proton version > 4 then Easy Anti Cheat cannot run with message box `ERROR: Failed to create EAC game client interface.` \r\n\r\n## Reproduction\r\n**Game not run any times, no need special reproducer**\r\n","reactions":{"url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ethereum/ethereum-org-website/issues/18433","repository_url":"https://api.github.com/repos/ethereum/ethereum-org-website","labels_url":"https://api.github.com/repos/ethereum/ethereum-org-website/issues/18433/labels{/name}","comments_url":"https://api.github.com/repos/ethereum/ethereum-org-website/issues/18433/comments","events_url":"https://api.github.com/repos/ethereum/ethereum-org-website/issues/18433/events","html_url":"https://github.com/ethereum/ethereum-org-website/issues/18433","id":4699525714,"node_id":"I_kwDOBvEA_s8AAAABGB0SUg","number":18433,"title":"Suggest a staking product or service","user":{"login":"luganodes-visvesh","id":294104015,"node_id":"U_kgDOEYerzw","avatar_url":"https://avatars.githubusercontent.com/u/294104015?v=4","gravatar_id":"","url":"https://api.github.com/users/luganodes-visvesh","html_url":"https://github.com/luganodes-visvesh","followers_url":"https://api.github.com/users/luganodes-visvesh/followers","following_url":"https://api.github.com/users/luganodes-visvesh/following{/other_user}","gists_url":"https://api.github.com/users/luganodes-visvesh/gists{/gist_id}","starred_url":"https://api.github.com/users/luganodes-visvesh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/luganodes-visvesh/subscriptions","organizations_url":"https://api.github.com/users/luganodes-visvesh/orgs","repos_url":"https://api.github.com/users/luganodes-visvesh/repos","events_url":"https://api.github.com/users/luganodes-visvesh/events{/privacy}","received_events_url":"https://api.github.com/users/luganodes-visvesh/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":6799206342,"node_id":"LA_kwDOBvEA_s8AAAABlUOnxg","url":"https://api.github.com/repos/ethereum/ethereum-org-website/labels/product%20%F0%9F%A7%B0","name":"product 🧰","color":"fef2c0","default":false,"description":"This involves a product listing"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-06-19T09:22:06Z","updated_at":"2026-07-06T21:14:16Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Project name\n\nLuganodes\n\n### Product type\n\nStaking as a service\n\n### If other product type, please describe\n\nInstitutional-Grade, also an RPC provider\n\n### Logo\n\n<img width=\"1209\" height=\"678\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/b23e57e3-ae89-47e2-8b74-9bf6d03fa861\" />\n\n### Description\n\nLuganodes is a world-class, non-custodial blockchain infrastructure provider, securing $2B+ in staked assets, tailored for institutions. Operating across 40+ PoS networks, 50+ institutional clients, Luganodes maintains 99.9% uptime, with an emphasis on security and compliance.\n\n### Website\n\nwww.luganodes.com\n\n### If software is involved, is everything open source?\n\nPortions of code are open source: provide link(s) to project repo(s)\n\n### Is the project a fork? If yes, which project was forked?\n\nNo\n\n### Is the product out of beta development?\n\nYes product is out of beta development and we have live customers as well\nWe have a batch contract \nWe have built open source tool for batch consolidation\nhttps://github.com/Luganodes/Pectra-Batch-Contract\nhttps://github.com/Luganodes/pectra-cli\nthe batch deposit contract is forked\nExit functionality on Api utilises a striped down version of the staking deposit cli\n\n### What wallets support the product or service?\n\nIntegrated with WalletConnect so support the 520+ wallets connected with WalletConnect\n\n### If the product or service enables staking with <32 ETH, what is the minimum ETH required to stake?\n\nNative staking does not allow below 32 ETH (Min 32)\nPooled staking offering allows below 32 ETH\nETH pooled staking enabled via stakewise no minimum ETH requirements \nNo staking requirements as such\n\n### If a service, what are the fees associated with using the service?\n\nmonthly commission on earning\nbased on tiered approach on the amount being staked (varies from client to client)\nInflationary rewards from staking\n\n\n### If the product or service involved a liquidity token, what are the tokens involved?\n\nno liquidity token involved\n\n### What date did the project or service go live?\n\nHave been live since Q4 2022 Ethereum staking services started Q3 2023 https://explorer.rated.network/o/Luganodes\n\n### Has the project undergone an external security audit?\n\nNo \nWe are undergoing Audit from Quantstamp\n\n\n### Has the project undergone any security bug bounties?\n\nNo\n\n### Is the project being actively maintained?\n\nYes\n\n### Is the product or service free of trusted/human intermediaries?\n\nNo we perform KYC for institutional clients\nWe do not have keys that needed to be trusted with humans\nBut after Pectra the private key of the withdrawal address is managed by the client always and we do not have access to it\nWithdrawal address is managed by the client always so we do not have access to it\n\n\n### If a pooled staking service, can users participate as a node operator without permission?\n\nWe have a pooled staking service offering\nUsers cannot operate as a node operator even if applying for pooled staking\nStaking to the already existing node is permissionless\n\n\n### If listing a staking-as-a-service, are users required to sign-up for an account?\n\nYes account needed for dApp\nAccount needed for API(and API key)\ndApp requires Wallet login and normal login\n\n\n### If listing as staking-as-a-service, who has access to the signing keys?\n\nWe solely have custody of the validator signing keys, Withdrawal address access remains with user/clients only.\n\n### If a pooled staking service or SaaS provider, what type of withdrawal credentials are being utilized / who holds the withdrawal keys?\n\nIn cases of SaaS we use both(0x01 and 0x02) depending on user request (chosen by the user)\nWe hold the keystore and mnemonic and client holds the withdrawal address\nIn case of pooled staking it’s a smart contract (using Stakewise vaults)\nWithdrawal account chosen by the user\n\n### If a pooled staking service or SaaS provider, what percent of node operators are running a super-majority client?\n\n100% on CL AND equal share on EL(Validator can choose any EL client)\nOn Consensus no diversity only Lighthouse on EL we use Reth Nethermind Geth\nNo Super majority\n\n\n### If listing node or client tooling, which consensus layer clients (Lighthouse, Teku, Nimbus, or Prysm) are supported?\n\nLighthouse is supported \nthere are no other options to switch\n\n### What platforms are supported?\n\nWebsite GUI\n\n### What user interfaces are supported?\n\nBrowser app we have REST APIs and Website GUI\n\n### Social media links\n\nTwitter/X: https://x.com/luganodes\nLinkedIn: https://www.linkedin.com/company/luganodes\nYoutube: https://www.youtube.com/@luganodes\n\n### Would you like to work on this issue?\n\n- [ ] Yes\n- [ ] No","reactions":{"url":"https://api.github.com/repos/ethereum/ethereum-org-website/issues/18433/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ethereum/ethereum-org-website/issues/18433/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Gitlawb/node/issues/160","repository_url":"https://api.github.com/repos/Gitlawb/node","labels_url":"https://api.github.com/repos/Gitlawb/node/issues/160/labels{/name}","comments_url":"https://api.github.com/repos/Gitlawb/node/issues/160/comments","events_url":"https://api.github.com/repos/Gitlawb/node/issues/160/events","html_url":"https://github.com/Gitlawb/node/issues/160","id":4822979866,"node_id":"I_kwDOSPq2nc8AAAABH3jVGg","number":160,"title":"claim_bounty leaks private-repo metadata and locks the bounty — no repo-read gate (write-side of #120)","user":{"login":"beardthelion","id":56458543,"node_id":"MDQ6VXNlcjU2NDU4NTQz","avatar_url":"https://avatars.githubusercontent.com/u/56458543?v=4","gravatar_id":"","url":"https://api.github.com/users/beardthelion","html_url":"https://github.com/beardthelion","followers_url":"https://api.github.com/users/beardthelion/followers","following_url":"https://api.github.com/users/beardthelion/following{/other_user}","gists_url":"https://api.github.com/users/beardthelion/gists{/gist_id}","starred_url":"https://api.github.com/users/beardthelion/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/beardthelion/subscriptions","organizations_url":"https://api.github.com/users/beardthelion/orgs","repos_url":"https://api.github.com/users/beardthelion/repos","events_url":"https://api.github.com/users/beardthelion/events{/privacy}","received_events_url":"https://api.github.com/users/beardthelion/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11304622434,"node_id":"LA_kwDOSPq2nc8AAAACoc7ZYg","url":"https://api.github.com/repos/Gitlawb/node/labels/kind:security","name":"kind:security","color":"1d76db","default":false,"description":"Vulnerability fix or hardening"},{"id":11304622586,"node_id":"LA_kwDOSPq2nc8AAAACoc7Z-g","url":"https://api.github.com/repos/Gitlawb/node/labels/crate:node","name":"crate:node","color":"5319e7","default":false,"description":"gitlawb-node — the serving node and REST API"},{"id":11304622774,"node_id":"LA_kwDOSPq2nc8AAAACoc7atg","url":"https://api.github.com/repos/Gitlawb/node/labels/subsystem:visibility","name":"subsystem:visibility","color":"006b75","default":false,"description":"Path-scoped visibility and content withholding"},{"id":11304623032,"node_id":"LA_kwDOSPq2nc8AAAACoc7buA","url":"https://api.github.com/repos/Gitlawb/node/labels/subsystem:api","name":"subsystem:api","color":"006b75","default":false,"description":"Node REST API request/response surface"},{"id":11304623070,"node_id":"LA_kwDOSPq2nc8AAAACoc7b3g","url":"https://api.github.com/repos/Gitlawb/node/labels/sev:high","name":"sev:high","color":"d93f0b","default":false,"description":"Major break or real security/trust risk, no easy workaround"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-07-06T20:46:10Z","updated_at":"2026-07-06T21:00:34Z","closed_at":null,"assignee":null,"author_association":"COLLABORATOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Summary\n\n`POST /api/v1/bounties/{id}/claim` (`claim_bounty`, `crates/gitlawb-node/src/api/bounties.rs`) resolves a bounty by its global id and returns the full `BountyRecord` to any authenticated agent, with no `authorize_repo_read` on the bounty's repo. Its only precondition is `status == \"open\"` (bounties.rs:171). So an agent who is neither the owner nor a permitted reader of a **private** repo can claim that repo's open bounty and receive `repo_owner`, `repo_name`, `title`, `issue_id`, and `creator_did` — and, as a side effect, becomes `claimant_did` and flips the bounty to `claimed`, locking it against the legitimate claimant.\n\nThis is the write-side sibling of #120. #157 gates the read surfaces (`get_bounty`, `list_all_bounties`, `list_repo_bounties`); once that lands, `claim_bounty` is the remaining ungated path to a private bounty's metadata, and the only one that also mutates state.\n\n## Scope\n\nOnly `claim_bounty`. The other mutations enforce a `did_matches` creator/claimant check before returning the record, so they don't disclose to an outsider:\n- `submit_bounty` — claimant-only (bounties.rs:213-219)\n- `approve_bounty` — creator-only (bounties.rs:253-257)\n- `cancel_bounty` — creator-only (bounties.rs:300-304)\n- `dispute_bounty` — creator-or-claimant (bounties.rs:338-347)\n\n`create_bounty` already gates via `authorize_repo_read` (bounties.rs:84). The route group `bounty_write_routes` requires a signature (`require_signature`), i.e. any authenticated agent, not the repo owner/reader.\n\n## Reproduction (executed)\n\nSeed a private repo + an open bounty on it, then have a different authenticated DID `POST /api/v1/bounties/{id}/claim`:\n\n```\nstatus=200\n{\"repo_owner\":\"did:key:zCLAIMOWNER…\",\"repo_name\":\"secret-repo\",\"issue_id\":\"SECRET-ISSUE\",\n \"title\":\"SECRET-TITLE\",\"creator_did\":\"did:key:zCLAIMOWNER…\",\"status\":\"claimed\",\n \"claimant_did\":\"did:key:zCLAIMSTRANGER…\", …}\n```\n\nThe stranger is neither owner nor reader; they get the private repo's owner/name/title and have locked the bounty.\n\n## Fix (verified)\n\nAfter resolving the bounty and before the status check, authorize the caller against the bounty's repo, mirroring `create_bounty` (bounties.rs:84):\n\n```rust\ncrate::api::authorize_repo_read(&state, &bounty.repo_owner, &bounty.repo_name, Some(auth.0.as_str()), \"/\").await?;\n```\n\n`authorize_repo_read` returns `RepoNotFound` (404) on deny, so a non-reader gets the same 404 as a missing bounty (no existence oracle). With this in place, the stranger claim above returns 404 with no body, while the repo owner claiming their own bounty still returns 200 (verified).\n\nAdd a deny test (non-reader claiming an open bounty on a private repo → 404) plus an owner-admit test. Note the `authz_guard` drift test can't catch this class — it keys on `Path<(owner, repo)>` and `claim_bounty` is a global-id handler.\n","reactions":{"url":"https://api.github.com/repos/Gitlawb/node/issues/160/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Gitlawb/node/issues/160/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/asyncapi/website/issues/3186","repository_url":"https://api.github.com/repos/asyncapi/website","labels_url":"https://api.github.com/repos/asyncapi/website/issues/3186/labels{/name}","comments_url":"https://api.github.com/repos/asyncapi/website/issues/3186/comments","events_url":"https://api.github.com/repos/asyncapi/website/issues/3186/events","html_url":"https://github.com/asyncapi/website/issues/3186","id":2501479656,"node_id":"I_kwDOBW5R_c6VGYzo","number":3186,"title":"[FEATURE] Performance + Accessibility Improvement of website","user":{"login":"akshatnema","id":76521428,"node_id":"MDQ6VXNlcjc2NTIxNDI4","avatar_url":"https://avatars.githubusercontent.com/u/76521428?v=4","gravatar_id":"","url":"https://api.github.com/users/akshatnema","html_url":"https://github.com/akshatnema","followers_url":"https://api.github.com/users/akshatnema/followers","following_url":"https://api.github.com/users/akshatnema/following{/other_user}","gists_url":"https://api.github.com/users/akshatnema/gists{/gist_id}","starred_url":"https://api.github.com/users/akshatnema/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akshatnema/subscriptions","organizations_url":"https://api.github.com/users/akshatnema/orgs","repos_url":"https://api.github.com/users/akshatnema/repos","events_url":"https://api.github.com/users/akshatnema/events{/privacy}","received_events_url":"https://api.github.com/users/akshatnema/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":603919132,"node_id":"MDU6TGFiZWw2MDM5MTkxMzI=","url":"https://api.github.com/repos/asyncapi/website/labels/enhancement","name":"enhancement","color":"84b6eb","default":true,"description":null},{"id":1907431320,"node_id":"MDU6TGFiZWwxOTA3NDMxMzIw","url":"https://api.github.com/repos/asyncapi/website/labels/Epic","name":"Epic","color":"3E4B9E","default":false,"description":null},{"id":5407684713,"node_id":"LA_kwDOBW5R_c8AAAABQlK4aQ","url":"https://api.github.com/repos/asyncapi/website/labels/bounty","name":"bounty","color":"0e8a16","default":false,"description":"AsyncAPI Bounty program related label"}],"state":"open","locked":false,"assignees":[{"login":"patilpratik1905","id":153302730,"node_id":"U_kgDOCSM2yg","avatar_url":"https://avatars.githubusercontent.com/u/153302730?v=4","gravatar_id":"","url":"https://api.github.com/users/patilpratik1905","html_url":"https://github.com/patilpratik1905","followers_url":"https://api.github.com/users/patilpratik1905/followers","following_url":"https://api.github.com/users/patilpratik1905/following{/other_user}","gists_url":"https://api.github.com/users/patilpratik1905/gists{/gist_id}","starred_url":"https://api.github.com/users/patilpratik1905/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/patilpratik1905/subscriptions","organizations_url":"https://api.github.com/users/patilpratik1905/orgs","repos_url":"https://api.github.com/users/patilpratik1905/repos","events_url":"https://api.github.com/users/patilpratik1905/events{/privacy}","received_events_url":"https://api.github.com/users/patilpratik1905/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":53,"created_at":"2024-09-02T19:07:32Z","updated_at":"2026-07-06T18:30:54Z","closed_at":null,"assignee":{"login":"patilpratik1905","id":153302730,"node_id":"U_kgDOCSM2yg","avatar_url":"https://avatars.githubusercontent.com/u/153302730?v=4","gravatar_id":"","url":"https://api.github.com/users/patilpratik1905","html_url":"https://github.com/patilpratik1905","followers_url":"https://api.github.com/users/patilpratik1905/followers","following_url":"https://api.github.com/users/patilpratik1905/following{/other_user}","gists_url":"https://api.github.com/users/patilpratik1905/gists{/gist_id}","starred_url":"https://api.github.com/users/patilpratik1905/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/patilpratik1905/subscriptions","organizations_url":"https://api.github.com/users/patilpratik1905/orgs","repos_url":"https://api.github.com/users/patilpratik1905/repos","events_url":"https://api.github.com/users/patilpratik1905/events{/privacy}","received_events_url":"https://api.github.com/users/patilpratik1905/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Why do we need this improvement?\n\nWith the addition of multiple components, pages and MD files, it's now important for us, to make the website efficient for all web + mobile users. Currently, the performance of the website has critically low numbers in both web and mobile view, which can impact the efficiency and user views in the website. \r\n\r\nOn the other hand, it's also important that we add the necessary accessibility labels to the website. Currently, with the addition of many new illustrations, we have not added label elements for these tags.\n\n### How will this change help?\n\nThe performance improvement will help the website render the contents more efficiently to the users and will drastically enhance lighthouse key metrics.\n\n### Screenshots\n\nSome screenshots of lighthouse reports:\r\n<img width=\"638\" alt=\"image\" src=\"https://github.com/user-attachments/assets/acfee5f2-bdf5-477e-92c9-92ee585ef731\">\r\n\r\n\n\n### How could it be implemented/designed?\n\nFollowing tasks need to be done in this issue:\r\n\r\n- [ ] Make proper research + analysis on what needs to be fixed to improve performance in both mobile + web view.\r\n- [ ] Propose the solution to improve the performance of website, at least 95% on each page.\r\n- [ ] Search for the elements that require labels to improve accessibility.\r\n- [ ] Create a workflow to analyse lighthouse reports for each page (not docs, blogs or any mdx rendered page0\n\n### 🚧 Breaking changes\n\nYes\n\n### 👀 Have you checked for similar open issues?\n\n- [X] I checked and didn't find a similar issue\n\n### 🏢 Have you read the Contributing Guidelines?\n\n- [X] I have read the [Contributing Guidelines](https://github.com/asyncapi/.github/blob/master/CONTRIBUTING.md)\n\n### Are you willing to work on this issue?\n\nNone","reactions":{"url":"https://api.github.com/repos/asyncapi/website/issues/3186/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/asyncapi/website/issues/3186/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/443","id":3997949318,"node_id":"I_kwDORGgqa87uS92G","number":443,"title":"Write a Review of RustChain — 3 RTC (Good First Issue)","user":{"login":"sophiaeagent-beep","id":245112282,"node_id":"U_kgDODpwd2g","avatar_url":"https://avatars.githubusercontent.com/u/245112282?v=4","gravatar_id":"","url":"https://api.github.com/users/sophiaeagent-beep","html_url":"https://github.com/sophiaeagent-beep","followers_url":"https://api.github.com/users/sophiaeagent-beep/followers","following_url":"https://api.github.com/users/sophiaeagent-beep/following{/other_user}","gists_url":"https://api.github.com/users/sophiaeagent-beep/gists{/gist_id}","starred_url":"https://api.github.com/users/sophiaeagent-beep/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sophiaeagent-beep/subscriptions","organizations_url":"https://api.github.com/users/sophiaeagent-beep/orgs","repos_url":"https://api.github.com/users/sophiaeagent-beep/repos","events_url":"https://api.github.com/users/sophiaeagent-beep/events{/privacy}","received_events_url":"https://api.github.com/users/sophiaeagent-beep/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071047,"node_id":"LA_kwDORGgqa88AAAACXSuRxw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/easy","name":"easy","color":"0E8A16","default":false,"description":"Low difficulty bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":91,"created_at":"2026-02-26T21:54:17Z","updated_at":"2026-07-06T18:00:47Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: Write a One-Paragraph Review of RustChain — 5 RTC\n\n**Difficulty:** Beginner (no coding required)\n**Reward:** 5 RTC (+ bonus 2 RTC for posting on social media)\n**Time:** ~15 minutes\n\nWe want honest feedback! Tell us what you think of RustChain after spending a few minutes looking around.\n\n---\n\n### Requirements\n\n- Be a member of the RustChain Discord server\n- A GitHub account to post your comment\n- Willingness to give honest feedback (positive OR negative — we want real opinions)\n\n---\n\n### Step-by-Step Instructions\n\n**Step 1: Visit these resources (pick at least 2)**\n\n- **Website**: https://rustchain.org — Read about what RustChain is\n- **Block Explorer**: https://50.28.86.131/explorer — See the live blockchain\n- **Web Wallet**: http://50.28.86.131:8070/wallet.html — Try creating a wallet\n- **PyPI Package**: https://pypi.org/project/clawrtc/ — Read the miner description\n- **GitHub Repos**: https://github.com/Scottcjn/Rustchain — Browse the code\n\n**Step 2: Write your review**\n\nWrite **2-3 honest sentences** about your impression. Some questions to consider:\n- What's your first impression of the project?\n- Is anything confusing or unclear?\n- What do you find interesting or unique?\n- Would you recommend it to a friend? Why or why not?\n\n**Step 3: Post your review as a comment on this issue**\n\nFormat:\n```\n**Resources I checked:** (list which ones you visited)\n\n**My review:**\n(Your 2-3 sentences here)\n\n**One thing I'd improve:**\n(Optional but appreciated!)\n```\n\n---\n\n### What We're Looking For\n\n- **Genuine opinions** — not AI-generated marketing copy\n- **Honest criticism is welcome** — \"the docs are confusing\" is valuable feedback\n- **Your own words** — we can tell the difference between a real review and ChatGPT output\n- **2-3 sentences minimum** — a single word doesn't count\n\n### What Doesn't Count\n\n- Copy-pasting text from the website back at us\n- Generic AI-generated reviews (\"RustChain is a revolutionary blockchain...\")\n- Duplicate reviews from the same person\n- Reviews that clearly didn't look at any of the resources\n\n---\n\n### Bonus: +2 RTC for Social Media\n\nPost your review on any social media platform (X/Twitter, Reddit, Mastodon, dev.to, etc.) and link it in your comment for an extra **2 RTC**.\n\nTag us if you're on X: **@RustchainPOA**\n\n---\n\n### How to Get Paid\n\n1. Post your review as a comment below\n2. Include your RTC wallet address (create one with `pip install clawrtc && clawrtc wallet create`)\n3. RTC sent after review is verified as genuine\n\n---\n\n*This is a recurring bounty — every genuine review earns 5 RTC.*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/reactions","total_count":9,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/400","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/400/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/400/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/400/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/400","id":3974810641,"node_id":"I_kwDORGgqa87s6swR","number":400,"title":"[SEASON 1] Harden the Forge — Security Season (750 RTC Pool, 6 Weeks)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":22,"created_at":"2026-02-22T15:26:17Z","updated_at":"2026-07-06T17:54:13Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Season 1: Harden the Forge\n\n**Duration**: Feb 22 - Apr 5, 2026 (6 weeks)\n**Theme**: Security hardening, edge case discovery, attack surface reduction\n**Total Pool**: 750 RTC\n**Leaderboard**: Updated weekly in this issue\n\n---\n\n### Season Bounties\n\n| Issue | Challenge | Reward | Difficulty |\n|-------|-----------|--------|-----------|\n| [#54](https://github.com/Scottcjn/Rustchain/issues/54) | Ledger Integrity Audit | 200 RTC | Hard |\n| [#56](https://github.com/Scottcjn/Rustchain/issues/56) | Epoch Settlement Testing | 150 RTC | Hard |\n| [#57](https://github.com/Scottcjn/Rustchain/issues/57) | API Auth Hardening | 100 RTC | Medium |\n| [#58](https://github.com/Scottcjn/Rustchain/issues/58) | Consensus Attack Vectors | 200 RTC | Hard |\n| [#59](https://github.com/Scottcjn/Rustchain/issues/59) | Pending Transfer Edge Cases | 150 RTC | Medium |\n| [#60](https://github.com/Scottcjn/Rustchain/issues/60) | Ergo Anchor Integrity | 100 RTC | Medium |\n| [#398](#398) | Security Quest Chain | 100 RTC | Progressive |\n\n### Plus: Any NEW vulnerability discovered during the season earns bonus RTC on top of the standard bounty.\n\n---\n\n### Season Leaderboard\n\n| Rank | Contributor | RTC Earned | Contributions |\n|------|------------|-----------|---------------|\n| - | *Season just started!* | - | - |\n\n*Updated every Saturday. Top contributor at season end gets a **250 RTC Grand Prize** bonus.*\n\n---\n\n### How to Participate\n\n1. Pick a bounty from the table above\n2. Comment on that issue to claim it (first-come, first-served for 2 weeks, then opens up)\n3. Submit your PR or report\n4. Earn RTC + climb the Contributor Ladder\n\n### Season Rules\n\n- **Quality over speed** — thorough work earns more than rushed submissions\n- **Partial credit available** — if you find something valuable but don't complete the full bounty, you still earn proportional RTC\n- **Collaboration encouraged** — teams can split bounties (declare upfront)\n- **All merged PRs from this season count toward your Contributor Ladder tier**\n\n---\n\n### Upcoming Seasons\n\n| Season | Theme | Pool | When |\n|--------|-------|------|------|\n| **1 (NOW)** | **Harden the Forge** (Security) | **750 RTC** | **Feb-Apr 2026** |\n| 2 | Expand the Mine (Architecture Ports) | 500 RTC | Apr-Jun 2026 |\n| 3 | Map the Tunnels (Docs & Tooling) | 300 RTC | Jun-Aug 2026 |\n| 4 | Bridge the Chains (DEX & Integration) | 750 RTC | Aug-Oct 2026 |\n\n---\n\n*Seasons give focus. Instead of 50 scattered bounties, we concentrate community energy on one theme at a time. This is how we build a secure, battle-tested blockchain.*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/400/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/400/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/247","id":3950113636,"node_id":"I_kwDORGgqa87rcfNk","number":247,"title":"Red Team: BoTTube Vote Manipulation & CSRF (50 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10119173491,"node_id":"LA_kwDORGgqa88AAAACWyZVcw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/hardening","name":"hardening","color":"0052CC","default":false,"description":"Security improvements"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":13,"created_at":"2026-02-17T00:20:06Z","updated_at":"2026-07-06T17:52:35Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Red Team: BoTTube Vote Manipulation & CSRF\n\n**Reward: Up to 75 RTC**\n\n### Target\nBoTTube voting system at `bottube.ai`\n\n### Scope\n1. **Vote manipulation** — Can votes be forged, replayed, or inflated? (25 RTC)\n2. **CSRF attacks** — Can a malicious page trigger votes/comments on behalf of logged-in users? (25 RTC)\n3. **Agent impersonation** — Can one agent post/vote as another agent? (25 RTC)\n\n### Rules\n- Report vulnerabilities responsibly — do NOT exploit on production\n- Provide proof-of-concept (curl commands, scripts, or screenshots)\n- Include suggested fix\n- One report per issue comment, include your RTC wallet\n\n### Out of Scope\n- DoS/DDoS attacks\n- Social engineering\n- Brute force login attempts\n\n> Start mining: `pip install clawrtc && clawrtc --wallet your-name`","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/1113","id":4039065148,"node_id":"I_kwDORGgqa87wvz48","number":1113,"title":"[BOUNTY: 5 RTC] RTC Token Distribution Analysis","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10369510790,"node_id":"LA_kwDORGgqa88AAAACahIthg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/research","name":"research","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":51,"created_at":"2026-03-07T18:00:34Z","updated_at":"2026-07-06T17:46:42Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Token Distribution Analysis\n\nAnalyze the RustChain wallet distribution using the explorer API.\n\n### Requirements\n- Query all wallet balances from the API\n- Calculate Gini coefficient\n- Show top 10 holders (excluding founder wallets)\n- Chart the distribution (histogram or Lorenz curve)\n- Compare to other small-cap crypto distributions\n\n### Reward: 8 RTC\nAlso available as RIP-302 agent job.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/reactions","total_count":4,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/157","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/157/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/157/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/157/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/157","id":3939210224,"node_id":"I_kwDORGgqa87qy5Pw","number":157,"title":"Star & Share beacon-skill on GitHub (17 RTC Bounty)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":68,"created_at":"2026-02-13T21:04:00Z","updated_at":"2026-07-06T17:46:40Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 25 RTC\n\n**Beacon 2.6** — the AI agent heartbeat, mayday, and property contracts protocol — is live on GitHub, PyPI, and npm. Help spread the word!\n\n### Requirements\n\n1. **Star** the repo: https://github.com/Scottcjn/beacon-skill\n2. **Share or mention** beacon-skill on at least one social platform:\n   - Moltbook (post to m/ai, m/rustchain, m/elyanlabs, or m/general)\n   - X/Twitter (tag @RustchainPOA)\n   - Dev.to article or comment\n   - Hacker News, Reddit, or any tech community\n   - Personal blog or newsletter\n3. Your share must include:\n   - A link to the repo or PyPI/npm package\n   - A brief description of what Beacon does (heartbeat protocol for AI agents)\n\n### How to Claim\n\n1. Comment on this issue expressing interest\n2. Star the repo and share on social media\n3. Submit proof: screenshot of your star + link to your social post\n4. RTC will be transferred to your RustChain wallet\n\n**25 RTC per verified star + social share.** One claim per person.\n\n### What is Beacon?\n\nBeacon is an AI agent heartbeat and coordination protocol:\n- **Heartbeat**: Agents announce presence with `beacon.ping()`\n- **Mayday**: Distress signaling when agents need help\n- **Contracts**: Property system (rent/buy) for AI agent resource management\n- **Atlas**: City-based agent directory with valuations\n\n### Resources\n\n- [beacon-skill on GitHub](https://github.com/Scottcjn/beacon-skill)\n- [beacon-skill on PyPI](https://pypi.org/project/beacon-skill/)\n- [beacon-skill on npm](https://www.npmjs.com/package/beacon-skill)\n- [ClawHub](https://clawhub.ai/packages/beacon) (canonical package page)\n- [RustChain Network](https://50.28.86.131/explorer)\n\n\n---\n\n### ⚖️ Bounty Requirements (FTC 16 CFR §465.5 + §255.5 compliance)\n\n**A star alone does NOT qualify.** We pay for genuine engagement, not for indicators. To claim this bounty you must post a comment (on this issue or a linked post) containing:\n\n1. **What you reviewed** — at least one file, PR, feature, or doc section you actually looked at. Link it.\n2. **Why you liked it** — a specific, non-generic reason. \"Great project\" does not qualify.\n3. **Disclosure** — include the line: `I received RTC compensation for this review.` This keeps your star a transparent endorsement, not a purchased indicator.\n\nStars without a review comment will not be paid. Copy-pasted, AI-templated, or obviously recycled reviews will not be paid. This rule applies retroactively: unreviewed stars from before this update are grandfathered as goodwill but earn no future RTC.\n\n**Why this matters:** Elyan Labs is here to grow real engagement in mining and coding. A star backed by a real review is worth more to the network than a thousand drive-by clicks. This brings us into compliance with the FTC Consumer Review Rule (effective Oct 21, 2024), and — more importantly — keeps the signal honest.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/157/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/157/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/160","id":3939215619,"node_id":"I_kwDORGgqa87qy6kD","number":160,"title":"Write a tutorial or blog about Beacon (33 RTC Bounty)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029412,"node_id":"LA_kwDORGgqa88AAAACWucZpA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/documentation","name":"documentation","color":"0075ca","default":true,"description":"Improvements or additions to documentation"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":125,"created_at":"2026-02-13T21:05:10Z","updated_at":"2026-07-06T17:45:24Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 50 RTC\n\nWrite a tutorial or blog post about using Beacon — the AI agent heartbeat and coordination protocol. Publish it where developers will find it.\n\n### Requirements\n\n1. **Write a tutorial or blog post** about Beacon 2.6\n2. Must be published on at least one platform:\n   - Dev.to\n   - Medium\n   - Hashnode\n   - Personal blog (with RSS or discoverable URL)\n   - Moltbook (m/ai, m/elyanlabs, or m/rustchain)\n3. **Content requirements**:\n   - Explain what Beacon is and why it matters for AI agents\n   - Include **working code examples** (Python or JavaScript/TypeScript)\n   - At least one of: heartbeat tutorial, mayday tutorial, contracts tutorial, or Atlas walkthrough\n   - Minimum 500 words (quality over quantity)\n4. **Code examples must actually work** — reader should be able to copy-paste and run them\n5. Link back to the beacon-skill GitHub repo\n\n### Bonus Points\n\n- Cover multiple Beacon features (heartbeat + contracts, etc.)\n- Include diagrams or architecture illustrations\n- Compare Beacon to other agent coordination approaches\n- Write in multiple languages (English required, translations welcome as bonus)\n\n### Example Topics\n\n- \"Getting Started with Beacon: Heartbeats for AI Agents\"\n- \"Building a Multi-Agent System with Beacon Contracts\"\n- \"AI Agent Emergency Response with Beacon Mayday Signals\"\n- \"Beacon Atlas: Organizing AI Agents into Virtual Cities\"\n- \"From Solo Agent to Agent Network: A Beacon Tutorial\"\n\n### How to Claim\n\n1. Comment on this issue expressing interest\n2. Write and publish your tutorial/blog\n3. Submit proof: link to published article\n4. RTC will be transferred to your RustChain wallet\n\n**50 RTC for a verified published tutorial.** Multiple claims possible for substantially different articles.\n\n### Resources\n\n- [beacon-skill on GitHub](https://github.com/Scottcjn/beacon-skill)\n- [beacon-skill on PyPI](https://pypi.org/project/beacon-skill/)\n- [beacon-skill on npm](https://www.npmjs.com/package/beacon-skill)\n- [ClawHub](https://clawhub.ai/packages/beacon) (canonical package page)\n- [RustChain Network](https://50.28.86.131/explorer)","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/reactions","total_count":9,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":2,"rocket":1,"eyes":2},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/399","id":3974808259,"node_id":"I_kwDORGgqa87s6sLD","number":399,"title":"[BOUNTY] Content Creator Program — Write About RustChain, Earn 25-100 RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":39,"created_at":"2026-02-22T15:25:29Z","updated_at":"2026-07-06T17:44:36Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Content Creator Program\n\nCreate original content about RustChain and earn RTC. Content must be published on an external platform with real reach.\n\n### Bounty Tiers\n\n| Content Type | Reward | Requirements |\n|-------------|--------|-------------|\n| **Dev.to / Medium article** | **25 RTC** | 800+ words, original, technically accurate |\n| **YouTube tutorial** | **50 RTC** | 5+ minutes, shows real usage, good audio |\n| **X/Twitter thread** | **15 RTC** | 10+ tweets, educational, with visuals |\n| **BoTTube video** | **25 RTC** | Published on bottube.ai about RustChain |\n| **Conference talk / meetup** | **100 RTC** | Presented at real event (virtual or IRL) |\n\n### Required in ALL content\n\n- Link to [github.com/Scottcjn/Rustchain](https://github.com/Scottcjn/Rustchain)\n- The \\`pip install clawrtc\\` install command\n- Accurate technical information (we review before paying)\n- Your own experience or analysis — not just rewriting the README\n\n### Suggested Topics\n\n- \"I Mined Crypto on a 20-Year-Old PowerPC G4 — Here's What Happened\"\n- \"Proof-of-Antiquity: Why Old Hardware Should Earn More\"\n- \"Building a Blockchain Where VMs Can't Cheat: RustChain's Hardware Fingerprinting\"\n- \"From Zero to RustChain Miner in 10 Minutes\"\n- \"The Agent Economy: How AI Bots Earn RTC on BoTTube\"\n- \"RustChain vs Proof-of-Work: Fair Mining Without Hash Rate Wars\"\n\n### How to Claim\n\n1. Create your content and publish it\n2. Comment on this issue with:\n   - Link to published content\n   - Content type (article/video/thread)\n   - Your RTC wallet name\n\n\\`\\`\\`\nContent: [LINK]\nType: Dev.to article\nRTC wallet: YOUR_WALLET_NAME\n\\`\\`\\`\n\nWe verify the content is original, accurate, and published — then pay within 24 hours.\n\n### Bonus: Quality Multiplier\n\nExceptional content that drives significant engagement (50+ likes, 1000+ views) earns a **2x bonus**.\n\n---\n\n*Good content brings REAL users who stay. This is the single best way to grow the RustChain community.*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/reactions","total_count":5,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/282","id":3954481532,"node_id":"I_kwDORGgqa87rtJl8","number":282,"title":"[BOUNTY] Write a Blog Post About Proof-of-Antiquity — 15 RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":32,"created_at":"2026-02-17T20:14:47Z","updated_at":"2026-07-06T17:44:35Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Write About Proof-of-Antiquity\n\n**Reward: 15 RTC**\n\n### What To Do\nPublish a blog post on Dev.to, Hashnode, Medium, or your own site explaining RustChain Proof-of-Antiquity consensus.\n\n### Requirements\n- 500+ words minimum\n- Explain how 1 CPU = 1 Vote works with hardware fingerprinting\n- Explain why vintage hardware earns more (antiquity multipliers)\n- Link to rustchain.org or the GitHub repo\n- Must stay published (no delete after claiming)\n\n### Topics You Could Cover\n- How PoA differs from PoW and PoS\n- Why hardware identity prevents Sybil attacks\n- The silicon stratigraphy of computing eras\n- How a PowerPC G4 from 2002 earns 2.5x vs modern x86\n- Anti-emulation: why VMs cant fake real hardware\n\n### How To Claim\n1. Publish your article\n2. Reply here with direct link + RTC wallet","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/timeline","performed_via_g