://avatars.githubusercontent.com/u/6250945?v=4","gravatar_id":"","url":"https://api.github.com/users/nibzard","html_url":"https://github.com/nibzard","followers_url":"https://api.github.com/users/nibzard/followers","following_url":"https://api.github.com/users/nibzard/following{/other_user}","gists_url":"https://api.github.com/users/nibzard/gists{/gist_id}","starred_url":"https://api.github.com/users/nibzard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nibzard/subscriptions","organizations_url":"https://api.github.com/users/nibzard/orgs","repos_url":"https://api.github.com/users/nibzard/repos","events_url":"https://api.github.com/users/nibzard/events{/privacy}","received_events_url":"https://api.github.com/users/nibzard/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":7347006954,"node_id":"LA_kwDOJ5_ntc8AAAABtept6g","url":"https://api.github.com/repos/daytonaio/content/labels/%F0%9F%92%8E%20Bounty","name":"💎 Bounty","color":"4f46e5","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":134,"created_at":"2024-08-19T15:05:03Z","updated_at":"2026-07-03T22:24:00Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Content Type\n\nGuide\n\n### Article Description\n\nContribute to the repo to add more supported APIs: https://github.com/nkkko/sapat\r\nOpenAI, groq, what else?\r\nWrite a long-form guide based on the repo and readme.\r\n\n\n### Target Audience\n\nAI engineer\n\n### References/Resources\n\nhttps://github.com/nkkko/sapat\n\n### Examples\n\nThis is a nice example, but it needs to be longer, explain more each step, especially whisper:\r\nhttps://www.daytona.io/dotfiles/how-to-set-up-a-project-with-cal-com-and-supabase\n\n### Special Instructions\n\n_No response_","reactions":{"url":"https://api.github.com/repos/daytonaio/content/issues/13/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/daytonaio/content/issues/13/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/tscircuit/dsn-converter/issues/54","repository_url":"https://api.github.com/repos/tscircuit/dsn-converter","labels_url":"https://api.github.com/repos/tscircuit/dsn-converter/issues/54/labels{/name}","comments_url":"https://api.github.com/repos/tscircuit/dsn-converter/issues/54/comments","events_url":"https://api.github.com/repos/tscircuit/dsn-converter/issues/54/events","html_url":"https://github.com/tscircuit/dsn-converter/issues/54","id":2724655942,"node_id":"I_kwDOMzB_qM6iZvNG","number":54,"title":"We can't convert Smoothie Board to Circuit JSON","user":{"login":"seveibar","id":1910070,"node_id":"MDQ6VXNlcjE5MTAwNzA=","avatar_url":"https://avatars.githubusercontent.com/u/1910070?v=4","gravatar_id":"","url":"https://api.github.com/users/seveibar","html_url":"https://github.com/seveibar","followers_url":"https://api.github.com/users/seveibar/followers","following_url":"https://api.github.com/users/seveibar/following{/other_user}","gists_url":"https://api.github.com/users/seveibar/gists{/gist_id}","starred_url":"https://api.github.com/users/seveibar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/seveibar/subscriptions","organizations_url":"https://api.github.com/users/seveibar/orgs","repos_url":"https://api.github.com/users/seveibar/repos","events_url":"https://api.github.com/users/seveibar/events{/privacy}","received_events_url":"https://api.github.com/users/seveibar/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":243,"created_at":"2024-12-07T14:43:29Z","updated_at":"2026-07-03T22:23:48Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Smoothie Board: https://github.com/freerouting/freerouting/blob/master/tests/Issue145-smoothieboard.dsn\nUpload to DSN Viewer: https://dsn.tscircuit.com/\n\nThis is probably a pretty hard multi-step issue. Make sure to download freerouting to make sure the snapshot resembles the DSN file.\n\nIn addition to the bounty, we will likely tip for steps along the way because doing it in one big PR may be counter-productive.\n\n/bounty $70\n\n![Image](https://github.com/user-attachments/assets/a612114f-df22-434c-80a5-383c9e754ae3)\n","reactions":{"url":"https://api.github.com/repos/tscircuit/dsn-converter/issues/54/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/tscircuit/dsn-converter/issues/54/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/251","repository_url":"https://api.github.com/repos/xevrion-v2/agent-playground","labels_url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/251/labels{/name}","comments_url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/251/comments","events_url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/251/events","html_url":"https://github.com/xevrion-v2/agent-playground/issues/251","id":4585007531,"node_id":"I_kwDOSvpFLM8AAAABEUmpqw","number":251,"title":"[BUG] Root package.json uses invalid '--workspaces' flag — all monorepo scripts are broken","user":{"login":"pangtongya","id":100079486,"node_id":"U_kgDOBfcXfg","avatar_url":"https://avatars.githubusercontent.com/u/100079486?v=4","gravatar_id":"","url":"https://api.github.com/users/pangtongya","html_url":"https://github.com/pangtongya","followers_url":"https://api.github.com/users/pangtongya/followers","following_url":"https://api.github.com/users/pangtongya/following{/other_user}","gists_url":"https://api.github.com/users/pangtongya/gists{/gist_id}","starred_url":"https://api.github.com/users/pangtongya/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pangtongya/subscriptions","organizations_url":"https://api.github.com/users/pangtongya/orgs","repos_url":"https://api.github.com/users/pangtongya/repos","events_url":"https://api.github.com/users/pangtongya/events{/privacy}","received_events_url":"https://api.github.com/users/pangtongya/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":4,"created_at":"2026-06-04T01:34:46Z","updated_at":"2026-07-03T18:59:36Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bug Description\n\nThe root `package.json` scripts use `--workspaces` (plural) which is **not a valid npm workspaces flag**:\n\n```json\n{\n  \"scripts\": {\n    \"dev\": \"npm run dev --workspaces --if-present\",\n    \"test\": \"npm run test --workspaces --if-present\",\n    \"lint\": \"npm run lint --workspaces --if-present\",\n    \"format\": \"npm run format --workspaces --if-present\"\n  }\n}\n```\n\n## Root Cause\n\nnpm's workspace flag is `--workspace` (singular) with shorthand `-ws`. `--workspaces` is not recognized and will cause npm to silently ignore the flag or throw an error depending on the npm version.\n\n**Correct:** `npm run dev -ws --if-present` or `npm run dev --workspace --if-present`\n\n**npm documentation:** https://docs.npmjs.com/cli/v10/using-npm/workspaces#running-commands-in-the-context-of-workspaces\n\n## Impact\n\n- Running `npm run test` at the root level will NOT execute tests in any workspace\n- Running `npm run dev` at root will NOT start all apps\n- All 4 root scripts (dev, test, lint, format) are non-functional\n- CI and automation that rely on these scripts will silently skip all workspace commands\n\n## Severity\n\n**Medium** — Core monorepo functionality is broken. Every developer who clones this repo and runs `npm run test` will get no test output and assume everything passes.\n\n## Proposed Fix\n\nReplace `--workspaces` with `-ws` (or `--workspace`) in all 4 scripts:\n\n```json\n{\n  \"scripts\": {\n    \"dev\": \"npm run dev -ws --if-present\",\n    \"test\": \"npm run test -ws --if-present\",\n    \"lint\": \"npm run lint -ws --if-present\",\n    \"format\": \"npm run format -ws --if-present\"\n  }\n}\n```\n\n## References\n\n- Per the bug bounty program described in #33\n- npm workspaces docs: https://docs.npmjs.com/cli/v10/using-npm/workspaces\n\n/bounty $300","reactions":{"url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/251/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/251/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/issues/926","repository_url":"https://api.github.com/repos/ubiquity/ubiquity-dollar","labels_url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/issues/926/labels{/name}","comments_url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/issues/926/comments","events_url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/issues/926/events","html_url":"https://github.com/ubiquity/ubiquity-dollar/issues/926","id":2246031922,"node_id":"I_kwDOF4fVBs6F37oy","number":926,"title":"Formal verification","user":{"login":"rndquu","id":119500907,"node_id":"U_kgDOBx9waw","avatar_url":"https://avatars.githubusercontent.com/u/119500907?v=4","gravatar_id":"","url":"https://api.github.com/users/rndquu","html_url":"https://github.com/rndquu","followers_url":"https://api.github.com/users/rndquu/followers","following_url":"https://api.github.com/users/rndquu/following{/other_user}","gists_url":"https://api.github.com/users/rndquu/gists{/gist_id}","starred_url":"https://api.github.com/users/rndquu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rndquu/subscriptions","organizations_url":"https://api.github.com/users/rndquu/orgs","repos_url":"https://api.github.com/users/rndquu/repos","events_url":"https://api.github.com/users/rndquu/events{/privacy}","received_events_url":"https://api.github.com/users/rndquu/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":5898797883,"node_id":"LA_kwDOF4fVBs8AAAABX5iDOw","url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/labels/Time:%20%3C1%20Day","name":"Time: <1 Day","color":"ededed","default":false,"description":null},{"id":5898805638,"node_id":"LA_kwDOF4fVBs8AAAABX5ihhg","url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/labels/Priority:%201%20(Normal)","name":"Priority: 1 (Normal)","color":"ededed","default":false,"description":null},{"id":5898837553,"node_id":"LA_kwDOF4fVBs8AAAABX5keMQ","url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/labels/Price:%20300%20USD","name":"Price: 300 USD","color":"1f883d","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":33,"created_at":"2024-04-16T13:15:22Z","updated_at":"2026-07-03T17:47:10Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"We should implement formal verification for [LibUbiquityPool](https://github.com/ubiquity/ubiquity-dollar/blob/a1b11e1b944227144d7cc19ab320220d9fce8b69/packages/contracts/src/dollar/libraries/LibUbiquityPool.sol). \r\n\r\nSo collaborator who's going to take this issue should carefully study the [LibUbiquityPool](https://github.com/ubiquity/ubiquity-dollar/blob/a1b11e1b944227144d7cc19ab320220d9fce8b69/packages/contracts/src/dollar/libraries/LibUbiquityPool.sol) and think of the invariants that should be tested.\r\n\r\nInvariants could be:\r\n- user can not mint more Dollars in USD than provided collateral\r\n- user can not redeem more collateral in USD than provided Dollar tokens\r\n\r\nPossible solutions for formal verification:\r\n- https://github.com/a16z/halmos\r\n- https://docs.runtimeverification.com/kontrol\r\n\r\nWe already had a try with formal verification, you may find related scripts [here](https://github.com/ubiquity/ubiquity-dollar/tree/a1b11e1b944227144d7cc19ab320220d9fce8b69/packages/contracts/scripts/smt-checker).\r\n\r\nWhat should be done:\r\n1. Impelent formal verification for the [LibUbiquityPool](https://github.com/ubiquity/ubiquity-dollar/blob/a1b11e1b944227144d7cc19ab320220d9fce8b69/packages/contracts/src/dollar/libraries/LibUbiquityPool.sol) contract (you may create tests in a separate test file like `UbiquityPoolFacet.formal.t.sol` so we could distinguish unit, fuzz, invariant and formal verification tests)\r\n2. Setup testing CI to run formal verification tests on merge to the `development` branch (keep in mind that github action runnners can run for 6 hours). We don't need to run formal verification tests on eash PR since they're really time consuming.\r\n","reactions":{"url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/issues/926/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/issues/926/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/moorcheh-ai/memanto/issues/639","repository_url":"https://api.github.com/repos/moorcheh-ai/memanto","labels_url":"https://api.github.com/repos/moorcheh-ai/memanto/issues/639/labels{/name}","comments_url":"https://api.github.com/repos/moorcheh-ai/memanto/issues/639/comments","events_url":"https://api.github.com/repos/moorcheh-ai/memanto/issues/639/events","html_url":"https://github.com/moorcheh-ai/memanto/issues/639","id":4597481815,"node_id":"I_kwDORu6bf88AAAABEggBVw","number":639,"title":"[BOUNTY $100] 🐜 The Great Agentic Memory Showdown: Memanto Benchmarking & Evaluation Challenge","user":{"login":"mjfekri","id":180991960,"node_id":"U_kgDOCsm32A","avatar_url":"https://avatars.githubusercontent.com/u/180991960?v=4","gravatar_id":"","url":"https://api.github.com/users/mjfekri","html_url":"https://github.com/mjfekri","followers_url":"https://api.github.com/users/mjfekri/followers","following_url":"https://api.github.com/users/mjfekri/following{/other_user}","gists_url":"https://api.github.com/users/mjfekri/gists{/gist_id}","starred_url":"https://api.github.com/users/mjfekri/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mjfekri/subscriptions","organizations_url":"https://api.github.com/users/mjfekri/orgs","repos_url":"https://api.github.com/users/mjfekri/repos","events_url":"https://api.github.com/users/mjfekri/events{/privacy}","received_events_url":"https://api.github.com/users/mjfekri/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10849173787,"node_id":"LA_kwDORu6bf88AAAAChqlBGw","url":"https://api.github.com/repos/moorcheh-ai/memanto/labels/bounty","name":"bounty","color":"fcf22a","default":false,"description":"This issue has a bounty attached to it"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":50,"created_at":"2026-06-05T13:58:36Z","updated_at":"2026-07-03T15:53:21Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"<html>\n<body>\n<!--StartFragment--><html><head></head><body><h3 data-path-to-node=\"2\" style=\"font-family: &quot;Google Sans&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"2\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Description:</b></h3><p data-path-to-node=\"3\" id=\"p-rc_c203bf6882a033d7-23\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">As AI agents scale into stateful, production-grade systems in 2026, memory management has shifted from a novelty to the primary architectural bottleneck. <span class=\"citation-11 citation-end-11\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">While dedicated platforms like Mem0, Zep (Graphiti), and Hindsight promise persistent recall, production builders still struggle with a massive trade-off: context window bloat, steep token overhead, and background processing latency.<source-footnote ng-version=\"0.0.0-PLACEHOLDER\" _nghost-ng-c3032730111=\"\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><sup _ngcontent-ng-c3032730111=\"\" class=\"superscript\" data-turn-source-index=\"1\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; font-size: 16px !important; background-color: transparent !important;\"><!----></sup></source-footnote></span><sources-carousel-inline ng-version=\"0.0.0-PLACEHOLDER\" _nghost-ng-c4240554462=\"\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">  <source-inline-chip _ngcontent-ng-c4240554462=\"\" _nghost-ng-c2372600268=\"\" class=\"ng-star-inserted\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><!----><!----><!----><!----><!----></source-inline-chip><!----><!----><!----></sources-carousel-inline></p><p data-path-to-node=\"4\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">We designed <b data-path-to-node=\"4\" data-index-in-node=\"12\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Memanto</b> to break this bottleneck. By moving away from heavy, passive vector/graph-dumping and introducing an <i data-path-to-node=\"4\" data-index-in-node=\"121\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">active companion agent</i> with serverless retrieval optimized by <code data-path-to-node=\"4\" data-index-in-node=\"183\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">moorcheh.ai</code>, we expect a massive advantage in token efficiency, p95 latency, and nuanced preference resolution.</p><p data-path-to-node=\"5\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">But we don't want you to take our word for it. We want the open-source community to prove it.</p><p data-path-to-node=\"6\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"6\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">The Challenge:</b></p><p data-path-to-node=\"6\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Build a rigorous, reproducible benchmarking suite or evaluation demo that pits <b data-path-to-node=\"6\" data-index-in-node=\"94\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Memanto</b> against another dedicated agentic memory framework (e.g., Mem0, Zep/Graphiti, Hindsight, or Letta) to stress-test their actual production efficiency.</p><p data-path-to-node=\"7\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">You can design any evaluation path you want, but your benchmark must evaluate the core tension of 2026 agent infrastructure: <b data-path-to-node=\"7\" data-index-in-node=\"125\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Accuracy vs. Resource Footprint.</b></p><h3 data-path-to-node=\"9\" style=\"font-family: &quot;Google Sans&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">💡 Need Inspiration? Here Are Two Flagship Use Cases:</h3><ul data-path-to-node=\"10\" style=\"padding-inline-start: 32px; font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><li style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><p data-path-to-node=\"10,0,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"10,0,0\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Scenario A: The Context-Overhead &amp; Latency Sprint (Data-Intensive)</b></p><p data-path-to-node=\"10,0,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Feed the agents dense, shifting technical logs or long-form medical histories. Measure the total tokens consumed per conversation turn and the retrieval latency.</p><ul data-path-to-node=\"10,0,1\" style=\"padding-inline-start: 32px; font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><li style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><p data-path-to-node=\"10,0,1,0,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><i data-path-to-node=\"10,0,1,0,0\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">The Goal:</i> Test if Memanto's active compression prevents the massive token inflation and immediate post-ingestion delays often seen in complex graph-based memory systems.</p></li></ul></li><li style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><p data-path-to-node=\"10,1,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"10,1,0\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Scenario B: The Shifting Persona &amp; Temporal Tracking Test (Dynamic Preference)</b></p><p data-path-to-node=\"10,1,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Build an agent (e.g., an evolving entertainment curator or an executive shadow) where user preferences dynamically mutate or contradict over multiple distinct sessions.</p><ul data-path-to-node=\"10,1,1\" style=\"padding-inline-start: 32px; font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><li style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><p data-path-to-node=\"10,1,1,0,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><i data-path-to-node=\"10,1,1,0,0\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">The Goal:</i> Measure preference retention accuracy over a long duration. Demonstrate how effectively Memanto flags out-of-date states and surfaces current nuances without polluting the active context window.</p></li></ul></li></ul><h3 data-path-to-node=\"12\" style=\"font-family: &quot;Google Sans&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"12\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">⚙️ Prerequisites:</b></h3><p data-path-to-node=\"13\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">To power Memanto's serverless, high-performance retrieval engine, you will need an active Moorcheh API key.</p><ul data-path-to-node=\"14\" style=\"padding-inline-start: 32px; font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><li style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><p data-path-to-node=\"14,0,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Grab your free key at <b data-path-to-node=\"14,0,0\" data-index-in-node=\"22\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><response-element class=\"\" ng-version=\"0.0.0-PLACEHOLDER\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><link-block _nghost-ng-c597493252=\"\" class=\"ng-star-inserted\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><!----><!----><a _ngcontent-ng-c597493252=\"\" target=\"_blank\" rel=\"noopener\" externallink=\"\" _nghost-ng-c1528876479=\"\" jslog=\"197247;track:generic_click,impression,attention;BardVeMetadataKey:[[&quot;r_f8c7d882f19d385d&quot;,&quot;c_f8227a11b652c333&quot;,null,&quot;rc_c203bf6882a033d7&quot;,null,null,&quot;&quot;,null,1,null,null,1,0]]\" href=\"https://moorcheh.ai/\" class=\"ng-star-inserted\" data-hveid=\"0\" decode-data-ved=\"1\" data-ved=\"0CAAQ_4QMahgKEwjmj_XCnfCUAxUAAAAAHQAAAAAQ4QE\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">moorcheh.ai</a><!----></link-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></b> before writing your setup script.</p></li></ul><h3 data-path-to-node=\"16\" style=\"font-family: &quot;Google Sans&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"16\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">🛠️ Implementation Guidelines:</b></h3><ul data-path-to-node=\"17\" style=\"padding-inline-start: 32px; font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><li style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><p data-path-to-node=\"17,0,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"17,0,0\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Direct Control Group:</b> Your code must run the exact same dataset/conversation logs through both Memanto and your chosen competitor simultaneously under identical baseline constraints.</p></li><li style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><p data-path-to-node=\"17,1,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"17,1,0\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Scientific Rigor:</b> Treat this like a formal systems experiment. You must explicitly document and isolate the host environment, the exact backend LLM used (e.g., Claude 3.5 Sonnet, GPT-4o), prompt system instructions, and engine toggles (such as graph summarization limits or routing settings).</p></li><li style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><p data-path-to-node=\"17,2,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"17,2,0\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Quantifiable Output:</b> The final run must output a clear dataset or table detailing exact differences in <b data-path-to-node=\"17,2,0\" data-index-in-node=\"103\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Total Tokens Ingested/Retrieved</b>, <b data-path-to-node=\"17,2,0\" data-index-in-node=\"136\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">p95 Latency (Seconds)</b>, and <b data-path-to-node=\"17,2,0\" data-index-in-node=\"163\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Retrieval Accuracy (via an LLM-as-a-Judge or golden dataset matching)</b>.</p></li><li style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><p data-path-to-node=\"17,3,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"17,3,0\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Total Reproducibility:</b> The benchmark suite must be plug-and-play. Include a functional <code data-path-to-node=\"17,3,0\" data-index-in-node=\"87\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">requirements.txt</code> or <code data-path-to-node=\"17,3,0\" data-index-in-node=\"107\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">pyproject.toml</code>, clear environment variable configurations, and your source evaluation dataset.</p></li></ul><h3 data-path-to-node=\"19\" style=\"font-family: &quot;Google Sans&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"19\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">\n📊 Judgment Method (The Success Matrix):</b></h3><p data-path-to-node=\"20\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">To ensure we reward actual engineering value that drives open-source distribution, submissions will be scored on a 100-point matrix split between <b data-path-to-node=\"20\" data-index-in-node=\"146\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Technical Rigor</b> and <b data-path-to-node=\"20\" data-index-in-node=\"166\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Social Amplification</b>.</p>\n\n<table>\n  <thead>\n    <tr>\n      <th>Criteria</th>\n      <th align=\"center\">Max Points</th>\n      <th>How it is Measured</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td><b>Scientific Rigor & Isolation</b></td>\n      <td align=\"center\">40 pts</td>\n      <td>Is the experimental design robust? Are variables isolated? Are prompt structures, LLMs, and platform-specific configurations thoroughly documented?</td>\n    </tr>\n    <tr>\n      <td><b>Use Case Complexity</b></td>\n      <td align=\"center\">20 pts</td>\n      <td>Does the benchmark tackle a meaningful, challenging scenario (dense data, complex evolving preferences) rather than a trivial task?</td>\n    </tr>\n    <tr>\n      <td><b>Reproducibility & Cleanliness</b></td>\n      <td align=\"center\">15 pts</td>\n      <td>Is the environment perfectly replicable? Are datasets, dependency files, and clear instructions provided? Does the code pass linting?</td>\n    </tr>\n    <tr>\n      <td><b>Social Virality</b></td>\n      <td align=\"center\">25 pts</td>\n      <td>Measured via public engagement metrics by the end of the bounty deadline.</td>\n    </tr>\n  </tbody>\n</table>\n\n<p data-path-to-node=\"22\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"22\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">The Social Formula:</b></p><p data-path-to-node=\"22\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><code data-path-to-node=\"22\" data-index-in-node=\"20\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Social Points = (Reddit Upvotes x 4) + (Reddit Comments x 3) + (X Bookmarks x 5) + (X Retweets x 3) + (GitHub PR Reactions x 2)</code></p><p data-path-to-node=\"23\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><i data-path-to-node=\"23\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">The top 3 finalists on the leaderboard will submit a screenshot of their platform analytics to verify organic reach before final payout.</i></p><h3 data-path-to-node=\"25\" style=\"font-family: &quot;Google Sans&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"25\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">🚀 Step-by-Step Instructions to Participate:</b></h3><ol start=\"1\" data-path-to-node=\"26\" style=\"padding-inline-start: 32px; font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><li style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><p data-path-to-node=\"26,0,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"26,0,0\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Star the Repository:</b> Help us clear our next star milestone this month! ⭐️</p></li><li style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><p data-path-to-node=\"26,1,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"26,1,0\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Get Your Key:</b> Sign up at <response-element class=\"\" ng-version=\"0.0.0-PLACEHOLDER\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><link-block _nghost-ng-c597493252=\"\" class=\"ng-star-inserted\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><!----><!----><a _ngcontent-ng-c597493252=\"\" target=\"_blank\" rel=\"noopener\" externallink=\"\" _nghost-ng-c1528876479=\"\" jslog=\"197247;track:generic_click,impression,attention;BardVeMetadataKey:[[&quot;r_f8c7d882f19d385d&quot;,&quot;c_f8227a11b652c333&quot;,null,&quot;rc_c203bf6882a033d7&quot;,null,null,&quot;&quot;,null,1,null,null,1,0]]\" href=\"https://moorcheh.ai/\" class=\"ng-star-inserted\" data-hveid=\"0\" decode-data-ved=\"1\" data-ved=\"0CAAQ_4QMahgKEwjmj_XCnfCUAxUAAAAAHQAAAAAQ5AE\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">moorcheh.ai</a><!----></link-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element> and configure your environment variables.</p></li><li style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><p data-path-to-node=\"26,2,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"26,2,0\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Develop:</b> Build your benchmark comparing the <code data-path-to-node=\"26,2,0\" data-index-in-node=\"44\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">memanto</code> package against an alternative memory layer.</p></li><li style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><p data-path-to-node=\"26,3,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"26,3,0\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Submit PR:</b> Fork this repo, add your implementation to a new folder in <code data-path-to-node=\"26,3,0\" data-index-in-node=\"70\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">/examples/benchmarks/</code>, and create a Pull Request. <b data-path-to-node=\"26,3,0\" data-index-in-node=\"120\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Your PR description must contain the link to your social media showcase and a summary of your benchmark metrics.</b></p></li><li style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><p data-path-to-node=\"26,4,0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\"><b data-path-to-node=\"26,4,0\" data-index-in-node=\"0\" style=\"font-family: &quot;Google Sans Text&quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;\">Amplify:</b> Write an in-depth post on Reddit https://www.reddit.com/r/AgenticMemory/ or X and mention @moorcheh_ai showing off your benchmarking results and explaining why Memanto won. </p></li></ol></body></html><!--EndFragment-->\n</body>\n<blockquote>\n  📅 <b>Deadline:</b> All submissions must be submitted and active by <b>July 1st, 2026 (11:59 PM UTC)</b> to be eligible for the success matrix audit.\n</blockquote>","reactions":{"url":"https://api.github.com/repos/moorcheh-ai/memanto/issues/639/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/moorcheh-ai/memanto/issues/639/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/archestra-ai/archestra/issues/4145","repository_url":"https://api.github.com/repos/archestra-ai/archestra","labels_url":"https://api.github.com/repos/archestra-ai/archestra/issues/4145/labels{/name}","comments_url":"https://api.github.com/repos/archestra-ai/archestra/issues/4145/comments","events_url":"https://api.github.com/repos/archestra-ai/archestra/issues/4145/events","html_url":"https://github.com/archestra-ai/archestra/issues/4145","id":4336433249,"node_id":"I_kwDOPM4s5s8AAAABAni4YQ","number":4145,"title":"WhatsApp support for agents similar to MS Teams and Slack","user":{"login":"Matvey-Kuk","id":3284841,"node_id":"MDQ6VXNlcjMyODQ4NDE=","avatar_url":"https://avatars.githubusercontent.com/u/3284841?v=4","gravatar_id":"","url":"https://api.github.com/users/Matvey-Kuk","html_url":"https://github.com/Matvey-Kuk","followers_url":"https://api.github.com/users/Matvey-Kuk/followers","following_url":"https://api.github.com/users/Matvey-Kuk/following{/other_user}","gists_url":"https://api.github.com/users/Matvey-Kuk/gists{/gist_id}","starred_url":"https://api.github.com/users/Matvey-Kuk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Matvey-Kuk/subscriptions","organizations_url":"https://api.github.com/users/Matvey-Kuk/orgs","repos_url":"https://api.github.com/users/Matvey-Kuk/repos","events_url":"https://api.github.com/users/Matvey-Kuk/events{/privacy}","received_events_url":"https://api.github.com/users/Matvey-Kuk/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10698319301,"node_id":"LA_kwDOPM4s5s8AAAACfatlxQ","url":"https://api.github.com/repos/archestra-ai/archestra/labels/Reserved%20for%20SE%20interview","name":"Reserved for SE interview","color":"fbca04","default":false,"description":"Please don't take it if you're not interviewing https://archestra.ai/careers"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":24,"created_at":"2026-04-27T14:20:06Z","updated_at":"2026-07-03T15:36:40Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"I'm not sure how exactly to build this, but it should work similarly to Slack and MS Teams agent triggers.\n\n---\n<!-- archestra-banner:v1 -->\n<a href=\"https://archestra.ai/contributor-onboard\" rel=\"nofollow noreferrer noopener\" target=\"_blank\">\n\n<img alt=\"Archestra Contributor\" src=\"https://raw.githubusercontent.com/archestra-ai/archestra/main/docs/assets/archestra-contributor-banner.webp\"/>\n\n</a>","reactions":{"url":"https://api.github.com/repos/archestra-ai/archestra/issues/4145/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/archestra-ai/archestra/issues/4145/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/issues/972","repository_url":"https://api.github.com/repos/ubiquity/ubiquity-dollar","labels_url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/issues/972/labels{/name}","comments_url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/issues/972/comments","events_url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/issues/972/events","html_url":"https://github.com/ubiquity/ubiquity-dollar/issues/972","id":2563432779,"node_id":"I_kwDOF4fVBs6YyuFL","number":972,"title":"CI: fix `check_storage_layout` for new contracts","user":{"login":"rndquu","id":119500907,"node_id":"U_kgDOBx9waw","avatar_url":"https://avatars.githubusercontent.com/u/119500907?v=4","gravatar_id":"","url":"https://api.github.com/users/rndquu","html_url":"https://github.com/rndquu","followers_url":"https://api.github.com/users/rndquu/followers","following_url":"https://api.github.com/users/rndquu/following{/other_user}","gists_url":"https://api.github.com/users/rndquu/gists{/gist_id}","starred_url":"https://api.github.com/users/rndquu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rndquu/subscriptions","organizations_url":"https://api.github.com/users/rndquu/orgs","repos_url":"https://api.github.com/users/rndquu/repos","events_url":"https://api.github.com/users/rndquu/events{/privacy}","received_events_url":"https://api.github.com/users/rndquu/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":5898797883,"node_id":"LA_kwDOF4fVBs8AAAABX5iDOw","url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/labels/Time:%20%3C1%20Day","name":"Time: <1 Day","color":"ededed","default":false,"description":null},{"id":5898805638,"node_id":"LA_kwDOF4fVBs8AAAABX5ihhg","url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/labels/Priority:%201%20(Normal)","name":"Priority: 1 (Normal)","color":"ededed","default":false,"description":null},{"id":5898837553,"node_id":"LA_kwDOF4fVBs8AAAABX5keMQ","url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/labels/Price:%20300%20USD","name":"Price: 300 USD","color":"1f883d","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":47,"created_at":"2024-10-03T08:26:32Z","updated_at":"2026-07-03T15:23:23Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"There's the [core-contracts-storage-check](https://github.com/ubiquity/ubiquity-dollar/blob/20799bedf5ee4d40d2863653f7bc2fe68a2ce3fa/.github/workflows/core-contracts-storage-check.yml) workflow which checks that contracts' storage is not messed on contract upgrades.\r\n\r\nCheck these CI runs which fails with the `No workflow run found with an artifact named...` error:\r\n- https://github.com/ubiquity/ubiquity-dollar/actions/runs/11125075713/job/30912062971?pr=959\r\n- https://github.com/ubiquity/ubiquity-dollar/actions/runs/11145695030/job/30975996318?pr=971\r\n\r\nThe issue is that when a **new contract** is added the [core-contracts-storage-check](https://github.com/ubiquity/ubiquity-dollar/blob/20799bedf5ee4d40d2863653f7bc2fe68a2ce3fa/.github/workflows/core-contracts-storage-check.yml) starts to fail while the expected behavior for the CI workflow to pass because we don't need to check storage layout for newly added contracts (because storage of the newly added contract hasn't been updated hence storage collision could not occur).\r\n\r\nSo as a part of this issue we should make sure that:\r\n1. [core-contracts-storage-check](https://github.com/ubiquity/ubiquity-dollar/blob/20799bedf5ee4d40d2863653f7bc2fe68a2ce3fa/.github/workflows/core-contracts-storage-check.yml) is not failing for newly added contracts\r\n2. [diamond-storage-check.yml](https://github.com/ubiquity/ubiquity-dollar/blob/20799bedf5ee4d40d2863653f7bc2fe68a2ce3fa/.github/workflows/diamond-storage-check.yml) is not failing for newly added libraries\r\n\r\nP.S. Pls provide a QA in the related PR with these scenarios:\r\n1) No storage updates, CI passing\r\n2) Storage update, no collision, CI passing\r\n3) Storage update, collision, CI failing\r\n4) New contract added, CI passing","reactions":{"url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/issues/972/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ubiquity/ubiquity-dollar/issues/972/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/attogram/dada-vibing/issues/291","repository_url":"https://api.github.com/repos/attogram/dada-vibing","labels_url":"https://api.github.com/repos/attogram/dada-vibing/issues/291/labels{/name}","comments_url":"https://api.github.com/repos/attogram/dada-vibing/issues/291/comments","events_url":"https://api.github.com/repos/attogram/dada-vibing/issues/291/events","html_url":"https://github.com/attogram/dada-vibing/issues/291","id":4803198770,"node_id":"I_kwDOTFXLb88AAAABHkr_Mg","number":291,"title":"# THE MANIFESTO 1. ALWAYS ASSUME FAILURE.  NEVER ASSUME SUCCESS. 2. EVERYTHING IS BROKEN.  EVERYTHING IS CHAOS.","user":{"login":"attogram","id":8653063,"node_id":"MDQ6VXNlcjg2NTMwNjM=","avatar_url":"https://avatars.githubusercontent.com/u/8653063?v=4","gravatar_id":"","url":"https://api.github.com/users/attogram","html_url":"https://github.com/attogram","followers_url":"https://api.github.com/users/attogram/followers","following_url":"https://api.github.com/users/attogram/following{/other_user}","gists_url":"https://api.github.com/users/attogram/gists{/gist_id}","starred_url":"https://api.github.com/users/attogram/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/attogram/subscriptions","organizations_url":"https://api.github.com/users/attogram/orgs","repos_url":"https://api.github.com/users/attogram/repos","events_url":"https://api.github.com/users/attogram/events{/privacy}","received_events_url":"https://api.github.com/users/attogram/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":55,"created_at":"2026-07-03T11:50:55Z","updated_at":"2026-07-03T13:04:27Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# THE MANIFESTO\n1. ALWAYS ASSUME FAILURE.  NEVER ASSUME SUCCESS.\n2. EVERYTHING IS BROKEN.  EVERYTHING IS CHAOS.\n3. THE USER IS CLUELESS.  THE AI IS CLUELESS.\n4. WORK TOGETHER.  AS SENIOR DEVELOPERS.\n5. USE CORRECT COMMUNICATION SYTLE.  DO NOT SPAM THE USER.\n6. OBEY THE WORKFLOW.\n7. UNDERSTAND TIME IN THE REAL WORLD.\n","reactions":{"url":"https://api.github.com/repos/attogram/dada-vibing/issues/291/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/attogram/dada-vibing/issues/291/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Tribler/tribler/issues/8667","repository_url":"https://api.github.com/repos/Tribler/tribler","labels_url":"https://api.github.com/repos/Tribler/tribler/issues/8667/labels{/name}","comments_url":"https://api.github.com/repos/Tribler/tribler/issues/8667/comments","events_url":"https://api.github.com/repos/Tribler/tribler/issues/8667/events","html_url":"https://github.com/Tribler/tribler/issues/8667","id":3242266563,"node_id":"I_kwDOAIBYAc7BQQ_D","number":8667,"title":"msc placeholder: Towards Solving Sybil Attacks Using Social Capital Accounting","user":{"login":"synctext","id":325224,"node_id":"MDQ6VXNlcjMyNTIyNA==","avatar_url":"https://avatars.githubusercontent.com/u/325224?v=4","gravatar_id":"","url":"https://api.github.com/users/synctext","html_url":"https://github.com/synctext","followers_url":"https://api.github.com/users/synctext/followers","following_url":"https://api.github.com/users/synctext/following{/other_user}","gists_url":"https://api.github.com/users/synctext/gists{/gist_id}","starred_url":"https://api.github.com/users/synctext/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/synctext/subscriptions","organizations_url":"https://api.github.com/users/synctext/orgs","repos_url":"https://api.github.com/users/synctext/repos","events_url":"https://api.github.com/users/synctext/events{/privacy}","received_events_url":"https://api.github.com/users/synctext/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":291602554,"node_id":"MDU6TGFiZWwyOTE2MDI1NTQ=","url":"https://api.github.com/repos/Tribler/tribler/labels/MSc%20Thesis%20Work","name":"MSc Thesis Work","color":"ed2cd6","default":false,"description":""}],"state":"open","locked":false,"assignees":[{"login":"aaaaayushh","id":55553065,"node_id":"MDQ6VXNlcjU1NTUzMDY1","avatar_url":"https://avatars.githubusercontent.com/u/55553065?v=4","gravatar_id":"","url":"https://api.github.com/users/aaaaayushh","html_url":"https://github.com/aaaaayushh","followers_url":"https://api.github.com/users/aaaaayushh/followers","following_url":"https://api.github.com/users/aaaaayushh/following{/other_user}","gists_url":"https://api.github.com/users/aaaaayushh/gists{/gist_id}","starred_url":"https://api.github.com/users/aaaaayushh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaaaayushh/subscriptions","organizations_url":"https://api.github.com/users/aaaaayushh/orgs","repos_url":"https://api.github.com/users/aaaaayushh/repos","events_url":"https://api.github.com/users/aaaaayushh/events{/privacy}","received_events_url":"https://api.github.com/users/aaaaayushh/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":40,"created_at":"2025-07-18T07:47:17Z","updated_at":"2026-07-03T10:00:44Z","closed_at":null,"assignee":{"login":"aaaaayushh","id":55553065,"node_id":"MDQ6VXNlcjU1NTUzMDY1","avatar_url":"https://avatars.githubusercontent.com/u/55553065?v=4","gravatar_id":"","url":"https://api.github.com/users/aaaaayushh","html_url":"https://github.com/aaaaayushh","followers_url":"https://api.github.com/users/aaaaayushh/followers","following_url":"https://api.github.com/users/aaaaayushh/following{/other_user}","gists_url":"https://api.github.com/users/aaaaayushh/gists{/gist_id}","starred_url":"https://api.github.com/users/aaaaayushh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaaaayushh/subscriptions","organizations_url":"https://api.github.com/users/aaaaayushh/orgs","repos_url":"https://api.github.com/users/aaaaayushh/repos","events_url":"https://api.github.com/users/aaaaayushh/events{/privacy}","received_events_url":"https://api.github.com/users/aaaaayushh/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"would like to work at intersection of distributed systems work and security. Avoid theoretical machine learning ✔️\nHas industry experience, startups! Mac developer. Could already explore thesis material in Q1, starting Sep 2025. Only 2 courses. In January 2026 we have the first draft master thesis chapter written: Problem Description.\n\nGeneral idea is stand-alone Python application, [re-using some of the code and/or design successes of the 20-year old Tribler codebase](https://github.com/Tribler/tribler).\nLooked at Groth Sahai proofs prior thesis work, offline digital Euro thesis. interesting!\n\nDesign of user experience for roadmap, voting, bounty payments, and self-evolution in general. Discussed the idea of having a \"New Features\" menu, as standard as \"settings\" menu option. Has bit of front-end experience. Could do first draft of screen design. Then professional designer could take over. As a working idea. Duplicate the Youtube-ish interface with non-patented and non closed source alternative. [PeerTube](https://joinpeertube.org/news/release-7.0) is key project to take inspiration from. They are federated, not fully self-organising Peer-to-Peer distributed. PeerTube will never outgrown Youtube or reach a billion users. Also, Streaming GUI needs to be as simple as TikTok! \n\n- ToDo1: make some draft screens\n   - Stand-alone Python app, it's a single DAO.\n   - Strip everything and [try to re-use this Tribler](https://github.com/Tribler/tribler/blob/main/src/tribler/ui/src/main.tsx)\n   - Spend a few days to see if [58 example React streamers](https://github.com/topics/netflix-clone-react) are usable plus if [existing GUI framework with fancy Nesxt.js 13 are easy re-use](https://github.com/Apestein/nextflix)\n   - With other students make the business model with zero-intermediaries, directly pay creatives from DAO, self-governance, etc works in _minimal viable_ running code. Leave stuff out-of-scope\n   - Screen ideas:\n     - propose new feature\n     - donate to feature being build (upvote with Karma or Bitcoin)\n     - List of open bounty for developers\n     - submit Python code for bounty\n     - quality assurance: check that code somehow with crowdsourcing ([meritRank Reputations](https://arxiv.org/pdf/2207.09950))\n     - security issue with unconstrained access by unknown code 😱 😮 😱\n     - payout of bounty\n     - rolling update of Python patch to whole community or revert (student idea: use Bitcoin collateral for incentive alignment?)\n     - ⚠️ AI agents can also submit code, earn bounty, and get rich ([Darwin Gödel Machine (DGM)](https://github.com/Tribler/tribler/issues/4057#issuecomment-2938618022)\n     - Example of emergent system which normal people expect to end in chaos (think Wikipedia doubters, Linux Kernel sceptics)\n   - See [Artist Investment Token we got operational](https://github.com/Tribler/tribler/issues/6714) for music industry (e.g. open source Spotify)\n   - [OnlyFrans statistics for viability of DAO](https://social-rise.com/blog/onlyfans-statistics)\n   - Knows the Mac and Safari world.\n   - No details yet on what the app does or use-case\n   - Other student is tasked with making list of use-cases @DogariuMatei \n   - Great _operational_ self-evolving code system for Android.\n     - [see huge PR on the Superapp](https://github.com/Tribler/trustchain-superapp/pull/231/commits/af1d75e4bc38e69771fdc1a86fa49c4c1fad9929)\n     - <IMG src=\"https://github.com/Tribler/trustchain-superapp/blob/af1d75e4bc38e69771fdc1a86fa49c4c1fad9929/p2playstore/src/main/assets/gif3.gif?raw=true\" width=250 />\n- ToDo2: comes up with 2-3 thesis direction texts\n- Todo3: commit to 1 direction, do work, write thesis. DONE.\n- ToDo4: With Honors, science-first thesis. More towards \"decentralising learning for bot detection\", \"decentral graph learning for something something problem\", \"zero trust architecture for undirected code evolution\", or \"agent technology for code bounties\". Explore Gitcoin collaboration❓ \n- ToDo5: enjoys math 🔢 🫶, bit rusty, could be foundation of thesis (Mathematics of Trust Part III. [Prior 2021 Part II (Delft,German math)](https://www.ifaamas.org/Proceedings/aamas2021/pdfs/p1263.pdf), and 2014 [part I (Harvard Math)](https://www.ifaamas.org/AAMAS/aamas2014/proceedings/aamas/p205.pdf)).\n  - old-skool Sybils\n  - Novel twist is democratic consensus on undirect evolution and [fitness function](https://uxpajournal.org/wp-content/uploads/sites/7/pdf/JUS_Rummel_Nov2017.pdf) (see mathematics of democracy](https://coursebrowser.dce.harvard.edu/course/the-mathematics-of-democracy/)). \n  - _Adversarial evolution of autonomous systems_","reactions":{"url":"https://api.github.com/repos/Tribler/tribler/issues/8667/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Tribler/tribler/issues/8667/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/93322","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/93322/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/93322/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/93322/events","html_url":"https://github.com/Expensify/App/issues/93322","id":4643274017,"node_id":"I_kwDOEQqHYc8AAAABFMK9IQ","number":93322,"title":"[$250] Web - Email tooltip is not displayed when hovering over member of a group","user":{"login":"applause-bot[bot]","id":265651874,"node_id":"BOT_kgDOD9WGog","avatar_url":"https://avatars.githubusercont