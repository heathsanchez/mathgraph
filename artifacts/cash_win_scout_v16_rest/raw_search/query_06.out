paulbrigner/followers","following_url":"https://api.github.com/users/paulbrigner/following{/other_user}","gists_url":"https://api.github.com/users/paulbrigner/gists{/gist_id}","starred_url":"https://api.github.com/users/paulbrigner/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/paulbrigner/subscriptions","organizations_url":"https://api.github.com/users/paulbrigner/orgs","repos_url":"https://api.github.com/users/paulbrigner/repos","events_url":"https://api.github.com/users/paulbrigner/events{/privacy}","received_events_url":"https://api.github.com/users/paulbrigner/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"ruzcash","id":45110597,"node_id":"MDQ6VXNlcjQ1MTEwNTk3","avatar_url":"https://avatars.githubusercontent.com/u/45110597?v=4","gravatar_id":"","url":"https://api.github.com/users/ruzcash","html_url":"https://github.com/ruzcash","followers_url":"https://api.github.com/users/ruzcash/followers","following_url":"https://api.github.com/users/ruzcash/following{/other_user}","gists_url":"https://api.github.com/users/ruzcash/gists{/gist_id}","starred_url":"https://api.github.com/users/ruzcash/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ruzcash/subscriptions","organizations_url":"https://api.github.com/users/ruzcash/orgs","repos_url":"https://api.github.com/users/ruzcash/repos","events_url":"https://api.github.com/users/ruzcash/events{/privacy}","received_events_url":"https://api.github.com/users/ruzcash/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"zerodartz","id":122978845,"node_id":"U_kgDOB1SCHQ","avatar_url":"https://avatars.githubusercontent.com/u/122978845?v=4","gravatar_id":"","url":"https://api.github.com/users/zerodartz","html_url":"https://github.com/zerodartz","followers_url":"https://api.github.com/users/zerodartz/followers","following_url":"https://api.github.com/users/zerodartz/following{/other_user}","gists_url":"https://api.github.com/users/zerodartz/gists{/gist_id}","starred_url":"https://api.github.com/users/zerodartz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zerodartz/subscriptions","organizations_url":"https://api.github.com/users/zerodartz/orgs","repos_url":"https://api.github.com/users/zerodartz/repos","events_url":"https://api.github.com/users/zerodartz/events{/privacy}","received_events_url":"https://api.github.com/users/zerodartz/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"alexgbo","id":179588022,"node_id":"U_kgDOCrRLtg","avatar_url":"https://avatars.githubusercontent.com/u/179588022?v=4","gravatar_id":"","url":"https://api.github.com/users/alexgbo","html_url":"https://github.com/alexgbo","followers_url":"https://api.github.com/users/alexgbo/followers","following_url":"https://api.github.com/users/alexgbo/following{/other_user}","gists_url":"https://api.github.com/users/alexgbo/gists{/gist_id}","starred_url":"https://api.github.com/users/alexgbo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alexgbo/subscriptions","organizations_url":"https://api.github.com/users/alexgbo/orgs","repos_url":"https://api.github.com/users/alexgbo/repos","events_url":"https://api.github.com/users/alexgbo/events{/privacy}","received_events_url":"https://api.github.com/users/alexgbo/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"Duhneekuh","id":179878595,"node_id":"U_kgDOCri6ww","avatar_url":"https://avatars.githubusercontent.com/u/179878595?v=4","gravatar_id":"","url":"https://api.github.com/users/Duhneekuh","html_url":"https://github.com/Duhneekuh","followers_url":"https://api.github.com/users/Duhneekuh/followers","following_url":"https://api.github.com/users/Duhneekuh/following{/other_user}","gists_url":"https://api.github.com/users/Duhneekuh/gists{/gist_id}","starred_url":"https://api.github.com/users/Duhneekuh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Duhneekuh/subscriptions","organizations_url":"https://api.github.com/users/Duhneekuh/orgs","repos_url":"https://api.github.com/users/Duhneekuh/repos","events_url":"https://api.github.com/users/Duhneekuh/events{/privacy}","received_events_url":"https://api.github.com/users/Duhneekuh/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":8,"created_at":"2025-12-03T22:10:38Z","updated_at":"2026-07-01T16:24:30Z","closed_at":null,"assignee":{"login":"alexgbo","id":179588022,"node_id":"U_kgDOCrRLtg","avatar_url":"https://avatars.githubusercontent.com/u/179588022?v=4","gravatar_id":"","url":"https://api.github.com/users/alexgbo","html_url":"https://github.com/alexgbo","followers_url":"https://api.github.com/users/alexgbo/followers","following_url":"https://api.github.com/users/alexgbo/following{/other_user}","gists_url":"https://api.github.com/users/alexgbo/gists{/gist_id}","starred_url":"https://api.github.com/users/alexgbo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alexgbo/subscriptions","organizations_url":"https://api.github.com/users/alexgbo/orgs","repos_url":"https://api.github.com/users/alexgbo/repos","events_url":"https://api.github.com/users/alexgbo/events{/privacy}","received_events_url":"https://api.github.com/users/alexgbo/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Terms and Conditions\n\n- [x] I agree to the [Grant Agreement](https://9ba4718c-5c73-47c3-a024-4fc4e5278803.usrfiles.com/ugd/9ba471_f81ef4e4b5f040038350270590eb2e42.pdf) terms if funded\n- [x] I agree to [Provide KYC information](https://9ba4718c-5c73-47c3-a024-4fc4e5278803.usrfiles.com/ugd/9ba471_7d9e73d16b584a61bae92282b208efc4.pdf) if funded above $50,000 USD\n- [x] I agree to disclose conflicts of interest\n- [x] I agree to adhere to the [Code of Conduct](https://forum.zcashcommunity.com/t/zcg-code-of-conduct/41787) and [Communication Guidelines](https://forum.zcashcommunity.com/t/zcg-communication-guidelines/44284)\n- [x] I understand all milestone deliverables will be validated and accepted by their intended users or their representatives, who will confirm that the deliverables meet the required quality, functionality, and usability for each user story.\n- [x] I agree that for any new open-source software, I will create a `CONTRIBUTING.md` file that reflects the high standards of Zcash development, using the [`librustzcash` style guides](https://github.com/zcash/librustzcash/blob/main/CONTRIBUTING.md#styleguides) as a primary reference.\n- [x] I understand when contributing to existing Zcash code, I am required to adhere to the project specific contribution guidelines, paying close attention to any [merge](https://github.com/zcash/librustzcash/blob/main/CONTRIBUTING.md#merge-workflow), [branch](https://github.com/zcash/librustzcash/blob/main/CONTRIBUTING.md#branch-history), [pull request](https://github.com/zcash/librustzcash/blob/main/CONTRIBUTING.md#pull-request-review), and [commit](https://github.com/zcash/librustzcash/blob/main/CONTRIBUTING.md#commit-messages) guidelines as exemplified in the `librustzcash` repository.\n- [x] I agree to post request details on the [Community Forum](https://forum.zcashcommunity.com/c/grants/33)\n- [x] I understand it is my responsibility to post a link to this issue on the [Zcash Community Forums](https://forum.zcashcommunity.com/c/grants/33) after this application has been submitted so the community can give input. I understand this is required in order for ZCG to discuss and vote on this grant application.\n\n### Application Owners (@Octocat, @Octocat1)\n\nlisa001 (chidi)\n\n### Organization Name\n\n@zcashNigeria\n\n### How did you learn about Zcash Community Grants\n\ncommunity\n\n### Requested Grant Amount (USD)\n\n68,600 \n\n### Category\n\nCommunity\n\n### Project Lead\n\n```project-lead.yaml\nName: Lisa001 (Chidi Olisa)\nRole: Lead, Zcash Nigeria   2026 Program\nAs Lead of Zcash Nigeria, the role for the 2026 program focuses on providing overall direction, coordination, and execution of all activities designed to expand Zcash’s presence, strengthen community engagement, and drive real-world adoption across the country. Responsibilities include public relations, partnership development, community growth, education, and ecosystem stewardship.\nProgram Leadership & Coordination\nResponsible for supervising, organizing, and coordinating all Zcash Nigeria activities throughout the year. This covers events, contributor programs, translations, university initiatives, content pipelines, regional campaigns, and collaboration with team members to ensure quality, consistency, and measurable impact.\nPublic Relations & Communications\nActs as the primary public-facing representative of Zcash Nigeria, shaping communications around financial privacy, engaging with media and influencers, and maintaining a strong, consistent presence across social and professional platforms. Ensures that Zcash’s message remains clear, accessible, and relevant within the Nigerian and African context.\nPartnership Development\nLeads engagement with universities, tech hubs, blockchain communities, businesses, and organizations to expand the reach of Zcash. Builds relationships that unlock collaboration, adoption opportunities, and educational initiatives aligned with privacy-focused technology.\nCommunity Growth, Education & Outreach\nDrives expansion of the Zcash Nigeria community across platforms such as X, Telegram, TikTok, YouTube, and Substack. Oversees the creation of localized educational content and coordinates meetups, workshops, watch parties, and grassroots activities across various regions, ensuring that Zcash remains accessible to both newcomers and experienced users.\nReal-World Adoption Efforts\n Leads initiatives that onboard merchants and service providers in Nigeria to accept ZEC for payments. Demonstrates how private digital currency supports everyday commerce, empowers local businesses, and offers practical financial alternatives.\nGovernance & Ecosystem Contribution\nRepresents the Nigerian community within the broader Zcash ecosystem through participation in governance conversations, strategic discussions, and cross-team collaboration. As a Zechub DAO board member and official Zcash Arborist Call note-taker, ensures that African perspectives inform ecosystem growth and development.\nThis role is central to advancing Zcash’s footprint in Nigeria throughout 2026, strengthening infrastructure, expanding community capacity, and promoting financial privacy as an accessible, empowering tool for people across the country.\n```\n\n### Additional Team Members\n\n```team-members.yaml\n@Cjfrankie – Content Lead, Video Creator & Community Educator\n@Cjfrankie is an exceptional member of the Zcash Nigeria team and a seasoned Web3 writer with more than nine years of experience in creative and technical content development. He excels at breaking down complex concepts into clear, engaging, and relatable narratives that resonate with audiences across different backgrounds.\nAs a long-standing contributor to ZecHub, he has authored high-quality wikis, guides, and educational materials that continue to strengthen the community’s knowledge base. His work reflects a deep understanding of Zcash’s mission, values, and the importance of financial privacy.\nhis responsibilities include article content writing, video content creation, TikTok educational clips, and oversight of the Zcash Nigeria content pipeline. He also manages Zealy quest tasks, supports community engagement, and contributes to the growth of Zcash Nigeria across all media platforms. His storytelling, video production skills, and community-first approach make him instrumental in driving Zcash education and awareness nationwide.\n\n@Hardaeborla – Creative Designer, Translator & Community Engagement Lead\n@Hardaeborla is a dedicated member of the Zcash Nigeria team and a passionate Web3 creator known for impactful visuals, detailed infographics, and compelling educational threads. His content consistently highlights Zcash’s partnerships, ecosystem updates, and core values, making privacy concepts accessible to a wider audience.\nHe is recognized for creativity, consistency, and strong attention to detail qualities that have made him a key contributor to Zcash Nigeria’s education and outreach efforts. Within the ZecHub ecosystem, he continues to support learning, collaboration, and community growth.\nhis role includes designing infographics and visual explainers, producing social media content, handling translations for local audiences, hosting Telegram quizzes and fun community activities, and overseeing Daework bounty tasks. He also supports outreach across X, and other platforms. His work continues to strengthen Zcash’s presence and expand its reach across Africa’s Web3 landscape.\n\n@Emmalexo – Community Manager, Adoption Lead & Outreach Coordinator\n@Emmalexo is a valued member of the Zcash Nigeria team and a Mechanical Engineering graduate with a strong passion for innovation, grassroots development, and real-world engagement. Despite his engineering background, he has emerged as a dynamic community builder who helps connect Zcash with everyday users and local businesses.\nHe plays an active role in expanding Zcash adoption across Nigeria by onboarding merchants to accept ZEC and demonstrating the practical benefits of privacy-preserving digital payments. His outreach efforts help educate communities about financial privacy, inclusion, and how Zcash can support underserved groups.\nhis responsibilities include  overseeing community growth efforts, and coordinating local outreach activities. He also leads merchant engagement and supports the execution of physical events and grassroots initiatives. His people-focused approach, strategic thinking, and dedication make him essential to strengthening Zcash’s footprint across Nigeria.\n```\n\n### Project Summary\n\nTo strengthen a well-informed Zcash community in Nigeria by delivering accurate, accessible, and engaging educational resources, while fostering an inclusive and connected network that supports growth, collaboration, and the adoption of privacy-focused financial solutions.\n\n\n### Project Description\n\nThis project continues the mission to expand the reach of Zcash in Nigeria, raise awareness about the importance of financial privacy, and strengthen the foundation of a vibrant, informed local community. Building on the solid progress achieved in recent months and the significant growth of the Zcash Nigeria community across Twitter (X), Telegram, TikTok, YouTube, and Substack, we are now focused on deepening engagement, expanding outreach, and driving broader adoption of Zcash across the country.\nWith Nigeria’s rapidly growing interest in cryptocurrency and Zcash’s strong privacy features, this next phase emphasizes education, localized content creation, and grassroots activities designed to inform, empower, and inspire both individuals and businesses.\nOur Goals\nExpand Awareness: Increase public understanding of financial privacy and showcase the unique benefits of Zcash technology to a wider Nigerian audience.\nProduce Localized Content: Create high-quality, culturally relevant educational materials infographics, videos, articles, and explainer threads tailored specifically for Nigerian users.\nGrow the Community: Build on the momentum of our significantly expanded user base by maintaining consistent, meaningful engagement across Telegram, Twitter (X), TikTok, and other social platforms.\nPromote Long-Term Adoption: Establish sustainable systems that keep the community informed, active, and connected to the global Zcash ecosystem through structured learning streams and continuous updates.\nHost Local Events: Organize meetups, AMA sessions, university engagements, and collaborations with local blockchain communities to share practical knowledge and promote Zcash awareness.\nEncourage Business Adoption: Onboard local merchants to accept ZEC for payments, demonstrating Zcash’s practical benefits and real-world value as a privacy-preserving digital currency.\n\n\n### Proposed Problem\n\nNigeria is one of the fastest-growing cryptocurrency markets in the world, yet awareness and understanding of financial privacy remain low. While many Nigerians actively use digital assets, only a small percentage understand the purpose or value of privacy-focused technologies like Zcash. Misconceptions and limited access to reliable information often create hesitation, skepticism, or a complete lack of engagement.\nThe absence of localized educational resources and dedicated community support further widens this gap. Without clear guidance or a trusted source of Zcash-specific knowledge, many individuals and businesses are unable to benefit from the security, privacy, and empowerment that Zcash provides.\n\nKey Challenges Include:\nLimited Access to Accurate Information\nMost crypto education efforts in Nigeria focus on trading or mainstream tokens, leaving privacy technologies largely unexplored and misunderstood.\nPersistent Misconceptions\nPrivacy coins are frequently misrepresented or associated with illegal activities, creating fear and reducing trust among potential users and merchants.\nLow Merchant Adoption\nFew Nigerian businesses currently accept ZEC, limiting opportunities for real-world usage and preventing people from seeing Zcash’s practical value in everyday transactions.\nWeak Collaboration Across Communities\nThere is minimal engagement between Zcash advocates and other Web3, fintech, or privacy-oriented groups, resulting in missed opportunities for partnerships, knowledge-sharing, and ecosystem growth.\n\n\n### Proposed Solution\n\nTo address the challenges facing Zcash awareness and adoption in Nigeria, this project will implement a practical, multi-layered strategy centered on education, community engagement, real-world adoption, and long-term sustainability. The goal is to empower Nigerians with the knowledge, tools, and support needed to confidently use Zcash as a privacy-preserving financial solution.\nEducation and Awareness\n\nLocalized Content Creation\nProduction of articles, infographics, explainer threads, and short videos tailored to Nigerian audiences, highlighting Zcash’s privacy features, use cases, and advantages.\nSocial Media Campaigns\nConsistent distribution of engaging and informative content across Twitter (X), Telegram, TikTok, Substack, and other platforms to broaden understanding and spark meaningful conversations around financial privacy.\nIn-Person Events\nOrganization of regular meetups across major cities and universities. These sessions will introduce new users to Zcash, strengthen community relationships, and offer hands-on demonstrations for sending, receiving, and storing ZEC.\nAMA Sessions and Twitter Spaces\nHosting live Q&A events featuring contributors and experts from the Zcash ecosystem to increase transparency, answer community questions, and build trust.\nCross-Community Collaboration\nPartnerships with other blockchain, fintech, and privacy-focused communities to promote joint learning, shared initiatives, and wider exposure to privacy technologies.\nMerchant Adoption\nBusiness Outreach\nDirect engagement with local merchants to demonstrate how accepting ZEC reduces transaction friction, provides fast payments, and offers a secure alternative to traditional financial systems.\nIncentive Programs\nIntroduction of  small rewards , visibility support, and promotional benefits to encourage more businesses to accept Zcash as a payment method.\nPractical Integration Support\nProvision of one-on-one training, onboarding guides, and hands-on assistance to help merchants successfully integrate ZEC into their operations.\nLocalized Resources\nTranslation Efforts\nTranslation of essential Zcash documents, guides, and educational materials into Yoruba, Igbo, and Hausa to make information accessible to non-English-speaking communities.\nSustainable Community Growth\nActive Online Platforms \nMaintenance and expansion of community channels across Telegram, Twitter (X), TikTok, Instagram, YouTube, and Substack to keep members informed, connected, and engaged.\nParticipation Rewards\nUse of Zealy quests, community challenges, and the Zcash Nigeria Contributor Program to encourage participation, reward content creators, and motivate volunteers who help onboard new users or support community activities.\n\n\n### Solution Format\n\nThis initiative is supported by three core pillars: education, community building, and real-world adoption. By expanding financial privacy awareness and showcasing the practical benefits of Zcash, the project aims to empower Nigerians with the knowledge and resources necessary to navigate and own their digital financial lives.\nNigeria is one of the most active crypto ecosystems in Africa, and this makes it the ideal environment to position Zcash as a trusted, practical, and widely-used privacy solution for individuals, businesses, and communities across the country.\n\n\n### Dependencies\n\nthere are no dependencies \n\n### Technical Approach\n\nTo strengthen the Zcash community in Nigeria and promote financial privacy, this project will implement a coordinated set of community-driven initiatives focused on education, accessibility, and real-world adoption.\nThe strategy begins with active participation in local events and collaborations with relevant organizations across the country. These engagements will introduce Zcash to new audiences, including students, developers, merchants, and everyday users. In-person activities will be supported by structured learning programs designed to simplify Zcash’s technology and explain the importance of financial privacy in practical, relatable terms.\nA key part of our outreach includes expanding our digital presence. We will activate and grow the Zcash Nigeria Instagram account and continue scaling our TikTok channel to reach younger and wider audiences through creative, informative, and localized content.\nTo promote inclusivity and accessibility, essential Zcash documentation and educational materials will be translated into widely spoken Nigerian languages such as Yoruba and Igbo. These efforts will make financial privacy concepts easier to understand for non-English speakers. Alongside this, we will maintain and moderate our online community spaces on Telegram and Twitter (X), ensuring ongoing communication, support, and engagement.\nSupporting new users is central to our approach. We will host regular onboarding sessions, provide personalized assistance, and help individuals set up wallets, perform transactions, and understand Zcash’s key features. To encourage real-world adoption, we will expand merchant outreach efforts by educating business owners on the benefits of accepting ZEC and offering step-by-step guidance for seamless integration.\nContent creation will serve as the educational backbone of the initiative. We will publish consistent blog posts, infographics, video explainers, and community updates to keep audiences informed and motivated. In-person workshops and meetups will offer hands-on learning opportunities, while live AMA sessions on social media will create open channels for people to ask questions and engage directly with Zcash advocates.\nTo broaden our impact, outreach will extend to new states, universities, and online communities, ensuring more Nigerians are introduced to Zcash and the financial freedom it provides. Through this comprehensive, inclusive, and people-centered approach, we aim to cultivate a strong, informed, and active Zcash community across Nigeria.\n\n\n### Upstream Merge Opportunities\n\nN/A\n\n### Hardware/Software Costs (USD)\n\nNa\n\n### Hardware/Software Justification\n\nN/A\n\n### Service Costs (USD)\n\nN/A\n\n### Service Costs Justification\n\nN/A\n\n### Compensation Costs (USD)\n\n57,600\n\n### Compensation Costs Justification\n\n[@lisa001](https://github.com/lisa001) :$1200 (monthly fee)\n[@Cjfrankie](https://github.com/Cjfrankie): $1200 (monthly fee)\n[@Hardaeborla](https://github.com/Hardaeborla):$1200 (monthly fee)\n@emmalexo: $1200  (monthly fee )\n\n\nThe estimated budget for Zcash Nigeria will be used to cover the working expenses of the team members for 1 year (Jan - Dec 2026)\n\n\nOther expenses included in the budget;\n\n\nMonthly meetups support: $6000  (12 events), 500 usd support for each event broken down below\nRenting of venue - up to $200\nrenting of equipment - up to $50\nproduction of T-shirts/swags - up to $100\nRefreshments and miscellaneous - upto $150\n\nSupport for large  conferences - 5000 usd\n\nThis funds will only be accessed for attending larger web 3 conferences that enhances experience, networking, collaborations  and adoption of zcash and  will cover conference sponsorships, reservations , accommodation, flights etc\n\n### Total Budget (USD)\n\n68,600\n\n### Previous Funding\n\nYes\n\n### Previous Funding Details\n\nhttps://forum.zcashcommunity.com/t/zcash-nigeria-2025-approved/50106\nhttps://forum.zcashcommunity.com/t/zcash-nigeria-2025-v-2-0-may-july/51138\nhttps://forum.zcashcommunity.com/t/zcash-nigeria-2025-august-october/51833\nhttps://forum.zcashcommunity.com/t/zcash-nigeria-2025-november-december/52836\n\n\n### Other Funding Sources\n\nNo\n\n### Other Funding Sources Details\n\nN/A\n\n### Implementation Risks\n\nNone\n\n### Potential Side Effects\n\nNone\n\n### Success Metrics\n\nThere will be fully transparent reporting to the community on success metrics. Relevant metric statistics will be shared regularly.\nZcash Nigeria Twiter Account growth\nZcash Nigeria monthly meetups\nZcash nigeria Regular articles\nZcash Nigeria Designs memes and infographics and threads\nZcash Nigeria translations.\nRegular X spaces \nZcash Nigeria tik tok account growth\nZcash Nigeria youtube channel growth\nZcash Nigeria substack Growth\nZcah Nigeria Telegram growth\nzcash Nigeria website \nBusinesses Onboarded \n\n\n### Startup Funding (USD)\n\n5,200 usd\n\n### Startup Funding Justification\n\nStartup Funding (USD): $5,000 USD for conferences, $200 for Jan & Feb monthly meetups (March–Dec monthly meetups are included in the milestone payments)\n\n### Milestone Details\n\n```milestones.yaml\nMilestone: 1\n\n5,200 usd\nExpected Completion Date: 31-01-2026\nDeliverables: Management report and metrics \n\nMilestone: 2 \n5,200 USD \nExpected completion Date: 28-02-2026\nDeliverables : Management report and metrics\n\nMilestone: 3 \n5,300 USD \nExpected completion Date: 31-03-2026\nDeliverables : Management report and metrics\n\nMilestone: 4 \n5,300 USD \nExpected completion Date: 30-04-2026\nDeliverables : Management report and metrics\n\nMilestone: 5\n5,300 USD \nExpected completion Date: 31-05-2026\nDeliverables : Management report and metrics\nMilestone: 6 \n5,300 USD \nExpected completion Date: 30-06-2026\nDeliverables : Management report and metrics\n\nMilestone: 7\n5,300 USD \nExpected completion Date: 31-07-2026\nDeliverables : Management report and metrics\n\nMilestone: 8\n5,300 USD \nExpected completion Date: 31-08-2026\nDeliverables : Management report and metrics\n\n\nMilestone: 9\n5,300 USD \nExpected completion Date: 30-09-2026\nDeliverables : Management report and metrics\n\nMilestone: 10 \n5,300 USD \nExpected completion Date: 31-10-2026\nDeliverables : Management report and metrics\n\nMilestone: 11 \n5,300 USD \nExpected completion Date: 30-11-2026\nDeliverables : Management report and metrics\n\nMilestone: 12 \n5,300 USD \nExpected completion Date: 31-12-2026\nDeliverables : Management report and metrics\n```\n\n### Supporting Documents\n\n```files.yaml\n\n```","reactions":{"url":"https://api.github.com/repos/ZcashCommunityGrants/zcashcommunitygrants/issues/150/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ZcashCommunityGrants/zcashcommunitygrants/issues/150/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/SynoCommunity/spksrc/issues/1160","repository_url":"https://api.github.com/repos/SynoCommunity/spksrc","labels_url":"https://api.github.com/repos/SynoCommunity/spksrc/issues/1160/labels{/name}","comments_url":"https://api.github.com/repos/SynoCommunity/spksrc/issues/1160/comments","events_url":"https://api.github.com/repos/SynoCommunity/spksrc/issues/1160/events","html_url":"https://github.com/SynoCommunity/spksrc/issues/1160","id":38876229,"node_id":"MDU6SXNzdWUzODg3NjIyOQ==","number":1160,"title":"[Package Request] Improved Forked-DAAPd","user":{"login":"Wawsax","id":7753160,"node_id":"MDQ6VXNlcjc3NTMxNjA=","avatar_url":"https://avatars.githubusercontent.com/u/7753160?v=4","gravatar_id":"","url":"https://api.github.com/users/Wawsax","html_url":"https://github.com/Wawsax","followers_url":"https://api.github.com/users/Wawsax/followers","following_url":"https://api.github.com/users/Wawsax/following{/other_user}","gists_url":"https://api.github.com/users/Wawsax/gists{/gist_id}","starred_url":"https://api.github.com/users/Wawsax/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Wawsax/subscriptions","organizations_url":"https://api.github.com/users/Wawsax/orgs","repos_url":"https://api.github.com/users/Wawsax/repos","events_url":"https://api.github.com/users/Wawsax/events{/privacy}","received_events_url":"https://api.github.com/users/Wawsax/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":171765,"node_id":"MDU6TGFiZWwxNzE3NjU=","url":"https://api.github.com/repos/SynoCommunity/spksrc/labels/request","name":"request","color":"c7def8","default":false,"description":"request for new package"},{"id":247315147,"node_id":"MDU6TGFiZWwyNDczMTUxNDc=","url":"https://api.github.com/repos/SynoCommunity/spksrc/labels/status/work-in-progress","name":"status/work-in-progress","color":"eb6420","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":21,"created_at":"2014-07-28T09:58:56Z","updated_at":"2026-07-01T14:49:31Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"[Improved Forked-DAAPd](http://github.com/ejurgensen/forked-daapd) is based on the mt-daapd / Firefly Media Server code only rewritten and updated to support the newest protocols and whims of Apple. The official forum thread for this [can be found on the Raspberri Pi boards here](http://www.raspberrypi.org/forums/viewtopic.php?p=387756&sid=83b19198afaf3af4295dfebec26d7720).\n\nThe official Synology iTunes Server package isn't very good, doesn't support artwork etc. Improved Forked-DAAPd works with the iOS Remote apps, supports artwork, is much more reliable and is still actively being developed and supported by the author.\n\nEdit: Updated URLs, cleaned up, removed waffle.\n## <bountysource-plugin>\n\nWant to back this issue? **[Post a bounty on it!](https://www.bountysource.com/issues/3359467-request-improved-forked-daapd?utm_campaign=plugin&utm_content=tracker%2F282943&utm_medium=issues&utm_source=github)** We accept bounties via [Bountysource](https://www.bountysource.com/?utm_campaign=plugin&utm_content=tracker%2F282943&utm_medium=issues&utm_source=github).\n</bountysource-plugin>\n","reactions":{"url":"https://api.github.com/repos/SynoCommunity/spksrc/issues/1160/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/SynoCommunity/spksrc/issues/1160/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/104","repository_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research","labels_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/104/labels{/name}","comments_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/104/comments","events_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/104/events","html_url":"https://github.com/zhangjiayang6835-cyber/ai-research/issues/104","id":4776382497,"node_id":"I_kwDOTGNm188AAAABHLHQIQ","number":104,"title":"[BUG] Full Takeover via Cache Poisoning $50","user":{"login":"zhangjiayang6835-cyber","id":288065324,"node_id":"U_kgDOESuHLA","avatar_url":"https://avatars.githubusercontent.com/u/288065324?v=4","gravatar_id":"","url":"https://api.github.com/users/zhangjiayang6835-cyber","html_url":"https://github.com/zhangjiayang6835-cyber","followers_url":"https://api.github.com/users/zhangjiayang6835-cyber/followers","following_url":"https://api.github.com/users/zhangjiayang6835-cyber/following{/other_user}","gists_url":"https://api.github.com/users/zhangjiayang6835-cyber/gists{/gist_id}","starred_url":"https://api.github.com/users/zhangjiayang6835-cyber/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zhangjiayang6835-cyber/subscriptions","organizations_url":"https://api.github.com/users/zhangjiayang6835-cyber/orgs","repos_url":"https://api.github.com/users/zhangjiayang6835-cyber/repos","events_url":"https://api.github.com/users/zhangjiayang6835-cyber/events{/privacy}","received_events_url":"https://api.github.com/users/zhangjiayang6835-cyber/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11346812202,"node_id":"LA_kwDOTGNm188AAAACpFKdKg","url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/labels/bug","name":"bug","color":"d73a4a","default":true,"description":"Something isn't working"},{"id":11370827640,"node_id":"LA_kwDOTGNm188AAAACpcEPeA","url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/labels/bounty","name":"bounty","color":"00ff00","default":false,"description":"赏金任务"},{"id":11374919204,"node_id":"LA_kwDOTGNm188AAAACpf9-JA","url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/labels/hard","name":"hard","color":"ededed","default":false,"description":null},{"id":11374970479,"node_id":"LA_kwDOTGNm188AAAACpgBGbw","url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/labels/security","name":"security","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":7,"created_at":"2026-06-30T11:37:46Z","updated_at":"2026-07-01T09:56:57Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 🐛 Bug Bounty: Full Takeover via Cache Poisoning\n\n**难度:** Hard | **奖励:** $50 USD\n\n### 漏洞描述\n此漏洞描述了一个常见的安全问题: Full Takeover via Cache Poisoning。需要提交修复代码。\n\n### 提交要求\n- 提交修复代码（Python/JavaScript）\n- 在 issue 评论中以代码块形式提交\n- 也可以创建 Pull Request\n\n### 评估标准\n- 代码正确修复了安全漏洞\n- 没有引入新的安全问题\n- 代码简洁且有效\n\n---\n*任务由 Daily Task Generator 自动创建*","reactions":{"url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/104/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/104/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/louislam/uptime-kuma/issues/6260","repository_url":"https://api.github.com/repos/louislam/uptime-kuma","labels_url":"https://api.github.com/repos/louislam/uptime-kuma/issues/6260/labels{/name}","comments_url":"https://api.github.com/repos/louislam/uptime-kuma/issues/6260/comments","events_url":"https://api.github.com/repos/louislam/uptime-kuma/issues/6260/events","html_url":"https://github.com/louislam/uptime-kuma/issues/6260","id":3553197739,"node_id":"I_kwDOFsxuac7TyX6r","number":6260,"title":"Please help with pull request reviews!","user":{"login":"CommanderStorm","id":26258709,"node_id":"MDQ6VXNlcjI2MjU4NzA5","avatar_url":"https://avatars.githubusercontent.com/u/26258709?v=4","gravatar_id":"","url":"https://api.github.com/users/CommanderStorm","html_url":"https://github.com/CommanderStorm","followers_url":"https://api.github.com/users/CommanderStorm/followers","following_url":"https://api.github.com/users/CommanderStorm/following{/other_user}","gists_url":"https://api.github.com/users/CommanderStorm/gists{/gist_id}","starred_url":"https://api.github.com/users/CommanderStorm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CommanderStorm/subscriptions","organizations_url":"https://api.github.com/users/CommanderStorm/orgs","repos_url":"https://api.github.com/users/CommanderStorm/repos","events_url":"https://api.github.com/users/CommanderStorm/events{/privacy}","received_events_url":"https://api.github.com/users/CommanderStorm/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":3136836376,"node_id":"MDU6TGFiZWwzMTM2ODM2Mzc2","url":"https://api.github.com/repos/louislam/uptime-kuma/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"May need your help to test or answer"},{"id":3184699051,"node_id":"MDU6TGFiZWwzMTg0Njk5MDUx","url":"https://api.github.com/repos/louislam/uptime-kuma/labels/discussion","name":"discussion","color":"104F4C","default":false,"description":""}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":30,"created_at":"2025-10-26T02:22:20Z","updated_at":"2026-07-01T07:39:16Z","closed_at":null,"assignee":null,"author_association":"COLLABORATOR","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"We have a huge number of open pull requests, and it's unfortunate that so many of them stay open for so long before being reviewed or merged. I'd like to change this situation.\n\n> [!IMPORTANT]\n> Obviously, there are more than pull requests.\n> Contributing to features, bugs, docs or by helping people are great ways to empower others (and thus you!).\n\nThe main bottleneck that we have currently is more pull requests being created than the maintainers can review each week.\nReviewing PRs is often time consuming, and with the best will in the world there's only so many that I can manage each week. It's also often a bit emotionally draining for me, since I don't enjoy saying no to PRs, or asking other volunteers to do even more work (e.g. making more changes to their PR). But rather than having fewer PRs opened each week (which would be a bad situation), I would like to get more reviews completed each week instead.\n\nThe best thing that you can do to help is to review someone else's PR.\nDon't worry, there's over 95 open today, I'm sure you can find one of interest to you!\nPlease take a look at it, read through it, have a think about the problem and the proposed solution and see what comes to mind. Maybe you'll spot that there's actually an underlying problem that should be solved instead (https://github.com/louislam/uptime-kuma/issues/6200 is a great example of this), or you would have a different approach if you did it yourself, or you apply [some of our \"internal\" pr reiew guidelines](https://github.com/louislam/uptime-kuma/blob/master/.github/REVIEW_GUIDELINES.md) and can help other contributors shape up their PR. That way the PR will become easier for the maintainers to review and merge when they get to it.\n\nAll of this helps share the workload for the maintainers. And it's the main path to becoming a maintainer yourself! I would also love to see a few more maintainers in the team.\n\nI'm happy to help anyone who is helping out with the work of reviewing PRs, since I think it's the main thing that is limiting our progress right now.","reactions":{"url":"https://api.github.com/repos/louislam/uptime-kuma/issues/6260/reactions","total_count":20,"+1":20,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/louislam/uptime-kuma/issues/6260/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":{"url":"https://api.github.com/repos/louislam/uptime-kuma/issues/comments/3796504136","html_url":"https://github.com/louislam/uptime-kuma/issues/6260#issuecomment-3796504136","issue_url":"https://api.github.com/repos/louislam/uptime-kuma/issues/6260","id":3796504136,"node_id":"IC_kwDOFsxuac7iSg5I","user":{"login":"louislam","id":1336778,"node_id":"MDQ6VXNlcjEzMzY3Nzg=","avatar_url":"https://avatars.githubusercontent.com/u/1336778?v=4","gravatar_id":"","url":"https://api.github.com/users/louislam","html_url":"https://github.com/louislam","followers_url":"https://api.github.com/users/louislam/followers","following_url":"https://api.github.com/users/louislam/following{/other_user}","gists_url":"https://api.github.com/users/louislam/gists{/gist_id}","starred_url":"https://api.github.com/users/louislam/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/louislam/subscriptions","organizations_url":"https://api.github.com/users/louislam/orgs","repos_url":"https://api.github.com/users/louislam/repos","events_url":"https://api.github.com/users/louislam/events{/privacy}","received_events_url":"https://api.github.com/users/louislam/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-25T11:55:24Z","updated_at":"2026-06-12T21:13:22Z","body":"After reading: https://www.reddit.com/r/programming/comments/1ql0w5p/overrun_with_ai_slop_curl_scraps_bug_bounties_to/\n\nI’ve also decided to disallow similar pull requests.  \nPeople are just rushing us to earn bug bounty money.\n\nAny pull requests listed on Gittensor will be closed.  \nhttps://gittensor.io/miners/repository?name=louislam%2Fuptime-kuma\n\nNot sure about other platforms. Let me know if you know any.\n\nFor pure AI usage (not bug-bounty driven), it’s acceptable when used to:\n\n- fix small issues  \n- correct grammar  \n- help understand the codebase  \n- act as auto-complete  \n\nBut if someone just feeds the issue to a code agent, generates code + LLM description, then pings for review without checking anything\n \nDepending on my mood, you might get **banned** immediately.\n\n<details><summary>Details, why we are taking such drasing measures from the a few months</summary>\n\n- https://github.com/louislam/uptime-kuma/issues/6260#issuecomment-3897470982\n- https://github.com/louislam/uptime-kuma/pull/6950\n- https://github.com/louislam/uptime-kuma/issues/6924\n- https://github.com/louislam/uptime-kuma/pull/6942\n- https://github.com/louislam/uptime-kuma/pull/6828\n- https://github.com/louislam/uptime-kuma/pull/6910\n- https://github.com/louislam/uptime-kuma/pull/6901\n- https://github.com/louislam/uptime-kuma/pull/6667\n- https://github.com/louislam/uptime-kuma/pull/6550\n- https://github.com/louislam/uptime-kuma/pull/6416\n- https://github.com/louislam/uptime-kuma/pull/6235\n- https://github.com/louislam/uptime-kuma/pull/6155\n- https://github.com/louislam/uptime-kuma/pull/6137\n- ht