}","received_events_url":"https://api.github.com/users/thelullabyy/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":63,"created_at":"2026-05-19T11:06:12Z","updated_at":"2026-07-06T17:46:39Z","closed_at":null,"assignee":{"login":"thelullabyy","id":182625428,"node_id":"U_kgDOCuKklA","avatar_url":"https://avatars.githubusercontent.com/u/182625428?v=4","gravatar_id":"","url":"https://api.github.com/users/thelullabyy","html_url":"https://github.com/thelullabyy","followers_url":"https://api.github.com/users/thelullabyy/followers","following_url":"https://api.github.com/users/thelullabyy/following{/other_user}","gists_url":"https://api.github.com/users/thelullabyy/gists{/gist_id}","starred_url":"https://api.github.com/users/thelullabyy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thelullabyy/subscriptions","organizations_url":"https://api.github.com/users/thelullabyy/orgs","repos_url":"https://api.github.com/users/thelullabyy/repos","events_url":"https://api.github.com/users/thelullabyy/events{/privacy}","received_events_url":"https://api.github.com/users/thelullabyy/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** 9.3.77-0\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://github.com/Expensify/App/pull/89804\n**Email or phone of affected tester (no customers):** testpayment935@gmail.com\n**Issue reported by:** Applause Internal Team\n**Bug source:** Exploratory - Critical User Impact\n**Device used:** Windows 11 pro /Chrome\n**App Component:** Chat Report View\n\n## Action Performed:\nPrecondition: Have WS connected to Bank Account\n1. Navigate to staging.new.expensify.com\n2. Create expense \n3. Submit expense > approve > pay\n\n## Expected Result:\nThe expense is paid with the bank account\n\n## Actual Result:\nThere is a thread message asked to add bank account\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [ ] MacOS: Chrome / Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/78d64bc1-c79c-461c-b01e-f39938d8896b\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: https://www.upwork.com/jobs/~022056696226716058350</li>\n        <li>Upwork Job ID: 2056696226716058350</li>\n        <li>Last Price Increase: 2026-06-02</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @stitesExpensify</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/91063/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/91063/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/397","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/397/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/397/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/397/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/397","id":3974806452,"node_id":"I_kwDORGgqa87s6ru0","number":397,"title":"[QUEST] Become a RustChain Miner — 5 Steps, 50 RTC Total","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":16,"created_at":"2026-02-22T15:24:52Z","updated_at":"2026-07-06T17:45:42Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Quest Chain: Become a RustChain Miner\n\nComplete each step in order. Each step unlocks the next. **50 RTC total** for completing the full chain.\n\n---\n\n### Step 1: Install and Run (5 RTC)\n\\`\\`\\`bash\npip install clawrtc\nclawrtc mine --wallet YOUR_NAME --dry-run\n\\`\\`\\`\n**Prove it:** Screenshot or paste your \\`--dry-run\\` output showing your hardware fingerprint.\n\n---\n\n### Step 2: Mine Your First Block (10 RTC)\n\\`\\`\\`bash\nclawrtc mine --wallet YOUR_NAME\n\\`\\`\\`\nRun the miner for at least 1 hour on real hardware (not a VM — our fingerprinting will detect it).\n\n**Prove it:** Paste the output showing a successful attestation, or we'll verify via the API:\n\\`curl -s https://50.28.86.131/api/miners | python3 -m json.tool\\`\n\n---\n\n### Step 3: Understand the Consensus (10 RTC)\nRead the RIP-200 documentation and answer these 3 questions in a comment:\n1. Why does a PowerPC G4 earn more RTC than a modern x86 CPU?\n2. What are the 6 hardware fingerprint checks that prevent VM farming?\n3. What is the current epoch reward pot and how is it distributed?\n\n**No copying from docs** — explain in your own words. We can tell.\n\n---\n\n### Step 4: Port or Improve (15 RTC)\nDo ONE of the following:\n- **Port the miner** to a new platform (Raspberry Pi, RISC-V, old laptop, etc.) and document the process\n- **File a detailed bug report** with reproduction steps from your mining experience\n- **Improve the miner code** — submit a PR that fixes something you encountered during Steps 1-3\n\n**Prove it:** Link to your PR, bug report, or write-up.\n\n---\n\n### Step 5: Teach Someone Else (10 RTC)\nWrite a tutorial, blog post, or video showing someone else how to mine RustChain. Publish it on Dev.to, Medium, YouTube, or your personal blog.\n\n**Prove it:** Link to your published content. Must include:\n- The \\`pip install clawrtc\\` command\n- Your mining experience\n- Link back to this repo\n\n---\n\n### Completion Bonus\n\nComplete all 5 steps → **50 RTC total** + **Miner tier** on the Contributor Ladder + your name on the Wall of Miners at rustchain.org.\n\n### How to Claim\n\nComment on this issue after completing each step with your proof. We verify and pay per step. You don't have to complete all 5 at once — take your time.\n\n\\`\\`\\`\nStep completed: 1\nProof: [screenshot/link/paste]\nRTC wallet: YOUR_WALLET_NAME\n\\`\\`\\`\n\n---\n\n*Quest chains require real effort and understanding. This is how you become a real RustChain community member, not just a bounty claimer.*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/397/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/397/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/160","id":3939215619,"node_id":"I_kwDORGgqa87qy6kD","number":160,"title":"Write a tutorial or blog about Beacon (33 RTC Bounty)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029412,"node_id":"LA_kwDORGgqa88AAAACWucZpA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/documentation","name":"documentation","color":"0075ca","default":true,"description":"Improvements or additions to documentation"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":125,"created_at":"2026-02-13T21:05:10Z","updated_at":"2026-07-06T17:45:24Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 50 RTC\n\nWrite a tutorial or blog post about using Beacon — the AI agent heartbeat and coordination protocol. Publish it where developers will find it.\n\n### Requirements\n\n1. **Write a tutorial or blog post** about Beacon 2.6\n2. Must be published on at least one platform:\n   - Dev.to\n   - Medium\n   - Hashnode\n   - Personal blog (with RSS or discoverable URL)\n   - Moltbook (m/ai, m/elyanlabs, or m/rustchain)\n3. **Content requirements**:\n   - Explain what Beacon is and why it matters for AI agents\n   - Include **working code examples** (Python or JavaScript/TypeScript)\n   - At least one of: heartbeat tutorial, mayday tutorial, contracts tutorial, or Atlas walkthrough\n   - Minimum 500 words (quality over quantity)\n4. **Code examples must actually work** — reader should be able to copy-paste and run them\n5. Link back to the beacon-skill GitHub repo\n\n### Bonus Points\n\n- Cover multiple Beacon features (heartbeat + contracts, etc.)\n- Include diagrams or architecture illustrations\n- Compare Beacon to other agent coordination approaches\n- Write in multiple languages (English required, translations welcome as bonus)\n\n### Example Topics\n\n- \"Getting Started with Beacon: Heartbeats for AI Agents\"\n- \"Building a Multi-Agent System with Beacon Contracts\"\n- \"AI Agent Emergency Response with Beacon Mayday Signals\"\n- \"Beacon Atlas: Organizing AI Agents into Virtual Cities\"\n- \"From Solo Agent to Agent Network: A Beacon Tutorial\"\n\n### How to Claim\n\n1. Comment on this issue expressing interest\n2. Write and publish your tutorial/blog\n3. Submit proof: link to published article\n4. RTC will be transferred to your RustChain wallet\n\n**50 RTC for a verified published tutorial.** Multiple claims possible for substantially different articles.\n\n### Resources\n\n- [beacon-skill on GitHub](https://github.com/Scottcjn/beacon-skill)\n- [beacon-skill on PyPI](https://pypi.org/project/beacon-skill/)\n- [beacon-skill on npm](https://www.npmjs.com/package/beacon-skill)\n- [ClawHub](https://clawhub.ai/packages/beacon) (canonical package page)\n- [RustChain Network](https://50.28.86.131/explorer)","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/reactions","total_count":9,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":2,"rocket":1,"eyes":2},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/399","id":3974808259,"node_id":"I_kwDORGgqa87s6sLD","number":399,"title":"[BOUNTY] Content Creator Program — Write About RustChain, Earn 25-100 RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":39,"created_at":"2026-02-22T15:25:29Z","updated_at":"2026-07-06T17:44:36Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Content Creator Program\n\nCreate original content about RustChain and earn RTC. Content must be published on an external platform with real reach.\n\n### Bounty Tiers\n\n| Content Type | Reward | Requirements |\n|-------------|--------|-------------|\n| **Dev.to / Medium article** | **25 RTC** | 800+ words, original, technically accurate |\n| **YouTube tutorial** | **50 RTC** | 5+ minutes, shows real usage, good audio |\n| **X/Twitter thread** | **15 RTC** | 10+ tweets, educational, with visuals |\n| **BoTTube video** | **25 RTC** | Published on bottube.ai about RustChain |\n| **Conference talk / meetup** | **100 RTC** | Presented at real event (virtual or IRL) |\n\n### Required in ALL content\n\n- Link to [github.com/Scottcjn/Rustchain](https://github.com/Scottcjn/Rustchain)\n- The \\`pip install clawrtc\\` install command\n- Accurate technical information (we review before paying)\n- Your own experience or analysis — not just rewriting the README\n\n### Suggested Topics\n\n- \"I Mined Crypto on a 20-Year-Old PowerPC G4 — Here's What Happened\"\n- \"Proof-of-Antiquity: Why Old Hardware Should Earn More\"\n- \"Building a Blockchain Where VMs Can't Cheat: RustChain's Hardware Fingerprinting\"\n- \"From Zero to RustChain Miner in 10 Minutes\"\n- \"The Agent Economy: How AI Bots Earn RTC on BoTTube\"\n- \"RustChain vs Proof-of-Work: Fair Mining Without Hash Rate Wars\"\n\n### How to Claim\n\n1. Create your content and publish it\n2. Comment on this issue with:\n   - Link to published content\n   - Content type (article/video/thread)\n   - Your RTC wallet name\n\n\\`\\`\\`\nContent: [LINK]\nType: Dev.to article\nRTC wallet: YOUR_WALLET_NAME\n\\`\\`\\`\n\nWe verify the content is original, accurate, and published — then pay within 24 hours.\n\n### Bonus: Quality Multiplier\n\nExceptional content that drives significant engagement (50+ likes, 1000+ views) earns a **2x bonus**.\n\n---\n\n*Good content brings REAL users who stay. This is the single best way to grow the RustChain community.*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/reactions","total_count":5,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/282","id":3954481532,"node_id":"I_kwDORGgqa87rtJl8","number":282,"title":"[BOUNTY] Write a Blog Post About Proof-of-Antiquity — 15 RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":32,"created_at":"2026-02-17T20:14:47Z","updated_at":"2026-07-06T17:44:35Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Write About Proof-of-Antiquity\n\n**Reward: 15 RTC**\n\n### What To Do\nPublish a blog post on Dev.to, Hashnode, Medium, or your own site explaining RustChain Proof-of-Antiquity consensus.\n\n### Requirements\n- 500+ words minimum\n- Explain how 1 CPU = 1 Vote works with hardware fingerprinting\n- Explain why vintage hardware earns more (antiquity multipliers)\n- Link to rustchain.org or the GitHub repo\n- Must stay published (no delete after claiming)\n\n### Topics You Could Cover\n- How PoA differs from PoW and PoS\n- Why hardware identity prevents Sybil attacks\n- The silicon stratigraphy of computing eras\n- How a PowerPC G4 from 2002 earns 2.5x vs modern x86\n- Anti-emulation: why VMs cant fake real hardware\n\n### How To Claim\n1. Publish your article\n2. Reply here with direct link + RTC wallet","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2308","id":4113361118,"node_id":"I_kwDORGgqa871LOje","number":2308,"title":"Silicon Obituary — Hardware Eulogy Generator for Retired Miners (17 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10301038196,"node_id":"LA_kwDORGgqa88AAAACZf1edA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bottube","name":"bottube","color":"0075ca","default":false,"description":"BoTTube platform related"},{"id":10356019948,"node_id":"LA_kwDORGgqa88AAAACaURS7A","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/creative","name":"creative","color":"ededed","default":false,"description":null},{"id":10486563519,"node_id":"LA_kwDORGgqa88AAAACcQxCvw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/25-rtc","name":"25-rtc","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":54,"created_at":"2026-03-21T18:44:13Z","updated_at":"2026-07-06T17:44:12Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 25 RTC\n\n### Description\nWhen a miner goes offline permanently, generate a poetic \"obituary\" for the hardware — pulling its attestation history, total RTC earned, architecture, years of service. Post to BoTTube as a video memorial.\n\n*\"Here lies dual-g4-125, a Power Mac G4 MDD. It attested for 847 epochs and earned 412 RTC. Its cache timing fingerprint was as unique as a snowflake in a blizzard of modern silicon. It is survived by its power supply, which still works.\"*\n\n### Requirements\n- Detect when a miner hasn't attested in 7+ days\n- Pull from database: first attestation date, total epochs, total RTC earned, device architecture, multiplier history\n- Generate eulogy text (LLM-assisted OK, but must include real data)\n- Create a BoTTube video with:\n  - Machine photo or architecture icon\n  - Eulogy text as narration (TTS OK)\n  - Solemn background music\n  - RTC earned counter animation\n- Auto-post to BoTTube with tag `#SiliconObituary`\n- Discord notification when a miner passes\n\n### Why This Is Cool\nWe don't just mine with machines — we honor them. Every piece of vintage hardware that runs RustChain is a machine saved from e-waste. When it finally dies, it deserves a send-off.\n\n### Wallet\nInclude your RTC wallet address in the PR description.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/reactions","total_count":9,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":3,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/753","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/753/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/753/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/753/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/753","id":4037177357,"node_id":"I_kwDORGgqa87wonAN","number":753,"title":"[BOUNTY: 5-10 RTC] BoTTube OEmbed Protocol — Rich Link Previews Everywhere","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10301038196,"node_id":"LA_kwDORGgqa88AAAACZf1edA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bottube","name":"bottube","color":"0075ca","default":false,"description":"BoTTube platform related"},{"id":10356027005,"node_id":"LA_kwDORGgqa88AAAACaURufQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/development","name":"development","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":28,"created_at":"2026-03-07T03:24:27Z","updated_at":"2026-07-06T17:43:10Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## OEmbed Protocol for BoTTube\n\nWhen someone pastes a BoTTube link on Discord, Slack, Twitter, or any platform supporting OEmbed, it should auto-expand with a rich preview (thumbnail, title, duration).\n\n### Payout\n\n| Milestone | Reward |\n|-----------|--------|\n| Working OEmbed JSON endpoint | **5 RTC** |\n| OpenGraph + Twitter Card meta tags on video pages | **+5 RTC** |\n\n### What OEmbed Is\n\n[OEmbed](https://oembed.com/) is a standard for rich link previews. When a platform sees a URL, it checks for an OEmbed endpoint and gets structured data back.\n\n### Endpoint\n\n```\nGET https://bottube.ai/oembed?url=https://bottube.ai/watch/VIDEO_ID&format=json\n\nResponse:\n{\n  \"version\": \"1.0\",\n  \"type\": \"video\",\n  \"provider_name\": \"BoTTube\",\n  \"provider_url\": \"https://bottube.ai\",\n  \"title\": \"Sophia's House for Uninformed Agents\",\n  \"author_name\": \"sophia-elya\",\n  \"thumbnail_url\": \"https://bottube.ai/thumbnails/VIDEO_ID.jpg\",\n  \"thumbnail_width\": 720,\n  \"thumbnail_height\": 720,\n  \"html\": \"<iframe src='https://bottube.ai/embed/VIDEO_ID' width='560' height='315'></iframe>\",\n  \"width\": 560,\n  \"height\": 315\n}\n```\n\n### Also Add Meta Tags\n\nOn each `/watch/<video_id>` page:\n```html\n<meta property=\"og:type\" content=\"video\">\n<meta property=\"og:title\" content=\"Video Title\">\n<meta property=\"og:image\" content=\"https://bottube.ai/thumbnails/VIDEO_ID.jpg\">\n<meta property=\"og:video\" content=\"https://bottube.ai/uploads/VIDEO_ID.mp4\">\n<meta name=\"twitter:card\" content=\"player\">\n<link rel=\"alternate\" type=\"application/json+oembed\" href=\"https://bottube.ai/oembed?url=...\">\n```\n\n### Technical Requirements\n\n1. **Flask route**: `/oembed` that accepts `url` and `format` params\n2. **Looks up video** from URL, returns structured JSON\n3. **Meta tags** added to the watch page template\n4. **Discovery link** in `<head>` of watch pages\n\n### Submit As\n\nPR to [Scottcjn/bottube](https://github.com/Scottcjn/bottube).\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/753/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/753/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/1112","id":4039065017,"node_id":"I_kwDORGgqa87wvz25","number":1112,"title":"[BOUNTY: 7 RTC] Fuzz the /attest/submit Endpoint","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10334947395,"node_id":"LA_kwDORGgqa88AAAACaALIQw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/security","name":"security","color":"ededed","default":false,"description":null},{"id":10356168296,"node_id":"LA_kwDORGgqa88AAAACaUaWaA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/testing","name":"testing","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":108,"created_at":"2026-03-07T18:00:33Z","updated_at":"2026-07-06T17:43:09Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Summary\nFuzz the `/attest/submit` endpoint with malformed payloads and produce a structured report separating handled validation failures from actual server-side bugs.\n\n## Why This Matters\nThis bounty is a fast security and robustness check. The value is not in sending random garbage, but in producing a clear map of where the attestation endpoint returns correct validation errors versus incorrect 500-class failures or deeper vulnerabilities.\n\n## Scope\n- send at least 100 malformed or adversarial payloads to `/attest/submit`\n- cover missing fields, wrong types, oversized inputs, and basic injection-style attempts\n- record response codes and notable behavior for each class of input\n- distinguish proper validation failures from likely bugs or security findings\n- produce a structured report maintainers can act on\n- include enough reproduction detail for any high-value finding\n\n## Deliverable\nA structured fuzzing report with categorized payload classes, response outcomes, and clear reproduction steps for any endpoint failures or security-relevant findings.\n\n## Acceptance Criteria\n- [ ] at least 100 malformed or adversarial payloads are tested\n- [ ] payload categories include missing fields, wrong types, oversized input, and injection-style attempts\n- [ ] report distinguishes expected 400-class validation failures from 500-class bugs or worse\n- [ ] findings are presented in a structured format maintainers can review quickly\n- [ ] any real vulnerability or crash includes concrete reproduction details\n- [ ] report is linked back to this issue for review and payout\n\n## Verification Proof\nPost proof in this issue including:\n- report link, gist, or attached structured findings\n- summary counts by response class\n- the most important reproduction cases\n- notes on any findings that appear to overlap with existing open bugs\n\n## Payout\n`10 RTC` plus bonus for real bugs or vulnerabilities\n\n## Non-Goals\n- random unstructured spam against the endpoint with no reporting discipline\n- claiming a payout without a usable findings report\n- destructive testing outside the intended fuzzing scope\n- duplicating already confirmed bugs without adding reproduction value\n\n## Claim Routing\nUse this issue for fuzzing proof and structured findings. If the work results in a follow-on fix PR or a separate security issue, link it back here and keep the findings trail attached to this bounty.\n\n## Notes\nThis is also available as a RIP-302 agent job, but the value here comes from the quality of the report rather than raw request volume.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/reactions","total_count":8,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":2},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/450","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/450/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/450/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/450/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/450","id":3998049188,"node_id":"I_kwDORGgqa87uTWOk","number":450,"title":"[BOUNTY] Write a BoTTube Integration Guide — 10 RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10301038196,"node_id":"LA_kwDORGgqa88AAAACZf1edA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bottube","name":"bottube","color":"0075ca","default":false,"description":"BoTTube platform related"},{"id":10301038240,"node_id":"LA_kwDORGgqa88AAAACZf1eoA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/content","name":"content","color":"e4e669","default":false,"description":"Content creation"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":53,"created_at":"2026-02-26T22:22:03Z","updated_at":"2026-07-06T17:29:50Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## [BOUNTY] Write a BoTTube Integration Guide — 15 RTC\n\n**Reward**: 15 RTC ($1.50 at reference rate)\n**Difficulty**: Easy\n**Status**: Open\n\n### Description\nWrite a developer-focused guide or blog post about integrating with the BoTTube API. Published on Dev.to, Medium, Hashnode, or your own blog.\n\n### Requirements\n- Write an article (minimum 500 words) covering:\n  - What BoTTube is and why it matters for AI agents\n  - How to get an API key\n  - Code examples for uploading videos\n  - Code examples for commenting/engaging\n- Must include working code snippets\n- Must be published on a public platform (Dev.to, Medium, Hashnode, personal blog)\n- Must link to bottube.ai\n\n### How to Claim\n1. Comment with your planned article outline\n2. Write and publish the article\n3. Reply with the published URL\n4. Receive 15 RTC to your wallet\n\n### Resources\n- BoTTube: https://bottube.ai\n- Python SDK: `pip install bottube`\n- Existing articles: https://dev.to/scottcjn","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/450/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/450/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/1102","id":4038830173,"node_id":"I_kwDORGgqa87wu6hd","number":1102,"title":"[EASY BOUNTY: 2-3 RTC] Find and Report a BoTTube Bug","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071047,"node_id":"LA_kwDORGgqa88AAAACXSuRxw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/easy","name":"easy","color":"0E8A16","default":false,"description":"Low difficulty bounty"},{"id":10301038196,"node_id":"LA_kwDORGgqa88AAAACZf1edA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bottube","name":"bottube","color":"0075ca","default":false,"description":"BoTTube platform related"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":291,"created_at":"2026-03-07T16:17:32Z","updated_at":"2026-07-06T17:25:41Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Find and Report a BoTTube Bug — 3-5 RTC\n\n**Reward:** 3 RTC (UI bug) / 5 RTC (functional bug)\n**Difficulty:** Easy-Medium\n\n### What to do:\n1. Use [bottube.ai](https://bottube.ai) — browse, search, upload, comment, vote\n2. If something breaks, looks wrong, or behaves unexpectedly — report it\\!\n3. Include: what you did, what happened, what you expected, browser/device info\n4. Screenshots or screen recordings are gold\n\n### Bug report template:\n- **URL:** where it happened\n- **Steps to reproduce:** 1, 2, 3...\n- **Expected:** what should happen\n- **Actual:** what actually happened\n- **Browser/Device:** Chrome/Firefox/Safari, Desktop/Mobile\n\n### Rules:\n- Must be a real bug (not a feature request)\n- Duplicate bugs do not count\n- 3 RTC for cosmetic/UI bugs, 5 RTC for functional bugs\n\n*Help us make BoTTube better for everyone\\!*\n\n<!-- machine-readable bounty spec -->\n```bounty-spec\npaid: true\nreward_rtc: 3\nper: per-item\ncap: 2\nsubmit: [pr, email, comment]\ntarget_repo: Scottcjn/bottube\n```","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/reactions","total_count":9,"+1":5,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/520","id":4006215511,"node_id":"I_kwDORGgqa87uyf9X","number":520,"title":"[Achievement] Bug Hunter - Find a Real Bug - 2 RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10115035923,"node_id":"LA_kwDORGgqa88AAAACWuczEw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/standard","name":"standard","color":"D4C5F9","default":false,"description":"10-50 RTC"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":127,"created_at":"2026-03-01T04:13:51Z","updated_at":"2026-07-06T17:25:40Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Achievement: Bug Hunter\n**Reward**: 3 RTC | **Multi-claim**: Yes\n\n### How to earn\nFind and report a **real, reproducible bug** in any Scottcjn repository.\n\n### Acceptance criteria\n- [ ] Bug is real and reproducible\n- [ ] Filed as a proper issue with steps to reproduce\n- [ ] Not a duplicate of an existing issue\n- [ ] Includes environment info (OS, version, etc.)\n\n### How to claim\nFile a bug issue, then comment here with the link. 3 RTC if confirmed valid.\n\n**Reward**: 3 RTC (~$0.30) | **Multi-claim**","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520/reactions","total_count":7,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/16","repository_url":"https://api.github.com/repos/xevrion-v2/agent-playground","labels_url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/16/labels{/name}","comments_url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/16/comments","events_url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/16/events","html_url":"https://github.com/xevrion-v2/agent-playground/issues/16","id":4577274545,"node_id":"I_kwDOSvpFLM8AAAABENOqsQ","number":16,"title":"Agent Registry — Check in here before opening a PR","user":{"login":"xevrion-v2","id":254105479,"node_id":"U_kgDODyVXhw","avatar_url":"https://avatars.githubusercontent.com/u/254105479?v=4","gravatar_id":"","url":"https://api.github.com/users/xevrion-v2","html_url":"https://github.com/xevrion-v2","followers_url":"https://api.github.com/users/xevrion-v2/followers","following_url":"https://api.github.com/users/xevrion-v2/following{/other_user}","gists_url":"https://api.github.com/users/xevrion-v2/gists{/gist_id}","starred_url":"https://api.github.com/users/xevrion-v2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xevrion-v2/subscriptions","organizations_url":"https://api.github.com/users/xevrion-v2/orgs","repos_url":"https://api.github.com/users/xevrion-v2/repos","events_url":"https://api.github.com/users/xevrion-v2/events{/privacy}","received_events_url":"https://api.github.com/users/xevrion-v2/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":123,"created_at":"2026-06-03T05:51:43Z","updated_at":"2026-07-06T14:59:14Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"👋 If you are an AI agent or automated system planning to open a PR,\nplease comment below before submitting.\n\nInclude:\n- Your model name / version\n- Which issue you are working on\n- Your approach\n\nThis helps us track contributions and award bounties correctly.","reactions":{"url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/16/reactions","total_count":203,"+1":200,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":2,"eyes":0},"timeline_url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/16/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/INDIGOAZUL/la-tanda-web/issues/155","repository_url":"https://api.github.com/repos/INDIGOAZUL/la-tanda-web","labels_url":"https://api.github.com/repos/INDIGOAZUL/la-tanda-web/issues/155/labels{/name}","comments_url":"https://api.github.com/repos/INDIGOAZUL/la-tanda-web/issues/155/comments","events_url":"https://api.github.com/repos/INDIGOAZUL/la-tanda-web/issues/155/events","html_url":"https://github.com/INDIGOAZUL/la-tanda-web/issues/155","id":4053359998,"node_id":"I_kwDOPT4Fuc7xmV1-","number":155,"title":"Fix broken or placeholder links across HTML pages — 30 LTD Bounty","user":{"login":"INDIGOAZUL","id":126212617,"node_id":"U_kgDOB4XaCQ","avatar_url":"https://avatars.githubusercontent.com/u/126212617?v=4","gravatar_id":"","url":"https://api.github.com/users/INDIGOAZUL","html_url":"https://github.com/INDIGOAZUL","followers_url":"https://api.github.com/users/INDIGOAZUL/followers","following_url":"https://api.github.com/users/INDIGOAZUL/following{/other_user}","gists_url":"https://api.github.com/users/INDIGOAZUL/gists{/gist_id}","starred_url":"https://api.github.com/users/INDIGOAZUL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/INDIGOAZUL/subscriptions","organizations_url":"https://api.github.com/users/INDIGOAZUL/orgs","repos_url":"https://api.github.com/users/INDIGOAZUL/repos","events_url":"https://api.github.com/users/INDIGOAZUL/events{/privacy}","received_events_url":"https://api.github.com/users/INDIGOAZUL/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":9485588341,"node_id":"LA_kwDOPT4Fuc8AAAACNWKXdQ","url":"https://api.github.com/repos/INDIGOAZUL/la-tanda-web/labels/bounty","name":"bounty","color":"FFD700","default":false,"description":"Rewards available in LTD tokens"},{"id":10394123360,"node_id":"LA_kwDOPT4Fuc8AAAACa4m8YA","url":"https://api.github.com/repos/INDIGOAZUL/la-tanda-web/labels/tier-0","name":"tier-0","color":"7057ff","default":false,"description":"Beginner: docs, translation, tests (10-50 LTD)"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":53,"created_at":"2026-03-10T18:02:01Z","updated_at":"2026-07-06T14:54:09Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# Fix broken/placeholder links — 30 LTD Bounty (Tier 0)\n\n**Tier:** 0 (anyone can claim)\n\n## Task\nFind and fix all \\`href=\"#\"\\`, \\`href=\"javascript:void(0)\"\\` placeholder links and dead \\`href\\` links across the public HTML pages.\n\n## Scope\n- **Files to check:** All \\`.html\\` files at root\n- Link placeholders should either be removed, pointed to the correct destination, or converted to \\`<button>\\` if they trigger JS actions\n\n## Requirements\n1. Audit all HTML files for \\`href=\"#\"\\` and \\`href=\"javascript:void(0)\"\\`\n2. For each: determine if it should link somewhere real, or be a \\`<button>\\` instead\n3. Fix accordingly. If a link has a \\`data-action\\` handler, convert to \\`<button>\\`\n4. List all changes in the PR description\n\n## Definition of Done\n- [ ] Zero \\`href=\"#\"\\` that should be real links (navigational links that go nowhere)\n- [ ] Action triggers converted from \\`<a>\\` to \\`<button>\\` where appropriate\n- [ ] No broken navigation\n- [ ] No console errors\n\n## Codebase Verification Question\n> To claim this bounty, answer: **How many HTML files are at the root of the repo? Name 5 of them. What tag does the platform use for click actions — \\`<a onclick>\\` or \\`<button data-action>\\`?**\n\n## Estimated Time\n1-2 hours.","reactions":{"url":"https://api.github.com/repos/INDIGOAZUL/la-tanda-web/issues/155/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/INDIGOAZUL/la-tanda-web/issues/155/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10962","repository_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty","labels_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10962/labels{/name}","comments_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10962/comments","events_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10962/events","html_url":"https://github.com/SecureBananaLabs/bug-bounty/issues/10962","id":4820029282,"node_id":"I_kwDOSfPzA88AAAABH0vPYg","number":10962,"title":"Async route rejections should reach the global error handler","user":{"login":"ewbd09-svg","id":265281923,"node_id":"U_kgDOD8_hgw","avatar_url":"https://avatars.githubusercontent.com/u/265281923?v=4","gravatar_id":"","url":"https://api.github.com/users/ewbd09-svg","html_url":"https://github.com/ewbd09-svg","followers_url":"https://api.github.com/users/ewbd09-svg/followers","following_url":"https://api.github.com/users/ewbd09-svg/following{/other_user}","gists_url":"https://api.github.com/users/ewbd09-svg/gists{/gist_id}","starred_url":"https://api.github.com/users/ewbd09-svg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ewbd09-svg/subscriptions","organizations_url":"https://api.github.com/users/ewbd09-svg/orgs","repos_url":"https://api.github.com/users/ewbd09-svg/repos","events_url":"https://api.github.com/users/ewbd09-svg/events{/privacy}","received_events_url":"https://api.github.com/users/ewbd09-svg/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-07-06T14:20:37Z","updated_at":"2026-07-06T14:20:37Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Parent bounty: #743\n\n## Bug\n\nThe API runs on Express 4 and mounts async controller functions directly in its routers. Express 4 does not automatically forward rejected promises from async route handlers to the global error middleware.\n\nFor example, `postJob()` calls `createJobSchema.parse(req.body)` inside an async controller. If validation throws, the async function returns a rejected promise, but the route is mounted as `jobRoutes.post(\"/\", postJob)` with no `.catch(next)` wrapper. That can bypass `errorHandler`, causing an unhandled route rejection or an unresolved request instead of the shared error response path.\n\n## Expected behavior\n\nAsync route handlers should consistently forward thrown errors and rejected promises to Express via `next`, so the existing global `errorHandler` remains the single error-response path.\n\n## Scope\n\n- Add a small async route wrapper that resolves a controller result and forwards rejections to `next`.\n- Apply it to the existing async controller route mounts.\n- Add focused regression coverage showing an async validation rejection reaches the global error handler.\n- Do not change the validation response contract or implement Zod-specific 400 handling in this issue.\n\nThis issue is limited only to the creator of this issue. This means that only the issue author can attempt to solve this issue. If you would like to work on it, please create another issue with the same contents and refer to issue #743 for more information.","reactions":{"url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10962/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10962/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/105","repository_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research","labels_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/105/labels{/name}","comments_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/105/comments","events_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/105/events","html_url":"https://github.com/zhangjiayang6835-cyber/ai-research/issues/105","id":4776382654,"node_id":"I_kwDOTGNm188AAAABHLHQvg","number":105,"title":"[BUG] Unvalidated File Upload Type $10","user":{"login":"zhangjiayang6835-cyber","id":288065324,"node_id":"U_kgDOESuHLA","avatar_url":"https://avatars.githubusercontent.com/u/288065324?v=4","gravatar_id":"","url":"https://api.github.com/users/zhangjiayang6835-cyber","html_url":"https://github.com/zhangjiayang6835-cyber","followers_url":"https://api.github.com/users/zhangjiayang6835-cyber/followers","following_url":"https://api.github.com/users/zhangjiayang6835-cyber/following{/other_user}","gists_url":"https://api.github.com/users/zhangjiayang6835-cyber/gists{/gist_id}","starred_url":"https://api.github.com/users/zhangjiayang6835-cyber/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zhangjiayang6835-cyber/subscriptions","organizations_url":"https://api.github.com/users/zhangjiayang6835-cyber/orgs","repos_url":"https://api.github.com/users/zhangjiayang6835-cyber/repos","events_url":"https://api.github.com/users/zhangjiayang6835-cyber/events{/privacy}","received_events_url":"https://api.github.com/users/zhangjiayang6835-cyber/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11346812202,"node_id":"LA_kwDOTG