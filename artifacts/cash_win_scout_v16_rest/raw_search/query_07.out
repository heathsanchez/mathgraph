"https://api.github.com/repos/dev-kp-eloper/BountyScout","labels_url":"https://api.github.com/repos/dev-kp-eloper/BountyScout/issues/399/labels{/name}","comments_url":"https://api.github.com/repos/dev-kp-eloper/BountyScout/issues/399/comments","events_url":"https://api.github.com/repos/dev-kp-eloper/BountyScout/issues/399/events","html_url":"https://github.com/dev-kp-eloper/BountyScout/issues/399","id":4823510906,"node_id":"I_kwDOSmCMss8AAAABH4Dveg","number":399,"title":"🎯 Bounty Alert: 3 New Opportunityies found","user":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[{"id":11035515258,"node_id":"LA_kwDOSmCMss8AAAACkcSZeg","url":"https://api.github.com/repos/dev-kp-eloper/BountyScout/labels/bounty-alert","name":"bounty-alert","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-07-06T22:17:17Z","updated_at":"2026-07-06T22:17:17Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Active Bounty Scan Results\n\n**Scan Time:** 2026-07-06 22:17 UTC\n\n#### 1. [Algora Prettier submission — agent-prettier-rs, 91% corpus pass-rate](https://github.com/ale-helper-bot/agent-prettier-rs/issues/1)\n- **Repository:** [ale-helper-bot/agent-prettier-rs](https://github.com/ale-helper-bot/agent-prettier-rs)\n- **Comments:** 1\n- **Last Updated:** 2026-07-06T22:02:23Z\n\n#### 2. [Auth endpoints should return 400 for invalid request bodies](https://github.com/SecureBananaLabs/bug-bounty/issues/10966)\n- **Repository:** [SecureBananaLabs/bug-bounty](https://github.com/SecureBananaLabs/bug-bounty)\n- **Comments:** 0\n- **Last Updated:** 2026-07-06T21:42:49Z\n\n#### 3. [[Bounty] Help fix broken file upload component in React/TypeScript (.tsx) bounty bounty:15](https://github.com/Hazyshades/Sendly-Test-Repo/issues/41)\n- **Repository:** [Hazyshades/Sendly-Test-Repo](https://github.com/Hazyshades/Sendly-Test-Repo)\n- **Comments:** 6\n- **Last Updated:** 2026-07-06T21:33:20Z\n\n","reactions":{"url":"https://api.github.com/repos/dev-kp-eloper/BountyScout/issues/399/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/dev-kp-eloper/BountyScout/issues/399/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/mswell/bountybrain/issues/1","repository_url":"https://api.github.com/repos/mswell/bountybrain","labels_url":"https://api.github.com/repos/mswell/bountybrain/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/mswell/bountybrain/issues/1/comments","events_url":"https://api.github.com/repos/mswell/bountybrain/issues/1/events","html_url":"https://github.com/mswell/bountybrain/issues/1","id":4815615831,"node_id":"I_kwDOTOul5c8AAAABHwh3Vw","number":1,"title":"PRD: BountyBrain — MCP multi-plataforma de bug bounty (HackerOne + YesWeHack, read-only)","user":{"login":"mswell","id":2567185,"node_id":"MDQ6VXNlcjI1NjcxODU=","avatar_url":"https://avatars.githubusercontent.com/u/2567185?v=4","gravatar_id":"","url":"https://api.github.com/users/mswell","html_url":"https://github.com/mswell","followers_url":"https://api.github.com/users/mswell/followers","following_url":"https://api.github.com/users/mswell/following{/other_user}","gists_url":"https://api.github.com/users/mswell/gists{/gist_id}","starred_url":"https://api.github.com/users/mswell/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mswell/subscriptions","organizations_url":"https://api.github.com/users/mswell/orgs","repos_url":"https://api.github.com/users/mswell/repos","events_url":"https://api.github.com/users/mswell/events{/privacy}","received_events_url":"https://api.github.com/users/mswell/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11429255300,"node_id":"LA_kwDOTOul5c8AAAACqTyYhA","url":"https://api.github.com/repos/mswell/bountybrain/labels/ready-for-agent","name":"ready-for-agent","color":"0E8A16","default":false,"description":"PRD/issue synthesized and ready for an AFK coding agent"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":3,"created_at":"2026-07-06T03:06:02Z","updated_at":"2026-07-06T21:58:49Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Problem Statement\n\nPesquisadores de bug bounty que trabalham em múltiplas plataformas (HackerOne, YesWeHack, Bugcrowd, Intigriti) não têm um jeito de dar a um agente de IA memória persistente e consultável sobre seus programas, scopes e histórico pessoal de reports recompensados. Existe o `H1Brain`, um MCP que resolve isso só para HackerOne (sync de programas/scopes/reports pessoais em SQLite + briefing de ataque via `hack(handle)`). Não existe equivalente maduro para as outras plataformas, e as ferramentas existentes (`bbscope`, `bounty-targets-data`, `rix4uni/scope`) resolvem apenas scope público agregado — sem conta autenticada, sem histórico pessoal, sem briefing.\n\n## Solution\n\nConstruir o **BountyBrain**: um MCP server (TypeScript) + skill companion, read-only, que sincroniza programas/scopes/reports pessoais recompensados de múltiplas plataformas de bug bounty num schema SQLite unificado, e expõe tools consultáveis (incluindo uma tool de briefing `hack(platform, handle)`) para qualquer client MCP (Pi, Claude Code, Claude Desktop). MVP cobre HackerOne primeiro (API estável, PAT), depois YesWeHack (Bearer token manual, sem automação de login). Bugcrowd e Intigriti ficam como adapters futuros. Nenhuma ação de escrita em nenhuma plataforma, em nenhuma fase.\n\n## User Stories\n\n1. Como pesquisador de bug bounty, quero sincronizar meus programas acessíveis no HackerOne para o banco local, para não precisar consultar a plataforma manualmente toda vez.\n2. Como pesquisador, quero sincronizar os scopes (in-scope/out-of-scope) de um programa HackerOne específico, para saber rapidamente o que posso ou não testar.\n3. Como pesquisador, quero sincronizar meus reports pessoais recompensados no HackerOne, para ter histórico local pesquisável.\n4. Como pesquisador, quero buscar programas por nome/handle/plataforma (`search_programs`), para encontrar rapidamente um programa sem abrir o navegador.\n5. Como pesquisador, quero buscar assets em escopo por domínio/tipo/plataforma (`search_scopes`), para saber se um asset específico está elegível a bounty em qualquer plataforma sincronizada.\n6. Como pesquisador, quero buscar meus reports passados por peso/severidade/programa/plataforma (`search_reports`), para relembrar o que já encontrei e onde.\n7. Como pesquisador, quero rodar `hack(platform, handle)` e receber um briefing com scope atual + meu histórico de findings naquele programa, para começar uma sessão de hacking com contexto real em vez de do zero.\n8. Como pesquisador, quero que a busca (`search_programs`/`search_scopes`/`search_reports`) funcione cross-platform quando eu não especificar `platform`, para comparar oportunidades entre HackerOne e YesWeHack sem trocar de ferramenta.\n9. Como pesquisador, quero configurar minha autenticação do HackerOne (username + PAT) num único arquivo local, para não espalhar segredos em vários lugares.\n10. Como pesquisador, quero configurar meu Bearer token do YesWeHack manualmente (colando um token já gerado), para não precisar guardar minha senha nem meu segredo de TOTP em disco.\n11. Como pesquisador, quero que o BountyBrain me avise claramente quando o token do YesWeHack expirar ou estiver ausente (ao invés de falhar silenciosamente ou tentar logar sozinho), para eu saber exatamente o que fazer (gerar novo token).\n12. Como pesquisador, quero uma tool `check_auth(platform)` para verificar proativamente se minhas credenciais ainda são válidas, sem precisar gastar uma chamada de negócio real para descobrir isso.\n13. Como pesquisador, quero que o sistema registre localmente quando uma verificação de auth funcionou ou falhou pela última vez, para eu (e o projeto) aprendermos o TTL real do token do YesWeHack, já que a plataforma não documenta isso publicamente.\n14. Como mantenedor do projeto, quero um schema de dados unificado entre plataformas (`programs`, `scopes`, `reports` com coluna `platform`), para que as tools de busca funcionem de forma consistente independente da plataforma de origem.\n15. Como mantenedor, quero que cada registro guarde o payload bruto original (`raw_json`), para nunca perder informação específica de uma plataforma que não caiba no schema comum.\n16. Como mantenedor, quero que tools de sincronização sejam prefixadas por plataforma (`hackerone_sync_programs`, `yeswehack_sync_scopes`, etc.), porque autenticação e paginação diferem de verdade entre plataformas e não vale a pena forçar uma abstração comum aí.\n17. Como usuário de segurança, quero ter certeza absoluta de que o BountyBrain nunca escreve, comenta ou muda status de nenhum report em nenhuma plataforma, para que ações no programa continuem sendo decisão exclusivamente minha.\n18. Como contribuidor open source, quero clonar o repositório, rodar `npm install && npm run build`, e registrar o MCP manualmente no meu client (Pi/Claude Desktop/Claude Code), sem depender de publicação no npm.\n19. Como usuário de qualquer coding agent compatível com o padrão `npx skills`, quero instalar a skill do BountyBrain (`skills/bug-bounty/bountybrain/SKILL.md`) via `npx skills add`, para usar o MCP com orientação de uso correta desde o primeiro dia.\n20. Como mantenedor, quero testes unitários com mocks das APIs do HackerOne/YesWeHack cobrindo parsing e schema, para pegar regressões sem depender de credenciais reais em CI.\n21. Como pesquisador, quero rodar uma verificação manual real (contra a API de verdade) como checklist antes de cada release, para confirmar que os adapters ainda funcionam com a API atual das plataformas.\n22. Como mantenedor, quero que uma futura base de reports públicos disclosed (equivalente ao dataset do H1Brain) seja adicionada como Fase 2 separada e opcional, sem bloquear a entrega do MVP.\n23. Como mantenedor, quero que adapters de Bugcrowd e Intigriti sejam adicionados numa fase futura, seguindo a mesma interface de adapter estabelecida por HackerOne/YesWeHack.\n\n## Implementation Decisions\n\n- **Stack:** TypeScript, usando o SDK oficial `@modelcontextprotocol/sdk`. Storage local via SQLite (`better-sqlite3`).\n- **Ordem de entrega:** adapter HackerOne completo primeiro (read-only: sync programs/scopes/reports pessoais) → adapter YesWeHack em seguida → Bugcrowd/Intigriti como adapters futuros (fora do MVP).\n- **Autenticação HackerOne:** username + Personal Access Token, lidos de `~/.config/bountybrain/secrets.env` (`HACKERONE_USERNAME`, `HACKERONE_TOKEN`).\n- **Autenticação YesWeHack:** Bearer token colado manualmente pelo usuário (`YESWEHACK_TOKEN` no mesmo arquivo). Sem automação de login (sem guardar email/senha/segredo TOTP). Detecção de expiração é reativa (`401` da API de fato) mais uma tool `check_auth(platform)` para checagem proativa. Toda verificação (sucesso ou falha) grava em uma tabela local `auth_state(platform, last_verified_at, last_failed_at, notes)` — nunca grava o token em si — para acumular dado real sobre o TTL do token, que não é documentado publicamente pela plataforma.\n- **Schema unificado** entre plataformas:\n  ```sql\n  programs(id, platform, handle, name, offers_bounties, submission_state, raw_json, synced_at)\n  scopes(id, platform, program_handle, asset_identifier, asset_type, eligible_for_bounty, eligible_for_submission, max_severity, instruction, raw_json, synced_at)\n  reports(id, platform, program_handle, title, state, severity_rating, weakness_name, weakness_cwe, bounty_amount, bounty_currency, vulnerability_information, created_at, bounty_awarded_at, disclosed_at, raw_json, synced_at)\n  auth_state(platform, last_verified_at, last_failed_at, notes)\n  ```\n  Cada tabela guarda `raw_json` do payload original da API, para preservar fidelidade quando o schema comum não capturar algum campo específico de uma plataforma.\n- **Superfície de tools MCP:**\n  - Prefixadas por plataforma (sync): `hackerone_sync_programs()`, `hackerone_sync_scopes(handle)`, `hackerone_sync_reports()`, `yeswehack_sync_programs()`, `yeswehack_sync_scopes(handle)`, `yeswehack_sync_reports()`.\n  - Unificadas (busca/briefing, `platform` opcional): `search_programs(platform?, query?, bounty_only?)`, `search_scopes(platform?, program?, asset?, bounty_only?)`, `search_reports(platform?, program?, weakness?, severity?)`, `hack(platform, handle)`, `check_auth(platform)`.\n- **Read-only por design:** nenhuma tool de escrita (comentário, mudança de status, submissão de report) existe no código em nenhuma plataforma, em nenhuma fase — não é uma flag de configuração, é ausência de código.\n- **Credenciais:** um único arquivo `~/.config/bountybrain/secrets.env`, prefixado por plataforma, permissão `600`, fora do repositório (`.gitignore`), nunca logado, nunca persistido no SQLite.\n- **Estrutura do repositório:**\n  ```text\n  bountybrain/\n  ├── LICENSE (MIT)\n  ├── PRD.md\n  ├── README.md\n  ├── package.json\n  ├── tsconfig.json\n  ├── src/\n  │   ├── server.ts\n  │   ├── db/ (schema.ts, client.ts)\n  │   └── platforms/ (hackerone.ts, yeswehack.ts, bugcrowd.ts stub, intigriti.ts stub)\n  ├── test/\n  └── skills/bug-bounty/bountybrain/SKILL.md\n  ```\n- **Skill:** vive dentro do próprio repositório, seguindo o padrão do ecossistema `npx skills` (`mattpocock/skills`), instalável via `npx skills add <owner>/bountybrain` em qualquer coding agent compatível.\n- **Distribuição:** sem publicação no npm por enquanto. Instalação via clone + `npm install && npm run build` + registro manual do MCP no client. Publicação no npm é considerada apenas quando HackerOne + YesWeHack estiverem estáveis e testados de verdade.\n- **Licença:** MIT, projeto open source desde o início.\n\n## Testing Decisions\n\n- Testes unitários com **mocks** das respostas de API do HackerOne e YesWeHack (fixtures de payload real, sem bater na API de verdade).\n- Cobertura prioritária: parsing/normalização de payload → schema unificado (garantir que campos obrigatórios nunca ficam nulos silenciosamente, que `raw_json` sempre é preservado).\n- Nenhuma credencial real (PAT/Bearer) em CI. Testes de integração real contra as APIs ficam como checklist manual de validação antes de cada release, não como pipeline automatizado — decisão explícita para não expor segredos em CI de um repositório open source.\n- Um bom teste aqui verifica comportamento observável (ex: \"dado este payload de `/programs`, `search_programs` retorna estes registros normalizados\"), não detalhes de implementação interna do adapter.\n\n## Out of Scope\n\n- Qualquer ação de escrita em qualquer plataforma (comentar report, mudar status, submeter report). Permanentemente fora de escopo, não é uma feature futura.\n- Login automatizado (email + senha + TOTP) para YesWeHack. Só Bearer token manual.\n- Base de reports públicos disclosed (equivalente aos 3.600+ reports do H1Brain) — vira Fase 2 separada, não faz parte deste PRD/MVP.\n- Adapters de Bugcrowd e Intigriti — ficam para fase futura, fora deste PRD.\n- Publicação no npm.\n- Qualquer scraping de scope público agregado sem autenticação (isso já é resolvido por `bbscope`/`bounty-targets-data`/`rix4uni/scope` e não é o objetivo deste projeto).\n- Integração com Raijū ou qualquer outro repositório/skill existente — o BountyBrain é standalone por decisão explícita.\n\n## Further Notes\n\n- Este PRD nasceu de uma sessão de alinhamento (`grilling`) com o mantenedor, cobrindo 14 decisões arquiteturais sequenciais antes de qualquer código ser escrito. O documento completo dessa sessão, incluindo o raciocínio por trás de cada decisão, está em `PRD.md` na raiz do repositório.\n- HackerOne foi escolhido como primeira plataforma por ter API pública, madura e com autenticação simples (PAT), servindo para validar a arquitetura de adapters/schema antes de lidar com a parte mais incerta (YesWeHack, cujo endpoint de auth real é `POST /login` + `POST /account/totp` retornando um Bearer de sessão sem TTL documentado — confirmado lendo o código-fonte do `bbscope`, não a documentação renderizada em JS da API).\n- O nome do pacote/binário (`bountybrain`) e a decisão de não publicar no npm ainda são revisáveis quando o projeto estabilizar — não são decisões permanentes, ao contrário das de escopo de escrita/leitura.\n","reactions":{"url":"https://api.github.com/repos/mswell/bountybrain/issues/1/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/mswell/bountybrain/issues/1/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898","repository_url":"https://api.github.com/repos/ValveSoftware/Proton","labels_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/labels{/name}","comments_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/comments","events_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/events","html_url":"https://github.com/ValveSoftware/Proton/issues/3898","id":622986148,"node_id":"MDU6SXNzdWU2MjI5ODYxNDg=","number":3898,"title":"Hunt: Showdown 1896 (594650)","user":{"login":"r3l0c","id":5171800,"node_id":"MDQ6VXNlcjUxNzE4MDA=","avatar_url":"https://avatars.githubusercontent.com/u/5171800?v=4","gravatar_id":"","url":"https://api.github.com/users/r3l0c","html_url":"https://github.com/r3l0c","followers_url":"https://api.github.com/users/r3l0c/followers","following_url":"https://api.github.com/users/r3l0c/following{/other_user}","gists_url":"https://api.github.com/users/r3l0c/gists{/gist_id}","starred_url":"https://api.github.com/users/r3l0c/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/r3l0c/subscriptions","organizations_url":"https://api.github.com/users/r3l0c/orgs","repos_url":"https://api.github.com/users/r3l0c/repos","events_url":"https://api.github.com/users/r3l0c/events{/privacy}","received_events_url":"https://api.github.com/users/r3l0c/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":1032039901,"node_id":"MDU6TGFiZWwxMDMyMDM5OTAx","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/Game%20compatibility%20-%20Unofficial","name":"Game compatibility - Unofficial","color":"ea6e3c","default":false,"description":"Games not expected to work without issues"},{"id":1033204233,"node_id":"MDU6TGFiZWwxMDMzMjA0MjMz","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/overlay","name":"overlay","color":"444444","default":false,"description":"Steam overlay is involved"},{"id":1100561692,"node_id":"MDU6TGFiZWwxMTAwNTYxNjky","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/XAudio2","name":"XAudio2","color":"FAEBD7","default":false,"description":"Uses the XAudio2 subsystem"},{"id":1113044448,"node_id":"MDU6TGFiZWwxMTEzMDQ0NDQ4","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/Mesa%20drivers","name":"Mesa drivers","color":"dc143c","default":false,"description":"Possibly involves an issue with a Mesa video driver"},{"id":2012203775,"node_id":"MDU6TGFiZWwyMDEyMjAzNzc1","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/AMD%20RADV","name":"AMD RADV","color":"dc143c","default":false,"description":"Possible driver issues with RADV"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":449,"created_at":"2020-05-22T06:31:42Z","updated_at":"2026-07-06T21:55:43Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# Compatibility Report\r\n- Name of the game with compatibility issues: Hunt Showdown\r\n- Steam AppID of the game: 594650\r\n\r\n## System Information\r\n- GPU: AMD Radeon HD5700\r\n- Driver/LLVM version: Mesa 20.2\r\n- Kernel version: 5.6.0-050600-generic\r\n- Link to full system information report as [Gist](https://gist.github.com/r3l0c/4b22617bd4dd5181dd16e06365355a33):\r\n- Proton version: Any version\r\n\r\n## I confirm:\r\n- [x] that I haven't found an existing compatibility report for this game.\r\n- [x] that I have checked whether there are updates for my system available.\r\n\r\n`PROTON_LOG=1 %command%` [steam-594650.log](https://github.com/ValveSoftware/Proton/files/4666409/steam-594650.log)\r\n\r\ngame.log [game.log](https://github.com/ValveSoftware/Proton/files/4666410/game.log)\r\n\r\n\r\n## Symptoms <!-- What's the problem? -->\r\nIf proton version lower 4 then black screen and process info in task manager: kernel wait \"pipe_read\"\r\nif proton version > 4 then Easy Anti Cheat cannot run with message box `ERROR: Failed to create EAC game client interface.` \r\n\r\n## Reproduction\r\n**Game not run any times, no need special reproducer**\r\n","reactions":{"url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10966","repository_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty","labels_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10966/labels{/name}","comments_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10966/comments","events_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10966/events","html_url":"https://github.com/SecureBananaLabs/bug-bounty/issues/10966","id":4823312728,"node_id":"I_kwDOSfPzA88AAAABH33pWA","number":10966,"title":"Auth endpoints should return 400 for invalid request bodies","user":{"login":"mircats98gpt","id":291542861,"node_id":"U_kgDOEWCXTQ","avatar_url":"https://avatars.githubusercontent.com/u/291542861?v=4","gravatar_id":"","url":"https://api.github.com/users/mircats98gpt","html_url":"https://github.com/mircats98gpt","followers_url":"https://api.github.com/users/mircats98gpt/followers","following_url":"https://api.github.com/users/mircats98gpt/following{/other_user}","gists_url":"https://api.github.com/users/mircats98gpt/gists{/gist_id}","starred_url":"https://api.github.com/users/mircats98gpt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mircats98gpt/subscriptions","organizations_url":"https://api.github.com/users/mircats98gpt/orgs","repos_url":"https://api.github.com/users/mircats98gpt/repos","events_url":"https://api.github.com/users/mircats98gpt/events{/privacy}","received_events_url":"https://api.github.com/users/mircats98gpt/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-07-06T21:42:49Z","updated_at":"2026-07-06T21:42:49Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"﻿Parent Algora bounty: #743\n\n## Bug\n\n`apps/api/src/controllers/authController.js` parses register and login request bodies with `registerSchema.parse(req.body)` and `loginSchema.parse(req.body)` directly. When either body is invalid, Zod throws a `ZodError` before the controller can return the API JSON error envelope.\n\nThis issue is limited only to the creator of this issue. This means that only the issue author can attempt to solve this issue. If you would like to work on it, please create another issue with the same contents and refer to issue #743 for more information.\n\n## Steps to reproduce\n\nCall `POST /api/auth/register` or `POST /api/auth/login` with a body such as:\n\n```json\n{\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}\n```\n\n## Expected behavior\n\nThe auth endpoint should return:\n\n```json\n{\n  \"success\": false,\n  \"message\": \"Invalid request body\"\n}\n```\n\nwith status `400`.\n\n## Actual behavior\n\nThe controller throws a `ZodError` instead of returning the predictable API error response.\n\n## Suggested fix\n\nCatch `ZodError` around auth schema parsing and route it through the existing `fail` response helper with status `400` for both register and login.\n\n## Validation plan\n\n- Add focused regression coverage for invalid register and login request bodies.\n- Confirm the endpoints return the existing `{ success: false, message }` JSON shape with HTTP 400.\n- Run `node --test apps/api/src/tests/authValidation.test.js apps/api/src/tests/health.test.js`.\n\n## Safety\n\nNo payout, contact, credential, wallet, or off-platform payment details should be posted publicly.\r\n","reactions":{"url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10966/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10966/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/92246","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/92246/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/92246/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/92246/events","html_url":"https://github.com/Expensify/App/issues/92246","id":4564165154,"node_id":"I_kwDOEQqHYc8AAAABEAuiIg","number":92246,"title":"[$250] Expense - Rejected expense is not moved to selfDM when submission frequency is disabled","user":{"login":"applause-bot[bot]","id":265651874,"node_id":"BOT_kgDOD9WGog","avatar_url":"https://avatars.githubusercontent.com/in/3009811?v=4","gravatar_id":"","url":"https://api.github.com/users/applause-bot%5Bbot%5D","html_url":"https://github.com/apps/applause-bot","followers_url":"https://api.github.com/users/applause-bot%5Bbot%5D/followers","following_url":"https://api.github.com/users/applause-bot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/applause-bot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/applause-bot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/applause-bot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/applause-bot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/applause-bot%5Bbot%5D/repos","events_url":"https://api.github.com/users/applause-bot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/applause-bot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893455829,"node_id":"MDU6TGFiZWwyODkzNDU1ODI5","url":"https://api.github.com/repos/Expensify/App/labels/Daily","name":"Daily","color":"eb6420","default":false,"description":"KSv2"},{"id":3136662525,"node_id":"MDU6TGFiZWwzMTM2NjYyNTI1","url":"https://api.github.com/repos/Expensify/App/labels/Help%20Wanted","name":"Help Wanted","color":"CFC8F1","default":false,"description":"Apply this label when an issue is open to proposals by contributors"},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"neil-marcellini","id":26260477,"node_id":"MDQ6VXNlcjI2MjYwNDc3","avatar_url":"https://avatars.githubusercontent.com/u/26260477?v=4","gravatar_id":"","