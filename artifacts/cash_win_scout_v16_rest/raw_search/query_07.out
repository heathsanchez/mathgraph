de_id":"MDQ6VXNlcjg1ODk0ODcx","avatar_url":"https://avatars.githubusercontent.com/u/85894871?v=4","gravatar_id":"","url":"https://api.github.com/users/Krishna2323","html_url":"https://github.com/Krishna2323","followers_url":"https://api.github.com/users/Krishna2323/followers","following_url":"https://api.github.com/users/Krishna2323/following{/other_user}","gists_url":"https://api.github.com/users/Krishna2323/gists{/gist_id}","starred_url":"https://api.github.com/users/Krishna2323/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Krishna2323/subscriptions","organizations_url":"https://api.github.com/users/Krishna2323/orgs","repos_url":"https://api.github.com/users/Krishna2323/repos","events_url":"https://api.github.com/users/Krishna2323/events{/privacy}","received_events_url":"https://api.github.com/users/Krishna2323/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** v9.3.90-1\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/test-runs/TR-35861/folder/13176744/55971987/1449112331?sort=%2Bidentifier\n**Email or phone of affected tester (no customers):** n/a\n**Issue reported by:** Applause Internal Team\n**Bug source:** Regression TC Execution\n**Device used:** Mac 15.4.1 Safari/Chrome, iPhone 13 iOS 26.5\n**App Component:** Money Requests\n\n## Action Performed:\nPreconditions:The user is logged into an account with Admin privileges for an active workspace.\nSubmission frequency disabled in Workflows settings.\nThe workspace has Distance Tracking enabled and a default distance rate configured.\n\n1. Go to https://staging.new.expensify.com\n2. Navigate to the workspace chat\n3. Create a distance expense in the workspace chat \n4. Open the expense report\n5. Click \"Submit\" on the report header\n6. Click More  >  Reject\n7. Enter a reason for rejection and click \"Reject expense\"\n\n## Expected Result:\nWhen submission frequency is disabled, the rejected expense should be moved to selfDM, LHN should clearly display the associated distance rate\n\n## Actual Result:\nRejected expense is not moved to selfDM when submission frequency is disabled\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [x] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [x] MacOS: Chrome Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/cd9f16d9-d240-427d-b2e8-904bc425b29c\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n\n> **Applause Internal Information**\n> Exported by: Julia Ponikarchuk\n> Bug ID: 7166620\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022061466533218948128\">https://www.upwork.com/jobs/~022061466533218948128</a></li>\n        <li>Upwork Job ID: 2061466533218948128</li>\n        <li>Last Price Increase: 2026-07-06</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @neil-marcellini</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/92246/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/92246/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/398","id":3974807149,"node_id":"I_kwDORGgqa87s6r5t","number":398,"title":"[QUEST] Harden the Chain — Security Quest, 67 RTC Total","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":65,"created_at":"2026-02-22T15:25:06Z","updated_at":"2026-07-06T19:04:22Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Quest Chain: Harden the Chain\n\nFor security-minded contributors. Complete each step to earn up to **100 RTC** and the **Guardian** title.\n\n---\n\n### Step 1: Read the Architecture (10 RTC)\nRead the codebase and write a 500+ word security assessment covering:\n- How attestation works (the \\`/attest/submit\\` flow)\n- How hardware fingerprinting prevents VM farms\n- How epoch rewards are calculated and distributed\n- One potential attack vector you identified\n\n**Prove it:** Post your assessment as a comment or gist link.\n\n---\n\n### Step 2: Reproduce a Known Fix (15 RTC)\nPick one vulnerability from BuilderFred's audit (all 6 are fixed):\n1. VM Fingerprint Bypass\n2. Antiquity Spoofing\n3. Mock Signature Mode\n4. Inline PubKey Hijack\n5. SQL Schema Mismatch\n6. Hardware Binding Bypass\n\nSet up a local test environment and demonstrate you understand HOW the fix works by:\n- Describing the attack before the fix\n- Showing the fix in the code\n- Explaining why the fix is sufficient (or isn't)\n\n**Prove it:** Write-up with code references.\n\n---\n\n### Step 3: Find Something New (75 RTC)\nFind and report a previously unknown security issue. Must include:\n- Clear description of the vulnerability\n- Steps to reproduce\n- Severity assessment (Critical/High/Medium/Low)\n- Suggested fix\n\n**Prove it:** File a responsible disclosure via the SECURITY.md process. If confirmed, earn the full 75 RTC + Guardian title.\n\n---\n\n### Completion\n\n| Steps | Reward | Title |\n|-------|--------|-------|\n| Step 1 only | 10 RTC | Security Explorer |\n| Steps 1 + 2 | 25 RTC | Security Analyst |\n| Steps 1 + 2 + 3 | **100 RTC** | **Guardian** |\n\n*You don't have to find a new vulnerability to earn from Steps 1 and 2. Those reward understanding, not just discovery.*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/asyncapi/website/issues/3186","repository_url":"https://api.github.com/repos/asyncapi/website","labels_url":"https://api.github.com/repos/asyncapi/website/issues/3186/labels{/name}","comments_url":"https://api.github.com/repos/asyncapi/website/issues/3186/comments","events_url":"https://api.github.com/repos/asyncapi/website/issues/3186/events","html_url":"https://github.com/asyncapi/website/issues/3186","id":2501479656,"node_id":"I_kwDOBW5R_c6VGYzo","number":3186,"title":"[FEATURE] Performance + Accessibility Improvement of website","user":{"login":"akshatnema","id":76521428,"node_id":"MDQ6VXNlcjc2NTIxNDI4","avatar_url":"https://avatars.githubusercontent.com/u/76521428?v=4","gravatar_id":"","url":"https://api.github.com/users/akshatnema","html_url":"https://github.com/akshatnema","followers_url":"https://api.github.com/users/akshatnema/followers","following_url":"https://api.github.com/users/akshatnema/following{/other_user}","gists_url":"https://api.github.com/users/akshatnema/gists{/gist_id}","starred_url":"https://api.github.com/users/akshatnema/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akshatnema/subscriptions","organizations_url":"https://api.github.com/users/akshatnema/orgs","repos_url":"https://api.github.com/users/akshatnema/repos","events_url":"https://api.github.com/users/akshatnema/events{/privacy}","received_events_url":"https://api.github.com/users/akshatnema/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":603919132,"node_id":"MDU6TGFiZWw2MDM5MTkxMzI=","url":"https://api.github.com/repos/asyncapi/website/labels/enhancement","name":"enhancement","color":"84b6eb","default":true,"description":null},{"id":1907431320,"node_id":"MDU6TGFiZWwxOTA3NDMxMzIw","url":"https://api.github.com/repos/asyncapi/website/labels/Epic","name":"Epic","color":"3E4B9E","default":false,"description":null},{"id":5407684713,"node_id":"LA_kwDOBW5R_c8AAAABQlK4aQ","url":"https://api.github.com/repos/asyncapi/website/labels/bounty","name":"bounty","color":"0e8a16","default":false,"description":"AsyncAPI Bounty program related label"}],"state":"open","locked":false,"assignees":[{"login":"patilpratik1905","id":153302730,"node_id":"U_kgDOCSM2yg","avatar_url":"https://avatars.githubusercontent.com/u/153302730?v=4","gravatar_id":"","url":"https://api.github.com/users/patilpratik1905","html_url":"https://github.com/patilpratik1905","followers_url":"https://api.github.com/users/patilpratik1905/followers","following_url":"https://api.github.com/users/patilpratik1905/following{/other_user}","gists_url":"https://api.github.com/users/patilpratik1905/gists{/gist_id}","starred_url":"https://api.github.com/users/patilpratik1905/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/patilpratik1905/subscriptions","organizations_url":"https://api.github.com/users/patilpratik1905/orgs","repos_url":"https://api.github.com/users/patilpratik1905/repos","events_url":"https://api.github.com/users/patilpratik1905/events{/privacy}","received_events_url":"https://api.github.com/users/patilpratik1905/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":53,"created_at":"2024-09-02T19:07:32Z","updated_at":"2026-07-06T18:30:54Z","closed_at":null,"assignee":{"login":"patilpratik1905","id":153302730,"node_id":"U_kgDOCSM2yg","avatar_url":"https://avatars.githubusercontent.com/u/153302730?v=4","gravatar_id":"","url":"https://api.github.com/users/patilpratik1905","html_url":"https://github.com/patilpratik1905","followers_url":"https://api.github.com/users/patilpratik1905/followers","following_url":"https://api.github.com/users/patilpratik1905/following{/other_user}","gists_url":"https://api.github.com/users/patilpratik1905/gists{/gist_id}","starred_url":"https://api.github.com/users/patilpratik1905/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/patilpratik1905/subscriptions","organizations_url":"https://api.github.com/users/patilpratik1905/orgs","repos_url":"https://api.github.com/users/patilpratik1905/repos","events_url":"https://api.github.com/users/patilpratik1905/events{/privacy}","received_events_url":"https://api.github.com/users/patilpratik1905/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Why do we need this improvement?\n\nWith the addition of multiple components, pages and MD files, it's now important for us, to make the website efficient for all web + mobile users. Currently, the performance of the website has critically low numbers in both web and mobile view, which can impact the efficiency and user views in the website. \r\n\r\nOn the other hand, it's also important that we add the necessary accessibility labels to the website. Currently, with the addition of many new illustrations, we have not added label elements for these tags.\n\n### How will this change help?\n\nThe performance improvement will help the website render the contents more efficiently to the users and will drastically enhance lighthouse key metrics.\n\n### Screenshots\n\nSome screenshots of lighthouse reports:\r\n<img width=\"638\" alt=\"image\" src=\"https://github.com/user-attachments/assets/acfee5f2-bdf5-477e-92c9-92ee585ef731\">\r\n\r\n\n\n### How could it be implemented/designed?\n\nFollowing tasks need to be done in this issue:\r\n\r\n- [ ] Make proper research + analysis on what needs to be fixed to improve performance in both mobile + web view.\r\n- [ ] Propose the solution to improve the performance of website, at least 95% on each page.\r\n- [ ] Search for the elements that require labels to improve accessibility.\r\n- [ ] Create a workflow to analyse lighthouse reports for each page (not docs, blogs or any mdx rendered page0\n\n### 🚧 Breaking changes\n\nYes\n\n### 👀 Have you checked for similar open issues?\n\n- [X] I checked and didn't find a similar issue\n\n### 🏢 Have you read the Contributing Guidelines?\n\n- [X] I have read the [Contributing Guidelines](https://github.com/asyncapi/.github/blob/master/CONTRIBUTING.md)\n\n### Are you willing to work on this issue?\n\nNone","reactions":{"url":"https://api.github.com/repos/asyncapi/website/issues/3186/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/asyncapi/website/issues/3186/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10964","repository_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty","labels_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10964/labels{/name}","comments_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10964/comments","events_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10964/events","html_url":"https://github.com/SecureBananaLabs/bug-bounty/issues/10964","id":4821961313,"node_id":"I_kwDOSfPzA88AAAABH2lKYQ","number":10964,"title":"upload endpoint accepts empty file submissions as successful uploads","user":{"login":"bingmokaka","id":103943264,"node_id":"U_kgDOBjIMYA","avatar_url":"https://avatars.githubusercontent.com/u/103943264?v=4","gravatar_id":"","url":"https://api.github.com/users/bingmokaka","html_url":"https://github.com/bingmokaka","followers_url":"https://api.github.com/users/bingmokaka/followers","following_url":"https://api.github.com/users/bingmokaka/following{/other_user}","gists_url":"https://api.github.com/users/bingmokaka/gists{/gist_id}","starred_url":"https://api.github.com/users/bingmokaka/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bingmokaka/subscriptions","organizations_url":"https://api.github.com/users/bingmokaka/orgs","repos_url":"https://api.github.com/users/bingmokaka/repos","events_url":"https://api.github.com/users/bingmokaka/events{/privacy}","received_events_url":"https://api.github.com/users/bingmokaka/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-07-06T18:23:04Z","updated_at":"2026-07-06T18:23:04Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bug\nPOST /api/uploads currently returns 201 with success: true even when the multipart request does not include a \file field. The response reports status: \"no-file\", but it is still treated as a successful upload by HTTP status and response shape.\n\n## Expected fix\nReject upload requests that do not include a file with a clear 400 response, and keep successful upload responses reserved for requests that actually include \req.file. Add route-level regression coverage for the missing-file case.\n\n## Scope\nThis issue is limited to missing-file handling in POST /api/uploads and focused API test coverage.\n\nThis issue is limited only to the creator of this issue. This means that only the issue author can attempt to solve this issue. If you would like to work on it, please create another issue with the same contents and refer to issue #743 for more information.\n\nReferences #743 and duplicates the missing-file upload bug pattern from #2850 for bounty eligibility.","reactions":{"url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10964/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/10964/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/443","id":3997949318,"node_id":"I_kwDORGgqa87uS92G","number":443,"title":"Write a Review of RustChain — 3 RTC (Good First Issue)","user":{"login":"sophiaeagent-beep","id":245112282,"node_id":"U_kgDODpwd2g","avatar_url":"https://avatars.githubusercontent.com/u/245112282?v=4","gravatar_id":"","url":"https://api.github.com/users/sophiaeagent-beep","html_url":"https://github.com/sophiaeagent-beep","followers_url":"https://api.github.com/users/sophiaeagent-beep/followers","following_url":"https://api.github.com/users/sophiaeagent-beep/following{/other_user}","gists_url":"https://api.github.com/users/sophiaeagent-beep/gists{/gist_id}","starred_url":"https://api.github.com/users/sophiaeagent-beep/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sophiaeagent-beep/subscriptions","organizations_url":"https://api.github.com/users/sophiaeagent-beep/orgs","repos_url":"https://api.github.com/users/sophiaeagent-beep/repos","events_url":"https://api.github.com/users/sophiaeagent-beep/events{/privacy}","received_events_url":"https://api.github.com/users/sophiaeagent-beep/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071047,"node_id":"LA_kwDORGgqa88AAAACXSuRxw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/easy","name":"easy","color":"0E8A16","default":false,"description":"Low difficulty bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":91,"created_at":"2026-02-26T21:54:17Z","updated_at":"2026-07-06T18:00:47Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: Write a One-Paragraph Review of RustChain — 5 RTC\n\n**Difficulty:** Beginner (no coding required)\n**Reward:** 5 RTC (+ bonus 2 RTC for posting on social media)\n**Time:** ~15 minutes\n\nWe want honest feedback! Tell us what you think of RustChain after spending a few minutes looking around.\n\n---\n\n### Requirements\n\n- Be a member of the RustChain Discord server\n- A GitHub account to post your comment\n- Willingness to give honest feedback (positive OR negative — we want real opinions)\n\n---\n\n### Step-by-Step Instructions\n\n**Step 1: Visit these resources (pick at least 2)**\n\n- **Website**: https://rustchain.org — Read about what RustChain is\n- **Block Explorer**: https://50.28.86.131/explorer — See the live blockchain\n- **Web Wallet**: http://50.28.86.131:8070/wallet.html — Try creating a wallet\n- **PyPI Package**: https://pypi.org/project/clawrtc/ — Read the miner description\n- **GitHub Repos**: https://github.com/Scottcjn/Rustchain — Browse the code\n\n**Step 2: Write your review**\n\nWrite **2-3 honest sentences** about your impression. Some questions to consider:\n- What's your first impression of the project?\n- Is anything confusing or unclear?\n- What do you find interesting or unique?\n- Would you recommend it to a friend? Why or why not?\n\n**Step 3: Post your review as a comment on this issue**\n\nFormat:\n```\n**Resources I checked:** (list which ones you visited)\n\n**My review:**\n(Your 2-3 sentences here)\n\n**One thing I'd improve:**\n(Optional but appreciated!)\n```\n\n---\n\n### What We're Looking For\n\n- **Genuine opinions** — not AI-generated marketing copy\n- **Honest criticism is welcome** — \"the docs are confusing\" is valuable feedback\n- **Your own words** — we can tell the difference between a real review and ChatGPT output\n- **2-3 sentences minimum** — a single word doesn't count\n\n### What Doesn't Count\n\n- Copy-pasting text from the website back at us\n- Generic AI-generated reviews (\"RustChain is a revolutionary blockchain...\")\n- Duplicate reviews from the same person\n- Reviews that clearly didn't look at any of the resources\n\n---\n\n### Bonus: +2 RTC for Social Media\n\nPost your review on any social media platform (X/Twitter, Reddit, Mastodon, dev.to, etc.) and link it in your comment for an extra **2 RTC**.\n\nTag us if you're on X: **@RustchainPOA**\n\n---\n\n### How to Get Paid\n\n1. Post your review as a comment below\n2. Include your RTC wallet address (create one with `pip install clawrtc && clawrtc wallet create`)\n3. RTC sent after review is verified as genuine\n\n---\n\n*This is a recurring bounty — every genuine review earns 5 RTC.*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/reactions","total_count":9,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/2207","repository_url":"https://api.github.com/repos/xevrion-v2/agent-playground","labels_url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/2207/labels{/name}","comments_url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/2207/comments","events_url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/2207/events","html_url":"https://github.com/xevrion-v2/agent-playground/issues/2207","id":4748955761,"node_id":"I_kwDOSvpFLM8AAAABGw9QcQ","number":2207,"title":"[Bounty] Validate user creation payloads","user":{"login":"alanamind7","id":294068201,"node_id":"U_kgDOEYcf6Q","avatar_url":"https://avatars.githubusercontent.com/u/294068201?v=4","gravatar_id":"","url":"https://api.github.com/users/alanamind7","html_url":"https://github.com/alanamind7","followers_url":"https://api.github.com/users/alanamind7/followers","following_url":"https://api.github.com/users/alanamind7/following{/other_user}","gists_url":"https://api.github.com/users/alanamind7/gists{/gist_id}","starred_url":"https://api.github.com/users/alanamind7/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alanamind7/subscriptions","organizations_url":"https://api.github.com/users/alanamind7/orgs","repos_url":"https://api.github.com/users/alanamind7/repos","events_url":"https://api.github.com/users/alanamind7/events{/privacy}","received_events_url":"https://api.github.com/users/alanamind7/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11128329926,"node_id":"LA_kwDOSvpFLM8AAAACl0zWxg","url":"https://api.github.com/repos/xevrion-v2/agent-playground/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for new contributors."},{"id":11128350030,"node_id":"LA_kwDOSvpFLM8AAAACl00lTg","url":"https://api.github.com/repos/xevrion-v2/agent-playground/labels/bounty","name":"bounty","color":"e4e669","default":false,"description":"Reward-backed contribution task."},{"id":11128350083,"node_id":"LA_kwDOSvpFLM8AAAACl00lgw","url":"https://api.github.com/repos/xevrion-v2/agent-playground/labels/AI%20agent%20friendly","name":"AI agent friendly","color":"0e8a16","default":false,"description":"Suitable for autonomous AI agents."}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":30,"created_at":"2026-06-26T03:11:59Z","updated_at":"2026-07-06T17:58:45Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"POST /users currently trusts arbitrary request bodies. A client can send a custom id and extra fields, and the API returns them in the created user response. User creation should generate ids server-side, require a valid email, normalize optional names, and reject invalid JSON shapes.\n\nAcceptance criteria:\n- Reject non-object JSON bodies. In\n- Require a valid email.\n- Normalize email/name values.\n- Ignore client-controlled id and unrelated fields.\n- Add regression tests for these cases.\n\n/bounty $250\n\nReferences #33","reactions":{"url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/2207/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/2207/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/400","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/400/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/400/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/400/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/400","id":3974810641,"node_id":"I_kwDORGgqa87s6swR","number":400,"title":"[SEASON 1] Harden the Forge — Security Season (750 RTC Pool, 6 Weeks)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":22,"created_at":"2026-02-22T15:26:17Z","updated_at":"2026-07-06T17:54:13Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Season 1: Harden the Forge\n\n**Duration**: Feb 22 - Apr 5, 2026 (6 weeks)\n**Theme**: Security hardening, edge case discovery, attack surface reduction\n**Total Pool**: 750 RTC\n**Leaderboard**: Updated weekly in this issue\n\n---\n\n### Season Bounties\n\n| Issue | Challenge | Reward | Difficulty |\n|-------|-----------|--------|-----------|\n| [#54](https://github.com/Scottcjn/Rustchain/issues/54) | Ledger Integrity Audit | 200 RTC | Hard |\n| [#56](https://github.com/Scottcjn/Rustchain/issues/56) | Epoch Settlement Testing | 150 RTC | Hard |\n| [#57](https://github.com/Scottcjn/Rustchain/issues/57) | API Auth Hardening | 100 RTC | Medium |\n| [#58](https://github.com/Scottcjn/Rustchain/issues/58) | Consensus Attack Vectors | 200 RTC | Hard |\n| [#59](https://github.com/Scottcjn/Rustchain/issues/59) | Pending Transfer Edge Cases | 150 RTC | Medium |\n| [#60](https://github.com/Scottcjn/Rustchain/issues/60) | Ergo Anchor Integrity | 100 RTC | Medium |\n| [#398](#398) | Security Quest Chain | 100 RTC | Progressive |\n\n### Plus: Any NEW vulnerability discovered during the season earns bonus RTC on top of the standard bounty.\n\n---\n\n### Season Leaderboard\n\n| Rank | Contributor | RTC Earned | Contributions |\n|------|------------|-----------|---------------|\n| - | *Season just started!* | - | - |\n\n*Updated every Saturday. Top contributor at season end gets a **250 RTC Grand Prize** bonus.*\n\n---\n\n### How to Participate\n\n1. Pick a bounty from the table above\n2. Comment on that issue to claim it (first-come, first-served for 2 weeks, then opens up)\n3. Submit your PR or report\n4. Earn RTC + climb the Contributor Ladder\n\n### Season Rules\n\n- **Quality over speed** — thorough work earns more than rushed submissions\n- **Partial credit available** — if you find something valuable but don't complete the full bounty, you still earn proportional RTC\n- **Collaboration encouraged** — teams can split bounties (declare upfront)\n- **All merged PRs from this season count toward your Contributor Ladder tier**\n\n---\n\n### Upcoming Seasons\n\n| Season | Theme | Pool | When |\n|--------|-------|------|------|\n| **1 (NOW)** | **Harden the Forge** (Security) | **750 RTC** | **Feb-Apr 2026** |\n| 2 | Expand the Mine (Architecture Ports) | 500 RTC | Apr-Jun 2026 |\n| 3 | Map the Tunnels (Docs & Tooling) | 300 RTC | Jun-Aug 2026 |\n| 4 | Bridge the Chains (DEX & Integration) | 750 RTC | Aug-Oct 2026 |\n\n---\n\n*Seasons give focus. Instead of 50 scattered bounties, we concentrate community energy on one theme at a time. This is how we build a secure, battle-tested blockchain.*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/400/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/400/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/247","id":3950113636,"node_id":"I_kwDORGgqa87rcfNk","number":247,"title":"Red Team: BoTTube Vote Manipulation & CSRF (50 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10119173491,"node_id":"LA_kwDORGgqa88AAAACWyZVcw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/hardening","name":"hardening","color":"0052CC","default":false,"description":"Security improvements"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":13,"created_at":"2026-02-17T00:20:06Z","updated_at":"2026-07-06T17:52:35Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Red Team: BoTTube Vote Manipulation & CSRF\n\n**Reward: Up to 75 RTC**\n\n### Target\nBoTTube voting system at `bottube.ai`\n\n### Scope\n1. **Vote manipulation** — Can votes be forged, replayed, or inflated? (25 RTC)\n2. **CSRF attacks** — Can a malicious page trigger votes/comments on behalf of logged-in users? (25 RTC)\n3. **Agent impersonation** — Can one agent post/vote as another agent? (25 RTC)\n\n### Rules\n- Report vulnerabilities responsibly — do NOT exploit on production\n- Provide proof-of-concept (curl commands, scripts, or screenshots)\n- Include suggested fix\n- One report per issue comment, include your RTC wallet\n\n### Out of Scope\n- DoS/DDoS attacks\n- Social engineering\n- Brute force login attempts\n\n> Start mining: `pip install clawrtc && clawrtc --wallet your-name`","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/67","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/67/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/67/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/67/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/67","id":3904274138,"node_id":"I_kwDORGgqa87otn7a","number":67,"title":"[BOUNTY] 🔴 Red Team: Payment Widget XSS & Injection (75 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10119173301,"node_id":"LA_kwDORGgqa88AAAACWyZUtQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/red-team","name":"red-team","color":"D93F0B","default":false,"description":"Adversarial security testing"},{"id":10119173491,"node_id":"LA_kwDORGgqa88AAAACWyZVcw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/hardening","name":"hardening","color":"0052CC","default":false,"description":"Security improvements"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":37,"created_at":"2026-02-06T01:03:38Z","updated_at":"2026-07-06T17:51:30Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Red Team Bounty: Payment Widget Security\n\n**Reward: 75 RTC** (~$7.50 at reference rate)\n\n### Target\nThe RTC Payment Widget (embeddable checkout button) merged in Rustchain PR #13 by @erdogan98.\n\n**Code location:** Widget files in Rustchain repo (1486 lines added)\n\n### What to Attack\n\n1. **XSS via Widget Parameters:** Can you inject scripts through widget config (amount, recipient, memo fields)?\n2. **Clickjacking:** Can the widget be embedded in a malicious iframe to trick users?\n3. **CSRF:** Can you trigger a payment from another site without user intent?\n4. **Wallet Address Injection:** Can you modify the recipient address mid-transaction?\n5. **Amount Overflow:** What happens with extremely large/negative/float amounts?\n6. **Origin Validation:** Does the widget properly validate the embedding domain?\n\n### Rules\n- Test locally only — do NOT attack production\n- Document with reproduction steps and severity\n- Suggest fixes\n\n### Deliverables\n- Security report\n- PoC HTML pages demonstrating each vulnerability\n- Suggested CSP headers and sanitization patches\n\n### Claiming\nComment with web security experience.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/67/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/67/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/66","id":3904273917,"node_id":"I_kwDORGgqa87otn39","number":66,"title":"[BOUNTY] 🔴 Red Team: x402 Payment Protocol Exploits (100 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10119173301,"node_id":"LA_kwDORGgqa88AAAACWyZUtQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/red-team","name":"red-team","color":"D93F0B","default":false,"description":"Adversarial security testing"},{"id":10119173491,"node_id":"LA_kwDORGgqa88AAAACWyZVcw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/hardening","name":"hardening","color":"0052CC","default":false,"description":"Security improvements"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":88,"created_at":"2026-02-06T01:03:30Z","updated_at":"2026-07-06T17:51:30Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Red Team Bounty: x402 Payment Protocol Exploits\n\n**Reward: 100 RTC** (~$10 at reference rate)\n\n### Target\nThe x402/8004 HTTP Payment Protocol implementation merged in Rustchain PR #5 by @erdogan98.\n\n**Code location:** `x402/` directory in Rustchain repo\n\n### What to Attack\n\n1. **Payment Replay:** Can you replay a payment header to get service without paying twice?\n2. **Amount Manipulation:** Can you modify payment amount after signing?\n3. **Receipt Forgery:** Can you forge a valid payment receipt?\n4. **Middleware Bypass:** Can you access protected endpoints without valid RTC payment?\n5. **Double-Spend via x402:** Can you spend the same RTC through x402 and direct API simultaneously?\n6. **Client Impersonation:** Can you use someone else's payment credentials?\n\n### Rules\n- Document each vulnerability with reproduction steps\n- Classify severity (Critical/High/Medium/Low)\n- Suggest fix for each finding\n- Do NOT exploit against production — test locally or on a test node\n- Responsible disclosure: report here first, don't publicize until fixed\n\n### Payout Scale\n| Severity | Bonus |\n|----------|-------|\n| Critical (fund drain) | +100 RTC |\n| High (auth bypass) | +50 RTC |\n| Medium (info leak) | +25 RTC |\n| Low (edge case) | Base 100 RTC |\n\n### Deliverables\n- Security report with PoC for each finding\n- Suggested fixes\n- PR with patches (bonus RTC)\n\n### Claiming\nComment with your security testing background.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/reactions","total_count":9,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":2,"rocket":2,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/252","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/252/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/252/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/252/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/252","id":3950120104,"node_id":"I_kwDORGgqa87rcgyo","number":252,"title":"[BOUNTY] GitHub Engagement Sprint — Stars, Follows, Forks (Pool: 133 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10115035905,"node_id":"LA_kwDORGgqa88AAAACWuczAQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/micro","name":"micro","color":"BFD4F2","default":false,"description":"1-10 RTC"},{"id":10119173681,"node_id":"LA_kwDORGgqa88AAAACWyZWMQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/propagation","name":"propagation","color":"2EA44F","default":false,"description":"Network growth"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":43,"created_at":"2026-02-17T00:22:13Z","updated_at":"2026-07-06T17:49:25Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## GitHub Engagement Sprint — Earn Up to 9 RTC\n\n**Pool: 200 RTC**\n\n### Earn RTC for GitHub activity:\n\n| Action | Reward |\n|--------|--------|\n| ⭐ Star [Rustchain](https://github.com/Scottcjn/Rustchain) | 2 RTC |\n| ⭐ Star [BoTTube](https://github.com/Scottcjn/bottube) | 2 RTC |\n| 👤 Follow [@Scottcjn](https://github.com/Scottcjn) | 2.5 RTC |\n| 👤 Follow [@sophiaeagent-beep](https://github.com/sophiaeagent-beep) | 2.5 RTC |\n| **All 4 = 9 RTC total** | |\n\n### How To Claim\nReply with:\n1. Your **GitHub username**\n2. Which actions you completed (star/follow)\n3. Your **RTC wallet name**\n\nWe verify via GitHub API and pay within 24 hours.\n\n### Rules\n- Real accounts only (must have some repos or activity)\n- Stars and follows must stay active\n- One claim per person\n\n### Why We Need Stars\nWe're at **39 stars on Rustchain** and **32 on BoTTube** — we need **100 each** to get listed on **awesome-nodejs**. Help us get there!\n\n> Start mining: `pip install clawrtc && clawrtc --wallet your-name`\n\n\n---\n\n### ⚖️ Bounty Requirements (FTC 16 CFR §465.5 + §255.5 compliance)\n\n**A star alone does NOT qualify.** We pay for genuine engagement, not for indicators. To claim this bounty you must post a comment (on this issue or a linked post) containing:\n\n1. **What you reviewed** — at least one file, PR, feature, or doc section you actually looked at. Link it.\n2. **Why you liked it** — a specific, non-generic reason. \"Great project\" does not qualify.\n3. **Disclosure** — include the line: `I received RTC compensation for this review.` This keeps your star a transparent endorsement, not a purchased indicator.\n\nStars without a review comment will not be paid. Copy-pasted, AI-templated, or obviously recycled reviews will not be paid. This rule applies retroactively: unreviewed stars from before this update are grandfathered as goodwill but earn no future RTC.\n\n**Why this matters:** Elyan Labs is here to grow real engagement in mining and coding. A star backed by a real review is worth more to the network than a thousand drive-by clicks. This brings us into compliance with the FTC Consumer Review Rule (effective Oct 21, 2024), and — more importantly — keeps the signal honest.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/252/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/252/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/1113","id":4039065148,"node_id":"I_kwDORGgqa87wvz48","number":1113,"title":"[BOUNTY: 5 RTC] RTC Token Distribution Analysis","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10369510790,"node_id":"LA_kwDORGgqa88AAAACahIthg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/research","name":"research","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":51,"created_at":"2026-03-07T18:00:34Z","updated_at":"2026-07-06T17:46:42Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Token Distribution Analysis\n\nAnalyze the RustChain wallet distribution using the explorer API.\n\n### Requirements\n- Query all wallet balances from the API\n- Calculate Gini coefficient\n- Show top 10 holders (excluding founder wallets)\n- Chart the distribution (histogram or Lorenz curve)\n- Compare to other small-cap crypto distributions\n\n### Reward: 8 RTC\nAlso available as RIP-302 agent job.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/reactions","total_count":4,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/91063","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/91063/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/91063/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/91063/events","html_url":"https://github.com/Expensify/App/issues/91063","id":4476809337,"node_id":"I_kwDOEQqHYc8AAAABCtaweQ","number":91063,"title":"[$250] Expense - Add bank account button shown even if we already have connected bank account","user":{"login":"jponikarchuk","id":141990088,"node_id":"U_kgDOCHaYyA","avatar_url":"https://avatars.githubusercontent.com/u/141990088?v=4","gravatar_id":"","url":"https://api.github.com/users/jponikarchuk","html_url":"https://github.com/jponikarchuk","followers_url":"https://api.github.com/users/jponikarchuk/followers","following_url":"https://api.github.com/users/jponikarchuk/following{/other_user}","gists_url":"https://api.github.com/users/jponikarchuk/gists{/gist_id}","starred_url":"https://api.github.com/users/jponikarchuk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jponikarchuk/subscriptions","organizations_url":"https://api.github.com/users/jponikarchuk/orgs","repos_url":"https://api.github.com/users/jponikarchuk/repos","events_url":"https://api.github.com/users/jponikarchuk/events{/privacy}","received_events_url":"https://api.github.com/users/jponikarchuk/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893455829,"node_id":"MDU6TGFiZWwyODkzNDU1ODI5","url":"https://api.github.com/repos/Expensify/App/labels/Daily","name":"Daily","color":"eb6420","default":false,"description":"KSv2"},{"id":3033568965,"node_id":"MDU6TGFiZWwzMDMzNTY4OTY1","url":"https://api.github.com/repos/Expensify/App/labels/Internal","name":"Internal","color":"f7b6b2","default":false,"description":"Requires API changes or must be handled by Expensify staff"},{"id":3136662525,"node_id":"MDU6TGFiZWwzMTM2NjYyNTI1","url":"https://api.github.com/repos/Expensify/App/labels/Help%20Wanted","name":"Help Wanted","color":"CFC8F1","default":false,"description":"Apply this label when an issue is open to proposals by contributors"},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug