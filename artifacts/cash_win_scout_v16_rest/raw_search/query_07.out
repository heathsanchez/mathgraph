ription":""},{"id":2893455829,"node_id":"MDU6TGFiZWwyODkzNDU1ODI5","url":"https://api.github.com/repos/Expensify/App/labels/Daily","name":"Daily","color":"eb6420","default":false,"description":"KSv2"},{"id":3136662525,"node_id":"MDU6TGFiZWwzMTM2NjYyNTI1","url":"https://api.github.com/repos/Expensify/App/labels/Help%20Wanted","name":"Help Wanted","color":"CFC8F1","default":false,"description":"Apply this label when an issue is open to proposals by contributors"},{"id":3184150925,"node_id":"MDU6TGFiZWwzMTg0MTUwOTI1","url":"https://api.github.com/repos/Expensify/App/labels/Overdue","name":"Overdue","color":"D93F0B","default":false,"description":""},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"mountiny","id":36083550,"node_id":"MDQ6VXNlcjM2MDgzNTUw","avatar_url":"https://avatars.githubusercontent.com/u/36083550?v=4","gravatar_id":"","url":"https://api.github.com/users/mountiny","html_url":"https://github.com/mountiny","followers_url":"https://api.github.com/users/mountiny/followers","following_url":"https://api.github.com/users/mountiny/following{/other_user}","gists_url":"https://api.github.com/users/mountiny/gists{/gist_id}","starred_url":"https://api.github.com/users/mountiny/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mountiny/subscriptions","organizations_url":"https://api.github.com/users/mountiny/orgs","repos_url":"https://api.github.com/users/mountiny/repos","events_url":"https://api.github.com/users/mountiny/events{/privacy}","received_events_url":"https://api.github.com/users/mountiny/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"adhorodyski","id":42047036,"node_id":"MDQ6VXNlcjQyMDQ3MDM2","avatar_url":"https://avatars.githubusercontent.com/u/42047036?v=