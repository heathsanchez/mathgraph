ed_events_url":"https://api.github.com/users/joekaufmanexpensify/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"thesahindia","id":83179295,"node_id":"MDQ6VXNlcjgzMTc5Mjk1","avatar_url":"https://avatars.githubusercontent.com/u/83179295?v=4","gravatar_id":"","url":"https://api.github.com/users/thesahindia","html_url":"https://github.com/thesahindia","followers_url":"https://api.github.com/users/thesahindia/followers","following_url":"https://api.github.com/users/thesahindia/following{/other_user}","gists_url":"https://api.github.com/users/thesahindia/gists{/gist_id}","starred_url":"https://api.github.com/users/thesahindia/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thesahindia/subscriptions","organizations_url":"https://api.github.com/users/thesahindia/orgs","repos_url":"https://api.github.com/users/thesahindia/repos","events_url":"https://api.github.com/users/thesahindia/events{/privacy}","received_events_url":"https://api.github.com/users/thesahindia/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":53,"created_at":"2026-06-21T18:42:54Z","updated_at":"2026-07-06T13:27:20Z","closed_at":null,"assignee":{"login":"dannymcclain","id":7516624,"node_id":"MDQ6VXNlcjc1MTY2MjQ=","avatar_url":"https://avatars.githubusercontent.com/u/7516624?v=4","gravatar_id":"","url":"https://api.github.com/users/dannymcclain","html_url":"https://github.com/dannymcclain","followers_url":"https://api.github.com/users/dannymcclain/followers","following_url":"https://api.github.com/users/dannymcclain/following{/other_user}","gists_url":"https://api.github.com/users/dannymcclain/gists{/gist_id}","starred_url":"https://api.github.com/users/dannymcclain/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dannymcclain/subscriptions","organizations_url":"https://api.github.com/users/dannymcclain/orgs","repos_url":"https://api.github.com/users/dannymcclain/repos","events_url":"https://api.github.com/users/dannymcclain/events{/privacy}","received_events_url":"https://api.github.com/users/dannymcclain/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Coming from [this Slack thread](https://expensify.slack.com/archives/C049HHMV9SM/p1780613739150249), we want to surface cash back activity as a dedicated row in the NewDot Bank Reconciliation view for the Expensify Card.\n\n### Details\n- In Classic, cash back credits appear as their own non-expandable row in Reconciliation > Settlements, with a `Cash Back Credit` merchant label, the credit amount, and a `Cleared` status (see screenshot below). NewDot currently shows nothing for cashback, making it impossible to reconcile cashback credits against bank activity.\n- To address that, we want to add a top-level cashback row to the Bank Reconciliation view to match this. The row should follow the existing NewDot rec table structure (Withdrawn date, Withdrawal status, Bank account, Withdrawal ID, Expenses, Total), but with no expand arrow option. \n- The plan is for the row to be identifiable by `Withdrawal status: Cash back` (analogous to how card payments use `Cleared`).\n- The total should display as a negative amount, consistent with OldDot and reflecting that cashback is a credit back to the bank account. The opposite direction from a card payment settlement.\n- This should be scoped to ACH cashback credits only, since the rec view is tied to bank activity. Cashback applied to billing is out of scope here, same as in OldDot. \n- We will pursue making these rows expandable in a follow-up issue, showing the individual underlying transactions that earned cashback in the period. \n\n### Existing cash back credit row (OldDot)\n\n<img width=\"1253\" height=\"714\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/3473c081-7810-419c-a1ce-f77f4c0273e3\" />\n\n### Cash back row in NewDot (final mock) \n\n<img width=\"2800\" height=\"1624\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/5d2555c2-bb4a-4357-8d29-61686f24d80b\" />\n\n\n\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @ShridharGoel</details>\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022069481062860149447\">https://www.upwork.com/jobs/~022069481062860149447</a></li>\n        <li>Upwork Job ID: 2069481062860149447</li>\n        <li>Last Price Increase: 2026-06-30</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/94133/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/94133/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/45","repository_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research","labels_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/45/labels{/name}","comments_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/45/comments","events_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/45/events","html_url":"https://github.com/zhangjiayang6835-cyber/ai-research/issues/45","id":4773688764,"node_id":"I_kwDOTGNm188AAAABHIi1vA","number":45,"title":"[BUG] Insecure Direct Object Reference (IDOR) v2 $25","user":{"login":"zhangjiayang6835-cyber","id":288065324,"node_id":"U_kgDOESuHLA","avatar_url":"https://avatars.githubusercontent.com/u/288065324?v=4","gravatar_i