https://api.github.com/users/joekaufmanexpensify/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893455829,"node_id":"MDU6TGFiZWwyODkzNDU1ODI5","url":"https://api.github.com/repos/Expensify/App/labels/Daily","name":"Daily","color":"eb6420","default":false,"description":"KSv2"},{"id":3033757191,"node_id":"MDU6TGFiZWwzMDMzNzU3MTkx","url":"https://api.github.com/repos/Expensify/App/labels/NewFeature","name":"NewFeature","color":"A52A2A","default":false,"description":"Something to build that is a new item."},{"id":3136662525,"node_id":"MDU6TGFiZWwzMTM2NjYyNTI1","url":"https://api.github.com/repos/Expensify/App/labels/Help%20Wanted","name":"Help Wanted","color":"CFC8F1","default":false,"description":"Apply this label when an issue is open to proposals by contributors"}],"state":"open","locked":false,"assignees":[{"login":"dannymcclain","id":7516624,"node_id":"MDQ6VXNlcjc1MTY2MjQ=","avatar_url":"https://avatars.githubusercontent.com/u/7516624?v=4","gravatar_id":"","url":"https://api.github.com/users/dannymcclain","html_url":"https://github.com/dannymcclain","followers_url":"https://api.github.com/users/dannymcclain/followers","following_url":"https://api.github.com/users/dannymcclain/following{/other_user}","gists_url":"https://api.github.com/users/dannymcclain/gists{/gist_id}","starred_url":"https://api.github.com/users/dannymcclain/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dannymcclain/subscriptions","organizations_url":"https://api.github.com/users/dannymcclain/orgs","repos_url":"https://api.github.com/users/dannymcclain/repos","events_url":"https://api.github.com/users/dannymcclain/events{/privacy}","received_events_url":"https://api.github.com/us