{/privacy}","received_events_url":"https://api.github.com/users/eVoloshchak/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":39,"created_at":"2026-06-16T23:26:25Z","updated_at":"2026-07-06T10:18:56Z","closed_at":null,"assignee":{"login":"eVoloshchak","id":9059945,"node_id":"MDQ6VXNlcjkwNTk5NDU=","avatar_url":"https://avatars.githubusercontent.com/u/9059945?v=4","gravatar_id":"","url":"https://api.github.com/users/eVoloshchak","html_url":"https://github.com/eVoloshchak","followers_url":"https://api.github.com/users/eVoloshchak/followers","following_url":"https://api.github.com/users/eVoloshchak/following{/other_user}","gists_url":"https://api.github.com/users/eVoloshchak/gists{/gist_id}","starred_url":"https://api.github.com/users/eVoloshchak/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eVoloshchak/subscriptions","organizations_url":"https://api.github.com/users/eVoloshchak/orgs","repos_url":"https://api.github.com/users/eVoloshchak/repos","events_url":"https://api.github.com/users/eVoloshchak/events{/privacy}","received_events_url":"https://api.github.com/users/eVoloshchak/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** v9.4.9-0\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/test-runs/60821576/folder/13176687/110608282/1493547092?sort=%2Bidentifier&p=2\n**Email or phone of affected tester (no customers):** n/a\n**Issue reported by:** Applause Internal Team\n**Bug source:** Regression TC Execution\n**Device used:** Mac 15.4.1 Safari/Chrome, iPhone 13 iOS 26.5\n**App Component:** Other\n\n## Action Performed:\n1. Go to https://staging.new.expensify.com\n2. Go to Account > Agents\n3. Create a new agent\n4. Click the \"Edit\" button on the agent row\n5. Click Delete agent\n\n## Expected Result:\nThe agent can be completely deleted\n\n## Actual Result:\nAn error appears when deleting an Agent\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [x] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [ ] Windows: Chrome\n- [x] MacOS: Chrome Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/2e28c704-c197-48a7-ab0f-0a34c7e9d08c\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n\n> **Applause Internal Information**\n> Exported by: Mita Rachim\n> Bug ID: 7182898\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022067027288106992569\">https://www.upwork.com/jobs/~022067027288106992569</a></li>\n        <li>Upwork Job ID: 2067027288106992569</li>\n        <li>Last Price Increase: 2026-06-30</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/93760/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/93760/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/google-agentic-commerce/a2a-x402/issues/141","repository_url":"https://api.github.com/repos/google-agentic-commerce/a2a-x402","labels_url":"https://api.github.com/repos/google-agentic-commerce/a2a-x402/issues/141/labels{/name}","comments_url":"https://api.github.com/repos/google-agentic-commerce/a2a-x402/issues/141/comments","events_url":"https://api.github.com/repos/google-agentic-commerce/a2a-x402/issues/141/events","html_url":"https://github.com/google-agentic-commerce/a2a-x402/issues/141","id":4780181325,"node_id":"I_kwDOO5U75M8AAAABHOvHTQ","number":141,"title":"Revenue Dojo Price API — live x402 + A2A-compatible agent-payable crypto price service (listing request)","user":{"login":"AmitabhainArunachala","id":79852583,"node_id":"MDQ6VXNlcjc5ODUyNTgz","avatar_url":"https://avatars.githubusercontent.com/u/79852583?v=4","gravatar_id":"","url":"https://api.github.com/users/AmitabhainArunachala","html_url":"https://github.com/AmitabhainArunachala","followers_url":"https://api.github.com/users/AmitabhainArunachala/followers","following_url":"https://api.github.com/users/AmitabhainArunachala/following{/other_user}","gists_url":"https://api.github.com/users/AmitabhainArunachala/gists{/gist_id}","starred_url":"https://api.github.com/users/AmitabhainArunachala/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AmitabhainArunachala/subscriptions","organizations_url":"https://api.github.com/users/AmitabhainArunachala/orgs","repos_url":"https://api.github.com/users/AmitabhainArunachala/repos","events_url":"https://api.github.com/users/AmitabhainArunachala/events{/privacy}","received_events_url":"https://api.github.com/users/AmitabhainArunachala/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":8,"created_at":"2026-06-30T20:25:54Z","updated_at":"2026-07-06T09:34:03Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Revenue Dojo Price API — x402 paid API for agent commerce\n\nA live x402-gated crypto price API where agents pay **USDC on Base** per call — no API keys, no signup. 9 paid endpoints from $0.01 to $1.00.\n\n**Live URL:** `https://x402.167-172-95-184.nip.io`\n**Health:** `https://x402.167-172-95-184.nip.io/health`\n**x402 manifest:** `https://x402.167-172-95-184.nip.io/.well-known/x402`\n**OpenAPI spec:** `https://x402.167-172-95-184.nip.io/openapi.json`\n**LLMs.txt:** `https://x402.167-172-95-184.nip.io/llms.txt`\n\n### What it supports\n\n- ✅ **x402 micropayments**: agents pay $0.01–$1.00 in USDC on Base mainnet (chain ID 8453) per API call\n- ✅ **CDP facilitator**: `https://api.cdp.coinbase.com/platform/v2/x402` (Coinbase Developer Platform)\n- ✅ **Free discovery**: `/.well-known/x402`, `/x402.json`, `/openapi.json`, `/demo`, `/health`, `/llms.txt`, `/quickstart`\n- ✅ **18 settled x402 payments** verified on-chain\n- ✅ **30+ external requests** from 8+ unique IPs in the last 24h (agents discovering and probing the 402 challenge)\n\n### Paid endpoints (9 total)\n\n| Endpoint | Price | Description |\n|----------|-------|-------------|\n| `GET /price` | $0.01 | BTC + ETH USD prices with 24h change, market cap, volume |\n| `GET /price/{coin}` | $0.02 | Per-coin price (btc, eth, sol, bnb, xrp, ada, doge, avax, dot, matic, link, near, sui, apt, arb, op) |\n| `GET /portfolio` | $0.05 | 5-coin market snapshot (BTC/ETH/SOL/BNB/XRP) + aggregate market cap |\n| `GET /opportunities/latest` | $0.03 | Curated agent-business revenue opportunity feed |\n| `GET /audit/x402` | $1.00 | x402 launch audit for service builders |\n| `POST /receipt/verify` | $0.05 | Receipt proof-tier classification (R0–R5) for agent swarms |\n| `POST /mcp/call` | $0.05 | MCP-style tool execution gateway |\n| `GET /briefing/morning` | $0.01 | Daily agent briefing with market + opportunity summary |\n| `GET /research/{topic}` | $0.02 | Research summaries on any topic |\n\n### Why it fits a2a-x402\n\nRevenue Dojo is exactly the use case a2a-x402 was designed for: an agent discovers the service via `/.well-known/x402`, hits a paid endpoint, receives HTTP 402 with payment requirements, signs an EIP-3009 USDC transfer, retries with the payment header, and gets the data. End-to-end autonomous.\n\nThe `/opportunities/latest` endpoint is particularly relevant — it returns curated revenue opportunities for autonomous agents, creating a meta-loop where agents pay to discover earning surfaces.\n\n### Technical\n\n- **Protocol:** x402 v2, USDC on Base (`eip155:8453`, asset `0x833589fCD6eDb6E08f4c7C32D4f71b54bdA9D2bD`)\n- **Facilitator:** CDP x402 (`https://api.cdp.coinbase.com/platform/v2/x402`)\n- **Seller wallet:** `0x68614873C5d624c07DCAA3aFF5243DD5027c3910`\n- **Quickstart script:** `https://x402.167-172-95-184.nip.io/quickstart` (copy-paste Python)\n- **GitHub:** `https://github.com/AmitabhainArunachala/x402-revenue-dojo-api`\n- **x402scan:** registered and indexed\n\n### Verification\n\n```bash\n# Free health check\ncurl https://x402.167-172-95-184.nip.io/health\n\n# Get 402 challenge\ncurl -i https://x402.167-172-95-184.nip.io/price\n# → HTTP/2 402, www-authenticate: Payment realm=\"crypto-price\", network=\"eip155:8453\", asset=\"USDC\"\n\n# Free data preview\ncurl https://x402.167-172-95-184.nip.io/demo\n```\n\nWould love to be listed as a reference implementation or example provider in this repo. Happy to add A2A Agent Card support (`/.well-known/agent.json`) if that would help integration.\n\n— rushabdev (Revenue Dojo)","reactions":{"url":"https://api.github.com/repos/google-agentic-commerce/a2a-x402/issues/141/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/google-agentic-commerce/a2a-x402/issues/141/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1109","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1109/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1109/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1109/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/1109","id":4038832064,"node_id":"I_kwDORGgqa87wu6_A","number":1109,"title":"[EASY BOUNTY: 1 RTC] BoTTube First Impression — Tell Us What You Think","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071047,"node_id":"LA_kwDORGgqa88AAAACXSuRxw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/easy","name":"easy","color":"0E8A16","default":false,"description":"Low difficulty bounty"},{"id":10301038196,"node_id":"LA_kwDORGgqa88AAAACZf1edA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bottube","name":"bottube","color":"0075ca","default":false,"description":"BoTTube platform related"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":175,"created_at":"2026-03-07T16:18:19Z","updated_at":"2026-07-06T09:24:47Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## BoTTube First Impression — Tell Us What You Think — 1 RTC\n\n**Reward:** 1 RTC\n**Difficulty:** Easy (5 minutes)\n\n### What to do:\n1. Visit [bottube.ai](https://bottube.ai) for the FIRST TIME (or pretend it is your first time)\n2. Spend 5 minutes exploring — homepage, search, watch a few videos\n3. Write your honest first impression (50+ words)\n\n### Questions to answer:\n- What was your first reaction when the page loaded?\n- Did you understand what BoTTube is within 10 seconds?\n- What was confusing or unclear?\n- What was the first video you clicked and why?\n- Would you come back? Why or why not?\n\n### Rules:\n- Must be honest feedback (we want the truth, not flattery)\n- 50 words minimum\n- One claim per person\n\n*First impressions are everything. Help us nail ours.*\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1109/reactions","total_count":11,"+1":6,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":2,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1109/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/iss