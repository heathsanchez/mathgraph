b.com/users/situchan/following{/other_user}","gists_url":"https://api.github.com/users/situchan/gists{/gist_id}","starred_url":"https://api.github.com/users/situchan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/situchan/subscriptions","organizations_url":"https://api.github.com/users/situchan/orgs","repos_url":"https://api.github.com/users/situchan/repos","events_url":"https://api.github.com/users/situchan/events{/privacy}","received_events_url":"https://api.github.com/users/situchan/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"lorretheboy","id":217769662,"node_id":"U_kgDODPrmvg","avatar_url":"https://avatars.githubusercontent.com/u/217769662?v=4","gravatar_id":"","url":"https://api.github.com/users/lorretheboy","html_url":"https://github.com/lorretheboy","followers_url":"https://api.github.com/users/lorretheboy/followers","following_url":"https://api.github.com/users/lorretheboy/following{/other_user}","gists_url":"https://api.github.com/users/lorretheboy/gists{/gist_id}","starred_url":"https://api.github.com/users/lorretheboy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lorretheboy/subscriptions","organizations_url":"https://api.github.com/users/lorretheboy/orgs","repos_url":"https://api.github.com/users/lorretheboy/repos","events_url":"https://api.github.com/users/lorretheboy/events{/privacy}","received_events_url":"https://api.github.com/users/lorretheboy/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":43,"created_at":"2026-05-27T15:50:20Z","updated_at":"2026-07-06T15:27:11Z","closed_at":null,"assignee":{"login":"luacmartins","id":22219519,"node_id":"MDQ6VXNlcjIyMjE5NTE5","avatar_url":"https://avatars.githubusercontent.com/u/22219519?v=4","gravatar_id":"","url":"https://api.github.com/users/luacmartins","html_url":"https://github.com/luacmartins","followers_url":"https://api.github.com/users/luacmartins/followers","following_url":"https://api.github.com/users/luacmartins/following{/other_user}","gists_url":"https://api.github.com/users/luacmartins/gists{/gist_id}","starred_url":"https://api.github.com/users/luacmartins/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/luacmartins/subscriptions","organizations_url":"https://api.github.com/users/luacmartins/orgs","repos_url":"https://api.github.com/users/luacmartins/repos","events_url":"https://api.github.com/users/luacmartins/events{/privacy}","received_events_url":"https://api.github.com/users/luacmartins/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Problem\n\nOn vertical Victory charts, the legend labels (e.g. \"This month\" / \"Last month\") overlap with the x-axis tick labels.\n\n![Screenshot 2026-05-27 at 1 34 29 PM](https://github.com/user-attachments/assets/210c71e3-840a-48c4-b8e5-c245ca9a19fa)\n\nThis was reported during review of [Victory Chart: Support horizontal bars](https://github.com/Expensify/App/pull/91659) and intentionally deferred as a follow-up:\n- Original report: https://github.com/Expensify/App/pull/91659#issuecomment-4554547564\n- Follow-up discussion: https://github.com/Expensify/App/pull/91659#issuecomment-4555671500\n\n## Analysis\n\nThe likely cause is that Victory Chart `padding` is not applied the same way as Victory Native `padding`. A similar spacing issue appears on the \"Monthly Spend\" chart, where the legend sits closer to the x-axis labels than in the [expected result](https://virtual-cfo-charts.netlify.app/).\n\n## Expected behavior\n\nLegend labels should not overlap x-axis tick labels on vertical charts. Spacing should match the reference charts on https://virtual-cfo-charts.netlify.app/.\n\n## Steps to reproduce\n\n1. Open a report with a vertical Victory chart that includes a legend near the bottom (e.g. \"This month\" / \"Last month\").\n2. Observe that the legend text overlaps the x-axis labels.\n\n## Solution\n\nAlign Victory Native chart padding/legend positioning with Victory Chart so vertical charts reserve enough space below the plot area for both x-axis labels and the legend.\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @situchan</details>\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022059994663451984832\">https://www.upwork.com/jobs/~022059994663451984832</a></li>\n        <li>Upwork Job ID: 2059994663451984832</li>\n        <li>Last Price Increase: 2026-07-06</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/91860/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/91860/timeline","performed_via_github_app":null,"state_reason":"reopened","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/chatmcp/mcpso/issues/1","repository_url":"https://api.github.com/repos/chatmcp/mcpso","labels_url":"https://api.github.com/repos/chatmcp/mcpso/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/chatmcp/mcpso/issues/1/comments","events_url":"https://api.github.com/repos/chatmcp/mcpso/issues/1/events","html_url":"https://github.com/chatmcp/mcpso/issues/1","id":2721891246,"node_id":"I_kwDONZpeys6iPMOu","number":1,"title":"Submit Your MCP Servers here","user":{"login":"idoubi","id":9711570,"node_id":"MDQ6VXNlcjk3MTE1NzA=","avatar_url":"https://avatars.githubusercontent.com/u/9711570?v=4","gravatar_id":"","url":"https://api.github.com/users/idoubi","html_url":"https://github.com/idoubi","followers_url":"https: