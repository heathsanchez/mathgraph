TOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"parent_issue_url":"https://api.github.com/repos/Expensify/App/issues/76128","issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"In an effort to improve the `#quality` of our app we started looking at INP (interaction to next pain) and looking at our slowest INPs we have [[data-sentry-label=“Receipt-Image”]](https://expensify.sentry.io/explore/traces/?environment=production&project=4510228107427840&query=span.description%3A%EF%80%8DContains%EF%80%8D%22%5Bdata-sentry-label%3D%5C%22Receipt-Image%5C%22%5D%22&statsPeriod=7d)\n\nLet's investigate why it is slow and fix it.\n\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @ChavdaSachin</details>\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: https://www.upwork.com/jobs/~022034008657026086159</li>\n        <li>Upwork Job ID: 2034008657026086159</li>\n        <li>Last Price Increase: 2026-06-16</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/85595/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/85595/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/chatmcp/mcpso/issues/1","repository_url":"https://api.github.com/repos/chatmcp/mcpso","labels_url":"https://api.github.com/repos/chatmcp/mcpso/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/chatmcp/mcpso/issues/1/comments","events_url":"https://api.github.com/repos/chatmcp/mcpso/issues/1/events","html_url":"https://github.com/chatmcp/mcpso/issues/1","id":2721891246,"node_id":"I_kwDONZpeys6iPMOu","number":1,"title":"Submit Your MCP Servers here","us