, decrease the number of allowable ESLint warnings [here](https://github.com/Expensify/App/blob/e7b5ac9401e2ae9b5c2c70ec513e8de6f5279d7d/package.json#L48) to equal the number of `Onyx.connect` references remaining in the code\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @tgolen / bfitzexpensify</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @DylanDylann</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @DylanDylann</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/66424/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/66424/timeline","performed_via_github_app":null,"state_reason":"reopened","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/85595","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/85595/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/85595/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/85595/events","html_url":"https://github.com/Expensify/App/issues/85595","id":4091109664,"node_id":"I_kwDOEQqHYc7z2WEg","number":85595,"title":"[$250] [INP] Slow Receipt-Image interaction","user":{"login":"rlinoz","id":5201282,"node_id":"MDQ6VXNlcjUyMDEyODI=","avatar_url":"https://avatars.githubusercontent.com/u/5201282?v=4","gravatar_id":"","url":"https://api.github.com/users/rlinoz","html_url":"https://github.com/rlinoz","followers_url":"https://api.github.com/users/rlinoz/followers","following_url":"https://api.github.com/users/rlinoz/following{/other_user}","gists_url":"https://api.github.com/users/rlinoz/gists{/gist_id}","starred_url":"https://api.github.com/users/rlinoz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rlinoz/subscriptions","organi