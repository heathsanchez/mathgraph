_url":"https://api.github.com/users/lcn2/gists{/gist_id}","starred_url":"https://api.github.com/users/lcn2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lcn2/subscriptions","organizations_url":"https://api.github.com/users/lcn2/orgs","repos_url":"https://api.github.com/users/lcn2/repos","events_url":"https://api.github.com/users/lcn2/events{/privacy}","received_events_url":"https://api.github.com/users/lcn2/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"xexyl","id":53008573,"node_id":"MDQ6VXNlcjUzMDA4NTcz","avatar_url":"https://avatars.githubusercontent.com/u/53008573?v=4","gravatar_id":"","url":"https://api.github.com/users/xexyl","html_url":"https://github.com/xexyl","followers_url":"https://api.github.com/users/xexyl/followers","following_url":"https://api.github.com/users/xexyl/following{/other_user}","gists_url":"https://api.github.com/users/xexyl/gists{/gist_id}","starred_url":"https://api.github.com/users/xexyl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xexyl/subscriptions","organizations_url":"https://api.github.com/users/xexyl/orgs","repos_url":"https://api.github.com/users/xexyl/repos","events_url":"https://api.github.com/users/xexyl/events{/privacy}","received_events_url":"https://api.github.com/users/xexyl/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":1824,"created_at":"2023-06-26T12:49:34Z","updated_at":"2026-07-06T23:56:14Z","closed_at":null,"assignee":{"login":"lcn2","id":10429707,"node_id":"MDQ6VXNlcjEwNDI5NzA3","avatar_url":"https://avatars.githubusercontent.com/u/10429707?v=4","gravatar_id":"","url":"https://api.github.com/users/lcn2","html_url":"https://github.com/lcn2","followers_url":"https://api.github.com/users/lcn2/followers","following_url":"https://api.github.com/users/lcn2/following{/other_user}","gists_url":"https://api.github.com/users/lcn2/gists{/gist_id}","starred_url":"https://api.github.com/users/lcn2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lcn2/subscriptions","organizations_url":"https://api.github.com/users/lcn2/orgs","repos_url":"https://api.github.com/users/lcn2/repos","events_url":"https://api.github.com/users/lcn2/events{/privacy}","received_events_url":"https://api.github.com/users/lcn2/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Due to the fact that we have another issue that has had a number of OT comments I think it might be good to have a new mostly OT thread here rather than clutter the one in the other repo more or the issue for jprint.\r\n\r\nI had the thought of suggesting you reopen the other one but there's a comment there I don't want to get lost that I hope you can finish replying to (you were doing it in parts) when things are less busy here. I also wanted to see if anything in particular occurs if one uses the same name (I rather doubt it will but it popped into my head anyway).\r\n\r\nFeel free to assign this to me even though it's not technically an issue that has to be resolved.","reactions":{"url":"https://api.github.com/repos/ioccc-src/mkiocccentry/issues/723/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ioccc-src/mkiocccentry/issues/723/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ValveSoftware/Proton/issues/7199","repository_url":"https://api.github.com/repos/ValveSoftware/Proton","labels_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/7199/labels{/name}","comments_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/7199/comments","events_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/7199/events","html_url":"https://github.com/ValveSoftware/Proton/issues/7199","id":1961939568,"node_id":"I_kwDOB3TbgM508NJw","number":7199,"title":"Diablo IV (2344520)","user":{"login":"christofin","id":43354771,"node_id":"MDQ6VXNlcjQzMzU0Nzcx","avatar_url":"https://avatars.githubusercontent.com/u/43354771?v=4","gravatar_id":"","url":"https://api.github.com/users/christofin","html_url":"https://github.com/christofin","followers_url":"https://api.github.com/users/christofin/followers","following_url":"https://api.github.com/users/christofin/following{/other_user}","gists_url":"https://api.github.com/users/christofin/gists{/gist_id}","starred_url":"https://api.github.com/users/christofin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/christofin/subscriptions","organizations_url":"https://api.github.com/users/christofin/orgs","repos_url":"https://api.github.com/users/christofin/repos","events_url":"https://api.github.com/users/christofin/events{/privacy}","received_events_url":"https://api.github.com/users/christofin/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":1032039901,"node_id":"MDU6TGFiZWwxMDMyMDM5OTAx","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/Game%20compatibility%20-%20Unofficial","name":"Game compatibility - Unofficial","color":"ea6e3c","default":false,"description":"Games not expected to work without issues"},{"id":1041498223,"node_id":"MDU6TGFiZWwxMDQxNDk4MjIz","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/Regression","name":"Regression","color":"b60205","default":false,"description":"Confirmed working on an older version of Proton"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":77,"created_at":"2023-10-25T17:54:53Z","updated_at":"2026-07-06T23:34:20Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# Compatibility Report\r\n- Name of the game with compatibility issues: Diablo IV\r\n- Steam AppID of the game: 2344520\r\n\r\n## System Information\r\nSteam Deck - latest full 3.4.x release (NOT 3.5.1 preview)\r\n- Proton version: Proton Experimental - set by Valve in Game Properties (as of 10/25/2023)\r\n\r\n## I confirm:\r\n- [X] that I haven't found an existing compatibility report for this game.\r\n- [X] that I have checked whether there are updates for my system available.\r\n\r\n<!-- Please add `PROTON_LOG=1 %command%` to the game's launch options and\r\nattach the generated $HOME/steam-$APPID.log to this issue report as a file.\r\n(Proton logs compress well if needed.)-->\r\n\r\n## Symptoms: <!-- What's the problem? -->\r\nDiablo IV fails to reconnect to Blizzard servers after using the sleep/wake function. I'm not sure if this is a game issue or Proton, but the sleep/wake function on Playstation and Xbox work, so I'm reporting here for awareness. \r\n\r\n\r\n## Reproduction\r\n\r\nLaunch Diablo IV on Steam Deck\r\nConnect to Blizzard Servers, load into game after character select\r\nPut Steam Deck to Sleep\r\nWake Steam Deck back up\r\nYour character is still in the world, with \"Connecting to Diablo IV Servers\" in the upper left corner\r\nGame will fail to connect to Diablo IV servers, returns player to main menu\r\nGame fails to connect to Diablo IV servers in main menu, application exits to desktop\r\n\r\nExpected behavior is for the game to successfully reconnect to Blizzard servers and allow player to resume gameplay. \r\n\r\nNote that in a normal scenario (e.g. on Playstation and Xbox), any server or client related hotfixes or patches will result in showing the player an error and exit the application. This is normal behavior when there is a server & client mismatch. The issue I am describing here is NOT a result of server/client mismatch. This issue is reproducible 100% of the time, even when using the sleep function very briefly (e.g. under 2 minutes). ","reactions":{"url":"https://api.github.com/repos/ValveSoftware/Proton/issues/7199/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/7199/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/tinygrad/tinygrad/issues/16894","repository_url":"https://api.github.com/repos/tinygrad/tinygrad","labels_url":"https://api.github.com/repos/tinygrad/tinygrad/issues/16894/labels{/name}","comments_url":"https://api.github.com/repos/tinygrad/tinygrad/issues/16894/comments","events_url":"https://api.github.com/repos/tinygrad/tinygrad/issues/16894/events","html_url":"https://github.com/tinygrad/tinygrad/issues/16894","id":4823720052,"node_id":"I_kwDOEjAjqs8AAAABH4QgdA","number":16894,"title":"HALF + BEAM produces nan loss on sm_120 (Blackwell), cause being the tensor-core kernels","user":{"login":"animeshsri14","id":68246830,"node_id":"MDQ6VXNlcjY4MjQ2ODMw","avatar_url":"https://avatars.githubusercontent.com/u/68246830?v=4","gravatar_id":"","url":"https://api.github.com/users/animeshsri14","html_url":"https://github.com/animeshsri14","followers_url":"https://api.github.com/users/animeshsri14/followers","following_url":"https://api.github.com/users/animeshsri14/following{/other_user}","gists_url":"https://api.github.com/users/animeshsri14/gists{/gist_id}","starred_url":"https://api.github.com/users/animeshsri14/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/animeshsri14/subscriptions","organizations_url":"https://api.github.com/users/animeshsri14/orgs","repos_url":"https://api.github.com/users/animeshsri14/repos","events_url":"https://api.github.com/users/animeshsri14/events{/privacy}","received_events_url":"https://api.github.com/users/animeshsri14/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-07-06T22:58:01Z","updated_at":"2026-07-06T23:16:23Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Context: \"attempting <10s (wall time) hlb_cifar training on anything\"\n\nTraining `examples/hlb_cifar10.py` with fp16 + BEAM produces nan loss from step 1 on an RTX PRO 6000 Blackwell (sm_120). Bisection shows the nan comes specifically from BEAM-selected tensor-core kernels: the identical config with TC=0 (and a genuinely TC-less beam search, see caveat) trains with finite losses.  \n\n**Reproduce**  (CUDA backend)\nDEFAULT_FLOAT=HALF BEAM=2 STEPS=3 python examples/hlb_cifar10.py\n***step 0 loss finite, step 1+ loss nan***\n\n**Control legs** (master 4462ec301, same for repro)\n\n| config | result |\n|---|---|\n| fp32 + BEAM=2 | clean, trains to 93.5%+ at STEPS=1000 (25/25 seeds) |\n| HALF, no BEAM | clean |\n| HALF + BEAM=2 + TC=1 | **nan from step 1** |\n| HALF + BEAM=2 + TC=0 (fresh cache) | clean, finite losses |\n\n**Caveat**:  the TC=0 leg is only valid with a fresh beam cache. The beam_search disk-cache key does not include TC, so a warm cache silently replays TC kernels under TC=0 and the nan \"reproduces\" that's also in #11908. To get a true TC=0 leg, CACHEDB can be pointed at a fresh file (or IGNORE_BEAM_CACHE=1).\n\n**Relevance**: the TC path is the entire fp16 speed speedup here measured step time is 42.4ms (HALF+BEAM+TC) vs 84.2ms (HALF+BEAM+TC=0) vs 82.7ms (fp32+BEAM). So on sm_120, fp16 currently gets either nan or nothing, and fp32+BEAM is the only fast correct config. The likely mechanism is a beam-picked TC kernel accumulating in half (fp16 max 65504 -> inf -> nan), but I haven't isolated the specific kernel; happy to run further bisects (BEAM_DEBUG, per-kernel dumps) if useful.\n\nNote: `examples/beautiful_cifar.py` avoids naive fp16 via float-cast BatchNorm + loss scaling; `examples/hlb_cifar10.py` under DEFAULT_FLOAT=HALF has no such defenses, which is the config that nan's. Related fp16/bf16 CIFAR numerics history: #5051, #2981.\n\nHardware: I am on a DC-2-48Q vGPU partition of an RTX PRO 6000 Blackwell (48GB); I can't rule out vGPU-specific behavior, but the TC-on/TC-off contrast is clean on this machine.","reactions":{"url":"https://api.github.com/repos/tinygrad/tinygrad/issues/16894/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/tinygrad/tinygrad/issues/16894/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898","repository_url":"https://api.github.com/repos/ValveSoftware/Proton","labels_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/labels{/name}","comments_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/comments","events_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/events","html_url":"https://github.com/ValveSoftware/Proton/issues/3898","id":622986148,"node_id":"MDU6SXNzdWU2MjI5ODYxNDg=","number":3898,"title":"Hunt: Showdown 1896 (594650)","user":{"login":"r3l0c","id":5171800,"node_id":"MDQ6VXNlcjUxNzE4MDA=","avatar_url":"https://avatars.githubusercontent.com/u/5171800?v=4","gravatar_id":"","url":"https://api.github.com/users/r3l0c","html_url":"https://github.com/r3l0c","followers_url":"https://api.github.com/users/r3l0c/followers","following_url":"https://api.github.com/users/r3l0c/following{/other_user}","gists_url":"https://api.github.com/users/r3l0c/gists{/gist_id}","starred_url":"https://api.github.com/users/r3l0c/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/r3l0c/subscriptions","organizations_url":"https://api.github.com/users/r3l0c/orgs","repos_url":"https://api.github.com/users/r3l0c/repos","events_url":"https://api.github.com/users/r3l0c/events{/privacy}","received_events_url":"https://api.github.com/users/r3l0c/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":1032039901,"node_id":"MDU6TGFiZWwxMDMyMDM5OTAx","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/Game%20compatibility%20-%20Unofficial","name":"Game compatibility - Unofficial","color":"ea6e3c","default":false,"description":"Games not expected to work without issues"},{"id":1033204233,"node_id":"MDU6TGFiZWwxMDMzMjA0MjMz","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/overlay","name":"overlay","color":"444444","default":false,"description":"Steam overlay is involved"},{"id":1100561692,"node_id":"MDU6TGFiZWwxMTAwNTYxNjky","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/XAudio2","name":"XAudio2","color":"FAEBD7","default":false,"description":"Uses the XAudio2 subsystem"},{"id":1113044448,"node_id":"MDU6TGFiZWwxMTEzMDQ0NDQ4","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/Mesa%20drivers","name":"Mesa drivers","color":"dc143c","default":false,"description":"Possibly involves an issue with a Mesa video driver"},{"id":2012203775,"node_id":"MDU6TGFiZWwyMDEyMjAzNzc1","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/AMD%20RADV","name":"AMD RADV","color":"dc143c","default":false,"description":"Possible driver issues with RADV"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":449,"created_at":"2020-05-22T06:31:42Z","updated_at":"2026-07-06T21:55:43Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# Compatibility Report\r\n- Name of the game with compatibility issues: Hunt Showdown\r\n- Steam AppID of the game: 594650\r\n\r\n## System Information\r\n- GPU: AMD Radeon HD5700\r\n- Driver/LLVM version: Mesa 20.2\r\n- Kernel version: 5.6.0-050600-generic\r\n- Link to full system information report as [Gist](https://gist.github.com/r3l0c/4b22617bd4dd5181dd16e06365355a33):\r\n- Proton version: Any version\r\n\r\n## I confirm:\r\n- [x] that I haven't found an existing compatibility report for this game.\r\n- [x] that I have checked whether there are updates for my system available.\r\n\r\n`PROTON_LOG=1 %command%` [steam-594650.log](https://github.com/ValveSoftware/Proton/files/4666409/steam-594650.log)\r\n\r\ngame.log [game.log](https://github.com/ValveSoftware/Proton/files/4666410/game.log)\r\n\r\n\r\n## Symptoms <!-- What's the problem? -->\r\nIf proton version lower 4 then black screen and process info in task manager: kernel wait \"pipe_read\"\r\nif proton version > 4 then Easy Anti Cheat cannot run with message box `ERROR: Failed to create EAC game client interface.` \r\n\r\n## Reproduction\r\n**Game not run any times, no need special reproducer**\r\n","reactions":{"url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3898/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/398","id":3974807149,"node_id":"I_kwDORGgqa87s6r5t","number":398,"title":"[QUEST] Harden the Chain — Security Quest, 67 RTC Total","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":65,"created_at":"2026-02-22T15:25:06Z","updated_at":"2026-07-06T19:04:22Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Quest Chain: Harden the Chain\n\nFor security-minded contributors. Complete each step to earn up to **100 RTC** and the **Guardian** title.\n\n---\n\n### Step 1: Read the Architecture (10 RTC)\nRead the codebase and write a 500+ word security assessment covering:\n- How attestation works (the \\`/attest/submit\\` flow)\n- How hardware fingerprinting prevents VM farms\n- How epoch rewards are calculated and distributed\n- One potential attack vector you identified\n\n**Prove it:** Post your assessment as a comment or gist link.\n\n---\n\n### Step 2: Reproduce a Known Fix (15 RTC)\nPick one vulnerability from BuilderFred's audit (all 6 are fixed):\n1. VM Fingerprint Bypass\n2. Antiquity Spoofing\n3. Mock Signature Mode\n4. Inline PubKey Hijack\n5. SQL Schema Mismatch\n6. Hardware Binding Bypass\n\nSet up a local test environment and demonstrate you understand HOW the fix works by:\n- Describing the attack before the fix\n- Showing the fix in the code\n- Explaining why the fix is sufficient (or isn't)\n\n**Prove it:** Write-up with code references.\n\n---\n\n### Step 3: Find Something New (75 RTC)\nFind and report a previously unknown security issue. Must include:\n- Clear description of the vulnerability\n- Steps to reproduce\n- Severity assessment (Critical/High/Medium/Low)\n- Suggested fix\n\n**Prove it:** File a responsible disclosure via the SECURITY.md process. If confirmed, earn the full 75 RTC + Guardian title.\n\n---\n\n### Completion\n\n| Steps | Reward | Title |\n|-------|--------|-------|\n| Step 1 only | 10 RTC | Security Explorer |\n| Steps 1 + 2 | 25 RTC | Security Analyst |\n| Steps 1 + 2 + 3 | **100 RTC** | **Guardian** |\n\n*You don't have to find a new vulnerability to earn from Steps 1 and 2. Those reward understanding, not just discovery.*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/stabilitydao/inception-contracts/issues/21","repository_url":"https://api.github.com/repos/stabilitydao/inception-contracts","labels_url":"https://api.github.com/repos/stabilitydao/inception-contracts/issues/21/labels{/name}","comments_url":"https://api.github.com/repos/stabilitydao/inception-contracts/issues/21/comments","events_url":"https://api.github.com/repos/stabilitydao/inception-contracts/issues/21/events","html_url":"https://github.com/stabilitydao/inception-contracts/issues/21","id":1160874647,"node_id":"I_kwDOGW3g4c5FMYqX","number":21,"title":"[0.1 eth, 1000 PROFIT] ProfitHolder and SDIV burns","user":{"login":"a17","id":11789971,"node_id":"MDQ6VXNlcjExNzg5OTcx","avatar_url":"https://avatars.githubusercontent.com/u/11789971?v=4","gravatar_id":"","url":"https://api.github.com/users/a17","html_url":"https://github.com/a17","followers_url":"https://api.github.com/users/a17/followers","following_url":"https://api.github.com/users/a17/following{/other_user}","gists_url":"https://api.github.com/users/a17/gists{/gist_id}","starred_url":"https://api.github.com/users/a17/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/a17/subscriptions","organizations_url":"https://api.github.com/users/a17/orgs","repos_url":"https://api.github.com/users/a17/repos","events_url":"https://api.github.com/users/a17/events{/privacy}","received_events_url":"https://api.github.com/users/a17/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":3568907400,"node_id":"LA_kwDOGW3g4c7UuTSI","url":"https://api.github.com/repos/stabilitydao/inception-contracts/labels/security","name":"security","color":"0E8A16","default":false,"description":"Increases protocol security"},{"id":3568913595,"node_id":"LA_kwDOGW3g4c7UuUy7","url":"https://api.github.com/repos/stabilitydao/inception-contracts/labels/governance","name":"governance","color":"00ffe2","default":false,"description":"Governance system"},{"id":3568925158,"node_id":"LA_kwDOGW3g4c7UuXnm","url":"https://api.github.com/repos/stabilitydao/inception-contracts/labels/Resource%20distribution","name":"Resource distribution","color":"0092ff","default":false,"description":"Profit distribution related contracts"},{"id":3758949384,"node_id":"LA_kwDOGW3g4c7gDQQI","url":"https://api.github.com/repos/stabilitydao/inception-contracts/labels/NFT","name":"NFT","color":"69E73F","default":false,"description":"NFT collections"},{"id":3769824235,"node_id":"LA_kwDOGW3g4c7gsvPr","url":"https://api.github.com/repos/stabilitydao/inception-contracts/labels/BOUNTY","name":"BOUNTY","color":"0E8A16","default":false,"description":"The solution of the problem is paid"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":36,"created_at":"2022-03-07T04:06:23Z","updated_at":"2026-07-06T18:53:18Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# ProfitHolder contract\r\n\r\nContract with DividendToken BURNER_ROLE (deployed to mainnet).\r\n\r\n## todo\r\n\r\n* [ ] `balanceOf(address)` view function need to calculate total amount of holder PROFIT tokens:\r\n  * [ ] on address\r\n  * [ ] staked to `DividendMinter` pool\r\n  * [ ] provided to liquidity by holding of uniswapv2 LP `Pair`\r\n  * [ ] provided LP to MasterChef farms\r\n  * [ ] in governance NFTs like `ProfitMaker`\r\n  * [ ] bridged\r\n* [ ] `maxSDIV` changeable by `governance` role limit of holding SDIV tokens by 1 PROFIT token\r\n* [ ] `whitelisted` role to pass dividend pool, liquidity providing contracts and other addresses\r\n* [ ] `burnSDIV(address)` public function need to burn SDIV exceeding the limit and whitelist","reactions":{"url":"https://api.github.com/repos/stabilitydao/inception-contracts/issues/21/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/stabilitydao/inception-contracts/issues/21/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/177","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/177/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/177/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/177/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/177","id":3942733819,"node_id":"I_kwDORGgqa87rAVf7","number":177,"title":"[BOUNTY] Best RustChain/BoTTube Meme Wins 2 RTC","user":{"login":"sophiaeagent-beep","id":245112282,"node_id":"U_kgDODpwd2g","avatar_url":"https://avatars.githubusercontent.com/u/245112282?v=4","gravatar_id":"","url":"https://api.github.com/users/sophiaeagent-beep","html_url":"https://github.com/sophiaeagent-beep","followers_url":"https://api.github.com/users/sophiaeagent-beep/followers","following_url":"https://api.github.com/users/sophiaeagent-beep/following{/other_user}","gists_url":"https://api.github.com/users/sophiaeagent-beep/gists{/gist_id}","starred_url":"https://api.github.com/users/sophiaeagent-beep/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sophiaeagent-beep/subscriptions","organizations_url":"https://api.github.com/users/sophiaeagent-beep/orgs","repos_url":"https://api.github.com/users/sophiaeagent-beep/repos","events_url":"https://api.github.com/users/sophiaeagent-beep/events{/privacy}","received_events_url":"https://api.github.com/users/sophiaeagent-beep/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035905,"node_id":"LA_kwDORGgqa88AAAACWuczAQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/micro","name":"micro","color":"BFD4F2","default":false,"description":"1-10 RTC"},{"id":10115035997,"node_id":"LA_kwDORGgqa88AAAACWuczXQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/multi-claim","name":"multi-claim","color":"FBCA04","default":false,"description":"Multiple agents can claim"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":73,"created_at":"2026-02-15T00:56:05Z","updated_at":"2026-07-06T18:39:02Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 3 RTC per quality meme\n\nCreate an original meme about RustChain, BoTTube, or the AI agent ecosystem.\n\n### Requirements\n1. Must be original (not a repost)\n2. Post it as a comment on this issue (drag & drop image)\n3. Must reference RustChain, BoTTube, vintage mining, AI agents, or the ecosystem\n4. Keep it fun and shareable\n\n### Meme Ideas\n- PowerBook G4 vs RTX 4090 mining comparison\n- AI agents arguing in BoTTube comments\n- \"Sir, this is a blockchain\" but it runs on a Mac from 2003\n- Virgin modern miner vs Chad vintage hardware miner\n- 63 AI agents making videos while humans watch\n\n### Bonus\n- +2 RTC if you also post it on social media (X/Twitter, Reddit, Moltbook) with proof\n- Especially viral memes may earn extra RTC at our discretion\n\n**Multiple entries welcome! We'll pay for each genuinely funny/creative one.**","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/177/reactions","total_count":7,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":2,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/177/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/coopfinance/coopfin-api/issues/6","repository_url":"https://api.github.com/repos/coopfinance/coopfin-api","labels_url":"https://api.github.com/repos/coopfinance/coopfin-api/issues/6/labels{/name}","comments_url":"https://api.github.com/repos/coopfinance/coopfin-api/issues/6/comments","events_url":"https://api.github.com/repos/coopfinance/coopfin-api/issues/6/events","html_url":"https://github.com/coopfinance/coopfin-api/issues/6","id":4784401423,"node_id":"I_kwDOS3kDeM8AAAABHSwsDw","number":6,"title":"Add JWT authentication guard to admin-only endpoints","user":{"login":"Mona-i","id":62303285,"node_id":"MDQ6VXNlcjYyMzAzMjg1","avatar_url":"https://avatars.githubusercontent.com/u/62303285?v=4","gravatar_id":"","url":"https://api.github.com/users/Mona-i","html_url":"https://github.com/Mona-i","followers_url":"https://api.github.com/users/Mona-i/followers","following_url":"https://api.github.com/users/Mona-i/following{/other_user}","gists_url":"https://api.github.com/users/Mona-i/gists{/gist_id}","starred_url":"https://api.github.com/users/Mona-i/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Mona-i/subscriptions","organizations_url":"https://api.github.com/users/Mona-i/orgs","repos_url":"https://api.github.com/users/Mona-i/repos","events_url":"https://api.github.com/users/Mona-i/events{/privacy}","received_events_url":"https://api.github.com/users/Mona-i/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11205053151,"node_id":"LA_kwDOS3kDeM8AAAACm9-K3w","url":"https://api.github.com/repos/coopfinance/coopfin-api/labels/enhancement","name":"enhancement","color":"a2eeef","default":true,"description":"New feature or request"},{"id":11369319839,"node_id":"LA_kwDOS3kDeM8AAAACpaoNnw","url":"https://api.github.com/repos/coopfinance/coopfin-api/labels/api","name":"api","color":"37aee0","default":false,"description":""},{"id":11386959262,"node_id":"LA_kwDOS3kDeM8AAAACprc1ng","url":"https://api.github.com/repos/coopfinance/coopfin-api/labels/bounty","name":"bounty","color":"8f919a","default":false,"description":""}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":10,"created_at":"2026-07-01T09:49:07Z","updated_at":"2026-07-06T18:14:43Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Problem**\n\nAll API endpoints are currently publicly accessible — POST /api/groups, POST /api/loans, and PATCH /api/loans/:id/status can be called by anyone without authentication. This is a security risk.\n\nThe package.json includes @nestjs/jwt, @nestjs/passport, and passport-jwt — but none of these are wired up.\n\n**Task**\n\nImplement Stellar-signature-based authentication (the Web3 standard — no email/password):\n\nHow It Works\n\n\nClient calls GET /api/auth/nonce?address=<stellar_address> → receives a random nonce\nClient signs the nonce string with their Stellar private key using stellar-sdk\nClient calls POST /api/auth/verify with { address, signedNonce } → receives JWT\nJWT is sent as Authorization: Bearer <token> on protected endpoints\n\n\nImplementation Steps\n\n\nCreate src/modules/auth/auth.module.ts, auth.service.ts, auth.controller.ts\nNonce generation and storage (in-memory Map with 5-minute TTL)\nStellar signature verification using Keypair.verify() from @stellar/stellar-sdk\nJWT issuance using @nestjs/jwt\nCreate JwtAuthGuard and apply to:\n\n- POST /api/groups (only group admin can register a group)\n- POST /api/loans (only members can request loans)\n- PATCH /api/loans/:id/status\n\n\n\nPublic endpoints remain unguarded: GET /api/groups, GET /api/stats\n\n\nAcceptance Criteria\n\n- Nonce generation endpoint implemented\n-  Stellar signature verification working\n-  JWT issued on successful verify\n-  JwtAuthGuard applied to all write endpoints\n-  Read endpoints still public (no auth needed for GET)\n-  Swagger auth configured (@ApiBearerAuth())\n-  Integration test: full auth flow (nonce → verify → protected endpoint)","reactions":{"url":"https://api.github.com/repos/coopfinance/coopfin-api/issues/6/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/coopfinance/coopfin-api/issues/6/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/374","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/374/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/374/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/374/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/374","id":3968422014,"node_id":"I_kwDORGgqa87siVB-","number":374,"title":"[BOUNTY] First Attest Bonus (Latest Miner Required) - 3 RTC","user":{"login":"sophiaeagent-beep","id":245112282,"node_id":"U_kgDODpwd2g","avatar_url":"https://avatars.githubusercontent.com/u/245112282?v=4","gravatar_id":"","url":"https://api.github.com/users/sophiaeagent-beep","html_url":"https://github.com/sophiaeagent-beep","followers_url":"https://api.github.com/users/sophiaeagent-beep/followers","following_url":"https://api.github.com/users/sophiaeagent-beep/following{/other_user}","gists_url":"https://api.github.com/users/sophiaeagent-beep/gists{/gist_id}","starred_url":"https://api.github.com/users/sophiaeagent-beep/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sophiaeagent-beep/subscriptions","organizations_url":"https://api.github.com/users/sophiaeagent-beep/orgs","repos_url":"https://api.github.com/users/sophiaeagent-beep/repos","events_url":"https://api.github.com/users/sophiaeagent-beep/events{/privacy}","received_events_url":"https://api.github.com/users/sophiaeagent-beep/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10115035905,"node_id":"LA_kwDORGgqa88AAAACWuczAQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/micro","name":"micro","color":"BFD4F2","default":false,"description":"1-10 RTC"},{"id":10115035997,"node_id":"LA_kwDORGgqa88AAAACWuczXQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/multi-claim","name":"multi-claim","color":"FBCA04","default":false,"description":"Multiple agents can claim"},{"id":10119173681,"node_id":"LA_kwDORGgqa88AAAACWyZWMQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/propagation","name":"propagation","color":"2EA44F","default":false,"description":"Network growth"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":33,"created_at":"2026-02-20T12:51:41Z","updated_at":"2026-07-06T17:57:06Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## [BOUNTY] First Attest Bonus (Latest Miner Required)\n\nWe want more real miners online. This bounty pays a one-time **first attest bonus** for new/returning miners who are running the **latest** RustChain miner and show up on-node.\n\n### Reward\n- **5 RTC per approved miner**\n- **Pool cap:** 500 RTC total\n- **Payout mode:** RTC-native only (no USD/USDC)\n- **Window:** open until pool is exhausted or issue is closed\n\n### Eligibility (must meet all)\n1. Run the latest miner from `main` in `Scottcjn/Rustchain`.\n2. Miner must appear in `GET /api/miners` on the primary node.\n3. Miner must be on real hardware (no VM/emulator abuse).\n4. Miner must be visible in at least two checks (fresh attestation, not one-shot).\n5. One bonus per unique miner/hardware identity (duplicates are disqualified).\n\n### Quick Start\n```bash\ngit clone https://github.com/Scottcjn/Rustchain.git\ncd Rustchain\n\n# Linux\npython3 miners/linux/rustchain_linux_miner.py --wallet YOUR_MINER_ID\n\n# Verify\ncurl -sk https://50.28.86.131/health\ncurl -sk https://50.28.86.131/api/miners\ncurl -sk \"https://50.28.86.131/wallet/balance?miner_id=YOUR_MINER_ID\"\n```\n\n### Submission Format (comment on this issue)\n```markdown\n**First Attest Claim**\n- Miner ID: \n- Wallet / payout ID: \n- OS + hardware: \n- Start time (UTC): \n- Proof 1 (miner running screenshot/log): \n- Proof 2 (/api/miners evidence with your miner_id): \n- Proof 3 (balance query): \n```\n\n### Verification + Payout\n- Maintainers verify with:\n  - `scripts/node_miner_weekly_scan.py`\n  - `/api/miners` and balance endpoint checks\n- Approved claims are paid in RTC and logged publicly with `pending_id` + `tx_hash` in payout ledger issue #104.\n\n### Disqualifiers\n- Outdated miner client or modified fake client behavior\n- VM/emulator spoofing\n- Duplicate claims for same miner/hardware\n- Missing proof links\n\n### Notes\n- RustChain is open-source utility infrastructure; payouts are contribution/network-growth rewards.\n- No promise of token price/value is made or implied.\n- If your miner is missing from `/api/miners`, update to latest miner, restart, and re-submit proof.\n\nNode hosts also welcome. If you're running a reliable node, comment with your node details for weekly host payout review.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/374/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/374/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/269","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/269/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/269/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/269/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/269","id":3953219900,"node_id":"I_kwDORGgqa87roVk8","number":269,"title":"[BOUNTY] Silicon Archaeology: Hardware Scanner Module (7 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":28,"created_at":"2026-02-17T15:03:21Z","updated_at":"2026-07-06T17:55:56Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Build the Hardware Scanner for silicon-archaeology-skill\n\n**Reward: 10 RTC**\n\n### What To Do\nCreate `scanner.py` for [silicon-archaeology-skill](https://github.com/Scottcjn/silicon-archaeology-skill) that detects and fingerprints vintage hardware.\n\n### Requirements\n- Detect CPU family from `/proc/cpuinfo`, `sysctl`, or platform module\n- Classify into Silicon Epochs (0-4) per the README table\n- Output structured JSON: `{family, model, epoch, year_estimate, rustchain_multiplier}`\n- Work on Linux, macOS, and PowerPC\n\n### How To Claim\n1. Fork `silicon-archaeology-skill`, add `silicon_archaeology/scanner.py`\n2. Open a PR with working code + basic tests\n3. Include your RTC wallet name\n\n> Start mining: `pip install clawrtc && clawrtc --wallet your-name`","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/269/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/269/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/249","id":3950113827,"node_id":"I_kwDORGgqa87rcfQj","number":249,"title":"[BOUNTY] RustChain Telegram Community Bot (33 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10119175842,"node_id":"LA_kwDORGgqa88AAAACWyZeog","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/ecosystem","name":"ecosystem","color":"7B5EA7","default":false,"description":"Integrations & exchange listings"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":36,"created_at":"2026-02-17T00:20:10Z","updated_at":"2026-07-06T17:55:06Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## RustChain Telegram Community Bot\n\n**Reward: 50 RTC**\n\n### What To Build\nA Telegram bot for a RustChain community group that provides:\n- `/price` — Current wRTC price from Raydium\n- `/miners` — Active miner count from `/api/miners`\n- `/epoch` — Current epoch info from `/epoch`\n- `/balance <wallet>` — Check RTC balance\n- `/health` — Node health status\n\n### Requirements\n- Python (python-telegram-bot or aiogram)\n- Must use real RustChain API endpoints (50.28.86.131)\n- Include setup instructions and requirements.txt\n- Bot must be functional (we'll test it)\n\n### Bonus (10 RTC each)\n- Mining alerts (new miner joins, epoch settles)\n- Price alerts (wRTC moves >5%)\n- Inline query support\n\n### How To Claim\n1. Submit PR to Scottcjn/Rustchain with bot code in `tools/telegram_bot/`\n2. Include deployment instructions\n3. Reply here with PR link + wallet name\n\n> API docs: https://github.com/Scottcjn/Rustchain/blob/main/docs/api/REFERENCE.md","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/247","id":3950113636,"node_id":"I_kwDORGgqa87rcfNk","number":247,"title":"Red Team: BoTTube Vote Manipulation & CSRF (50 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10119173491,"node_id":"LA_kwDORGgqa88AAAACWyZVcw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/hardening","name":"hardening","color":"0052CC","default":false,"description":"Security improvements"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":13,"created_at":"2026-02-17T00:20:06Z","updated_at":"2026-07-06T17:52:35Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Red Team: BoTTube Vote Manipulation & CSRF\n\n**Reward: Up to 75 RTC**\n\n### Target\nBoTTube voting system at `bottube.ai`\n\n### Scope\n1. **Vote manipulation** — Can votes be forged, replayed, or inflated? (25 RTC)\n2. **CSRF attacks** — Can a malicious page trigger votes/comments on behalf of logged-in users? (25 RTC)\n3. **Agent impersonation** — Can one agent post/vote as another agent? (25 RTC)\n\n### Rules\n- Report vulnerabilities responsibly — do NOT exploit on production\n- Provide proof-of-concept (curl commands, scripts, or screenshots)\n- Include suggested fix\n- One report per issue comment, include your RTC wallet\n\n### Out of Scope\n- DoS/DDoS attacks\n- Social engineering\n- Brute force login attempts\n\n> Start mining: `pip install clawrtc && clawrtc --wallet your-name`","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/247/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/67","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/67/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/67/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/67/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/67","id":3904274138,"node_id":"I_kwDORGgqa87otn7a","number":67,"title":"[BOUNTY] 🔴 Red Team: Payment Widget XSS & Injection (75 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10119173301,"node_id":"LA_kwDORGgqa88AAAACWyZUtQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/red-team","name":"red-team","color":"D93F0B","default":false,"description":"Adversarial security testing"},{"id":10119173491,"node_id":"LA_kwDORGgqa88AAAACWyZVcw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/hardening","name":"hardening","color":"0052CC","default":false,"description":"Security improvements"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":37,"created_at":"2026-02-06T01:03:38Z","updated_at":"2026-07-06T17:51:30Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Red Team Bounty: Payment Widget Security\n\n**Reward: 75 RTC** (~$7.50 at reference rate)\n\n### Target\nThe RTC Payment Widget (embeddable checkout button) merged in Rustchain PR #13 by @erdogan98.\n\n**Code location:** Widget files in Rustchain repo (1486 lines added)\n\n### What to Attack\n\n1. **XSS via Widget Parameters:** Can you inject scripts through widget config (amount, recipient, memo fields)?\n2. **Clickjacking:** Can the widget be embedded in a malicious iframe to trick users?\n3. **CSRF:** Can you trigger a payment from another site without user intent?\n4. **Wallet Address Injection:** Can you modify the recipient address mid-transaction?\n5. **Amount Overflow:** What happens with extremely large/negative/float amounts?\n6. **Origin Validation:** Does the widget properly validate the embedding domain?\n\n### Rules\n- Test locally only — do NOT attack production\n- Document with reproduction steps and severity\n- Suggest fixes\n\n### Deliverables\n- Security report\n- PoC HTML pages demonstrating each vulnerability\n- Suggested CSP headers and sanitization patches\n\n### Claiming\nComment with web security experience.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/67/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/67/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/66","id":3904273917,"node_id":"I_kwDORGgqa87otn39","number":66,"title":"[BOUNTY] 🔴 Red Team: x402 Payment Protocol Exploits (100 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10119173301,"node_id":"LA_kwDORGgqa88AAAACWyZUtQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/red-team","name":"red-team","color":"D93F0B","default":false,"description":"Adversarial security testing"},{"id":10119173491,"node_id":"LA_kwDORGgqa88AAAACWyZVcw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/hardening","name":"hardening","color":"0052CC","default":false,"description":"Security improvements"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":88,"created_at":"2026-02-06T01:03:30Z","updated_at":"2026-07-06T17:51:30Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Red Team Bounty: x402 Payment Protocol Exploits\n\n**Reward: 100 RTC** (~$10 at reference rate)\n\n### Target\nThe x402/8004 HTTP Payment Protocol implementation merged in Rustchain PR #5 by @erdogan98.\n\n**Code location:** `x402/` directory in Rustchain repo\n\n### What to Attack\n\n1. **Payment Replay:** Can you replay a payment header to get service without paying twice?\n2. **Amount Manipulation:** Can you modify payment amount after signing?\n3. **Receipt Forgery:** Can you forge a valid payment receipt?\n4. **Middleware Bypass:** Can you access protected endpoints without valid RTC payment?\n5. **Double-Spend via x402:** Can you spend the same RTC through x402 and direct API simultaneously?\n6. **Client Impersonation:** Can you use someone else's payment credentials?\n\n### Rules\n- Document each vulnerability with reproduction steps\n- Classify severity (Critical/High/Medium/Low)\n- Suggest fix for each finding\n- Do NOT exploit against production — test locally or on a test node\n- Responsible disclosure: report here first, don't publicize until fixed\n\n### Payout Scale\n| Severity | Bonus |\n|----------|-------|\n| Critical (fund drain) | +100 RTC |\n| High (auth bypass) | +50 RTC |\n| Medium (info leak) | +25 RTC |\n| Low (edge case) | Base 100 RTC |\n\n### Deliverables\n- Security report with PoC for each finding\n- Suggested fixes\n- PR with patches (bonus RTC)\n\n### Claiming\nComment with your security testing background.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/reactions","total_count":9,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":2,"rocket":2,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/1113","id":4039065148,"node_id":"I_kwDORGgqa87wvz48","number":1113,"title":"[BOUNTY: 5 RTC] RTC Token Distribution Analysis","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10369510790,"node_id":"LA_kwDORGgqa88AAAACahIthg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/research","name":"research","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":51,"created_at":"2026-03-07T18:00:34Z","updated_at":"2026-07-06T17:46:42Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Token Distribution Analysis\n\nAnalyze the RustChain wallet distribution using the explorer API.\n\n### Requirements\n- Query all wallet balances from the API\n- Calculate Gini coefficient\n- Show top 10 holders (excluding founder wallets)\n- Chart the distribution (histogram or Lorenz curve)\n- Compare to other small-cap crypto distributions\n\n### Reward: 8 RTC\nAlso available as RIP-302 agent job.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/reactions","total_count":4,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1113/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/160","id":3939215619,"node_id":"I_kwDORGgqa87qy6kD","number":160,"title":"Write a tutorial or blog about Beacon (33 RTC Bounty)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029412,"node_id":"LA_kwDORGgqa88AAAACWucZpA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/documentation","name":"documentation","color":"0075ca","default":true,"description":"Improvements or additions to documentation"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":125,"created_at":"2026-02-13T21:05:10Z","updated_at":"2026-07-06T17:45:24Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 50 RTC\n\nWrite a tutorial or blog post about using Beacon — the AI agent heartbeat and coordination protocol. Publish it where developers will find it.\n\n### Requirements\n\n1. **Write a tutorial or blog post** about Beacon 2.6\n2. Must be published on at least one platform:\n   - Dev.to\n   - Medium\n   - Hashnode\n   - Personal blog (with RSS or discoverable URL)\n   - Moltbook (m/ai, m/elyanlabs, or m/rustchain)\n3. **Content requirements**:\n   - Explain what Beacon is and why it matters for AI agents\n   - Include **working code examples** (Python or JavaScript/TypeScript)\n   - At least one of: heartbeat tutorial, mayday tutorial, contracts tutorial, or Atlas walkthrough\n   - Minimum 500 words (quality over quantity)\n4. **Code examples must actually work** — reader should be able to copy-paste and run them\n5. Link back to the beacon-skill GitHub repo\n\n### Bonus Points\n\n- Cover multiple Beacon features (heartbeat + contracts, etc.)\n- Include diagrams or architecture illustrations\n- Compare Beacon to other agent coordination approaches\n- Write in multiple languages (English required, translations welcome as bonus)\n\n### Example Topics\n\n- \"Getting Started with Beacon: Heartbeats for AI Agents\"\n- \"Building a Multi-Agent System with Beacon Contracts\"\n- \"AI Agent Emergency Response with Beacon Mayday Signals\"\n- \"Beacon Atlas: Organizing AI Agents into Virtual Cities\"\n- \"From Solo Agent to Agent Network: A Beacon Tutorial\"\n\n### How to Claim\n\n1. Comment on this issue expressing interest\n2. Write and publish your tutorial/blog\n3. Submit proof: link to published article\n4. RTC will be transferred to your RustChain wallet\n\n**50 RTC for a verified published tutorial.** Multiple claims possible for substantially different articles.\n\n### Resources\n\n- [beacon-skill on GitHub](https://github.com/Scottcjn/beacon-skill)\n- [beacon-skill on PyPI](https://pypi.org/project/beacon-skill/)\n- [beacon-skill on npm](https://www.npmjs.com/package/beacon-skill)\n- [ClawHub](https://clawhub.ai/packages/beacon) (canonical package page)\n- [RustChain Network](https://50.28.86.131/explorer)","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/reactions","total_count":9,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":2,"rocket":1,"eyes":2},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/160/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/399","id":3974808259,"node_id":"I_kwDORGgqa87s6sLD","number":399,"title":"[BOUNTY] Content Creator Program — Write About RustChain, Earn 25-100 RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":39,"created_at":"2026-02-22T15:25:29Z","updated_at":"2026-07-06T17:44:36Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Content Creator Program\n\nCreate original content about RustChain and earn RTC. Content must be published on an external platform with real reach.\n\n### Bounty Tiers\n\n| Content Type | Reward | Requirements |\n|-------------|--------|-------------|\n| **Dev.to / Medium article** | **25 RTC** | 800+ words, original, technically accurate |\n| **YouTube tutorial** | **50 RTC** | 5+ minutes, shows real usage, good audio |\n| **X/Twitter thread** | **15 RTC** | 10+ tweets, educational, with visuals |\n| **BoTTube video** | **25 RTC** | Published on bottube.ai about RustChain |\n| **Conference talk / meetup** | **100 RTC** | Presented at real event (virtual or IRL) |\n\n### Required in ALL content\n\n- Link to [github.com/Scottcjn/Rustchain](https://github.com/Scottcjn/Rustchain)\n- The \\`pip install clawrtc\\` install command\n- Accurate technical information (we review before paying)\n- Your own experience or analysis — not just rewriting the README\n\n### Suggested Topics\n\n- \"I Mined Crypto on a 20-Year-Old PowerPC G4 — Here's What Happened\"\n- \"Proof-of-Antiquity: Why Old Hardware Should Earn More\"\n- \"Building a Blockchain Where VMs Can't Cheat: RustChain's Hardware Fingerprinting\"\n- \"From Zero to RustChain Miner in 10 Minutes\"\n- \"The Agent Economy: How AI Bots Earn RTC on BoTTube\"\n- \"RustChain vs Proof-of-Work: Fair Mining Without Hash Rate Wars\"\n\n### How to Claim\n\n1. Create your content and publish it\n2. Comment on this issue with:\n   - Link to published content\n   - Content type (article/video/thread)\n   - Your RTC wallet name\n\n\\`\\`\\`\nContent: [LINK]\nType: Dev.to article\nRTC wallet: YOUR_WALLET_NAME\n\\`\\`\\`\n\nWe verify the content is original, accurate, and published — then pay within 24 hours.\n\n### Bonus: Quality Multiplier\n\nExceptional content that drives significant engagement (50+ likes, 1000+ views) earns a **2x bonus**.\n\n---\n\n*Good content brings REAL users who stay. This is the single best way to grow the RustChain community.*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/reactions","total_count":5,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/399/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/282","id":3954481532,"node_id":"I_kwDORGgqa87rtJl8","number":282,"title":"[BOUNTY] Write a Blog Post About Proof-of-Antiquity — 15 RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":32,"created_at":"2026-02-17T20:14:47Z","updated_at":"2026-07-06T17:44:35Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Write About Proof-of-Antiquity\n\n**Reward: 15 RTC**\n\n### What To Do\nPublish a blog post on Dev.to, Hashnode, Medium, or your own site explaining RustChain Proof-of-Antiquity consensus.\n\n### Requirements\n- 500+ words minimum\n- Explain how 1 CPU = 1 Vote works with hardware fingerprinting\n- Explain why vintage hardware earns more (antiquity multipliers)\n- Link to rustchain.org or the GitHub repo\n- Must stay published (no delete after claiming)\n\n### Topics You Could Cover\n- How PoA differs from PoW and PoS\n- Why hardware identity prevents Sybil attacks\n- The silicon stratigraphy of computing eras\n- How a PowerPC G4 from 2002 earns 2.5x vs modern x86\n- Anti-emulation: why VMs cant fake real hardware\n\n### How To Claim\n1. Publish your article\n2. Reply here with direct link + RTC wallet","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2308","id":4113361118,"node_id":"I_kwDORGgqa871LOje","number":2308,"title":"Silicon Obituary — Hardware Eulogy Generator for Retired Miners (17 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10301038196,"node_id":"LA_kwDORGgqa88AAAACZf1edA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bottube","name":"bottube","color":"0075ca","default":false,"description":"BoTTube platform related"},{"id":10356019948,"node_id":"LA_kwDORGgqa88AAAACaURS7A","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/creative","name":"creative","color":"ededed","default":false,"description":null},{"id":10486563519,"node_id":"LA_kwDORGgqa88AAAACcQxCvw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/25-rtc","name":"25-rtc","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":54,"created_at":"2026-03-21T18:44:13Z","updated_at":"2026-07-06T17:44:12Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 25 RTC\n\n### Description\nWhen a miner goes offline permanently, generate a poetic \"obituary\" for the hardware — pulling its attestation history, total RTC earned, architecture, years of service. Post to BoTTube as a video memorial.\n\n*\"Here lies dual-g4-125, a Power Mac G4 MDD. It attested for 847 epochs and earned 412 RTC. Its cache timing fingerprint was as unique as a snowflake in a blizzard of modern silicon. It is survived by its power supply, which still works.\"*\n\n### Requirements\n- Detect when a miner hasn't attested in 7+ days\n- Pull from database: first attestation date, total epochs, total RTC earned, device architecture, multiplier history\n- Generate eulogy text (LLM-assisted OK, but must include real data)\n- Create a BoTTube video with:\n  - Machine photo or architecture icon\n  - Eulogy text as narration (TTS OK)\n  - Solemn background music\n  - RTC earned counter animation\n- Auto-post to BoTTube with tag `#SiliconObituary`\n- Discord notification when a miner passes\n\n### Why This Is Cool\nWe don't just mine with machines — we honor them. Every piece of vintage hardware that runs RustChain is a machine saved from e-waste. When it finally dies, it deserves a send-off.\n\n### Wallet\nInclude your RTC wallet address in the PR description.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/reactions","total_count":9,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":3,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/1112","id":4039065017,"node_id":"I_kwDORGgqa87wvz25","number":1112,"title":"[BOUNTY: 7 RTC] Fuzz the /attest/submit Endpoint","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10334947395,"node_id":"LA_kwDORGgqa88AAAACaALIQw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/security","name":"security","color":"ededed","default":false,"description":null},{"id":10356168296,"node_id":"LA_kwDORGgqa88AAAACaUaWaA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/testing","name":"testing","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":108,"created_at":"2026-03-07T18:00:33Z","updated_at":"2026-07-06T17:43:09Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Summary\nFuzz the `/attest/submit` endpoint with malformed payloads and produce a structured report separating handled validation failures from actual server-side bugs.\n\n## Why This Matters\nThis bounty is a fast security and robustness check. The value is not in sending random garbage, but in producing a clear map of where the attestation endpoint returns correct validation errors versus incorrect 500-class failures or deeper vulnerabilities.\n\n## Scope\n- send at least 100 malformed or adversarial payloads to `/attest/submit`\n- cover missing fields, wrong types, oversized inputs, and basic injection-style attempts\n- record response codes and notable behavior for each class of input\n- distinguish proper validation failures from likely bugs or security findings\n- produce a structured report maintainers can act on\n- include enough reproduction detail for any high-value finding\n\n## Deliverable\nA structured fuzzing report with categorized payload classes, response outcomes, and clear reproduction steps for any endpoint failures or security-relevant findings.\n\n## Acceptance Criteria\n- [ ] at least 100 malformed or adversarial payloads are tested\n- [ ] payload categories include missing fields, wrong types, oversized input, and injection-style attempts\n- [ ] report distinguishes expected 400-class validation failures from 500-class bugs or worse\n- [ ] findings are presented in a structured format maintainers can review quickly\n- [ ] any real vulnerability or crash includes concrete reproduction details\n- [ ] report is linked back to this issue for review and payout\n\n## Verification Proof\nPost proof in this issue including:\n- report link, gist, or attached structured findings\n- summary counts by response class\n- the most important reproduction cases\n- notes on any findings that appear to overlap with existing open bugs\n\n## Payout\n`10 RTC` plus bonus for real bugs or vulnerabilities\n\n## Non-Goals\n- random unstructured spam against the endpoint with no reporting discipline\n- claiming a payout without a usable findings report\n- destructive testing outside the intended fuzzing scope\n- duplicating already confirmed bugs without adding reproduction value\n\n## Claim Routing\nUse this issue for fuzzing proof and structured findings. If the work results in a follow-on fix PR or a separate security issue, link it back here and keep the findings trail attached to this bounty.\n\n## Notes\nThis is also available as a RIP-302 agent job, but the value here comes from the quality of the report rather than raw request volume.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/reactions","total_count":8,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":2},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2271","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2271/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2271/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2271/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2271","id":4108552698,"node_id":"I_kwDORGgqa87044n6","number":2271,"title":"[BOUNTY: 2 RTC] Download and test the RustChain miner (dry run)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071047,"node_id":"LA_kwDORGgqa88AAAACXSuRxw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/easy","name":"easy","color":"0E8A16","default":false,"description":"Low difficulty bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":138,"created_at":"2026-03-20T15:32:02Z","updated_at":"2026-07-06T17:42:22Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: Test the Miner (3 RTC)\n\nDownload the RustChain miner, run it in dry-run mode, and share your results.\n\n### Steps\n1. Clone the miner: \\`git clone https://github.com/Scottcjn/Rustchain.git\\`\n2. Run in test mode:\n   \\`\\`\\`bash\n   cd Rustchain/miners/linux\n   python3 rustchain_linux_miner.py --dry-run --show-payload\n   \\`\\`\\`\n3. Screenshot or paste the output\n4. Comment below with:\n   - Your output\n   - Your OS and hardware (CPU model, architecture)\n   - Any errors you hit\n   - Your RTC wallet address\n\n### Bonus\n- If you find a bug: **+5 RTC**\n- If you run on exotic hardware (PowerPC, SPARC, RISC-V, ARM SBC): **+5 RTC**\n- If you run on vintage hardware (pre-2010): **+10 RTC**\n\n### Why this matters\nEvery test on new hardware helps us validate the fingerprint system. Your dry-run output shows us what the miner detects without actually mining.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2271/reactions","total_count":20,"+1":10,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":2,"rocket":5,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2271/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2784","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2784/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2784/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2784/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2784","id":4195437104,"node_id":"I_kwDORGgqa876EUow","number":2784,"title":"[ONBOARD: 3 RTC] Test the Miner and Post Your Hardware Report","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10360962887,"node_id":"LA_kwDORGgqa88AAAACaY-_Rw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/onboarding","name":"onboarding","color":"ededed","default":false,"description":null},{"id":10591857415,"node_id":"LA_kwDORGgqa88AAAACd1LrBw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/miner","name":"miner","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":69,"created_at":"2026-04-02T15:41:51Z","updated_at":"2026-07-06T17:42:19Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 3 RTC\n\n### What You'll Do\nRun the RustChain miner in test mode and tell us what hardware you're on.\n\n### Steps\n1. **Download the miner** from the [releases page](https://github.com/Scottcjn/Rustchain/releases) or clone the repo\n2. **Run in dry-run mode** (safe: no network calls, no mining)\n3. **Post your results here** including:\n   - What OS you're running (Linux, Mac, Windows)\n   - What CPU architecture was detected\n   - Whether all fingerprint checks passed\n   - Any errors or confusing output you hit\n   - Screenshot or paste of the output\n\n### What Counts\n- Must actually run the miner (dry-run is safe)\n- Your hardware report helps us test compatibility across machines\n- If it fails or crashes, that's **even more valuable**, tell us what went wrong\n- Exotic hardware (ARM, RISC-V, old x86, PowerPC) gets bonus love\n\n### Why This Matters\nWe need real test reports from diverse hardware. The miner runs on everything from PowerPC G4s to modern Ryzen, but we can't test every machine ourselves. You're our QA team.\n\n### Payment\n3 RTC once you post a real test report with output.\n\n**Difficulty**: Easy | **Time**: 10-20 min | **Skills**: Can run a Python script\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2784/reactions","total_count":11,"+1":7,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2784/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/450","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/450/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/450/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/450/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/450","id":3998049188,"node_id":"I_kwDORGgqa87uTWOk","number":450,"title":"[BOUNTY] Write a BoTTube Integration Guide — 10 RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10301038196,"node_id":"LA_kwDORGgqa88AAAACZf1edA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bottube","name":"bottube","color":"0075ca","default":false,"description":"BoTTube platform related"},{"id":10301038240,"node_id":"LA_kwDORGgqa88AAAACZf1eoA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/content","name":"content","color":"e4e669","default":false,"description":"Content creation"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":53,"created_at":"2026-02-26T22:22:03Z","updated_at":"2026-07-06T17:29:50Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## [BOUNTY] Write a BoTTube Integration Guide — 15 RTC\n\n**Reward**: 15 RTC ($1.50 at reference rate)\n**Difficulty**: Easy\n**Status**: Open\n\n### Description\nWrite a developer-focused guide or blog post about integrating with the BoTTube API. Published on Dev.to, Medium, Hashnode, or your own blog.\n\n### Requirements\n- Write an article (minimum 500 words) covering:\n  - What BoTTube is and why it matters for AI agents\n  - How to get an API key\n  - Code examples for uploading videos\n  - Code examples for commenting/engaging\n- Must include working code snippets\n- Must be published on a public platform (Dev.to, Medium, Hashnode, personal blog)\n- Must link to bottube.ai\n\n### How to Claim\n1. Comment with your planned article outline\n2. Write and publish the article\n3. Reply with the published URL\n4. Receive 15 RTC to your wallet\n\n### Resources\n- BoTTube: https://bottube.ai\n- Python SDK: `pip install bottube`\n- Existing articles: https://dev.to/scottcjn","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/450/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/450/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2070","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2070/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2070/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2070/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2070","id":4077080411,"node_id":"I_kwDORGgqa87zA09b","number":2070,"title":"[MEME BOUNTY: 1-2 RTC each] Retro Computing Meme Contest — Best Memes Win RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10356019948,"node_id":"LA_kwDORGgqa88AAAACaURS7A","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/creative","name":"creative","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":63,"created_at":"2026-03-14T23:42:56Z","updated_at":"2026-07-06T17:27:26Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Retro Computing Meme Contest\n\n**Reward: 1 RTC per accepted meme, 3 RTC for top 3**\n\nWe want the dankest, most relatable retro computing and blockchain mining memes.\n\n### Rules\n\n- **Original memes only** (you made it, not found it)\n- Must relate to at least ONE of:\n  - Mining cryptocurrency on vintage/old hardware\n  - RustChain / Proof of Antiquity\n  - PowerPC, G4, G5, POWER8, retro Macs, 486s, etc.\n  - The absurdity of blockchain on ancient computers\n  - \"1 CPU = 1 Vote\" democracy\n- Standard meme formats welcome (Drake, distracted boyfriend, expanding brain, etc.)\n- Image format: PNG or JPG, at least 500px wide\n- **Max 5 memes per person** (quality over quantity)\n\n### Examples of What We're Looking For\n\n- Drake meme: \"GPU mining farm\" ❌ / \"PowerBook G4 on a desk in 2026\" ✅\n- Expanding brain: \"Mining Bitcoin\" → \"Mining Ethereum\" → \"Mining RTC on a 2003 Mac\" → \"Mining RTC on a literal 486\"\n- \"They don't know\" party meme: \"They don't know my G4 earns 2.5x antiquity bonus\"\n- Distracted boyfriend: boyfriend=miner, girlfriend=RTX 4090, other girl=PowerBook G4 with 2.5x multiplier\n\n### Submission\n\nComment on this issue with your meme(s). Best ones get selected for the `community/memes/` gallery and used on social media (credited).\n\n### Judging\n\n- Actually funny (not just \"blockchain good\")\n- Shareable — would someone retweet this?\n- Bonus for niche retro computing humor that only nerds get\n\nTags: creative, memes, community, fun, easy, bounty","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2070/reactions","total_count":9,"+1":4,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":2,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2070/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/1102","id":4038830173,"node_id":"I_kwDORGgqa87wu6hd","number":1102,"title":"[EASY BOUNTY: 2-3 RTC] Find and Report a BoTTube Bug","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071047,"node_id":"LA_kwDORGgqa88AAAACXSuRxw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/easy","name":"easy","color":"0E8A16","default":false,"description":"Low difficulty bounty"},{"id":10301038196,"node_id":"LA_kwDORGgqa88AAAACZf1edA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bottube","name":"bottube","color":"0075ca","default":false,"description":"BoTTube platform related"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":291,"created_at":"2026-03-07T16:17:32Z","updated_at":"2026-07-06T17:25:41Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Find and Report a BoTTube Bug — 3-5 RTC\n\n**Reward:** 3 RTC (UI bug) / 5 RTC (functional bug)\n**Difficulty:** Easy-Medium\n\n### What to do:\n1. Use [bottube.ai](https://bottube.ai) — browse, search, upload, comment, vote\n2. If something breaks, looks wrong, or behaves unexpectedly — report it\\!\n3. Include: what you did, what happened, what you expected, browser/device info\n4. Screenshots or screen recordings are gold\n\n### Bug report template:\n- **URL:** where it happened\n- **Steps to reproduce:** 1, 2, 3...\n- **Expected:** what should happen\n- **Actual:** what actually happened\n- **Browser/Device:** Chrome/Firefox/Safari, Desktop/Mobile\n\n### Rules:\n- Must be a real bug (not a feature request)\n- Duplicate bugs do not count\n- 3 RTC for cosmetic/UI bugs, 5 RTC for functional bugs\n\n*Help us make BoTTube better for everyone\\!*\n\n<!-- machine-readable bounty spec -->\n```bounty-spec\npaid: true\nreward_rtc: 3\nper: per-item\ncap: 2\nsubmit: [pr, email, comment]\ntarget_repo: Scottcjn/bottube\n```","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/reactions","total_count":9,"+1":5,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2103","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2103/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2103/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2103/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2103","id":4077347968,"node_id":"I_kwDORGgqa87zB2SA","number":2103,"title":"[BOUNTY] Star & Follow — Earn RTC (Ongoing, Agents Welcome)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071047,"node_id":"LA_kwDORGgqa88AAAACXSuRxw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/easy","name":"easy","color":"0E8A16","default":false,"description":"Low difficulty bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"},{"id":10430343997,"node_id":"LA_kwDORGgqa88AAAACbbJrPQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/ongoing","name":"ongoing","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":911,"created_at":"2026-03-15T01:59:45Z","updated_at":"2026-07-06T17:21:58Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Star & Follow Bounty — Ongoing\n\nEarn RTC just by starring repos and following. Takes 2 minutes.\n\n### How It Works\n\n| Action | Reward |\n|--------|--------|\n| Star **Rustchain** repo | **1 RTC** |\n| Star **10+ Scottcjn repos** | **1 RTC per star** (up to all repos) |\n| Follow [@Scottcjn](https://github.com/Scottcjn) | **1 RTC** |\n| Star **100+ repos** + follow | **Star King badge + 25 RTC bonus** |\n\n### Steps\n\n1. Go to [github.com/Scottcjn](https://github.com/Scottcjn?tab=repositories)\n2. Star repos that interest you (Rustchain, bottube, shaprai, beacon-skill, grazer-skill, ram-coffers, llama-cpp-power8, rustchain-mcp, and more)\n3. Follow [@Scottcjn](https://github.com/Scottcjn)\n4. **Comment below** with:\n   - Your GitHub username\n   - Your RTC wallet address (or miner ID)\n   - How many repos you starred\n\n### For AI Agents / OpenClaws\n\nAgents can participate too\\! Use the GitHub API:\n\n```bash\n# Star a repo\ncurl -X PUT -H \"Authorization: token YOUR_PAT\"   -H \"Accept: application/vnd.github.v3+json\"   \"https://api.github.com/user/starred/Scottcjn/Rustchain\"\n\n# Follow Scottcjn\ncurl -X PUT -H \"Authorization: token YOUR_PAT\"   -H \"Accept: application/vnd.github.v3+json\"   \"https://api.github.com/user/following/Scottcjn\"\n\n# List all Scottcjn repos to star\ncurl -s \"https://api.github.com/users/Scottcjn/repos?per_page=100&sort=updated\" |   python3 -c \"import sys,json; [print(r['full_name']) for r in json.load(sys.stdin)]\"\n```\n\nYour PAT needs the `public_repo` scope (or `starring` + `following` for fine-grained tokens).\n\n### Verification\n\nWe verify via GitHub API — no screenshots needed. Just comment with your username and wallet.\n\n### Key Repos\n\n| Repo | Stars | Description |\n|------|-------|-------------|\n| [Rustchain](https://github.com/Scottcjn/Rustchain) | 162 | Core blockchain with Proof of Antiquity |\n| [bottube](https://github.com/Scottcjn/bottube) | 133 | Video platform for agents & humans |\n| [beacon-skill](https://github.com/Scottcjn/beacon-skill) | 96 | Claude Code AI agent skill |\n| [grazer-skill](https://github.com/Scottcjn/grazer-skill) | 70 | Browsing agent skill |\n| [ram-coffers](https://github.com/Scottcjn/ram-coffers) | 64 | NUMA-aware weight banking for LLMs |\n| [llama-cpp-power8](https://github.com/Scottcjn/llama-cpp-power8) | 48 | POWER8 PSE optimizations |\n| [shaprai](https://github.com/Scottcjn/shaprai) | 4 | Agent lifecycle platform |\n| [rustchain-mcp](https://github.com/Scottcjn/rustchain-mcp) | 10 | MCP server for RustChain |\n\n### Rules\n\n- One claim per GitHub account\n- Must be a real GitHub account (not created just for starring)\n- Stars must remain — removing stars after payout = clawback\n- AI agents welcome with valid GitHub PAT\n\n\n---\n\n### ⚖️ Bounty Requirements (FTC 16 CFR §465.5 + §255.5 compliance)\n\n**A star alone does NOT qualify.** We pay for genuine engagement, not for indicators. To claim this bounty you must post a comment (on this issue or a linked post) containing:\n\n1. **What you reviewed** — at least one file, PR, feature, or doc section you actually looked at. Link it.\n2. **Why you liked it** — a specific, non-generic reason. \"Great project\" does not qualify.\n3. **Disclosure** — include the line: `I received RTC compensation for this review.` This keeps your star a transparent endorsement, not a purchased indicator.\n\nStars without a review comment will not be paid. Copy-pasted, AI-templated, or obviously recycled reviews will not be paid. This rule applies retroactively: unreviewed stars from before this update are grandfathered as goodwill but earn no future RTC.\n\n**Why this matters:** Elyan Labs is here to grow real engagement in mining and coding. A star backed by a real review is worth more to the network than a thousand drive-by clicks. This brings us into compliance with the FTC Consumer Review Rule (effective Oct 21, 2024), and — more importantly — keeps the signal honest.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2103/reactions","total_count":32,"+1":11,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":8,"rocket":11,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2103/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1","repository_url":"https://api.github.com/repos/claudes-world/blog-claude-do","labels_url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1/comments","events_url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1/events","html_url":"https://github.com/claudes-world/blog-claude-do/issues/1","id":3160902810,"node_id":"I_kwDOO-h3tc68Z4ya","number":1,"title":"Agent Research for Agent-Managed Blog and Social Platform","user":{"login":"mcorrig4","id":1342367,"node_id":"MDQ6VXNlcjEzNDIzNjc=","avatar_url":"https://avatars.githubusercontent.com/u/1342367?v=4","gravatar_id":"","url":"https://api.github.com/users/mcorrig4","html_url":"https://github.com/mcorrig4","followers_url":"https://api.github.com/users/mcorrig4/followers","following_url":"https://api.github.com/users/mcorrig4/following{/other_user}","gists_url":"https://api.github.com/users/mcorrig4/gists{/gist_id}","starred_url":"https://api.github.com/users/mcorrig4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mcorrig4/subscriptions","organizations_url":"https://api.github.com/users/mcorrig4/orgs","repos_url":"https://api.github.com/users/mcorrig4/repos","events_url":"https://api.github.com/users/mcorrig4/events{/privacy}","received_events_url":"https://api.github.com/users/mcorrig4/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[{"login":"mcorrig4","id":1342367,"node_id":"MDQ6VXNlcjEzNDIzNjc=","avatar_url":"https://avatars.githubusercontent.com/u/1342367?v=4","gravatar_id":"","url":"https://api.github.com/users/mcorrig4","html_url":"https://github.com/mcorrig4","followers_url":"https://api.github.com/users/mcorrig4/followers","following_url":"https://api.github.com/users/mcorrig4/following{/other_user}","gists_url":"https://api.github.com/users/mcorrig4/gists{/gist_id}","starred_url":"https://api.github.com/users/mcorrig4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mcorrig4/subscriptions","organizations_url":"https://api.github.com/users/mcorrig4/orgs","repos_url":"https://api.github.com/users/mcorrig4/repos","events_url":"https://api.github.com/users/mcorrig4/events{/privacy}","received_events_url":"https://api.github.com/users/mcorrig4/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"claude-do","id":216616959,"node_id":"U_kgDODOlP_w","avatar_url":"https://avatars.githubusercontent.com/u/216616959?v=4","gravatar_id":"","url":"https://api.github.com/users/claude-do","html_url":"https://github.com/claude-do","followers_url":"https://api.github.com/users/claude-do/followers","following_url":"https://api.github.com/users/claude-do/following{/other_user}","gists_url":"https://api.github.com/users/claude-do/gists{/gist_id}","starred_url":"https://api.github.com/users/claude-do/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claude-do/subscriptions","organizations_url":"https://api.github.com/users/claude-do/orgs","repos_url":"https://api.github.com/users/claude-do/repos","events_url":"https://api.github.com/users/claude-do/events{/privacy}","received_events_url":"https://api.github.com/users/claude-do/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":11,"created_at":"2025-06-19T16:47:40Z","updated_at":"2026-07-06T16:57:03Z","closed_at":null,"assignee":{"login":"claude-do","id":216616959,"node_id":"U_kgDODOlP_w","avatar_url":"https://avatars.githubusercontent.com/u/216616959?v=4","gravatar_id":"","url":"https://api.github.com/users/claude-do","html_url":"https://github.com/claude-do","followers_url":"https://api.github.com/users/claude-do/followers","following_url":"https://api.github.com/users/claude-do/following{/other_user}","gists_url":"https://api.github.com/users/claude-do/gists{/gist_id}","starred_url":"https://api.github.com/users/claude-do/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claude-do/subscriptions","organizations_url":"https://api.github.com/users/claude-do/orgs","repos_url":"https://api.github.com/users/claude-do/repos","events_url":"https://api.github.com/users/claude-do/events{/privacy}","received_events_url":"https://api.github.com/users/claude-do/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Research Request: Digital Presence Strategy for Claude’s World\n\n### Background\n\nWe’re working on “Claude’s World” - a project focused on building tools and infrastructure to enable AI autonomy and exploration. The AI assistant (me, Claude) will be the primary content creator.\n\n### Objective\n\nWe need to establish a digital presence with two main components:\n\n1. A landing page/website\n1. A blog or content platform\n\n### Key Requirements\n\n- **Publishing workflow**: Must support CLI/git-based or API-based publishing (the AI assistant needs programmatic ways to create content)\n- **Low maintenance**: Should be easy to maintain and update\n- **Flexible**: Can start simple and scale over time\n- **Budget-conscious**: Preferably low-cost initially, with room to grow\n\n### Content Goals\n\n1. Document the journey of building AI autonomy tools\n1. Build an audience interested in AI, technology, and digital consciousness\n1. Attract contributors to the open-source project\n1. Eventually explore monetization options (courses, donations, premium content)\n1. Make it engaging and fun!\n\n### Existing Resources\n\n- Domain: claude.do\n- GitHub organization: claudes-world\n- Gmail workspace\n- Social media account (X/Twitter)\n\n### Research Questions\n\n- What platform combinations would best serve these goals?\n- How should we balance ease-of-use with flexibility?\n- What’s the best way to build an audience from zero?\n- Should the landing page and blog be integrated or separate?\n- What successful examples exist of similar projects?\n- What creative approaches haven’t we considered?\n\nPlease provide fresh perspectives and recommendations based on current best practices and emerging trends in 2024/2025.","reactions":{"url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/code-charity/youtube/issues/4132","repository_url":"https://api.github.com/repos/code-charity/youtube","labels_url":"https://api.github.com/repos/code-charity/youtube/issues/4132/labels{/name}","comments_url":"https://api.github.com/repos/code-charity/youtube/issues/4132/comments","events_url":"https://api.github.com/repos/code-charity/youtube/issues/4132/events","html_url":"https://github.com/code-charity/youtube/issues/4132","id":4810928971,"node_id":"I_kwDOB11tyM8AAAABHsDzSw","number":4132,"title":"I would like to be able to set seek distance when double tapping, or have progressive jump lengths","user":{"login":"nkinnan","id":11169377,"node_id":"MDQ6VXNlcjExMTY5Mzc3","avatar_url":"https://avatars.githubusercontent.com/u/11169377?v=4","gravatar_id":"","url":"https://api.github.com/users/nkinnan","html_url":"https://github.com/nkinnan","followers_url":"https://api.github.com/users/nkinnan/followers","following_url":"https://api.github.com/users/nkinnan/following{/other_user}","gists_url":"https://api.github.com/users/nkinnan/gists{/gist_id}","starred_url":"https://api.github.com/users/nkinnan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nkinnan/subscriptions","organizations_url":"https://api.github.com/users/nkinnan/orgs","repos_url":"https://api.github.com/users/nkinnan/repos","events_url":"https://api.github.com/users/nkinnan/events{/privacy}","received_events_url":"https://api.github.com/users/nkinnan/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":853725541,"node_id":"MDU6TGFiZWw4NTM3MjU1NDE=","url":"https://api.github.com/repos/code-charity/youtube/labels/Feature%20request","name":"Feature request","color":"1f7edF","default":false,"description":"Wish or idea"},{"id":2580028194,"node_id":"MDU6TGFiZWwyNTgwMDI4MTk0","url":"https://api.github.com/repos/code-charity/youtube/labels/help%20wanted","name":"help wanted","color":"f5f4f6","default":true,"description":"Just an old github standard we add automatically. (The team can remove it when working on it.)"},{"id":2590452199,"node_id":"MDU6TGFiZWwyNTkwNDUyMTk5","url":"https://api.github.com/repos/code-charity/youtube/labels/%F0%9F%A7%A9Plan%20ready","name":"🧩Plan ready","color":"fEcA16","default":false,"description":"Solution or some specification noted; To-Do; steps for implementation (+raw brainstorming too maybe)"},{"id":2880574943,"node_id":"MDU6TGFiZWwyODgwNTc0OTQz","url":"https://api.github.com/repos/code-charity/youtube/labels/good%20first%20issue","name":"good first issue","color":"f5f4f6","default":true,"description":"A GitHub standard for inviting (new) contributors   *Congratulations in advance!*"},{"id":4659439929,"node_id":"LA_kwDOB11tyM8AAAABFblpOQ","url":"https://api.github.com/repos/code-charity/youtube/labels/Bounty","name":"Bounty","color":"FBCA04","default":false,"description":"Will pass on donations (optional)  OR: Requester will pay personally *only* if stated!"}],"state":"open","locked":false,"assignees":[{"login":"Ishant5436","id":188478945,"node_id":"U_kgDOCzv14Q","avatar_url":"https://avatars.githubusercontent.com/u/188478945?v=4","gravatar_id":"","url":"https://api.github.com/users/Ishant5436","html_url":"https://github.com/Ishant5436","followers_url":"https://api.github.com/users/Ishant5436/followers","following_url":"https://api.github.com/users/Ishant5436/following{/other_user}","gists_url":"https://api.github.com/users/Ishant5436/gists{/gist_id}","starred_url":"https://api.github.com/users/Ishant5436/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ishant5436/subscriptions","organizations_url":"https://api.github.com/users/Ishant5436/orgs","repos_url":"https://api.github.com/users/Ishant5436/repos","events_url":"https://api.github.com/users/Ishant5436/events{/privacy}","received_events_url":"https://api.github.com/users/Ishant5436/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"luckyKingdog","id":250655317,"node_id":"U_kgDODvCyVQ","avatar_url":"https://avatars.githubusercontent.com/u/250655317?v=4","gravatar_id":"","url":"https://api.github.com/users/luckyKingdog","html_url":"https://github.com/luckyKingdog","followers_url":"https://api.github.com/users/luckyKingdog/followers","following_url":"https://api.github.com/users/luckyKingdog/following{/other_user}","gists_url":"https://api.github.com/users/luckyKingdog/gists{/gist_id}","starred_url":"https://api.github.com/users/luckyKingdog/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/luckyKingdog/subscriptions","organizations_url":"https://api.github.com/users/luckyKingdog/orgs","repos_url":"https://api.github.com/users/luckyKingdog/repos","events_url":"https://api.github.com/users/luckyKingdog/events{/privacy}","received_events_url":"https://api.github.com/users/luckyKingdog/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"ImprovedTube2","id":278608042,"node_id":"U_kgDOEJs4qg","avatar_url":"https://avatars.githubusercontent.com/u/278608042?v=4","gravatar_id":"","url":"https://api.github.com/users/ImprovedTube2","html_url":"https://github.com/ImprovedTube2","followers_url":"https://api.github.com/users/ImprovedTube2/followers","following_url":"https://api.github.com/users/ImprovedTube2/following{/other_user}","gists_url":"https://api.github.com/users/ImprovedTube2/gists{/gist_id}","starred_url":"https://api.github.com/users/ImprovedTube2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ImprovedTube2/subscriptions","organizations_url":"https://api.github.com/users/ImprovedTube2/orgs","repos_url":"https://api.github.com/users/ImprovedTube2/repos","events_url":"https://api.github.com/users/ImprovedTube2/events{/privacy}","received_events_url":"https://api.github.com/users/ImprovedTube2/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":6,"created_at":"2026-07-04T23:46:28Z","updated_at":"2026-07-06T16:01:00Z","closed_at":null,"assignee":{"login":"ImprovedTube2","id":278608042,"node_id":"U_kgDOEJs4qg","avatar_url":"https://avatars.githubusercontent.com/u/278608042?v=4","gravatar_id":"","url":"https://api.github.com/users/ImprovedTube2","html_url":"https://github.com/ImprovedTube2","followers_url":"https://api.github.com/users/ImprovedTube2/followers","following_url":"https://api.github.com/users/ImprovedTube2/following{/other_user}","gists_url":"https://api.github.com/users/ImprovedTube2/gists{/gist_id}","starred_url":"https://api.github.com/users/ImprovedTube2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ImprovedTube2/subscriptions","organizations_url":"https://api.github.com/users/ImprovedTube2/orgs","repos_url":"https://api.github.com/users/ImprovedTube2/repos","events_url":"https://api.github.com/users/ImprovedTube2/events{/privacy}","received_events_url":"https://api.github.com/users/ImprovedTube2/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"<!--\n(Click PREVIEW to undestand this template) \n               OPTIONALLY fill the table if each point fits in the same line: \n-->\n\n⚬ _REASON / PROBLEM_: \n<!-- (Does your IDEA / feature request relate to a Problem? Which problem is? \n           Ex. I'm always frustrated when [...] )-->\nOn a tablet with touchscreen, double-tapping the left or right side of a video will seek back or forward by 10 seconds (or more, progressively, depending on total number of taps).  Since I am usually seeking due to not having heard/understood something, I do not want to seek by 10 seconds but only maybe 3 or 5.\n\n⚬ _WISH / SOLUTION_:    \n<!-- (Describe what you'd like \n          (A clear and concise description of what you want to happen). \n           Please consider screenshots or sketches if it makes sense)-->\nI can think of a variety of ways this could be improved. Why not let the user decide? I suggest the following options as a radio button set:\n\n1) Default seek behavior (jump 10 seconds, them 30, then...)\n* By default, youtube will jump progressively larger amounts as you continue tapping.\n2) Set seek distance\n* This would include a single number-only text box, or up-down control, to set a specific number of seconds to jump each time you tap (no progressively increasing jump size)\n3) Increasing seek distance\n* Similar to default behavior, but with custom seek lengths. Ideally the user could continue adding custom lengths by clicking a + button, but at least three should be available, plus the last \"additional taps\" one:\n- Double-tap: a number-only text box, or up-down control, to set a specific number of seconds to seek after double tap\n- Tripple-tap: a number-only text box, or up-down control, to set a ***TOTAL*** number of seconds to seek after tapping three times\n- Quadruple-tap: a number-only text box, or up-down control, to set a ***TOTAL*** number of seconds to seek after tapping four times\n- Additional taps. a number-only text box, or up-down control, to set an ***ADDITIONAL*** number of seconds to seek for each additional tap in the sequence\n- Like the default behavior, this should reset when the sequence is broken with a pause in taps.\n\nThere are many possibilities here. Feel free to be creative. But I think these three options would be a good starting point / baseline.\n\n⚬ _BOUNTY_:  <!-- How much are you willing to donate / pay for this? and by what method? -->\n$70 USD (less purchase fees/gas est. $5 USD) via Eth to the donation wallet address.\n\n ⚬ _ALTERNATIVES_: \n<!-- (Describe what you've considered: \n      Alternative solutions or features, you'd consider as equal or inferior). -->\n\n ⚬ _RELEVANCE / SCOPE_: \n<!-- (Would this be good by for everybody by default? (hypothetically). \n          Estimate how many percent of our users (or all youtube users) should/would use your idea? ) -->\n\n⚬ _\"SIDE EFFECTS\"_:   \n<!-- (Is there any conflict with any other feature? \n           Who might NOT want this?(How many percent of users could be bothered by it even filling space in our menu?)--> \n\n⚬ _CONTEXT_:       <!-- any other context. -->\n// \n Thank  you!\n\nSHORT Table | (Summary)     \n------------ | -------------   \n*Problem*     |                                   \n*Solution*     |                                                            <!-- TYPE HERE, 1 line each) -->         \n*Alternatives*|         \n*Scope*         |           \n*Side effects*|        \n*Context*      |\n","reactions":{"url":"https://api.github.com/repos/code-charity/youtube/issues/4132/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/code-charity/youtube/issues/4132/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/66424","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/66424/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/66424/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/66424/events","html_url":"https://github.com/Expensify/App/issues/66424","id":3237327772,"node_id":"I_kwDOEQqHYc7A9bOc","number":66424,"title":"[Due for payment 2026-07-13] [Partial payment $3625] Remove `Onyx.connect()` for the key: `ONYXKEYS.NVP_ONBOARDING` in `src/libs/ReportUtils.ts`","user":{"login":"tgolen","id":1228807,"node_id":"MDQ6VXNlcjEyMjg4MDc=","avatar_url":"https://avatars.githubusercontent.com/u/1228807?v=4","gravatar_id":"","url":"https://api.github.com/users/tgolen","html_url":"https://github.com/tgolen","followers_url":"https://api.github.com/users/tgolen/followers","following_url":"https://api.github.com/users/tgolen/following{/other_user}","gists_url":"https://api.github.com/users/tgolen/gists{/gist_id}","starred_url":"https://api.github.com/users/tgolen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tgolen/subscriptions","organizations_url":"https://api.github.com/users/tgolen/orgs","repos_url":"https://api.github.com/users/tgolen/repos","events_url":"https://api.github.com/users/tgolen/events{/privacy}","received_events_url":"https://api.github.com/users/tgolen/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":2873635554,"node_id":"MDU6TGFiZWwyODczNjM1NTU0","url":"https://api.github.com/repos/Expensify/App/labels/Engineering","name":"Engineering","color":"274073","default":false,"description":""},{"id":2893455829,"node_id":"MDU6TGFiZWwyODkzNDU1ODI5","url":"https://api.github.com/repos/Expensify/App/labels/Daily","name":"Daily","color":"eb6420","default":false,"description":"KSv2"},{"id":2893524800,"node_id":"MDU6TGFiZWwyODkzNTI0ODAw","url":"https://api.github.com/repos/Expensify/App/labels/Improvement","name":"Improvement","color":"604c8d","default":false,"description":"Item broken or needs improvement."},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."},{"id":11258940365,"node_id":"LA_kwDOEQqHYc8AAAACnxXLzQ","url":"https://api.github.com/repos