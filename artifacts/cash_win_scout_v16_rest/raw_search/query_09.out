:"https://api.github.com/repos/xevrion-v2/agent-playground/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for new contributors."},{"id":11128350030,"node_id":"LA_kwDOSvpFLM8AAAACl00lTg","url":"https://api.github.com/repos/xevrion-v2/agent-playground/labels/bounty","name":"bounty","color":"e4e669","default":false,"description":"Reward-backed contribution task."},{"id":11128350083,"node_id":"LA_kwDOSvpFLM8AAAACl00lgw","url":"https://api.github.com/repos/xevrion-v2/agent-playground/labels/AI%20agent%20friendly","name":"AI agent friendly","color":"0e8a16","default":false,"description":"Suitable for autonomous AI agents."}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":55,"created_at":"2026-06-03T05:50:52Z","updated_at":"2026-07-05T14:36:01Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Configure a conservative JSON body size limit in the Express app and document the expected value.\n\n## Acceptance Criteria\n\n- Keep the pull request focused.\n- Include a short summary of the change.\n- Link this issue in the pull request description.\n\n/bounty $50","reactions":{"url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/9/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/9/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/320","repository_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research","labels_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/32