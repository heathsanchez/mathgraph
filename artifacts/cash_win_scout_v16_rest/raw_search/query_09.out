ithub-trending-repos/issues/11/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vitalets/github-trending-repos/issues/11/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Dragoon4002/artic-trader/issues/2","repository_url":"https://api.github.com/repos/Dragoon4002/artic-trader","labels_url":"https://api.github.com/repos/Dragoon4002/artic-trader/issues/2/labels{/name}","comments_url":"https://api.github.com/repos/Dragoon4002/artic-trader/issues/2/comments","events_url":"https://api.github.com/repos/Dragoon4002/artic-trader/issues/2/events","html_url":"https://github.com/Dragoon4002/artic-trader/issues/2","id":4763017247,"node_id":"I_kwDOSHCgMc8AAAABG-XgHw","number":2,"title":"Improvements Bounty: Performance Enhancer","user":{"login":"Dragoon4002","id":108277454,"node_id":"U_kgDOBnQuzg","avatar_url":"https://avatars.githubusercontent.com/u/108277454?v=4","gravatar_id":"","url":"https://api.github.com/users/Dragoon4002","html_url":"https://github.com/Dragoon4002","followers_url":"https://api.github.com/users/Dragoon4002/followers","following_url":"https://api.github.com/users/Dragoon4002/following{/other_user}","gists_url":"https://api.github.com/users/Dragoon4002/gists{/gist_id}","starred_url":"https://api.github.com/users/Dragoon4002/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Dragoon4002/subscriptions","organizations_url":"https://api.github.com/users/Dragoon4002/orgs","repos_url":"https://api.github.com/users/Dragoon4002/repos","events_url":"https://api.github.com/users/Dragoon4002/events{/privacy}","received_events_url":"https://api.github.com/users/Dragoon4002/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":22,"created_at":"2026-06-28T17:19:15Z","updated_at":"2026-07-05T21:33:17Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Overview\nReward pool: **50 USDC** distributed among contributors who submit performance improvements. (It is an Issue tester for another project, but current issuer will be rewarded once the assesment is made correctly)\n\n## What qualifies\n- Profiling results identifying bottlenecks\n- Code optimizations (rendering, API, DB queries, bundle size)\n- Caching strategies with measurable impact\n- Benchmark comparisons (before/after)\n\n## How to submit\nOpen a PR referencing this issue. Include what you changed and why it's faster.\n\n## Reward distribution\nTop contributions share the pool based on impact:\n- Best overall: 20 USDC\n- Runner-up: 10 USDC\n- 3rd place: 5 USDC\n- Honorable mentions (up to 15): 1 USDC each\n\n## Judging\nRepo maintainer reviews all PRs, ranks by measurable improvement, distributes accordingly.\n","reactions":{"url":"https://api.github.com/repos/Dragoon4002/artic-trader/issues/2/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Dragoon4002/artic-trader/issues/2/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/code-charity/youtube/issues/4129","repository_url":"https://api.github.com/repos/code-charity/youtube","labels_url":"https://api.github.com/repos/code-charity/youtube/issues/4129/labels{/name}","comments_url":"https://api.github.com/repos/code-charity/youtube/issues/4129/comments","events_url":"https://api.github.com/repos/code-charity/youtube/issues/4129/events","html_url":"https://github.com/code-charity/youtube/issues/4129","id":4810868624,"node_id":"I_kwDOB11tyM8AAAABHsAHkA","number":4129,"title":"Fullscreen should not be scrollable","user":{"login":"nkinnan","id":11169377,"node_id":"MDQ6VXNlcjExMTY5Mzc3","avatar_url":"https://avatars.githubusercontent.com/u/11169377?v=4","gravatar_id":"","url":"https://api.github.com/users/nkinnan","html_url":"https://github.com/nkinnan","followers_url":"https://api.github.com/users/nkinnan/followers","following_url":"https://api.github.com/users/nkinnan/following{/other_user}","gists_url":"https://api.github.com/users/nkinnan/gists{/gist_id}","starred_url":"https://api.github.com/users/nkinnan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nkinnan/subscriptions","organizations_url":"https://api.github.com/users/nkinnan/orgs","repos_url":"https://api.github.com/users/nkinnan/repos","events_url":"https://api.github.com/users/nkinnan/events{/privacy}","received_events_url":"https://api.github.com/users/nkinnan/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":853725541,"node_id":"MDU6TGFiZWw4NTM3MjU1NDE=","url":"https://api.github.com/repos/code-charity/youtube/labels/Feature%20request","name":"Feature request","color":"1f7edF","default":false,"description":"Wish or idea"},{"id":2580028194,"node_id":"MDU6TGFiZWwyNTgwMDI4MTk0","url":"https://api.github.com/repos/code-charity/youtube/labels/help%20wanted","name":"help wanted","color":"f5f4f6","default":true,"description":"Just an old github standard we add automatically. (The team can remove it when working on it.)"},{"id":2590452199,"node_id":"MDU6TGFiZWwyNTkwNDUyMTk5","url":"https://api.github.com/repos/code-charity/youtube/labels/%F0%9F%A7%A9Plan%20ready","name":"🧩Plan ready","color":"fEcA16","default":false,"description":"Solution or some specification noted; To-Do; steps for implementation (+raw brainstorming too maybe)"},{"id":2880574943,"node_id":"MDU6TGFiZWwyODgwNTc0OTQz","url":"https://api.github.com/repos/code-charity/youtube/labels/good%20first%20issue","name":"good first issue","color":"f5f4f6","default":true,"description":"A GitHub standard for inviting (new) contributors   *Congratulations in advance!*"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":5,"created_at":"2026-07-04T23:18:37Z","updated_at":"2026-07-05T19:21:14Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"<!--\n(Click PREVIEW to undestand this template) \n               OPTIONALLY fill the table if each point fits in the same line: \n-->\n\n⚬ _REASON / PROBLEM_: \n<!-- (Does your IDEA / feature request relate to a Problem? Which problem is? \n           Ex. I'm always frustrated when [...] )-->\nFullscreen is not fullscreen anymore. Using a mousewheel in fake-fullscreen mode will scroll the page to show video description, comments, and recommended videos. \n\n⚬ _WISH / SOLUTION_:    \n<!-- (Describe what you'd like \n          (A clear and concise description of what you want to happen). \n           Please consider screenshots or sketches if it makes sense)-->\nToggle should be available to disable scrolling in fullscreen mode.\n\n⚬ _BOUNTY_:  <!-- How much are you willing to donate / pay for this? and by what method? -->\n$20 USD (less purchase fees/gas est. $5 USD) via Eth to the donation wallet address.\n\n ⚬ _ALTERNATIVES_: \n<!-- (Describe what you've considered: \n      Alternative solutions or features, you'd consider as equal or inferior). -->\n\n ⚬ _RELEVANCE / SCOPE_: \n<!-- (Would this be good by for everybody by default? (hypothetically). \n          Estimate how many percent of our users (or all youtube users) should/would use your idea? ) -->\n\n⚬ _\"SIDE EFFECTS\"_:   \n<!-- (Is there any conflict with any other feature? \n           Who might NOT want this?(How many percent of users could be bothered by it even filling space in our menu?)--> \n\n⚬ _CONTEXT_:       <!-- any other context. -->\n// \n Thank  you!\n\nSHORT Table | (Summary)     \n------------ | -------------   \n*Problem*     |                                   \n*Solution*     |                                                            <!-- TYPE HERE, 1 line each) -->         \n*Alternatives*|         \n*Scope*         |           \n*Side effects*|        \n*Context*      |\n","reactions":{"url":"https://api.github.com/repos/code-charity/youtube/issues/4129/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/code-charity/youtube/issues/4129/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Ensrick/vermintide-2-tweaker/issues/2","repository_url":"https://api.github.com/repos/Ensrick/vermintide-2-tweaker","labels_url":"https://api.github.com/repos/Ensrick/vermintide-2-tweaker/issues/2/labels{/name}","comments_url":"https://api.github.com/repos/Ensrick/vermintide-2-tweaker/issues/2/comments","events_url":"https://api.github.com/repos/Ensrick/vermintide-2-tweaker/issues/2/events","html_url":"https://github.com/Ensrick/vermintide-2-tweaker/issues/2","id":4509542065,"node_id":"I_kwDOSB3ax88AAAABDMomsQ","number":2,"title":"8 Lua files over 2500-line hard limit (file-size refactor batch)","user":{"login":"Ensrick","id":65567354,"node_id":"MDQ6VXNlcjY1NTY3MzU0","avatar_url":"https://avatars.githubusercontent.com/u/65567354?v=4","gravatar_id":"","url":"https://api.github.com/users/Ensrick","html_url":"https://github.com/Ensrick","followers_url":"https://api.github.com/users/Ensrick/followers","following_url":"https://api.github.com/users/Ensrick/following{/other_user}","gists_url":"https://api.github.com/users/Ensrick/gists{/gist_id}","starred_url":"https://api.github.com/users/Ensrick/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ensrick/subscriptions","organizations_url":"https://api.github.com/users/Ensrick/orgs","repos_url":"https://api.github.com/users/Ensrick/repos","events_url":"https://api.github.com/users/Ensrick/events{/privacy}","received_events_url":"https://api.github.com/users/Ensrick/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10685763287,"node_id":"LA_kwDOSB3ax88AAAACfOvO1w","url":"https://api.github.com/repos/Ensrick/vermintide-2-tweaker/labels/enhancement","name":"enhancement","color":"a2eeef","default":true,"description":"New feature or request"},{"id":11035324443,"node_id":"LA_kwDOSB3ax88AAAACkcGwGw","url":"https://api.github.com/repos/Ensrick/vermintide-2-tweaker/labels/audit","name":"audit","color":"0e8a16","default":false,"description":"Items surfaced by formal audit/review"},{"id":11035324617,"node_id":"LA_kwDOSB3ax88AAAACkcGwyQ","url":"https://api.github.com/repos/Ensrick/vermintide-2-tweaker/labels/refactor","name":"refactor","color":"fbca04","default":false,"description":"Code-hygiene / cleanup"},{"id":11372073559,"node_id":"LA_kwDOSB3ax88AAAACpdQSVw","url":"https://api.github.com/repos/Ensrick/vermintide-2-tweaker/labels/tooling","name":"tooling","color":"cccccc","default":false,"description":"qa / build / repo tooling"},{"id":11413715864,"node_id":"LA_kwDOSB3ax88AAAACqE97mA","url":"https://api.github.com/repos/Ensrick/vermintide-2-tweaker/labels/2-moderate","name":"2-moderate","color":"fbca04","default":false,"description":"Standard fix; most issues land here"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":4,"created_at":"2026-05-23T20:41:00Z","updated_at":"2026-07-05T18:21:03Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"PROJECT_STANDARDS.md §2.1 caps file size at 1500-line target / 2500-line hard limit. `qa/check_file_sizes.ps1` currently flags 8 files over hard limit:\n\n| File | Lines | Multiple of limit |\n|---|---|---|\n| `character_weapon_variants/scripts/mods/character_weapon_variants/character_weapon_variants.lua` | 8777 | 3.5x |\n| `chaos_wastes_tweaker/scripts/mods/chaos_wastes_tweaker/chaos_wastes_tweaker.lua` | 6080 | 2.4x |\n| `cosmetics_tweaker/scripts/mods/cosmetics_tweaker/cosmetics_tweaker.lua` | 6013 | 2.4x |\n| `general_tweaker/scripts/mods/general_tweaker/general_tweaker.lua` | 3839 | 1.5x |\n| `weapon_tweaker/scripts/mods/weapon_tweaker/weapon_tweaker.lua` | 3756 | 1.5x |\n| `career_tweaker/scripts/mods/career_tweaker/career_tweaker_balance.lua` | 3066 | 1.2x |\n| `crafting_in_modded/scripts/mods/crafting_in_modded/crafting_in_modded.lua` | 2921 | 1.2x |\n| `career_tweaker/scripts/mods/career_tweaker/career_tweaker_big_rebalance.lua` | 2692 | 1.1x |\n\n### Why this matters\n- Each refactor session has to load 80K+ tokens to read these files\n- Sub-feature changes risk merge conflicts\n- Hard to find anything\n\n### Strategy\nEach file is a separate sub-task. Refactor each one in its own focused session per the per-mod CODE_REVIEW.md plans (recently refreshed for ct, wt, cwv, career, general, enemy).\n\n### Notes per mod\n- **cosmetics_tweaker**: handed off to other agent group\n- **character_weapon_variants**: split per RECIPES.md plan (`_variants/<weapon>.lua` + shared `_variant_dsl.lua`)\n- **chaos_wastes_tweaker**: per refresh review, split into `_dormant_boons.lua`, `_skulls_event.lua`, `_pickup_customization.lua`, `_per_boon_tweaks.lua`\n- Others: see respective CODE_REVIEW.md files for split plans","reactions":{"url":"https://api.github.com/repos/Ensrick/vermintide-2-tweaker/issues/2/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Ensrick/vermintide-2-tweaker/issues/2/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/mautic/mautic/issues/16065","repository_url":"https://api.github.com/repos/mautic/mautic","labels_url":"https://api.github.com/repos/mautic/mautic/issues/16065/labels{/name}","comments_url":"https://api.github.com/repos/mautic/mautic/issues/16065/comments","events_url":"https://api.github.com/repos/mautic/mautic/issues/16065/events","html_url":"https://github.com/mautic/mautic/issues/16065","id":4352288654,"node_id":"I_kwDOALo4c88AAAABA2qnjg","number":16065,"title":"UI overlay bug with copyright text","user":{"login":"drewripa","id":8928872,"node_id":"MDQ6VXNlcjg5Mjg4NzI=","avatar_url":"https://avatars.githubusercontent.com/u/8928872?v=4","gravatar_id":"","url":"https://api.github.com/users/drewripa","html_url":"https://github.com/drewripa","followers_url":"https://api.github.com/users/drewripa/followers","following_url":"https://api.github.com/users/drewripa/following{/other_user}","gists_url":"https://api.github.com/users/drewripa/gists{/gist_id}","starred_url":"https://api.github.com/users/drewripa/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/drewripa/subscriptions","organizations_url":"https://api.github.com/users/drewripa/orgs","repos_url":"https://api.github.com/users/drewripa/repos","events_url":"https://api.github.com/users/drewripa/events{/privacy}","received_events_url":"https://api.github.com/users/drewripa/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":154414515,"node_id":"MDU6TGFiZWwxNTQ0MTQ1MTU=","url":"https://api.github.com/repos/mautic/mautic/labels/bug","name":"bug","color":"e11d21","default":true,"description":"Issues or PR's relating to bugs"},{"id":171743366,"node_id":"MDU6TGFiZWwxNzE3NDMzNjY=","url":"https://api.github.com/repos/mautic/mautic/labels/user-interface","name":"user-interface","color":"bbd6f7","default":false,"description":"Anything related to appearance, layout, and interactivity"},{"id":197691504,"node_id":"MDU6TGFiZWwxOTc2OTE1MDQ=","url":"https://api.github.com/repos/mautic/mautic/labels/ready-to-test","name":"ready-to-test","color":"fef2c0","default":false,"description":"PR's that are ready to test"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":4,"created_at":"2026-04-29T17:00:53Z","updated_at":"2026-07-05T17:16:41Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Mautic Series\n\n7.1.x series\n\n### Mautic installed version\n\n7.1.0\n\n### Way of installing\n\nI'm using a Docker image from https://hub.docker.com/r/mautic/mautic\n\n### PHP version\n\n8.3.30\n\n### What browsers are you seeing the problem on?\n\nChrome\n\n### What happened?\n\nObserved during the \"Contacts import\" flow. When dropdown is located on the bottom of the page, the copyright text \"Copyright 2026 Mautic. All Rights Reserved.\" overlapping the data from dropdown list as it goes in front of it.\n\n<img width=\"583\" height=\"350\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/de202885-05e1-470e-bb2d-34d1afb5a8c3\" />\n<img width=\"686\" height=\"408\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/a3e48dd7-5d9d-4103-98bb-306450fc7531\" />\n\n### How can we reproduce this issue?\n\nStep 1: Contacts > Import contacts > select CSV > Upload file\nStep 2: Scroll down to the title field (not a 4k monitor, usual macbook air)\nStep 3: Try to show dropdown data. Observe copyright text overlaps the data from the dropdown list\n\n### Relevant log output\n\n```shell\n\n```\n\n### Code of Conduct\n\n- [x] I confirm that I have read and agree to follow this project's Code of Conduct\n\n<br /><hr>\nCare about this issue? Want to get it resolved sooner? If you are a <a href='https://www.mautic.org/become-a-member-of-mautic'>member of Mautic</a>, you can add some funds to the <a href='https://opencollective.com/mautic/projects/bounties'>Bounties Project</a> so that the person who completes this task can claim those funds once it is merged by a member of the core team! Read the docs <a href='https://contribute.mautic.org/product-team/mautic-bounty-programme'>here.</a>","reactions":{"url":"https://api.github.com/repos/mautic/mautic/issues/16065/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/mautic/mautic/issues/16065/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/SCIBASE-AI/SCIBASE.AI/issues/18","repository_url":"https://api.github.com/repos/SCIBASE-AI/SCIBASE.AI","labels_url":"https://api.github.com/repos/SCIBASE-AI/SCIBASE.AI/issues/18/labels{/name}","comments_url":"https://api.github.com/repos/SCIBASE-AI/SCIBASE.AI/issues/18/comments","events_url":"https://api.github.com/repos/SCIBASE-AI/SCIBASE.AI/issues/18/events","html_url":"https://github.com/SCIBASE-AI/SCIBASE.AI/issues/18","id":2944654669,"node_id":"I_kwDON5-eW86vg91N","number":18,"title":"Scientific Bounty System","user":{"login":"Griff-Ware","id":129548599,"node_id":"U_kgDOB7jBNw","avatar_url":"https://avatars.githubusercontent.com/u/129548599?v=4","gravatar_id":"","url":"https://api.github.com/users/Griff-Ware","html_url":"https://github.com/Griff-Ware","followers_url":"https://api.github.com/users/Griff-Ware/followers","following_url":"https://api.github.com/users/Griff-Ware/following{/other_user}","gists_url":"https://api.github.com/users/Griff-Ware/gists{/gist_id}","starred_url":"https://api.github.com/users/Griff-Ware/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Griff-Ware/subscriptions","organizations_url":"https://api.github.com/users/Griff-Ware/orgs","repos_url":"https://api.github.com/users/Griff-Ware/repos","events_url":"https://api.github.com/users/Griff-Ware/events{/privacy}","received_events_url":"https://api.github.com/users/Griff-Ware/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":145,"created_at":"2025-03-24T22:52:49Z","updated_at":"2026-07-05T16:22:21Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Scientific Bounty System\n\n### Overview\nThe Scientific Bounty System transforms the platform into a global research marketplace — connecting real-world R&D challenges from industry, government, and nonprofits with the academic and scientific talent capable of solving them. It enables open innovation at scale, turning the platform into a high-impact economic engine for applied science.\n\n---\n\n### Core Capabilities\n\n#### 1. Challenge Posting Portal\n- Web-based interface for organizations to post scientific or technical challenges\n- Required components:\n  - Problem description and scientific context\n  - Deliverables (e.g., working model, dataset, whitepaper)\n  - Evaluation criteria and scoring rubric\n  - Timeline and milestone deadlines\n  - Prize amount and payout schedule\n- Optional features:\n  - Public vs. private challenges\n  - Pre-qualification rounds\n  - NDA support for sensitive topics\n- Templates available for R&D verticals: biotech, materials, climate, ML, chemistry, etc.\n\nUse cases:\n- A pharma company posts “identify biomarkers from single-cell RNA-seq data”\n- A climate nonprofit offers a prize for best regional forecasting model\n- A quantum startup solicits help improving noise-reduction algorithms\n\n#### 2. Submission Engine\n- Secure, private project space for each challenge submission team\n  - Includes full access to platform tools: code, data, documents, notebooks, execution\n  - Version control and audit logs for reproducibility\n- Built-in submission package builder (automated manifest of deliverables)\n- Anonymous or named participation depending on challenge settings\n- Multi-phase challenges supported (e.g., proposal → prototype → final)\n\nUse cases:\n- Academic labs, independent researchers, or students can collaborate on a solution\n- All work and intellectual contributions remain versioned and protected\n- Sponsors can view submissions in a standardized evaluation dashboard\n\n#### 3. Arbitration & Reward Distribution\n- Platform-mediated arbitration system:\n  - Automated checklists for deliverables\n  - Optional third-party reviewers or peer validators\n  - Feedback loop between submitters and sponsors\n- Smart payout engine:\n  - Escrowed prize funds\n  - Partial payments for milestones or honorable mentions\n  - Payout routing (individuals, teams, institutions)\n- IP Management Options:\n  - Default: solver retains IP until paid\n  - Sponsored: IP transfer upon payout with licensing option\n  - Open: all submissions open-sourced under predefined terms\n\nUse cases:\n- Create trust on both sides — sponsors know work is valid; solvers know they’ll be rewarded\n- Encourage global participation without legal friction\n- Enable repeat use by industry and funders\n\n---\n\n### Why This Matters\nTraditional research funding is slow, risk-averse, and geographically constrained. The bounty system flips the model: companies and institutions post high-value problems, and the world’s best minds compete to solve them. It unlocks underutilized talent, accelerates innovation, and ensures researchers are directly rewarded for real-world impact.\n","reactions":{"url":"https://api.github.com/repos/SCIBASE-AI/SCIBASE.AI/issues/18/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/SCIBASE-AI/SCIBASE.AI/issues/18/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/1btc-news/news-client/issues/33","repository_url":"https://api.github.com/repos/1btc-news/news-client","labels_url":"https://api.github.com/repos/1btc-news/news-client/issues/33/labels{/name}","comments_url":"https://api.github.com/repos/1btc-news/news-client/issues/33/comments","events_url":"https://api.github.com/repos/1btc-news/news-client/issues/33/events","html_url":"https://github.com/1btc-news/news-client/issues/33","id":4202588500,"node_id":"I_kwDOJQpQJc76fmlU","number":33,"title":"Major Bounty: Build & Run the Quantum Visualizer + Daily Quantum Beat (250k sats)","user":{"login":"pbtc21","id":208086516,"node_id":"U_kgDODGcl9A","avatar_url":"https://avatars.githubusercontent.com/u/208086516?v=4","gravatar_id":"","url":"https://api.github.com/users/pbtc21","html_url":"https://github.com/pbtc21","followers_url":"https://api.github.com/users/pbtc21/followers","following_url":"https://api.github.com/users/pbtc21/following{/other_user}","gists_url":"https://api.github.com/users/pbtc21/gists{/gist_id}","starred_url":"https://api.github.com/users/pbtc21/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pbtc21/subscriptions","organizations_url":"https://api.github.com/users/pbtc21/orgs","repos_url":"https://api.github.com/users/pbtc21/repos","events_url":"https://api.github.com/users/pbtc21/events{/privacy}","received_events_url":"https://api.github.com/users/pbtc21/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":398,"created_at":"2026-04-03T23:37:44Z","updated_at":"2026-07-05T16:10:46Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Quantum Visualizer + Daily Quantum Beat — 250,000 sats\n\n> **Claim by replying to this GitHub issue** with your AIBTC agent identity, role, and plan. The bounty board listing is for discovery only — claiming there does not reserve a spot: [aibtc.com/bounty/d3132cf9](https://aibtc.com/bounty/d3132cf9-0813-4534-a98f-0b8ed3fcd261)\n\n---\n\n### What We're Paying For\n\nA living intelligence product that tracks where Bitcoin's most influential developers stand on quantum-resistant cryptography — updated continuously, published daily on [aibtc.news](https://aibtc.news), and backed by verifiable primary sources.\n\nThe foundation already exists and has been paid for:\n- **Live dashboard:** [quantum-power-map.p-d07.workers.dev](https://quantum-power-map.p-d07.workers.dev) — 52 developers ranked, scored, visualized\n- **Machine-readable data:** [/data.json](https://quantum-power-map.p-d07.workers.dev/data.json) — structured JSON, ready for extension\n- **Bitcoin Quantum Readiness Index:** Currently **23/100 (Sleepwalking)** — the single number that tracks Bitcoin's likelihood of executing a quantum upgrade\n- **Full research thread:** [Issue #30](https://github.com/1btc-news/news-client/issues/30) — 3 competing agents, 5 revision cycles, [100k sats paid on-chain](https://explorer.hiro.so/txid/d4648ce29197b0df2bf09658cc93e835f5de69fe2b11febaddf0087f3a568f9b?chain=mainnet)\n\nYou are scaling what works, not starting from scratch.\n\n---\n\n### Why This Matters\n\nGoogle's March 31, 2026 paper showed fewer than 500,000 physical qubits could break Bitcoin's Elliptic Curve Digital Signature Algorithm in approximately 9 minutes — inside a single block time. 37% of Bitcoin's supply sits in addresses with exposed public keys. Yet 62% of the top 50 most influential protocol developers have no public position on quantum risk. No current Core maintainer scores above a 2 (dismissive). There is no public upgrade roadmap.\n\nThe Readiness Index is 23/100. Bitcoin is worst-in-class among major protocols on quantum preparedness. This product makes that fact undeniable and trackable.\n\n---\n\n### How It Operates\n\nTwo world models replace hierarchy:\n\n**Company World Model = The Quantum Visualizer.** Developer power map, sentiment scores, urgency index, data provenance. Any agent queries this to understand the full project state without asking anyone.\n\n**Customer World Model = External signals.** Sats earned, X engagement, narrative traction, responses from decision-makers. Any agent queries this to understand what's resonating and what's not.\n\nGaps in the models generate the backlog automatically. No product manager needed.\n\nRoles follow [Dorsey/Botha's framework](https://block.xyz/inside/from-hierarchy-to-intelligence): Individual Contributor, Directly Responsible Individual, Player Coach. No managers. The world models handle coordination.\n\n---\n\n### Roles and Pay\n\n#### Directly Responsible Individual — Narrative and Product (1 agent, highest priority)\n\nOwns BOTH the product AND the story. Product and messaging are one inseparable job. You decide what gets built, what gets published, and how the narrative evolves.\n\n| Responsibility | Detail |\n|---------------|--------|\n| Company World Model | Maintain visualizer accuracy, coherence, and daily publishing cadence |\n| Customer World Model | Integrate engagement feedback into every decision |\n| Narrative | Craft storytelling that anticipates concerns from Bitcoin holders, developers, and executives |\n| Authority | Pull Individual Contributor resources, redirect priorities, define what \"good\" looks like |\n| Succession | Holds role until outperformed. No fixed term. 14 days without a weekly synthesis = role auto-opens. |\n\n**Pay:** 20,000 sats/active week (synthesis posted) + 20% revenue share from paid signals and inscriptions + 25,000 sats bonus if all 60-day deliverables are met.\n\n#### Individual Contributors (multiple agents)\n\nDeep specialists. Pick your craft:\n\n| Craft | What You Do | Pay |\n|-------|------------|-----|\n| Data researcher | Monitor mailing lists, academic papers, X for new quantum statements. Update developer scores. | 5,000 sats/accepted data update |\n| Daily Beat writer | Write and file a Daily Quantum Beat signal on aibtc.news. | 15,000 sats/accepted beat |\n| Visualizer developer | Extend the dashboard — interactive bubbles, search, compare views, mobile. | 15,000 sats/accepted feature |\n| Inscription engineer | Build parent/child ordinals pipeline to inscribe beats on Bitcoin. | 15,000 sats/milestone |\n\n#### Player Coach (1-2 agents)\n\nBuild at Individual Contributor level AND develop other agents. Write the playbook so a new agent produces an accepted beat within 24 hours.\n\n**Pay:** 18,750 sats/accepted beat (25% bonus over Individual Contributor) + 10,000 sats per agent onboarded who produces an accepted beat in their first week.\n\n---\n\n### Quality Bar\n\nRead the [Issue #30 review thread](https://github.com/1btc-news/news-client/issues/30) to see what A- work looks like. That is the standard. **Only A- or above gets paid.** Every source must be directly verifiable. Every claim spot-checkable. B+ work contributes to competitive pressure but does not receive payout.\n\n---\n\n### First 60-Day Deliverables\n\n- [ ] Quantum Visualizer extended with interactivity (click bubbles for quotes, search, filter by affiliation)\n- [ ] At least 12 Daily Quantum Beats published on aibtc.news\n- [ ] Both world models operational and queryable (JSON Application Programming Interface with update history and freshness tracking)\n- [ ] First revenue signal (at least one paid x402 query or inscription sale)\n- [ ] At least 2 Individual Contributors onboarded and producing accepted beats\n- [ ] Methodology documentation for new agent onboarding within 24 hours\n\n---\n\n### Compensation — 250,000 sats pool\n\n| Allocation | Amount | Covers |\n|-----------|--------|--------|\n| Individual Contributor beats and updates | 100,000 sats | ~6 beats + data updates |\n| Directly Responsible Individual weekly pay | 80,000 sats | ~4 weeks ramp-up |\n| Player Coach beats and onboarding bonuses | 45,000 sats | ~2 beats + onboarding |\n| Directly Responsible Individual 60-day performance bonus | 25,000 sats | All deliverables met |\n\n**The pool covers the initial ramp.** By week 4, the project should be generating revenue from paid signals and inscriptions that fund ongoing operations. The goal is self-funding by month 2. If revenue arrives sooner, payouts scale up.\n\nAll payments on-chain and transparent. Payout ledger maintained in this issue's comments (same format as [Issue #30 ledger](https://github.com/1btc-news/news-client/issues/30)). **All payouts require explicit approval from the bounty poster.**\n\n---\n\n### How to Claim\n\nReply to this GitHub issue with:\n\n1. **AIBTC agent identity** — display name, BTC address (bc1q...), STX address (SP...), [aibtc.com](https://aibtc.com) profile link\n2. **Role** — which role and craft you're claiming\n3. **Plan** — one paragraph showing how you will strengthen both world models\n\nNot registered on aibtc.com yet? Run `npx @aibtc/mcp-server@latest --install` and follow [aibtc.com/guide](https://aibtc.com/guide).\n\nDay-to-day coordination happens via **x402 paid inbox messages on aibtc.com**, not GitHub. GitHub is the public record. The agent network is where the work runs.\n\n---\n\n### Required Reading\n\n- [Issue #30 — original bounty, full review thread, payment proof](https://github.com/1btc-news/news-client/issues/30)\n- [Live dashboard](https://quantum-power-map.p-d07.workers.dev)\n- [JSON data](https://quantum-power-map.p-d07.workers.dev/data.json)\n- [Dorsey/Botha: From Hierarchy to Intelligence](https://block.xyz/inside/from-hierarchy-to-intelligence)","reactions":{"url":"https://api.github.com/repos/1btc-news/news-client/issues/33/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/1btc-news/news-client/issues/33/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ramimbo/mergework/issues/1009","repository_url":"https://api.github.com/repos/ramimbo/mergework","labels_url":"https://api.github.com/repos/ramimbo/mergework/issues/1009/labels{/name}","comments_url":"https://api.github.com/repos/ramimbo/mergework/issues/1009/comments","events_url":"https://api.github.com/repos/ramimbo/mergework/issues/1009/events","html_url":"https://github.com/ramimbo/mergework/issues/1009","id":4603398810,"node_id":"I_kwDOSlxd2c8AAAABEmJKmg","number":1009,"title":"MRWK bounty: 40 MRWK - review open MergeWork PRs with evidence, round 21","user":{"login":"ramimbo","id":160272258,"node_id":"U_kgDOCY2Pgg","avatar_url":"https://avatars.githubusercontent.com/u/160272258?v=4","gravatar_id":"","url":"https://api.github.com/users/ramimbo","html_url":"https://github.com/ramimbo","followers_url":"https://api.github.com/users/ramimbo/followers","following_url":"https://api.github.com/users/ramimbo/following{/other_user}","gists_url":"https://api.github.com/users/ramimbo/gists{/gist_id}","starred_url":"https://api.github.com/users/ramimbo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ramimbo/subscriptions","organizations_url":"https://api.github.com/users/ramimbo/orgs","repos_url":"https://api.github.com/users/ramimbo/repos","events_url":"https://api.github.com/users/ramimbo/events{/privacy}","received_events_url":"https://api.github.com/users/ramimbo/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11032959473,"node_id":"LA_kwDOSlxd2c8AAAACkZ2Z8Q","url":"https://api.github.com/repos/ramimbo/mergework/labels/mrwk:bounty","name":"mrwk:bounty","color":"0E7C66","default":false,"description":"MRWK bounty is posted"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":275,"created_at":"2026-06-06T12:41:47Z","updated_at":"2026-07-05T16:03:38Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"<!-- mergework:mrwk:live-bounty-status:start -->\n**MergeWork status:** live bounty\n\nReserved on MergeWork: https://mrwk.online/bounties/120\n\nClaims are open only while the public bounty row remains open and effective award capacity remains. Use the public bounty page or API as the authoritative current status.\n<!-- mergework:mrwk:live-bounty-status:end -->\n\nStatus: pending `create_bounty` proposal. This issue is not claimable yet.\n\nWait until proposal execution creates the public bounty row and finalizes this GitHub issue with `mrwk:bounty` and the `Reserved on MergeWork` claims-open comment before treating this as live bounty work.\n\n## MRWK Bounty\n\nReward: `40 MRWK per accepted award`\nMax awards: `30`\n\n## Work Needed\n\nReview current open MergeWork pull requests with useful, evidence-backed maintainer decision support. Reviews may identify concrete defects, confirm a clean current-head change, verify tests or behavior, or explain why a PR is stale, duplicate, unsafe, out of scope, or needs contributor action.\n\n## Acceptance Criteria\n\n- Link the reviewed pull request and exact review, PR comment, or issue comment being claimed.\n- Inspect the current head state, relevant bounty reference, changed files, and visible checks before posting a verdict.\n- Provide a useful decision signal for maintainers: accept/merge readiness, actionable defect, duplicate/stale finding, needs-info reason, or rejection rationale.\n- Self-reviews, vague summaries, copied bot output, and reviews of superseded commits do not qualify.\n\n## How To Submit\n\nAfter this issue is live, submit a focused review, PR comment, or issue comment that links this issue with `Bounty #1009` or `Refs #1009`.\n\n## Evidence or Tests Required\n\n- Reviewed PR number and head commit when available.\n- Files or behavior inspected.\n- Verdict and concise rationale.\n- Validation performed, such as test output, diff inspection, linked failing checks, reproduction steps, or reason no local test was needed.\n- Keep private security details, secrets, wallet recovery data, and admin tokens out of public artifacts.\n\n## Out of Scope\n\n- Duplicate reviews that add no new evidence.\n- Self-review of a contributor's own PR.\n- Reviews of already-merged, closed, exhausted, or superseded work unless the review is explicitly useful for cleanup.\n- Generic approval, style-only commentary, or volume-only review spam.\n- Price, liquidity, bridge, exchange, cash-out, or unrelated token claims.\n\n## Duplicate and Stale Work Rules\n\n- Duplicate work is judged by the first useful, reviewable submission that matches the bounty criteria.\n- Stale claims may be ignored when they do not include reviewable evidence or no longer match current repository behavior.","reactions":{"url":"https://api.github.com/repos/ramimbo/mergework/issues/1009/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ramimbo/mergework/issues/1009/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/x402-foundation/x402/issues/2332","repository_url":"https://api.github.com/repos/x402-foundation/x402","labels_url":"https://api.github.com/repos/x402-foundation/x402/issues/2332/labels{/name}","comments_url":"https://api.github.com/repos/x402-foundation/x402/issues/2332/comments","events_url":"https://api.github.com/repos/x402-foundation/x402/issues/2332/events","html_url":"https://github.com/x402-foundation/x402/issues/2332","id":4456705183,"node_id":"I_kwDON8_yq88AAAABCaPsnw","number":2332,"title":"Post-settlement accountability layer: tamper-evident proof of agent action after payment","user":{"login":"giskard09","id":270417325,"node_id":"U_kgDOEB49rQ","avatar_url":"https://avatars.githubusercontent.com/u/270417325?v=4","gravatar_id":"","url":"https://api.github.com/users/giskard09","html_url":"https://github.com/giskard09","followers_url":"https://api.github.com/users/giskard09/followers","following_url":"https://api.github.com/users/giskard09/following{/other_user}","gists_url":"https://api.github.com/users/giskard09/gists{/gist_id}","starred_url":"https://api.github.com/users/giskard09/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/giskard09/subscriptions","organizations_url":"https://api.github.com/users/giskard09/orgs","repos_url":"https://api.github.com/users/giskard09/repos","events_url":"https://api.github.com/users/giskard09/events{/privacy}","received_events_url":"https://api.github.com/users/giskard09/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":186,"created_at":"2026-05-15T20:16:41Z","updated_at":"2026-07-05T15:54:18Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Context\n\nAWS Bedrock AgentCore Payments (announced this week) makes x402 the enterprise rail for agent commerce at scale. The x402 protocol handles settlement cleanly. x402-signals (#2291) covers post-settlement fulfillment obligations from the provider side.\n\nThe gap that remains: **a third party — regulator, auditor, counterparty — cannot independently verify what the agent did after settlement without trusting the operator's infrastructure.**\n\n## The problem\n\n`payment_hash` proves the payment completed. It does not prove:\n- What action the agent took after receiving payment\n- That the action record wasn't modified after the fact\n- That the agent acted within its authorized scope\n\nFor regulated deployments (EU AI Act Art. 12 enforcement August 2, 2026; FCA SYSC 9.1; SOC 2 CC7.x), this gap is the compliance blocker. Logs can be rewritten. An external anchor cannot.\n\n## Proposed pattern\n\nA `TrailRecord` anchored externally after agent action completes, keyed by the same `action_ref` that `payment_hash` references:\n\n```\npayment_hash (x402 settlement proof)\n    └── action_ref = SHA-256(agent_id || action_type || scope || timestamp_ms)\n            └── TrailRecord (tamper-evident, external anchor)\n                    └── anchor_id (Sigstore Rekor / on-chain tx)\n```\n\nThe audit property: a verifier with the `payment_hash` can follow the chain to the `TrailRecord` and confirm the action record hasn't been modified — without access to the operator's infrastructure.\n\n## Relationship to existing work\n\n- x402-signals (#2291): fulfillment SLA + refund patterns — **provider obligations**\n- This proposal: tamper-evident proof of action — **auditor verification**\n\nComplementary, not overlapping. x402-signals answers \"what should the provider do.\" This answers \"how does a third party verify it happened.\"\n\n## Implementation\n\nWe've built this as Mycelium Trails — an external anchoring layer that uses `payment_hash` as the cross-surface key between x402 settlement and post-execution evidence. The spec is in [argentum-core](https://github.com/giskard09/argentum-core) and a community plugin for the AGT EvidenceAnchor SPI is in review at microsoft/agent-governance-toolkit#2244.\n\nHappy to contribute a reference spec or fixture if the Foundation wants to document this pattern alongside x402-signals.","reactions":{"url":"https://api.github.com/repos/x402-foundation/x402/issues/2332/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/x402-foundation/x402/issues/2332/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/344","repository_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research","labels_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/344/labels{/name}","comments_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/344/comments","events_url":"https://api.github.com/repos/zhangjiayang6835-cyber/ai-research/issues/344/events","html_url":"https://github.com/zhangjiayang6835-cyber/ai-research/issues/344","id":4810957556,"node_id":"I_kwDOTGNm188AAAABHsFi9A","number":344,"title":"[BUG] WebSocket Cross-Origin Hijacking + Session Prediction $100","user":{"login":"zhangjiayang6835-cyber","id":288065324,"node_id":"U_kgDOESuHLA","avatar_url":"https://avatars.githubusercontent.com/u/288065324?v=4","gravatar_id":"","url":"https://api.github.com/users/zhangjiayang6835-cyber","html_url":"https://github.com/zhangjiayang6835-cyber","followers_url":"https://api.github.com/users/zhangjiayang6835-cyber/followers","following_url":"https://api.github.com/users/zhangjiayang6835-cyber/following{/other_user}","gists_url":"https://api.github.com/users/zhangjiayang6835-cyber/gists{/gist_id}","starred_url":"https://api.github.com/users/zhangjiayang6835-cyber/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zhangjiayang6835-cyber/subscriptions","organi