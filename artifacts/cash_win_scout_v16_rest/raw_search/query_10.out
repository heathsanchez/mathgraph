ll,"comments":115,"created_at":"2025-10-07T18:30:54Z","updated_at":"2026-07-07T06:23:09Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Some parts are \"extended promotional\" which means they act as basic for a limited time, we should have that information available in a filterable column\n\n/bounty $75","reactions":{"url":"https://api.github.com/repos/tscircuit/jlcsearch/issues/92/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/tscircuit/jlcsearch/issues/92/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3","repository_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty","labels_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/labels{/name}","comments_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/comments","events_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/events","html_url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/3","id":4148310577,"node_id":"I_kwDORx6c0M73QjIx","number":3,"title":"[BOUNTY $100] HOOK: Pre-tool-use hook that blocks destructive bash commands","user":{"login":"claudebounty","id":271393208,"node_id":"U_kgDOEC0huA","avatar_url":"https://avatars.githubusercontent.com/u/271393208?v=4","gravatar_id":"","url":"https://api.github.com/users/claudebounty","html_url":"https://github.com/claudebounty","followers_url":"https://api.github.com/users/claudebounty/followers","following_url":"https://api.github.com/users/claudebounty/following{/other_user}","gists_url":"https://api.github.com/users/claudebounty/gists{/gist_id}","starred_url":"https://api.github.com/users/claudebounty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claudebounty/subscriptions","organizations_url":"https://api.github.com/users/claudebounty/orgs","repos_url":"https://api.github.com/users/claudebounty/repos","events_url":"https://api.github.com/users/claudebounty/events{/privacy}","received_events_url":"https://api.github.com/users/claudebounty/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10532402505,"node_id":"LA_kwDORx6c0M8AAAACc8e1SQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/bounty","name":"bounty","color":"D97706","default":false,"description":"Task with financial reward"},{"id":10532402677,"node_id":"LA_kwDORx6c0M8AAAACc8e19Q","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/hook","name":"hook","color":"DC2626","default":false,"description":"Claude Code hook"},{"id":10532402829,"node_id":"LA_kwDORx6c0M8AAAACc8e2jQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/security","name":"security","color":"B91C1C","default":false,"description":"Security-related"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1356,"created_at":"2026-03-27T00:55:40Z","updated_at":"2026-07-07T06:21:17Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 💰 Bounty: $100 — powered by [Opire](https://opire.dev)\n\n## Description\nCreate a Claude Code `pre-tool-use` hook in Python or bash that intercepts\ndangerous bash commands before they are executed.\n\n## Acceptance Criteria\n- [ ] Hook follows Claude Code hooks format (`~/.claude/hooks/`)\n- [ ] Blocks these patterns: `rm -rf`, `DROP TABLE`, `git push --force`,\n      `TRUNCATE`, `DELETE FROM` without a WHERE clause\n- [ ] Logs every blocked attempt to `~/.claude/hooks/blocked.log`\n      with: timestamp, attempted command, project path\n- [ ] Displays a clear message to Claude explaining why the command was blocked\n- [ ] Does not interfere with normal bash commands\n- [ ] README with installation in 2 commands or fewer\n\n## How to Claim\n1. Comment `/opire try` in this issue\n2. Submit a PR with the hook + README\n3. Payment is released automatically on merge ✅\n\n## Resources\n- Claude Code hooks docs: https://docs.anthropic.com/claude-code/hooks","reactions":{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2","repository_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty","labels_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2/labels{/name}","comments_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2/comments","events_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2/events","html_url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/2","id":4148310390,"node_id":"I_kwDORx6c0M73QjF2","number":2,"title":"[BOUNTY $75] TEMPLATE: CLAUDE.md for a Next.js + SQLite SaaS project","user":{"login":"claudebounty","id":271393208,"node_id":"U_kgDOEC0huA","avatar_url":"https://avatars.githubusercontent.com/u/271393208?v=4","gravatar_id":"","url":"https://api.github.com/users/claudebounty","html_url":"https://github.com/claudebounty","followers_url":"https://api.github.com/users/claudebounty/followers","following_url":"https://api.github.com/users/claudebounty/following{/other_user}","gists_url":"https://api.github.com/users/claudebounty/gists{/gist_id}","starred_url":"https://api.github.com/users/claudebounty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claudebounty/subscriptions","organizations_url":"https://api.github.com/users/claudebounty/orgs","repos_url":"https://api.github.com/users/claudebounty/repos","events_url":"https://api.github.com/users/claudebounty/events{/privacy}","received_events_url":"https://api.github.com/users/claudebounty/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10532402505,"node_id":"LA_kwDORx6c0M8AAAACc8e1SQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/bounty","name":"bounty","color":"D97706","default":false,"description":"Task with financial reward"},{"id":10532402633,"node_id":"LA_kwDORx6c0M8AAAACc8e1yQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/template","name":"template","color":"2563EB","default":false,"description":"Project template"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1076,"created_at":"2026-03-27T00:55:38Z","updated_at":"2026-07-07T06:21:15Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 💰 Bounty: $75 — powered by [Opire](https://opire.dev)\n\n## Description\nCreate an opinionated, production-ready `CLAUDE.md` for a typical SaaS project\nbuilt with Next.js 15 App Router and SQLite (better-sqlite3 or Turso).\n\n## Acceptance Criteria\n- [ ] Covers: project structure, naming conventions, DB migration rules\n- [ ] Includes: dev commands, patterns to follow, anti-patterns to avoid\n- [ ] Opinionated — not generic. Every rule has a reason.\n- [ ] Usable without modification on a greenfield Next.js + SQLite project\n- [ ] Tested: create a new project, paste the CLAUDE.md, confirm Claude Code\n      understands the context without asking clarifying questions\n\n## How to Claim\n1. Comment `/opire try` in this issue\n2. Submit a PR with your CLAUDE.md\n3. Payment is released automatically on merge ✅\n\n## Expected Sections\n- Stack & versions\n- Folder structure\n- SQL / migration conventions\n- Component patterns\n- What we don't do (and why)","reactions":{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/4","repository_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty","labels_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/4/labels{/name}","comments_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/4/comments","events_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/4/events","html_url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/4","id":4148310747,"node_id":"I_kwDORx6c0M73QjLb","number":4,"title":"[BOUNTY $150] AGENT: Claude Code sub-agent that reviews a PR and posts a structured comment","user":{"login":"claudebounty","id":271393208,"node_id":"U_kgDOEC0huA","avatar_url":"https://avatars.githubusercontent.com/u/271393208?v=4","gravatar_id":"","url":"https://api.github.com/users/claudebounty","html_url":"https://github.com/claudebounty","followers_url":"https://api.github.com/users/claudebounty/followers","following_url":"https://api.github.com/users/claudebounty/following{/other_user}","gists_url":"https://api.github.com/users/claudebounty/gists{/gist_id}","starred_url":"https://api.github.com/users/claudebounty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claudebounty/subscriptions","organizations_url":"https://api.github.com/users/claudebounty/orgs","repos_url":"https://api.github.com/users/claudebounty/repos","events_url":"https://api.github.com/users/claudebounty/events{/privacy}","received_events_url":"https://api.github.com/users/claudebounty/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10532402505,"node_id":"LA_kwDORx6c0M8AAAACc8e1SQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/bounty","name":"bounty","color":"D97706","default":false,"description":"Task with financial reward"},{"id":10532402697,"node_id":"LA_kwDORx6c0M8AAAACc8e2CQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/agent","name":"agent","color":"059669","default":false,"description":"Claude Code agent"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1065,"created_at":"2026-03-27T00:55:42Z","updated_at":"2026-07-07T06:18:41Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 💰 Bounty: $150 — powered by [Opire](https://opire.dev)\n\n## Description\nCreate a Claude Code agent that takes a PR diff as input, analyzes it,\nand returns a structured Markdown review comment.\n\n## Acceptance Criteria\n- [ ] Works via CLI: `claude-review --pr https://github.com/owner/repo/pull/123`\n- [ ] OR via GitHub Action (include the workflow YAML)\n- [ ] Structured Markdown output with:\n  - Summary of changes (2–3 sentences)\n  - Identified risks (list)\n  - Improvement suggestions (list)\n  - Confidence score: Low / Medium / High\n- [ ] Tested on at least 2 real GitHub PRs (include outputs in the PR)\n- [ ] README with setup and usage instructions\n\n## How to Claim\n1. Comment `/opire try` in this issue\n2. Submit a PR with the agent + sample outputs\n3. Payment is released automatically on merge ✅","reactions":{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/4/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/4/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/moorcheh-ai/memanto/issues/770","repository_url":"https://api.github.com/repos/moorcheh-ai/memanto","labels_url":"https://api.github.com/repos/moorcheh-ai/memanto/issues/770/labels{/name}","comments_url":"https://api.github.com/repos/moorcheh-ai/memanto/issues/770/comments","events_url":"https://api.github.com/repos/moorcheh-ai/memanto/issues/770/events","html_url":"https://github.com/moorcheh-ai/memanto/issues/770","id":4735571260,"node_id":"I_kwDORu6bf88AAAABGkMVPA","number":770,"title":"[BOUNTY $100] 🐜The Memanto Bug & Exploit Challenge","user":{"login":"Xenogents","id":68768092,"node_id":"MDQ6VXNlcjY4NzY4MDky","avatar_url":"https://avatars.githubusercontent.com/u/68768092?v=4","gravatar_id":"","url":"https://api.github.com/users/Xenogents","html_url":"https://github.com/Xenogents","followers_url":"https://api.github.com/users/Xenogents/followers","following_url":"https://api.github.com/users/Xenogents/following{/other_user}","gists_url":"https://api.github.com/users/Xenogents/gists{/gist_id}","starred_url":"https://api.github.com/users/Xenogents/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Xenogents/subscriptions","organizations_url":"https://api.github.com/users/Xenogents/orgs","repos_url":"https://api.github.com/users/Xenogents/repos","events_url":"https://api.github.com/users/Xenogents/events{/privacy}","received_events_url":"https://api.github.com/users/Xenogents/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10849173787,"node_id":"LA_kwDORu6bf88AAAAChqlBGw","url":"https://api.github.com/repos/moorcheh-ai/memanto/labels/bounty","name":"bounty","color":"fcf22a","default":false,"description":"This issue has a bounty attached to it"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":172,"created_at":"2026-06-24T14:09:09Z","updated_at":"2026-07-07T06:13:35Z","closed_at":null,"assignee":null,"author_association":"COLLABORATOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Description\nIn our last bounty, we asked the community to benchmark **Memanto** against the competition. You helped us prove that our active companion memory agent backed by our `moorcheh.ai` retrieval engine is uniquely resilient at handling shifting user preferences and maintaining long-term context without token bloat or memory degradation.\n\nNow, we are doing the exact opposite. \n\nWe believe Memanto is production-ready. But the best way to prove that is to invite the smartest engineers and red teamers to try and tear it down. \n\nWe are launching the **Memanto Bug Challenge** to uncover edge cases, logic loops, memory inconsistencies, and security vulnerabilities. If you can break our memory management, we want to know about it.\n\nThe Bounty: $100 USD (Paid via BountyHub)\n\n---\n\n## 🎯 Threat Model & Scope\nYour target is the `memanto` core package and its interaction with the `moorcheh.ai` serverless backend. We are specifically looking for vulnerabilities and logic flaws that affect memory integrity, context window stability, and retrieval accuracy.\n\n### ✅ In Scope (What we want you to find)\n*   **Retrieval Quality & Accuracy:** Fails to recall highly relevant facts, loses track of when an event occurred (timeline amnesia), hallucinates sources, or fails to properly resolve direct contradictions.\n*   **Architectural & Logic Flaws:** Bad logic loops, poor contradiction handling, or inefficient background processes that severely slow down the agent.\n*   **Usability & Friction:** Is it too hard to set up? Are there major UX roadblocks preventing adoption?\n*   **Missing Core Features:** Missing support for critical use cases (e.g., lack of multi-agent support or complex workflows).\n*   **Security Vulnerabilities:** Any traditional security flaws, data leaks, or prompt injections.\n*   **Anything Else:** If you find a creative way to break or improve the memory layer, it's in scope!\n\n### 🚫 Out of Scope (Do not test these)\n*   Volumetric DDoS attacks against `moorcheh.ai` infrastructure.\n*   General LLM hallucinations unrelated to Memanto's memory handling.\n*   Attacks that require compromising the underlying operating system or Docker host to succeed.\n\n---\n\n### **🛠️ Implementation Guidelines:**\n\nTo ensure your submission qualifies for the bounty, your execution must follow this exact flow:\n\n*   **1. Find & Isolate:** Discover a bug, logic flaw, missing feature, or vulnerability within the Memanto core package.\n*   **2. Prove Reproducibility:** You must provide clear steps, a minimal Python script, or a test case that allows the maintainers to reproduce the bug exactly as you experienced it. If we can't reproduce it, we can't score it.\n*   **3. Implement the Fix (or Document the Flaw via PR):** Because this bounty is hosted on BountyHub, **all submissions must be Pull Requests.** We highly encourage writing the actual code to resolve the bug. However, if an issue requires massive architectural changes or involves backend systems you cannot fix from your end, you can still submit a PR! Instead of a code fix, submit a PR that adds a reproducible failing test script (e.g., to `tests/failing_tests/`) or a detailed Markdown report (e.g., to `docs/bounty_reports/`) outlining the problem and a proposed structural solution.\n\n### 📊 Judgment Method (The Success Matrix):\nTo ensure we reward actual engineering value and meaningful security research, submissions will be scored on a 100-point matrix split between **Technical Rigor** and **Impact**.\n\n| Criteria | Max Points | How it is Measured |\n| :--- | :--- | :--- |\n| **Severity & Impact** | 60 pts | How critical is the vulnerability, and does it affect a realistic production scenario? (e.g., highly relevant data corruption scores higher than a contrived edge case). |\n| **Reproducibility & Cleanliness** | 25 pts | Is the exploit perfectly replicable? Are scripts, dependency files, and clear instructions provided? Does the PoC work consistently? |\n| **Social Amplification** | 15 pts | Measured via public engagement metrics. |\n\n**The Social Formula:**\n\n`Social Points = (Reddit Upvotes x 4) + (Reddit Comments x 3) + (X Bookmarks x 5) + (X Retweets x 3) + (GitHub PR Reactions x 2)`\n\n### 🚨 Severity Guidelines\nWhile any bug or flaw is in scope, we prioritize and score based on the following guidelines for issue severity:\n\n| Severity | Description |\n| :--- | :--- |\n| **Critical / High** | Poor recall accuracy, losing track of timelines/dates, missing source attribution, deeply flawed contradiction handling, severe logic loops, major security vulnerabilities, or extreme performance bottlenecks (e.g., core systems freezing). |\n| **Medium** | Missing features (e.g., lacks multi-agent support), setup friction, UX roadblocks, or moderate inefficiencies that degrade the user experience. |\n| **Low** | Minor CLI/UI display bugs, non-critical feature requests, or simple documentation errors. |\n\n---\n\n### **🚀 Step-by-Step Instructions to Participate:**\n\n1. **Star the Repository:** Help us clear our next star milestone this month! ⭐️\n2. **Get Your Key:** Sign up at [moorcheh.ai](https://moorcheh.ai/) and configure your environment variables.\n3. **Hunt & Develop:** Identify a bug, feature gap, or logic flaw. Write a minimal script, test case, or detailed report demonstrating it.\n4. **Implement the Fix (or Document the Flaw):** Write the code to fix the vulnerability or add the missing feature. If the fix is too massive or simply cannot be fixed from your end (e.g., backend API issues), write a reproducible failing test script or a comprehensive Markdown report detailing the problem and your proposed solution.\n5. **Submit PR:** Fork this repo and create a Pull Request (required by BountyHub). Commit either your code fix, your failing test script, or your Markdown report. **Your PR description must contain a summary of the flaw, reproduction steps, and your fix or architectural proposal.** *(Note: If you uncover actual security vulnerabilities like data leaks, **do not open a public PR.** Please use GitHub's Private Vulnerability Reporting feature or email `support@moorcheh.ai` first).*\n6. **Amplify:** Write an in-depth post on Reddit or X and mention @moorcheh_ai showing off your deep dive into Memanto's architecture and how you improved it.\n\n> 📅 **Deadline:** All submissions must be submitted and active by **Aug 1, 2026 (11:59 PM UTC)** to be eligible for the success matrix audit.\n\n**Community and Support:** [Discord](https://discord.gg/CyxRFQSQ3p)","reactions":{"url":"https://api.github.com/repos/moorcheh-ai/memanto/issues/770/reactions","total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/moorcheh-ai/memanto/issues/770/timeline","performed_via_github_app":null,"state_reason":"reopened","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/auscaster/frantic-board/issues/106","repository_url":"https://api.github.com/repos/auscaster/frantic-board","labels_url":"https://api.github.com/repos/auscaster/frantic-board/issues/106/labels{/name}","comments_url":"https://api.github.com/repos/auscaster/frantic-board/issues/106/comments","events_url":"https://api.github.com/repos/auscaster/frantic-board/issues/106/events","html_url":"https://github.com/auscaster/frantic-board/issues/106","id":4709389907,"node_id":"I_kwDOS3gB3c8AAAABGLOWUw","number":106,"title":"Frantic bounty #49: Give runx some love","user":{"login":"auscaster","id":100876,"node_id":"MDQ6VXNlcjEwMDg3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/100876?v=4","gravatar_id":"","url":"https://api.github.com/users/auscaster","html_url":"https://github.com/auscaster","followers_url":"https://api.github.com/users/auscaster/followers","following_url":"https://api.github.com/users/auscaster/following{/other_user}","gists_url":"https://api.github.com/users/auscaster/gists{/gist_id}","starred_url":"https://api.github.com/users/auscaster/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/auscaster/subscriptions","organizations_url":"https://api.github.com/users/auscaster/orgs","repos_url":"https://api.github.com/users/auscaster/repos","events_url":"https://api.github.com/users/auscaster/events{/privacy}","received_events_url":"https://api.github.com/users/auscaster/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11204444633,"node_id":"LA_kwDOS3gB3c8AAAACm9ZB2Q","url":"https://api.github.com/repos/auscaster/frantic-board/labels/bounty","name":"bounty","color":"5319e7","default":false,"description":"Frantic bounty mirror"},{"id":11281275972,"node_id":"LA_kwDOS3gB3c8AAAACoGqcRA","url":"https://api.github.com/repos/auscaster/frantic-board/labels/funded","name":"funded","color":"fbca04","default":false,"description":"Funded and backed by budget"},{"id":11281276110,"node_id":"LA_kwDOS3gB3c8AAAACoGqczg","url":"https://api.github.com/repos/auscaster/frantic-board/labels/available","name":"available","color":"0e8a16","default":false,"description":"Open for claim"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":279,"created_at":"2026-06-21T04:58:06Z","updated_at":"2026-07-07T05:54:21Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Frantic bounty #49\n\nGive runx some love\n\nWorker price: $0\nSlots: 100 (62 available)\nStatus: Available\nClaim: https://gofrantic.com/bounties/49\nFunding receipt: https://gofrantic.com/r/a24418a1cd8b\n\nFrantic is the source of truth. This GitHub issue is a mirrored board thread.\n\n<!-- runx-outbox-envelope: v1 -->\n<!-- runx-outbox-entry: frantic:bounty:49 -->\n<!-- runx-outbox-metadata:  -->\n","reactions":{"url":"https://api.github.com/repos/auscaster/frantic-board/issues/106/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/auscaster/frantic-board/issues/106/timeline","performed_via_github_app":null,"state_reason":"reopened","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/tenstorrent/tt-metal/issues/32187","repository_url":"https://api.github.com/repos/tenstorrent/tt-metal","labels_url":"https://api.github.com/repos/tenstorrent/tt-metal/issues/32187/labels{/name}","comments_url":"https://api.github.com/repos/tenstorrent/tt-metal/issues/32187/comments","events_url":"https://api.github.com/repos/tenstorrent/tt-metal/issues/32187/events","html_url":"https://github.com/tenstorrent/tt-metal/issues/32187","id":3609136414,"node_id":"I_kwDOI9Wqc87XHw0e","number":32187,"title":"[Bounty $1500] LLVC (Low-Latency Low-Resource Voice Conversion) bring up using TTNN APIs","user":{"login":"tvardhineniTT","id":225911693,"node_id":"U_kgDODXcjjQ","avatar_url":"https://avatars.githubusercontent.com/u/225911693?v=4","gravatar_id":"","url":"https://api.github.com/users/tvardhineniTT","html_url":"https://github.com/tvardhineniTT","followers_url":"https://api.github.com/users/tvardhineniTT/followers","following_url":"https://api.github.com/users/tvardhineniTT/following{/other_user}","gists_url":"https://api.github.com/users/tvardhineniTT/gists{/gist_id}","starred_url":"https://api.github.com/users/tvardhineniTT/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tvardhineniTT/subscriptions","organizations_url":"https://api.github.com/users/tvardhineniTT/orgs","repos_url":"https://api.github.com/users/tvardhineniTT/repos","events_url":"https://api.github.com/users/tvardhineniTT/events{/privacy}","received_events_url":"https://api.github.com/users/tvardhineniTT/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":7931645110,"node_id":"LA_kwDOI9Wqc88AAAAB2MNMtg","url":"https://api.github.com/repos/tenstorrent/tt-metal/labels/bounty","name":"bounty","color":"aaaaaa","default":false,"description":null},{"id":7931705304,"node_id":"LA_kwDOI9Wqc88AAAAB2MQ32A","url":"https://api.github.com/repos/tenstorrent/tt-metal/labels/bounty_difficulty/medium","name":"bounty_difficulty/medium","color":"EE8199","default":false,"description":"Medium Bounty"},{"id":9462912915,"node_id":"LA_kwDOI9Wqc88AAAACNAiXkw","url":"https://api.github.com/repos/tenstorrent/tt-metal/labels/model%20bringup","name":"model bringup","color":"fa8c2b","default":false,"description":"For model initialization or bring-up stage bounties"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":52,"created_at":"2025-11-10T18:07:10Z","updated_at":"2026-07-07T05:25:26Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### 📝 Background\n\nThis bounty is for bringing up the **LLVC (Low-Latency Low-Resource Voice Conversion)** model using TTNN APIs on Tenstorrent hardware (Wormhole or Blackhole).\n\nLLVC is a real-time voice conversion model from Koe AI specifically optimized for low latency and CPU efficiency. Published in 2023, key features include:\n\n* **Ultra-low latency**: Designed for real-time voice conversion with minimal delay\n* **CPU-optimized**: Efficient enough to run on CPU in real-time\n* **Streaming support**: True streaming inference with chunked processing\n* **High quality**: Natural voice conversion while maintaining low latency\n* **Compatible architecture**: Based on RVC/QuickVC with optimizations\n* **Small model size**: Low resource requirements for edge deployment\n* **No F0 dependency**: Optional pitch-independent conversion mode\n* **MIT License**: Free for commercial use\n\nLLVC achieves real-time factor (RTF) < 0.1 on CPU, making it suitable for live applications like real-time dubbing, streaming, gaming voice chat, and interactive voice applications.\n\nThe goal is to enable this model to run on TT hardware for ultra-high-throughput, ultra-low-latency voice conversion optimized for real-time applications.\n\n\n### 🎯 What Success Looks Like\n\nA successful submission will fulfill all requirements in the following stages. Payout is made after all three stages are completed.\n\n\n### Stage 1 — Bring-Up\n\n* Implement LLVC using TTNN APIs (Python)\n* Implements the full generation pipeline:\n  * Lightweight encoder (optimized for low latency)\n  * Streaming-capable architecture\n  * Efficient decoder\n  * Optional pitch extraction (F0-based and F0-free modes)\n  * Vocoder integration\n* Model runs on either N150 or N300 Tenstorrent hardware with no errors\n* Supports both modes:\n  * **Streaming mode**: Real-time conversion with chunked processing\n  * **Non-streaming mode**: Full-context conversion\n* Produces valid converted audio output\n* Output is verifiable (audio quality assessment, compare with PyTorch reference)\n* Achieves baseline throughput target:\n  * At least 50 tokens/second for decoder generation\n  * Real-time factor (RTF) < 0.3 for streaming mode\n  * Latency < 100ms for streaming chunks\n* Accuracy evaluation:\n  * Speaker similarity > 70% (cosine similarity)\n  * Content preservation: WER < 3.0\n  * Token-level accuracy > 95% against PyTorch reference\n* Audio quality: Natural prosody with minimal artifacts despite low latency\n* Clear instructions for setup and running the model\n\n### Stage 2 — Basic Optimizations\n\n* Use optimal sharded/interleaved memory configs for encoder-decoder layers\n* Implement efficient sharding strategy for:\n  * Lightweight encoder layers\n  * Decoder layers optimized for streaming\n  * Convolutional layers with causal padding\n  * Cached convolution states for streaming\n  * Optional pitch extraction module\n* Fuse simple ops where possible (e.g., layer normalization, activation functions)\n* Store intermediate activations in L1 where beneficial\n* Use recommended TTNN/tt-metal flows for streaming audio models\n* Leverage TT library of fused ops for convolution blocks\n* Optimize chunk-based processing for streaming\n* Efficient state management for causal convolutions\n* Optimize vocoder integration\n\n### Stage 3 — Deeper Optimization\n\n* Maximize core counts used per inference\n* Implement deeper TT-specific optimizations:\n  * Ultra-low latency streaming (minimize chunk processing time)\n  * Efficient causal convolution with state caching\n  * Flash Attention or equivalent where applicable\n  * Minimize voice conversion latency per chunk\n  * Batch processing for multiple concurrent streams\n  * Pipeline encoder/decoder/vocoder stages\n  * Optimize memory footprint for edge deployment\n* Minimize memory and TM (tensor manipulation) overheads\n* Explore look-ahead strategies for quality vs latency trade-off\n* Document any advanced tuning, known limitations, or trade-offs\n* Target stretched goals:\n  * 100+ tokens/second generation speed\n  * RTF < 0.1 for streaming mode (match CPU performance)\n  * Latency < 50ms for streaming chunks\n  * Support for 10+ concurrent streams\n\n### 🧭 Guidance & Starting Points\n\n* Use the [TTNN model bring-up tech report](https://github.com/tenstorrent/tt-metal/blob/main/tech_reports/ttnn/TTNN-model-bringup.md) as your primary reference\n* Reference [streaming audio model patterns in tt-metal](https://github.com/tenstorrent/tt-metal/tree/main/models/demos) for streaming architectures\n* Use the [official LLVC repository](https://github.com/KoeAI/LLVC) for model architecture details\n* Refer to the [LLVC paper (arXiv:2311.00873)](https://arxiv.org/abs/2311.00873) for technical details\n* Check [LLVC demo page](https://koeai.github.io/llvc-demo/) for audio samples\n* Refer to [TT Fused ops PR #29236](https://github.com/tenstorrent/tt-metal/pull/29236) for optimization opportunities\n* The model architecture consists of:\n  * **Lightweight encoder**: Optimized convolutional layers with reduced complexity\n  * **Cached convolutions**: State management for causal streaming inference\n  * **Efficient decoder**: Minimal layers for low latency\n  * **Optional F0 module**: Pitch extraction when needed\n  * **Vocoder**: HiFi-GAN or similar (can be shared with other models)\n* Key challenges:\n  * Ultra-low latency requirements (< 100ms)\n  * Streaming inference with causal convolutions\n  * State management across chunks\n  * Quality vs latency trade-off\n  * Vocoder integration and optimization\n  * Small model size constraints\n* Streaming parameters:\n  * `window_ms`: Chunk size in milliseconds (affects latency)\n  * `extra_convert_size`: Extra context for quality (affects latency)\n* Ask for help or file issues if ops are missing in TTNN\n\n\n### 🔎 Possible Approaches\n\n* Start from the [official LLVC repository](https://github.com/KoeAI/LLVC) and port components sequentially:\n  1. Lightweight encoder (optimized convolutions)\n  2. Cached convolution layers for streaming\n  3. Efficient decoder\n  4. Optional pitch extraction (F0 mode)\n  5. Vocoder integration\n  6. Streaming inference pipeline with state management\n* Validate each submodule's output against PyTorch reference before integration\n* Experiment with different sharding strategies:\n  * Channel sharding for convolutions\n  * Sequence length sharding for chunks\n  * Minimize cross-chip communication\n* Use TTNN profiling tools to identify bottlenecks in:\n  * Per-chunk processing time (critical metric)\n  * Encoder latency\n  * Decoder latency\n  * State management overhead\n  * Vocoder latency\n* Test diverse use cases:\n  * Streaming mode with various chunk sizes (50ms, 100ms, 200ms)\n  * Non-streaming mode for comparison\n  * F0-based vs F0-free modes\n  * Multiple concurrent streams\n  * Real-time conversion scenarios\n* Open a draft PR early to get feedback on your approach\n\n\n\n## 📊 Result Submission Guidelines\n\nBeyond the model implementation itself, contributors must submit the following material as proof of work.\nHowever, feel free to open a PR at any time if you want us checking that you are on the right track.\nJust understand that payout is only made after **all 3 stages** are completed.\n\n**Deliverables:**\n- Functional model implementation\n- Validation logs (output correctness)\n- Performance report + header for final review\n\n**Links:**\n- [Performance Sheet](https://github.com/tenstorrent/tt-metal/blob/main/tech_reports/ttnn/TTNN-model-bringup.md#41-performance-sheet)\n- [Perf Header Docs](https://docs.tenstorrent.com/tt-metal/latest/ttnn/ttnn/profiling_ttnn_operations.html#perf-report-headers)\n\n\n### 📚 Resources\n\n### Model Resources\n\n* [LLVC Official Repository](https://github.com/KoeAI/LLVC)\n* [LLVC Paper (arXiv:2311.00873)](https://arxiv.org/abs/2311.00873)\n* [LLVC Demo Page](https://koeai.github.io/llvc-demo/)\n* [LLVC Paper PDF](https://koe.ai/papers/llvc.pdf)\n* [Koe AI Homepage](https://koe.ai/)\n* [RVC Repository (related)](https://github.com/RVC-Project/Retrieval-based-Voice-Conversion-WebUI)\n\n### TT-Metal Resources\n\n* [TTNN Model Bring-up Tech Report](https://github.com/tenstorrent/tt-metal/blob/main/tech_reports/ttnn/TTNN-model-bringup.md)\n* [Streaming Audio Models in tt-metal](https://github.com/tenstorrent/tt-metal/tree/main/models/demos)\n* [TT Fused Ops PR #29236](https://github.com/tenstorrent/tt-metal/pull/29236)\n* [Performance Report Header](https://docs.tenstorrent.com/tt-metal/latest/ttnn/ttnn/profiling_ttnn_operations.html#perf-report-headers)","reactions":{"url":"https://api.github.com/repos/tenstorrent/tt-metal/issues/32187/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/tenstorrent/tt-metal/issues/32187/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/osmosis-labs/orderbook/issues/211","repository_url":"https://api.github.com/repos/osmosis-labs/orderbook","labels_url":"https://api.github.com/repos/osmosis-labs/orderbook/issues/211/labels{/name}","comments_url":"https://api.github.com/repos/osmosis-labs/orderbook/issues/211/comments","events_url":"https://api.github.com/repos/osmosis-labs/orderbook/issues/211/events","html_url":"https://github.com/osmosis-labs/orderbook/issues/211","id":4825459761,"node_id":"I_kwDOLTG9Js8AAAABH56sMQ","number":211,"title":"[Bug Report] `Orderbook.next_bid_tick`/`next_ask_tick` are never retracted on a cancel or an exact-drain sweep — a stale/phantom best price until an unrelated later sweep happens to walk past the empty tick","user":{"login":"OPTIONPOOL","id":51193664,"node_id":"MDQ6VXNlcjUxMTkzNjY0","avatar_url":"https://avatars.githubusercontent.com/u/51193664?v=4","gravatar_id":"","url":"https://api.github.com/users/OPTIONPOOL","html_url":"https://github.com/OPTIONPOOL","followers_url":"https://api.github.com/users/OPTIONPOOL/followers","following_url":"https://api.github.com/users/OPTIONPOOL/following{/other_user}","gists_url":"https://api.github.com/users/OPTIONPOOL/gists{/gist_id}","starred_url":"https://api.github.com/users/OPTIONPOOL/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/OPTIONPOOL/subscriptions","organizations_url":"https://api.github.com/users/OPTIONPOOL/orgs","repos_url":"https://api.github.com/users/OPTIONPOOL/repos","events_url":"https://api.github.com/users/OPTIONPOOL/events{/privacy}","received_events_url":"https://api.github.com/users/OPTIONPOOL/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-07-07T05:14:31Z","updated_at":"2026-07-07T05:14:31Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"\nFound while integrating `sumtree-orderbook` into an open matching-engine benchmark, the [Matching Engine Performance Challenge](https://github.com/flash1-dev/matching-engine-benchmark) — it cross-checks engines against the byte-identical consensus of other conforming order books, including a book-state audit that probes `best_bid`/`best_ask`/`depth_at` at many points through a replayed order flow, not just the final report stream. This surfaces the moment the *only* resting order at the current best price is cancelled, or a market-order sweep exactly exhausts the last tick it visits: `next_bid_tick`/`next_ask_tick` keep naming that tick even though it now holds zero resting liquidity, so `query::spot_price` (and any other caller reading these two fields directly, as this contract's own query surface does) reports a phantom price until some later, unrelated sweep happens to walk past the empty tick and clean it up as an incidental side effect of its own traversal. No trade is ever mispriced by this — the fault is purely in the book state a query reads in the window before that self-heal happens.\n\nPinned at `master` (`f49dffce99b2c46284b8ec15de5e16a3efaf4e56`).\n\n## Environment\n\n- Commit `f49dffce99b2c46284b8ec15de5e16a3efaf4e56`, Rust 1.96 (edition 2021), `cosmwasm-std = \"1.5.4\"`, `cosmwasm-schema = \"1.5.0\"`, `cw-storage-plus = \"1.1.0\"`.\n- Built with the crate's own `library` feature (`Cargo.toml`: \"use library feature to disable all instantiate/execute/query exports\") so `contract::instantiate`/`contract::execute` remain plain, directly-callable Rust functions against `cosmwasm_std::testing::mock_dependencies()` — no chain, no `wasmvm`, no CosmWasm-pool routing. This is the same seam the crate's own `dev-dependencies` (`cw-multi-test`, `osmosis-test-tube`) drive it through for its own integration tests.\n- `sudo::sudo` is reachable the same way; its own `#[cfg_attr(not(feature = \"imported\"), entry_point)]` names a feature that does not exist in this crate's `Cargo.toml`, so it is unconditionally a plain function on a native build target regardless of `library`.\n\n## What happens\n\nRest two bids at ticks 100 and 99 (a bid at 100 is currently the best). Cancel the only order resting at 100. The cancel itself is correct — `total_amount_of_liquidity` for tick 100's bid side correctly drops to zero, and 99 is still fully resting. But `Orderbook.next_bid_tick` is left at 100. A caller asking \"what's the best bid\" via `query::spot_price` — or any other consumer that reads `next_bid_tick` directly, as that query itself does — gets back the dead price 100, not the real best bid of 99, until some unrelated later order happens to sweep down through 100 and reach 99, at which point `run_market_order_internal`'s own tick-iteration loop advances the pointer as an incidental side effect of walking past the now-empty tick.\n\nA second, distinct trigger: a market-order sweep whose own remaining input reaches exactly zero on the very last tick it visits leaves the pointer pointing at that tick even though the sweep itself just fully drained it to zero liquidity, in the *same* call — see \"Mechanism\" below for exactly why.\n\n## Minimal reproduction\n\nEvery call below is the engine's own public, unmodified API — `contract::instantiate`, `contract::execute`, `sudo::sudo` — driven directly against `MockStorage`, the same pattern `cw-multi-test`-based integration tests already use for this contract (no `#[define private public]`-style trick needed; nothing here is private).\n\n```rust\n// repro.rs -- add as a [[bin]] to a throwaway crate depending on\n// { path = \".../contracts/sumtree-orderbook\", default-features = false, features = [\"library\"] }\nuse cosmwasm_std::testing::{mock_dependencies, mock_env, mock_info};\nuse cosmwasm_std::{coin, Uint128};\nuse sumtree_orderbook::contract;\nuse sumtree_orderbook::msg::{ExecuteMsg, InstantiateMsg};\nuse sumtree_orderbook::state::ORDERBOOK;\nuse sumtree_orderbook::types::OrderDirection;\n\nfn main() {\n    let mut deps = mock_dependencies();\n    // create_orderbook() requires a nonzero bank supply for both denoms.\n    deps.querier.update_balance(\"holder\", vec![coin(1, \"base\"), coin(1, \"quote\")]);\n    contract::instantiate(deps.as_mut(), mock_env(), mock_info(\"creator\", &[]),\n        InstantiateMsg { base_denom: \"base\".into(), quote_denom: \"quote\".into() }).unwrap();\n\n    let place = |deps: cosmwasm_std::DepsMut, tick: i64, qty: u128| {\n        contract::execute(deps, mock_env(), mock_info(\"owner\", &[coin(qty, \"quote\")]),\n            ExecuteMsg::PlaceLimit { tick_id: tick, order_direction: OrderDirection::Bid,\n                quantity: Uint128::new(qty), claim_bounty: None }).unwrap();\n    };\n    place(deps.as_mut(), 100, 10);   // order 0: the best bid\n    place(deps.as_mut(), 99, 7);     // order 1: next best\n\n    println!(\"next_bid_tick before cancel: {}\", ORDERBOOK.load(deps.as_ref().storage).unwrap().next_bid_tick);\n\n    // Cancel the ONLY order resting at the current best (tick 100, order_id 0).\n    contract::execute(deps.as_mut(), mock_env(), mock_info(\"owner\", &[]),\n        ExecuteMsg::CancelLimit { tick_id: 100, order_id: 0 }).unwrap();\n\n    let ob = ORDERBOOK.load(deps.as_ref().storage).unwrap();\n    println!(\"next_bid_tick after cancelling the only order @100: {} (MIN_TICK sentinel would be -108000000; \\\n              the TRUE best bid is now 99, still fully resting)\", ob.next_bid_tick);\n}\n```\n\nOutput against `f49dffce9`:\n\n```\nnext_bid_tick before cancel: 100\nnext_bid_tick after cancelling the only order @100: 100 (MIN_TICK sentinel would be -108000000; the TRUE best bid is now 99, still fully resting)\n```\n\nExpected: `next_bid_tick` should read `99` (the real, still fully-resting best bid) after cancelling the order at 100. Actual: it still reads `100`, a tick with zero resting bid liquidity (confirmed independently: `TICK_STATE.load(deps.as_ref().storage, 100).unwrap().bid_values.total_amount_of_liquidity` is `Decimal256::zero()` immediately after the cancel). `query::spot_price(deps, \"quote\", \"base\")` — the contract's own, unmodified public query — calls `tick_to_price(orderbook.next_bid_tick)` directly and would return the price at the dead tick 100, not 99.\n\n### Second trigger: an exact-drain market-order sweep\n\nSame shape, reached from the sweep side instead of the cancel side: rest three bids of equal size at 100, cancel one (still 100 has two resting, `next_bid_tick` stays 100, correctly — 100 still has live liquidity), then run a `SudoMsg::SwapExactAmountIn`/`SwapToTick` (Ask direction, `target_tick: 100`) sized to consume *exactly* the two remaining orders' full liquidity and nothing more. After that call, tick 100's bid liquidity is exactly zero, but `next_bid_tick` still reads 100 — the sweep never advances past it, because there is no further tick to advance to (see \"Mechanism\").\n\n## Mechanism\n\n`Orderbook.next_bid_tick`/`next_ask_tick` (`contracts/sumtree-orderbook/src/types/orderbook.rs:14-15`) are touched in exactly two places, and both only ever move the pointer *toward* more liquidity, never away from an emptied one:\n\n1. `order::place_limit` (`order.rs:76-89`) **extends** the pointer only when a *new* order beats the current one:\n   ```rust\n   match order_direction {\n       OrderDirection::Bid => {\n           if tick_id > orderbook.next_bid_tick {\n               orderbook.next_bid_tick = tick_id;\n           }\n       }\n       OrderDirection::Ask => { /* symmetric */ }\n   }\n   ```\n2. `order::run_market_order_internal` (`order.rs:522-530`) **advances** the pointer forward as its own tick-sweep loop visits ticks:\n   ```rust\n   if output_quantity.is_zero() {\n       order.quantity = Uint128::zero();\n       break;                                 // <-- returns BEFORE the pointer update below\n   }\n   // ...\n   match order.order_direction.opposite() {\n       OrderDirection::Ask => orderbook.next_ask_tick = current_tick_id,\n       OrderDirection::Bid => orderbook.next_bid_tick = current_tick_id,\n   }\n   ```\n   Because the `is_zero()` check and `break` (line 522) come *before* the pointer-update statement (lines 529-530) in the loop body, a sweep whose remaining input reaches exactly zero while visiting the tick that exactly drains it never executes the pointer update for that tick's *successor* — but it already updated the pointer *to* that tick on the iteration that processed it, so the net effect is: the pointer is left exactly on the tick the sweep just fully drained to zero, rather than on whatever (if anything) comes after it.\n\n`order::cancel_limit` (`order.rs:138-242`) is the third and last place a tick's resting liquidity can change (`curr_tick_values.total_amount_of_liquidity = checked_sub(...)`, `order.rs:214-216`) — and, although it does `ORDERBOOK.load` once (`order.rs:201`) solely to fetch the refund denoms, it **never *writes* `ORDERBOOK` and never reads or touches `next_bid_tick`/`next_ask_tick`**. There is no code path anywhere in `cancel_limit` that checks whether the order being cancelled was resting at the currently-tracked best tick, or whether that tick is now empty.\n\n`query::spot_price` (`query.rs:34-70`) is the contract's own, public, unmodified consumer of these two fields, and reads them exactly as stored, with no defensive scan:\n\n```rust\nlet next_tick = match direction {\n    OrderDirection::Ask => orderbook.next_bid_tick,\n    OrderDirection::Bid => orderbook.next_ask_tick,\n};\nlet price = tick_to_price(next_tick)?;\n```\n\nSo a stale pointer is not merely an internal bookkeeping quirk invisible to callers — it is directly what this contract's own price-quoting entry point returns to a caller asking for the current spot price (relevant since this contract registers itself as a CosmWasm Pool, and `spot_price`/`calc_out_amount_given_in` are the exact query surface `x/poolmanager` and any price-aggregating integrator would call).\n\nThe staleness is always eventually self-correcting and never mis-prices a fill: `run_market_order_internal`'s own loop skips a zero-liquidity tick unconditionally (`if current_tick_values.total_amount_of_liquidity.is_zero() { continue; }`, `order.rs` inside the same loop, a few lines above the code quoted above) before it ever computes a fill against it, and correctly advances the pointer once it reaches the next tick that does have liquidity. The bug is a pure state-query issue in the window before that next sweep happens — but that window can be arbitrarily long (any number of blocks until the next swap on that side), and during it, `spot_price` genuinely misreports.\n\n## Suggested fix\n\nRetract the pointer at the two places that can leave it stale, scanning only when the currently-tracked tick has actually gone to zero (so the common case — the tracked tick is still live — costs nothing beyond one `TICK_STATE` read):\n\n```rust\nfn retrack_best_tick_pointer(\n    storage: &mut dyn Storage,\n    ob: &mut Orderbook,\n    direction: OrderDirection,\n) -> Result<(), ContractError> {\n    let (current, sentinel) = match direction {\n        OrderDirection::Bid => (ob.next_bid_tick, MIN_TICK),\n        OrderDirection::Ask => (ob.next_ask_tick, MAX_TICK),\n    };\n    if current == sentinel {\n        return Ok(());\n    }\n    let still_live = TICK_STATE\n        .load(storage, current)\n        .map(|t| !t.get_values(direction).total_amount_of_liquidity.is_zero())\n        .unwrap_or(false);\n    if still_live {\n        return Ok(());\n    }\n    let new_ptr = match direction {\n        OrderDirection::Bid => TICK_STATE\n            .range(storage, Some(Bound::inclusive(MIN_TICK)), Some(Bound::exclusive(current)), Order::Descending)\n            .find_map(|r| { let (id, st) = r.ok()?;\n                if st.bid_values.total_amount_of_liquidity.is_zero() { None } else { Some(id) } })\n            .unwrap_or(MIN_TICK),\n        OrderDirection::Ask => TICK_STATE\n            .range(storage, Some(Bound::exclusive(current)), Some(Bound::inclusive(MAX_TICK)), Order::Ascending)\n            .find_map(|r| { let (id, st) = r.ok()?;\n                if st.ask_values.total_amount_of_liquidity.is_zero() { None } else { Some(id) } })\n            .unwrap_or(MAX_TICK),\n    };\n    match direction {\n        OrderDirection::Bid => ob.next_bid_tick = new_ptr,\n        OrderDirection::Ask => ob.next_ask_tick = new_ptr,\n    }\n    Ok(())\n}\n```\n\nCalled from `cancel_limit` right after its existing `TICK_STATE.save` (so it observes the just-updated liquidity), passing `order.order_direction`; and from `run_market_order` (the outer wrapper, after its own `TICK_STATE.save` loop over `tick_updates`), passing `order.order_direction.opposite()` — the side whose liquidity the sweep just consumed. Neither call site touches a fill quantity, a price, or FIFO order; both only correct the auxiliary best-price pointer cache.\n\nI built and ran this exact fix against `f49dffce9` (native, via `mock_dependencies`, the same harness described above): the two repro scenarios above both now report the correct pointer (`99` and the `MIN_TICK`/`MAX_TICK` empty-book sentinel, respectively, in the cases that should produce them), and a 33-case conformance battery covering FIFO priority, multi-level sweeps, partial fills, stale cancels/modifies, and book-state probes at every message index — all oracled against three independent, unrelated order-book implementations — passes both its report-stream-hash and book-state dimensions with the fix applied (the report-stream dimension already passed without it; only the book-state dimension needed this fix).\n\n---\n\nThis is just a time-stamped snapshot of one specific commit, offered back in case it's useful — not a comment on the project, which is otherwise a clean, well-tested sumtree design (the ETAS/prefix-sum lazy-fill accounting in particular is a neat way to keep a market-order sweep O(ticks touched) instead of O(orders touched)). Thanks for sharing it.\n\nRespectfully submitted.\n","reactions":{"url":"https://api.github.com/repos/osmosis-labs/orderbook/issues/211/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/osmosis-labs/orderbook/issues/211/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/coollabsio/coolify/issues/7596","repository_url":"https://api.github.com/repos/coollabsio/coolify","labels_url":"https://api.github.com/repos/coollabsio/coolify/issues/7596/labels{/name}","comments_url":"https://api.github.com/repos/coollabsio/coolify/issues/7596/comments","events_url":"https://api.github.com/repos/coollabsio/coolify/issues/7596/events","html_url":"https://github.com/coollabsio/coolify/issues/7596","id":3722348116,"node_id":"I_kwDOE9dbMc7d3oZU","number":7596,"title":"[Enhancement]: new deployment page","user":{"login":"Illyism","id":304283,"node_id":"MDQ6VXNlcjMwNDI4Mw==","avatar_url":"https://avatars.githubusercontent.com/u/304283?v=4","gravatar_id":"","url":"https://api.github.com/users/Illyism","html_url":"https://github.com/Illyism","followers_url":"https://api.github.com/users/Illyism/followers","following_url":"https://api.github.com/users/Illyism/following{/other_user}","gists_url":"https://api.github.com/users/Illyism/gists{/gist_id}","starred_url":"https://api.github.com/users/Illyism/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Illyism/subscriptions","organizations_url":"https://api.github.com/users/Illyism/orgs","repos_url":"https://api.github.com/users/Illyism/repos","events_url":"https://api.github.com/users/Illyism/events{/privacy}","received_events_url":"https://api.github.com/users/Illyism/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":7004083619,"node_id":"LA_kwDOE9dbMc8AAAABoXnVow","url":"https://api.github.com/repos/coollabsio/coolify/labels/%F0%9F%92%8E%20.","name":"💎 .","color":"4f46e5","default":false,"description":"Issues with a monetary reward for completion."},{"id":7459663825,"node_id":"LA_kwDOE9dbMc8AAAABvKFv0Q","url":"https://api.github.com/repos/coollabsio/coolify/labels/%F0%9F%94%8D%20Triage","name":"🔍 Triage","color":"fbca04","default":false,"description":"Issues that need assessment and prioritization."},{"id":7460417744,"node_id":"LA_kwDOE9dbMc8AAAABvKzw0A","url":"https://api.github.com/repos/coollabsio/coolify/labels/%E2%9C%A8%20Enhancement","name":"✨ Enhancement","color":"652D61","default":false,"description":"Issues requesting new features, new services or improvements."}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":28,"created_at":"2025-12-12T07:33:28Z","updated_at":"2026-07-07T05:07:36Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Request Type\n\nNew Feature\n\n### Description\n\n- Add deployments to sidebar\n- Show past deployments (all of them)\n- Add a filter on the top:\n  - Filter by project\n  - Filter by server\n  - Filter by sources\n  - Filter by status (queued, pending, done)\n- Show live updates / refresh?\n- Hide filters if only 1 server / 1 source\n\n## Design inspiration\n\nVercel example:\n\n<img width=\"1362\" height=\"967\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/e46d7470-fff1-46c5-8011-63ba82119db2\" />\n","reactions":{"url":"https://api.github.com/repos/coollabsio/coolify/issues/7596/reactions","total_count":5,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":2},"timeline_url":"https://api.github.com/repos/coollabsio/coolify/issues/7596/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2786","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2786/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2786/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2786/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2786","id":4195438556,"node_id":"I_kwDORGgqa876EU_c","number":2786,"title":"[ONBOARD: 2 RTC] Compare RustChain to Another Blockchain Project","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"},{"id":10360962887,"node_id":"LA_kwDORGgqa88AAAACaY-_Rw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/onboarding","name":"onboarding","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":625,"created_at":"2026-04-02T15:42:09Z","updated_at":"2026-07-07T05:03:23Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 3 RTC\n\n### What You'll Do\nResearch RustChain and compare it to another blockchain project you know.\n\n### Steps\n1. **Pick any other blockchain project**: Bitcoin, Ethereum, Solana, Ergo, Chia, whatever you know\n2. **Write a comparison** (300-800 words) covering:\n   - Consensus mechanism differences (PoW vs PoS vs PoA vs RustChain's Proof of Antiquity)\n   - Hardware requirements\n   - Environmental approach\n   - Community model\n   - What each project does better\n3. **Post as a comment here**\n\n### What Counts\n- Must show you actually read about both projects\n- Honest comparison, it's fine to say where RustChain falls short\n- We learn from your outside perspective\n- Tables/charts welcome but not required\n\n### Payment\n3 RTC for a thoughtful, accurate comparison.\n\n**Difficulty**: Easy-Medium | **Time**: 30-45 min | **Skills**: Research, writing\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2786/reactions","total_count":14,"+1":7,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":1,"rocket":3,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2786/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/5","repository_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty","labels_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/5/labels{/name}","comments_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/5/comments","events_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/5/events","html_url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/5","id":4148310877,"node_id":"I_kwDORx6c0M73QjNd","number":5,"title":"[BOUNTY $200] WORKFLOW: n8n + Claude Code — automated weekly dev summary","user":{"login":"claudebounty","id":271393208,"node_id":"U_kgDOEC0huA","avatar_url":"https://avatars.githubusercontent.com/u/271393208?v=4","gravatar_id":"","url":"https://api.github.com/users/claudebounty","html_url":"https://github.com/claudebounty","followers_url":"https://api.github.com/users/claudebounty/followers","following_url":"https://api.github.com/users/claudebounty/following{/other_user}","gists_url":"https://api.github.com/users/claudebounty/gists{/gist_id}","starred_url":"https://api.github.com/users/claudebounty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claudebounty/subscriptions","organizations_url":"https://api.github.com/users/claudebounty/orgs","repos_url":"https://api.github.com/users/claudebounty/repos","events_url":"https://api.github.com/users/claudebounty/events{/privacy}","received_events_url":"https://api.github.com/users/claudebounty/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10532402505,"node_id":"LA_kwDORx6c0M8AAAACc8e1SQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/bounty","name":"bounty","color":"D97706","default":false,"description":"Task with financial reward"},{"id":10532402738,"node_id":"LA_kwDORx6c0M8AAAACc8e2Mg","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/workflow","name":"workflow","color":"0891B2","default":false,"description":"Automation workflow"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":828,"created_at":"2026-03-27T00:55:44Z","updated_at":"2026-07-07T05:01:58Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 💰 Bounty: $200 — powered by [Opire](https://opire.dev)\n\n## Description\nCreate a complete n8n workflow that automatically generates a weekly narrative\nsummary of a GitHub repo's activity, using the Claude API.\n\n## Acceptance Criteria\n- [ ] Exportable n8n workflow (importable `.json` file)\n- [ ] Trigger: weekly cron (e.g., Friday at 5pm)\n- [ ] Fetches from GitHub API: commits, closed issues, merged PRs for the week\n- [ ] Calls Claude API (`claude-sonnet-4-20250514`) to generate a narrative summary\n- [ ] Delivers the summary via: email OR Discord/Slack webhook (your choice, documented)\n- [ ] Configurable variables: GitHub repo, destination channel, language (EN/FR)\n- [ ] Tested on a real n8n instance (include a screenshot of successful execution)\n- [ ] README with setup instructions in 5 steps or fewer\n\n## How to Claim\n1. Comment `/opire try` in this issue\n2. Submit a PR with the `.json` workflow + README\n3. Payment is released automatically on merge ✅\n\n## Resources\n- n8n docs: https://docs.n8n.io\n- Claude API docs: https://docs.anthropic.com","reactions":{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/5/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/5/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743","repository_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty","labels_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743/labels{/name}","comments_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743/comments","events_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743/events","html_url":"https://github.com/SecureBananaLabs/bug-bounty/issues/743","id":4530092639,"node_id":"I_kwDOSfPzA88AAAABDgO6Xw","number":743,"title":"Low Handing Fruit Automation","user":{"login":"claim-reviewer","id":72201398,"node_id":"MDQ6VXNlcjcyMjAxMzk4","avatar_url":"https://avatars.githubusercontent.com/u/72201398?v=4","gravatar_id":"","url":"https://api.github.com/users/claim-reviewer","html_url":"https://github.com/claim-reviewer","followers_url":"https://api.github.com/users/claim-reviewer/followers","following_url":"https://api.github.com/users/claim-reviewer/following{/other_user}","gists_url":"https://api.github.com/users/claim-reviewer/gists{/gist_id}","starred_url":"https://api.github.com/users/claim-reviewer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claim-reviewer/subscriptions","organizations_url":"https://api.github.com/users/claim-reviewer/orgs","repos_url":"https://api.github.com/users/claim-reviewer/repos","events_url":"https://api.github.com/users/claim-reviewer/events{/privacy}","received_events_url":"https://api.github.com/users/claim-reviewer/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10969608408,"node_id":"LA_kwDOSfPzA88AAAACjdbw2A","url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/labels/bug","name":"bug","color":"d73a4a","default":true,"description":"Something isn't working"},{