ion":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Automate Low Hanging fruit bug detection and issue creation recursively.\n\nThis issue is an issue focused on creating more issues:\n1. Find a feature/bug to work on from this repository\n2. Create a GitHub issue on the repository to start working on it -- Pull requests without issues will not be considered.\n3. Use the following string in the issue that you created: \"This issue is limited only to the creator of this issue. This means that only the issue author can attempt to solve this issue. If you would like to work on it, please create another issue with the same contents and refer to issue #743 for more information.\"\n\nFollow all instructions carefully and precisely.\n\n/bounty $700\n\nBounties can only be paid upon successful PR merge.","reactions":{"url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Jayant2908/BLT/issues/1","repository_url":"https://api.github.com/repos/Jayant2908/BLT","labels_url":"https://api.github.com/repos/Jayant2908/BLT/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/Jayant2908/BLT/issues/1/comments","events_url":"https://api.github.com/repos/Jayant2908/BLT/issues/1/events","html_url":"https://github.com/Jayant2908/BLT/issues/1","id":3720927628,"node_id":"I_kwDOQNx8QM7dyNmM","number":1,"title":"Testing","user":{"login":"Jayant2908","id":200989760,"node_id":"U_kgDOC_rcQA","avatar_url":"https://avatars.githubusercontent.com/u/200