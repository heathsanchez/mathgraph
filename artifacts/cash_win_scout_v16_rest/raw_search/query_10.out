ine_url":"https://api.github.com/repos/Jayant2908/BLT/issues/1/timeline","performed_via_github_app":null,"state_reason":"reopened","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2782","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2782/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2782/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2782/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2782","id":4195435600,"node_id":"I_kwDORGgqa876EURQ","number":2782,"title":"[ONBOARD: 1 RTC] Review an Open PR","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10360962887,"node_id":"LA_kwDORGgqa88AAAACaY-_Rw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/onboarding","name":"onboarding","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1358,"created_at":"2026-04-02T15:41:31Z","updated_at":"2026-07-07T03:16:00Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 2 RTC\n\n### What You'll Do\nHelp us review code. Every PR benefits from a second pair of eyes.\n\n### Steps\n1. **Pick any open PR** from [Rustchain](https://github.com/Scottcjn/Rustchain/pulls), [BoTTube](https://github.com/Scottcjn/bottube/pulls), or [rustchain-bounties](https://github.com/Scottcjn/rustchain-bounties/pulls)\n2. **Read the code changes** (click \"Files changed\" tab)\n3. **Leave a substantive review comment**. Examples:\n   - \"Line 42: this SQL query isn't parameterized, potential injection\"\n   - \"This function duplicates logic already in utils.py line 80\"\n   - \"Missing error handling if the API returns non-200\"\n   - \"Good approach, but the variable name should describe what it holds\"\n4. **Comment here** with a link to your review\n\n### What Counts\n- Review must be **technical and specific** (not \"looks good\" or \"nice work\")\n- Point to specific lines with specific observations\n- Positive observations count too (\"good use of context manager here\")\n- You don't need to be an expert. Asking good questions is reviewing.\n\n### Payment\n2 RTC once your review contains at least 2 substantive observations.\n\n**Difficulty**: Easy-Medium | **Time**: 20-40 min | **Skills**: Can read Python or JavaScript\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2782/reactions","total_count":12,"+1":6,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":3,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2782/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/71","id":3904303864,"node_id":"I_kwDORGgqa87otvL4","number":71,"title":"[BOUNTY] Ongoing Bug Bounty Program — Find Bugs, Earn RTC (133 RTC Pool)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029408,"node_id":"LA_kwDORGgqa88AAAACWucZoA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bug","name":"bug","color":"d73a4a","default":true,"description":"Something isn't working"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":432,"created_at":"2026-02-06T01:13:53Z","updated_at":"2026-07-07T02:47:44Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Ongoing Bug Bounty Program\n\n**Pool: 750 RTC (ongoing, replenished as needed)**\n\n### Severity & Rewards\n| Severity | Description | Reward |\n|----------|-------------|--------|\n| **Critical** | Fund theft, consensus bypass, RCE | 100-200 RTC |\n| **High** | Data leak, auth bypass, significant logic error | 50-100 RTC |\n| **Medium** | DoS, info disclosure, moderate bugs | 15-50 RTC |\n| **Low** | UI bugs, minor leaks, doc errors | 5-15 RTC |\n\n### In-Scope\n- RustChain node software, attestation & fingerprint system\n- Epoch settlement & rewards, wallet endpoints\n- BoTTube web app, API, payment system\n- Python SDK, Block Explorer, Wallet GUI, Miner clients\n\n### Reporting\n1. Create GitHub issue with `[SECURITY]` prefix\n2. For critical: email first, issue after fix\n3. Include: steps to reproduce, impact, suggested fix\n\n### Rules\n- First reporter wins\n- Responsible disclosure required\n- Must not exploit on production\n\n---\n*Total RTC supply: 8.3M | RTC Reference Rate: 1 RTC = $0.10 USD*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/reactions","total_count":11,"+1":5,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":3,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/dev-kp-eloper/BountyScout/issues/400","repository_url":"https://api.github.com/repos/dev-kp-eloper/BountyScout","labels_url":"https://api.github.com/repos/dev-kp-eloper/BountyScout/issues/400/labels{/name}","comments_url":"https://api.github.com/repos/dev-kp-eloper/BountyScout/issues/400/comments","events_url":"https://api.github.com/repos/dev-kp-eloper/BountyScout/issues/400/events","html_url":"https://github.com/dev-kp-eloper/BountyScout/issues/400","id":4824079571,"node_id":"I_kwDOSmCMss8AAAABH4mc0w","number":400,"title":"🎯 Bounty Alert: 10 New Opportunityies found","user":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events