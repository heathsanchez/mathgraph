github.com/users/Vadman97/repos","events_url":"https://api.github.com/users/Vadman97/events{/privacy}","received_events_url":"https://api.github.com/users/Vadman97/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":2289841065,"node_id":"MDU6TGFiZWwyMjg5ODQxMDY1","url":"https://api.github.com/repos/highlight/highlight/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed"},{"id":5096574258,"node_id":"LA_kwDOETrouc8AAAABL8eNMg","url":"https://api.github.com/repos/highlight/highlight/labels/external%20bug%20/%20request","name":"external bug / request","color":"8FD635","default":false,"description":"Bugs related to external customers, users, etc.."},{"id":5426616458,"node_id":"LA_kwDOETrouc8AAAABQ3OYig","url":"https://api.github.com/repos/highlight/highlight/labels/sdk","name":"sdk","color":"7A5325","default":false,"description":""},{"id":5874195521,"node_id":"LA_kwDOETrouc8AAAABXiEcQQ","url":"https://api.github.com/repos/highlight/highlight/labels/%F0%9F%92%8E%20Bounty","name":"💎 Bounty","color":"4f46e5","default":false,"description":null},{"id":5896036273,"node_id":"LA_kwDOETrouc8AAAABX25fsQ","url":"https://api.github.com/repos/highlight/highlight/labels/%F0%9F%92%B0%20Rewarded","name":"💰 Rewarded","color":"15803d","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/highlight/highlight/milestones/10","html_url":"https://github.com/highlight/highlight/milestone/10","labels_url":"https://api.github.com/repos/highlight/highlight/milestones/10/labels","id":9322473,"node_id":"MI_kwDOETrouc4Ajj_p","number":10,"title":"[q2] Error Monitoring","description":"","creator":{"login":"ccschmitz","id":308182,"node_id":"MDQ6VXNlcjMwODE4Mg==","avatar_url":"https://avatars.githubusercontent.com/u/308182?v=4","gravatar_id":"","url":"https://api.github.com/users/ccschmitz","html_url":"https://github.com/ccschmitz","followers_url":"https://api.github.com/users/ccschmitz/followers","following_url":"https://api.github.com/users/ccschmitz/following{/other_user}","gists_url":"https://api.github.com/users/ccschmitz/gists{/gist_id}","starred_url":"https://api.github.com/users/ccschmitz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ccschmitz/subscriptions","organizations_url":"https://api.github.com/users/ccschmitz/orgs","repos_url":"https://api.github.com/users/ccschmitz/repos","events_url":"https://api.github.com/users/ccschmitz/events{/privacy}","received_events_url":"https://api.github.com/users/ccschmitz/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":7,"closed_issues":78,"state":"open","created_at":"2023-04-24T20:18:30Z","updated_at":"2024-01-29T16:48:32Z","due_on":"2023-06-30T00:00:00Z","closed_at":null},"comments":16,"created_at":"2023-02-10T23:40:33Z","updated_at":"2026-06-07T07:40:03Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"The SDK should implement the following:\r\n* a way to `H.recordException` following the otel exception reporting spec.\r\n* a way to instrument php/laravel logging libraries. if the php/laravel sdk supports logs natively, it would be great to route them to as LogRecords on `v1/logs`, but if not, fine to support them as trace events. \r\n\r\nas part of the exception implementation, if laravel libraries follow a common format for tracing HTTP request handlers, it would be great to wrap those as native otel traces.\r\n\r\nWe should build the SDK based on the [opentelemetry sdk](https://opentelemetry.io/docs/instrumentation/php/). There is a [guide](https://github.com/open-telemetry/opentelemetry-php/blob/main/docs/laravel-quickstart.md) for php laravel specifically, so we should follow best practices here in terms of collecting the available data.\r\n\r\nRequirements:\r\n* a `init` method that sets up the PHP instrumentation to collect console logs automatically.\r\n* a `recordException` method that allows capturing errors manually (see [java sdk](https://www.highlight.io/docs/sdk/java) as an example).\r\n* Laravel instrumentation that will hook into the framework to collect errors / logs automatically, without the need for a user to manually report errors.\r\n\r\nSome getting started pointers on our [docs](https://www.highlight.io/docs/general/company/open-source/contributing/adding-an-sdk)! Please let us know if you have feedback, I'm happy to [add to them](https://github.com/highlight/highlight.io/blob/main/docs-content/general/3_company/open-source/contributing/adding-an-sdk.md).","reactions":{"url":"https://api.github.com/repos/highlight/highlight/issues/4225/reactions","total_count":7,"+1":7,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/highlight/highlight/issues/4225/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/dev-kp-eloper/BountyScout/issues/118","repository_url":"https://api.github.com/repos/dev-kp-eloper/BountyScout","labels_url":"https://api.github.com/repos/dev-kp-eloper/BountyScout/issues/118/labels{/name}","comments_url":"https://api.github.com/repos/dev-kp-eloper/BountyScout/issues/118/comments","events_url":"https://api.github.com/repos/dev-kp-eloper/BountyScout/issues/118/events","html_url":"https://github.com/dev-kp-eloper/BountyScout/issues/118","id":4600512824,"node_id":"I_kwDOSmCMss8AAAABEjZBOA","number":118,"title":"🎯 Bounty Alert: 5 New Opportunityies found","user":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=