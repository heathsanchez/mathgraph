13","repository_url":"https://api.github.com/repos/sindresorhus/caprine","labels_url":"https://api.github.com/repos/sindresorhus/caprine/issues/713/labels{/name}","comments_url":"https://api.github.com/repos/sindresorhus/caprine/issues/713/comments","events_url":"https://api.github.com/repos/sindresorhus/caprine/issues/713/events","html_url":"https://github.com/sindresorhus/caprine/issues/713","id":397673823,"node_id":"MDU6SXNzdWUzOTc2NzM4MjM=","number":713,"title":"Help wanted","user":{"login":"sindresorhus","id":170270,"node_id":"MDQ6VXNlcjE3MDI3MA==","avatar_url":"https://avatars.githubusercontent.com/u/170270?v=4","gravatar_id":"","url":"https://api.github.com/users/sindresorhus","html_url":"https://github.com/sindresorhus","followers_url":"https://api.github.com/users/sindresorhus/followers","following_url":"https://api.github.com/users/sindresorhus/following{/other_user}","gists_url":"https://api.github.com/users/sindresorhus/gists{/gist_id}","starred_url":"https://api.github.com/users/sindresorhus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sindresorhus/subscriptions","organizations_url":"https://api.github.com/users/sindresorhus/orgs","repos_url":"https://api.github.com/users/sindresorhus/repos","events_url":"https://api.github.com/users/sindresorhus/events{/privacy}","received_events_url":"https://api.github.com/users/sindresorhus/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":261051869,"node_id":"MDU6TGFiZWwyNjEwNTE4Njk=","url":"https://api.github.com/repos/sindresorhus/caprine/labels/help%20wanted","name":"help wanted","color":"159818","default":true,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":14,"created_at":"2019-01-10T05:04:32Z","updated_at":"2026-07-02T18:53:50Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Caprine has become a very popular app. This also means that the maintenance burden has increased substantially. I could use some help with triaging and fixing issues. 🙌\r\n\r\nI have set up paid bounties for many of the issues in this repo.\r\nIt's now **$400** in total: https://issuehunt.io/repos/42574339","reactions":{"url":"https://api.github.com/repos/sindresorhus/caprine/issues/713/reactions","total_count":15,"+1":15,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sindresorhus/caprine/issues/713/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/tscircuit/tscircuit/issues/328","repository_url":"https://api.github.com/repos/tscircuit/tscircuit","labels_url":"https://api.github.com/repos/tscircuit/tscircuit/issues/328/labels{/name}","comments_url":"https://api.github.com/repos/tscircuit/tscircuit/issues/328/comments","events_url":"https://api.github.com/repos/tscircuit/tscircuit/issues/328/events","html_url":"https://github.com/tscircuit/tscircuit/issues/328","id":2453902011,"node_id":"I_kwDOLgfF886SQ5K7","number":328,"title":"Build the Arduino Nano with tscircuit","user":{"login":"seveibar","id":1910070,"node_id":"MDQ6VXNlcjE5MTAwNzA=","avatar_url":"https://avatars.githubusercontent.com/u/1910070?v=4","gravatar_id":"","url":"https://api.github.com/users/seveibar","html_url":"https://github.com/seveibar","followers_url":"https://api.github.com/users/seveibar/followers","following_url":"https://api.github.com/users/seveibar/following{/other_user}","gists_url":"https://api.github.com/users/seveibar/gists{/gist_id}","starred_url":"https://api.github.com/users/seveibar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/seveibar/subscriptions","organizations_url":"https://api.github.com/users/seveibar