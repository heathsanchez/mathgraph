//api.github.com/users/toukirkhan/events{/privacy}","received_events_url":"https://api.github.com/users/toukirkhan/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":68,"created_at":"2024-10-10T17:41:34Z","updated_at":"2026-07-02T13:32:30Z","closed_at":null,"assignee":{"login":"toukirkhan","id":88899011,"node_id":"MDQ6VXNlcjg4ODk5MDEx","avatar_url":"https://avatars.githubusercontent.com/u/88899011?v=4","gravatar_id":"","url":"https://api.github.com/users/toukirkhan","html_url":"https://github.com/toukirkhan","followers_url":"https://api.github.com/users/toukirkhan/followers","following_url":"https://api.github.com/users/toukirkhan/following{/other_user}","gists_url":"https://api.github.com/users/toukirkhan/gists{/gist_id}","starred_url":"https://api.github.com/users/toukirkhan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/toukirkhan/subscriptions","organizations_url":"https://api.github.com/users/toukirkhan/orgs","repos_url":"https://api.github.com/users/toukirkhan/repos","events_url":"https://api.github.com/users/toukirkhan/events{/privacy}","received_events_url":"https://api.github.com/users/toukirkhan/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### 👟 Reproduction steps\n\nPOST to /v1/users or any of the \"create user with ___ password\" endpoints\nCreate body with a defined UserId, and a `name: null`.\nObserve the vague server error\n\n### 👍 Expected behavior\n\nNo server error, should continue creating the user with no name. Name is optional anyway, so specifying it as null should not create this error.\n\n### 👎 Actual Behavior\n\n![Image](https://github.com/user-attachments/assets/835e2c3f-dd8b-453d-8d61-2c6a85a0d1ec)\n\n\n### 🎲 Appwrite version\n\nAppwrite Cloud\n\n### 💻 Operating system\n\nWindows\n\n### 🧱 Your Environment\n\nI am developing my own SDK, hence running into this issue. I can work around it of course, but there shouldn't be a reason for this to occur in the first place. I have replicated it using postman to eliminate any possible issues at a deeper level within my own SDK.\n\nWasn't sure if you would care about this sort of issue, but received no answer on Discord as to whether to file this or not.\n\n### 👀 Have you spent some time to check if this issue has been raised before?\n\n- [x] I checked and didn't find similar issue\n\n### 🏢 Have you read the Code of Conduct?\n\n- [x] I have read the [Code of Conduct](https://github.com/appwrite/.github/blob/main/CODE_OF_CONDUCT.md)","reactions":{"url":"https://api.github.com/repos/appwrite/appwrite/issues/8785/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/appwrite/appwrite/issues/8785/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/3ni8ma/aarushkarak-website/issues/86","repository_url":"https://api.github.com/repos/3ni8ma/aarushkarak-website","labels_url":"https://api.github.com/repos/3ni8ma/aarushkarak-website/issues/86/labels{/name}","comments_url":"https://api.github.com/repos/3ni8ma/aarushkarak-website/issues/86/comments","events_url":"https://api.github.com/repos/3ni8ma/aarushkarak-website/issues/86/events","html_url":"https://github.com/3ni8ma/aarushkarak-website/issues/86","id":4789756439,"node_id":"I_kwDOS8xWjc8AAAABHX3iFw","number":86,"title":"Daily Issue Report — 2026-07-01","user":{"login":"3ni8ma","id":178741808,"node_id":"U_kgDOCqdiMA","avatar_url":"https://avatars.githubusercontent.com/u/178741808?v=4","gravatar_id":"","url":"https://api.github.com/users/3ni8ma","html_url":"https://gith