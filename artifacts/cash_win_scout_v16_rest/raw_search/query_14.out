ttps://github.com/strapi/strapi/issues/22946","id":2864539843,"node_id":"I_kwDOApbc-86qvWjD","number":22946,"title":"Strapi 5 local plugins : size has significantly increased","user":{"login":"mathieugrwn","id":155733551,"node_id":"U_kgDOCUhOLw","avatar_url":"https://avatars.githubusercontent.com/u/155733551?v=4","gravatar_id":"","url":"https://api.github.com/users/mathieugrwn","html_url":"https://github.com/mathieugrwn","followers_url":"https://api.github.com/users/mathieugrwn/followers","following_url":"https://api.github.com/users/mathieugrwn/following{/other_user}","gists_url":"https://api.github.com/users/mathieugrwn/gists{/gist_id}","starred_url":"https://api.github.com/users/mathieugrwn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mathieugrwn/subscriptions","organizations_url":"https://api.github.com/users/mathieugrwn/orgs","repos_url":"https://api.github.com/users/mathieugrwn/repos","events_url":"https://api.github.com/users/mathieugrwn/events{/privacy}","received_events_url":"https://api.github.com/users/mathieugrwn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":267208743,"node_id":"MDU6TGFiZWwyNjcyMDg3NDM=","url":"https://api.github.com/repos/strapi/strapi/labels/issue:%20bug","name":"issue: bug","color":"d34a52","default":false,"description":"Issue reporting a bug"},{"id":749108959,"node_id":"MDU6TGFiZWw3NDkxMDg5NTk=","url":"https://api.github.com/repos/strapi/strapi/labels/severity:%20medium","name":"severity: medium","color":"fbca04","default":false,"description":"If it breaks the basic use of the product but can be worked around"},{"id":758314049,"node_id":"MDU6TGFiZWw3NTgzMTQwNDk=","url":"https://api.github.com/repos/strapi/strapi/labels/good%20first%20issue","name":"good first issue","color":"ececec","default":true,"description":"Good for newcomers"},{"id":783919370,"node_id":"MDU6TGFiZWw3ODM5MTkzNzA=","url":"https://api.github.com/repos/strapi/strapi/labels/status:%20confirme