ed into my head anyway).\r\n\r\nFeel free to assign this to me even though it's not technically an issue that has to be resolved.","reactions":{"url":"https://api.github.com/repos/ioccc-src/mkiocccentry/issues/723/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ioccc-src/mkiocccentry/issues/723/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/3ni8ma/aarushkarak-website/issues/146","repository_url":"https://api.github.com/repos/3ni8ma/aarushkarak-website","labels_url":"https://api.github.com/repos/3ni8ma/aarushkarak-website/issues/146/labels{/name}","comments_url":"https://api.github.com/repos/3ni8ma/aarushkarak-website/issues/146/comments","events_url":"https://api.github.com/repos/3ni8ma/aarushkarak-website/issues/146/events","html_url":"https://github.com/3ni8ma/aarushkarak-website/issues/146","id":4823511208,"node_id":"I_kwDOS8xWjc8AAAABH4DwqA","number":146,"title":"Daily Issue Report — 2026-07-06","user":{"login":"3ni8ma","id":178741808,"node_id":"U_kgDOCqdiMA","avatar_url":"https://avatars.githubusercontent.com/u/178741808?v=4","gravatar_id":"","url":"https://api.github.com/users/3ni8ma","html_url":"https://github.com/3ni8ma","followers_url":"https://api.github.com/users/3ni8ma/followers","following_url":"https://api.github.com/users/3ni8ma/following{/other_user}","gists_url":"https://api.github.com/users/3ni8ma/gists{/gist_id}","starred_url":"https://api.github.com/users/3ni8ma/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/3ni8ma/subscriptions","organizations_url":"https://api.github.com/users/3ni8ma/orgs","repos_url":"https://api.github.com/users/3ni8ma/repos","events_url":"https://api.github.com/users/3ni8ma/events{/privacy}","received_events_url":"https://api.github.com/users/3ni8ma/received_events","type":"User","user_view_type":"public","site_