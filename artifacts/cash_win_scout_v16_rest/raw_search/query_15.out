y":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Subscribe to this issue and stay notified about new [weekly trending repos in Python](https://github.com/trending/python?since=weekly)!","reactions":{"url":"https://api.github.com/repos/vitalets/github-trending-repos/issues/11/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vitalets/github-trending-repos/issues/11/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/vitalets/github-trending-repos/issues/23","repository_url":"https://api.github.com/repos/vitalets/github-trending-repos","labels_url":"https://api.github.com/repos/vitalets/github-trending-repos/issues/23/labels{/name}","comments_url":"https://api.github.com/repos/vitalets/github-trending-repos/issues/23/comments","events_url":"https://api.github.com/repos/vitalets/github-trending-repos/issues/23/events","html_url":"https://github.com/vitalets/github-trending-repos/issues/23","id":272607240,"node_id":"MDU6SXNzdWUyNzI2MDcyNDA=","number":23,"title":"New weekly trending repos in Shell","user":{"login":"vitalets","id":1473072,"node_id":"MDQ6VXNlcjE0NzMwNzI=","avatar_url":"https://avatars.githubusercontent.com/u/1473072?v=4","gravatar_id":"","url":"https://api.github.com/users/vitalets","html_url":"https://github.com/vitalets","followers_url":"https://api.github.com/users/vitalets/followers","following_url":"https://api.github.com/users/vitalets/following{/other_user}","gists_url":"https://api.github.com/users/vitalets/gists{/gist_id}","starred_url":"https://api.github.com/users/vitalets/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vitalets/subscriptions","organizations_url":"https://api.github.com/users/vitalets/orgs","repos_url":"https://api.github.com/users/vitalets/repos","events_url":"https://api.github.com/users/vitalets/events{/privacy}","received_events_url":"https://api.github.com/users/vitalets/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":737629103,"node_id":"MDU6TGFiZWw3Mzc2MjkxMDM=","url":"https://api.github.com/repos/vitalets/github-trending-repos/labels/trending-weekly","name":"trending-weekly","color":"33aa3f","default":false,"description":null}],"state":"open","locked":true,"assignees":[],"milestone":null,"comments":4,"created_at":"2017-11-09T15:35:28Z","updated_at":"2026-07-05T22:03:14Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Subscribe to this issue and stay notified about new [weekly trending repos in Shell](https://github.com/trending/shell?since=weekly)!","reactions":{"url":"https://api.github.com/repos/vitalets/github-trending-repos/issues/23/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vitalets/github-trending-repos/issues/23/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Dragoon4002/artic-trader/issues/2","repository_url":"https://api.github.com/repos/Dragoon4002/artic-trader","labels_url":"https://api.github.com/repos/Dragoon4002/artic-trader/issues/2/labels{/name}","comments_url":"https://api.github.com/repos/Dragoon4002/artic-trader/issues/2/comments","events_url":"https://api.github.com/repos/Dragoon4002/artic-trader/issues/2/events","html_url":"https://github.com/Dragoon4002/artic-trader/issues/2","id":4763017247,"node_id":"I_kwDOSHCgMc8AAAABG-XgHw","number":2,"title":"Improvements Bounty: Performance Enhancer","user":{"login":"Dragoon4002","id":108277454,"node_id":"U_kgDOBnQuzg","avatar_url":"https://avatars.githubusercontent.com/u/108277454?v=4","gravatar_id":"","url":"https://api.github.com/users/Dragoon4002","html_url":"https://github.com/Dragoon4002","followers_url":"https://api.github.com/users/Dragoon4002/followers","following_url":"https://api.github.com/users/Dragoon4002/following{/other_user}","gists_url":"https://api.github.com/users/Dragoon4002/gists{/gist_id}","starred_url":"https://api.github.com/users/Dragoon4002/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Dragoon4002/subscriptions","organizations_url":"https://api.github.com/users/Dragoon4002/orgs","repos_url":"https://api.github.com/users/Dragoon4002/repos","events_url":"https://api.github.com/users/Dragoon4002/events{/privacy}","received_events_url":"https://api.github.com/users/Dragoon4002/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":22,"created_at":"2026-06-28T17:19:15Z","updated_at":"2026-07-05T21:33:17Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Overview\nReward pool: **50 USDC** distributed among contributors who submit performance improvements. (It is an Issue tester for another project, but current issuer will be rewarded once the assesment is made correctly)\n\n## What qualifies\n- Profiling results identifying bottlenecks\n- Code optimizations (rendering, API, DB queries, bundle size)\n- Caching strategies with measurable impact\n- Benchmark comparisons (before/after)\n\n## How to submit\nOpen a PR referencing this issue. Include what you changed and why it's faster.\n\n## Reward distribution\nTop contributions share the pool based on impact:\n- Best overall: 20 USDC\n- Runner-up: 10 USDC\n- 3rd place: 5 USDC\n- Honorable mentions (up to 15): 1 USDC each\n\n## Judging\nRepo maintainer reviews all PRs, ranks by measurable improvement, distributes accordingly.\n","reactions":{"url":"https://api.github.com/repos/Dragoon4002/artic-trader/issues/2/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Dragoon4002/artic-trader/issues/2/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/snowdensb/litellm/issues/49","repository_url":"https://api.github.com/repos/snowdensb/litellm","labels_url":"https://api.github.com/repos/snowdensb/litellm/issues/49/labels{/name}","comments_url":"https://api.github.com/repos/snowdensb/litellm/issues/49/comments","events_url":"https://api.github.com/repos/snowdensb/litellm/issues/49/events","html_url":"https://github.com/snowdensb/litellm/issues/49","id":3677718689,"node_id":"I_kwDOPtV4m87bNYih","number":49,"title":"mlflow-3.6.0-py3-none-any.whl: 34 vulnerabilities (highest severity is: 10.0)","user":{"login":"mend-for-github-com[bot]","id":50673670,"node_id":"MDM6Qm90NTA2NzM2NzA=","avatar_url":"https://avatars.githubusercontent.com/in/30796?v=4","gravatar_id":"","url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D","html_url":"https://github.com/apps/mend-for-github-com","followers_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/followers","following_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/mend-for-gith