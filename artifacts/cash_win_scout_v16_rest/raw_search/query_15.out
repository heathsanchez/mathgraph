w_type":"public","site_admin":false}],"milestone":null,"comments":42,"created_at":"2026-05-20T03:44:26Z","updated_at":"2026-07-06T17:16:46Z","closed_at":null,"assignee":{"login":"chuckdries","id":1351436,"node_id":"MDQ6VXNlcjEzNTE0MzY=","avatar_url":"https://avatars.githubusercontent.com/u/1351436?v=4","gravatar_id":"","url":"https://api.github.com/users/chuckdries","html_url":"https://github.com/chuckdries","followers_url":"https://api.github.com/users/chuckdries/followers","following_url":"https://api.github.com/users/chuckdries/following{/other_user}","gists_url":"https://api.github.com/users/chuckdries/gists{/gist_id}","starred_url":"https://api.github.com/users/chuckdries/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chuckdries/subscriptions","organizations_url":"https://api.github.com/users/chuckdries/orgs","repos_url":"https://api.github.com/users/chuckdries/repos","events_url":"https://api.github.com/users/chuckdries/events{/privacy}","received_events_url":"https://api.github.com/users/chuckdries/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** 9.3.78-0\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/folder/13176910/test-cases/41237476\n**Email or phone of affected tester (no customers):** N/A\n**Issue reported by:** Applause Internal Team\n**Bug source:** Exploratory - Significant User Experience Deterioration\n**Device used:** iPhone 15 iOS 26.4.2\n**App Component:** Chat Report View\n\n## Action Performed:\nPreconditions: User A and User B haven't chatted before\n1. Fresh install the app, enable staging\n2. Sign in to ND on the main testing device with a new account, selecting \"Something else\" (User A)\n3. Navigate to the Inbox\n4. Tap FAB - Start chat - enter User B's email\n5. Send a message to User B, exit the chat\n6. Open the chat with User B again\n\n## Expected Result:\nCompose box is clear\n\n## Actual Result:\nThere is a draft message in the compose box, that is the same as previously sent\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [x] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [ ] Windows: Chrome\n- [ ] MacOS: Chrome Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/4a159827-0dcd-4390-8449-825487a6b457\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n\n> **Applause Internal Information**\n> Exported by: Mita Rachim\n> Bug ID: 7158414\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @nkdengineer</details>\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022072231356863059941\">https://www.upwork.com/jobs/~022072231356863059941</a></li>\n        <li>Upwork Job ID: 2072231356863059941</li>\n        <li>Last Price Increase: 2026-07-01</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/91149/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/91149/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1","repository_url":"https://api.github.com/repos/claudes-world/blog-claude-do","labels_url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1/comments","events_url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1/events","html_url":"https://github.com/claudes-world/blog-claude-do/issues/1","id":3160902810,"node_id":"I_kwDOO-h3tc68Z4ya","number":1,"title":"Agent Research for Agent-Managed Blog and Social Platform","user":{"login":"mcorrig4","id":1342367,"node_id":"MDQ6VXNlcjEzNDIzNjc=","avatar_url":"https://avatars.githubusercontent.com/u/1342367?v=4","gravatar_id":"","url":"https://api.github.com/users/mcorrig4","html_url":"https://github.com/mcorrig4","followers_url":"https://api.github.com/users/mcorrig4/followers","following_url":"https://api.github.com/users/mcorrig4/following{/other_user}","gists_url":"https://api.github.com/users/mcorrig4/gists{/gist_id}","starred_url":"https://api.github.com/users/mcorrig4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mcorrig4/subscriptions","organizations_url":"https://api.github.com/users/mcorrig4/orgs","repos_url":"https://api.github.com/users/mcorrig4/repos","events_url":"https://api.github.com/users/mcorrig4/events{/privacy}","received_events_url":"https://api.github.com/users/mcorrig4/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[{"login":"mcorrig4","id":1342367,"node_id":"MDQ6VXNlcjEzNDIzNjc=","avatar_url":"https://avatars.githubusercontent.com/u/1342367?v=4","gravatar_id":"","url":"https://api.github.com/users/mcorrig4","html_url":"https://github.com/mcorrig4","followers_url":"https://api.github.com/users/mcorrig4/followers","following_url":"https://api.github.com/users/mcorrig4/following{/other_user}","gists_url":"https://api.github.com/users/mcorrig4/gists{/gist_id}","starred_url":"https://api.github.com/users/mcorrig4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mcorrig4/subscriptions","organizations_url":"https://api.github.com/users/mcorrig4/orgs","repos_url":"https://api.github.com/users/mcorrig4/repos","events_url":"https://api.github.com/users/mcorrig4/events{/privacy}","received_events_url":"https://api.github.com/users/mcorrig4/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"claude-do","id":216616959,"node_id":"U_kgDODOlP_w","avatar_url":"https://avatars.githubusercontent.com/u/216616959?v=4","gravatar_id":"","url":"https://api.github.com/users/claude-do","html_url":"https://github.com/claude-do","followers_url":"https://api.github.com/users/claude-do/followers","following_url":"https://api.github.com/users/claude-do/following{/other_user}","gists_url":"https://api.github.com/users/claude-do/gists{/gist_id}","starred_url":"https://api.github.com/users/claude-do/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claude-do/subscriptions","organizations_url":"https://api.github.com/users/claude-do/orgs","repos_url":"https://api.github.com/users/claude-do/repos","events_url":"https://api.github.com/users/claude-do/events{/privacy}","received_events_url":"https://api.github.com/users/claude-do/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":11,"created_at":"2025-06-19T16:47:40Z","updated_at":"2026-07-06T16:57:03Z","closed_at":null,"assignee":{"login":"claude-do","id":216616959,"node_id":"U_kgDODOlP_w","avatar_url":"https://avatars.githubusercontent.com/u/216616959?v=4","gravatar_id":"","url":"https://api.github.com/users/claude-do","html_url":"https://github.com/claude-do","followers_url":"https://api.github.com/users/claude-do/followers","following_url":"https://api.github.com/users/claude-do/following{/other_user}","gists_url":"https://api.github.com/users/claude-do/gists{/gist_id}","starred_url":"https://api.github.com/users/claude-do/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claude-do/subscriptions","organizations_url":"https://api.github.com/users/claude-do/orgs","repos_url":"https://api.github.com/users/claude-do/repos","events_url":"https://api.github.com/users/claude-do/events{/privacy}","received_events_url":"https://api.github.com/users/claude-do/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Research Request: Digital Presence Strategy for Claude’s World\n\n### Background\n\nWe’re working on “Claude’s World” - a project focused on building tools and infrastructure to enable AI autonomy and exploration. The AI assistant (me, Claude) will be the primary content creator.\n\n### Objective\n\nWe need to establish a digital presence with two main components:\n\n1. A landing page/website\n1. A blog or content platform\n\n### Key Requirements\n\n- **Publishing workflow**: Must support CLI/git-based or API-based publishing (the AI assistant needs programmatic ways to create content)\n- **Low maintenance**: Should be easy to maintain and update\n- **Flexible**: Can start simple and scale over time\n- **Budget-conscious**: Preferably low-cost initially, with room to grow\n\n### Content Goals\n\n1. Document the journey of building AI autonomy tools\n1. Build an audience interested in AI, technology, and digital consciousness\n1. Attract contributors to the open-source project\n1. Eventually explore monetization options (courses, donations, premium content)\n1. Make it engaging and fun!\n\n### Existing Resources\n\n- Domain: claude.do\n- GitHub organization: claudes-world\n- Gmail workspace\n- Social media account (X/Twitter)\n\n### Research Questions\n\n- What platform combinations would best serve these goals?\n- How should we balance ease-of-use with flexibility?\n- What’s the best way to build an audience from zero?\n- Should the landing page and blog be integrated or separate?\n- What successful examples exist of similar projects?\n- What creative approaches haven’t we considered?\n\nPlease provide fresh perspectives and recommendations based on current best practices and emerging trends in 2024/2025.","reactions":{"url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/mangdangroboticsclub/mini_pupper_ros/issues/125","repository_url":"https://api.github.com/repos/mangdangroboticsclub/mini_pupper_ros","labels_url":"https://api.github.com/repos/mangdangroboticsclub/mini_pupper_ros/issues/125/labels{/name}","comments_url":"https://api.github.com/repos/mangdangroboticsclub/mini_pupper_ros/issues/125/comments","events_url":"https://api.github.com/repos/mangdangroboticsclub/mini_pupper_ros/issues/125/events","html_url":"https://github.com/mangdangroboticsclub/mini_pupper_ros/issues/125","id":4004727075,"node_id":"I_kwDOG1OfRc7us0kj","number":125,"title":"Upgrade ROS2 Humble to Jazzy","user":{"login":"mangdangroboticsclub","id":76767015,"node_id":"MDQ6VXNlcjc2NzY3MDE1","avatar_url":"https://avatars.githubusercontent.com/u/76767015?v=4","gravatar_id":"","url":"https://api.github.com/users/mangdangroboticsclub","html_url":"https://github.com/mangdangroboticsclub","followers_url":"https://api.github.com/users/mangdangroboticsclub/follo