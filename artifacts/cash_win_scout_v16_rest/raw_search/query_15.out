lse,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893515375,"node_id":"MDU6TGFiZWwyODkzNTE1Mzc1","url":"https://api.github.com/repos/Expensify/App/labels/Weekly","name":"Weekly","color":"009800","default":false,"description":"KSv2"},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"Ollyws","id":11609254,"node_id":"MDQ6VXNlcjExNjA5MjU0","avatar_url":"https://avatars.githubusercontent.com/u/11609254?v=4","gravatar_id":"","url":"https://api.github.com/users/Ollyws","html_url":"https://github.com/Ollyws","followers_url":"https://api.github.com/users/Ollyws/followers","following_url":"https://api.github.com/users/Ollyws/following{/other_user}","gists_url":"https://api.github.com/users/Ollyws/gists{/gist_id}","starred_url":"https://api.github.com/users/Ollyws/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ollyws/subscriptions","organizations_url":"https://api.github.com/users/Ollyws/orgs","repos_url":"https://api.github.com/users/Ollyws/repos","events_url":"https://api.github.com/users/Ollyws/events{/privacy}","received_events_url":"https://api.github.com/users/Ollyws/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"mountiny","id":36083550,"node_id":"MDQ6VXNlcjM2MDgzNTUw","avatar_url":"https://avatars.githubusercontent.com/u/36083550?v=4","gravatar_id":"","url":"https://api.github.com/users/mountiny","html_url":"https://github.com/mountiny","followers_url":"https://api.github.com/users/mountiny/followers","following_url":"https://api.github.com/users/mountiny/following{/other_user}","gists_url":"https://api.github.com/users/mountiny/gists{/gist_id}","starred_url":"https://api.github.com/users/mountiny/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mountiny/subscriptions","organizations_url":"https://api.github.com/users/mountiny/orgs","repos_url":"https://api.github.com/users/mountiny/repos","events_url":"https://api.github.com/users/mountiny/events{/privacy}","received_events_url":"https://api.github.com/users/mountiny/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"mateuuszzzzz","id":60450261,"node_id":"MDQ6VXNlcjYwNDUwMjYx","avatar_url":"https://avatars.githubusercontent.com/u/60450261?v=4","gravatar_id":"","url":"https://api.github.com/users/mateuuszzzzz","html_url":"https://github.com/mateuuszzzzz","followers_url":"https://api.github.com/users/mateuuszzzzz/followers","following_url":"https://api.github.com/users/mateuuszzzzz/following{/other_user}","gists_url":"https://api.github.com/users/mateuuszzzzz/gists{/gist_id}","starred_url":"https://api.github.com/users/mateuuszzzzz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mateuuszzzzz/subscriptions","organizations_url":"https://api.github.com/users/mateuuszzzzz/orgs","repos_url":"https://api.github.com/users/mateuuszzzzz/repos","events_url":"https://api.github.com/users/mateuuszzzzz/events{/privacy}","received_events_url":"https://api.github.com/users/mateuuszzzzz/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":37,"created_at":"2026-05-20T18:09:07Z","updated_at":"2026-07-06T13:24:26Z","closed_at":null,"assignee":{"login":"mountiny","id":36083550,"node_id":"MDQ6VXNlcjM2MDgzNTUw","avatar_url":"https://avatars.githubusercontent.com/u/36083550?v=4","gravatar_id":"","url":"https://api.github.com/users/mountiny","html_url":"https://github.com/mountiny","followers_url":"https://api.github.com/users/mountiny/followers","following_url":"https://api.github.com/users/mountiny/following{/other_user}","gists_url":"https://api.github.com/users/mountiny/gists{/gist_id}","starred_url":"https://api.github.com/users/mountiny/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mountiny/subscriptions","organizations_url":"https://api.github.com/users/mountiny/orgs","repos_url":"https://api.github.com/users/mountiny/repos","events_url":"https://api.github.com/users/mountiny/events{/privacy}","received_events_url":"https://api.github.com/users/mountiny/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"parent_issue_url":"https://api.github.com/repos/Expensify/App/issues/91302","issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Sentry\nhttps://expensify.sentry.io/issues/APP-7CX\n\n## Impact (snapshot at filing)\n- Users (total since first seen): **3,395**\n- Events: 3,627\n- Users (last 14d): ~86\n- First seen: 2026-03-11\n- Last seen: now (ongoing)\n- Platform: iOS, hybrid_app (HybridApp / OldDot)\n- App version(s): 9.3.59 and later (still occurring on 9.3.77)\n- Device class: high (iPhone15+, iOS 26.x dominant)\n- Mechanism: `AppHang`, fatal, watchdog termination after 2000ms main-thread block\n\n## Stack trace (top frames, native iOS)\n```\n-[UIControl _sendActionsForEvents:withEvent:]\n  → -[UIBarButtonItem _triggerActionForEvent:fallbackSender:]\n  → -[BaseViewController onBarButtonItemSelected:]\n  → +[YAPLJS callFunction:args:]\n  → -[JSValue callWithArguments:]\n  → JSObjectCallAsFunction\n  → JSC::profiledCall\n  → JSC::Interpreter::executeCall\n  → (... JS execution ...)\n  → +[YAPLLogManager logWithLevel:message:parameters:tags:syncWithServer:isInsecure:]\n  → +[YAPLLogManager commitLogLine:...]\n  → LogSyncerManager.addLog\n  → LogSyncerManager.sendLogPacket\n  → +[YAPLJS callFunction:args:]            ← second JS entry from inside the first\n  → -[JSValue callWithArguments:]\n  → JSC::JSLock::grabAllLocks\n  → JSC::JSLock::lock\n  → WTF::LockAlgorithm<…>::lockSlow\n  → WTF::ParkingLot::parkConditionallyImpl\n  → WTF::ThreadCondition::timedWait\n  → _pthread_cond_wait                       ← main thread blocked here\n```\n\n## Suspected cause\nJSC lock contention deadlock. The main thread enters JS through `YAPLJS callFunction:args:` to handle the bar button tap, the JS handler calls `Log` (or another function that goes through `YAPLLogManager`), and `LogSyncerManager.sendLogPacket` re-enters JSC via a second `+[YAPLJS callFunction:args:]`. The second entry contends for the JSC lock held by the first entry on the same thread, the parking lot puts the thread to sleep, and the watchdog terminates the app at the 2000ms threshold.\n\nAvoiding re-entrant JSC calls inside `LogSyncerManager.sendLogPacket` (e.g. by dispatching the second call to a serial queue rather than executing it inline) is the most likely fix direction.\n\n## Reproduction\nUnknown deterministically. Triggers on bar button taps when the resulting JS handler logs something that causes a re-entrant native-to-JS call.\n\n## Related\n- Sibling Sentry IDs: APP-7A5 (tracked by closed [#86334](https://github.com/Expensify/App/issues/86334) — closed 2026-05-18 as COMPLETED, but APP-7CX continues to fire on the same symptom)\n- Prior GH issues: [#86334](https://github.com/Expensify/App/issues/86334) (closed). This issue covers the still-occurring Sentry grouping; reopening #86334 is also acceptable if maintainers prefer that.\n\nTwo more Sentry groupings hit the same OldDot iOS bar-button-tap path — flagging here so they can be tracked under one fix:\n\n| Sentry ID | Users (last 14d) | Signature |\n|-----------|-------------------|-----------|\n| [APP-7CX](https://expensify.sentry.io/issues/APP-7CX) (this issue) | ~86 | `Fatal App Hang +[YAPLJS callFunction:args:]` |\n| [APP-84S](https://expensify.sentry.io/issues/APP-84S) | ~20 | Same `Fatal App Hang +[YAPLJS callFunction:args:]` signature |\n| [APP-82E](https://expensify.sentry.io/issues/APP-82E) | ~15 | `NSRangeException objectAtIndexedSubscript index 0 beyond bounds for empty array` at `-[BaseViewController onBarButtonItemSelected:]` (same culprit frame in this issue's stack) |\n\nSame root-cause family as far as the stack shows — recursive JSC invocation triggered from a bar-button tap handler. A fix here should resolve all three.\n\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022057380809520139975\">https://www.upwork.com/jobs/~022057380809520139975</a></li>\n        <li>Upwork Job ID: 2057380809520139975</li>\n        <li>Last Price Increase: 2026-06-18</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @mateuuszzzzz</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/91229/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/91229/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/91016","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/91016/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/91016/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/91016/events","html_url":"https://github.com/Expensify/App/issues/91016","id":4472459099,"node_id":"I_kwDOEQqHYc8AAAABCpRPWw","number":91016,"title":"[$250] Expense – Empty report displayed when category is disabled from another tab","user":{"login":"lanitochka17","id":78819774,"node_id":"MDQ6VXNlcjc4ODE5Nzc0","avatar_url":"https://avatars.githubusercontent.com/u/78819774?v=4","gravatar_id":"","url":"https://api.github.com/users/lanitochka17","html_url":"https://github.com/lanitochka17","followers_url":"https://api.github.com/users/lanitochka17/followers","following_url":"https://api.github.com/users/lanitochka17/following{/other_user}","gists_url":"https://api.github.com/users/lanitochka17/gists{/gist_id}","starred_url":"https://api.github.com/users/lanitochka17/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lanitochka17/subscriptions","organizations_url":"https://api.github.com/users/lanitochka17/orgs","repos_url":"https://api.github.com/users/lanitochka17/repos","events_url":"https://api.github.com/users/lanitochka17/events{/privacy}","received_events_url":"https://api.github.com/users/lanitochka17/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":2283143991,"node_id":"MDU6TGFiZWwyMjgzMTQzOTkx","url":"https://api.github.com/repos/Expensify/App/labels/Reviewing","name":"Reviewing","color":"dddddd","default":false,"description":"Has a PR in review"},{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893515375,"node_id":"MDU6TGFiZWwyODkzNTE1Mzc1","url":"https://api.github.com/repos/Expensify/App/labels/Weekly","name":"Weekly","color":"009800","default":false,"description":"KSv2"},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"elirangoshen","id":9560116,"node_id":"MDQ6VXNlcjk1NjAxMTY=","avatar_url":"https://avatars.githubusercontent.com/u/9560116?v=4","gravatar_id":"","url":"https://api.github.com/users/elirangoshen","html_url":"https://github.com/elirangoshen","followers_url":"https://api.github.com/users/elirangosh