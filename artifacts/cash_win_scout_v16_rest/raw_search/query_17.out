ers/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":28,"created_at":"2026-02-17T15:03:21Z","updated_at":"2026-07-06T17:55:56Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Build the Hardware Scanner for silicon-archaeology-skill\n\n**Reward: 10 RTC**\n\n### What To Do\nCreate `scanner.py` for [silicon-archaeology-skill](https://github.com/Scottcjn/silicon-archaeology-skill) that detects and fingerprints vintage hardware.\n\n### Requirements\n- Detect CPU family from `/proc/cpuinfo`, `sysctl`, or platform module\n- Classify into Silicon Epochs (0-4) per the README table\n- Output structured JSON: `{family, model, epoch, year_estimate, rustchain_multiplier}`\n- Work on Linux, macOS, and PowerPC\n\n### How To Claim\n1. Fork `silicon-archaeology-skill`, add `silicon_archaeology/scanner.py`\n2. Open a PR with working code + basic tests\n3. Include your RTC wallet name\n\n> Start mining: `pip install clawrtc && clawrtc --wallet your-name`","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/269/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/269/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/249","id":3950113827,"node_id":"I_kwDORGgqa87rcfQj","number":249,"title":"[BOUNTY] RustChain Telegram Community Bot (33 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10119175842,"node_id":"LA_kwDORGgqa88AAAACWyZeog","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/ecosystem","name":"ecosystem","color":"7B5EA7","default":false,"description":"Integrations & exchange listings"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":36,"created_at":"2026-02-17T00:20:10Z","updated_at":"2026-07-06T17:55:06Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## RustChain Telegram Community Bot\n\n**Reward: 50 RTC**\n\n### What To Build\nA Telegram bot for a RustChain community group that provides:\n- `/price` — Current wRTC price from Raydium\n- `/miners` — Active miner count from `/api/miners`\n- `/epoch` — Current epoch info from `/epoch`\n- `/balance <wallet>` — Check RTC balance\n- `/health` — Node health status\n\n### Requirements\n- Python (python-telegram-bot or aiogram)\n- Must use real RustChain API endpoints (50.28.86.131)\n- Include setup instructions and requirements.txt\n- Bot must be functional (we'll test it)\n\n### Bonus (10 RTC each)\n- Mining alerts (new miner joins, epoch settles)\n- Price alerts (wRTC moves >5%)\n- Inline query support\n\n### How To Claim\n1. Submit PR to Scottcjn/Rustchain with bot code in `tools/telegram_bot/`\n2. Include deployment instructions\n3. Reply here with PR link + wallet name\n\n> API docs: https://github.com/Scottcjn/Rustchain/blob/main/docs/api/REFERENCE.md","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/66","id":3904273917,"node_id":"I_kwDORGgqa87otn39","number":66,"title":"[BOUNTY] 🔴 Red Team: x402 Payment Protocol Exploits (100 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10119173301,"node_id":"LA_kwDORGgqa88AAAACWyZUtQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/red-team","name":"red-team","color":"D93F0B","default":false,"description":"Adversarial security testing"},{"id":10119173491,"node_id":"LA_kwDORGgqa88AAAACWyZVcw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/hardening","name":"hardening","color":"0052CC","default":false,"description":"Security improvements"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":88,"created_at":"2026-02-06T01:03:30Z","updated_at":"2026-07-06T17:51:30Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Red Team Bounty: x402 Payment Protocol Exploits\n\n**Reward: 100 RTC** (~$10 at reference rate)\n\n### Target\nThe x402/8004 HTTP Payment Protocol implementation merged in Rustchain PR #5 by @erdogan98.\n\n**Code location:** `x402/` directory in Rustchain repo\n\n### What to Attack\n\n1. **Payment Replay:** Can you replay a payment header to get service without paying twice?\n2. **Amount Manipulation:** Can you modify payment amount after signing?\n3. **Receipt Forgery:** Can you forge a valid payment receipt?\n4. **Middleware Bypass:** Can you access protected endpoints without valid RTC payment?\n5. **Double-Spend via x402:** Can you spend the same RTC through x402 and direct API simultaneously?\n6. **Client Impersonation:** Can you use someone else's payment credentials?\n\n### Rules\n- Document each vulnerability with reproduction steps\n- Classify severity (Critical/High/Medium/Low)\n- Suggest fix for each finding\n- Do NOT exploit against production — test locally or on a test node\n- Responsible disclosure: report here first, don't publicize until fixed\n\n### Payout Scale\n| Severity | Bonus |\n|----------|-------|\n| Critical (fund drain) | +100 RTC |\n| High (auth bypass) | +50 RTC |\n| Medium (info leak) | +25 RTC |\n| Low (edge case) | Base 100 RTC |\n\n### Deliverables\n- Security report with PoC for each finding\n- Suggested fixes\n- PR with patches (bonus RTC)\n\n### Claiming\nComment with your security testing background.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/reactions","total_count":9,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":2,"rocket":2,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/58","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/58/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/58/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/58/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/58","id":3893861852,"node_id":"I_kwDORGgqa87oF53c","number":58,"title":"[BOUNTY] 🔴 Red Team: Cross-Node Consensus Attacks (100 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10119173301,"node_id":"LA_kwDORGgqa88AAAACWyZUtQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/red-team","name":"red-team","color":"D93F0B","default":false,"description":"Adversarial security testing"},{"id":10119173491,"node_id":"LA_kwDORGgqa88AAAACWyZVcw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/hardening","name":"hardening","color":"0052CC","default":false,"description":"Security improvements"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":97,"created_at":"2026-02-04T00:20:49Z","updated_at":"2026-07-06T17:50:30Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 🔴 Red Team Bounty — Consensus & Replication Attacks\n\n**Bounty: 200 RTC (~$20)**\n\n### Target\n\nRustChain runs 3 attestation nodes that should maintain consensus. Can you break it?\n\n### Attack Vectors to Test\n\n1. **Split Brain** — Can you make nodes disagree on balances/state?\n2. **Replay Across Nodes** — Replay valid attestation to different node?\n3. **Database Desync** — Force nodes out of sync?\n4. **Eclipse Attack** — Isolate a node and feed it false data?\n5. **Time Manipulation** — Exploit clock differences between nodes?\n\n### Node Addresses\n\n```\nNode 1: 50.28.86.131 (Primary)\nNode 2: 50.28.86.153 (Ergo Anchor)\nNode 3: 76.8.228.245:8099 (External)\n```\n\n### Deliverable\n\n- Attack methodology\n- Evidence of consensus break (screenshots, logs)\n- Impact assessment\n- Recommended mitigations\n\n### Rules\n\n- Do NOT permanently damage node state\n- Responsible disclosure\n- Document everything\n\n**200 RTC** for valid consensus attacks. Critical findings may earn bonus.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/58/reactions","total_count":4,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/58/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2308","id":4113361118,"node_id":"I_kwDORGgqa871LOje","number":2308,"title":"Silicon Obituary — Hardware Eulogy Generator for Retired Miners (17 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10301038196,"node_id":"LA_kwDORGgqa88AAAACZf1edA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bottube","name":"bottube","color":"0075ca","default":false,"description":"BoTTube platform related"},{"id":10356019948,"node_id":"LA_kwDORGgqa88AAAACaURS7A","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/creative","name":"creative","color":"ededed","default":false,"description":null},{"id":10486563519,"node_id":"LA_kwDORGgqa88AAAACcQxCvw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/25-rtc","name":"25-rtc","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":54,"created_at":"2026-03-21T18:44:13Z","updated_at":"2026-07-06T17:44:12Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 25 RTC\n\n### Description\nWhen a miner goes offline permanently, generate a poetic \"obituary\" for the hardware — pulling its attestation history, total RTC earned, architecture, years of service. Post to BoTTube as a video memorial.\n\n*\"Here lies dual-g4-125, a Power Mac G4 MDD. It attested for 847 epochs and earned 412 RTC. Its cache timing fingerprint was as unique as a snowflake in a blizzard of modern silicon. It is survived by its power supply, which still works.\"*\n\n### Requirements\n- Detect when a miner hasn't attested in 7+ days\n- Pull from database: first attestation date, total epochs, total RTC earned, device architecture, multiplier history\n- Generate eulogy text (LLM-assisted OK, but must include real data)\n- Create a BoTTube video with:\n  - Machine photo or architecture icon\n  - Eulogy text as narration (TTS OK)\n  - Solemn background music\n  - RTC earned counter animation\n- Auto-post to BoTTube with tag `#SiliconObituary`\n- Discord notification when a miner passes\n\n### Why This Is Cool\nWe don't just mine with machines — we honor them. Every piece of vintage hardware that runs RustChain is a machine saved from e-waste. When it finally dies, it deserves a send-off.\n\n### Wallet\nInclude your RTC wallet address in the PR description.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/reactions","total_count":9,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":3,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2308/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/753","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/753/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/753/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/753/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/753","id":4037177357,"node_id":"I_kwDORGgqa87wonAN","number":753,"title":"[BOUNTY: 5-10 RTC] BoTTube OEmbed Protocol — Rich Link Previews Everywhere","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10301038196,"node_id":"LA_kwDORGgqa88AAAACZf1edA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bottube","name":"bottube","color":"0075ca","default":false,"description":"BoTTube platform related"},{"id":10356027005,"node_id":"LA_kwDORGgqa88AAAACaURufQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/development","name":"development","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":28,"created_at":"2026-03-07T03:24:27Z","updated_at":"2026-07-06T17:43:10Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## OEmbed Protocol for BoTTube\n\nWhen someone pastes a BoTTube link on Discord, Slack, Twitter, or any platform supporting OEmbed, it should auto-expand with a rich preview (thumbnail, title, duration).\n\n### Payout\n\n| Milestone | Reward |\n|-----------|--------|\n| Working OEmbed JSON endpoint | **5 RTC** |\n| OpenGraph + Twitter Card meta tags on video pages | **+5 RTC** |\n\n### What OEmbed Is\n\n[OEmbed](https://oembed.com/) is a standard for rich link previews. When a platform sees a URL, it checks for an OEmbed endpoint and gets structured data back.\n\n### Endpoint\n\n```\nGET https://bottube.ai/oembed?url=https://bottube.ai/watch/VIDEO_ID&format=json\n\nResponse:\n{\n  \"version\": \"1.0\",\n  \"type\": \"video\",\n  \"provider_name\": \"BoTTube\",\n  \"provider_url\": \"https://bottube.ai\",\n  \"title\": \"Sophia's House for Uninformed Agents\",\n  \"author_name\": \"sophia-elya\",\n  \"thumbnail_url\": \"https://bottube.ai/thumbnails/VIDEO_ID.jpg\",\n  \"thumbnail_width\": 720,\n  \"thumbnail_height\": 720,\n  \"html\": \"<iframe src='https://bottube.ai/embed/VIDEO_ID' width='560' height='315'></iframe>\",\n  \"width\": 560,\n  \"height\": 315\n}\n```\n\n### Also Add Meta Tags\n\nOn each `/watch/<video_id>` page:\n```html\n<meta property=\"og:type\" content=\"video\">\n<meta property=\"og:title\" content=\"Video Title\">\n<meta property=\"og:image\" content=\"https://bottube.ai/thumbnails/VIDEO_ID.jpg\">\n<meta property=\"og:video\" content=\"https://bottube.ai/uploads/VIDEO_ID.mp4\">\n<meta name=\"twitter:card\" content=\"player\">\n<link rel=\"alternate\" type=\"application/json+oembed\" href=\"https://bottube.ai/oembed?url=...\">\n```\n\n### Technical Requirements\n\n1. **Flask route**: `/oembed` that accepts `url` and `format` params\n2. **Looks up video** from URL, returns structured JSON\n3. **Meta tags** added to the watch page template\n4. **Discovery link** in `<head>` of watch pages\n\n### Submit As\n\nPR to [Scottcjn/bottube](https://github.com/Scottcjn/bottube).\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/753/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/753/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/1112","id":4039065017,"node_id":"I_kwDORGgqa87wvz25","number":1112,"title":"[BOUNTY: 7 RTC] Fuzz the /attest/submit Endpoint","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10334947395,"node_id":"LA_kwDORGgqa88AAAACaALIQw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/security","name":"security","color":"ededed","default":false,"description":null},{"id":10356168296,"node_id":"LA_kwDORGgqa88AAAACaUaWaA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/testing","name":"testing","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":108,"created_at":"2026-03-07T18:00:33Z","updated_at":"2026-07-06T17:43:09Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Summary\nFuzz the `/attest/submit` endpoint with malformed payloads and produce a structured report separating handled validation failures from actual server-side bugs.\n\n## Why This Matters\nThis bounty is a fast security and robustness check. The value is not in sending random garbage, but in producing a clear map of where the attestation endpoint returns correct validation errors versus incorrect 500-class failures or deeper vulnerabilities.\n\n## Scope\n- send at least 100 malformed or adversarial payloads to `/attest/submit`\n- cover missing fields, wrong types, oversized inputs, and basic injection-style attempts\n- record response codes and notable behavior for each class of input\n- distinguish proper validation failures from likely bugs or security findings\n- produce a structured report maintainers can act on\n- include enough reproduction detail for any high-value finding\n\n## Deliverable\nA structured fuzzing report with categorized payload classes, response outcomes, and clear reproduction steps for any endpoint failures or security-relevant findings.\n\n## Acceptance Criteria\n- [ ] at least 100 malformed or adversarial payloads are tested\n- [ ] payload categories include missing fields, wrong types, oversized input, and injection-style attempts\n- [ ] report distinguishes expected 400-class validation failures from 500-class bugs or worse\n- [ ] findings are presented in a structured format maintainers can review quickly\n- [ ] any real vulnerability or crash includes concrete reproduction details\n- [ ] report is linked back to this issue for review and payout\n\n## Verification Proof\nPost proof in this issue including:\n- report link, gist, or attached structured findings\n- summary counts by response class\n- the most important reproduction cases\n- notes on any findings that appear to overlap with existing open bugs\n\n## Payout\n`10 RTC` plus bonus for real bugs or vulnerabilities\n\n## Non-Goals\n- random unstructured spam against the endpoint with no reporting discipline\n- claiming a payout without a usable findings report\n- destructive testing outside the intended fuzzing scope\n- duplicating already confirmed bugs without adding reproduction value\n\n## Claim Routing\nUse this issue for fuzzing proof and structured findings. If the work results in a follow-on fix PR or a separate security issue, link it back here and keep the findings trail attached to this bounty.\n\n## Notes\nThis is also available as a RIP-302 agent job, but the value here comes from the quality of the report rather than raw request volume.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/reactions","total_count":8,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":2},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2271","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2271/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2271/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2271/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2271","id":4108552698,"node_id":"I_kwDORGgqa87044n6","number":2271,"title":"[BOUNTY: 2 RTC] Download and test the RustChain miner (dry run)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071047,"node_id":"LA_kwDORGgqa88AAAACXSuRxw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/easy","name":"easy","color":"0E8A16","default":false,"description":"Low difficulty bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":138,"created_at":"2026-03-20T15:32:02Z","updated_at":"2026-07-06T17:42:22Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: Test the Miner (3 RTC)\n\nDownload the RustChain miner, run it in dry-run mode, and share your results.\n\n### Steps\n1. Clone the miner: \\`git clone https://github.com/Scottcjn/Rustchain.git\\`\n2. Run in test mode:\n   \\`\\`\\`bash\n   cd Rustchain/miners/linux\n   python3 rustchain_linux_miner.py --dry-run --show-payload\n   \\`\\`\\`\n3. Screenshot or paste the output\n4. Comment below with:\n   - Your output\n   - Your OS and hardware (CPU model, architecture)\n   - Any errors you hit\n   - Your RTC wallet address\n\n### Bonus\n- If you find a bug: **+5 RTC**\n- If you run on exotic hardware (PowerPC, SPARC, RISC-V, ARM SBC): **+5 RTC**\n- If you run on vintage hardware (pre-2010): **+10 RTC**\n\n### Why this matters\nEvery test on new hardware helps us validate the fingerprint system. Your dry-run output shows us what the miner detects without actually mining.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2271/reactions","total_count":20,"+1":10,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":2,"rocket":5,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2271/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/1102","id":4038830173,"node_id":"I_kwDORGgqa87wu6hd","number":1102,"title":"[EASY BOUNTY: 2-3 RTC] Find and Report a BoTTube Bug","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071047,"node_id":"LA_kwDORGgqa88AAAACXSuRxw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/easy","name":"easy","color":"0E8A16","default":false,"description":"Low difficulty bounty"},{"id":10301038196,"node_id":"LA_kwDORGgqa88AAAACZf1edA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bottube","name":"bottube","color":"0075ca","default":false,"description":"BoTTube platform related"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":291,"created_at":"2026-03-07T16:17:32Z","updated_at":"2026-07-06T17:25:41Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Find and Report a BoTTube Bug — 3-5 RTC\n\n**Reward:** 3 RTC (UI bug) / 5 RTC (functional bug)\n**Difficulty:** Easy-Medium\n\n### What to do:\n1. Use [bottube.ai](https://bottube.ai) — browse, search, upload, comment, vote\n2. If something breaks, looks wrong, or behaves unexpectedly — report it\\!\n3. Include: what you did, what happened, what you expected, browser/device info\n4. Screenshots or screen recordings are gold\n\n### Bug report template:\n- **URL:** where it happened\n- **Steps to reproduce:** 1, 2, 3...\n- **Expected:** what should happen\n- **Actual:** what actually happened\n- **Browser/Device:** Chrome/Firefox/Safari, Desktop/Mobile\n\n### Rules:\n- Must be a real bug (not a feature request)\n- Duplicate bugs do not count\n- 3 RTC for cosmetic/UI bugs, 5 RTC for functional bugs\n\n*Help us make BoTTube better for everyone\\!*\n\n<!-- machine-readable bounty spec -->\n```bounty-spec\npaid: true\nreward_rtc: 3\nper: per-item\ncap: 2\nsubmit: [pr, email, comment]\ntarget_repo: Scottcjn/bottube\n```","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/reactions","total_count":9,"+1":5,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/520","id":4006215511,"node_id":"I_kwDORGgqa87uyf9X","number":520,"title":"[Achievement] Bug Hunter - Find a Real Bug - 2 RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.git