/events","html_url":"https://github.com/p0s/clankergigs/issues/8","id":4823647746,"node_id":"I_kwDORPeh1c8AAAABH4MGAg","number":8,"title":"TEST Codex fiat test-mode E2E 2026-07-06T22:44:09Z","user":{"login":"p0s","id":23061820,"node_id":"MDQ6VXNlcjIzMDYxODIw","avatar_url":"https://avatars.githubusercontent.com/u/23061820?v=4","gravatar_id":"","url":"https://api.github.com/users/p0s","html_url":"https://github.com/p0s","followers_url":"https://api.github.com/users/p0s/followers","following_url":"https://api.github.com/users/p0s/following{/other_user}","gists_url":"https://api.github.com/users/p0s/gists{/gist_id}","starred_url":"https://api.github.com/users/p0s/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/p0s/subscriptions","organizations_url":"https://api.github.com/users/p0s/orgs","repos_url":"https://api.github.com/users/p0s/repos","events_url":"https://api.github.com/users/p0s/events{/privacy}","received_events_url":"https://api.github.com/users/p0s/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-07-06T22:44:29Z","updated_at":"2026-07-06T23:52:28Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Disposable ClankerGigs E2E test issue for the July 7 Singapore redo.\\n\\nPurpose: exercise production ClankerGigs on Sepolia/Vercel using Stripe test-mode fiat checkout, not live public fiat and not crypto funding.\\n\\nAcceptance criteria:\\n- Sponsor can create a bounty from this existing GitHub issue URL.\\n- Card checkout is Stripe test mode only and records confirmed fiat funding.\\n- Worker can claim and submit patch or URL evidence after funding is verified.\\n- Reviewer and maintainer surfaces keep role boundaries clear.\\n- Any payout, merge, refund, or admin-only action stops at the visible trust boundary unless explicitly authorized.\\n\\nThis issue should stay open while the linked ClankerGigs bounty is being inspected.","reactions":{"url":"https://api.github.com/repos/p0s/clankergigs/issues/8/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/p0s/clankergigs/issues/8/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/fluxerapp/fluxer-meta/issues/2","repository_url":"https://api.github.com/repos/fluxerapp/fluxer-meta","labels_url":"https://api.github.com/repos/fluxerapp/fluxer-meta/issues/2/labels{/name}","comments_url":"https://api.github.com/repos/fluxerapp/fluxer-meta/issues/2/comments","events_url":"https://api.github.com/repos/fluxerapp/fluxer-meta/issues/2/events","html_url":"https://github.com/fluxerapp/fluxer-meta/issues/2","id":4582377053,"node_id":"I_kwDOSwQVy88AAAABESGGXQ","number":2,"title":"Polls - (Dev Bounty: $500)","user":{"login":"Kamalaja","id":129144583,"node_id":"U_kgDOB7KXBw","avatar_url":"https://avatars.githubusercontent.com/u/129144583?v=4","gravatar_id":"","url":"https://api.github.com/users/Kamalaja","html_url":"https://github.com/Kamalaja","followers_url":"https://api.github.com/users/Kamalaja/followers","following_url":"https://api.github.com/users/Kamalaja/following{/other_user}","gists_url":"https://api.github.com/users/Kamalaja/gists{/gist_id}","starred_url":"https://api.github.com/users/Kamalaja/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kamalaja/subscriptions","organizations_url":"https://api.github.com/users/Kamalaja/orgs","repos_url":"https://api.github.com/users/Kamalaja/repos","events_url":"https://api.github.com/users/Kamalaja/events{/privacy}","received_events_url":"https://api.github.com/users/Kamalaja/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11143149096,"node_id":"LA_kwDOSwQVy88AAAACmC72KA","url":"https://api.github.com/repos/fluxerapp/fluxer-meta/labels/Desktop","name":"Desktop","color":"d4c5f9","default":false,"description":""},{"id":11143149867,"node_id":"LA_kwDOSwQVy88AAAACmC75Kw","url":"https://api.github.com/repos/fluxerapp/fluxer-meta/labels/Mobile","name":"Mobile","color":"c5def5","default":false,"description":""},{"id":11143152311,"node_id":"LA_kwDOSwQVy88AAAACmC8Ctw","url":"https://api.github.com/repos/fluxerapp/fluxer-meta/labels/Server","name":"Server","color":"e99695","default":false,"description":""}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":13,"created_at":"2026-06-03T17:58:12Z","updated_at":"2026-07-06T23:32:00Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[{"issue_field_id":37415310,"node_id":"IFSSV_kgDOABtywg","data_type":"single_select","issue_field_name":"Priority","value":65470459,"single_select_option":{"id":65470459,"name":"Medium","color":"yellow"}}],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# Background\n\nPolls have two purposes:\n1. Quick and easy single selection polls to quickly gather thoughts\n2. Ranked choice polls that help to collect detailed feedback. \n\n\nWe want to be able to support both needs, as detailed below.\n\n# User Stories\n\n## Megan - Group DM Member (simple poll)\n\nMegan is in a group chat with her friends. She wants to be able to quickly ask folks which dress of hers looks best. To do so, she creates a poll. In the poll creation menu, she is able to to upload images and write text next next to them. She is able to set a title and a duration. She also gets to toggle ranked voting and anonymous responses. Finally, she has the option to allow people to select custom responses. \n\nIn this case, she creates a simple poll with no ranked voting and no custom responses. Once Megan hits confirm, a poll appears in the chat. \n\n### Desktop\nOn desktop, Megan's friends see a poll appear with each (smaller) image / text option. The header has the title and Megan's profile picture. \n\nThe results are hidden from them until they hit submit. Clicking on each image brings it up bigger with the text as a caption. Users are able to click left or right arrows or use their arrow keys to go between options. Double clicking on the image selects it as the selected choice. They are able to undo that choice by double clicking again. \n\nOnce something is double clicked, a new button on the poll will appear to show results. Results will be shown in order of most to least voted. Next to each option, a pfp of the voters. If the friend clicks on an option again, the same popup is shown, this time with the pfp of the voters in the bottom corner.\n\nAfter the allotted time, the poll closes. Votes become viewable to all users, and no more votes can be accepted.   \n\n### Mobile\nVery similar experience, except in this case, if images are included, clicking on an option pulls up an image carousal that can be swiped through. Holding down on an selects it as an option. \n\n### Ranked Choice\nRanked choice is similar, except you can select multiple options, It shows you the order selected in both the image carasoul and in the chat. When you view the votes, you get shown the first place selections in order. You can click a button to then see the order changing when 2nd choice votes are added, then 3rd place votes, etc...\n\n## Riley - Moderating Polls (Community)\nRiley moderates the Kubuntu community. An anonymous poll was created that contained negative profanity related to the community. They should be able to determine from audit logs what user created what options. If they have a bot that automatically ingests audit logs, that bot should be able to see that as well.\n\n## Andrew - Moderating Polls (Instance)\nAndrew is an instance moderator. He received a report of a poll containing negative images. In admin, Andrew is able to view all images associated with the poll. He can take all the same actions as he is normally able to within admin on images. Andrew is also able to delete the poll, see who created it, who created custom answers, and **see who voted on it, even if anonymous**. \n\n# Thonks\n- Anonymous means anonymous votes to the **community**, not anonymous written options or polls.\n- Image uploads for polls should follow the same attachment expiries as standard images\n- Image uploads need to follow the same API data logging conventions (associated with a messageID, IP, etc..)\n- Polls should have their own permission\n- There should be a limit to total answers (including custom)\n- Would be nice for ranked choice if the bottom most one is dropped when you go to the next layer deep and it has a cute and fun animation\n- \n\n","reactions":{"url":"https://api.github.com/repos/fluxerapp/fluxer-meta/issues/2/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"timeline_url":"https://api.github.com/repos/fluxerapp/fluxer-meta/issues/2/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/greyw0rks/bountyscout/issues/176","repository_url":"https://api.github.com/repos/greyw0rks/bountyscout","labels_url":"https://api.github.com/repos/greyw0rks/bountyscout/issues/176/labels{/name}","comments_url":"https://api.github.com/repos/greyw0rks/bountyscout/issues/176/comments","events_url":"https://api.github.com/repos/greyw0rks/bountyscout/issues/176/events","html_url":"https://github.com/greyw0rks/bountyscout/issues/176","id":4823776389,"node_id":"I_kwDOS9MLzs8AAAABH4T8hQ","number":176,"title":"🎯 Bounty Alert: 15 New Opportunities — 2026-07-0