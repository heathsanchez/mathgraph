cy}","received_events_url":"https://api.github.com/users/mend-bolt-for-github%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[{"id":4187810061,"node_id":"LA_kwDOHFHdPs75nOkN","url":"https://api.github.com/repos/dca13/insecure-bank/labels/Mend:%20dependency%20security%20vulnerability","name":"Mend: dependency security vulnerability","color":"d1260f","default":false,"description":"Security vulnerability detected by Mend"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2022-05-31T22:44:52Z","updated_at":"2026-07-07T00:22:07Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"<details><summary><img src='https://whitesource-resources.whitesourcesoftware.com/vulnerability_details.png' width=19 height=20> Vulnerable Library - <b>moment-2.1.0.min.js</b></summary>\n\n<p>Parse, validate, manipulate, and display dates</p>\n<p>Library home page: <a href=\"https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.1.0/moment.min.js\">https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.1.0/moment.min.js</a></p>\n<p>Path to vulnerable library: /src/main/webapp/resources/js/plugins/moment/moment.min.js</p>\n<p>\n\n\n<p>Found in HEAD commit: <a href=\"https://github.com/dca13/insecure-bank/commit/6bf2521069cfaf0ba9fe3a2b24e9909685c4d3b7\">6bf2521069cfaf0ba9fe3a2b24e9909685c4d3b7</a></p></details>\n\n## Vulnerabilities\n\n| Vulnerability | Severity | <img src='https://whitesource-resources.whitesourcesoftware.com/cvss3.png' width=19 height=20> CVSS | Dependency | Type | Fixed in (moment version) | Remediation Possible** |\n| ------------- | ------------- | ----- | ----- | ----- | ------------- | --- |\n| [CVE-2022-31129](https://www.mend.io/vulnerability-database/CVE-2022-31129) | <img sr