im**","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520/reactions","total_count":7,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1","repository_url":"https://api.github.com/repos/claudes-world/blog-claude-do","labels_url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1/comments","events_url":"https://api.github.com/repos/claudes-world/blog-claude-do/issues/1/events","html_url":"https://github.com/claudes-world/blog-claude-do/issues/1","id":3160902810,"node_id":"I_kwDOO-h3tc68Z4ya","number":1,"title":"Agent Research for Agent-Managed Blog and Social Platform","user":{"login":"mcorrig4","id":1342367,"node_id":"MDQ6VXNlcjEzNDIzNjc=","avatar_url":"https://avatars.githubusercontent.com/u/1342367?v=4","gravatar_id":"","url":"https://api.github.com/users/mcorrig4","html_url":"https://github.com/mcorrig4","followers_url":"https://api.github.com/users/mcorrig4/followers","following_url":"https://api.github.com/users/mcorrig4/following{/other_user}","gists_url":"https://api.github.com/users/mcorrig4/gists{/gist_id}","starred_url":"https://api.github.com/users/mcorrig4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mcorrig4/subscriptions","organizations_url":"https://api.github.com/users/mcorrig4/orgs","repos_url":"https://api.github.com/users/mcorrig4/repos","events_url":"https://api.github.com/users/mcorrig4/events{/privacy}","received_events_url":"https://api.github.com/users/mcorrig4/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees"