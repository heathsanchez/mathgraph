ssues/2203/labels{/name}","comments_url":"https://api.github.com/repos/commaai/panda/issues/2203/comments","events_url":"https://api.github.com/repos/commaai/panda/issues/2203/events","html_url":"https://github.com/commaai/panda/issues/2203","id":3073450562,"node_id":"I_kwDOBTb99c63MSJC","number":2203,"title":"Test important GPIO initialization in CI (libpanda)","user":{"login":"robbederks","id":894159,"node_id":"MDQ6VXNlcjg5NDE1OQ==","avatar_url":"https://avatars.githubusercontent.com/u/894159?v=4","gravatar_id":"","url":"https://api.github.com/users/robbederks","html_url":"https://github.com/robbederks","followers_url":"https://api.github.com/users/robbederks/followers","following_url":"https://api.github.com/users/robbederks/following{/other_user}","gists_url":"https://api.github.com/users/robbederks/gists{/gist_id}","starred_url":"https://api.github.com/users/robbederks/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/robbederks/subscriptions","organizations_url":"https://api.github.com/users/robbederks/orgs","repos_url":"https://api.github.com/users/robbederks/repos","events_url":"https://api.github.com/users/robbederks/events{/privacy}","received_events_url":"https://api.github.com/users/robbederks/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":578378652,"node_id":"MDU6TGFiZWw1NzgzNzg2NTI=","url":"https://api.github.com/repos/commaai/panda/labels/enhancement","name":"enhancement","color":"84b6eb","default":true,"description":null},{"id":3633695314,"node_id":"LA_kwDOBTb99c7YlcpS","url":"https://api.github.com/repos/commaai/panda/labels/tests","name":"tests","color":"c2e0c6","default":false,"description":""},{"id":6307600117,"node_id":"LA_kwDOBTb99c8AAAABd_ZW9Q","url":"https://api.github.com/repos/commaai/panda/labels/good%20first%20issue","name":"good first issue","color":"fef2c0","default":true,"description":""}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":4,"created_at":"2025-05-19T11:07:28Z","updated_at":"2026-07-07T06:21:56Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"A good test for PRs that refactor / change parts of the panda initialization ([such as this](https://github.com/commaai/panda/pull/2094)) would be a CI job that asserts GPIO like these are initialized correctly and in a safe order:\n- the SBU line driving / readout\n- the CAN transciever lines (enable + RX/TX alternative functions)\n- SOM reset / bootkick\n- LED\n- ...\n\nThis should be quite easy to do without HITL, by writing a \"simulated\" GPIO hardware block in [fake_stm.h](https://github.com/commaai/panda/blob/471a455789b88a0bf1098e87c49d564da266e890/board/fake_stm.h) and using [libpanda](https://github.com/commaai/panda/tree/471a455789b88a0bf1098e87c49d564da266e890/tests/libpanda).","reactions":{"url":"https://api.github.com/repos/commaai/panda/issues/2203/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/commaai/panda/issues/2203/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3","repository_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty","labels_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/labels{/name}","comments_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/comments","events_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/events","html_url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/3","id":4148310577,"node_id":"I_kwDORx6c0M73QjIx","number":3,"title":"[BOUNTY $100] HOOK: Pre-tool-use hook that blocks destructive bash commands","user":{"login":"claudebounty","id":271393208,"node_id":"U_kgDOEC0huA","avatar_url":"https://avatars.githubusercontent.com/u/271393208?v=4","gravatar_id":"","url":"https://api.github.com/users/claudebounty","html_url":"https://github.com/claudebounty","followers_url":"https://api.github.com/users/claudebounty/followers","following_url":"https://api.github.com/users/claudebounty/following{/other_user}","gists_url":"https://api.github.com/users/claudebounty/gists{/gist_id}","starred_url":"https://api.github.com/users/claudebounty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claudebounty/subscriptions","organizations_url":"https://api.github.com/users/claudebounty/orgs","repos_url":"https://api.github.com/users/claudebounty/repos","events_url":"https://api.github.com/users/claudebounty/events{/privacy}","received_events_url":"https://api.github.com/users/claudebounty/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10532402505,"node_id":"LA_kwDORx6c0M8AAAACc8e1SQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/bounty","name":"bounty","color":"D97706","default":false,"description":"Task with financial reward"},{"id":10532402677,"node_id":"LA_kwDORx6c0M8AAAACc8e19Q","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/hook","name":"hook","color":"DC2626","default":false,"description":"Claude Code hook"},{"id":10532402829,"node_id":"LA_kwDORx6c0M8AAAACc8e2jQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/security","name":"security","color":"B91C1C","default":false,"description":"Security-related"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1356,"created_at":"2026-03-27T00:55:40Z","updated_at":"2026-07-07T06:21:17Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 💰 Bounty: $100 — powered by [Opire](https://opire.dev)\n\n## Description\nCreate a Claude Code `pre-tool-use` hook in Python or bash that intercepts\ndangerous bash commands before they are executed.\n\n## Acceptance Criteria\n- [ ] Hook follows Claude Code hooks format (`~/.claude/hooks/`)\n- [ ] Blocks these patterns: `rm -rf`, `DROP TABLE`, `git push --force`,\n      `TRUNCATE`, `DELETE FROM` without a WHERE clause\n- [ ] Logs every blocked attempt to `~/.claude/hooks/blocked.log`\n      with: timestamp, attempted command, project path\n- [ ] Displays a clear message to Claude explaining why the command was blocked\n- [ ] Does not interfere with normal bash commands\n- [ ] README with installation in 2 commands or fewer\n\n## How to Claim\n1. Comment `/opire try` in this issue\n2. Submit a PR with the hook + README\n3. Payment is released automatically on merge ✅\n\n## Resources\n- Claude Code hooks docs: https://docs.anthropic.com/claude-code/hooks","reactions":{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2","repository_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty","labels_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2