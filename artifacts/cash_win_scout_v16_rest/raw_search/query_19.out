prover change\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [x] MacOS: Chrome / Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/6c5a1a49-27b2-4be4-9ed4-41674dd0e8c9\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022067914058094347586\">https://www.upwork.com/jobs/~022067914058094347586</a></li>\n        <li>Upwork Job ID: 2067914058094347586</li>\n        <li>Last Price Increase: 2026-07-03</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/94021/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/94021/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/93704","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/93704/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/93704/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/93704/events","html_url":"https://github.com/Expensify/App/issues/93704","id":4674814585,"node_id":"I_kwDOEQqHYc8AAAABFqQCeQ","number":93704,"title":"[$250] CSV card feed import succeeds but no cards are created (no validation for missing required fields)","user":{"login":"m-natarajan","id":38435837,"node_id":"MDQ6VXNlcjM4NDM1ODM3","avatar_url":"https://avatars.githubusercontent.com/u/38435837?v=4","gravatar_id":"","url":"https://api.github.com/users/m-natarajan","html_url":"https: