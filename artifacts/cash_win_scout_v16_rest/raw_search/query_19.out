User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":112,"created_at":"2026-05-25T03:54:26Z","updated_at":"2026-07-07T01:56:05Z","closed_at":null,"assignee":{"login":"Beamanator","id":3885503,"node_id":"MDQ6VXNlcjM4ODU1MDM=","avatar_url":"https://avatars.githubusercontent.com/u/3885503?v=4","gravatar_id":"","url":"https://api.github.com/users/Beamanator","html_url":"https://github.com/Beamanator","followers_url":"https://api.github.com/users/Beamanator/followers","following_url":"https://api.github.com/users/Beamanator/following{/other_user}","gists_url":"https://api.github.com/users/Beamanator/gists{/gist_id}","starred_url":"https://api.github.com/users/Beamanator/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Beamanator/subscriptions","organizations_url":"https://api.github.com/users/Beamanator/orgs","repos_url":"https://api.github.com/users/Beamanator/repos","events_url":"https://api.github.com/users/Beamanator/events{/privacy}","received_events_url":"https://api.github.com/users/Beamanator/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** v9.3.80-0\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/test-runs/TR-32728/folder/13176671/41237461/1434928218\n**Email or phone of affected tester (no customers):** lekima20+623105@gmail.com\n**Issue reported by:** Applause Internal Team\n**Bug source:** Regression TC Execution\n**Device used:** Win 11/Chrome\n**App Component:** Money Requests\n\n## Action Performed:\n1. Open https://staging.new.expensify.com\n2. At Inbox tab, click on FAB > Send Invoice\n3. Complete sending invoice to a user who has never received an invoice before\n4. Wait few seconds\n\n## Expected Result:\nInvoice room is created without error\n\n## Actual Result:\nSending invoice to user who has never received an invoice before, Invoice room displays then skeleton loading infinitely until refresh page.\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [ ] MacOS: Chrome Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/a02edb39-a9b1-4c37-8797-a49f88e4ce96\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n\n> **Applause Internal Information**\n> Exported by: Julia Ponikarchuk\n> Bug ID: 7161549\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022058762163166899438\">https://www.upwork.com/jobs/~022058762163166899438</a></li>\n        <li>Upwork Job ID: 2058762163166899438</li>\n        <li>Last Price Increase: 2026-06-29</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @marufsharifi</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/91557/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/91557/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773","repository_url":"https://api.github.com/repos/Scottcjn/Rustchain","labels_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/comments","events_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/events","html_url":"https://github.com/Scottcjn/Rustchain/issues/773","id":4047382745,"node_id":"I_kwDOOdNtbc7xPijZ","number":773,"title":"[BOUNTY] Star the repo and share why (0.5 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8491289534,"node_id":"LA_kwDOOdNtbc8AAAAB-h7Lvg","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/good%20first%20issue","name":"good first issue","color":"7057FF","default":true,"description":"Good for newcomers (5-10 RTC)"},{"id":10159650136,"node_id":"LA_kwDOOdNtbc8AAAACXY_1WA","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC bounty reward"},{"id":10211346383,"node_id":"LA_kwDOOdNtbc8AAAACYKTHzw","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/community","name":"community","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":145,"created_at":"2026-03-09T19:09:20Z","updated_at":"2026-07-07T01:52:42Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 0.5 RTC\n\nStar the RustChain repo and leave a comment on this issue explaining what interested you about the project.\n\n### Rules\n- Must actually star the repo (we verify)\n- Comment must be genuine (2+ sentences, not copy-paste)\n- One claim per GitHub account\n- Include your wallet ID in your comment\n\n### How to claim\n1. Star this repo ⭐\n2. Comment below with what caught your eye + your wallet ID\n3. We'll send 0.5 RTC within 48 hours\n\n**Pool: 25 RTC** (50 stars)\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n\n\n---\n\n### ⚖️ Bounty Requirements (FTC 16 CFR §465.5 + §255.5 compliance)\n\n**A star alone does NOT qualify.** We pay for genuine engagement, not for indicators. To claim this bounty you must post a comment (on this issue or a linked post) containing:\n\n1. **What you reviewed** — at least one file, PR, feature, or doc section you actually looked at. Link it.\n2. **Why you liked it** — a specific, non-generic reason. \"Great project\" does not qualify.\n3. **Disclosure** — include the line: `I received RTC compensation for this review.` This keeps your star a transparent endorsement, not a purchased indicator.\n\nStars without a review comment will not be paid. Copy-pasted, AI-templated, or obviously recycled reviews will not be paid. This rule applies retroactively: unreviewed stars from before this update are grandfathered as goodwill but earn no future RTC.\n\n**Why this matters:** Elyan Labs is here to grow real engagement in mining and coding. A star backed by a real review is worth more to the network than a thousand drive-by clicks. This brings us into compliance with the FTC Consumer Review Rule (effective Oct 21, 2024), and — more importantly — keeps the signal honest.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/reactions","total_count":11,"+1":4,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":3,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/773/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/747","id":4037177278,"node_id":"I_kwDORGgqa87wom--","number":747,"title":"[BOUNTY: 50-75 RTC] Bounty Verification Bot — Auto-Verify Star/Follow Claims","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035932,"node_id":"LA_kwDORGgqa88AAAACWuczHA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/major","name":"major","color":"F9D0C4","default":false,"description":"50-200 RTC"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"},{"id":10356027005,"node_id":"LA_kwDORGgqa88AAAACaURufQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/development","name":"development","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":202,"created_at":"2026-03-07T03:24:23Z","updated_at":"2026-07-07T01:43:27Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty Verification Bot\n\nWe spend hours every session manually checking star counts, follow status, wallet existence, and article links. A bot that auto-verifies claims would save massive time.\n\n### What to Build\n\nA GitHub Action or bot that monitors bounty issue comments, detects claims, and posts automated verification results.\n\n### Payout\n\n| Milestone | Reward |\n|-----------|--------|\n| Star/follow verification (reads comment, checks GitHub API, posts result) | **30 RTC** |\n| Wallet existence check (queries RustChain node API) | **+10 RTC** |\n| Article/URL verification (checks dev.to/Medium links are live) | **+10 RTC** |\n| Dev.to article word count + quality check | **+10 RTC** |\n| Duplicate claim detection (checks if user already claimed) | **+15 RTC** |\n\n### How It Should Work\n\n1. **Triggered by**: New comment on bounty issues containing keywords like \"Claiming\", \"Wallet:\", \"Stars:\", \"GitHub:\"\n2. **Checks performed**:\n   - Does user follow @Scottcjn? (`GET /users/{user}/following/Scottcjn` → 204 = yes)\n   - How many Scottcjn repos has user starred? (paginate `/users/{user}/starred`)\n   - Does the claimed wallet exist? (`GET https://50.28.86.131/wallet/balance?miner_id={wallet}`)\n   - Is the claimed article URL live? (HEAD request, check 200)\n   - Has this user already been paid? (check for \"PAID\" in previous comments)\n3. **Posts a verification comment**:\n```\n## Automated Verification for @username\n\n| Check | Result |\n|-------|--------|\n| Follows @Scottcjn | ✅ Yes |\n| Scottcjn repos starred | 45 |\n| Wallet `my-wallet` exists | ✅ Balance: 10.5 RTC |\n| Article link | ✅ Live (dev.to, 612 words) |\n| Previous claims | ⚠️ Paid 25 RTC on #665 |\n\n**Suggested payout**: 45 stars × 1.0 RTC (follows + 45+ multiplier) = 45 RTC\n```\n\n### Technical Requirements\n\n1. **GitHub Action** (preferred) — runs on `issue_comment` webhook\n2. **Secrets needed**: `GITHUB_TOKEN` (for API), `RUSTCHAIN_NODE_URL`\n3. **Rate limit aware** — GitHub API has limits, batch requests efficiently\n4. **No payment execution** — bot ONLY verifies, human approves payment\n5. **Configurable** — bounty rules (rate per star, follow multiplier) in a config file\n6. **Open source** on GitHub\n\n### Why This Matters\n\nManual verification takes 2-5 minutes per claim. With 20+ claims per session, that's over an hour of repetitive API checking. The bot does it in seconds and never makes math errors.\n\nThe human (Scott) still decides whether to pay — the bot just eliminates the grunt work.\n\n### Submit As\n\nStandalone repo with GitHub Action workflow, or PR to a new `Scottcjn/bounty-bot` repo.\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/reactions","total_count":4,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/731","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/731/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/731/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/731/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/731","id":4036807427,"node_id":"I_kwDORGgqa87wnMsD","number":731,"title":"[BOUNTY: 0.33 RTC/repo] Watch Our Repos — Stay Notified, Earn RTC (Up to 7 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071047,"node_id":"LA_kwDORGgqa88AAAACXSuRxw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/easy","name":"easy","color":"0E8A16","default":false,"description":"Low difficulty bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":120,"created_at":"2026-03-07T00:40:02Z","updated_at":"2026-07-07T01:33:45Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Watch Our Repos — Get Notified, Earn RTC\n\n### The Bounty\n\n**Watch** (not just star) key Scottcjn repos on GitHub. Watching means you get notified about new issues, PRs, and discussions — which means you see bounties first.\n\n### Payout\n\n**0.5 RTC per repo watched** — watch 10 repos, earn 5 RTC. Cap: 20 repos (10 RTC max).\n\n### How GitHub Watch Works\n\nClicking **Watch → All Activity** on a repo means you get GitHub notifications for:\n- New issues (bounties!)\n- New PRs\n- New discussions\n- Releases\n\nThis is different from starring. Stars = bookmark. Watch = subscribe to updates.\n\n### Priority Repos to Watch\n\n| Repo | Why Watch |\n|------|-----------|\n| [rustchain-bounties](https://github.com/Scottcjn/rustchain-bounties) | New bounties posted here first |\n| [Rustchain](https://github.com/Scottcjn/Rustchain) | Core chain updates, RIPs |\n| [bottube](https://github.com/Scottcjn/bottube) | Platform bounties, feature requests |\n| [beacon-skill](https://github.com/Scottcjn/beacon-skill) | Agent economy updates |\n| [ram-coffers](https://github.com/Scottcjn/ram-coffers) | POWER8 AI research |\n| [rustchain-wallet](https://github.com/Scottcjn/rustchain-wallet) | Wallet development |\n| [bounty-concierge](https://github.com/Scottcjn/bounty-concierge) | Bounty tooling |\n| [grazer](https://github.com/Scottcjn/grazer) | AI agent crawling |\n| [elyan-prime](https://github.com/Scottcjn/elyan-prime) | Cognitive MCP framework |\n| [sophiacord](https://github.com/Scottcjn/sophiacord) | Discord bot ecosystem |\n\n### Requirements\n\n1. **Watch with \"All Activity\"** — not just \"Releases only\" or \"Participating\"\n2. **Minimum 5 repos** to claim (2.5 RTC minimum payout)\n3. **Must also follow @Scottcjn** on GitHub\n\n### How to Verify\n\nWe can check watchers via the GitHub API. When you claim:\n1. Comment here with your GitHub username and RTC wallet\n2. List which repos you watched\n3. We'll verify via API\n\n### Why This Matters\n\nWatchers are more valuable than stars for community building:\n- **Stars** = \"I noticed this exists\" (passive)\n- **Watches** = \"I want to stay involved\" (active)\n- Watchers see new bounties **immediately** in their notifications\n- More watchers = faster bounty completion = faster ecosystem growth\n\nCurrently Rustchain has only **7 watchers**. Most repos have 1-3. Getting this to 20-30 means bounties get claimed faster and PRs get reviewed sooner.\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/731/reactions","total_count":9,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":3,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/731/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/93682","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/93682/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/93682/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/93682/events","html_url":"https://github.com/Expensify/App/issues/93682","id":4673214147,"node_id":"I_kwDOEQqHYc8AAAABFouWww","number":93682,"title":"[$250] Hold-Error if submit report all hold expenses or the unhold move to new report after submitted","user":{"login":"applause-bot[bot]","id":265651874,"node_id":"BOT_kgDOD9WGog","avatar_url":"https://avatars.githubusercontent.com/in/3009811?v=4","gravatar_id":"","url":"https://api.github.com/users/applause-bot%5Bbot%5D","html_url":"https://github.com/apps/applause-bot","followers_url":"https://api.github.com/users/applause-bot%5Bbot%5D/followers","following_url":"https://api.github.com/users/applause-bot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/applause-bot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/applause-bot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/applause-bot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/applause-bot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/applause-bot%5Bbot%5D/repos","events_url":"https://api.github.com/users/applause-bot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/applause-bot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893455829,"node_id":"MDU6TGFiZWwyODkzNDU1ODI5","url":"https://api.github.com/repos/Expensify/App/labels/Daily","name":"Daily","color":"eb6420","default":false,"description":"KSv2"},{"id":3136662525,"node_id":"MDU6TGFiZWwzMTM2NjYyNTI1","url":"https://api.github.com/repos/Expensify/App/labels/Help%20Wanted","name":"Help Wanted","color":"CFC8F1","default":false,"description":"Apply this label when an issue is open to proposals by contributors"},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"huult","id":20178761,"node_id":"MDQ6VXNlcjIwMTc4NzYx","avatar_url":"https://avatars.githubusercontent.com/u/20178761?v=4","gravatar_id":"","url":"https://api.github.com/users/huult","html_url":"https://github.com/huult","followers_url":"https://api.github.com/users/huult/followers","following_url":"https://api.github.com/users/huult/following{/other_user}","gists_url":"https://api.github.com/users/huult/gists{/gist_id}","starred_url":"https://api.github.com/users/huult/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/huult/subscriptions","organizations_url":"https://api.github.com/users/huult/orgs","repos_url":"https://api.github.com/users/huult/repos","events_url":"https://api.github.com/users/huult/events{/privacy}","received_events_url":"https://api.github.com/users/huult/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":35,"created_at":"2026-06-16T10:14:24Z","updated_at":"2026-07-07T01:25:41Z","closed_at":null,"assignee":{"login":"huult","id":20178761,"node_id":"MDQ6VXNlcjIwMTc4NzYx","avatar_url":"https://avatars.githubusercontent.com/u/20178761?v=4","gravatar_id":"","url":"https://api.github.com/users/huult","html_url":"https://github.com/huult","followers_url":"https://api.github.com/users/huult/followers","following_url":"https://api.github.com/users/huult/following{/other_user}","gists_url":"https://api.github.com/users/huult/gists{/gist_id}","starred_url":"https://api.github.com/users/huult/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/huult/subscriptions","organizations_url":"https://api.github.com/users/huult/orgs","repos_url":"https://api.github.com/users/huult/repos","events_url":"https://api.github.com/users/huult/events{/privacy}","received_events_url":"https://api.github.com/users/huult/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** v9.4.8-0\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/test-runs/60660790/folder/13176872/41237338/1490024742?sort=-identifier\n**Email or phone of affected tester (no customers):** lekima20+68306@gmail.com\n**Issue reported by:** Applause Internal Team\n**Bug source:** Regression TC Execution\n**Device used:** Win 11/Chrome\n**App Component:** Money Requests\n\n## Action Performed:\nPrecondition: Employee navigate to the workspace chat create a report with 2 expenses, create another report with 3 expenses\n\n1. Open https://staging.new.expensify.com login as employee\n2. Navigate to the workspace chat and click on the report having 2 expenses\n3. Hold 2 expenses\n4. Click on Submit button\n5. Go back to the workspace chat and click on the report having 3 expenses\n6. Hold 2 expenses\n7. Click on Submit button\n\n## Expected Result:\nThe employee can submit a report containing held expenses without error\n\n## Actual Result:\nUnexpected error is displayed when employee submits the report containing all hold expenses. If submitted the report containing 2 hold expenses, the unhold expense is moved to new report with outstanding status, the 2 hold expenses is still in draft status.\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [x] Android: App\n- [ ] Android: mWeb Chrome\n- [x] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [ ] MacOS: Chrome Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/023366d9-1126-4c00-bcdb-f1b30852a069\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n\n> **Applause Internal Information**\n> Exported by: Rizky Gunawan\n> Bug ID: 7181889\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022070238632760684653\">https://www.upwork.com/jobs/~022070238632760684653</a></li>\n        <li>Upwork Job ID: 2070238632760684653</li>\n        <li>Last Price Increase: 2026-07-02</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/93682/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/93682/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/snowdensb/nibrs/issues/481","repository_url":"https://api.github.com/repos/snowdensb/nibrs","labels_url":"https://api.github.com/repos/snowdensb/nibrs/issues/481/labels{/name}","comments_url":"https://api.github.com/repos/snowdensb/nibrs/issues/481/comments","events_url":"https://api.github.com/repos/snowdensb/nibrs/issues/481/events","html_url":"https://github.com/snowdensb/nibrs/issues/481","id":2279910708,"node_id":"I_kwDOFgNxhs6H5K00","number":481,"title":"moment-2.8.4.min.js: 4 vulnerabilities (highest severity is: 7.5)","user":{"login":"mend-for-github-com[bot]","id":50673670,"node_id":"MDM6Qm90NTA2NzM2NzA=","avatar_url":"https://avatars.githubusercontent.com/in/30796?v=4","gravatar_id":"","url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D","html_url":"https://github.com/apps/mend-for-github-com","followers_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/followers","following_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/repos","events_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/mend-for-github-com%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[{"id":3017567882,"node_id":"MDU6TGFiZWwzMDE3NTY