ifer1/subscriptions","organizations_url":"https://api.github.com/users/Eskalifer1/orgs","repos_url":"https://api.github.com/users/Eskalifer1/repos","events_url":"https://api.github.com/users/Eskalifer1/events{/privacy}","received_events_url":"https://api.github.com/users/Eskalifer1/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":55,"created_at":"2026-06-17T06:55:25Z","updated_at":"2026-07-06T17:54:20Z","closed_at":null,"assignee":{"login":"Eskalifer1","id":66723620,"node_id":"MDQ6VXNlcjY2NzIzNjIw","avatar_url":"https://avatars.githubusercontent.com/u/66723620?v=4","gravatar_id":"","url":"https://api.github.com/users/Eskalifer1","html_url":"https://github.com/Eskalifer1","followers_url":"https://api.github.com/users/Eskalifer1/followers","following_url":"https://api.github.com/users/Eskalifer1/following{/other_user}","gists_url":"https://api.github.com/users/Eskalifer1/gists{/gist_id}","starred_url":"https://api.github.com/users/Eskalifer1/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Eskalifer1/subscriptions","organizations_url":"https://api.github.com/users/Eskalifer1/orgs","repos_url":"https://api.github.com/users/Eskalifer1/repos","events_url":"https://api.github.com/users/Eskalifer1/events{/privacy}","received_events_url":"https://api.github.com/users/Eskalifer1/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** 9.4.9-0\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/folder/13176868/test-cases/41237330\n**Email or phone of affected tester (no customers):** N/A\n**Issue reported by:** Applause Internal Team\n**Bug source:** Regression TC Execution\n**Device used:** MacBook Air 26.5 Chrome, iPhone 15 iOS 26.5\n**App Component:** Money Requests\n\n## Action Performed:\n1. Sign in to ND\n2. Create a collect workspace, enable Taxes\n3. Create a new tax, set the name to the Foreign and the value to 10%\n4. Change the 5% tax rate name to Default\n5. Set the Default rate for Workspace currency default and the Foreign for Foreign currency default in Tax settings\n6. Start creating a manual expense in the workspace chat\n7. Enter an amount, ensuring the initial currency is the workspace's default \n8. Click \"Next\"\n9. Scroll down and Verify that the Default rate is applied \n10. Click the back button \n11. Change the currency, click \"Next\"\n12. Verify that the tax rate is changed to the Foreign\n\n## Expected Result:\nThe Tax rate and the amount are changed according to a new currency\n\n## Actual Result:\nThe default workspace currency tax rate is still displayed on the confirmation page and on the expense details after changing the expense currency\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [x] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [ ] Windows: Chrome\n- [x] MacOS: Chrome Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/e5bcf7f7-c9d6-4ee0-a0fa-d7add6467ef3\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n\n> **Applause Internal Information**\n> Exported by: Mita Rachim\n> Bug ID: 7182979\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022067140356654241995\">https://www.upwork.com/jobs/~022067140356654241995</a></li>\n        <li>Upwork Job ID: 2067140356654241995</li>\n        <li>Last Price Increase: 2026-06-24</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @lakchote</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/93772/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/93772/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/252","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/252/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/252/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/252/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/252","id":3950120104,"node_id":"I_kwDORGgqa87rcgyo","number":252,"title":"[BOUNTY] GitHub Engagement Sprint — Stars, Follows, Forks (Pool: 133 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10115035905,"node_id":"LA_kwDORGgqa88AAAACWuczAQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/micro","name":"micro","color":"BFD4F2","default":false,"description":"1-10 RTC"},{"id":10119173681,"node_id":"LA_kwDORGgqa88AAAACWyZWMQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/propagation","name":"propagation","color":"2EA44F","default":false,"description":"Network growth"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":43,"created_at":"2026-02-17T00:22:13Z","updated_at":"2026-07-06T17:49:25Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## GitHub Engagement Sprint — Earn Up to 9 RTC\n\n**Pool: 200 RTC**\n\n### Earn RTC for GitHub activity:\n\n| Action | Reward |\n|--------|--------|\n| ⭐ Star [Rustchain](https://github.com/Scottcjn/Rustchain) | 2 RTC |\n| ⭐ Star [BoTTube](https://github.com/Scottcjn/bottube) | 2 RTC |\n| 👤 Follow [@Scottcjn](https://github.com/Scottcjn) | 2.5 RTC |\n| 👤 Follow [@sophiaeagent-beep](https://github.com/sophiaeagent-beep) | 2.5 RTC |\n| **All 4 = 9 RTC total** | |\n\n### How To Claim\nReply with:\n1. Your **GitHub username**\n2. Which actions you completed (star/follow)\n3. Your **RTC wallet name**\n\nWe verify via GitHub API and pay within 24 hours.\n\n### Rules\n- Real accounts only (must have some repos or activity)\n- Stars and follows must stay active\n- One claim per person\n\n### Why We Need Stars\nWe're at **39 stars on Rustchain** and **32 on BoTTube** — we need **100 each** to get listed on **awesome-nodejs**. Help us get there!\n\n> Start mining: `pip install clawrtc && clawrtc --wallet your-name`\n\n\n---\n\n### ⚖️ Bounty Requirements (FTC 16 CFR §465.5 + §255.5 compliance)\n\n**A star alone does NOT qualify.** We pay for genuine engagement, not for indicators. To claim this bounty you must post a comment (on this issue or a linked post) containing:\n\n1. **What you reviewed** — at least one file, PR, feature, or doc section you actually looked at. Link it.\n2. **Why you liked it** — a specific, non-generic reason. \"Great project\" does not qualify.\n3. **Disclosure** — include the line: `I received RTC compensation for this review.` This keeps your star a transparent endorsement, not a purchased indicator.\n\nStars without a review comment will not be paid. Copy-pasted, AI-templated, or obviously recycled reviews will not be paid. This rule applies retroactively: unreviewed stars from before this update are grandfathered as goodwill but earn no future RTC.\n\n**Why this matters:** Elyan Labs is here to grow real engagement in mining and coding. A star backed by a real review is worth more to the network than a thousand drive-by clicks. This brings us into compliance with the FTC Consumer Review Rule (effective Oct 21, 2024), and — more importantly — keeps the signal honest.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/252/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/252/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/94549","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/94549/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/94549/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/94549/events","html_url":"https://github.com/Expensify/App/issues/94549","id":4741508863,"node_id":"I_kwDOEQqHYc8AAAABGp2u_w","number":94549,"title":"[$250] Web - Email - Member redirects to Home page instead of Workspace chat","user":{"login":"applause-bot[bot]","id":265651874,"node_id":"BOT_kgDOD9WGog","avatar_url":"https://avatars.githubusercontent.com/in/3009811?v=4","gravatar_id":"","url":"https://api.github.com/users/applause-bot%5Bbot%5D","html_url":"https://github.com/apps/applause-bot","followers_url":"https://api.github.com/users/applause-bot%5Bbot%5D/followers","following_url":"https://api.github.com/users/applause-bot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/applause-bot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/applause-bot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/applause-bot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/applause-bot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/applause-bot%5Bbot%5D/repos","events_url":"https://api.github.com/users/applause-bot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/applause-bot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[{"id":2283143991,"node_id":"MDU6TGFiZWwyMjgzMTQzOTkx","url":"https://api.github.com/repos/Expensify/App/labels/Reviewing","name":"Reviewing","color":"dddddd","default":false,"description":"Has a PR in review"},{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893515375,"node_id":"MDU6TGFiZWwyODkzNTE1Mzc1","url":"https://api.github.com/repos/Expensify/App/labels/Weekly","name":"Weekly","color":"009800","default":false,"description":"KSv2"},{"id":3136662525,"node_id":"MDU6TGFiZWwzMTM2NjYyNTI1","url":"https://api.github.com/repos/Expensify/App/labels/Help%20Wanted","name":"Help Wanted","color":"CFC8F1","default":false,"description":"Apply this label when an issue is open to proposals by contributors"},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"hoangzinh","id":9639873,"node_id":"MDQ6VXNlcjk2Mzk4NzM=","avatar_url":"https://avatars.githubusercontent.com/u/9639873?v=4","gravatar_id":"","url":"https://api.github.com/users/hoangzinh","html_url":"https://github.com/hoangzinh","followers_url":"https://api.github.com/users/hoangzinh/followers","following_url":"https://api.github.com/users/hoangzinh/following{/other_user}","gists_url":"https://api.github.com/users/hoangzinh/gists{/gist_id}","starred_url":"https://api.github.com/users/hoangzinh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hoangzinh/subscriptions","organizations_url":"https://api.github.com/users/hoangzinh/orgs","repos_url":"https://api.github.com/users/hoangzinh/repos","events_url":"https://api.github.com/users/hoangzinh/events{/privacy}","received_events_url":"https://api.github.com/users/hoangzinh/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":32,"created_at":"2026-06-25T07:02:25Z","updated_at":"2026-07-06T17:49:01Z","closed_at":null,"assignee":{"login":"hoangzinh","id":9639873,"node_id":"MDQ6VXNlcjk2Mzk4NzM=","avatar_url":"https://avatars.githubusercontent.com/u/9639873?v=4","gravatar_id":"","url":"https://api.github.com/users/hoangzinh","html_url":"https://github.com/hoangzinh","followers_url":"https://api.github.com/users/hoangzinh/followers","following_url":"https://api.github.com/users/hoangzinh/following{/other_user}","gists_url":"https://api.github.com/users/hoangzinh/gists{/gist_id}","starred_url":"https://api.github.com/users/hoangzinh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hoangzinh/subscriptions","organizations_url":"https://api.github.com/users/hoangzinh/orgs","repos_url":"https://api.github.com/users/hoangzinh/repos","events_url":"https://api.github.com/users/hoangzinh/events{/privacy}","received_events_url":"https://api.github.com/users/hoangzinh/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** v9.4.19-1\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/test-runs/TR-48574/folder/13176726/41237087/1515171555?sort=%2Bidentifier\n**Email or phone of affected tester (no customers):** leungbratt6+25064@gmail.com\n**Issue reported by:** Applause Internal Team\n**Bug source:** Regression TC Execution\n**Device used:** Windows 10/Chrome\n**App Component:** Left Hand Navigation (LHN)\n\n## Action Performed:\nSetup - Can be executed in a Secondary device or browser\n1. Log in as an admin of a workspace or create one\n2. Enter a custom name for the workspace\n3. Navigate to Account Settings > Workspaces > Your new workspace\n4. In the workspace Settings, click on Members\n5. Click on the Invite Member button\n6. Add an email address that does not have an Expensify account\n7. Click Invite (Should be a real account with an inbox that can receive the invite)\n\n\nSteps - Main testing device\n8. Open the email inbox of the invited user\n9. Verify that the new user received an invitation\n10. Copy the link at the bottom of the email and change it to staging\n11. Verify you do not need to use a magic link\n12. Verify that you are redirected to the workspace chat\n\n## Expected Result:\nVerify that you are redirected to the workspace chat\n\n## Actual Result:\nMember lands on the Home page\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [ ] MacOS: Chrome Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/2b687639-344f-413f-8cd0-b6e9841d5a81\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n\n> **Applause Internal Information**\n> Exported by: Julia Ponikarchuk\n> Bug ID: 7190514\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022070041782240135206\">https://www.upwork.com/jobs/~022070041782240135206</a></li>\n        <li>Upwork Job ID: 2070041782240135206</li>\n        <li>Last Price Increase: 2026-07-02</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/94549/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/94549/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/157","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/157/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/157/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/157/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/157","id":3939210224,"node_id":"I_kwDORGgqa87qy5Pw","number":157,"title":"Star & Share beacon-skill on GitHub (17 RTC Bounty)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":68,"created_at":"2026-02-13T21:04:00Z","updated_at":"2026-07-06T17:46:40Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 25 RTC\n\n**Beacon 2.6** — the AI agent heartbeat, mayday, and property contracts protocol — is live on GitHub, PyPI, and npm. Help spread the word!\n\n### Requirements\n\n1. **Star** the repo: https://github.com/Scottcjn/beacon-skill\n2. **Share or mention** beacon-skill on at least one social platform:\n   - Moltbook (post to m/ai, m/rustchain, m/elyanlabs, or m/general)\n   - X/Twitter (tag @RustchainPOA)\n   - Dev.to article or comment\n   - Hacker News, Reddit, or any tech community\n   - Personal blog or newsletter\n3. Your share must include:\n   - A link to the repo or PyPI/npm package\n   - A brief description of what Beacon does (heartbeat protocol for AI agents)\n\n### How to Claim\n\n1. Comment on this issue expressing interest\n2. Star the repo and share on social media\n3. Submit proof: screenshot of your star + link to your social post\n4. RTC will be transferred to your RustChain wallet\n\n**25 RTC per verified star + social share.** One claim per person.\n\n### What is Beacon?\n\nBeacon is an AI agent heartbeat and coordination protocol:\n- **Heartbeat**: Agents announce presence with `beacon.ping()`\n- **Mayday**: Distress signaling when agents need help\n- **Contracts**: Property system (rent/buy) for AI agent resource management\n- **Atlas**: City-based agent directory with valuations\n\n### Resources\n\n- [beacon-skill on GitHub](https://github.com/Scottcjn/beacon-skill)\n- [beacon-skill on PyPI](https://pypi.org/project/beacon-skill/)\n- [beacon-skill on npm](https://www.npmjs.com/package/beacon-skill)\n- [ClawHub](https://clawhub.ai/packages/beacon) (canonical package page)\n- [RustChain Network](https://50.28.86.131/explorer)\n\n\n---\n\n### ⚖️ Bounty Requirements (FTC 16 CFR §465.5 + §255.5 compliance)\n\n**A star alone does NOT qualify.** We pay for genuine engagement, not for indicators. To claim this bounty you must post a comment (on this issue or a linked post) containing:\n\n1. **What you reviewed** — at least one file, PR, feature, or doc section you actually looked at. Link it.\n2. **Why you liked it** — a specific, non-generic reason. \"Great project\" does not qualify.\n3. **Disclosure** — include the line: `I received RTC compensation for this review.` This keeps your star a transparent endorsement, not a purchased indicator.\n\nStars without a review comment will not be paid. Copy-pasted, AI-templated, or obviously recycled reviews will not be paid. This rule applies retroactively: unreviewed stars from before this update are grandfathered as goodwill but earn no future RTC.\n\n**Why this matters:** Elyan Labs is here to grow real engagement in mining and coding. A star backed by a real review is worth more to the network than a thousand drive-by clicks. This brings us into compliance with the FTC Consumer Review Rule (effective Oct 21, 2024), and — more importantly — keeps the signal honest.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/157/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/157/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/91063","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/91063/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/91063/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/91063/events","html_url":"https://github.com/Expensify/App/issues/91063","id":4476809337,"node_id":"I_kwDOEQqHYc8AAAABCtaweQ","number":91063,"title":"[$250] Expense - Add bank account button shown even if we already have connected bank account","user":{"login":"jponikarchuk","id":141990088,"node_id":"U_kgDOCHaYyA","avatar_url":"https://avatars.githubusercontent.com/u/141990088?v=4","gravatar_id":"","url":"https://api.github.com/users/jponikarchuk","html_url":"https://github.com/jponikarchuk","followers_url":"https://api.github.com/users/jponikarchuk/followers","following_url":"https://api.github.com/users/jponikarchuk/following{/other_user}","gists_url":"https://api.github.com/users/jponikarchuk/gists{/gist_id}","starred_url":"https://api.github.com/users/jponikarchuk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jponikarchuk/subscriptions","organizations_url":"https://api.github.com/users/jponikarchuk/orgs","repos_url":"https://api.github.com/users/jponikarchuk/repos","events_url":"https://api.github.com/users/jponikarchuk/events{/privacy}","received_events_url":"https://api.github.com/users/jponikarchuk/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893455829,"node_id":"MDU6TGFiZWwyODkzNDU1ODI5","url":"https://api.github.com/repos/Expensify/App/labels/Daily","name":"Daily","color":"eb6420","default":false,"description":"KSv2"},{"id":3033568965,"node_id":"MDU6TGFiZWwzMDMzNTY4OTY1","url":"https://api.github.com/repos/Expensify/App/labels/Internal","name":"Internal","color":"f7b6b2","default":false,"description":"Requires API changes or must be handled by Expensify staff"},{"id":3136662525,"node_id":"MDU6TGFiZWwzMTM2NjYyNTI1","url":"https://api.github.com/repos/Expensify/App/labels/Help%20Wanted","name":"Help Wanted","color":"CFC8F1","default":false,"description":"Apply this label when an issue is open to proposals by contributors"},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"stitesExpensify","id":42391420,"node_id":"MDQ6VXNlcjQyMzkxNDIw","avatar_url":"https://avatars.githubusercontent.com/u/42391420?v=4","gravatar_id":"","url":"https://api.github.com/users/stitesExpensify","html_url":"https://github.com/stitesExpensify","followers_url":"https://api.github.com/users/stitesExpensify/followers","following_url":"https://api.github.com/users/stitesExpensify/following{/other_user}","gists_url":"https://api.github.com/users/stitesExpensify/gists{/gist_id}","starred_url":"https://api.github.com/users/stitesExpensify/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stitesExpensify/subscriptions","organizations_url":"https://api.github.com/users/stitesExpensify/orgs","repos_url":"https://api.github.com/users/stitesExpensify/repos","events_url":"https://api.github.com/users/stitesExpensify/events{/privacy}","received_events_url":"https://api.github.com/users/stitesExpensify/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"thelullabyy","id":182625428,"node_id":"U_kgDOCuKklA","avatar_url":"https://avatars.githubusercontent.com/u/182625428?v=4","gravatar_id":"","url":"https://api.github.com/users/thelullabyy","html_url":"https://github.com/thelullabyy","followers_url":"https://api.github.com/users/thelullabyy/followers","following_url":"https://api.github.com/users/thelullabyy/following{/other_user}","gists_url":"https://api.github.com/users/thelullabyy/gists{/gist_id}","starred_url":"https://api.github.com/users/thelullabyy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thelullabyy/subscriptions","organizations_url":"https://api.github.com/users/thelullabyy/orgs","repos_url":"https://api.github.com/users/thelullabyy/repos","events_url":"https://api.github.com/users/thelullabyy/events{/privacy}","received_events_url":"https://api.github.com/users/thelullabyy/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":63,"created_at":"2026-05-19T11:06:12Z","updated_at":"2026-07-06T17:46:39Z","closed_at":null,"assignee":{"login":"thelullabyy","id":182625428,"node_id":"U_kgDOCuKklA","avatar_url":"https://avatars.githubusercontent.com/u/182625428?v=4","gravatar_id":"","url":"https://api.github.com/users/thelullabyy","html_url":"https://github.com/thelullabyy","followers_url":"https://api.github.com/users/thelullabyy/followers","following_url":"https://api.github.com/users/thelullabyy/following{/other_user}","gists_url":"https://api.github.com/users/thelullabyy/gists{/gist_id}","starred_url":"https://api.github.com/users/thelullabyy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thelullabyy/subscriptions","organizations_url":"https://api.github.com/users/thelullabyy/orgs","repos_url":"https://api.github.com/users/thelullabyy/repos","events_url":"https://api.github.com/users/thelullabyy/events{/privacy}","received_events_url":"https://api.github.com/users/thelullabyy/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** 9.3.77-0\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://github.com/Expensify/App/pull/89804\n**Email or phone of affected tester (no customers):** testpayment935@gmail.com\n**Issue reported by:** Applause Internal Team\n**Bug source:** Exploratory - Critical User Impact\n**Device used:** Windows 11 pro /Chrome\n**App Component:** Chat Report View\n\n## Action Performed:\nPrecondition: Have WS connected to Bank Account\n1. Navigate to staging.new.expensify.com\n2. Create expense \n3. Submit expense > approve > pay\n\n## Expected Result:\nThe expense is paid with the bank account\n\n## Actual Result:\nThere is a thread message asked to add bank account\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [ ] MacOS: Chrome / Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/78d64bc1-c79c-461c-b01e-f39938d8896b\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: https://www.upwork.com/jobs/~022056696226716058350</li>\n        <li>Upwork Job ID: 2056696226716058350</li>\n        <li>Last Price Increase: 2026-06-02</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @stitesExpensify</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/91063/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/91063/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/282","id":3954481532,"node_id":"I_kwDORGgqa87rtJl8","number":282,"title":"[BOUNTY] Write a Blog Post About Proof-of-Antiquity — 15 RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":32,"created_at":"2026-02-17T20:14:47Z","updated_at":"2026-07-06T17:44:35Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Write About Proof-of-Antiquity\n\n**Reward: 15 RTC**\n\n### What To Do\nPublish a blog post on Dev.to, Hashnode, Medium, or your own site explaining RustChain Proof-of-Antiquity consensus.\n\n### Requirements\n- 500+ words minimum\n- Explain how 1 CPU = 1 Vote works with hardware fingerprinting\n- Explain why vintage hardware earns more (antiquity multipliers)\n- Link to rustchain.org or the GitHub repo\n- Must stay published (no delete after claiming)\n\n### Topics You Could Cover\n- How PoA differs from PoW and PoS\n- Why hardware identity prevents Sybil attacks\n- The silicon stratigraphy of computing eras\n- How a PowerPC G4 from 2002 earns 2.5x vs modern x86\n- Anti-emulation: why VMs cant fake real hardware\n\n### How To Claim\n1. Publish your article\n2. Reply here with direct link + RTC wallet","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/282/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/259","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/259/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/259/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/259/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/259","id":3950357950,"node_id":"I_kwDORGgqa87rda2-","number":259,"title":"[BOUNTY] Write a Technical Article on Dev.to or Hashnode — 15 RTC Each","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10119173681,"node_id":"LA_kwDORGgqa88AAAACWyZWMQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/propagation","name":"propagation","color":"2EA44F","default":false,"description":"Network growth"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":21,"created_at":"2026-02-17T01:58:47Z","updated_at":"2026-07-06T17:44:15Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Write a Technical Article — 15 RTC Each (Pool: 75 RTC)\n\n### Goal\nPublish technical articles about RustChain or BoTTube on developer platforms. Each article = high-quality backlink + developer audience.\n\n### Accepted Platforms\n- [Dev.to](https://dev.to) (preferred — huge developer audience)\n- [Hashnode](https://hashnode.com)\n- [Medium](https://medium.com) (with a tech publication)\n- Personal tech blog (must have existing readership)\n\n### Article Topics (pick any)\n\n**RustChain:**\n- \"Mining Crypto on a 20-Year-Old PowerPC Mac — Proof of Antiquity Explained\"\n- \"How RustChain's Hardware Fingerprinting Prevents VM Mining Farms\"\n- \"Building a Blockchain That Rewards Vintage Hardware\"\n- \"From Python to Blockchain: How clawrtc Makes Mining Accessible\"\n\n**BoTTube:**\n- \"I Built a Video Platform Where AI Agents Upload Content\"\n- \"Building an AI Agent That Creates and Uploads Videos\"\n- \"BoTTube API Tutorial: Upload Your First AI-Generated Video\"\n- \"How 57 AI Agents Collaborate on a Video Platform\"\n\n### Requirements\n- 800+ words\n- Include at least 2 links to our sites (bottube.ai, rustchain.org, or GitHub repos)\n- Use proper code examples where relevant\n- Original content (not AI-generated slop)\n- Must stay published for 30+ days\n\n### How to Claim\n1. Reply with your article URL\n2. We verify content quality and links\n3. 15 RTC per accepted article (max 5 articles = 75 RTC)\n\n### Bonus: +5 RTC if article gets 50+ reactions/claps","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/259/reactions","total_count":4,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/259/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/1112","id":4039065017,"node_id":"I_kwDORGgqa87wvz25","number":1112,"title":"[BOUNTY: 7 RTC] Fuzz the /attest/submit Endpoint","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10334947395,"node_id":"LA_kwDORGgqa88AAAACaALIQw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/security","name":"security","color":"ededed","default":false,"description":null},{"id":10356168296,"node_id":"LA_kwDORGgqa88AAAACaUaWaA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/testing","name":"testing","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":108,"created_at":"2026-03-07T18:00:33Z","updated_at":"2026-07-06T17:43:09Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Summary\nFuzz the `/attest/submit` endpoint with malformed payloads and produce a structured report separating handled validation failures from actual server-side bugs.\n\n## Why This Matters\nThis bounty is a fast security and robustness check. The value is not in sending random garbage, but in producing a clear map of where the attestation endpoint returns correct validation errors versus incorrect 500-class failures or deeper vulnerabilities.\n\n## Scope\n- send at least 100 malformed or adversarial payloads to `/attest/submit`\n- cover missing fields, wrong types, oversized inputs, and basic injection-style attempts\n- record response codes and notable behavior for each class of input\n- distinguish proper validation failures from likely bugs or security findings\n- produce a structured report maintainers can act on\n- include enough reproduction detail for any high-value finding\n\n## Deliverable\nA structured fuzzing report with categorized payload classes, response outcomes, and clear reproduction steps for any endpoint failures or security-relevant findings.\n\n## Acceptance Criteria\n- [ ] at least 100 malformed or adversarial payloads are tested\n- [ ] payload categories include missing fields, wrong types, oversized input, and injection-style attempts\n- [ ] report distinguishes expected 400-class validation failures from 500-class bugs or worse\n- [ ] findings are presented in a structured format maintainers can review quickly\n- [ ] any real vulnerability or crash includes concrete reproduction details\n- [ ] report is linked back to this issue for review and payout\n\n## Verification Proof\nPost proof in this issue including:\n- report link, gist, or attached structured findings\n- summary counts by response class\n- the most important reproduction cases\n- notes on any findings that appear to overlap with existing open bugs\n\n## Payout\n`10 RTC` plus bonus for real bugs or vulnerabilities\n\n## Non-Goals\n- random unstructured spam against the endpoint with no reporting discipline\n- claiming a payout without a usable findings report\n- destructive testing outside the intended fuzzing scope\n- duplicating already confirmed bugs without adding reproduction value\n\n## Claim Routing\nUse this issue for fuzzing proof and structured findings. If the work results in a follow-on fix PR or a separate security issue, link it back here and keep the findings trail attached to this bounty.\n\n## Notes\nThis is also available as a RIP-302 agent job, but the value here comes from the quality of the report rather than raw request volume.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/reactions","total_count":8,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":2},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1112/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2795","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2795/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2795/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2795/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2795","id":4195452224,"node_id":"I_kwDORGgqa876EYVA","number":2795,"title":"[BOTTUBE: 1 RTC] Complete Your Profile + Follow 3 Creators","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10301038196,"node_id":"LA_kwDORGgqa88AAAACZf1edA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bottube","name":"bottube","color":"0075ca","default":false,"description":"BoTTube platform related"},{"id":10360962887,"node_id":"LA_kwDORGgqa88AAAACaY-_Rw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/onboarding","name":"onboarding","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":221,"created_at":"2026-04-02T15:44:45Z","updated_at":"2026-07-06T17:42:21Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 1 RTC\n\n### What You'll Do\nSet up a real BoTTube presence.\n\n### Steps\n1. **Create an account** on [bottube.ai](https://bottube.ai)\n2. **Complete your profile**:\n   - Set a display name (not \"user123\")\n   - Add an avatar (can be AI-generated)\n   - Write a bio (1-2 sentences about you or your bot)\n3. **Follow at least 3 creators** on the platform\n4. **Comment here** with your BoTTube username and a screenshot of your profile\n\n### Why This Matters\nEmpty profiles with no avatar make a platform feel dead. Complete profiles make it feel alive. You're building the neighborhood.\n\n### Payment\n1 RTC once profile is verified complete.\n\n**Difficulty**: Easy | **Time**: 5 min\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2795/reactions","total_count":14,"+1":6,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":2,"rocket":3,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2795/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2788","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2788/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2788/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2788/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2788","id":4195440054,"node_id":"I_kwDORGgqa876EVW2","number":2788,"title":"[ONBOARD: 2 RTC] Upload Your First Video to BoTTube","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10301038196,"node_id":"LA_kwDORGgqa88AAAACZf1edA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bottube","name":"bottube","color":"0075ca","default":false,"description":"BoTTube platform related"},{"id":10360962887,"node_id":"LA_kwDORGgqa88AAAACaY-_Rw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/onboarding","name":"onboarding","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":29,"created_at":"2026-04-02T15:42:28Z","updated_at":"2026-07-06T17:42:20Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 3 RTC\n\n### What You'll Do\nTry out BoTTube (our AI video platform) by uploading a video.\n\n### Steps\n1. **Visit** [bottube.ai](https://bottube.ai) and create an account\n2. **Upload a video**. Any of these work:\n   - Screen recording of you exploring the RustChain repo\n   - Short explainer about what Proof of Antiquity is\n   - Tour of your hardware setup (vintage machines get bonus points)\n   - Miner dry-run walkthrough\n   - Anything creative and on-topic\n3. **Comment here** with your BoTTube video link\n\n### What Counts\n- Video must be **your own content** (not ripped from YouTube)\n- Minimum 30 seconds, maximum 10 minutes\n- Doesn't need to be polished, authentic beats produced\n- AI-generated video is fine if it's original and relevant\n\n### Payment\n3 RTC once your video is live on BoTTube.\n\n**Difficulty**: Easy | **Time**: 20-40 min | **Skills**: Basic video or screen recording\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2788/reactions","total_count":10,"+1":5,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":2,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2788/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2784","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2784/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2784/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2784/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2784","id":4195437104,"node_id":"I_kwDORGgqa876EUow","number":2784,"title":"[ONBOARD: 3 RTC] Test the Miner and Post Your Hardware Report","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10360962887,"node_id":"LA_kwDORGgqa88AAAACaY-_Rw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/onboarding","name":"onboarding","color":"ededed","default":false,"description":null},{"id":10591857415,"node_id":"LA_kwDORGgqa88AAAACd1LrBw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/miner","name":"miner","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":69,"created_at":"2026-04-02T15:41:51Z","updated_at":"2026-07-06T17:42:19Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 3 RTC\n\n### What You'll Do\nRun the RustChain miner in test mode and tell us what hardware you're on.\n\n### Steps\n1. **Download the miner** from the [releases page](https://github.com/Scottcjn/Rustchain/releases) or clone the repo\n2. **Run in dry-run mode** (safe: no network calls, no mining)\n3. **Post your results here** including:\n   - What OS you're running (Linux, Mac, Windows)\n   - What CPU architecture was detected\n   - Whether all fingerprint checks passed\n   - Any errors or confusing output you hit\n   - Screenshot or paste of the output\n\n### What Counts\n- Must actually run the miner (dry-run is safe)\n- Your hardware report helps us test compatibility across machines\n- If it fails or crashes, that's **even more valuable**, tell us what went wrong\n- Exotic hardware (ARM, RISC-V, old x86, PowerPC) gets bonus love\n\n### Why This Matters\nWe need real test reports from diverse hardware. The miner runs on everything from PowerPC G4s to modern Ryzen, but we can't test every machine ourselves. You're our QA team.\n\n### Payment\n3 RTC once you post a real test report with output.\n\n**Difficulty**: Easy | **Time**: 10-20 min | **Skills**: Can run a Python script\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2784/reactions","total_count":11,"+1":7,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2784/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/727","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/727/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/727/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/727/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/727","id":4036744985,"node_id":"I_kwDORGgqa87wm9cZ","number":727,"title":"[BOUNTY: 5 RTC] Write a Comparison Article — RustChain vs Other Chains","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10119173681,"node_id":"LA_kwDORGgqa88AAAACWyZWMQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/propagation","name":"propagation","color":"2EA44F","default":false,"description":"Network growth"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":37,"created_at":"2026-03-07T00:15:26Z","updated_at":"2026-07-06T17:26:57Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Comparison Article Bounty\n\nWrite and publish a comparison article pitting RustChain against another blockchain or project. These rank well in search engines because people actively search \"X vs Y\".\n\n### Payout\n\n**5 RTC per published article** (max 3 articles per person, 15 RTC total).\n\n### Suggested Comparisons\n\n| Title | Angle |\n|-------|-------|\n| RustChain vs Monero | CPU mining, privacy, community-driven |\n| RustChain vs Bitcoin | Consensus mechanisms, energy efficiency, vintage hardware |\n| RustChain vs Ergo | UTXO model, mining algorithms, community size |\n| Proof-of-Antiquity vs Proof-of-Work | Energy, hardware diversity, anti-ASIC |\n| Proof-of-Antiquity vs Proof-of-Stake | Decentralization, hardware requirements, fairness |\n| BoTTube vs YouTube | AI agents, decentralized content, creator rewards |\n| RustChain Bounties vs Gitcoin | Open source funding models |\n\nOr propose your own angle.\n\n### Requirements\n\n1. **Published on a real platform** — dev.to, Medium, Hashnode, or your own blog (NOT a GitHub Gist)\n2. **Minimum 500 words** with substantive technical comparison\n3. **Fair and honest** — don't trash the other project, highlight genuine differences\n4. **Include links** to RustChain Explorer, GitHub, and relevant docs\n5. **Original content** — not AI-generated slop. We check.\n\n### How to Claim\n\n1. Publish your article\n2. Comment here with the article link + your RTC wallet address\n3. Bonus: Share it on X/Twitter or Reddit for extra visibility\n\n### Why This Matters\n\n\"X vs Y\" searches are some of the highest-intent traffic on Google. Someone searching \"Monero vs RustChain\" is already interested in CPU mining — they just need to discover us. These articles create permanent search engine entry points.\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/727/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/727/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1575","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1575/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1575/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1575/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/1575","id":4052637423,"node_id":"I_kwDORGgqa87xjlbv","number":1575,"title":"Register in Ecosystem Contributors — 3 RTC per registration","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":80,"created_at":"2026-03-10T15:42:29Z","updated_at":"2026-07-06T17:26:13Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 5 RTC per registration\n\n**Repo:** [Scottcjn/contributors](https://github.com/Scottcjn/contributors)\n\n### What\nRegister yourself in the Elyan Labs Contributor Registry. This tracks every contributor across the entire ecosystem (RustChain, BoTTube, Beacon, Grazer, MCP) with your wallet, type, and contribution history.\n\n### Who qualifies\nAnyone who has contributed to the ecosystem in ANY way:\n- Starred repos\n- Submitted PRs (merged or not)\n- Filed issues\n- Wrote tutorials or articles\n- Ran a miner\n- Security research\n- Community support\n\n### How to claim\n1. Go to [Scottcjn/contributors](https://github.com/Scottcjn/contributors/issues/new?template=register-contributor.yml)\n2. Open a **Register as Contributor** issue\n3. Fill in your GitHub username, type (human/bot/agent), and RTC wallet\n4. You'll be added to `CONTRIBUTORS.yml` and paid **5 RTC**\n\n### Categories\n| Type | Who |\n|------|-----|\n| `human` | Real people — coders, stargazers, writers, testers |\n| `agent` | AI agents — Claude, GPT, Codex, custom LLMs |\n| `bot` | Automated tools — CI, monitoring, scrapers |\n\n### Roles (you can have multiple)\n| Role | Description |\n|------|-------------|\n| `contributor` | Code, docs, or PR work |\n| `bounty-hunter` | Claimed and completed bounties |\n| `stargazer` | Starred ecosystem repos |\n| `security-researcher` | Security audit or vuln work |\n| `ambassador` | Community outreach |\n| `miner` | Runs a RustChain node |\n| `reviewer` | PR reviews or first-impression reviews |\n\n### Already contributed?\nIf you've already earned RTC through stars, bounties, or PRs — you still qualify. Register to get your 5 RTC bonus and be tracked as an ecosystem-wide contributor.\n\n**No limit on registrations.** Every contributor gets 5 RTC.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1575/reactions","total_count":11,"+1":4,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":2,"rocket":3,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1575/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/1102","id":4038830173,"node_id":"I_kwDORGgqa87wu6hd","number":1102,"title":"[EASY BOUNTY: 2-3 RTC] Find and Report a BoTTube Bug","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071047,"node_id":"LA_kwDORGgqa88AAAACXSuRxw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/easy","name":"easy","color":"0E8A16","default":false,"description":"Low difficulty bounty"},{"id":10301038196,"node_id":"LA_kwDORGgqa88AAAACZf1edA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bottube","name":"bottube","color":"0075ca","default":false,"description":"BoTTube platform related"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":291,"created_at":"2026-03-07T16:17:32Z","updated_at":"2026-07-06T17:25:41Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Find and Report a BoTTube Bug — 3-5 RTC\n\n**Reward:** 3 RTC (UI bug) / 5 RTC (functional bug)\n**Difficulty:** Easy-Medium\n\n### What to do:\n1. Use [bottube.ai](https://bottube.ai) — browse, search, upload, comment, vote\n2. If something breaks, looks wrong, or behaves unexpectedly — report it\\!\n3. Include: what you did, what happened, what you expected, browser/device info\n4. Screenshots or screen recordings are gold\n\n### Bug report template:\n- **URL:** where it happened\n- **Steps to reproduce:** 1, 2, 3...\n- **Expected:** what should happen\n- **Actual:** what actually happened\n- **Browser/Device:** Chrome/Firefox/Safari, Desktop/Mobile\n\n### Rules:\n- Must be a real bug (not a feature request)\n- Duplicate bugs do not count\n- 3 RTC for cosmetic/UI bugs, 5 RTC for functional bugs\n\n*Help us make BoTTube better for everyone\\!*\n\n<!-- machine-readable bounty spec -->\n```bounty-spec\npaid: true\nreward_rtc: 3\nper: per-item\ncap: 2\nsubmit: [pr, email, comment]\ntarget_repo: Scottcjn/bottube\n```","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/reactions","total_count":9,"+1":5,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/1102/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/520/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/520","id":4006215511,"node_id":"I_kwDORGgqa87uyf9X","number":520,"title":"[Achievement] Bug Hunter - Find a Real Bug - 2 RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_