losmiceli/gists{/gist_id}","starred_url":"https://api.github.com/users/carlosmiceli/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/carlosmiceli/subscriptions","organizations_url":"https://api.github.com/users/carlosmiceli/orgs","repos_url":"https://api.github.com/users/carlosmiceli/repos","events_url":"https://api.github.com/users/carlosmiceli/events{/privacy}","received_events_url":"https://api.github.com/users/carlosmiceli/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"dmkt9","id":208698323,"node_id":"U_kgDODHB70w","avatar_url":"https://avatars.githubusercontent.com/u/208698323?v=4","gravatar_id":"","url":"https://api.github.com/users/dmkt9","html_url":"https://github.com/dmkt9","followers_url":"https://api.github.com/users/dmkt9/followers","following_url":"https://api.github.com/users/dmkt9/following{/other_user}","gists_url":"https://api.github.com/users/dmkt9/gists{/gist_id}","starred_url":"https://api.github.com/users/dmkt9/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dmkt9/subscriptions","organizations_url":"https://api.github.com/users/dmkt9/orgs","repos_url":"https://api.github.com/users/dmkt9/repos","events_url":"https://api.github.com/users/dmkt9/events{/privacy}","received_events_url":"https://api.github.com/users/dmkt9/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":72,"created_at":"2026-05-28T14:02:52Z","updated_at":"2026-07-07T02:53:16Z","closed_at":null,"assignee":{"login":"carlosmiceli","id":1166066,"node_id":"MDQ6VXNlcjExNjYwNjY=","avatar_url":"https://avatars.githubusercontent.com/u/1166066?v=4","gravatar_id":"","url":"https://api.github.com/users/carlosmiceli","html_url":"https://github.com/carlosmiceli","followers_url":"https://api.github.com/users/carlosmiceli/followers","following_url":"https://api.github.com/users/carlosmiceli/following{/other_user}","gists_url":"https://api.github.com/users/carlosmiceli/gists{/gist_id}","starred_url":"https://api.github.com/users/carlosmiceli/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/carlosmiceli/subscriptions","organizations_url":"https://api.github.com/users/carlosmiceli/orgs","repos_url":"https://api.github.com/users/carlosmiceli/repos","events_url":"https://api.github.com/users/carlosmiceli/events{/privacy}","received_events_url":"https://api.github.com/users/carlosmiceli/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Background\n\nWhen a report is submitted and the approver account no longer exists, the backend (`ReportAPI.php`) throws an `ExpError` with a descriptive message: _\"The approver account could not be found. A workspace admin must update the approver for this category or tag.\"_ (introduced in [Web-Expensify#51582](https://github.com/Expensify/Web-Expensify/pull/51582), commit [`005ac29`](https://github.com/Expensify/Web-Expensify/commit/005ac2986a67b4278a0f52e838b5c50116067228)).\n\nHowever, the NewDot frontend is **not passing this error message through to the user**. Instead, a generic _\"Unexpected error. Please try again later.\"_ message is displayed, giving the submitter no actionable information.\n\n## Steps to reproduce\n\n1. Have a workspace where an approver account has been deleted / no longer exists.\n2. As a member, open an expense report and click **Submit**.\n3. Observe the generic error toast — the specific approver error message from the backend is not shown.\n\n## Expected behaviour\n\nThe descriptive backend error message should be surfaced to the user (or a clear equivalent), e.g.:\n> _\"The approver account could not be found. A workspace admin must update the approver for this category or tag.\"_\n\n## Actual behaviour\n\nA generic _\"Unexpected error. Please try again later.\"_ is shown. The user has no idea why submission failed or how to fix it.\n\n## Context / references\n\n- Backend error location: [`ReportAPI.php#L3388-L3400`](https://github.com/Expensify/Web-Expensify/blob/151b35fd0fff2849bf7ff7c7c1100625853d87a3/lib/ReportAPI.php#L3388-L3400)\n- Backend change that introduced the new error: [Web-Expensify#51582](https://github.com/Expensify/Web-Expensify/pull/51582)\n- The error uses HTTP status code `666` which may be why the NewDot frontend doesn't recognise and display it correctly.\n\n## Platform\n\nWeb (NewDot)\n\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022060000152310746110\">https://www.upwork.com/jobs/~022060000152310746110</a></li>\n        <li>Upwork Job ID: 2060000152310746110</li>\n        <li>Last Price Increase: 2026-07-02</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @dmkt9</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/91973/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/91973/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/71","id":3904303864,"node_id":"I_kwDORGgqa87otvL4","number":71,"title":"[BOUNTY] Ongoing Bug Bounty Program — Find Bugs, Earn RTC (133 RTC Pool)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029408,"node_id":"LA_kwDORGgqa88AAAACWucZoA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bug","name":"bug","color":"d73a4a","default":true,"description":"Something isn't working"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":432,"created_at":"2026-02-06T01:13:53Z","updated_at":"2026-07-07T02:47:44Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Ongoing Bug Bounty Program\n\n**Pool: 750 RTC (ongoing, replenished as needed)**\n\n### Severity & Rewards\n| Severity | Description | Reward |\n|----------|-------------|--------|\n| **Critical** | Fund theft, consensus bypass, RCE | 100-200 RTC |\n| **High** | Data leak, auth bypass, significant logic error | 50-100 RTC |\n| **Medium** | DoS, info disclosure, moderate bugs | 15-50 RTC |\n| **Low** | UI bugs, minor leaks, doc errors | 5-15 RTC |\n\n### In-Scope\n- RustChain node software, attestation & fingerprint system\n- Epoch settlement & rewards, wallet endpoints\n- BoTTube web app, API, payment system\n- Python SDK, Block Explorer, Wallet GUI, Miner clients\n\n### Reporting\n1. Create GitHub issue with `[SECURITY]` prefix\n2. For critical: email first, issue after fix\n3. Include: steps to reproduce, impact, suggested fix\n\n### Rules\n- First reporter wins\n- Responsible disclosure required\n- Must not exploit on production\n\n---\n*Total RTC supply: 8.3M | RTC Reference Rate: 1 RTC = $0.10 USD*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/reactions","total_count":11,"+1":5,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":3,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/165","repository_url":"https://api.github.com/repos/Scottcjn/Rustchain","labels_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/165/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/165/comments","events_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/165/events","html_url":"https://github.com/Scottcjn/Rustchain/issues/165","id":3938981398,"node_id":"I_kwDOOdNtbc7qyBYW","number":165,"title":"[BOUNTY] Share Why You Starred RustChain — 3 RTC + Community Shoutout (Pool: 300 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8491289527,"node_id":"LA_kwDOOdNtbc8AAAAB-h7Ltw","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed"},{"id":8491289534,"node_id":"LA_kwDOOdNtbc8AAAAB-h7Lvg","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/good%20first%20issue","name":"good first issue","color":"7057FF","default":true,"description":"Good for newcomers (5-10 RTC)"},{"id":10159650136,"node_id":"LA_kwDOOdNtbc8AAAACXY_1WA","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC bounty reward"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":159,"created_at":"2026-02-13T20:12:59Z","updated_at":"2026-07-07T02:35:55Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Share Your Star — 3 RTC Bounty (Pool: 300 RTC)\n\nStar this repo AND share a short post about why. That's it. Real people sharing real opinions = organic growth.\n\n### How to Claim\n\n1. **Star this repo** (https://github.com/Scottcjn/Rustchain)\n2. **Post about it** on any platform — X/Twitter, Reddit, Mastodon, Dev.to, Hacker News, a blog, Moltbook, anywhere\n3. **Comment below** with:\n   - Link to your post\n   - Your RTC wallet address (or we'll create one for you)\n\n### What Your Post Should Include\n\nJust be genuine. Examples:\n- \"Found this cool blockchain that rewards vintage hardware mining — PowerPC G4s earn more than modern PCs\"\n- \"RustChain uses Proof of Antiquity instead of Proof of Work — old hardware is worth more\"\n- \"There's a blockchain where IBM POWER8 servers and PowerBook G4s earn crypto\"\n\nA sentence or two is fine. No essay needed.\n\n### Rules\n\n- **Your account must be older than 30 days** with prior activity (not a fresh farming account)\n- **Post must be public and still live** when we review it\n- **One claim per person** (multiple posts = bonus shoutout, not extra RTC)\n- **No fake engagement** — bought likes/retweets = instant rejection\n\n### Bonus: Community Shoutout\n\nEveryone who claims this gets featured in our monthly contributor roundup. Best posts get retweeted from [@RustchainPOA](https://x.com/RustchainPOA).\n\n### Payout\n\n3 RTC per valid claim. Pool of 300 RTC = 100 slots available.\n\nFirst come, first served — when the pool's gone, it's gone.\n\n\n---\n\n### ⚖️ Bounty Requirements (FTC 16 CFR §465.5 + §255.5 compliance)\n\n**A star alone does NOT qualify.** We pay for genuine engagement, not for indicators. To claim this bounty you must post a comment (on this issue or a linked post) containing:\n\n1. **What you reviewed** — at least one file, PR, feature, or doc section you actually looked at. Link it.\n2. **Why you liked it** — a specific, non-generic reason. \"Great project\" does not qualify.\n3. **Disclosure** — include the line: `I received RTC compensation for this review.` This keeps your star a transparent endorsement, not a purchased indicator.\n\nStars without a review comment will not be paid. Copy-pasted, AI-templated, or obviously recycled reviews will not be paid. This rule applies retroactively: unreviewed stars from before this update are grandfathered as goodwill but earn no future RTC.\n\n**Why this matters:** Elyan Labs is here to grow real engagement in mining and coding. A star backed by a real review is worth more to the network than a thousand drive-by clicks. This brings us into compliance with the FTC Consumer Review Rule (effective Oct 21, 2024), and — more importantly — keeps the signal honest.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/165/reactions","total_count":8,"+1":4,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/165/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/harnessclaw/harnessclaw/issues/66","repository_url":"https://api.github.com/repos/harnessclaw/harnessclaw","labels_url":"https://api.github.com/repos/harnessclaw/harnessclaw/issues/66/labels{/name}","comments_url":"https://api.github.com/repos/harnessclaw/harnessclaw/issues/66/comments","events_url":"https://api.github.com/repos/harnessclaw/harnessclaw/issues/66/events","html_url":"https://github.com/harnessclaw/harnessclaw/issues/66","id":4571841311,"node_id":"I_kwDOSAmqZ88AAAABEIDDHw","number":66,"title":"[Reward] HarnessClaw 体验测评（任一场景） #2","user":{"login":"FenjuFu","id":92919259,"node_id":"U_kgDOBYnV2w","avatar_url":"https://avatars.githubusercontent.com/u/92919259?v=4","gravatar_id":"","url":"https://api.github.com/users/FenjuFu","html_url":"https://github.com/FenjuFu","followers_url":"https://api.github.com/users/FenjuFu/followers","following_url":"https://api.github.com/users/FenjuFu/following{/other_user}","gists_url":"https://api.github.com/users/FenjuFu/gists{/gist_id}","starred_url":"https://api.github.com/users/FenjuFu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FenjuFu/subscriptions","organizations_url":"https://api.github.com/users/FenjuFu/orgs","repos_url":"https://api.github.com/users/FenjuFu/repos","events_url":"https://api.github.com/users/FenjuFu/events{/privacy}","received_events_url":"https://api.github.com/users/FenjuFu/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10673602650,"node_id":"LA_kwDOSAmqZ88AAAACfDJAWg","url":"https://api.github.com/repos/harnessclaw/harnessclaw/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":11013801440,"node_id":"LA_kwDOSAmqZ88AAAACkHlF4A","url":"https://api.github.com/repos/harnessclaw/harnessclaw/labels/reward","name":"reward","color":"FFD700","default":false,"description":"Issues with a bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":6,"created_at":"2026-06-02T13:29:24Z","updated_at":"2026-07-07T02:35:15Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Task description\n\n征集 HarnessClaw 的体验测评（第二期，编号备注 #2）—— 任一场景均可，例如：\n\n- 上手安装与首次配置流程是否顺畅\n- 在某个真实工作流（写代码 / 写文档 / 跑 agent / 调 MCP / 子 agent 调度 等）中的使用感受\n- 与其他同类工具（Claude Code / Cursor / VS Code Copilot 等）的横向对比\n- 发现的 bug、卡点或值得改进的体验细节\n- 长期使用一段时间后的总结，包括优点 / 痛点 / 期待功能\n\n**提交方式**：开一个 PR，把测评内容写成 markdown（建议放到 `docs/reviews/<你的GitHub用户名>.md`），在 PR 描述里写上 `Closes #<本 issue 号>`，合并后 `github-actions[bot]` 会自动在本 issue 下贴出 Reward Data 评论并 tag 你的合并提交以发放奖励。\n\n**内容要求**：\n\n- 字数不限，建议 300 字以上，有真实使用上下文\n- 可以中英文，可以加截图 / 录屏链接\n- 拒绝 AI 一键生成的空泛吹捧或纯负面情绪宣泄 —— 重点是「具体场景 + 你的真实感受 + 可复现的细节」\n- 同一作者可多次提交不同场景的测评，但同一 issue 仅奖励一次\n\n### 审核标准（Acceptance criteria）\n\n> 在 2026-05-23 收到一批由 bounty agent（codex/*, ari/* 等分支前缀）自动认领的同质化 PR 后增加。详见 #44–#49 的关闭说明。\n\n为了保证奖励真正发给「用过 HarnessClaw 的人」，PR 需要同时满足以下条件，否则不予接受：\n\n1. **真实使用证据**（必选其一）\n   - 在测评中贴出至少一次完整 chat / agent / skill / sub-agent 调度的截图或短视频；\n   - 或提供本地 session 记录的 session ID + 简短上下文摘录（路径见 `~/.harnessclaw/db/harnessclaw.db`）；\n   - 或提供安装某个 skill 后的实际产出片段（命令、文件、回复均可）。\n   - 仅跑 `yarn install` / `yarn build` / `yarn dev` 启动窗口 **不算「使用」**。\n2. **贡献形态**：不接受 `docs/reviews/<author>.md` 这种空文档型 PR。可选形式：\n   - 写到个人博客 / 飞书 / 公众号 / 知乎等平台，在 issue 评论里贴链接 + 摘要；\n   - 或直接把测评正文贴在本 issue 评论中；\n   - 或针对仓库做**有实质内容**的改动（文档勘误、bug 修复、功能改进等）并附上简短测评。\n3. **账号信誉**：不接受过去 30 天内在 ≥ 3 个无关 bounty repo（不同主题 / 不同组织 / 不同生态）都开过 PR 的账号。\n4. **AI 辅助透明披露**：若测评内容由 AI 辅助生成，须在 PR 描述顶部显式声明，并附上：\n   - 使用的 agent / 模型名（如 Codex Cloud / Claude / Cursor Background Agent 等）；\n   - 主要 prompt 或 prompt 模板；\n   - 作者本人在 AI 输出基础上做的人工修改或补充范围。\n\n不满足以上任一条者会被关闭并不发放奖励。\n\n---\n\n**奖励形式**：京东卡（人民币 100 元等值），由 @FenjuFu 在 PR 合并后通过 GitHub / 邮箱与作者联系发放。\n\n### Reward currency\n\nCNY RMB\n\n### Reward amount\n\n100\n\n### Reward payer\n\nFenjuFu","reactions":{"url":"https://api.github.com/repos/harnessclaw/harnessclaw/issues/66/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/harnessclaw/harnessclaw/issues/66/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/91437","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/91437/labels{/name}","comments_ur