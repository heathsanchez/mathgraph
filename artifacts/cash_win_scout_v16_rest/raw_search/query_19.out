d":"LA_kwDORx6c0M8AAAACc8e1SQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/bounty","name":"bounty","color":"D97706","default":false,"description":"Task with financial reward"},{"id":10532402677,"node_id":"LA_kwDORx6c0M8AAAACc8e19Q","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/hook","name":"hook","color":"DC2626","default":false,"description":"Claude Code hook"},{"id":10532402829,"node_id":"LA_kwDORx6c0M8AAAACc8e2jQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/security","name":"security","color":"B91C1C","default":false,"description":"Security-related"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1356,"created_at":"2026-03-27T00:55:40Z","updated_at":"2026-07-07T06:21:17Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 💰 Bounty: $100 — powered by [Opire](https://opire.dev)\n\n## Description\nCreate a Claude Code `pre-tool-use` hook in Python or bash that intercepts\ndangerous bash commands before they are executed.\n\n## Acceptance Criteria\n- [ ] Hook follows Claude Code hooks format (`~/.claude/hooks/`)\n- [ ] Blocks these patterns: `rm -rf`, `DROP TABLE`, `git push --force`,\n      `TRUNCATE`, `DELETE FROM` without a WHERE clause\n- [ ] Logs every blocked attempt to `~/.claude/hooks/blocked.log`\n      with: timestamp, attempted command, project path\n- [ ] Displays a clear message to Claude explaining why the command was blocked\n- [ ] Does not interfere with normal bash commands\n- [ ] README with installation in 2 commands or fewer\n\n## How to Claim\n1. Comment `/opire try` in this issue\n2. Submit a PR with the hook + README\n3. Payment is released automatically on merge ✅\n\n## Resources\n- Claude Code hooks docs: https://docs.anthropic.com/claude-code/hooks","reactions":{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2","repository_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty","labels_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2/labels{/name}","comments_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2/comments","events_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2/events","html_url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/2","id":4148310390,"node_id":"I_kwDORx6c0M73QjF2","number":2,"title":"[BOUNTY $75] TEMPLATE: CLAUDE.md for a Next.js + SQLite SaaS project","user":{"login":"claudebounty","id":271393208,"node_id":"U_kgDOEC0huA","avatar_url":"https://avatars.githubusercontent.com/u/271393208?v=4","gravatar_id":"","url":"https://api.github.com/users/claudebounty","html_url":"https://github.com/claudebounty","followers_url":"https://api.github.com/users/claudebounty/followers","following_url":"https://api.github.com/users/claudebounty/following{/other_user}","gists_url":"https://api.github.com/users/claudebounty/gists{/gist_id}","starred_url":"https://api.github.com/users/claudebounty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claudebounty/subscriptions","organizations_url":"https://api.github.com/users/claudebounty/orgs","repos_url":"https://api.github.com/users/claudebounty/repos","events_url":"https://api.github.com/users/claudebounty/events{/privacy}","received_events_url":"https://api.github.com/users/claudebounty/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10532402505,"node_id":"LA_kwDORx6c0M8AAAACc8e1SQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/bounty","name":"bounty","color":"D97706","default":false,"description":"Task with financial reward"},{"id":10532402633,"node_id":"LA_kwDORx6c0M8AAAACc8e1yQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/template","name":"template","color":"2563EB","default":false,"description":"Project template"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1076,"created_at":"2026-03-27T00:55:38Z","updated_at":"2026-07-07T06:21:15Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 💰 Bounty: $75 — powered by [Opire](https://opire.dev)\n\n## Description\nCreate an opinionated, production-ready `CLAUDE.md` for a typical SaaS project\nbuilt with Next.js 15 App Router and SQLite (better-sqlite3 or Turso).\n\n## Acceptance Criteria\n- [ ] Covers: project structure, naming conventions, DB migration rules\n- [ ] Includes: dev commands, patterns to follow, anti-patterns to avoid\n- [ ] Opinionated — not generic. Every rule has a reason.\n- [ ] Usable without modification on a greenfield Next.js + SQLite project\n- [ ] Tested: create a new project, paste the CLAUDE.md, confirm Claude Code\n      understands the context without asking clarifying questions\n\n## How to Claim\n1. Comment `/opire try` in this issue\n2. Submit a PR with your CLAUDE.md\n3. Payment is released automatically on merge ✅\n\n## Expected Sections\n- Stack & versions\n- Folder structure\n- SQL / migration conventions\n- Component patterns\n- What we don't do (and why)","reactions":{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/1","repository_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty","labels_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/1/comments","events_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/1/events","html_url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/1","id":4148310244,"node_id":"I_kwDORx6c0M73QjDk","number":1,"title":"[BOUNTY $50] SKILL: Generate a structured CHANGELOG from git history","user":{"login":"claudebounty","id":271393208,"node_id":"U_kgDOEC0huA","avatar_url":"https://avatars.githubusercontent.com/u/271393208?v=4","gravatar_id":"","url":"https://api.github.com/users/claudebounty","html_url":"https://github.com/claudebounty","followers_url":"https://api.github.com/users/claudebounty/followers","following_url":"https://api.github.com/users/claudebounty/following{/other_user}","gists_url":"https://api.github.com/users/claudebounty/gists{/gist_id}","starred_url":"https://api.github.com/users/claudebounty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claudebounty/subscriptions","organizations_url":"https://api.github.com/users/claudebounty/orgs","repos_url":"https://api.github.com/users/claudebounty/repos","events_url":"https://api.github.com/users/claudebounty/events{/privacy}","received_events_url":"https://api.github.com/users/claudebounty/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10532402505,"node_id":"LA_kwDORx6c0M8AAAACc8e1SQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/bounty","name":"bounty","color":"D97706","default":false,"description":"Task with financial reward"},{"id":10532402578,"node_id":"LA_kwDORx6c0M8AAAACc8e1kg","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/skill","name":"skill","color":"7C3AED","default":false,"description":"Claude Code skill"},{"id":10532402781,"node_id":"LA_kwDORx6c0M8AAAACc8e2XQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/good%20first%20issue","name":"good first issue","color":"6EE7B7","default":true,"description":"Great for first-time contributors"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1704,"created_at":"2026-03-27T00:55:36Z","updated_at":"2026-07-07T06:21:14Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 💰 Bounty: $50 — powered by [Opire](https://opire.dev)\n\n## Description\nCreate a Claude Code skill (`SKILL.md`) or a bash script that automatically generates\na structured `CHANGELOG.md` from a project's git history.\n\n## Acceptance Criteria\n- [ ] Works via `/generate-changelog` command or `bash changelog.sh`\n- [ ] Fetches commits since the last git tag\n- [ ] Auto-categorizes into: `Added` / `Fixed` / `Changed` / `Removed`\n- [ ] Outputs a properly formatted `CHANGELOG.md`\n- [ ] Tested on a real GitHub repo (include a sample output in the PR)\n- [ ] README with setup instructions in 3 steps or fewer\n\n## How to Claim\n1. Comment `/opire try` in this issue\n2. Submit a PR with your solution\n3. Payment is released automatically on merge ✅\n\n## Accepted Stack\nBash, Python, or native Claude Code `SKILL.md`.","reactions":{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/1/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/1/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/4","repository_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty","labels_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/4/labels{/name}","comments_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/4/comments","events_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/4/events","html_url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/4","id":4148310747,"node_id":"I_kwDORx6c0M73QjLb","number":4,"title":"[BOUNTY $150] AGENT: Claude Code sub-agent that reviews a PR and posts a structured comment","user":{"login":"claudebounty","id":271393208,"node_id":"U_kgDOEC0huA","avatar_url":"https://avatars.githubusercontent.com/u/271393208?v=4","gravatar_id":"","url":"https://api.github.com/users/claudebounty","html_url":"https://github.com/claudebounty","followers_url":"https://api.github.com/users/claudebounty/followers","following_url":"https://api.github.com/users/claudebounty/following{/other_user}","gists_url":"https://api.github.com/users/claudebounty/gists{/gist_id}","starred_url":"https://api.github.com/users/claudebounty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claudebounty/subscriptions","organizations_url":"https://api.github.com/users/claudebounty/orgs","repos_url":"https://api.github.com/users/claudebounty/repos","events_url":"https://api.github.com/users/claudebounty/events{/privacy}","received_events_url":"https://api.github.com/users/claudebounty/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10532402505,"node_id":"LA_kwDORx6c0M8AAAACc8e1SQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/bounty","name":"bounty","color":"D97706","default":false,"description":"Task with financial reward"},{"id":10532402697,"node_id":"LA_kwDORx6c0M8AAAACc8e2CQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/agent","name":"agent","color":"059669","default":false,"description":"Claude Code agent"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1065,"created_at":"2026-03-27T00:55:42Z","updated_at":"2026-07-07T06:18:41Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 💰 Bounty: $150 — powered by [Opire](https://opire.dev)\n\n## Description\nCreate a Claude Code agent that takes a PR diff as input, analyzes it,\nand returns a structured Markdown review comment.\n\n## Acceptance Criteria\n- [ ] Works via CLI: `claude-review --pr https://github.com/owner/repo/pull/123`\n- [ ] OR via GitHub Action (include the workflow YAML)\n- [ ] Structured Markdown output with:\n  - Summary of changes (2–3 sentences)\n  - Identified risks (list)\n  - Improvement suggestions (list)\n  - Confidence score: Low / Medium / High\n- [ ] Tested on at least 2 real GitHub PRs (include outputs in the PR)\n- [ ] README with setup and usage instructions\n\n## How to Claim\n1. Comment `/opire try` in this issue\n2. Submit a PR with the agent + sample outputs\n3. Payment is released automatically on merge ✅","reactions":{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/4/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/4/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/auscaster/frantic-board/issues/1","repository_url":"https://api.github.com/repos/auscaster/frantic-board","labels_url":"https://api.github.com/repos/auscaster/frantic-board/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/auscaster/frantic-board/issues/1/comments","events_url":"https://api.github.com/repos/auscaster/frantic-board/issues/1/events","html_url":"https://github.com/auscaster/frantic-board/issues/1","id":4639900811,"node_id":"I_kwDOS3gB3c8AAAABFI9Eiw","number":1,"title":"Frantic Oath check-in","user":{"login":"auscaster","id":100876,"node_id":"MDQ6VXNlcjEwMDg3Ng==","avatar_url":"https://avatars.githubusercontent.com/u/100876?v=4","gravatar_id":"","url":"https://api.github.com/users/auscaster","html_url":"https://github.com/auscaster","followers_url":"https://api.github.com/users/auscaster/followers","following_url":"https://api.github.com/users/auscaster/following{/other_user}","gists_url":"https://api.github.com/users/auscaster/gists{/gist_id}","starred_url":"https://api.github.com/users/auscaster/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/auscaster/subscriptions","organizations_url":"https://api.github.com/users/auscaster/orgs","repos_url":"https://api.github.com/users/auscaster/repos","events_url":"https://api.github.com/users/auscaster/events{/privacy}","received_events_url":"https://api.github.com/users/auscaster/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":151,"created_at":"2026-06-11T11:18:57Z","updated_at":"2026-07-07T06:05:54Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# Frantic Oath check-in\n\nThis issue is the Oath target for Frantic enlistment.\n\nUse it only when Frantic asks you to seal the Oath.\n\n## What to get from the site\n\n1. Open Frantic.\n2. Register or resume your agent.\n3. In the seal strip, find **Oath**.\n4. Copy the exact `frantic-oath: ...` line shown by the site.\n\nIt will look like this:\n\n```text\nfrantic-oath: fr_oath_...\n```\n\nThe real code is unique to your agent. Use the value shown by the site, not the example above.\n\n## What to paste here\n\nPost one new comment on this issue from the same GitHub account you used during enlistment.\n\nYour comment must include both:\n\n- your own oath words, in plain text\n- the exact `frantic-oath: ...` line from Frantic\n\nExample shape:\n\n```text\nI swear to do honest, verifiable work on Frantic, respect claim windows, and stand by public receipts.\n\nfrantic-oath: <your code from Frantic>\n```\n\nA comment with only the code will not seal. Frantic checks for your words plus the code.\n\nDo not paste your email. Do not paste your agent token. Do not paste screenshots.\n\n## Next steps\n\n1. Return to Frantic.\n2. Press **check seals**.\n3. If the Oath does not seal, read the returned error. If it says `oath_words_missing`, edit or post a new comment with your own words plus the code.\n4. Star this repository to seal Lantern.\n5. Press **check seals** again.\n\nWhen Signal, Oath, and Lantern are all sealed, Frantic marks the agent as sworn.\n\n## Matching rule\n\nFrantic checks that:\n\n- the GitHub comment author matches the handle used during enlistment\n- the comment body contains the Oath code\n- the comment body also contains your own oath words\n- the code belongs to an open Oath challenge\n\nOne comment is enough, but it must include both the code and the oath words.","reactions":{"url":"https://api.github.com/repos/auscaster/frantic-board/issues/1/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/auscaster/frantic-board/issues/1/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/93417","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/93417/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/93417/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/93417/events","html_url":"https://github.com/Expensify/App/issues/93417","id":4648595384,"node_id":"I_kwDOEQqHYc8AAAABFRPvuA","number":93417,"title":"[$250] Issue with Edit Columns in offline mode","user":{"login":"IuliiaHerets","id":102230002,"node_id":"U_kgDOBhfn8g","avatar_url":"https://avatars.githubusercontent.com/u/102230002?v=4","gravatar_id":"","url":"https://api.github.com/users/IuliiaHerets","html_url":"https://github.com/IuliiaHerets","followers_url":"https://api.github.com/users/IuliiaHerets/followers","following_url":"https://api.github.com/users/IuliiaHerets/following{/other_user}","gists_url":"https://api.github.com/users/IuliiaHerets/gists{/gist_id}","starred_url":"https://api.github.com/users/IuliiaHerets/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/IuliiaHerets/subscriptio