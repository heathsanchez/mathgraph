{/other_user}","gists_url":"https://api.github.com/users/stitesExpensify/gists{/gist_id}","starred_url":"https://api.github.com/users/stitesExpensify/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stitesExpensify/subscriptions","organizations_url":"https://api.github.com/users/stitesExpensify/orgs","repos_url":"https://api.github.com/users/stitesExpensify/repos","events_url":"https://api.github.com/users/stitesExpensify/events{/privacy}","received_events_url":"https://api.github.com/users/stitesExpensify/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"abdulrahuman5196","id":46707890,"node_id":"MDQ6VXNlcjQ2NzA3ODkw","avatar_url":"https://avatars.githubusercontent.com/u/46707890?v=4","gravatar_id":"","url":"https://api.github.com/users/abdulrahuman5196","html_url":"https://github.com/abdulrahuman5196","followers_url":"https://api.github.com/users/abdulrahuman5196/followers","following_url":"https://api.github.com/users/abdulrahuman5196/following{/other_user}","gists_url":"https://api.github.com/users/abdulrahuman5196/gists{/gist_id}","starred_url":"https://api.github.com/users/abdulrahuman5196/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abdulrahuman5196/subscriptions","organizations_url":"https://api.github.com/users/abdulrahuman5196/orgs","repos_url":"https://api.github.com/users/abdulrahuman5196/repos","events_url":"https://api.github.com/users/abdulrahuman5196/events{/privacy}","received_events_url":"https://api.github.com/users/abdulrahuman5196/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":23,"created_at":"2026-06-22T23:06:36Z","updated_at":"2026-07-06T21:48:25Z","closed_at":null,"assignee":{"login":"abdulrahuman5196","id":46707890,"node_id":"MDQ6VXNlcjQ2NzA3ODkw","avatar_url":"https://avatars.githubusercontent.com/u/46707890?v=4","gravatar_id":"","url":"https://api.github.com/users/abdulrahuman5196","html_url":"https://github.com/abdulrahuman5196","followers_url":"https://api.github.com/users/abdulrahuman5196/followers","following_url":"https://api.github.com/users/abdulrahuman5196/following{/other_user}","gists_url":"https://api.github.com/users/abdulrahuman5196/gists{/gist_id}","starred_url":"https://api.github.com/users/abdulrahuman5196/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abdulrahuman5196/subscriptions","organizations_url":"https://api.github.com/users/abdulrahuman5196/orgs","repos_url":"https://api.github.com/users/abdulrahuman5196/repos","events_url":"https://api.github.com/users/abdulrahuman5196/events{/privacy}","received_events_url":"https://api.github.com/users/abdulrahuman5196/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding. To join our Slack channel, fill out [this form](https://forms.gle/Q7hnhUJPnQCK7Fe56).\n___\n\n**Version Number:** \n**Reproducible in staging?:** Needs Reproduction (Reproduction blocked)\n**Reproducible in production?:** Needs Reproduction\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:**\n**Email or phone of affected tester (no customers):**\n**Logs:** https://stackoverflow.com/c/expensify/questions/4856\n**Expensify/Expensify Issue URL:**\n**Issue reported by:** @nicollyrodrigues-max\n**Slack conversation** (hyperlinked to channel name): [#Expensify Bugs](https://expensify.slack.com/archives/C049HHMV9SM/p1782154827287909)\n\n## Action Performed:\n\n1. Create or access a Group Workspace with the Travel feature enabled.\n2. Confirm that a Workspace Admin has this Group Workspace set as their default workspace.\n3. Sign in as the Workspace Admin.\n4. Navigate to Expensify Travel.\n5. Attempt to access Travel administration areas such as:\nProgram\nTravel Policy settings\nPeople management\nTravel analytics\n6. Verify the user's role within the Travel account.\n## Expected Result:\nAny user who is a Workspace Admin on a Travel-enabled Group Workspace should automatically be provisioned as a Travel Admin (Company Admin) and have access to Program settings, Travel Policies, People management, Trips, and Analytics.\n\n## Actual Result:\nWorkspace Admins are provisioned with the Employee role in Travel instead of the Company Admin role. As a result, they cannot access Travel Policy settings or other Travel administration features until their role is manually updated by a TMC Admin.\n\n## Additional Notes:\n\nAll Workspace Admins had the Travel-enabled Group Workspace configured as their default workspace.\nThe customer reported they had never been able to access Travel Policy settings since Travel was enabled.\nManually assigning the Company Admin role through Travel > Program > People > Groups and Roles immediately resolved the issue.\nPer the expected Travel behavior, Workspace Admins on a Travel-enabled workspace should automatically be provisioned as Travel Admins.\n\n## Workaround:\nUnknown\n## Platforms:\nSelect the officially supported platforms where the issue was reproduced:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [x] MacOS: Chrome / Safari\n\n## Screenshots/Videos\n\nThe screenshots for the issue are in Slack [thread](https://expensify.slack.com/archives/C049HHMV9SM/p1782154827287909)\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022069197533904254634\">https://www.upwork.com/jobs/~022069197533904254634</a></li>\n        <li>Upwork Job ID: 2069197533904254634</li>\n        <li>Last Price Increase: 2026-06-29</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @lakchote</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/94226/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/94226/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/92675","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/92675/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/92675/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/92675/events","html_url":"https://github.com/Expensify/App/issues/92675","id":4588859005,"node_id":"I_kwDOEQqHYc8AAAABEYRufQ","number":92675,"title":"[$250] Clicking Distance request link navigates to Create manual expense RHP","user":{"login":"applause-bot[bot]","id":265651874,"node_id":"BOT_kgDOD9WGog","avatar_url":"https://avatars.githubusercontent.com/in/3009811?v=4","gravatar_id":"","url":"https://api.github.com/users/applause-bot%5Bbot%5D","html_url":"https://github.com/apps/applause-bot","followers_url":"https://api.github.com/users/applause-bot%5Bbot%5D/followers","following_url":"https://api.github.com/users/applause-bot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/applause-bot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/applause-bot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/applause-bot%5B