starred_url":"https://api.github.com/users/cretadn22/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cretadn22/subscriptions","organizations_url":"https://api.github.com/users/cretadn22/orgs","repos_url":"https://api.github.com/users/cretadn22/repos","events_url":"https://api.github.com/users/cretadn22/events{/privacy}","received_events_url":"https://api.github.com/users/cretadn22/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding. To join our Slack channel, fill out [this form](https://forms.gle/Q7hnhUJPnQCK7Fe56).\n___\n\n**Version Number:** 9.4.15-3\n**Reproducible in staging?:** Needs reproduction (Unable to reproduce)\n**Reproducible in production?:** Needs reproduction\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:**\n**Email or phone of affected tester (no customers):**\n**Logs:** https://stackoverflow.com/c/expensify/questions/4856\n**Expensify/Expensify Issue URL:**\n**Issue reported by:** @scerrato88\n**Slack conversation** (hyperlinked to channel name): [#Expensify Bugs](https://expensify.slack.com/archives/C049HHMV9SM/p1781894562414879)\n\n## Action Performed:\n\n1. Navigate to Workspace > Company Cards.\n2. Click Add Card.\n3. Select a bank/card feed option.\n4. Click Import transactions from file.\n5. Upload a CSV file containing card transactions.\n6. Map all required columns correctly. (The CSV columns were mapped correctly during the import flow.)\n7. Complete the import process.\n\n## Expected Result:\nThe CSV should be imported successfully, or the system should provide a specific validation message identifying any issues with the file or mapped fields.\n\n## Actual Result:\nThe import fails and displays the generic error:\n\"Please ensure all fields are filled out correctly and try again. If the problem persists, please reach out to Concierge.\"\n\nNo additional information is provided about which field, row, or column is causing the failure.\n\n## Workaround:\nUnknown\n\n## Platforms:\nSelect the officially supported platforms where the issue was reproduced:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [x] MacOS: Chrome / Safari\n\n## Screenshots/Videos\n\nThe screenshot for the issue is in Slack [thread](https://expensify.slack.com/archives/C049HHMV9SM/p1781894562414879)\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022069053620673593010\">https://www.upwork.com/jobs/~022069053620673593010</a></li>\n        <li>Upwork Job ID: 2069053620673593010</li>\n        <li>Last Price Increase: 2026-07-06</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/94178/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/94178/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/94021","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/94021/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/94021/comments","events_url":"