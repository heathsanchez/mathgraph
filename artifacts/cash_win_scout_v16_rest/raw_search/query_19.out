r: @mallenexpensify</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/92412/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/92412/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/94142","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/94142/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/94142/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/94142/events","html_url":"https://github.com/Expensify/App/issues/94142","id":4714337085,"node_id":"I_kwDOEQqHYc8AAAABGP8TPQ","number":94142,"title":"[$250] QBO - Can't connect on Android app","user":{"login":"applause-bot[bot]","id":265651874,"node_id":"BOT_kgDOD9WGog","avatar_url":"https://avatars.githubusercontent.com/in/3009811?v=4","gravatar_id":"","url":"https://api.github.com/users/applause-bot%5Bbot%5D","html_url":"https://github.com/apps/applause-bot","followers_url":"https://api.github.com/users/applause-bot%5Bbot%5D/followers","following_url":"https://api.github.com/users/applause-bot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/applause-bot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/applause-bot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/applause-bot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/applause-bot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/applause-bot%5Bbot%5D/repos","events_url":"https://api.github.com/users/applause-bot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/applause-bot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","sit