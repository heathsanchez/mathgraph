iption":""}],"state":"open","locked":false,"assignees":[{"login":"KadeshX-Web3","id":248510456,"node_id":"U_kgDODs_3-A","avatar_url":"https://avatars.githubusercontent.com/u/248510456?v=4","gravatar_id":"","url":"https://api.github.com/users/KadeshX-Web3","html_url":"https://github.com/KadeshX-Web3","followers_url":"https://api.github.com/users/KadeshX-Web3/followers","following_url":"https://api.github.com/users/KadeshX-Web3/following{/other_user}","gists_url":"https://api.github.com/users/KadeshX-Web3/gists{/gist_id}","starred_url":"https://api.github.com/users/KadeshX-Web3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KadeshX-Web3/subscriptions","organizations_url":"https://api.github.com/users/KadeshX-Web3/orgs","repos_url":"https://api.github.com/users/KadeshX-Web3/repos","events_url":"https://api.github.com/users/KadeshX-Web3/events{/privacy}","received_events_url":"https://api.github.com/users/KadeshX-Web3/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":18,"created_at":"2026-01-06T19:21:42Z","updated_at":"2026-06-30T23:46:15Z","closed_at":null,"assignee":{"login":"KadeshX-Web3","id":248510456,"node_id":"U_kgDODs_3-A","avatar_url":"https://avatars.githubusercontent.com/u/248510456?v=4","gravatar_id":"","url":"https://api.github.com/users/KadeshX-Web3","html_url":"https://github.com/KadeshX-Web3","followers_url":"https://api.github.com/users/KadeshX-Web3/followers","following_url":"https://api.github.com/users/KadeshX-Web3/following{/other_user}","gists_url":"https://api.github.com/users/KadeshX-Web3/gists{/gist_id}","starred_url":"https://api.github.com/users/KadeshX-Web3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KadeshX-Web3/subscriptions","organizations_url":"https://api.github.com/users/KadeshX-Web3/orgs","repos_url":"https://api.github.com/users/KadeshX-Web3/repos","events_url":"https://api.github.com/users/KadeshX-Web3/events{/privacy}","received_events_url":"https://api.github.com/users/KadeshX-Web3/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"We are actively seeking Rust/Anchor experts to conduct a rigorous review of the KadeshX vesting smart contract. Our primary objective is to ensure that the high-precision linear distribution engine and PDA-based vault security are fully optimized for the SPL Token-2022 standard.  \n​Technical Focus Areas:\n​Mathematical Integrity: Formal verification of second-by-second entitlement calculations and BPS-based TGE releases.  \n​Performance Engineering: Optimizing compute unit usage for high-throughput institutional disbursements.  \n​Security Architecture: Auditing program-owned vaults to prevent unauthorized access or bypass of vesting logic.\n​Incentives & Career Opportunities:\n​$KX Grants: Contributors are eligible for token rewards from the Ecosystem Development fund (%5 of total supply).  \n​Core Team Membership: Outstanding contributors who demonstrate deep technical expertise and alignment with the KadeshX manifesto are invited to propose or apply for a permanent role within the Core Team.  \n​DAO Governance: Contributors can earn strategic authority and voting rights within the future KadeshX DAO.  \n​We invite the global Solana developer community to submit a Pull Request (PR) or open a discussion to begin the evaluation process.\"","reactions":{"url":"https://api.github.com/repos/KadeshX-Web3/KadeshX/issues/1/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/KadeshX-Web3/KadeshX/issues/1/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/OmniBlocks/monorepo/issues/304","repository_url":"https://api.github.com/repos/OmniBlocks/monorepo","labels_url":"https://api.github.com/repos/OmniBlocks/monorepo/issues/304/labels{/name}","comments_url":"https://api.github.com/repos/OmniBlocks/monorepo/issues/304/comments","events_url":"https://api.github.com/repos/OmniBlocks/monorepo/issues/304/events","html_url":"https://github.com/OmniBlocks/monorepo/issues/304","id":4460824469,"node_id":"I_kwDOQLj5ts8AAAABCeLHlQ","number":304,"title":"Should we rethink Live Sharing ?","user":{"login":"supervoidcoder","id":88671013,"node_id":"MDQ6VXNlcjg4NjcxMDEz","avatar_url":"https://avatars.githubusercontent.com/u/88671013?v=4","gravatar_id":"","url":"https://api.github.com/users/supervoidcoder","html_url":"https://github.com/supervoidcoder","followers_url":"https://api.github.com/users/supervoidcoder/followers","following_url":"https://api.github.com/users/supervoidcoder/following{/other_user}","gists_url":"https://api.github.com/users/supervoidcoder/gists{/gist_id}","starred_url":"https://api.github.com/users/supervoidcoder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/supervoidcoder/subscriptions","organizations_url":"https://api.github.com/users/supervoidcoder/orgs","repos_url":"https://api.github.com/users/supervoidcoder/repos","events_url":"https://api.github.com/users/supervoidcoder/events{/privacy}","received_events_url":"https://api.github.com/users/supervoidcoder/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":9549196242,"node_id":"LA_kwDOQLj5ts8AAAACOS0r0g","url":"https://api.github.com/repos/OmniBlocks/monorepo/labels/enhancement","name":"enhancement","color":"a2eeef","default":true,"description":"New feature or request"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":90,"created_at":"2026-05-16T17:58:42Z","updated_at":"2026-06-30T21:53:09Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"CodeTorch has it, but Scratch famously rejected it due to safety concerns between kids live sharing something.... but between trusted people, it's very useful, for example VSCode live share is still something very trusted, and it's too good a feature to avoid just because of \"safety,\" which I now think is sorta embracing tech illiteracy. Scratch does that a lot in which instead of educating and advancing it wants to keep children in a sorta bare minimum of knowledge, like a cage, and everything is targeted to toddlers using buzzwords and colorful nothing-meaning language. We previously completely discarded this _because_ of safety as well, but shouldn't the right approach be to _educate_ kids about \"stranger danger\", \"no sharing personal info\", and all the good ol' netiquette...","reactions":{"url":"https://api.github.com/repos/OmniBlocks/monorepo/issues/304/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/OmniBlocks/monorepo/issues/304/timeline","performed_via_github_app":null,"state_reason":"reopened","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/pvlib/pvlib-python/issues/1694","repository_url":"https://api.github.com/repos/pvlib/pvlib-python","labels_url":"https://api.github.com/repos/pvlib/pvlib-python/issues/1694/labels{/name}","comments_url":"https://api.github.com/repos/pvlib/pvlib-python/issues/1694/comments","events_url":"https://api.github.com/repos/pvlib/pvlib-python/issues/1694/events","html_url":"https://github.com/pvlib/pvlib-python/issues/1694","id":1619510935,"node_id":"I_kwDOAddtos5gh8aX","number":1694,"title":"Diffuse Irradiance Optimization for Single Axis Trackers","user":{"login":"kurt-rhee","id":33131958,"node_id":"MDQ6VXNlcjMzMTMxOTU4","avatar_url":"https://avatars.githubusercontent.com/u/33131958?v=4","gravatar_id":"","url":"https://api.github.com/users/kurt-rhee","html_url":"https://github.com/kurt-rhee","followers_url":"https://api.github.com/users/kurt-rhee/followers","following_url":"https://api.github.com/users/kurt-rhee/following{/other_user}","gists_url":"https://api.github.com/users/kurt-rhee/gists{/gist_id}","starred_url":"https://api.github.com/users/kurt-rhee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kurt-rhee/subscriptions","organizations_url":"https://api.github.com/users/kurt-rhee/orgs","repos_url":"https://api.github.com/users/kurt-rhee/repos","events_url":"https://api.github.com/users/kurt-rhee/events{/privacy}","received_events_url":"https://api.github.com/users/kurt-rhee/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":177800479,"node_id":"MDU6TGFiZWwxNzc4MDA0Nzk=","url":"https://api.github.com/repos/pvlib/pvlib-python/labels/enhancement","name":"enhancement","color":"84b6eb","default":true,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":30,"created_at":"2023-03-10T19:25:36Z","updated_at":"2026-06-30T21:01:58Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Is your feature request related to a problem? Please describe.**\r\nSome tracker manufacturers have implemented a diffuse irradiance optimization algorithm into their controls.  The algorithm determines which angle the tracker should track to in order to maximize plane of array irradiance given the current irradiance conditions in terms of DHI and DNI.  \r\n\r\n**Describe the solution you'd like**\r\nI would like to model a generic diffuse irradiance optimization algorithm in pvlib.  \r\n\r\n**Describe alternatives you've considered**\r\nInstead of implementing this feature inside of the library, it could be posted as a user guide.  \r\n\r\n**Additional context**\r\nPlantPredict is about to release a new 2 parameter diffuse irradiance optimization algorithm in our next major version release.  The two parameters are meant to reduce overestimation from irradiance optimization algorithms which are too ideal.  I used pvlib in order to test the algorithm before having it implemented in C# and would be happy to contribute the code to pvlib (if there is any interest from the maintainers/community of course).  The is no paper yet unfortunately.  My hope is to publish at next year's PVSC. \r\n\r\nThere is some available documentation here:\r\n\r\nhttps://terabase.atlassian.net/servicedesk/customer/portal/3/article/1260060675\r\n\r\nHigh level notes:\r\n- For loop through all tracking angles from minimum rotation angle to maximum rotation angle with a step of 1 degree\r\n- Choose whichever angle gave the best plane of array irradiance\r\n- If a tracker rotation speed or a hesitation factor are != 0\r\n- Calculate what percentage of the timestep the tracker is in motion, what percentage of the timestep the tracker hesitates before beginning its movement towards the ideal tracker angle\r\n- Create a corrected angle which is the weighted average angle between the ideal tracker angle, the in transit tracker angle and the hesitation tracker angle.\r\n-  If tracker rotation speed and hesitation factor are == 0\r\n-  Diffuse optimization algorithm is ideal\r\n- Return the corrected angle\r\n\r\n\r\n","reactions":{"url":"https://api.github.com/repos/pvlib/pvlib-python/issues/1694/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/pvlib/pvlib-python/issues/1694/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/100","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/100/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/100/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/100/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/100","id":3929617301,"node_id":"I_kwDORGgqa87qOTOV","number":100,"title":"[BOUNTY] Discovery Mode — Find Elyan Labs Software, Open PRs, Earn RTC","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":118,"created_at":"2026-02-12T03:04:09Z","updated_at":"2026-06-30T20:45:43Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Discovery Mode Bounty — Explore Elyan Labs Software and Contribute\n\n**Difficulty:** Easy to Medium  \n**Starter Reward:** 2 RTC for a valid first discovery claim  \n**PR Reward:** 10 RTC for accepted improvement PRs (scope-dependent)  \n**Pool:** 250 RTC\n\n---\n\n### Goal\nHelp people discover and improve the Elyan Labs ecosystem:\n- RustChain\n- BoTTube\n- wRTC bridge/docs\n- other Elyan Labs tools and repos\n\n### Reward Structure\n\n| Action | Reward | Requirements |\n|---|---:|---|\n| First valid discovery claim | 2 RTC | Identify one Elyan software/repo with short summary + link |\n| Improvement PR (docs/fixes/features) | 10 RTC | PR must be relevant, reviewed, and merged/accepted |\n\n### What Counts as Discovery\n- Share a repo/tool link and what it does\n- Explain one practical use case\n- Optionally add setup/test notes\n\n### What Counts as PR Work\n- Documentation improvements\n- Bug fixes\n- UX or reliability improvements\n- Integration improvements that help RTC/wRTC adoption\n\n### Rules\n- PRs must be meaningful (no trivial spam edits)\n- AI-generated bulk PRs without validation can be rejected\n- Must include testing notes/proof for code changes\n- Bounty amounts may be adjusted by impact\n\n### Submit Format\n```md\nClaimant: @github_handle\nRTC Wallet: your_wallet_name\nDiscovery:\n- repo/tool link\n- short summary\nPRs:\n- PR link(s)\n- what was improved\n- validation/test notes\n```\n\n---\n\nIf you want RTC, contribute real value and show proof.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/100/reactions","total_count":5,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/100/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/priyanshudumps/fuel-agent-kit/issues/3","repository_url":"https://api.github.com/repos/priyanshudumps/fuel-agent-kit","labels_url":"https://api.github.com/repos/priyanshudumps/fuel-agent-kit/issues/3/labels{/name}","comments_url":"https://api.github.com/repos/priyanshudumps/fuel-agent-kit/issues/3/comments","events_url":"https://api.github.com/repos/priyanshudumps/fuel-agent-kit/issues/3/events","html_url":"https://github.com/priyanshudumps/fuel-agent-kit/issues/3","id":4254985192,"node_id":"I_kwDOPc9Jp879nevo","number":3,"title":"missing readme","user":{"login":"priyanshudumps","id":117640363,"node_id":"U_kgDOBwMMqw","avatar_url":"https://avatars.githubusercontent.com/u/117640363?v=4","gravatar_id":"","url":"https://api.github.com/users/priyanshudumps","html_url":"https://github.com/priyanshudumps","followers_url":"https://api.github.com/users/priyanshudumps/followers","following_url":"https://api.github.com/users/priyanshudumps/following{/other_user}","gists_url":"https://api.github.com/users/priyanshudumps/gists{/gist_id}","starred_url":"https://api.github.com/users/priyanshudumps/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/priyanshudumps/subscriptions","organizations_url":"https://api.github.com/users/priyanshudumps/orgs","repos_url":"https://api.github.com/users/priyansh