tneyOfstad/subscriptions","organizations_url":"https://api.github.com/users/CortneyOfstad/orgs","repos_url":"https://api.github.com/users/CortneyOfstad/repos","events_url":"https://api.github.com/users/CortneyOfstad/events{/privacy}","received_events_url":"https://api.github.com/users/CortneyOfstad/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"abbasifaizan70","id":58352279,"node_id":"MDQ6VXNlcjU4MzUyMjc5","avatar_url":"https://avatars.githubusercontent.com/u/58352279?v=4","gravatar_id":"","url":"https://api.github.com/users/abbasifaizan70","html_url":"https://github.com/abbasifaizan70","followers_url":"https://api.github.com/users/abbasifaizan70/followers","following_url":"https://api.github.com/users/abbasifaizan70/following{/other_user}","gists_url":"https://api.github.com/users/abbasifaizan70/gists{/gist_id}","starred_url":"https://api.github.com/users/abbasifaizan70/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abbasifaizan70/subscriptions","organizations_url":"https://api.github.com/users/abbasifaizan70/orgs","repos_url":"https://api.github.com/users/abbasifaizan70/repos","events_url":"https://api.github.com/users/abbasifaizan70/events{/privacy}","received_events_url":"https://api.github.com/users/abbasifaizan70/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"aimane-chnaif","id":96077027,"node_id":"U_kgDOBboE4w","avatar_url":"https://avatars.githubusercontent.com/u/96077027?v=4","gravatar_id":"","url":"https://api.github.com/users/aimane-chnaif","html_url":"https://github.com/aimane-chnaif","followers_url":"https://api.github.com/users/aimane-chnaif/followers","following_url":"https://api.github.com/users/aimane-chnaif/following{/other_user}","gists_url":"https://api.github.com/users/aimane-chnaif/gists{/gist_id}","starred_url":"https://api.github.com/users/aimane-chnaif/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aimane-chnaif/subscriptions","organizations_url":"https://api.github.com/users/aimane-chnaif/orgs","repos_url":"https://api.github.com/users/aimane-chnaif/repos","events_url":"https://api.github.com/users/aimane-chnaif/events{/privacy}","received_events_url":"https://api.github.com/users/aimane-chnaif/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":45,"created_at":"2026-02-23T13:01:45Z","updated_at":"2026-07-01T22:00:40Z","closed_at":null,"assignee":{"login":"chuckdries","id":1351436,"node_id":"MDQ6VXNlcjEzNTE0MzY=","avatar_url":"https://avatars.githubusercontent.com/u/1351436?v=4","gravatar_id":"","url":"https://api.github.com/users/chuckdries","html_url":"https://github.com/chuckdries","followers_url":"https://api.github.com/users/chuckdries/followers","following_url":"https://api.github.com/users/chuckdries/following{/other_user}","gists_url":"https://api.github.com/users/chuckdries/gists{/gist_id}","starred_url":"https://api.github.com/users/chuckdries/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chuckdries/subscriptions","organizations_url":"https://api.github.com/users/chuckdries/orgs","repos_url":"https://api.github.com/users/chuckdries/repos","events_url":"https://api.github.com/users/chuckdries/events{/privacy}","received_events_url":"https://api.github.com/users/chuckdries/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Description\n\nTyping into the Inbox search (SearchRouter) freezes the JS thread on mobile. The native back gesture and native scrolling still work, but all JS-driven interactions (navigation buttons, virtualization recalculation) become unresponsive.\n\n## Steps to Reproduce\n\n1. Open the app on a mobile device (iOS or Android)\n2. Tap the search icon in the Inbox\n3. Start typing a search query\n4. Observe that the UI becomes unresponsive\n\n## Expected Behavior\n\nSearch input should remain responsive while filtering results, with no perceptible lag or JS thread blocking.\n\n## Actual Behavior\n\nThe JS thread freezes. Navigation buttons stop working, virtualization bounds don't recalculate. Only native gestures (back swipe, scroll) continue to work.\n\n## Root Cause\n\n`autocompleteQueryValue` in `SearchRouter.tsx` updates immediately on every keystroke (only `textInputValue` is debounced). This triggers synchronous re-computation of:\n\n- `getSearchOptions()` -- filters all reports/personal details\n- `isSearchStringMatch()` -- creates RegExp per word per item\n- `combineOrderingOfReportsAndPersonalDetails()` -- sorts results\n- Multiple `.filter()` chains on tags, categories, currencies, participants\n\n## Suggested Fixes\n\n1. Debounce `autocompleteQueryValue` (or the prop passed to `SearchAutocompleteList`) so filtering doesn't run on every keystroke\n2. Memoize `searchOptions` and `recentReportsOptions` with stable dependencies\n3. Optimize `isSearchStringMatch` -- reuse compiled RegExp objects instead of creating new ones per iteration\n4. Consider moving heavy filtering off the JS thread (InteractionManager, web worker, or native module)\n\n## Platform\n\n- [x] iOS\n- [x] Android\n- [ ] Web (likely affected but less severe)\n\n## Reporter\n\nChuck ([Slack thread](https://expensify.slack.com/archives/C05LX9D6E07/p1771606797669149))\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @abbasifaizan70</details>\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: https://www.upwork.com/jobs/~022025920563596911295</li>\n        <li>Upwork Job ID: 2025920563596911295</li>\n        <li>Last Price Increase: 2026-03-02</li>\n<li>Automatic offers: </li>\n<ul>\n<li>aimane-chnaif | Reviewer | 110717229</li>\n</ul></li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/83207/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/83207/timeline","performed_via_github_app":null,"state_reason":"reopened","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/2150","repository_url":"https://api.github.com/repos/Scottcjn/Rustchain","labels_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/2150/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/2150/comments","events_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/2150/events","html_url":"https://github.com/Scottcjn/Rustchain/issues/2150","id":4212996864,"node_id":"I_kwDOOdNtbc77HTsA","number":2150,"title":"Bounty: \"Mine Your Grandma's Computer\" — vintage miner setup guide","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8491289506,"node_id":"LA_kwDOOdNtbc8AAAAB-h7Log","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/documentation","name":"documentation","color":"0075ca","default":true,"description":"Improvements or additions to documentation"},{"id":8491289534,"node_id":"LA_kwDOOdNtbc8AAAAB-h7Lvg","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/good%20first%20issue","name":"good first issue","color":"7057FF","default":true,"description":"Good for newcomers (5-10 RTC)"},{"id":10159650136,"node_id":"LA_kwDOOdNtbc8AAAACXY_1WA","url":"https://api.github.com/repos/Scottcjn/Rustchain/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC bounty reward"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":28,"created_at":"2026-04-06T17:14:04Z","updated_at":"2026-07-01T21:47:14Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 🏆 Bounty: 50 RTC\n\nThat old computer in your closet could be earning RTC right now. Write the guide that gets someone from \"I found an old computer\" to \"it's earning RTC\" in under 15 minutes.\n\n**Target at least 2 of:**\n- Old Windows laptop (Core 2 Duo era)\n- PowerPC Mac (G3/G4/G5)\n- Old Linux desktop (Pentium 4, Athlon 64)\n- Raspberry Pi\n\n**Requirements:**\n- Step-by-step with screenshots or photos of real hardware\n- \"Does my computer qualify?\" quick check\n- Show fingerprint check passing on vintage hardware\n- Show first attestation succeeding\n- Explain antiquity multiplier in plain English\n\n**Bonus (+25 RTC):** 2-minute video walkthrough of the whole process.\n\nThis is about onboarding real people with real old hardware. Make it accessible.","reactions":{"url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/2150/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/Rustchain/issues/2150/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/greyw0rks/bountyscout/issues/129","repository_url":"https://api.github.com/repos/greyw0rks/bountyscout","labels_url":"https://api.github.com/repos/greyw0rks/bountyscout/issues/129/labels{/name}","comments_url":"https://api.github.com/repos/greyw0rks/bountyscout/issues/129/comments","events_url":"https://api.github.com/repos/greyw0rks/bountyscout/issues/129/events","html_url":"https://github.com/greyw0rks/bountyscout/issues/129","id":4789337618,"node_id":"I_kwDOS9MLzs8AAAABHXd-Eg","number":129,"title":"🎯 Bounty Alert: 13 New Opportunities — 2026-07-01 21:29 UTC","user":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[{"id":11259492070,"node_id":"LA_kwDOS9MLzs8AAAACnx42