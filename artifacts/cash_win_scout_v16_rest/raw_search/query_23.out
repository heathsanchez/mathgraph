thub.com/users/mkhutornyi/followers","following_url":"https://api.github.com/users/mkhutornyi/following{/other_user}","gists_url":"https://api.github.com/users/mkhutornyi/gists{/gist_id}","starred_url":"https://api.github.com/users/mkhutornyi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mkhutornyi/subscriptions","organizations_url":"https://api.github.com/users/mkhutornyi/orgs","repos_url":"https://api.github.com/users/mkhutornyi/repos","events_url":"https://api.github.com/users/mkhutornyi/events{/privacy}","received_events_url":"https://api.github.com/users/mkhutornyi/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":158,"created_at":"2025-05-05T21:19:20Z","updated_at":"2026-07-06T21:49:14Z","closed_at":null,"assignee":{"login":"francoisl","id":2229301,"node_id":"MDQ6VXNlcjIyMjkzMDE=","avatar_url":"https://avatars.githubusercontent.com/u/2229301?v=4","gravatar_id":"","url":"https://api.github.com/users/francoisl","html_url":"https://github.com/francoisl","followers_url":"https://api.github.com/users/francoisl/followers","following_url":"https://api.github.com/users/francoisl/following{/other_user}","gists_url":"https://api.github.com/users/francoisl/gists{/gist_id}","starred_url":"https://api.github.com/users/francoisl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/francoisl/subscriptions","organizations_url":"https://api.github.com/users/francoisl/orgs","repos_url":"https://api.github.com/users/francoisl/repos","events_url":"https://api.github.com/users/francoisl/events{/privacy}","received_events_url":"https://api.github.com/users/francoisl/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** 9.1.39-6\n**Reproducible in staging?:** Y\n**Reproducible in production?:** Y\n**If this was caught during regression testing, add the test name, ID and link from TestRail:**\n**Email or phone of affected tester (no customers):**\n**Logs:** https://stackoverflow.com/c/expensify/questions/4856\n**Expensify/Expensify Issue URL:**\n**Issue reported by:** @shawnborton \n**Slack conversation** (hyperlinked to channel name): [#Expensify Bugs](https://expensify.slack.com/archives/C049HHMV9SM/p1746476858200089)\n\n## Action Performed:\n1. Navigate to Reports\n2. Click Advanced filters > Categories\n3. Scroll the page and select any category\n4. Observe\n## Expected Result:\nSelecting an item should not trigger any automatic scrolling or reordering.\nThe user’s scroll position should remain unchanged.\nItems should stay in place visually to allow smooth, uninterrupted multi-selection.\n## Actual Result:\nThe selected item moves to the top of the list.\nThe view scrolls up, disorienting the user and forcing them to manually scroll back to where they were.\n## Workaround:\nUnknown\n## Platforms:\nSelect the officially supported platforms where the issue was reproduced:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [x] MacOS: Chrome / Safari\n- [ ] MacOS: Desktop\n\n<details>\n  <summary>Platforms Tested:</summary>\nOn which of our officially supported platforms was this issue tested:\n\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [x] MacOS: Chrome / Safari\n- [ ] MacOS: Desktop\n\n</details>\n\n## Scree