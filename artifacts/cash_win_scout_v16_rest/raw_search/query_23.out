e_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/daytonaio/content/issues/13","repository_url":"https://api.github.com/repos/daytonaio/content","labels_url":"https://api.github.com/repos/daytonaio/content/issues/13/labels{/name}","comments_url":"https://api.github.com/repos/daytonaio/content/issues/13/comments","events_url":"https://api.github.com/repos/daytonaio/content/issues/13/events","html_url":"https://github.com/daytonaio/content/issues/13","id":2473588629,"node_id":"I_kwDOJ5_ntc6Tb_eV","number":13,"title":"AI Transcription Tool","user":{"login":"nibzard","id":6250945,"node_id":"MDQ6VXNlcjYyNTA5NDU=","avatar_url":"https://avatars.githubusercontent.com/u/6250945?v=4","gravatar_id":"","url":"https://api.github.com/users/nibzard","html_url":"https://github.com/nibzard","followers_url":"https://api.github.com/users/nibzard/followers","following_url":"https://api.github.com/users/nibzard/following{/other_user}","gists_url":"https://api.github.com/users/nibzard/gists{/gist_id}","starred_url":"https://api.github.com/users/nibzard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nibzard/subscriptions","organizations_url":"https://api.github.com/users/nibzard/orgs","repos_url":"https://api.github.com/users/nibzard/repos","events_url":"https://api.github.com/users/nibzard/events{/privacy}","received_events_url":"https://api.github.com/users/nibzard/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":7347006954,"node_id":"LA_kwDOJ5_ntc8AAAABtept6g","url":"https://api.github.com/repos/daytonaio/content/labels/%F0%9F%92%8E%20Bounty","name":"💎 Bounty","color":"4f46e5","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":134,"created_at":"2024-08-19T15:05:03Z","updated_at":"2026-07-03T22:24:00Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Content Type\n\nGuide\n\n### Article Description\n\nContribute to the repo to add more supported APIs: https://github.com/nkkko/sapat\r\nOpenAI, groq, what else?\r\nWrite a long-form guide based on the repo and readme.\r\n\n\n### Target Audience\n\nAI engineer\n\n### References/Resources\n\nhttps://github.com/nkkko/sapat\n\n### Examples\n\nThis is a nice example, but it needs to be longer, explain more each step, especially whisper:\r\nhttps://www.daytona.io/dotfiles/how-to-set-up-a-project-with-cal-com-and-supabase\n\n### Special Instructions\n\n_No response_","reactions":{"url":"https://api.github.com/repos/daytonaio/content/issues/13/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/daytonaio/content/issues/13/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/qdrant/qdrant/issues/4297","repository_url":"https://api.github.com/repos/qdrant/qdrant","labels_url":"https://api.github.com/repos/qdrant/qdrant/issues/4297/labels{/name}","comments_url":"https://api.github.com/repos/qdrant/qdrant/issues/4297/comments","events_url":"https://api.github.com/repos/qdrant/qdrant/issues/4297/events","html_url":"https://github.com/qdrant/qdrant/issues/4297","id":2310345317,"node_id":"I_kwDOD_vaGc6JtRJl","number":4297,"title":"Implement better handling of OOD issues in optimizer","user":{"login":"generall","id":1935623,"node_id":"MDQ6VXNlcjE5MzU2MjM=","avatar_url":"https://avatars.githubusercontent.com/u/1935623?v=4","gravatar_id":"","url":"https://api.github.com/users/generall","html_url":"https://github.com/generall","followers_url":"https://api.github.com/users/generall/followers","following_url":"https://api.github.com/users/generall/following{/other_user}","gists_url":"https://api.github.com/users/generall/gists{/gist_id}","starred_url":"https://api.github.com/users/generall/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/generall/subscriptions","organizations_url":"https://api.github.com/users/generall/orgs","repos_url":"https://api.github.com/users/generall/repos","events_url":"https://api.github.com/users/generall/events{/privacy}","received_events_url":"https://api.github.com/users/generall/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":5309057328,"node_id":"LA_kwDOD_vaGc8AAAABPHHJMA","url":"https://api.github.com/repos/qdrant/qdrant/labels/%F0%9F%92%8E%20Bounty","name":"💎 Bounty","color":"4f46e5","default":false,"description":null},{"id":5338900719,"node_id":"LA_kwDOD_vaGc8AAAABPjko7w","url":"https://api.github.com/repos/qdrant/qdrant/labels/%F0%9F%92%B0%20Rewarded","name":"💰 Rewarded","color":"15803d","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":14,"created_at":"2024-05-22T11:57:12Z","updated_at":"2026-07-03T22:23:30Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Is your feature request related to a problem? Please describe.**\r\n\r\nCurrently, if the optimizer is used, it creates a new temporary segment with a copy of data from those segments, which are currently under optimization. \r\nThis process requires sometimes significant amount of disk space and if it is not enough, current implementation might panic.\r\n\r\n**Describe the solution you'd like**\r\n\r\nIn optimization process, we can check if there are enough disk space to continue indexing or not.\r\nA good space to do it is https://github.com/qdrant/qdrant/blob/ccf7f1d24f37dcfe82dad85fa66fb91352bd7a21/lib/collection/src/collection_manager/optimizers/segment_optimizer.rs#L100\r\n\r\n\r\n**Describe alternatives you've considered**\r\nIndexed segment is potentially a plain structure. There are not too many places where we can't handle the OOD error.\r\nAlternatively, we can check if we can actually handle OOD errors in this case, instead of checking for empty space each time.\r\n\r\n**Additional context**\r\n\r\nWe created a test that simulates the scenario of disk overflow https://github.com/qdrant/qdrant/pull/4267\r\n\r\nThe solution for this issue should resolve this test scenario in the most general way reasonable.\r\n\r\n\r\n","reactions":{"url":"https://api.github.com/repos/qdrant/qdrant/issues/4297/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/qdrant/qdrant/issues/4297/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/greyw0rks/bountyscout/issues/147","repository_url":"https://api.github.com/repos/greyw0rks/bountyscout","labels_url":"https://api.github.com/repos/greyw0rks/bountyscout/issues/147/labels{/name}","comments_url":"https://api.github.com/repos/greyw0rks/bountyscout/issues/147/comments","events_url":"https://api.github.com/repos/greyw0rks/bountyscout/issues/147/events","html_url":"https://github.com/greyw0rks/bountyscout/issues/147","id":4806306912,"node_id":"I_kwDOS9MLzs8AAAABHnpsYA","number":147,"title":"🎯 Bounty Alert: 32 New Opportunities — 2026-07-03 21:06 UTC","user":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.co