06:29:19Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Review the README for minor spelling, grammar, or formatting issues and submit a small cleanup PR.\n\n## Acceptance Criteria\n\n- Keep the pull request focused.\n- Include a short summary of the change.\n- Link this issue in the pull request description.\n\n/bounty $50","reactions":{"url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/2/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/xevrion-v2/agent-playground/issues/2/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/tscircuit/jlcsearch/issues/92","repository_url":"https://api.github.com/repos/tscircuit/jlcsearch","labels_url":"https://api.github.com/repos/tscircuit/jlcsearch/issues/92/labels{/name}","comments_url":"https://api.github.com/repos/tscircuit/jlcsearch/issues/92/comments","events_url":"https://api.github.com/repos/tscircuit/jlcsearch/issues/92/events","html_url":"https://github.com/tscircuit/jlcsearch/issues/92","id":3492579756,"node_id":"I_kwDONJLUE87QLIms","number":92,"title":"Add `is_extended_promotional ` column to components (from data source)","user":{"login":"seveibar","id":1910070,"node_id":"MDQ6VXNlcjE5MTAwNzA=","avatar_url":"https://avatars.githubusercontent.com/u/1910070?v=4","gravatar_id":"","url":"https://api.github.com/users/seveibar","html_url":"https://github.com/seveibar","followers_url":"https://api.github.com/users/seveibar/followers","following_url":"https://api.github.com/users/seveibar/following{/other_user}","gists_url":"https://api.github.com/users/seveibar/gists{/gist_id}","starred_url":"https://api.github.com/users/seveibar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/seveibar/subscriptions","organizations_url":"https://api.github.com/users/seveibar/orgs","repos_url":"https://api.github.com/users/seveibar/repos","events_url":"https://api.github.com/users/seveibar/events{/privacy}","received_events_url":"https://api.github.com/users/seveibar/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":7921659787,"node_id":"LA_kwDONJLUE88AAAAB2Crviw","url":"https://api.github.com/repos/tscircuit/jlcsearch/labels/%F0%9F%92%8E%20Bounty","name":"💎 Bounty","color":"4f46e5","default":false,"description":null},{"id":11003900875,"node_id":"LA_kwDONJLUE88AAAACj-Izyw","url":"https://api.github.com/repos/tscircuit/jlcsearch/labels/$1","name":"$1","color":"34d399","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":115,"created_at":"2025-10-07T18:30:54Z","updated_at":"2026-07-07T06:23:09Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Some parts are \"extended promotional\" which means they act as basic for a limited time, we should have that information available in a filterable column\n\n/bounty $75","reactions":{"url":"https://api.github.com/repos/tscircuit/jlcsearch/issues/92/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/tscircuit/jlcsearch/issues/92/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3","repository_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty","labels_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/labels{/name}","comments_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/comments","events_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/events","html_url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/3","id":4148310577,"node_id":"I_kwDORx6c0M73QjIx","number":3,"title":"[BOUNTY $100] HOOK: Pre-tool-use hook that blocks destructive bash commands","user":{"login":"claudebounty","id":271393208,"node_id":"U_kgDOEC0huA","avatar_url":"https://avatars.githubusercontent.com/u/271393208?v=4","gravatar_id":"","url":"https://api.github.com/users/claudebounty","html_url":"https://github.com/claudebounty","followers_url":"https://api.github.com/users/claudebounty/followers","following_url":"https://api.github.com/users/claudebounty/following{/other_user}","gists_url":"https://api.github.com/users/claudebounty/gists{/gist_id}","starred_url":"https://api.github.com/users/claudebounty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claudebounty/subscriptions","organizations_url":"https://api.github.com/users/claudebounty/orgs","repos_url":"https://api.github.com/users/claudebounty/repos","events_url":"https://api.github.com/users/claudebounty/events{/privacy}","received_events_url":"https://api.github.com/users/claudebounty/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10532402505,"node_id":"LA_kwDORx6c0M8AAAACc8e1SQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/bounty","name":"bounty","color":"D97706","default":false,"description":"Task with financial reward"},{"id":10532402677,"node_id":"LA_kwDORx6c0M8AAAACc8e19Q","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/hook","name":"hook","color":"DC2626","default":false,"description":"Claude Code hook"},{"id":10532402829,"node_id":"LA_kwDORx6c0M8AAAACc8e2jQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/security","name":"security","color":"B91C1C","default":false,"description":"Security-related"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1356,"created_at":"2026-03-27T00:55:40Z","updated_at":"2026-07-07T06:21:17Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 💰 Bounty: $100 — powered by [Opire](https://opire.dev)\n\n## Description\nCreate a Claude Code `pre-tool-use` hook in Python or bash that intercepts\ndangerous bash commands before they are executed.\n\n## Acceptance Criteria\n- [ ] Hook follows Claude Code hooks format (`~/.claude/hooks/`)\n- [ ] Blocks these patterns: `rm -rf`, `DROP TABLE`, `git push --force`,\n      `TRUNCATE`, `DELETE FROM` without a WHERE clause\n- [ ] Logs every blocked attempt to `~/.claude/hooks/blocked.log`\n      with: timestamp, attempted command, project path\n- [ ] Displays a clear message to Claude explaining why the command was blocked\n- [ ] Does not interfere with normal bash commands\n- [ ] README with installation in 2 commands or fewer\n\n## How to Claim\n1. Comment `/opire try` in this issue\n2. Submit a PR with the hook + README\n3. Payment is released automatically on merge ✅\n\n## Resources\n- Claude Code hooks docs: https://docs.anthropic.com/claude-code/hooks","reactions":{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/3/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2","repository_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty","labels_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2/labels{/name}","comments_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2/comments","events_url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2/events","html_url":"https://github.com/claude-builders-bounty/claude-builders-bounty/issues/2","id":4148310390,"node_id":"I_kwDORx6c0M73QjF2","number":2,"title":"[BOUNTY $75] TEMPLATE: CLAUDE.md for a Next.js + SQLite SaaS project","user":{"login":"claudebounty","id":271393208,"node_id":"U_kgDOEC0huA","avatar_url":"https://avatars.githubusercontent.com/u/271393208?v=4","gravatar_id":"","url":"https://api.github.com/users/claudebounty","html_url":"https://github.com/claudebounty","followers_url":"https://api.github.com/users/claudebounty/followers","following_url":"https://api.github.com/users/claudebounty/following{/other_user}","gists_url":"https://api.github.com/users/claudebounty/gists{/gist_id}","starred_url":"https://api.github.com/users/claudebounty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claudebounty/subscriptions","organizations_url":"https://api.github.com/users/claudebounty/orgs","repos_url":"https://api.github.com/users/claudebounty/repos","events_url":"https://api.github.com/users/claudebounty/events{/privacy}","received_events_url":"https://api.github.com/users/claudebounty/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10532402505,"node_id":"LA_kwDORx6c0M8AAAACc8e1SQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/bounty","name":"bounty","color":"D97706","default":false,"description":"Task with financial reward"},{"id":10532402633,"node_id":"LA_kwDORx6c0M8AAAACc8e1yQ","url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/labels/template","name":"template","color":"2563EB","default":false,"description":"Project template"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1076,"created_at":"2026-03-27T00:55:38Z","updated_at":"2026-07-07T06:21:15Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 💰 Bounty: $75 — powered by [Opire](https://opire.dev)\n\n## Description\nCreate an opinionated, production-ready `CLAUDE.md` for a typical SaaS project\nbuilt with Next.js 15 App Router and SQLite (better-sqlite3 or Turso).\n\n## Acceptance Criteria\n- [ ] Covers: project structure, naming conventions, DB migration rules\n- [ ] Includes: dev commands, patterns to follow, anti-patterns to avoid\n- [ ] Opinionated — not generic. Every rule has a reason.\n- [ ] Usable without modification on a greenfield Next.js + SQLite project\n- [ ] Tested: create a new project, paste the CLAUDE.md, confirm Claude Code\n      understands the context without asking clarifying questions\n\n## How to Claim\n1. Comment `/opire try` in this issue\n2. Submit a PR with your CLAUDE.md\n3. Payment is released automatically on merge ✅\n\n## Expected Sections\n- Stack & versions\n- Folder structure\n- SQL / migration conventions\n- Component patterns\n- What we don't do (and why)","reactions":{"url":"https://api.github.com/repos/claude-builders-bounty/claude-builders-bounty/issues/2/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"t