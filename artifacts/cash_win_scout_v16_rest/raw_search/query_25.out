ture","name":"NewFeature","color":"A52A2A","default":false,"description":"Something to build that is a new item."},{"id":3184150925,"node_id":"MDU6TGFiZWwzMTg0MTUwOTI1","url":"https://api.github.com/repos/Expensify/App/labels/Overdue","name":"Overdue","color":"D93F0B","default":false,"description":""},{"id":11258940365,"node_id":"LA_kwDOEQqHYc8AAAACnxXLzQ","url":"https://api.github.com/repos/Expensify/App/labels/Skip%20Payment","name":"Skip Payment","color":"6028c6","default":false,"description":"Skips all the payment process steps for an issue. Use it for fixed-price projects."}],"state":"open","locked":false,"assignees":[{"login":"yuwenmemon","id":4741899,"node_id":"MDQ6VXNlcjQ3NDE4OTk=","avatar_url":"https://avatars.githubusercontent.com/u/4741899?v=4","gravatar_id":"","url":"https://api.github.com/users/yuwenmemon","html_url":"https://github.com/yuwenmemon","followers_url":"https://api.github.com/users/yuwenmemon/followers","following_url":"https://api.github.com/users/yuwenmemon/following{/other_user}","gists_url":"https://api.github.com/users/yuwenmemon/gists{/gist_id}","starred_url":"https://api.github.com/users/yuwenmemon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yuwenmemon/subscriptions","organizations_url":"https://api.github.com/users/yuwenmemon/orgs","repos_url":"https://api.github.com/users/yuwenmemon/repos","events_url":"https://api.github.com/users/yuwenmemon/events{/privacy}","received_events_url":"https://api.github.com/users/yuwenmemon/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"ChavdaSachin","id":81917707,"node_id":"MDQ6VXNlcjgxOTE3NzA3","avatar_url":"https://avatars.githubusercontent.com/u/81917707?v=4","gravatar_id":"","url":"https://api.github.com/users/ChavdaSachin","html_url":"https://github.com/ChavdaSachin","followers_url":"https://api.github.com/users/ChavdaSachin/followers","following_url":"https://api.github.com/users/ChavdaSachin/following{/other_user}","gists_url":"https://api.github.com/users/ChavdaSachin/gists{/gist_id}","starred_url":"https://api.github.com/users/ChavdaSachin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ChavdaSachin/subscriptions","organizations_url":"https://api.github.com/users/ChavdaSachin/orgs","repos_url":"https://api.github.com/users/ChavdaSachin/repos","events_url":"https://api.github.com/users/ChavdaSachin/events{/privacy}","received_events_url":"https://api.github.com/users/ChavdaSachin/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"dubielzyk-expensify","id":145416827,"node_id":"U_kgDOCKriew","avatar_url":"https://avatars.githubusercontent.com/u/145416827?v=4","gravatar_id":"","url":"https://api.github.com/users/dubielzyk-expensify","html_url":"https://github.com/dubielzyk-expensify","followers_url":"https://api.github.com/users/dubielzyk-expensify/followers","following_url":"https://api.github.com/users/dubielzyk-expensify/following{/other_user}","gists_url":"https://api.github.com/users/dubielzyk-expensify/gists{/gist_id}","starred_url":"https://api.github.com/users/dubielzyk-expensify/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dubielzyk-expensify/subscriptions","organizations_url":"https://api.github.com/users/dubielzyk-expensify/orgs","repos_url":"https://api.github.com/users/dubielzyk-expensify/repos","events_url":"https://api.github.com/users/dubielzyk-expensify/events{/privacy}","received_events_url":"https://api.github.com/users/dubielzyk-expensify/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"thelullabyy","id":182625428,"node_id":"U_kgDOCuKklA","avatar_url":"https://avatars.githubusercontent.com/u/182625428?v=4","gravatar_id":"","url":"https://api.github.com/users/thelullabyy","html_url":"https://github.com/thelullabyy","followers_url":"https://api.github.com/users/thelullabyy/followers","following_url":"https://api.github.com/users/thelullabyy/following{/other_user}","gists_url":"https://api.github.com/users/thelullabyy/gists{/gist_id}","starred_url":"https://api.github.com/users/thelullabyy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thelullabyy/subscriptions","organizations_url":"https://api.github.com/users/thelullabyy/orgs","repos_url":"https://api.github.com/users/thelullabyy/repos","events_url":"https://api.github.com/users/thelullabyy/events{/privacy}","received_events_url":"https://api.github.com/users/thelullabyy/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":19,"created_at":"2026-05-02T21:47:27Z","updated_at":"2026-07-06T21:54:21Z","closed_at":null,"assignee":{"login":"yuwenmemon","id":4741899,"node_id":"MDQ6VXNlcjQ3NDE4OTk=","avatar_url":"https://avatars.githubusercontent.com/u/4741899?v=4","gravatar_id":"","url":"https://api.github.com/users/yuwenmemon","html_url":"https://github.com/yuwenmemon","followers_url":"https://api.github.com/users/yuwenmemon/followers","following_url":"https://api.github.com/users/yuwenmemon/following{/other_user}","gists_url":"https://api.github.com/users/yuwenmemon/gists{/gist_id}","starred_url":"https://api.github.com/users/yuwenmemon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yuwenmemon/subscriptions","organizations_url":"https://api.github.com/users/yuwenmemon/orgs","repos_url":"https://api.github.com/users/yuwenmemon/repos","events_url":"https://api.github.com/users/yuwenmemon/events{/privacy}","received_events_url":"https://api.github.com/users/yuwenmemon/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Parent: Expensify/Expensify#589894\nDesign doc: https://docs.google.com/document/d/1qQXU4EIij-OyCpk6z8idi0ch0rP4XtIQ0770STZeF5E/edit\n\n## Scope\n\nBranch `CertiniaAdvancedPage` to render PSA-specific toggles when `hasPSA === true` — Tax Non-Billable and Export Foreign Currency Amount — replacing the FFA Sync Reimbursed Reports row. Auto Sync remains for both modules.\n\n## Implementation notes (from design doc)\n\n### `CertiniaAdvancedPage.tsx` — Add PSA conditional rendering\n\nAuto Sync row remains at the top for both modules.\n\nIf `hasPSA === true`, replace the Sync Reimbursed Reports row with:\n\n2. **Export Tax as Non-Billable**: `ToggleSettingOptionRow`. `isActive={!!config?.advanced?.taxNonBillable}`. `onToggle={(enabled) => updateFinancialForceTaxNonBillable(policyID, enabled)}`. Subtitle: \"When enabled, tax is marked as non-billable on export to PSA.\"\n\n3. **Export Foreign Currency Amount**: `ToggleSettingOptionRow`. `isActive={!!config?.advanced?.exportForeignCurrency}`. `onToggle={(enabled) => updateFinancialForceExportForeignCurrency(policyID, enabled)}`. Subtitle: \"When disabled, expenses are converted to the report currency before export.\"\n\n## Tests\n\n- PSA advanced page: Auto Sync + Tax Non-Billable + Export Foreign Currency — no Sync Reimbursed Reports.\n- FFA advanced page renders the original Release 1 content unchanged.\n- Both new toggles fire the corresponding actions with pending indicator and revert on simulated failure.\n\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @mallenexpensify</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/89441/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/89441/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/89438","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/89438/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/89438/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/89438/events","html_url":"https://github.com/Expensify/App/issues/89438","id":4370130434,"node_id":"I_kwDOEQqHYc8AAAABBHrmAg","number":89438,"title":"[Certinia] R2 PSA: Scaffolding (CONST, SCREENS, ROUTES, navigators, API commands, actions, remove beta flag)","user":{"login":"yuwenmemon","id":4741899,"node_id":"MDQ6VXNlcjQ3NDE4OTk=","avatar_url":"https://avatars.githubusercontent.com/u/4741899?v=4","gravatar_id":"","url":"https://api.github.com/users/yuwenmemon","html_url":"https://github.com/yuwenmemon","followers_url":"https://api.github.com/users/yuwenmemon/followers","following_url":"https://api.github.com/users/yuwenmemon/following{/other_user}","gists_url":"https://api.github.com/users/yuwenmemon/gists{/gist_id}","starred_url":"https://api.github.com/users/yuwenmemon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yuwenmemon/subscriptions","organizations_url":"https://api.github.com/users/yuwenmemon/orgs","repos_url":"https://api.github.com/users/yuwenmemon/repos","events_url":"https://api.github.com/users/yuwenmemon/events{/privacy}","received_events_url":"https://api.github.com/users/yuwenmemon/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":2873635554,"node_id":"MDU6TGFiZWwyODczNjM1NTU0","url":"https://api.github.com/repos/Expensify/App/labels/Engineering","name":"Engineering","color":"274073","default":false,"description":""},{"id":2893515375,"node_id":"MDU6TGFiZWwyODkzNTE1Mzc1","url":"https://api.github.com/repos/Expensify/App/labels/Weekly","name":"Weekly","color":"009800","default":false,"description":"KSv2"},{"id":3033757191,"node_id":"MDU6TGFiZWwzMDMzNzU3MTkx","url":"https://api.github.com/repos/Expensify/App/labels/NewFeature","name":"NewFeature","col