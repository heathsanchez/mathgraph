ll,"comments":69,"created_at":"2026-03-17T15:55:54Z","updated_at":"2026-07-06T21:53:42Z","closed_at":null,"assignee":{"login":"luacmartins","id":22219519,"node_id":"MDQ6VXNlcjIyMjE5NTE5","avatar_url":"https://avatars.githubusercontent.com/u/22219519?v=4","gravatar_id":"","url":"https://api.github.com/users/luacmartins","html_url":"https://github.com/luacmartins","followers_url":"https://api.github.com/users/luacmartins/followers","following_url":"https://api.github.com/users/luacmartins/following{/other_user}","gists_url":"https://api.github.com/users/luacmartins/gists{/gist_id}","starred_url":"https://api.github.com/users/luacmartins/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/luacmartins/subscriptions","organizations_url":"https://api.github.com/users/luacmartins/orgs","repos_url":"https://api.github.com/users/luacmartins/repos","events_url":"https://api.github.com/users/luacmartins/events{/privacy}","received_events_url":"https://api.github.com/users/luacmartins/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Problem\nWhen users interact with the Reports page, if they are then navigated to the inbox, then they get confused and disoriented.\n\n### Solution\n1. Audit all interactions a user can take on the `Reports` page.\n2. Create a list of navigation events that redirect the user out of the `Reports` page, e.g. some page in the `Inbox`\n3. Fix those navigation events to prioritize navigating to their `Reports` counter part so users stay in the `Reports` page.\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @sobitneupane</details>\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: https://www.upwork.com/jobs/~022033935420524243072</li>\n        <li>Upwork Job ID: 2033935420524243072</li>\n        <li>Last Price Increase: 2026-04-07</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/85560/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/85560/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/82534","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/82534/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/82534/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/82534/events","html_url":"https://github.com/Expensify/App/issues/82534","id":3945797485,"node_id":"I_kwDOEQqHYc7rMBdt","number":82534,"title":"[Partial Payment?][CFI] Add inline editing for tables on desktop","user":{"login":"dubielzyk-expensify","id":145416827,"node_id":"U_kgDOCKriew","avatar_url":"https://avatars.githubusercontent.com/u/145416827?v=4","gravatar_id":"","url":"https://api.github.com/users/dubielzyk-expensify","html_url":"https://github.com/dubielzyk-expensify","followers_url":"https://api.github.com/users/dubielzyk-expensify/followers","following_url":"https://api.github.com/users/dubielzyk-expensify/following{/other_user}","gists_url":"https://api.github.com/users/dubielzyk-expensify/gists{/gist_id}","starred_url":"https://api.github.com/users/dubielzyk-expensify/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dubielzyk-expensify/subscriptions","organizations_url":"https://api.github.com/users/dubielzyk-expensify/orgs","repos_url":"https://api.github.com/users/dubielzyk-expensify/repos","events_url":"https://api.github.com/users/dubielz