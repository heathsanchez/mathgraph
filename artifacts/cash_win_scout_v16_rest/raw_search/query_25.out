ture","color":"A52A2A","default":false,"description":"Something to build that is a new item."},{"id":3184150925,"node_id":"MDU6TGFiZWwzMTg0MTUwOTI1","url":"https://api.github.com/repos/Expensify/App/labels/Overdue","name":"Overdue","color":"D93F0B","default":false,"description":""},{"id":11258940365,"node_id":"LA_kwDOEQqHYc8AAAACnxXLzQ","url":"https://api.github.com/repos/Expensify/App/labels/Skip%20Payment","name":"Skip Payment","color":"6028c6","default":false,"description":"Skips all the payment process steps for an issue. Use it for fixed-price projects."}],"state":"open","locked":false,"assignees":[{"login":"shawnborton","id":2319350,"node_id":"MDQ6VXNlcjIzMTkzNTA=","avatar_url":"https://avatars.githubusercontent.com/u/2319350?v=4","gravatar_id":"","url":"https://api.github.com/users/shawnborton","html_url":"https://github.com/shawnborton","followers_url":"https://api.github.com/users/shawnborton/followers","following_url":"https://api.github.com/users/shawnborton/following{/other_user}","gists_url":"https://api.github.com/users/shawnborton/gists{/gist_id}","starred_url":"https://api.github.com/users/shawnborton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shawnborton/subscriptions","organizations_url":"https://api.github.com/users/shawnborton/orgs","repos_url":"https://api.github.com/users/shawnborton/repos","events_url":"https://api.github.com/users/shawnborton/events{/privacy}","received_events_url":"https://api.github.com/users/shawnborton/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"yuwenmemon","id":4741899,"node_id":"MDQ6VXNlcjQ3NDE4OTk=","avatar_url":"https://avatars.githubusercontent.com/u/4741899?v=4","gravatar_id":"","url":"https://api.github.com/users/yuwenmemon","html_url":"https://github.com/yuwenmemon","followers_url":"https://api.github.com/users/yuwenmemon/followers","following_url":"https://api.github.com/users/yuwenmemon/following{/other_user}","gists_url":"https://api.github.com/users/yuwenmemon/gists{/gist_id}","starred_url":"https://api.github.com/users/yuwenmemon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yuwenmemon/subscriptions","organizations_url":"https://api.github.com/users/yuwenmemon/orgs","repos_url":"https://api.github.com/users/yuwenmemon/repos","events_url":"https://api.github.com/users/yuwenmemon/events{/privacy}","received_events_url":"https://api.github.com/users/yuwenmemon/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"ChavdaSachin","id":81917707,"node_id":"MDQ6VXNlcjgxOTE3NzA3","avatar_url":"https://avatars.githubusercontent.com/u/81917707?v=4","gravatar_id":"","url":"https://api.github.com/users/ChavdaSachin","html_url":"https://github.com/ChavdaSachin","followers_url":"https://api.github.com/users/ChavdaSachin/followers","following_url":"https://api.github.com/users/ChavdaSachin/following{/other_user}","gists_url":"https://api.github.com/users/ChavdaSachin/gists{/gist_id}","starred_url":"https://api.github.com/users/ChavdaSachin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ChavdaSachin/subscriptions","organizations_url":"https://api.github.com/users/ChavdaSachin/orgs","repos_url":"https://api.github.com/users/ChavdaSachin/repos","events_url":"https://api.github.com/users/ChavdaSachin/events{/privacy}","received_events_url":"https://api.github.com/users/ChavdaSachin/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"thelullabyy","id":182625428,"node_id":"U_kgDOCuKklA","avatar_url":"https://avatars.githubusercontent.com/u/182625428?v=4","gravatar_id":"","url":"https://api.github.com/users/thelullabyy","html_url":"https://github.com/thelullabyy","followers_url":"https://api.github.com/users/thelullabyy/followers","following_url":"https://api.github.com/users/thelullabyy/following{/other_user}","gists_url":"https://api.github.com/users/thelullabyy/gists{/gist_id}","starred_url":"https://api.github.com/users/thelullabyy/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thelullabyy/subscriptions","organizations_url":"https://api.github.com/users/thelullabyy/orgs","repos_url":"https://api.github.com/users/thelullabyy/repos","events_url":"https://api.github.com/users/thelullabyy/events{/privacy}","received_events_url":"https://api.github.com/users/thelullabyy/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":19,"created_at":"2026-05-02T21:47:33Z","updated_at":"2026-07-06T21:54:24Z","closed_at":null,"assignee":{"login":"shawnborton","id":2319350,"node_id":"MDQ6VXNlcjIzMTkzNTA=","avatar_url":"https://avatars.githubusercontent.com/u/2319350?v=4","gravatar_id":"","url":"https://api.github.com/users/shawnborton","html_url":"https://github.com/shawnborton","followers_url":"https://api.github.com/users/shawnborton/followers","following_url":"https://api.github.com/users/shawnborton/following{/other_user}","gists_url":"https://api.github.com/users/shawnborton/gists{/gist_id}","starred_url":"https://api.github.com/users/shawnborton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shawnborton/subscriptions","organizations_url":"https://api.github.com/users/shawnborton/orgs","repos_url":"https://api.github.com/users/shawnborton/repos","events_url":"https://api.github.com/users/shawnborton/events{/privacy}","received_events_url":"https://api.github.com/users/shawnborton/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Parent: Expensify/Expensify#589894\nDesign doc: https://docs.google.com/document/d/1qQXU4EIij-OyCpk6z8idi0ch0rP4XtIQ0770STZeF5E/edit\n\n## Scope\n\nBuild the SRP `CertiniaCompanySelectorPage` (only relevant when both modules are active), wire it into `accounting/utils.tsx`, and add the Release 2 PSA translation keys to `en.ts`. With this issue landed, Release 2 is feature-complete and the beta flag can come off.\n\n## Implementation notes (from design doc)\n\n### `src/pages/workspace/accounting/certinia/CertiniaCompanySelectorPage.tsx` — Create (SRP)\n\nOnly relevant when `hasPSA === true && hasPSAOnly === false` (SRP: both modules active). Lists companies from `policy?.connections?.financialForce?.data?.companies` as radio options. Calls `updateFinancialForceCompany(policyID, companyID)`.\n\nIn `getAccountingIntegrationData` (SRP: both modules active), surface navigation to this page as an additional `MenuItemWithTopDescription` on the main Accounting connection card when `hasPSA && !hasPSAOnly`, pointing to `POLICY_ACCOUNTING_CERTINIA_COMPANY_SELECTOR.getRoute(policyID)`.\n\nAlso update the `subscribed*Settings` arrays in `accounting/utils.tsx` to include PSA-specific keys based on `ffaConfig?.hasPSA` (e.g., `PARENT_TAG_MAPPING`, `SYNC_MILESTONES`, `REPORT_EXPORT_STATUS`, `TAX_NON_BILLABLE`, `EXPORT_FOREIGN_CURRENCY`) so the connection card shows the right pending/error indicators for PSA workspaces.\n\n### `src/languages/en.ts` — Add PSA translation keys\n\n```ts\ncertinia.import.expenseTypeGlaMappings = 'Expense type GLA mappings'\ncertinia.import.expenseTypeGlaMappingsDescription = 'FinancialForce Expense Type GLA Mappings are imported into Expensify as categories.'\ncertinia.import.tagsMappedTo = 'Tags should be mapped to'\ncertinia.import.projectsAndAssignments = 'Projects and Assignments'\ncertinia.import.projects = 'Projects'\ncertinia.import.assignments = 'Assignments'\ncertinia.import.milestones = 'Milestones'\ncertinia.import.milestonesDescription = 'When enabled, milestones associated with PSA projects are synced into Expensify.'\ncertinia.export.expenseReportStatus = 'Expense report status'\ncertinia.export.reportStatuses.APPROVED = 'Approved'\ncertinia.export.reportStatuses.SUBMITTED = 'Submitted'\ncertinia.advanced.taxNonBillable = 'Export tax as non-billable'\ncertinia.advanced.taxNonBillableDescription = 'When enabled, tax is marked as non-billable on export to PSA.'\ncertinia.advanced.exportForeignCurrency = 'Export foreign currency amount'\ncertinia.advanced.exportForeignCurrencyDescription = 'When disabled, expenses are converted to the report currency before export.'\ncertinia.companySelector = 'Company'\n```\n\nStub corresponding entries in `es.ts`.\n\n## Tests (Release 2 verification)\n\nAfter this issue lands, the Release 2 staging checklist should pass:\n\n1. FFA workspace: all Release 1 screens unchanged.\n2. PSA workspace (`hasPSA === true`): import page shows locked Expense Type GLA Mappings toggle, Tags push row, Milestones toggle — no Dimension rows, no Tax toggle.\n3. Tags Mapping page shows 3 radio options; selecting one updates the subtitle optimistically.\n4. PSA export: Preferred Exporter, Expense Report Status, two static rows — no Default Vendor, no Invoice Date.\n5. PSA advanced: Auto Sync + Tax Non-Billable + Export Foreign Currency — no Sync Reimbursed Reports.\n6. SRP connection (`hasPSA && !hasPSAOnly`): Company Selector row visible on main Accounting page; selecting a company fires the action with pending indicator.\n7. All PSA toggles show pending indicator; revert correctly on simulated API failure.\n8. Beta flag absent — Certinia card is visible to all users.\n\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @mallenexpensify</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/89442/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/89442/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.co