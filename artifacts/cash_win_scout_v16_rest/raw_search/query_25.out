,"description":"Item broken or needs improvement."},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."},{"id":11258940365,"node_id":"LA_kwDOEQqHYc8AAAACnxXLzQ","url":"https://api.github.com/repos/Expensify/App/labels/Skip%20Payment","name":"Skip Payment","color":"6028c6","default":false,"description":"Skips all the payment process steps for an issue. Use it for fixed-price projects."}],"state":"open","locked":false,"assignees":[{"login":"tgolen","id":1228807,"node_id":"MDQ6VXNlcjEyMjg4MDc=","avatar_url":"https://avatars.githubusercontent.com/u/1228807?v=4","gravatar_id":"","url":"https://api.github.com/users/tgolen","html_url":"https://github.com/tgolen","followers_url":"https://api.github.com/users/tgolen/followers","following_url":"https://api.github.com/users/tgolen/following{/other_user}","gists_url":"https://api.github.com/users/tgolen/gists{/gist_id}","starred_url":"https://api.github.com/users/tgolen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tgolen/subscriptions","organizations_url":"https://api.github.com/users/tgolen/orgs","repos_url":"https://api.github.com/users/tgolen/repos","events_url":"https://api.github.com/users/tgolen/events{/privacy}","received_events_url":"https://api.github.com/users/tgolen/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"rlinoz","id":5201282,"node_id":"MDQ6VXNlcjUyMDEyODI=","avatar_url":"https://avatars.githubusercontent.com/u/5201282?v=4","gravatar_id":"","url":"https://api.github.com/users/rlinoz","html_url":"https://github.com/rlinoz","followers_url":"https://api.github.com/users/rlinoz/followers","following_url":"https://api.github.com/users/rlinoz/following{/other_user}","gists_url":"https://api.github.com/users/rlinoz/gists{/gist_id}","starred_url":"https://api.github.com/use