"MDQ6VXNlcjcxMjEwNzk5","avatar_url":"https://avatars.githubusercontent.com/u/71210799?v=4","gravatar_id":"","url":"https://api.github.com/users/mohammadjafarinejad","html_url":"https://github.com/mohammadjafarinejad","followers_url":"https://api.github.com/users/mohammadjafarinejad/followers","following_url":"https://api.github.com/users/mohammadjafarinejad/following{/other_user}","gists_url":"https://api.github.com/users/mohammadjafarinejad/gists{/gist_id}","starred_url":"https://api.github.com/users/mohammadjafarinejad/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mohammadjafarinejad/subscriptions","organizations_url":"https://api.github.com/users/mohammadjafarinejad/orgs","repos_url":"https://api.github.com/users/mohammadjafarinejad/repos","events_url":"https://api.github.com/users/mohammadjafarinejad/events{/privacy}","received_events_url":"https://api.github.com/users/mohammadjafarinejad/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":37,"created_at":"2025-12-04T06:45:36Z","updated_at":"2026-07-06T22:38:38Z","closed_at":null,"assignee":{"login":"waterim","id":39777589,"node_id":"MDQ6VXNlcjM5Nzc3NTg5","avatar_url":"https://avatars.githubusercontent.com/u/39777589?v=4","gravatar_id":"","url":"https://api.github.com/users/waterim","html_url":"https://github.com/waterim","followers_url":"https://api.github.com/users/waterim/followers","following_url":"https://api.github.com/users/waterim/following{/other_user}","gists_url":"https://api.github.com/users/waterim/gists{/gist_id}","starred_url":"https://api.github.com/users/waterim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/waterim/subscriptions","organizations_url":"https://api.github.com/users/waterim/orgs","repos_url":"https://api.github.com/users/waterim/repos","events_url":"https://api.github.com/users/waterim/events{/privacy}","received_events_url":"https://api.github.com/users/waterim/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"parent_issue_url":"https://api.github.com/repos/Expensify/App/issues/68799","issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Coming from https://github.com/Expensify/App/issues/68799#issuecomment-3562885730...\n\n### Problem\nWhen every component mounts its own ConfirmModal in the component tree, it creates component bloat, memory overhead from multiple modal instances, and repetitive boilerplate code that makes the application harder to maintain.\n\n### Solution\nRefactor ConfirmModal usage to useConfirmModal in the following files:\n\n```\nImportSpreadsheet.tsx\nImportSpreadsheetConfirmModal.tsx\nDotIndicatorMessage.tsx\nBookTravelButton.tsx\nAccountSwitcher.tsx\nExportWithDropdownMenu.tsx\nLocationPermissionModal/index.tsx\nLocationPermissionModal/index.desktop.tsx\nContactPermissionModal/index.native.tsx\nFocusModeNotification.tsx\nSupportalPermissionDeniedModalProvider.tsx\nDelegateNoAccessModalProvider.tsx\nLockedAccountModalProvider.tsx\nuseFilesValidation.tsx\nuseCreateEmptyReportConfirmation.tsx\nsrc/Expensify.tsx\nTransactionReceiptModalContent.tsx\n```\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @</details>\n\n\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @mallenexpensify</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/76696/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/76696/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/66411","repository_url":"https://api.github.com/rep