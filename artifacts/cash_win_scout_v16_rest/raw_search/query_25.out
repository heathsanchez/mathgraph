://api.github.com/users/sharabai/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":44,"created_at":"2026-05-13T10:43:18Z","updated_at":"2026-07-06T22:36:42Z","closed_at":null,"assignee":{"login":"parasharrajat","id":24370807,"node_id":"MDQ6VXNlcjI0MzcwODA3","avatar_url":"https://avatars.githubusercontent.com/u/24370807?v=4","gravatar_id":"","url":"https://api.github.com/users/parasharrajat","html_url":"https://github.com/parasharrajat","followers_url":"https://api.github.com/users/parasharrajat/followers","following_url":"https://api.github.com/users/parasharrajat/following{/other_user}","gists_url":"https://api.github.com/users/parasharrajat/gists{/gist_id}","starred_url":"https://api.github.com/users/parasharrajat/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/parasharrajat/subscriptions","organizations_url":"https://api.github.com/users/parasharrajat/orgs","repos_url":"https://api.github.com/users/parasharrajat/repos","events_url":"https://api.github.com/users/parasharrajat/events{/privacy}","received_events_url":"https://api.github.com/users/parasharrajat/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"parent_issue_url":"https://api.github.com/repos/Expensify/App/issues/53493","issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Context\n\nThis is a sub-issue of #53493 (Replace modal screens with modals from `@react-navigation`).\n\nFor full background and migration approach, see the [triage analysis comment](https://github.com/Expensify/App/issues/53493#issuecomment-4312826488) and the [sub-issue breakdown comment](https://github.com/Expensify/App/issues/53493#issuecomment-4439641260).\n\n## Problem\n\n`FeatureTrainingModal` is a generic educational overlay used in 12+ render sites across 11+ files with non-serializable configuration (children, video/SVG/Lottie content, custom callbacks), making it complex to migrate to `@react-navigation`.\n\n## Migration approach (Group 4 — Complex, consider deferring inline usages)\n\n- **File:** `src/components/FeatureTrainingModal.tsx` (534 lines)\n- **Used by:** 11+ files, 12+ render sites. 3 are already navigation pages via `FeatureTrainingModalNavigator`; the rest are `CENTERED` overlays.\n- **Complexity:** Generic educational overlay with video/SVG/Lottie, \"don't show again\" preference, help/skip buttons, and custom children. Inline usages (HoldOrReject, HoldSubmitter, multi-scan popup) are contextual overlays that would change UX if moved to a navigation route.\n\n### Suggested migration approach\n1. Evaluate whether the `CENTERED` inline usages genuinely need navigation migration or can remain as-is (they are not currently causing animation bugs).\n2. Focus on the usages that animate in from right-to-left (screen-like) and are causing animation inconsistencies.\n3. For those usages, create dedicated `@react-navigation` modal routes and pass any required configuration via Onyx rather than props.\n4. Keep the `CENTERED` overlay usages as-is where the UX change is not justified.\n\n## Reference\n\n- Triage analysis: https://github.com/Expensify/App/issues/53493#issuecomment-4312826488\n- Parent tracking issue: #53493\n\n","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/90475/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/90475/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/92431","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/is