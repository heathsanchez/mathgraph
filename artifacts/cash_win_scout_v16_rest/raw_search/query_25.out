site_admin":false}],"milestone":null,"comments":7,"created_at":"2026-06-17T10:09:43Z","updated_at":"2026-07-06T22:29:00Z","closed_at":null,"assignee":{"login":"TMisiukiewicz","id":13985840,"node_id":"MDQ6VXNlcjEzOTg1ODQw","avatar_url":"https://avatars.githubusercontent.com/u/13985840?v=4","gravatar_id":"","url":"https://api.github.com/users/TMisiukiewicz","html_url":"https://github.com/TMisiukiewicz","followers_url":"https://api.github.com/users/TMisiukiewicz/followers","following_url":"https://api.github.com/users/TMisiukiewicz/following{/other_user}","gists_url":"https://api.github.com/users/TMisiukiewicz/gists{/gist_id}","starred_url":"https://api.github.com/users/TMisiukiewicz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TMisiukiewicz/subscriptions","organizations_url":"https://api.github.com/users/TMisiukiewicz/orgs","repos_url":"https://api.github.com/users/TMisiukiewicz/repos","events_url":"https://api.github.com/users/TMisiukiewicz/events{/privacy}","received_events_url":"https://api.github.com/users/TMisiukiewicz/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"parent_issue_url":"https://api.github.com/repos/Expensify/App/issues/80560","issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Problem\n\n`useAllPolicyExpenseChatReportActions` built a filtered map of policy-expense-chat report actions on every render and was consumed by 5 components, even though the filtered map was only needed inside event-handler callbacks. On heavy accounts this wasted significant work on every render cycle — e.g. `KYCWall` took ~275ms on a single \"Pay\" button press (4x CPU throttle).\n\n## Solution\n\nExtracted the filtering logic into a pure function `getAllPolicyExpenseChatReportActions(allReports, allReportActions)` in `ReportUtils.ts`, migrated all 5 consumers to call it lazily inside the callbacks that need it, and deleted the unused hook. No behavior change — computation moves from the render path to callbacks only.\n\n## PR\n\nhttps://github.com/Expensify/App/pull/93781\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @mallenexpensify</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/93788/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/93788/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/92089","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/92089/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/92089/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/92089/events","html_url":"https://github.com/Expensify/App/issues/92089","id":4549386596,"node_id":"I_kwDOEQqHYc8AAAABDyohZA","number":92089,"title":"[Due for payment 2026-06-29] [CFI] [$250] Future-dated card assignments are not supported in New Expensify","user":{"login":"m-natarajan","id":38435837,"node_id":"MDQ6VXNlcjM4NDM1ODM3","avatar_url":"https://avatars.githubusercontent.com/u/38435837?v=4","gravatar_id":"","url":"https://api.github.com/users/m-natarajan","html_url":"https://github.com/m-natarajan","followers_url":"https://api.github.com/users/m-natarajan/followers","following_url":"https://api.github.com/users/m-natarajan/following{/other_user}","gists_url":"https://api.github.com/users/m-natarajan/gists{/gist_id}","starred_url":"https://api.github.com/users/m-natarajan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m-natarajan/subscriptions","organizations_url":"htt