tions_url":"https://api.github.com/users/ahmedGaber93/orgs","repos_url":"https://api.github.com/users/ahmedGaber93/repos","events_url":"https://api.github.com/users/ahmedGaber93/events{/privacy}","received_events_url":"https://api.github.com/users/ahmedGaber93/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":36,"created_at":"2026-07-06T18:48:26Z","updated_at":"2026-07-07T04:37:34Z","closed_at":null,"assignee":{"login":"ahmedGaber93","id":41129870,"node_id":"MDQ6VXNlcjQxMTI5ODcw","avatar_url":"https://avatars.githubusercontent.com/u/41129870?v=4","gravatar_id":"","url":"https://api.github.com/users/ahmedGaber93","html_url":"https://github.com/ahmedGaber93","followers_url":"https://api.github.com/users/ahmedGaber93/followers","following_url":"https://api.github.com/users/ahmedGaber93/following{/other_user}","gists_url":"https://api.github.com/users/ahmedGaber93/gists{/gist_id}","starred_url":"https://api.github.com/users/ahmedGaber93/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ahmedGaber93/subscriptions","organizations_url":"https://api.github.com/users/ahmedGaber93/orgs","repos_url":"https://api.github.com/users/ahmedGaber93/repos","events_url":"https://api.github.com/users/ahmedGaber93/events{/privacy}","received_events_url":"https://api.github.com/users/ahmedGaber93/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** 9.4.28-0\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://github.com/Expensify/App/pull/92142\n**Email or phone of affected tester (no customers):** sdjoisjdnojsodjiosjo@gmail.com\n**Issue reported by:** Applause Internal Team\n**Bug source:** Pull Request QA execution\n**Device used:** Mac 26.5 / Chrome\n**App Component:** Money Requests\n\n## Action Performed:\nPrecondition:\n- Workspace is connected to Sage Intacct.\n\n1. Go to staging.new.expensify.com\n2. Go to workspace chat.\n3. Create an expense.\n4. Open the report.\n5. Click Submit, Approve and Mark as paid.\n6. Click More > Export > Mark as exported.\n7. Try to select export system message by clicking and dragging.\n\n## Expected Result:\nExport system message can be selected by clicking and dragging.\n\n## Actual Result:\nExport system message cannot be selected by clicking and dragging.\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [ ] MacOS: Chrome Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/535dffa9-dae1-4019-8a84-ff1fab3b3315\n\n> **Applause Internal Information**\n> Exported by: Svetlana Lazutkina\n> Bug ID: 7201040\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022074204959729888287\">https://www.upwork.com/jobs/~022074204959729888287</a></li>\n        <li>Upwork Job ID: 2074204959729888287</li>\n        <li>Last Price Increase: 2026-07-06</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/95424/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/95424/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/anthropics/claude-code/issues/17432","repository_url":"https://api.github.com/repos/anthropics/claude-code","labels_url":"https://api.github.com/repos/anthropics/claude-code/issues/17432/labels{/name}","comments_url":"https://api.github.com/repos/anthropics/claude-code/issues/17432/comments","events_url":"https://api.github.com/repos/anthropics/claude-code/issues/17432/events","html_url":"https://github.com/anthropics/claude-code/issues/17432","id":3800747157,"node_id":"I_kwDON91aY87iisyV","number":17432,"title":"Feature Request: India-Specific Pricing Plans (INR) for Claude & Claude Code","user":{"login":"saidev-pbi-fabric","id":205408242,"node_id":"U_kgDODD5H8g","avatar_url":"https://avatars.githubusercontent.com/u/205408242?v=4","gravatar_id":"","url":"https://api.github.com/users/saidev-pbi-fabric","html_url":"https://github.com/saidev-pbi-fabric","followers_url":"https://api.github.com/users/saidev-pbi-fabric/followers","following_url":"https://api.github.com/users/saidev-pbi-fabric/following{/other_user}","gists_url":"https://api.github.com/users/saidev-pbi-fabric/gists{/gist_id}","starred_url":"https://api.github.com/users/saidev-pbi-fabric/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/saidev-pbi-fabric/subscriptions","organizations_url":"https://api.github.com/users/saidev-pbi-fabric/orgs","repos_url":"https://api.github.com/users/saidev-pbi-fabric/repos","events_url":"https://api.github.com/users/saidev-pbi-fabric/events{/privacy}","received_events_url":"https://api.github.com/users/saidev-pbi-fabric/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8190926415,"node_id":"LA_kwDON91aY88AAAAB6DeeTw","url":"https://api.github.com/repos/anthropics/claude-code/labels/enhancement","name":"enhancement","color":"A2D9CE","default":true,"description":"New feature or request"},{"id":8566350905,"node_id":"LA_kwDON91aY88AAAAB_pgkOQ","url":"https://api.github.com/repos/anthropics/claude-code/labels/area:cost","name":"area:cost","color":"ededed","default":false,"description":""},{"id":8571179701,"node_id":"LA_kwDON91aY88AAAAB_uHStQ","url":"https://api.github.com/repos/anthropics/claude-code/labels/external","name":"external","color":"ededed","default":false,"description":""}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":205,"created_at":"2026-01-11T05:03:21Z","updated_at":"2026-07-07T04:35:33Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Summary\nRequest for Anthropic to introduce India-specific pricing plans in INR (Indian Rupees) for Claude Pro and Claude Code subscriptions, similar to what OpenAI (ChatGPT) and Google (Gemini) already offer.\n\n## Problem\nCurrently, Claude subscriptions are only available in USD, which creates significant barriers for Indian users:\n\n1. **Currency conversion costs**: Indians pay in INR but are charged in USD, incurring forex conversion fees (2-3%)\n2. **GST on international transactions**: 18% GST is added to foreign currency transactions\n3. **Effective cost is much higher**: Claude Pro ($20) becomes ~₹2,000+ after conversion and taxes\n4. **No UPI support**: India's most popular payment method isn't supported\n5. **No localized payment options**: No support for Indian payment gateways\n\n## Competitor Comparison (India Pricing)\n\n| Service | India Price (INR/month) | Special Offers |\n|---------|-------------------------|----------------|\n| ChatGPT Go | ₹399 | First year FREE for Indians |\n| ChatGPT Plus | ₹1,999 | Localized pricing |\n| Gemini AI Plus | ₹199 (intro) → ₹399 | 6-month intro pricing |\n| Gemini AI Pro | ₹1,950 | Free 1 year for college students |\n| **Claude Pro** | ~₹2,000+ (USD converted) | No localized pricing |\n\nBoth OpenAI and Google have recognized India as a major market and introduced:\n- INR pricing\n- UPI payment support\n- Student/promotional offers\n- Partnerships with Indian telcos (e.g., Jio)\n\n## Proposed Solution\n\n1. **Introduce INR pricing** for Claude Pro and Claude Max plans\n2. **Add UPI as a payment option** (used by 300M+ Indians)\n3. **Consider competitive pricing**: \n   - Claude Pro: ₹999-1,499/month (to compete with ChatGPT Go at ₹399)\n   - Claude Max: ₹4,999-7,999/month\n4. **Student discounts** for Indian college students\n5. **Partner with Indian payment gateways** (Razorpay, Paytm, PhonePe)\n\n## Why This Matters\n\n- **India has 900M+ internet users** - one of the largest potential markets\n- **Growing developer community** - India produces the most developers globally\n- **AI adoption is accelerating** - but cost is a major barrier\n- **Competitors are winning** - ChatGPT and Gemini are capturing the Indian market with localized pricing\n- **Claude Code specifically** - developers need affordable access to use Claude Code for their work\n\n## Current Pain Points (User Perspective)\n\n> \"To use Claude Code we need a subscription and if it's in dollars and including GST it's very expensive for Indians who make money in INR unless provided by a corporate.\"\n\nThis sentiment is common among Indian developers and professionals who want to use Claude but find the pricing prohibitive compared to alternatives.\n\n## Business Case\n\n- India's AI market is projected to reach $17B by 2027\n- Localized pricing typically increases adoption 3-5x in emerging markets\n- First-mover advantage in localized pricing builds brand loyalty\n- Enterprise adoption in India often starts with individual developers\n\n## Additional Context\n\nCountries like Brazil, Indonesia, and other emerging markets would also benefit from similar localized pricing strategies.\n\n## References\n- [ChatGPT Go India Launch](https://www.cursor-ide.com/blog/chatgpt-go-subscription-india)\n- [Google AI Plus India Pricing](https://techcrunch.com/2025/12/10/google-launches-sub-5-ai-plus-plan-in-india-to-compete-with-chatgpt-go/)\n- [AI Subscriptions Comparison 2025](https://www.freepressjournal.in/tech/top-ai-subscriptions-compared-2025-chatgpt-gemini-claude-more-choose-the-right-one-for-you)","reactions":{"url":"https://api.github.com/repos/anthropics/claude-code/issues/17432/reactions","total_count":593,"+1":464,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":35,"rocket":80,"eyes":14},"timeline_url":"https://api.github.com/repos/anthropics/claude-code/issues/17432/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/midnghtsapphire/revvel-standards/issues/15168","repository_url":"https://api.github.com/repos/midnghtsapphire/revvel-standards","labels_url":"https://api.github.com/repos/midnghtsapphire/revvel-standards/issues/15168/labels{/name}","comments_url":"https://api.github.com/repos/midnghtsapphire/revvel-standards/issues/15168/comments","events_url":"https://api.github.com/repos/midnghtsapphire/revvel-standards/issues/15168/events","html_url":"https://github.com/midnghtsapphire/revvel-standards/issues/15168","id":4814737503,"node_id":"I_kwDORUz8Xs8AAAABHvsQXw","number":15168,"title":"[WR] deep research github models to implement in revvel-standard","user":{"login":"midnghtsapphire","id":4635833,"node_id":"MDQ6VXNlcjQ2MzU4MzM=","avatar_url":"https://avatars.githubusercontent.com/u/4635833?v=4","gravatar_id":"","url":"https://api.github.com/users/midnghtsapphire","html_url":"https://github.com/midnghtsapphire","followers_url":"https://api.github.com/users/midnghtsapphire/followers","following_url":"https://api.github.com/users/midnghtsapphire/following{/other_user}","gists_url":"https://api.github.com/users/midnghtsapphire/gists{/gist_id}"