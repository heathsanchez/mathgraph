ub.com/users/dubielzyk-expensify/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dubielzyk-expensify/subscriptions","organizations_url":"https://api.github.com/users/dubielzyk-expensify/orgs","repos_url":"https://api.github.com/users/dubielzyk-expensify/repos","events_url":"https://api.github.com/users/dubielzyk-expensify/events{/privacy}","received_events_url":"https://api.github.com/users/dubielzyk-expensify/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":38,"created_at":"2026-06-08T12:55:36Z","updated_at":"2026-07-07T02:47:56Z","closed_at":null,"assignee":{"login":"Ollyws","id":11609254,"node_id":"MDQ6VXNlcjExNjA5MjU0","avatar_url":"https://avatars.githubusercontent.com/u/11609254?v=4","gravatar_id":"","url":"https://api.github.com/users/Ollyws","html_url":"https://github.com/Ollyws","followers_url":"https://api.github.com/users/Ollyws/followers","following_url":"https://api.github.com/users/Ollyws/following{/other_user}","gists_url":"https://api.github.com/users/Ollyws/gists{/gist_id}","starred_url":"https://api.github.com/users/Ollyws/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Ollyws/subscriptions","organizations_url":"https://api.github.com/users/Ollyws/orgs","repos_url":"https://api.github.com/users/Ollyws/repos","events_url":"https://api.github.com/users/Ollyws/events{/privacy}","received_events_url":"https://api.github.com/users/Ollyws/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Coming from https://github.com/Expensify/Expensify/issues/636268, lets make the following changes in this issue:\n\n1. Add the 🔍 icon to the top right of the Spend page (like the rest of the pages in the app). This will make it consistent across screens. This will act as the router for the search page.\n2.  We need to make the following changes to the search bar on the 'spend' page:\n3. Turn the search bar into a keyword search only. This should maintain the current filters, and search type that are currently applied, but update the `keyword:` filter\n4. Clicking the X in the keyword search input re-executes the search minus the keywords, but leaves the rest of the filters of the current search in place. (That way, it doesn’t “jump” back to Spend > Expenses every time as the default, but does clear whatever keyword filtering on the table you did).\n\n\n\n\n\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022063968232784055750\">https://www.upwork.com/jobs/~022063968232784055750</a></li>\n        <li>Upwork Job ID: 2063968232784055750</li>\n        <li>Last Price Increase: 2026-06-08</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @mallenexpensify</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/92924/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/92924/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/71","id":3904303864,"node_id":"I_kwDORGgqa87otvL4","number":71,"title":"[BOUNTY] Ongoing Bug Bounty Program — Find Bugs, Earn RTC (133 RTC Pool)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029408,"node_id":"LA_kwDORGgqa88AAAACWucZoA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bug","name":"bug","color":"d73a4a","default":true,"description":"Something isn't working"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":432,"created_at":"2026-02-06T01:13:53Z","updated_at":"2026-07-07T02:47:44Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Ongoing Bug Bounty Program\n\n**Pool: 750 RTC (ongoing, replenished as needed)**\n\n### Severity & Rewards\n| Severity | Description | Reward |\n|----------|-------------|--------|\n| **Critical** | Fund theft, consensus bypass, RCE | 100-200 RTC |\n| **High** | Data leak, auth bypass, significant logic error | 50-100 RTC |\n| **Medium** | DoS, info disclosure, moderate bugs | 15-50 RTC |\n| **Low** | UI bugs, minor leaks, doc errors | 5-15 RTC |\n\n### In-Scope\n- RustChain node software, attestation & fingerprint system\n- Epoch settlement & rewards, wallet endpoints\n- BoTTube web app, API, payment system\n- Python SDK, Block Explorer, Wallet GUI, Miner clients\n\n### Reporting\n1. Create GitHub issue with `[SECURITY]` prefix\n2. For critical: email first, issue after fix\n3. Include: steps to reproduce, impact, suggested fix\n\n### Rules\n- First reporter wins\n- Responsible disclosure required\n- Must not exploit on production\n\n---\n*Total RTC supply: 8.3M | RTC Reference Rate: 1 RTC = $0.10 USD*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/reactions","total_count":11,"+1":5,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":3,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/91437","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/91437/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/91437/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/91437/events","html_url":"https://github.com/Expensify/App/issues/91437","id":4503404099,"node_id":"I_k