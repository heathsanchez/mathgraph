user-attachments/assets/e6afe015-ce0d-413c-bd60-b5b81b5f38ee\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022061914342799802566\">https://www.upwork.com/jobs/~022061914342799802566</a></li>\n        <li>Upwork Job ID: 2061914342799802566</li>\n        <li>Last Price Increase: 2026-06-09</li>\n<li>Automatic offers: </li>\n<ul>\n<li>linhvovan29546 | Reviewer | 111774386</li>\n</ul></li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @mallenexpensify</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/92431/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/92431/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/iii123iii/Crystal-PDF/issues/3","repository_url":"https://api.github.com/repos/iii123iii/Crystal-PDF","labels_url":"https://api.github.com/repos/iii123iii/Crystal-PDF/issues/3/labels{/name}","comments_url":"https://api.github.com/repos/iii123iii/Crystal-PDF/issues/3/comments","events_url":"https://api.github.com/repos/iii123iii/Crystal-PDF/issues/3/events","html_url":"https://github.com/iii123iii/Crystal-PDF/issues/3","id":4821398111,"node_id":"I_kwDORxSOW88AAAABH2CyXw","number":3,"title":"Bug bounty 100 usd to whoever makes my landing page responsive for mobile","user":{"login":"iii123iii","id":117964666,"node_id":"U_kgDOBwf_eg","avatar_url":"https://avatars.githubusercontent.com/u/117964666?v=4","gravatar_id":"","url":"https://api.github.com/users/iii123iii","html_url":"https://github.com/iii123iii","followers_url":"https://api.github.com/users/iii123iii/followers","following