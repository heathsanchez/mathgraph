public","site_admin":false}],"milestone":null,"comments":55,"created_at":"2026-06-20T09:24:25Z","updated_at":"2026-07-07T03:24:29Z","closed_at":null,"assignee":{"login":"arosiclair","id":6833644,"node_id":"MDQ6VXNlcjY4MzM2NDQ=","avatar_url":"https://avatars.githubusercontent.com/u/6833644?v=4","gravatar_id":"","url":"https://api.github.com/users/arosiclair","html_url":"https://github.com/arosiclair","followers_url":"https://api.github.com/users/arosiclair/followers","following_url":"https://api.github.com/users/arosiclair/following{/other_user}","gists_url":"https://api.github.com/users/arosiclair/gists{/gist_id}","starred_url":"https://api.github.com/users/arosiclair/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arosiclair/subscriptions","organizations_url":"https://api.github.com/users/arosiclair/orgs","repos_url":"https://api.github.com/users/arosiclair/repos","events_url":"https://api.github.com/users/arosiclair/events{/privacy}","received_events_url":"https://api.github.com/users/arosiclair/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** v9.4.16-1\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/folder/13177079/test-cases/41237920\n**Email or phone of affected tester (no customers):** agexptest+pr190626c@gmail.com\n**Issue reported by:** Applause Internal Team\n**Bug source:** Regression TC Execution\n**Device used:** Windows 11/ Chrome, Samsung S23FE/ Android 16, iPhone 13 Mini/ iOS 26.3\n**App Component:** Workspace Settings\n\n## Action Performed:\n1. Navigate to staging.new.expensify.com\n2. Sign up with a new Gmail account\n3. Select any onboarding intent except the Manage my team's expenses \n4. Create new workspace\n5. Navigate to Workspace Settings > More Features\n6. Enable the Travel feature toggle\n7. Click on the Travel menu option > Let's Go\n\n## Expected Result:\nThe \"Book travel\" RHP is displayed with the following message: \"You'll need to use your work email (e.g., name@company.com) with Expensify Travel, not your personal email (e.g., name@gmail.com).\"\n\n## Actual Result:\nThe \"What's your legal name?\" RHP is displayed.\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [x] Android: App\n- [ ] Android: mWeb Chrome\n- [x] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [x] MacOS: Chrome Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/7ca7f96e-2728-42b1-8e6c-e3c16ff00b3f\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n\n> **Applause Internal Information**\n> Exported by: Nathan Lemma\n> Bug ID: 7185684\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022068264724712363497\">https://www.upwork.com/jobs/~022068264724712363497</a></li>\n        <li>Upwork Job ID: 2068264724712363497</li>\n        <li>Last Price Increase: 2026-06-20</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @mallenexpensify</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/94108/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocke