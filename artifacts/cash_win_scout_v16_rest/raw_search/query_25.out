.githubusercontent.com/u/10429707?v=4","gravatar_id":"","url":"https://api.github.com/users/lcn2","html_url":"https://github.com/lcn2","followers_url":"https://api.github.com/users/lcn2/followers","following_url":"https://api.github.com/users/lcn2/following{/other_user}","gists_url":"https://api.github.com/users/lcn2/gists{/gist_id}","starred_url":"https://api.github.com/users/lcn2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lcn2/subscriptions","organizations_url":"https://api.github.com/users/lcn2/orgs","repos_url":"https://api.github.com/users/lcn2/repos","events_url":"https://api.github.com/users/lcn2/events{/privacy}","received_events_url":"https://api.github.com/users/lcn2/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Due to the fact that we have another issue that has had a number of OT comments I think it might be good to have a new mostly OT thread here rather than clutter the one in the other repo more or the issue for jprint.\r\n\r\nI had the thought of suggesting you reopen the other one but there's a comment there I don't want to get lost that I hope you can finish replying to (you were doing it in parts) when things are less busy here. I also wanted to see if anything in particular occurs if one uses the same name (I rather doubt it will but it popped into my head anyway).\r\n\r\nFeel free to assign this to me even though it's not technically an issue that has to be resolved.","reactions":{"url":"https://api.github.com/repos/ioccc-src/mkiocccentry/issues/723/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ioccc-src/mkiocccentry/issues/723/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/viamin/paid/issues/2823","repository_url":"https://api.github.com/repos/viamin/paid","labels_url":"https://api.github.com/repos/viamin/paid/issues/2823/labels{/name}","comments_url":"https://api.github.com/repos/viamin/paid/issues/2823/comments","events_url":"https://api.github.com/repos/viamin/paid/issues/2823/events","html_url":"https://github.com/viamin/paid/issues/2823","id":4820498217,"node_id":"I_kwDOQ_VJgM8AAAABH1L3KQ","number":2823,"title":"Configuration profiles: hardening + posture coverage (RDR-044 Phase 3)","user":{"login":"viamin","id":260794,"node_id":"MDQ6VXNlcjI2MDc5NA==","avatar_url":"https://avatars.githubusercontent.com/u/260794?v=4","gravatar_id":"","url":"https://api.github.com/users/viamin","html_url":"https://github.com/viamin","followers_url":"https://api.github.com/users/viamin/followers","following_url":"https://api.github.com/users/viamin/following{/other_user}","gists_url":"https://api.github.com/users/viamin/gists{/gist_id}","starred_url":"https://api.github.com/users/viamin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/viamin/subscriptions","organizations_url":"https://api.github.com/users/viamin/orgs","repos_url":"https://api.github.com/users/viamin/repos","events_url":"https://api.github.com/users/viamin/events{/privacy}","received_events_url":"https://api.github.com/users/viamin/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10046397520,"node_id":"LA_kwDOQ_VJgM8AAAACVs_cUA","url":"https://api.github.com/repos/viamin/paid/labels/enhancement","name":"enhancement","color":"a2eeef","default":true,"description":"New feature or request"},{"id":10329814744,"node_id":"LA_kwDOQ_VJgM8AAAACZ7R22A","url":"https://api.github.com/repos/viamin/paid/labels/agents","name":"agents","color":"1D76DB","default":false,"description":"Agent workflow integration"},{"id":10329814784,"node_id":"LA_kwDOQ_VJgM8AAAACZ7R3AA","url":"https://api.github.com/repos/viamin/paid/labels/security","name":"security","color":"B60205","default":false,"description":"Security, redaction, access control"},{"id":10633603685,"node_id":"LA_kwDOQ_VJgM8AAAACec_qZQ","url":"https://api.github.com/repos/viamin/paid/labels/P2","name":"P2","color":"2d57e4","default":false,"description":""}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-07-06T15:15:26Z","updated_at":"2026-07-06T23:24:09Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Part of #2820. Implements **Phase 3** of [RDR-044](docs/rdrs/RDR-044-configuration-profiles-chat.md).\n\nDepends on #2822.\n\n## Goal\n\nHarden the profile system and expand posture coverage so it stays coherent as Paid's settings surface evolves, and so users can introspect and reverse changes.\n\n## Scope\n\n1. **Drift regression guard** — a test asserting every profile covers the current set of operating-mode-relevant fields, so adding a new automation flag can't silently leave profiles stale.\n2. **\"What posture am I in?\"** — read-only reverse-engineering of the nearest profile from current settings (read-only `describe_current_posture`, or a nearest-match mode on `plan_*`), so the chat can answer posture questions.\n3. **Rollback helper** — reverse-apply using recorded activity entries (`Accounts::RecordActivity`) so a posture change can be undone.\n4. **Additional postures** as real usage emerges (e.g. `cost_capped_automated`, `quality_strict`).\n\n## Validation\n\n- Regression test passes against the live settings field set; fails loudly when a new mode-relevant flag lacks profile coverage.\n- Reverse-match + rollback unit/integration tests.\n\n## Notes\n\n- Keep `Plan`/`Change` generic so future batch operations (quality-gate bundle, cost-budget preset) can reuse the abstraction.\n- Account-level and `OrchestrationStrategy` write tools remain out of scope (admin/sensitive).","reactions":{"url":"https://api.github.com/repos/viamin/paid/issues/2823/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/viamin/paid/issues/2823/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/vamseeachanta/assethold/issues/59","repository_url":"https://api.github.com/repos/vamseeachanta/assethold","labels_url":"https://api.github.com/repos/vamseeachanta/assethold/issues/59/labels{/name}","comments_url":"https://api.github.com/repos/vamseeachanta/assethold/issues/59/comments","events_url":"https://api.github.com/repos/vamseeachanta/assethold/issues/59/events","html_url":"https://github.com/vamseeachanta/assethold/issues/59","id":4706586594,"node_id":"I_kwDOIWjGTs8AAAABGIjP4g","number":59,"title":"Pages demo: portfolio-strategy signals + real-estate underwriting (SYNTHETIC data only)","user":{"login":"vamseeachanta","id":23155845,"node_id":"MDQ6VXNlcjIzMTU1ODQ1","avatar_url":"https://avatars.githubusercontent.com/u/23155845?v=4","gravatar_id":"","url":"https://api.github.com/users/vamseeachanta","html_url":"https://github.com/vamseeachanta","followers_url":"https://api.github.com/users/vamseeachanta/followers","following_url":"https://api.github.com/users/vamseeachanta/following{/other_user}","gists_url":"https://api.github.com/users/vamseeachanta/gists{/gist_id}","starred_url":"https://api.github.com/users/vamseeachanta/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vamseeachanta/subscriptions","organizations_url":"https://api.github.com/users/vamseeachanta/orgs","repos_url":"https://api.github.com/users/vamseeachanta/repos","events_url":"https://api.github.com/users/vamseeachanta/events{/privacy}","received_events_url":"https://api.github.com/users/vamseeachanta/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10719847194,"node_id":"LA_kwDOIWjGTs8AAAACfvPjGg","url":"https://api.github.com/repos/vamseeachanta/assethold/labels/status:plan-approved","name":"status:plan-approved","color":"0E8A16","default":false,"description":"User approved plan; ready for implementation"},{"id":11193219182,"node_id":"LA_kwDOIWjGTs8AAAACmyr4bg","url":"https://api.github.com/repos/vamseeachanta/assethold/labels/lane:codex","name":"lane:codex","color":"0e8a16","default":false,"description":"Dispatch: Codex (bulk/deterministic/adversarial-review)"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2026-06-20T12:36:06Z","updated_at":"2026-07-06T23:03:19Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Part of ecosystem epic vamseeachanta/workspace-hub#3223.\n\n## Goal\nA GitHub Pages gallery of the analysis engines driven by synthetic/sample inputs — never personal financial data.\n\n## What to demonstrate (public-safe)\n- Daily Portfolio Strategy engine (weighted-composite Build/Hold/Trim: RSI/52-wk/SMA-50/SMA-200/insider/weight-drift), run on SAMPLE tickers (e.g. AAPL,MSFT,NVDA).\n- Stock fundamental/technical analysis + risk metrics (VaR/Sharpe/Beta), insider/institutional dashboards.\n- Real-estate underwriting: net-lease NN/NNN DCF + multifamily IRR/equity-multiple Plotly (client-data-free models).\n- Property timeline/GIS module (geocoding, change detection, KML).\n\n## Candidate outputs\n- Self-contained multifamily Plotly HTML already in-tree (`modules/multifamily/output/2020_CA_85_drs*.html`); daily-strategy demo regenerated from synthetic tickers; sample chart PNGs. mkdocs site already builds to `site/`.\n\n## Approach\n- Reuse the worldenergydata pattern: a generator renders FROZEN outputs; built site dir gitignored, regenerated in CI; committed frozen assets in `site_assets/`.\n- Provenance + \"data limits & honest caveats\" on every page; never fabricate.\n- Enable Pages (Settings → Pages → Source = GitHub Actions) — one-time, human.\n\n## ⚠️ Data safety (real personal data in-tree)\nMUST EXCLUDE from any public build: `reports/daily-strategy/2026-02-18.md` (real named brokerage accounts, share counts, **$723,894.71** portfolio, per-position cost basis), `reports/daily-strategy/history/signals.csv`, `config/daily_strategy.yaml` (Fidelity loader / employer plan), third-party PDFs. Build must read synthetic tickers + sample configs only; pre-publish leak-grep for dollar figures/account names. (net_lease model is explicitly client-data-free.)\n\n## Acceptance criteria\n- [ ] `reports/` + personal configs excluded; synthetic tickers only\n- [ ] Leak-grep guard passes\n- [ ] mkdocs build gains a deploy step; site reachable\n","reactions":{"url":"https://api.github.com/repos/vamseeachanta/assethold/issues/59/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vamseeachanta/assethold/issues/59/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/victor-hernandez-gft/skills-introduction-to-codeql/issues/1","repository_url":"https://api.github.com/repos/victor-hernandez-gft/skills-introduction-to-codeql","labels_url":"https://api.github.com/repos/victor-hernandez-gft/skills-introduction-to-codeql/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/victor-hernandez-gft/skills-introduction-to-codeql/issues/1/comments","events_url":"https://api.github.com/repos/victor-hernandez-gft/skills-introduction-to-codeql/issues/1/events","html_url":"https://github.com/victor-hernandez-gft/skills-introduction-to-codeql/issues/1","id":4823696294,"node_id":"I_kwDOTPuQ588AAAABH4PDpg","number":1,"title":"Exercise: Introduction to CodeQL","user":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":8,"created_at":"2026-07-06T22:53:37Z","updated_at":"2026-07-06T22:57:11Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Introduction to CodeQL\n\n<img alt=\"original github octocat\" src=\"https://octodex.github.com/images/original.png\" align=\"left\" height=\"80px\" />\n\n👋 Hey there @victor-hernandez-gft! Welcome to your Skills exercise!\n\nLearn to use CodeQL to find security vulnerabilities in your code.\n\n---\n\n✨ **This is an interactive, hands-on GitHub Skills exercise!**\n\nAs you complete each step, I’ll leave updates in the comments:\n\n- ✅ Check your work and guide you forward\n- 💡 Share helpful tips and resources\n- 🚀 Celebrate your progress and completion\n\nLet’s get started - good luck and have fun!\n\n<sub>— Mona</sub>\n> <sub> If you encounter any issues along the way please report them [here](https://github.com/skills/introduction-to-codeql/issues).</sub>","reactions":{"url":"https://api.github.com/repos/victor-hernandez-gft/skills-introduction-to-codeql/issues/1/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/victor-hernandez-gft/skills-introduction-to-codeql/issues/1/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/stuff4ai/adrman/issues/47","repository_url":"https://api.github.com/repos/stuff4ai/adrman","labels_url":"https://api.github.com/repos/stuff4ai/adrman/issues/47/labels{/name}","comments_url":"https://api.github.com/repos/stuff4ai/adrman/issues/47/comments","events_url":"https://api.github.com/repos/stuff4ai/adrman/issues/47/events","html_url":"https://github.com/stuff4ai/adrman/issues/47","id":4823650496,"node_id":"I_kwDOTHhQ0M8AAAABH4MQwA","number":47,"title":"Add CI report with test statistics and coverage","user":{"login":"alexengrig","id":36041152,"node_id":"MDQ6VXNlcjM2MDQxMTUy","avatar_url":"https://avatars.githubusercontent.com/u/36041152?v=4","gravatar_id":"","url":"https://api.github.com/users/alexengrig","html_url":"https://github.com/alexengrig","followers_url":"https://api.github.com/users/alexengrig/followers","following_url":"https://api.github.com/users/alexengrig/following{/other_user}","gists_url":"https://api.github.com/users/alexengrig/gists{/gist_id}","starred_url":"https://api.github.com/users/alexengrig/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alexengrig/subscriptions","organizations_url":"https://api.github.com/users/alexengrig/orgs","repos_url":"https://api.github.com/users/alexengrig/repos","events_url":"https://api.github.com/users/alexengrig/events{/privacy}","received_events_url":"https://api.github.com/users/alexengrig/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11359372908,"node_id":"LA_kwDOTHhQ0M8AAAACpRJGbA","url":"https://api.github.com/repos/stuff4ai/adrman/labels/enhancement","name":"enhancement","color":"a2eeef","default":true,"description":"New feature or request"},{"id":11438601182,"node_id":"LA_kwDOTHhQ0M8AAAACqcsz3g","url":"https://api.github.com/repos/stuff4ai/adrman/labels/ci","name":"ci","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-07-06T22:44:59Z","updated_at":"2026-07-06T22:44:59Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Summary\n\nAdd a GitHub-native CI report that makes workflow runs easier to review without requiring paid third-party services.\n\nThe report should summarize formatting, linting, tests, and coverage in a readable GitHub Actions job summary, and upload machine-readable artifacts for future automation.\n\n## Motivation\n\nadrman should have a polished but cheap CI experience. A generated report will help humans review pull requests and will also create structured outputs that future agents or automation can consume.\n\n## Requirements\n\n- Generate a Markdown report in GitHub Actions using `$GITHUB_STEP_SUMMARY`.\n- Include overall status for:\n  - formatting\n  - clippy\n  - tests\n  - coverage\n- Run Rust tests with `cargo-nextest`.\n- Generate test statistics from nextest output.\n- Generate JUnit test output.\n- Generate coverage with `cargo-llvm-cov`.\n- Upload useful artifacts:\n  - JUnit test report\n  - LCOV coverage report\n  - HTML coverage report\n  - coverage summary text\n- Keep the implementation cheap:\n  - no paid services\n  - no required external hosting\n  - no mandatory Codecov dependency\n- Make the report useful for both PR reviewers and future automation.\n\n## Suggested report sections\n\n- Overall CI result\n- Format result\n- Clippy result\n- Test statistics\n- Coverage summary\n- Links or references to uploaded artifacts\n- Optional slowest tests if easy to extract\n\n## Non-goals\n\n- Do not require Codecov.\n- Do not publish GitHub Pages.\n- Do not make coverage thresholds blocking in the first implementation.\n- Do not fail the build only because coverage is below a target yet.\n\n## Future work\n\n- Add coverage threshold enforcement.\n- Add PR coverage diff comments.\n- Add README badges.\n- Track coverage trends on the main branch.\n- Add richer report data for slow or flaky tests.","reactions":{"url":"https://api.github.com/repos/stuff4ai/adrman/issues/47/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/stuff4ai/adrman/issues/47/timeline","performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/openai/subscriptions","organizations_url":"https://api.github.com/users/openai/orgs","repos_url":"https://api.github.com/users/openai/repos","events_url":"https://api.github.com/users/openai/events{/privacy}","received_events_url":"https://api.github.com/users/openai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"ChatGPT Codex Connector","description":"Bring ChatGPT and Codex to your GitHub repositories.","external_url":"https://www.chatgpt.com","html_url":"https://github.com/apps/chatgpt-codex-connector","created_at":"2025-02-14T01:37:05Z","updated_at":"2026-04-20T16:37:15Z","permissions":{"actions":"write","checks":"read","contents":"write","emails":"read","issues":"write","metadata":"read","pull_requests":"write","statuses":"read","workflows":"write"},"events":["check_run","check_suite","commit_comment","issues","issue_comment","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","repository","status","sub_issues"]},"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ZaxbyHub/opencode-swarm/issues/1737","repository_url":"https://api.github.com/repos/ZaxbyHub/opencode-swarm","labels_url":"https://api.github.com/repos/ZaxbyHub/opencode-swarm/issues/1737/labels{/name}","comments_url":"https://api.github.com/repos/ZaxbyHub/opencode-swarm/issues/1737/comments","events_url":"https://api.github.com/repos/ZaxbyHub/opencode-swarm/issues/1737/events","html_url":"https://github.com/ZaxbyHub/opencode-swarm/issues/1737","id":4823629126,"node_id":"I_kwDORCfX8c8AAAABH4K9Rg","number":1737,"title":"Pay down remaining test quarantine debt + structural CI improvements to prevent recurrence","user":{"login":"zaxbysauce","id":10211642,"node_id":"MDQ6VXNlcjEwMjExNjQy","avatar_url":"https://avatars.githubusercontent.com/u/10211642?v=4","gravatar_id":"","url":"https://api.github.com/users/zaxbysauce","html_url":"https://github.com/zaxbysauce","followers_url":"https://api.github.com/users/zaxbysauce/followers","following_url":"https://api.github.com/users/zaxbysauce/following{/other_user}","gists_url":"https://api.github.com/users/zaxbysauce/gists{/gist_id}","starred_url":"https://api.github.com/users/zaxbysauce/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zaxbysauce/subscriptions","organizations_url":"https://api.github.com/users/zaxbysauce/orgs","repos_url":"https://api.github.com/users/zaxbysauce/repos","events_url":"https://api.github.com/users/zaxbysauce/events{/privacy}","received_events_url":"https://api.github.com/users/zaxbysauce/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-07-06T22:40:35Z","updated_at":"2026-07-06T22:40:35Z","closed_at":null,"assignee":null,"author_association":"COLLABORATOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Context\n\nPR #1730 (issue #1729) paid down the bulk of the CI quarantine debt — fixing the production `save_plan` projection bug, resolving ~40 cross-platform test failures, and driving 3 of 4 quarantine lists to zero. However, **11 entries remain across 3 lists**, and the effort exposed systemic gaps that allowed the debt to accumulate undetected for months. This issue tracks both the remaining debt and the structural fixes needed to prevent recurrence.\n\n## Current quarantine state (on main post-#1730)\n\n| List | Active entries | Root cause category |\n|---|---|---|\n| quarantined-tests.txt | 5 | Knowledge-system test failures (pre-existing, unrelated to #1729) |\n| quarantined-tests-macos.txt | 4 | Lean-turbo worktree provisioning — macOS-only lane mock issue |\n| quarantined-tests-windows.txt | 0 | Clean |\n| quarantined-integration-tests.txt | 2 | Ubuntu CI-only: read-only fs semantics + injection-budget shared-state |\n\n---\n\n## Part A — Diagnose and fix the 11 remaining quarantined tests\n\n### A1. macOS lean-turbo worktree tests (4 files)\n\n**Files:**\n```\ntests/unit/turbo/lean/integration-worktree.test.ts\ntests/unit/turbo/lean/runner.test.ts\ntests/unit/turbo/lean/runner.adversarial.test.ts\ntests/unit/turbo/lean/retroactive-adversarial.test.ts\n```\n\n**Failure signature (from merge_group run 28806176287):**\n```\nexpect(received).toBeGreaterThan(expected)\nExpected: > 0\nReceived: 0\n```\nThe tests mock `provisionWorktree` via `_internals.bunSpawn` and assert it was called at least 1 time during `runPhase`. On macOS it's called **0 times** — `runPhase` takes a different code path. These tests pass on ubuntu and Windows.\n\n**Suspected root causes to investigate:**\n- `checkPathBudget` (src/worktree/core.ts:326) may behave differently on macOS, changing the provisioning path. It's Windows-only in intent but may short-circuit on non-Windows in an unexpected way.\n- `git worktree add` porcelain output format or branch creation semantics may differ on the macOS runner's git version, causing the mock to not match.\n- A race condition that only manifests on the macOS runner's slower I/O — the `provisionWorktree` call may be async and the mock may not be installed by the time it runs.\n- The tests construct lane evidence files that feed `listLaneEvidence`; the sort added in #1730 made ordering deterministic, but the mock setup may still depend on filesystem timing.\n\n**Blocker:** requires macOS environment access (or detailed merge_group log analysis across multiple runs). Cannot be diagnosed on Linux or Windows.\n\n**Validation:** merge_group run with `unit (macos-latest, N)` all 4 shards passing these files.\n\n### A2. Integration tests — ubuntu CI-only (2 files)\n\n**Files:**\n```\ntests/integration/phase-complete-events.adversarial.test.ts\ntests/integration/unified-injection-budget.test.ts\n```\n\n#### A2a. phase-complete-events.adversarial.test.ts:393 — read-only .swarm directory\n\n**Failure signature:**\n```\nexpect(parsed.success).toBe(true)\nExpected: true\nReceived: false\n```\nThe test makes `.swarm` read-only via `chmod 444` and expects `phase_complete` to still succeed (write failure should be non-blocking). On the ubuntu CI runner, `success` is `false`. Passes on Windows and macOS.\n\n**Suspected root cause:** the ubuntu runner's uid/fs semantics — the runner user may be root (which bypasses read-only permissions), OR the `chmod 444` on `.swarm` doesn't prevent the specific write path the way the test expects. The test should use a more robust read-only simulation (e.g. `chmod 555` on the parent, or mock the write).\n\n#### A2b. unified-injection-budget.test.ts:312 — SC-005 (Production bug #2)\n\n**Failure signature:**\n```\nexpect(kiInjected).toBeUndefined()\nReceived: { info: { role: \"system\" }, parts: [{ type: \"text\", text: \"[[KNOWLEDGE-INJECTED]]...\" }] }\n```\nWhen `system-enhancer` alone exceeds the unified injection ceiling, `knowledge-injector` should get **0** allocation and not inject. But it still injects on the ubuntu CI runner. This is the **real Production bug #2** from issue #1729 section 3.4.\n\n**Critical note:** this test passes in isolation on Windows and in a clean `origin/main` worktree. It only fails in the ubuntu CI merge_group environment. The suspected cause is **test-ordering/shared-state contamination** — `getSystemEnhancerDemand(sessionID)` reads from a session-keyed map that may not be populated correctly when tests run in a specific order, or the session ID isn't unique between tests.\n\n**Source locations to investigate:**\n- src/hooks/knowledge-injector.ts:707-712 — `allocateInjectionBudget(seDemand, effectiveBudget, ...)` call\n- src/hooks/system-enhancer.ts:684-691, 1645-1651, 2479-2485 — `resetUnifiedBudget` / demand recording\n- Determine whether SE demand is actually recorded for the session before KI reads it in this test flow\n\n**This may be a real production bug** (not just a test issue): if SE demand isn't recorded under certain session lifecycles, KI would inject beyond the unified budget in production too.\n\n### A3. Base quarantine — knowledge-system tests (5 files, pre-existing)\n\n**Files:**\n```\ntests/unit/commands/cleanup-drift.test.ts\ntests/unit/commands/knowledge.adversarial.test.ts\ntests/unit/hooks/knowledge-injector-drift-adversarial.test.ts\ntests/unit/hooks/knowledge-floor-action.test.ts\ntests/unit/tools/knowledge-recall.test.ts\n```\n\nThese were quarantined before/during the #1729 effort (commits a5879ccb, f491360a) and are unrelated to the cross-platform work. They're knowledge-system failures likely related to the #1716/#1717 knowledge lifecycle changes. Triage separately — they may already be fixed by the knowledge PRs that landed (#1722, #1727, #1730's merge brought those in).\n\n---\n\n## Part B — Structural CI improvements to prevent recurrence\n\nThe #1729 effort took ~10 merge_group bounces over 2 days because the `pull_request` CI tier is ubuntu-only and cannot surface macOS/Windows/integration/coverage failures. These improvements would have caught every bounce before queuing:\n\n### B1. Shared canonicalTmpDir() test helper + lint enforcement\n\n~20 test files were individually fixed with `fs.realpathSync(os.tmpdir())` for the macOS /var to /private/var symlink. Without a shared helper, new tests will reintroduce the bug.\n\n- Create `tests/helpers/tmpdir.ts` exporting `canonicalTmpDir()` and `canonicalMkdtemp(prefix)`.\n- Add `scripts/check-test-tmpdir.sh` (modeled on `check-mock-cleanup.sh`) that flags raw `os.tmpdir()` / `mkdtemp` usage in test files without the realpath wrap.\n- Wire into the `quality` CI job.\n\n### B2. Bash portability lint for scripts/\n\n`check-invariants.sh` used `declare -A` (bash 4+) which silently died on macOS bash 3.2 for months. A lint script would catch this class of failure:\n\n- Create `scripts/check-bash-portability.sh` that flags bash-4+ constructs: `declare -A`, associative-array subscript syntax, `grep -P`, hex escapes like `\\x27`, `coproc`, `mapfile`/`readarray`.\n- Wire into the `quality` CI job.\n\n### B3. Cross-OS PR-tier validation (the biggest gap)\n\nThe root cause of the entire backlog: `pull_request` CI runs ubuntu-only, so macOS/Windows-only failures are invisible until the merge queue bounces them.\n\n**Option A — workflow_dispatch full-matrix trigger:** add a `workflow_dispatch` trigger to ci.yml that lets PR authors manually trigger the full 3-OS matrix + integration + coverage on their branch before queuing. Cost: GitHub Action minutes, but prevents queue bounces.\n\n**Option B — \"platform-sensitive\" path filter:** run macOS + Windows unit shards on `pull_request` only when the diff touches platform-sensitive paths (src/worktree/**, src/sandbox/**, src/plan/**, scripts/**, .github/workflows/**). Use a `paths` filter or a `dorny/paths-filter` action.\n\n**Option C — Previously-quarantined smoke job:** add a fast `pull_request` job that runs just the previously-quarantined files on all 3 OSes (a small subset, not the full 4-shard suite). This catches regressions in the files most likely to have cross-platform issues without the full cost.\n\n### B4. Coverage-gate docs reconciliation\n\nCoverage is already a required check (ruleset 17809658, added 2026-06-30), but the ci.yml comment at ~L245-249 still says \"must happen AFTER this lands on main.\" Update the comment to reflect that coverage is enforced.\n\n---\n\n## Recommended order of attack\n\n1. **A3** (base quarantine, 5 knowledge tests) — re-triage each; may already pass after the knowledge PRs merged. Lowest effort, highest chance of quick wins.\n2. **B1 + B2** (shared helper + bash lint) — quick to implement, prevents the most common recurrence patterns. ~2-3 hrs each.\n3. **A2b** (injection budget SC-005) — likely a real production bug. Reproduce by running the test file in the same bun process as the other integration tests (simulate the CI ordering). ~2-4 hrs.\n4. **A2a** (read-only .swarm) — fix the read-only simulation to be uid-independent. ~1 hr.\n5. **B3** (cross-OS PR-tier validation) — the systemic fix. ~3-5 hrs depending on option chosen.\n6. **A1** (macOS lean worktree) — blocked on macOS access. ~2-4 hrs with a Mac.\n\n## Definition of done\n\n- [ ] All 4 quarantine lists at 0 active entries\n- [ ] B1 (canonicalTmpdir helper + lint) implemented and wired into CI\n- [ ] B2 (bash portability lint) implemented and wired into CI\n- [ ] B3 (cross-OS PR-tier validation) implemented — at minimum Option A or C\n- [ ] B4 (coverage docs reconciled)\n- [ ] No test is green-by-not-running (verified by checking all 4 lists return empty for non-comment lines)\n\n## Related\n\n- Closes the residual debt from #1729 (PR #1730).\n- Supersedes the quarantine tracking in #1705 (now closed).\n- A2b traces to #1729 section 3.4 \"Production bug #2\" (unified injection budget).\n","reactions":{"url":"https://api.github.com/repos/ZaxbyHub/opencode-swarm/issues/1737/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ZaxbyHub/opencode-swarm/issues/1737/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/82191","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/82191/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/82191/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/82191/events","html_url":"https://github.com/Expensify/App/issues/82191","id":3928611594,"node_id":"I_kwDOEQqHYc7qKdsK","number":82191,"title":"Migrate useSearchSelector.base.ts from useOptionsList to useFilteredOptions","user":{"login":"mountiny","id":36083550,"node_id":"MDQ6VXNlcjM2MDgzNTUw","avatar_url":"https://avatars.githubusercontent.com/u/36083550?v=4","gravatar_id":"","url":"https://api.github.com/users/mountiny","html_url":"https://github.com/mountiny","followers_url":"https://api.github.com/users/mountiny/followers","following_url":"https://api.github.com/users/mountiny/following{/other_user}","gists_url":"https://api.github.com/users/mountiny/gists{/gist_id}","starred_url":"https://api.github.com/users/mountiny/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mountiny/subscriptions","organizations_url":"https://api.github.com/users/mountiny/orgs","repos_url":"https://api.github.com/users/mountiny/repos","events_url":"https://api.github.com/users/mountiny/events{/privacy}","received_events_url":"https://api.github.com/users/mountiny/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":2893455829,"node_id":"MDU6TGFiZWwyODkzNDU1ODI5","url":"https://api.github.com/repos/Expensify/App/labels/Daily","name":"Daily","color":"eb6420","default":false,"description":"KSv2"},{"id":3172234733,"node_id":"MDU6TGFiZWwzMTcyMjM0NzMz","url":"https://api.github.com/repos/Expensify/App/labels/Task","name":"Task","color":"ededed","default":false,"description":null},{"id":3184150925,"node_id":"MDU6TGFiZWwzMTg0MTUwOTI1","url":"https://api.github.com/repos/Expensify/App/labels/Overdue","name":"Overdue","color":"D93F0B","default":false,"description":""},{"id":11258940365,"node_id":"LA_kwDOEQqHYc8AAAACnxXLzQ","url":"https://api.github.com/repos/Expensify/App/labels/Skip%20Payment","name":"Skip Payment","color":"6028c6","default":false,"description":"Skips all the payment process steps for an issue. Use it for fixed-price projects."}],"state":"open","locked":false,"assignees":[{"login":"hoangzinh","id":9639873,"node_id":"MDQ6VXNlcjk2Mzk4NzM=","avatar_url":"https://avatars.githubusercontent.com/u/9639873?v=4","gravatar_id":"","url":"https://api.github.com/users/hoangzinh","html_url":"https://github.com/hoangzinh","followers_url":"https://api.github.com/users/hoangzinh/followers","following_url":"https://api.github.com/users/hoangzinh/following{/other_user}","gists_url":"https://api.github.com/users/hoangzinh/gists{/gist_id}","starred_url":"https://api.github.com/users/hoangzinh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hoangzinh/subscriptions","organizations_url":"https://api.github.com/users/hoangzinh/orgs","repos_url":"https://api.github.com/users/hoangzinh/repos","events_url":"https://api.github.com/users/hoangzinh/events{/privacy}","received_events_url":"https://api.github.com/users/hoangzinh/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"mountiny","id":36083550,"node_id":"MDQ6VXNlcjM2MDgzNTUw","avatar_url":"https://avatars.githubusercontent.com/u/36083550?v=4","gravatar_id":"","url":"https://api.github.com/users/mountiny","html_url":"https://github.com/mountiny","followers_url":"https://api.github.com/users/mountiny/followers","following_url":"https://api.github.com/users/mountiny/following{/other_user}","gists_url":"https://api.github.com/users/mountiny/gists{/gist_id}","starred_url":"https://api.github.com/users/mountiny/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mountiny/subscriptions","organizations_url":"https://api.github.com/users/mountiny/orgs","repos_url":"https://api.github.com/users/mountiny/repos","events_url":"https://api.github.com/users/mountiny/events{/privacy}","received_events_url":"https://api.github.com/users/mountiny/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"shubham1206agra","id":58412969,"node_id":"MDQ6VXNlcjU4NDEyOTY5","avatar_url":"https://avatars.githubusercontent.com/u/58412969?v=4","gravatar_id":"","url":"https://api.github.com/users/shubham1206agra","html_url":"https://github.com/shubham1206agra","followers_url":"https://api.github.com/users/shubham1206agra/followers","following_url":"https://api.github.com/users/shubham1206agra/following{/other_user}","gists_url":"https://api.github.com/users/shubham1206agra/gists{/gist_id}","starred_url":"https://api.github.com/users/shubham1206agra/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shubham1206agra/subscriptions","organizations_url":"https://api.github.com/users/shubham1206agra/orgs","repos_url":"https://api.github.com/users/shubham1206agra/repos","events_url":"https://api.github.com/users/shubham1206agra/events{/privacy}","received_events_url":"https://api.github.com/users/shubham1206agra/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":56,"created_at":"2026-02-11T20:41:35Z","updated_at":"2026-07-06T22:39:53Z","closed_at":null,"assignee":{"login":"hoangzinh","id":9639873,"node_id":"MDQ6VXNlcjk2Mzk4NzM=","avatar_url":"https://avatars.githubusercontent.com/u/9639873?v=4","gravatar_id":"","url":"https://api.github.com/users/hoangzinh","html_url":"https://github.com/hoangzinh","followers_url":"https://api.github.com/users/hoangzinh/followers","following_url":"https://api.github.com/users/hoangzinh/following{/other_user}","gists_url":"https://api.github.com/users/hoangzinh/gists{/gist_id}","starred_url":"https://api.github.com/users/hoangzinh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hoangzinh/subscriptions","organizations_url":"https://api.github.com/users/hoangzinh/orgs","repos_url":"https://api.github.com/users/hoangzinh/repos","events_url":"https://api.github.com/users/hoangzinh/events{/privacy}","received_events_url":"https://api.github.com/users/hoangzinh/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"parent_issue_url":"https://api.github.com/repos/Expensify/App/issues/82193","issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Problem\n\n`useSearchSelector.base.ts` currently uses the `useOptionsList` hook from `OptionListContextProvider`, which causes unnecessary background recalculations on every personal details or reports change.\n\nThis is part of a larger effort to remove `OptionListContextProvider` entirely. See parent issue #82193 for full context.\n\n## Solution\n\nReplace `useOptionsList` with `useFilteredOptions` following the pattern established in PR #74071 (NewChatPage migration).\n\n**Current usage:**\n- Properties used: `options` (as `defaultOptions`), `areOptionsInitialized`\n- Called with: `{ shouldInitialize }` (from hook config, defaults to true)\n- File: `src/hooks/useSearchSelector.base.ts`\n\n**How options are used:**\n- `options` (renamed to `defaultOptions`) is merged with `contactOptions` into `optionsWithContacts`\n- Used as base for `baseOptions` in switch on `searchContext` (via `getSearchOptions` or `getValidOptions`)\n- `areOptionsInitialized` guards `optionsWithContacts` and `baseOptions` computation\n- `areOptionsInitialized` is exposed in the return value for consumers\n\n**High-impact migration:** This is a shared base hook used indirectly by approximately 10 screens:\n- VacationDelegatePage\n- MoneyRequestParticipantsSelector\n- MoneyRequestAttendeeSelector\n- BaseOnboardingWorkspaceInvite\n- WorkspaceInvitePage\n- InviteReportParticipantsPage\n- AssigneeStep (Expensify Card)\n- AssigneeStep (Company Cards)\n- TaskAssigneeSelectorModal\n- BaseShareLogList\n\nMigrating this hook automatically benefits all these indirect consumers.\n\n**Migration steps:**\n1. Replace `import {useOptionsList} from '@components/OptionListContextProvider'` with `import useFilteredOptions from '@hooks/useFilteredOptions'`\n2. Replace `useOptionsList({ shouldInitialize })` with `useFilteredOptions({ enabled: shouldInitialize })` (or a similar mapping)\n3. Replace `areOptionsInitialized` with `!isLoading` (or `options !== null`)\n4. Update `optionsWithContacts` and `baseOptions` guards accordingly\n5. Update the return value to expose the new loading semantics\n6. Verify all ~10 indirect consumers still work correctly\n\n**Complexity:** Medium (high-impact due to ~10 indirect consumers)\n\n**Reference PR:** https://github.com/Expensify/App/pull/74071\n\n## Tests\n\n- Verify search selector works across all screens that use `useSearchSelector`:\n  - MoneyRequestParticipantsSelector (create expense > select participant)\n  - WorkspaceInvitePage (workspace settings > invite members)\n  - InviteReportParticipantsPage (report > invite participants)\n  - TaskAssigneeSelectorModal (assign a task)\n  - VacationDelegatePage (vacation delegate selection)\n  - And other indirect consumers listed above\n- Verify loading placeholders show correctly while options compute\n- Verify search/filter functionality works in each context\n- Verify no errors appear in the JS console\n- Test on all platforms (iOS, Android, Web, Desktop)\n\n\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @hoangzinh</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/82191/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/82191/timeline","performed_via_github_app":null,"state_reason":"reopened","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/76696","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/76696/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/76696/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/76696/events","html_url":"https://github.com/Expensify/App/issues/76696","id":3693182648,"node_id":"I_kwDOEQqHYc7cIX64","number":76696,"title":"Refactor ConfirmModal usage to useConfirmModal in various components, hooks, and providers","user":{"login":"roryabraham","id":47436092,"node_id":"MDQ6VXNlcjQ3NDM2MDky","avatar_url":"https://avatars.githubusercontent.com/u/47436092?v=4","gravatar_id":"","url":"https://api.github.com/users/roryabraham","html_url":"https://github.com/roryabraham","followers_url":"https://api.github.com/users/roryabraham/followers","following_url":"https://api.github.com/users/roryabraham/following{/other_user}","gists_url":"https://api.github.com/users/roryabraham/gists{/gist_id}","starred_url":"https://api.github.com/users/roryabraham/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/roryabraham/subscriptions","organizations_url":"https://api.github.com/users/roryabraham/orgs","repos_url":"https://api.github.com/users/roryabraham/repos","events_url":"https://api.github.com/users/roryabraham/events{/privacy}","received_events_url":"https://api.github.com/users/roryabraham/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893515375,"node_id":"MDU6TGFiZWwyODkzNTE1Mzc1","url":"https://api.github.com/repos/Expensify/App/labels/Weekly","name":"Weekly","color":"009800","default":false,"description":"KSv2"},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"waterim","id":39777589,"node_id":"MDQ6VXNlcjM5Nzc3NTg5","avatar_url":"https://avatars.githubusercontent.com/u/39777589?v=4","gravatar_id":"","url":"https://api.github.com/users/waterim","html_url":"https://github.com/waterim","followers_url":"https://api.github.com/users/waterim/followers","following_url":"https://api.github.com/users/waterim/following{/other_user}","gists_url":"https://api.github.com/users/waterim/gists{/gist_id}","starred_url":"https://api.github.com/users/waterim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/waterim/subscriptions","organizations_url":"https://api.github.com/users/waterim/orgs","repos_url":"https://api.github.com/users/waterim/repos","events_url":"https://api.github.com/users/waterim/events{/privacy}","received_events_url":"https://api.github.com/users/waterim/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"roryabraham","id":47436092,"node_id":"MDQ6VXNlcjQ3NDM2MDky","avatar_url":"https://avatars.githubusercontent.com/u/47436092?v=4","gravatar_id":"","url":"https://api.github.com/users/roryabraham","html_url":"https://github.com/roryabraham","followers_url":"https://api.github.com/users/roryabraham/followers","following_url":"https://api.github.com/users/roryabraham/following{/other_user}","gists_url":"https://api.github.com/users/roryabraham/gists{/gist_id}","starred_url":"https://api.github.com/users/roryabraham/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/roryabraham/subscriptions","organizations_url":"https://api.github.com/users/roryabraham/orgs","repos_url":"https://api.github.com/users/roryabraham/repos","events_url":"https://api.github.com/users/roryabraham/events{/privacy}","received_events_url":"https://api.github.com/users/roryabraham/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"dylanexpensify","id":60117248,"node_id":"MDQ6