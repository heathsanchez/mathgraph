b.com/users/abdulrahuman5196/events{/privacy}","received_events_url":"https://api.github.com/users/abdulrahuman5196/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":45,"created_at":"2026-05-12T05:34:45Z","updated_at":"2026-07-06T21:54:38Z","closed_at":null,"assignee":{"login":"MelvinBot","id":12432488,"node_id":"MDQ6VXNlcjEyNDMyNDg4","avatar_url":"https://avatars.githubusercontent.com/u/12432488?v=4","gravatar_id":"","url":"https://api.github.com/users/MelvinBot","html_url":"https://github.com/MelvinBot","followers_url":"https://api.github.com/users/MelvinBot/followers","following_url":"https://api.github.com/users/MelvinBot/following{/other_user}","gists_url":"https://api.github.com/users/MelvinBot/gists{/gist_id}","starred_url":"https://api.github.com/users/MelvinBot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MelvinBot/subscriptions","organizations_url":"https://api.github.com/users/MelvinBot/orgs","repos_url":"https://api.github.com/users/MelvinBot/repos","events_url":"https://api.github.com/users/MelvinBot/events{/privacy}","received_events_url":"https://api.github.com/users/MelvinBot/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** 9.3.70-1\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** N/A - new feature, doesn't exist in prod\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://github.com/Expensify/App/pull/88752\n**Email or phone of affected tester (no customers):** ibellicotest+2250@gmail.com\n**Issue reported by:** Applause Internal Team\n**Bug source:** Exploratory - Significant User Experience Deterioration\n**Device used:** Motorola MotoG60 / Android 12 (Hybrid app) - Windows 11 / Chrome\n**App Component:** Search\n\n## Action Performed:\nPrerequisite: User is owner of at least one track-intent workspace with at least one invited member.\n1. Open the staging.new.expensify.com\n2. Create a manual expense with date from last month and submit it to any individual chat.\n3. Navigate to \"Spend\" > \"Top Spenders\"\n4. Note that the just created expense is visible despite not being part of a workspace.\n\n## Expected Result:\nOnly expenses from workspaces with members should be visible on \"Top Spenders\" section.\n\n## Actual Result:\nAn expense submitted to an individual chat, can be found on \"Top Spenders\" section, despite not being part of a workspace.\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [x] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [ ] MacOS: Chrome / Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/e2875c74-52a0-46e4-9372-a328e8bd1cf9\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @MonilBhavsar</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/90294/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/90294/timeline","performed_via_github_app":null,"state_reason":"reopened","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/89442","repositor