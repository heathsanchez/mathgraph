ult":false,"description":"Auto-added when associated PR is deployed to production"},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"mallenexpensify","id":22508304,"node_id":"MDQ6VXNlcjIyNTA4MzA0","avatar_url":"https://avatars.githubusercontent.com/u/22508304?v=4","gravatar_id":"","url":"https://api.github.com/users/mallenexpensify","html_url":"https://github.com/mallenexpensify","followers_url":"https://api.github.com/users/mallenexpensify/followers","following_url":"https://api.github.com/users/mallenexpensify/following{/other_user}","gists_url":"https://api.github.com/users/mallenexpensify/gists{/gist_id}","starred_url":"https://api.github.com/users/mallenexpensify/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mallenexpensify/subscriptions","organizations_url":"https://api.github.com/users/mallenexpensify/orgs","repos_url":"https://api.github.com/users/mallenexpensify/repos","events_url":"https://api.github.com/users/mallenexpensify/events{/privacy}","received_events_url":"https://api.github.com/users/mallenexpensify/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"stitesExpensify","id":42391420,"node_id":"MDQ6VXNlcjQyMzkxNDIw","avatar_url":"https://avatars.githubusercontent.com/u/42391420?v=4","gravatar_id":"","url":"https://api.github.com/users/stitesExpensify","html_url":"https://github.com/stitesExpensify","followers_url":"https://api.github.com/users/stitesExpensify/followers","following_url":"https://api.github.com/users/stitesExpensify/following{/other_user}","gists_url":"https://api.github.com/users/stitesExpensify/gists{/gist_id}","starred_url":"https://api.github.com/users/stitesExpensify/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com