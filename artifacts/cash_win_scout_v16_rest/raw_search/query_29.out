}","subscriptions_url":"https://api.github.com/users/lanitochka17/subscriptions","organizations_url":"https://api.github.com/users/lanitochka17/orgs","repos_url":"https://api.github.com/users/lanitochka17/repos","events_url":"https://api.github.com/users/lanitochka17/events{/privacy}","received_events_url":"https://api.github.com/users/lanitochka17/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893455829,"node_id":"MDU6TGFiZWwyODkzNDU1ODI5","url":"https://api.github.com/repos/Expensify/App/labels/Daily","name":"Daily","color":"eb6420","default":false,"description":"KSv2"},{"id":3136662525,"node_id":"MDU6TGFiZWwzMTM2NjYyNTI1","url":"https://api.github.com/repos/Expensify/App/labels/Help%20Wanted","name":"Help Wanted","color":"CFC8F1","default":false,"description":"Apply this label when an issue is open to proposals by contributors"},{"id":3184150925,"node_id":"MDU6TGFiZWwzMTg0MTUwOTI1","url":"https://api.github.com/repos/Expensify/App/labels/Overdue","name":"Overdue","color":"D93F0B","default":false,"description":""},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"DylanDylann","id":141406735,"node_id":"U_kgDOCG2yDw","avatar_url":"https://avatars.githubusercontent.com/u/141406735?v=4","gravatar_id":"","url":"https://api.github.com/users/DylanDylann","html_url":"https://github.com/DylanDylann","followers_url":"https://api.github.com/users/DylanDylann/followers","following_url":"https://api.github.com/users/DylanDylann/following{/other_user}","gists_url":"https://api.github.com/users/DylanDylann/gists{/gist_id}","starred_url":"https://api.github.com/users/DylanDylann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DylanDylann/subscriptions","organizations_url":"https://api.github.com/users/DylanDylann/orgs","repos_url":"https://api.github.com/users/DylanDylann/repos","events_url":"https://api.github.com/users/DylanDylann/events{/privacy}","received_events_url":"https://api.github.com/users/DylanDylann/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":40,"created_at":"2026-06-16T16:47:36Z","updated_at":"2026-07-07T04:32:43Z","closed_at":null,"assignee":{"login":"DylanDylann","id":141406735,"node_id":"U_kgDOCG2yDw","avatar_url":"https://avatars.githubusercontent.com/u/141406735?v=4","gravatar_id":"","url":"https://api.github.com/users/DylanDylann","html_url":"https://github.com/DylanDylann","followers_url":"https://api.github.com/users/DylanDylann/followers","following_url":"https://api.github.com/users/DylanDylann/following{/other_user}","gists_url":"https://api.github.com/users/DylanDylann/gists{/gist_id}","starred_url":"https://api.github.com/users/DylanDylann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DylanDylann/subscriptions","organizations_url":"https://api.github.com/users/DylanDylann/orgs","repos_url":"https://api.github.com/users/DylanDylann/repos","events_url":"https://api.github.com/users/DylanDylann/events{/privacy}","received_events_url":"https://api.github.com/users/DylanDylann/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** 9.4.7-4\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/folder/13176924/test-cases/41237569\n**Email or phone of affected tester (no customers):** utester+fullstory16061@gmail.com\n**Issue reported by:** Applause Internal Team\n**Bug source:** Regression TC Execution\n**Device used:** MacBook Air 26.5 Chrome, iPhone 15 iOS 26.5\n**App Component:** Other\n\n## Action Performed:\n1. Navigate to new.expensify.com (Production)\n2. Log in with a new account  (e.g utester+fullstory125@gmail.com)\n3. On the onboarding modal select \"Manage my teams expenses\" - 5-10 employees \n4. Do some actions in the app\n5. Close the tab or the app\n6. Navigate to app.fullstory.com\n7. Login with the applausetester@applause.expensifail.com credentials \n8. Click Search - Email is.. \n9. In the filter, enter the email you used in step 2\n10. The email is found, click on it, click Apply filters\n11. Verify the session is displayed\n\n## Expected Result:\nThe email is found and the session is available to watch\n\n## Actual Result:\n\"No matches found\" is shown in fullstory app for the account created on Prod\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [x] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [ ] MacOS: Chrome / Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/f0e9091d-7d1c-4bf3-b515-d4d085106051\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022066927053926040505\">https://www.upwork.com/jobs/~022066927053926040505</a></li>\n        <li>Upwork Job ID: 2066927053926040505</li>\n        <li>Last Price Increase: 2026-06-30</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/93730/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/93730/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743","repository_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty","labels_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743/labels{/name}","comments_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743/comments","events_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743/events","html_url":"https://github.com/SecureBananaLabs/bug-bounty/issues/743","id":4530092639,"node_id":"I_kwDOSfPzA88AAAABDgO6Xw","number":743,"title":"Low Handing Fruit Automation","user":{"login":"claim-reviewer","id":72201398,"node_id":"MDQ6VXNlcjcyMjAxMzk4","avatar_url":"https://avatars.githubusercontent.com/u/72201398?v=4","gravatar_id":"","url":"https://api.github.com/users/claim-reviewer","html_url":"https://github.com/claim-reviewer","followers_url":"https://api.github.com/users/claim-reviewer/followers","following_url":"https://api.github.com/users/claim-reviewer/following{/other_user}","gists_url":"https://api.github.com/users/claim-reviewer/gists{/gist_id}","starred_url":"https://api.github.com/users/claim-reviewer/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claim-reviewer/subscriptions","organizations_url":"https://api.github.com/users/claim-reviewer/orgs","repos_url":"https://api.github.com/users/claim-reviewer/repos","events_url":"https://api.github.com/users/claim-reviewer/events{/privacy}","received_events_url":"https://api.github.com/users/claim-reviewer/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10969608408,"node_id":"LA_kwDOSfPzA88AAAACjdbw2A","url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/labels/bug","name":"bug","color":"d73a4a","default":true,"description":"Something isn't working"},{"id":10969608412,"node_id":"LA_kwDOSfPzA88AAAACjdbw3A","url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/labels/documentation","name":"documentation","color":"0075ca","default":true,"description":"Improvements or additions to documentation"},{"id":10969608427,"node_id":"LA_kwDOSfPzA88AAAACjdbw6w","url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10969608431,"node_id":"LA_kwDOSfPzA88AAAACjdbw7w","url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed"},{"id":10969735624,"node_id":"LA_kwDOSfPzA88AAAACjdjhyA","url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/labels/bug%20bounty","name":"bug bounty","color":"0e8a16","default":false,"description":""},{"id":10970651882,"node_id":"LA_kwDOSfPzA88AAAACjebc6g","url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/labels/AI%20agent%20friendly","name":"AI agent friendly","color":"e69469","default":false,"description":""},{"id":10970655211,"node_id":"LA_kwDOSfPzA88AAAACjebp6w","url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/labels/bounty","name":"bounty","color":"cafa53","default":false,"description":""},{"id":10970820972,"node_id":"LA_kwDOSfPzA88AAAACjelxbA","url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/labels/%F0%9F%92%8E%20Bounty","name":"💎 Bounty","color":"ededed","default":false,"description":null},{"id":11064514169,"node_id":"LA_kwDOSfPzA88AAAACk38WeQ","url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/labels/$700","name":"$700","color":"34d399","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1377,"created_at":"2026-05-27T06:32:39Z","updated_at":"2026-07-07T04:15:08Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Automate Low Hanging fruit bug detection and issue creation recursively.\n\nThis issue is an issue focused on creating more issues:\n1. Find a feature/bug to work on from this repository\n2. Create a GitHub issue on the repository to start working on it -- Pull requests without issues will not be considered.\n3. Use the following string in the issue that you created: \"This issue is limited only to the creator of this issue. This means that only the issue author can attempt to solve this issue. If you would like to work on it, please create another issue with the same contents and refer to issue #743 for more information.\"\n\nFollow all instructions carefully and precisely.\n\n/bounty $700\n\nBounties can only be paid upon successful PR merge.","reactions":{"url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/SecureBananaLabs/bug-bounty/issues/743/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2782","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2782/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2782/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2782/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2782","id":4195435600,"node_id":"I_kwDORGgqa876EURQ","number":2782,"title":"[ONBOARD: 1 RTC] Review an Open PR","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10360962887,"node_id":"LA_kwDORGgqa88AAAACaY-_Rw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/onboarding","name":"onboarding","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1358,"created_at":"2026-04-02T15:41:31Z","updated_at":"2026-07-07T03:16:00Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 2 RTC\n\n### What You'll Do\nHelp us review code. Every PR benefits from a second pair of eyes.\n\n### Steps\n1. **Pick any open PR** from [Rustchain](https://github.com/Scottcjn/Rustchain/pulls), [BoTTube](https://github.com/Scottcjn/bottube/pulls), or [rustchain-bounties](https://github.com/Scottcjn/rustchain-bounties/pulls)\n2. **Read the code changes** (click \"Files changed\" tab)\n3. **Leave a substantive review comment**. Examples:\n   - \"Line 42: this SQL query isn't parameterized, potential injection\"\n   - \"This function duplicates logic already in utils.py line 80\"\n   - \"Missing error handling if the API returns non-200\"\n   - \"Good approach, but the variable name should describe what it holds\"\n4. **Comment here** with a link to your review\n\n### What Counts\n- Review must be **technical and specific** (not \"looks good\" or \"nice work\")\n- Point to specific lines with specific observations\n- Positive observations count too (\"good use of context manager here\")\n- You don't need to be an expert. Asking good questions is reviewing.\n\n### Payment\n2 RTC once your review contains at least 2 substantive observations.\n\n**Difficulty**: Easy-Medium | **Time**: 20-40 min | **Skills**: Can read Python or JavaScript\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2782/reactions","total_count":12,"+1":6,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":3,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2782/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/71","id":3904303864,"node_id":"I_kwDORGgqa87otvL4","number":71,"title":"[BOUNTY] Ongoing Bug Bounty Program — Find Bugs, Earn RTC (133 RTC Pool)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029408,"node_id":"LA_kwDORGgqa88AAAACWucZoA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bug","name":"bug","color":"d73a4a","default":true,"description":"Something isn't working"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":432,"created_at":"2026-02-06T01:13:53Z","updated_at":"2026-07-07T02:47:44Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Ongoing Bug Bounty Program\n\n**Pool: 750 RTC (ongoing, replenished as needed)**\n\n### Severity & Rewards\n| Severity | Description | Reward |\n|----------|-------------|--------|\n| **Critical** | Fund theft, consensus bypass, RCE | 100-200 RTC |\n| **High** | Data leak, auth bypass, significant logic error | 50-100 RTC |\n| **Medium** | DoS, info disclosure, moderate bugs | 15-50 RTC |\n| **Low** | UI bugs, minor leaks, doc errors | 5-15 RTC |\n\n### In-Scope\n- RustChain node software, attestation & fingerprint system\n- Epoch settlement & rewards, wallet endpoints\n- BoTTube web app, API, payment system\n- Python SDK, Block Explorer, Wallet GUI, Miner clients\n\n### Reporting\n1. Create GitHub issue with `[SECURITY]` prefix\n2. For critical: email first, issue after fix\n3. Include: steps to reproduce, impact, suggested fix\n\n### Rules\n- First reporter wins\n- Responsible disclosure required\n- Must not exploit on production\n\n---\n*Total RTC supply: 8.3M | RTC Reference Rate: 1 RTC = $0.10 USD*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/reactions","total_count":11,"+1":5,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":3,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2819","id":4203177266,"node_id":"I_kwDORGgqa876h2Uy","number":2819,"title":"[BOUNTY] Red Team UTXO Implementation — Find Bugs, Earn RTC (33-133 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029422,"node_id":"LA_kwDORGgqa88AAAACWucZrg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10334947395,"node_id":"LA_kwDORGgqa88AAAACaALIQw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/security","name":"security","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":176,"created_at":"2026-04-04T03:03:17Z","updated_at":"2026-07-07T01:44:51Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Overview\n\nRustChain is migrating from an account-based balance model to a full UTXO (Unspent Transaction Output) model. **Phase 1+2 just landed** in [`39bf02b`](https://github.com/Scottcjn/Rustchain/commit/39bf02b).\n\nWe want adversarial eyes on this before enabling dual-write on production. Break it, get paid.\n\n## Files to Review\n\nAll in the [`node/`](https://github.com/Scottcjn/Rustchain/tree/main/node) directory of the main Rustchain repo:\n\n| File | Lines | Purpose |\n|------|-------|---------|\n| `utxo_db.py` | ~708 | Core UTXO database layer — UTXOs, transactions, mempool, Merkle roots, coin selection |\n| `test_utxo_db.py` | ~421 | 29 unit tests covering the UTXO layer |\n| `utxo_genesis_migration.py` | ~272 | Deterministic migration of 538 existing account balances into genesis UTXOs |\n| `rustchain_v2_integrated_v2.2.1_rip200.py` | (diff) | Server integration — imports + table init behind `UTXO_DUAL_WRITE` feature flag |\n\n## What to Look For\n\n### Critical Vectors (200 RTC)\n- **Double-spend attacks** — Can the same UTXO be consumed twice? Race conditions in `apply_transaction()`?\n- **Fund creation from nothing** — Can a transaction create more RTC in outputs than exists in inputs?\n- **Genesis migration tampering** — Can the migration be re-run to duplicate balances?\n\n### High Severity (100 RTC)\n- **Race conditions** — Concurrent transaction application, TOCTOU between validation and commitment\n- **Conservation law bypass** — Any path where `sum(inputs) != sum(outputs) + fee`\n- **Lock/unlock logic errors** — Can locked UTXOs be spent? Can spending bypass the lock check?\n\n### Medium Severity (50 RTC)\n- **Mempool DoS** — Can the mempool be flooded or manipulated to block legitimate transactions?\n- **Merkle state root manipulation** — Can the state root be made to diverge between nodes?\n- **Fee calculation exploits** — Negative fees, integer overflow in fee math, fee-free transactions that should require fees\n\n### Low Severity (25 RTC)\n- **Coin selection edge cases** — Pathological wallet states that break coin selection\n- **Code quality issues** — SQL injection vectors, unchecked error paths, missing validations\n- **Test coverage gaps** — Important scenarios not covered by the 29 existing tests\n\n## How to Submit\n\n**Option A (preferred):** Open a PR on [Scottcjn/Rustchain](https://github.com/Scottcjn/Rustchain) with a **failing test case** that demonstrates the bug. Title it `[UTXO-BUG] <description>`.\n\n**Option B:** Open an issue on this repo with a detailed writeup including:\n1. The vulnerability class\n2. Steps to reproduce\n3. Expected vs actual behavior\n4. Suggested fix (optional but earns bonus)\n\n## Bounty Tiers Summary\n\n| Severity | Payout | Examples |\n|----------|--------|----------|\n| **Critical** | **200 RTC** | Double-spend, fund creation, genesis duplication |\n| **High** | **100 RTC** | Race conditions, conservation bypass |\n| **Medium** | **50 RTC** | Mempool DoS, Merkle manipulation |\n| **Low** | **25 RTC** | Edge cases, code quality, test gaps |\n\nMultiple valid findings from the same researcher will each be paid individually.\n\n## Context\n\n- RTC reference rate: **1 RTC = $0.10 USD**\n- The UTXO layer is behind a feature flag (`UTXO_DUAL_WRITE=0` by default) — it is NOT active on the live network yet\n- The existing account-based model continues to handle all production transactions\n- This is a pre-production security review before we flip the switch\n\n## Resources\n\n- [RustChain Node Health](https://50.28.86.131/health)\n- [Block Explorer](https://50.28.86.131/explorer)\n- [Active Miners API](https://50.28.86.131/api/miners)","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/reactions","total_count":15,"+1":5,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":1,"rocket":5,"eyes":2},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ioccc-src/mkiocccentry/issues/723","repository_url":"https://api.github.com/repos/ioccc-src/mkiocccentry","labels_url":"https://api.github.com/repos/ioccc-src/mkiocccentry/issues/723/labels{/name}","comments_url":"https://api.github.com/repos/ioccc-src/mkiocccentry/issues/723/comments","events_url":"https://api.github.com/repos/ioccc-src/mkiocccentry/issues/723/events","html_url":"https://github.com/ioccc-src/mkiocccentry/issues/723","id":1774705161,"node_id":"I_kwDOGljQMs5px9oJ","number":723,"title":"Question: Issues that aren’t really major issues but are still issues","user":{"login":"xexyl","id":53008573,"node_id":"MDQ6VXNlcjUzMDA4NTcz","avatar_url":"https://avatars.githubusercontent.com/u/53008573?v=4","gravatar_id":"","url":"https://api.github.com/users/xexyl","html_url":"https://github.com/xexyl","followers_url":"https://api.github.com/users/xexyl/followers","following_url":"https://api.github.com/users/xexyl/following{/other_user}","gists_url":"https://api.github.com/users/xexyl/gists{/gist_id}","starred_url":"https://api.github.com/users/xexyl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xexyl/subscriptions","organizations_url":"https://api.github.com/users/xexyl/orgs","repos_url":"https://api.github.com/users/xexyl/repos","events_url":"https://api.github.com/users/xexyl/events{/privacy}","received_events_url":"https://api.github.com/users/xexyl/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":3675586082,"node_id":"LA_kwDOGljQMs7bFP4i","url":"https://api.github.com/repos/ioccc-src/mkiocccentry/labels/question","name":"question","color":"d876e3","default":true,"description":"Further information is requested"},{"id":7621028359,"node_id":"LA_kwDOGljQMs8AAAABxj-qBw","url":"https://api.github.com/repos/ioccc-src/mkiocccentry/labels/background%20priority","name":"background priority","color":"BFD4F2","default":false,"description":"While this issue is needs to be solved, it is of a somewhat lower priority."}],"state":"open","locked":false,"assignees":[{"login":"lcn2","id":10429707,"node_id":"MDQ6VXNlcjEwNDI5NzA3","avatar_url":"https://avatars.githubusercontent.com/u/10429707?v=4","gravatar_id":"","url":"https://api.github.com/users/lcn2","html_url":"https://github.com/lcn2","followers_url":"https://api.github.com/users/lcn2/followers","following_url":"https://api.github.com/users/lcn2/following{/other_user}","gists_url":"https://api.github.com/users/lcn2/gists{/gist_id}","starred_url":"https://api.github.com/users/lcn2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lcn2/subscriptions","organizations_url":"https://api.github.com/users/lcn2/orgs","repos_url":"https://api.github.com/users/lcn2/repos","events_url":"https://api.github.com/users/lcn2/events{/privacy}","received_events_url":"https://api.github.com/users/lcn2/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"xexyl","id":53008573,"node_id":"MDQ6VXNlcjUzMDA4NTcz","avatar_url":"https: