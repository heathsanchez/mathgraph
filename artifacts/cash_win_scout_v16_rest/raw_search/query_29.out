id":"","url":"https://api.github.com/users/nibzard","html_url":"https://github.com/nibzard","followers_url":"https://api.github.com/users/nibzard/followers","following_url":"https://api.github.com/users/nibzard/following{/other_user}","gists_url":"https://api.github.com/users/nibzard/gists{/gist_id}","starred_url":"https://api.github.com/users/nibzard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nibzard/subscriptions","organizations_url":"https://api.github.com/users/nibzard/orgs","repos_url":"https://api.github.com/users/nibzard/repos","events_url":"https://api.github.com/users/nibzard/events{/privacy}","received_events_url":"https://api.github.com/users/nibzard/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":7347006954,"node_id":"LA_kwDOJ5_ntc8AAAABtept6g","url":"https://api.github.com/repos/daytonaio/content/labels/%F0%9F%92%8E%20Bounty","name":"💎 Bounty","color":"4f46e5","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":37,"created_at":"2024-08-20T14:40:10Z","updated_at":"2026-07-03T22:23:58Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Content Type\r\n\r\nArticle\r\n\r\n### Article Description\r\n\r\nWrite a how-to article to show step by step how dev can run Omni engineer inside Daytona and use it. \r\n\r\nCreate devcontainer.json file and contribute it to the existing repos:\r\nhttps://github.com/Doriandarko/omni-engineer\r\nhttps://github.com/Doriandarko/claude-engineer\r\n\r\nFor this to be accepted, PR needs to be created on the groq repo with the valid and working devcontainer and you should follow all of the rules for contributing to the mentioned repos.\r\n\r\n