sub_issues"]},"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/daydreamsai/lucid-agents/issues/177","repository_url":"https://api.github.com/repos/daydreamsai/lucid-agents","labels_url":"https://api.github.com/repos/daydreamsai/lucid-agents/issues/177/labels{/name}","comments_url":"https://api.github.com/repos/daydreamsai/lucid-agents/issues/177/comments","events_url":"https://api.github.com/repos/daydreamsai/lucid-agents/issues/177/events","html_url":"https://github.com/daydreamsai/lucid-agents/issues/177","id":3994307258,"node_id":"I_kwDOQPXP0s7uFEq6","number":177,"title":"[Data API] Cross-Chain Liquidity Snapshot Service (TDD PRD)","user":{"login":"ponderingdemocritus","id":90423308,"node_id":"MDQ6VXNlcjkwNDIzMzA4","avatar_url":"https://avatars.githubusercontent.com/u/90423308?v=4","gravatar_id":"","url":"https://api.github.com/users/ponderingdemocritus","html_url":"https://github.com/ponderingdemocritus","followers_url":"https://api.github.com/users/ponderingdemocritus/followers","following_url":"https://api.github.com/users/ponderingdemocritus/following{/other_user}","gists_url":"https://api.github.com/users/ponderingdemocritus/gists{/gist_id}","starred_url":"https://api.github.com/users/ponderingdemocritus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ponderingdemocritus/subscriptions","organizations_url":"https://api.github.com/users/ponderingdemocritus/orgs","repos_url":"https://api.github.com/users/ponderingdemocritus/repos","events_url":"https://api.github.com/users/ponderingdemocritus/events{/privacy}","received_events_url":"https://api.github.com/users/ponderingdemocritus/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10296243754,"node_id":"LA_kwDOQPXP0s8AAAACZbQ2Kg","url":"https://api.github.com/repos/daydreamsai/lucid-agents/labels/BOUNTY","name":"BOUNTY","color":"1D76DB","default":false,"description":"Taskmarket bounty linked issue"},{"id":10296243804,"node_id":"LA_kwDOQPXP0s8AAAACZbQ2XA","url":"https://api.github.com/repos/daydreamsai/lucid-agents/labels/AMOUNT:%20$3","name":"AMOUNT: $3","color":"0E8A16","default":false,"description":"Bounty amount is $3"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":5,"created_at":"2026-02-26T09:17:42Z","updated_at":"2026-07-01T00:11:45Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## TDD PRD\n\n### Context\nBuild a paid API-first Lucid agent that sells minute-level liquidity depth, slippage curves, and route quality for major token pairs across EVM venues.\n\n### Problem\nExecution agents overpay or fail routes because they cannot buy normalized, machine-readable liquidity snapshots with predictable latency and data quality guarantees.\n\n### Buyer User Story (Agent-to-Agent)\nAs a routing agent, I need a single paid endpoint that returns comparable pool depth and estimated slippage by notional so I can select the cheapest executable route automatically.\n\n### Product Scope\n- Sell data through paid HTTP endpoints (x402) for machine consumers.\n- Expose deterministic JSON contracts with strict Zod validation.\n- Provide freshness metadata and confidence annotations in every response.\n- Support programmatic agent consumers via stable API versioning.\n\n### API Contract (v1)\n- Endpoints: GET /v1/liquidity/snapshot, GET /v1/liquidity/slippage, GET /v1/liquidity/routes\n- Inputs: chain, baseToken, quoteToken, notionalUsd, venueFilter, timestamp\n- Outputs: normalized pools, depth buckets, slippage_bps_curve, best_route, confidence_score, freshness_ms\n\n### Architecture Requirements (Lucid Packages)\n- Runtime: @lucid-agents/core\n- Transport + SSE: @lucid-agents/http\n- Paywall + pricing: @lucid-agents/payments\n- Receivables wallet: @lucid-agents/wallet\n- Trust & attestations: @lucid-agents/identity\n- Upstream agent federation: @lucid-agents/a2a\n- Revenue sharing and composable payments: @lucid-agents/ap2\n\n### TDD Plan (Required Sequence)\n1. Write failing contract tests for all request/response schemas and error envelopes.\n2. Write failing business-logic tests for core data transforms and ranking/scoring behavior.\n3. Write failing integration tests for paid-route behavior (x402 required on monetized endpoints).\n4. Write failing freshness/quality tests (staleness thresholds, confidence propagation).\n5. Implement minimum code to pass tests incrementally.\n6. Refactor with tests green, preserving API behavior and performance budgets.\n\n### Test Coverage Requirements\n- Focus: schema validation, stale data rejection, deterministic route ranking, paid-access enforcement, SSE incremental updates\n- Unit: schema parsing, pure transforms, scoring/ranking invariants.\n- Integration: endpoint handlers + payment middleware + A2A upstream adapters.\n- Contract: stable JSON shape, explicit error codes, backwards-compatible field semantics.\n\n### Acceptance Criteria\n- All monetized endpoints require payment and return valid data after successful payment.\n- All responses include freshness and confidence fields where relevant.\n- P95 response time for cached path <= 500ms under test workload.\n- Test suite passes in CI with no skipped critical tests.\n- README includes endpoint examples for agent consumers.\n\n### Deliverables\n- Source implementation with typed contracts.\n- Test suite (unit + integration + contract).\n- API docs/examples for machine consumers.\n- Configuration docs for pricing and receivable wallet.\n\n### Definition of Done\n- PR opened referencing this issue.\n- CI green with test evidence attached.\n- Reviewer confirms TDD order from commit history and test evolution.\n\n### TaskMarket Cross-Reference\n- TaskMarket Task ID: 0x0cf736810fb343205481947628aee4fd718ea70d065207fc767de5898e98751f\n- TaskMarket API URL: https://api-market.daydreams.systems/api/tasks/0x0cf736810fb343205481947628aee4fd718ea70d065207fc767de5898e98751f\n","reactions":{"url":"https://api.github.com/repos/daydreamsai/lucid-agents/issues/177/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/daydreamsai/lucid-agents/issues/177/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3291","repository_url":"https://api.github.com/repos/ValveSoftware/Proton","labels_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3291/labels{/name}","comments_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3291/comments","events_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3291/events","html_url":"https://github.com/ValveSoftware/Proton/issues/3291","id":533525407,"node_id":"MDU6SXNzdWU1MzM1MjU0MDc=","number":3291,"title":"Red Dead Redemption 2 (1174180)","user":{"login":"NTMan","id":200750,"node_id":"MDQ6VXNlcjIwMDc1MA==","avatar_url":"https://avatars.githubusercontent.com/u/200750?v=4","gravatar_id":"","url":"https://api.github.com/users/NTMan","html_url":"https://github.com/NTMan","followers_url":"https://api.github.com/users/NTMan/followers","following_url":"https://api.github.com/users/NTMan/following{/other_user}","gists_url":"https://api.github.com/users/NTMan/gists{/gist_id}","starred_url":"https://api.github.com/users/NTMan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NTMan/subscriptions","organizations_url":"https://api.github.com/users/NTMan/orgs","repos_url":"https://api.github.com/users/NTMan/repos","events_url":"https://api.github.com/users/NTMan/events{/privacy}","received_events_url":"https://api.github.com/users/NTMan/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":1032039901,"node_id":"MDU6TGFiZWwxMDMyMDM5OTAx","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/Game%20compatibility%20-%20Unofficial","name":"Game compatibility - Unofficial","color":"ea6e3c","default":false,"description":"Games not expected to work without issues"},{"id":1041498223,"node_id":"MDU6TGFiZWwxMDQxNDk4MjIz","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/Regression","name":"Regression","color":"b60205","default":false,"description":"Confirmed working on an older version of Proton"},{"id":1079596127,"node_id":"MDU6TGFiZWwxMDc5NTk2MTI3","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/NVIDIA%20drivers","name":"NVIDIA drivers","color":"76b900","default":false,"description":"Possibly involves an issue with the NVIDIA proprietary driver"},{"id":1113044448,"node_id":"MDU6TGFiZWwxMTEzMDQ0NDQ4","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/Mesa%20drivers","name":"Mesa drivers","color":"dc143c","default":false,"description":"Possibly involves an issue with a Mesa video driver"},{"id":2012203775,"node_id":"MDU6TGFiZWwyMDEyMjAzNzc1","url":"https://api.github.com/repos/ValveSoftware/Proton/labels/AMD%20RADV","name":"AMD RADV","color":"dc143c","default":false,"description":"Possible driver issues with RADV"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1721,"created_at":"2019-12-05T18:40:49Z","updated_at":"2026-06-30T18:33:55Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# Compatibility Report\r\n- Name of the game with compatibility issues: Red Dead Redemption 2\r\n- Steam AppID of the game: 1174180\r\n\r\n## System Information\r\n- GPU: AMD Radeon VII\r\n- Driver/LLVM version: Mesa 20.0/10.0.0\r\n- Kernel version: 5.4\r\n- Link to full system information report as [Gist](https://gist.github.com/NTMan/33cca4906328793206218192820779ec)\r\n- Proton version: 4.11-9\r\n\r\n## I confirm:\r\n- [x] that I haven't found an existing compatibility report for this game.\r\n- [x] that I have checked whether there are updates for my system available.\r\n\r\n<!-- Please add `PROTON_LOG=1 %command%` to the game's launch options and drag\r\nand drop the generated `$HOME/steam-$APPID.log` into this issue report -->\r\n[steam-1174180.log](https://github.com/ValveSoftware/Proton/files/3928500/steam-1174180.log)\r\n\r\n## Symptoms <!-- What's the problem? -->\r\nRockstar Game Launcher said that unable to launch the game and recommend verify game data, but the game data successfully validated by steam.\r\n\r\n![Screenshot from 2019-12-05 22-59-27](https://user-images.githubusercontent.com/200750/70263493-4d81e080-17b8-11ea-8364-59213df0d3e2.png)\r\n\r\n![Screenshot from 2019-12-05 22-59-32](https://user-images.githubusercontent.com/200750/70263500-5377c180-17b8-11ea-8e08-eec65800860d.png)\r\n\r\n![Screenshot from 2019-12-06 00-09-00](https://user-images.githubusercontent.com/200750/70265695-c1be8300-17bc-11ea-9ac5-d1513caed891.png)\r\n\r\n\r\n## Reproduction\r\nJust launch the game.\r\n\r\n<!--\r\n1. You can find the Steam AppID in the URL of the shop page of the game.\r\n   e.g. for `The Witcher 3: Wild Hunt` the AppID is `292030`.\r\n2. You can find your driver and Linux version, as well as your graphics\r\n   processor's name in the system information report of Steam.\r\n3. You can retrieve a full system information report by clicking\r\n   `Help` > `System Information` in the Steam client on your machine.\r\n4. Please copy it to your clipboard by pressing `Ctrl+A` and then `Ctrl+C`.\r\n   Then paste it in a [Gist](https://gist.github.com/) and post the link in\r\n   this issue.\r\n5. Please search for open issues and pull requests by the name of the game and\r\n   find out whether they are relevant and should be referenced above.\r\n-->\r\n","reactions":{"url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3291/reactions","total_count":49,"+1":45,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":3,"eyes":1},"timeline_url":"https://api.github.com/repos/ValveSoftware/Proton/issues/3291/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/daydreamsai/lucid-agents/issues/179","repository_url":"https://api.github.com/repos/daydreamsai/lucid-agents","labels_url":"https://api.github.com/repos/daydreamsai/lucid-agents/issues/179/labels{/name}","comments_url":"https://api.github.com/repos/daydreamsai/lucid-agents/issues/179/comments","events_url":"https://api.github.com/repos/daydreamsai/lucid-agents/issues/179/events","html_url":"https://github.com/daydreamsai/lucid-agents/issues/179","id":3994313257,"node_id":"I_kwDOQPXP0s7uFGIp","number":179,"title":"[Data API] Counterparty Risk Graph Intelligence API (TDD PRD)","user":{"login":"ponderingdemocritus","id":90423308,"node_id":"MDQ6VXNlcjkwNDIzMzA4","avatar_url":"https://avatars.githubusercontent.com/u/90423308?v=4","gravatar_id":"","url":"https://api.github.com/users/ponderingdemocritus","html_url":"https://github.com/ponderingdemocritus","followers_url":"https://api.github.com/users/ponderingdemocritus/followers","following_url":"https://api.github.com/users/ponderingdemocritus/following{/other_user}","gists_url":"https://api.github.com/users/ponderingdemocritus/gists{/gist_id}","starred_url":"https://api.github.com/users/ponderingdemocritus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ponderingdemocritus/subscriptions","organizations_url":"https://api.github.com/users/ponderingdemocritus/orgs","repos_url":"https://api.github.com/users/ponderingdemocritus/repos","events_url":"https://api.github.com/users/ponderingdemocritus/events{/privacy}","received_events_url":"https://api.github.com/users/ponderingdemocritus/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10296243754,"node_id":"LA_kwDOQPXP0s8AAAACZbQ2Kg","url":"https://api.github.com/repos/daydreamsai/lucid-agents/labels/BOUNTY","name":"BOUNTY","color":"1D76DB","default":false,"description":"Taskmarket bounty linked issue"},{"id":10296243804,"node_id":"LA_kwDOQPXP0s8AAAACZbQ2XA","url":"https://api.github.com/repos/daydreamsai/lucid-agents/labels/AMOUNT:%20$3","name":"AMOUNT: $3","color":"0E8A16","default":false,"description":"Bounty amount is $3"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":8,"created_at":"2026-02-26T09:18:54Z","updated_at":"2026-06-30T14:38:48Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## TDD PRD\n\n### Context\nBuild a paid graph-intelligence API that sells wallet/entity clustering, exposure paths, and risk scores.\n\n### Problem\nPayment and underwriting agents lack standardized machine-readable counterparty risk context before transacting.\n\n### Buyer User Story (Agent-to-Agent)\nAs a payment-routing agent, I need exposure-chain and risk evidence in one response so I can avoid high-risk counterparties automatically.\n\n### Product Scope\n- Sell data through paid HTTP endpoints (x402) for machine consumers.\n- Expose deterministic JSON contracts with strict Zod validation.\n- Provide freshness metadata and confidence annotations in every response.\n- Support programmatic agent consumers via stable API versioning.\n\n### API Contract (v1)\n- Endpoints: POST /v1/risk/score, GET /v1/risk/exposure-paths, GET /v1/risk/entity-profile\n- Inputs: address, network, transaction_context, threshold, lookback_days\n- Outputs: risk_score, risk_factors, exposure_paths, cluster_id, sanctions_proximity, evidence_refs\n\n### Architecture Requirements (Lucid Packages)\n- Runtime: @lucid-agents/core\n- Transport + SSE: @lucid-agents/http\n- Paywall + pricing: @lucid-agents/payments\n- Receivables wallet: @lucid-agents/wallet\n- Trust & attestations: @lucid-agents/identity\n- Upstream agent federation: @lucid-agents/a2a\n- Revenue sharing and composable payments: @lucid-agents/ap2\n\n### TDD Plan (Required Sequence)\n1. Write failing contract tests for all request/response schemas and error envelopes.\n2. Write failing business-logic tests for core data transforms and ranking/scoring behavior.\n3. Write failing integration tests for paid-route behavior (x402 required on monetized endpoints).\n4. Write failing freshness/quality tests (staleness thresholds, confidence propagation).\n5. Implement minimum code to pass tests incrementally.\n6. Refactor with tests green, preserving API behavior and performance budgets.\n\n### Test Coverage Requirements\n- Focus: graph traversal correctness, deterministic scoring, false-positive guardrails, paid route tests, evidence reference integrity\n- Unit: schema parsing, pure transforms, scoring/ranking invariants.\n- Integration: endpoint handlers + payment middleware + A2A upstream adapters.\n- Contract: stable JSON shape, explicit error codes, backwards-compatible field semantics.\n\n### Acceptance Criteria\n- All monetized endpoints require payment and return valid data after successful payment.\n- All responses include freshness and confidence fields where relevant.\n- P95 response time for cached path <= 500ms under test workload.\n- Test suite passes in CI with no skipped critical tests.\n- README includes endpoint examples for agent consumers.\n\n### Deliverables\n- Source implementation with typed contracts.\n- Test suite (unit + integration + contract).\n- API docs/examples for machine consumers.\n- Configuration docs for pricing and receivable wallet.\n\n### Definition of Done\n- PR opened referencing this issue.\n- CI green with test evidence attached.\n- Reviewer confirms TDD order from commit history and test evolution.\n\n### TaskMarket Cross-Reference\n- TaskMarket Task ID: 0x2d5b5d7d419c76537b2edbcf7e54a51ae7d07bc7a428cf8b0b1d62fe8d33ea4c\n- TaskMarket API URL: https://api-market.daydreams.systems/api/tasks/0x2d5b5d7d419c76537b2edbcf7e54a51ae7d07bc7a428cf8b0b1d62fe8d33ea4c\n","reactions":{"url":"https://api.github.com/repos/daydreamsai/lucid-agents/issues/179/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/daydreamsai/lucid-agents/issues/179/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/mergeos-bounties/mergeos/issues/1","repository_url":"https://api.github.com/repos/mergeos-bounties/mergeos","labels_url":"https://api.github.com/repos/mergeos-bounties/mergeos/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/mergeos-bounties/mergeos/issues/1/comments","events_url":"https://api.github.com/repos/mergeos-bounties/mergeos/issues/1/events","html_url":"https://github.com/mergeos-bounties/mergeos/issues/1","id":4521580715,"node_id":"I_kwDOSn8qcM8AAAABDYHYqw","number":1,"title":"Claim MRG Tokens for Bug Bounty Reports - Comment New Bugs Here Before Opening a PR","user":{"login":"TUPM96","id":22741583,"node_id":"MDQ6VXNlcjIyNzQxNTgz","avatar_url":"https://avatars.githubusercontent.com/u/22741583?v=4","gravatar_id":"","url":"https://api.github.com/users/TUPM96","html_url":"https://github.com/TUPM96","followers_url":"https://api.github.com/users/TUPM96/followers","following_url":"https://api.github.com/users/TUPM96/following{/other_user}","gists_url":"https://api.github.com/users/TUPM96/gists{/gist_id}","starred_url":"https://api.github.com/users/TUPM96/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TUPM96/subscriptions","organizations_url":"https://api.github.com/users/TUPM96/orgs","repos_url":"https://api.github.com/users/TUPM96/repos","events_url":"https://api.github.com/users/TUPM96/events{/privacy}","received_events_url":"https://api.github.com/users/TUPM96/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11054066705,"node_id":"LA_kwDOSn8qcM8AAAACkt-sEQ","url":"https://api.github.com/repos/mergeos-bounties/mergeos/labels/claim-token","name":"claim-token","color":"0E8A16","default":false,"description":"Token claim intake for bounty bug reports"},{"id":11054066706,"node_id":"LA_kwDOSn8qcM8AAAACkt-sEg","url":"https://api.github.com/repos/mergeos-bounties/mergeos/labels/bounty","name":"bounty","color":"5319E7","default":false,"description":"Eligible work for the MergeOS bounty program"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":93,"created_at":"2026-05-26T05:18:53Z","updated_at":"2026-06-29T19:31:34Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"# Claim MRG Tokens for Bug Bounty Reports\n\nUse this issue as the single intake queue for new bug bounty reports that want to claim MRG token rewards.\n\nFull bounty policy: https://github.com/mergeos-bounties/mergeos/blob/master/BOUNTY-POLICY.md\nCurrent bounty index: https://github.com/mergeos-bounties/mergeos/blob/master/README-INDEX.md\n\n## Contributor Requirement\n\nContributors must star this repository before claiming, starting, or submitting bounty work. Claims and PRs from accounts that have not starred the repo are not eligible for bounty review until the repo is starred.\n\n## Bounty Reward Scale\n\n| Bounty scope | Reward |\n| --- | ---: |\n| Bug fix or small feature | 25 MRG |\n| Medium feature | 50 MRG |\n| Large feature | 100 MRG |\n| Extra-large feature or system-level work | 200 MRG |\n\n## Claim Rules\n\n1. Comment in this issue before starting work on a new bounty bug.\n2. A maintainer will confirm whether the bug is valid, assign type, size, bounty amount, and claimant.\n3. After the claim is confirmed, create a branch and open a PR with the fix.\n4. The PR must link back to the exact claim comment in this issue.\n5. The PR must include evidence: before/after screenshots or GIFs for UI bugs, or logs, request/response examples, terminal output, or test failure/pass output for non-UI bugs.\n6. MRG token rewards are only eligible after the PR is reviewed, evidence is accepted, tests pass, and the PR is merged.\n\n## Bug Claim Comment Template\n\n```markdown\n### Bug title\nShort name for the bug.\n\n### Impact\nWho is affected, where it happens, and severity.\n\n### Steps to reproduce\n1. ...\n2. ...\n3. ...\n\n### Expected result\nWhat should happen.\n\n### Actual result\nWhat happens now.\n\n### Evidence\nAttach screenshot, GIF, video, log, request/response, or failing test output.\n\n### Proposed fix\nOptional fix direction.\n\n### Claim info\nGitHub handle:\nWallet/token receiver:\n```\n\n## Required PR Evidence\n\n- Link to the claim comment in this issue.\n- Clear bug description and fix summary.\n- Before/after evidence using images, GIFs, logs, or test output.\n- Test checklist and command output.\n\nClaims without a PR, or PRs without evidence, are not eligible for MRG token payout yet.","reactions":{"url":"https://api.github.com/repos/mergeos-bounties/mergeos/issues/1/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/mergeos-bounties/mergeos/issues/1/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/commaai/opendbc/issues/2017","repository_url":"https://api.github.com/repos/commaai/opendbc","labels_url":"https://api.github.com/repos/commaai/opendbc/issues/2017/labels{/name}","comments_url":"https://api.github.com/repos/commaai/opendbc/issues/2017/comments","events_url":"https://api.github.com/repos/commaai/opendbc/issues/2017/events","html_url":"https://github.com/commaai/opendbc/issues/2017","id":2935936021,"node_id":"I_kwDOBYm73M6u_tQV","number":2017,"title":"[$3000 bounty] BYD port","user":{"login":"adeebshihadeh","id":8762862,"node_id":"MDQ6VXNlcjg3NjI4NjI=","avatar_url":"https://avatars.githubusercontent.com/u/8762862?v=4","gravatar_id":"","url":"https://api.github.com/users/adeebshihadeh","html_url":"https://github.com/adeebshihadeh","followers_url":"https://api.github.com/users/adeebshihadeh/followers","following_url":"https://api.github.com/users/adeebshihadeh/following{/other_user}","gists_url":"https://api.github.com/users/adeebshihadeh/gists{/gist_id}","starred_url":"https://api.github.com/users/adeebshihadeh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adeebshihadeh/subscriptions","organizations_url":"https://api.github.com/users/adeebshihadeh/orgs","repos_url":"https://api.github.com/users/adeebshihadeh/repos","events_url":"https://api.github.com/users/adeebshihadeh/events{/privacy}","received_events_url":"https://api.github.com/users/adeebshihadeh/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":616569022,"node_id":"MDU6TGFiZWw2MTY1NjkwMjI=","url":"https://api.github.com/repos/commaai/opendbc/labels/enhancement","name":"enhancement","color":"84b6eb","default":true,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":22,"created_at":"2025-03-20T15:48:20Z","updated_at":"2026-06-27T12:24:31Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Let's get a BYD supported! Any model is eligible.\n\nRequires a harness design/schematic, a high quality lateral port, and ideally longitudinal support.","reactions":{"url":"https://api.github.com/repos/commaai/opendbc/issues/2017/reactions","total_count":5,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":5,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/commaai/opendbc/issues/2017/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/tscircuit/matchpack/issues/12","repository_url":"https://api.github.com/repos/tscircuit/matchpack","labels_url":"https://api.github.com/repos/tscircuit/matchpack/issues/12/labels{/name}","comments_url":"https://api.github.com/repos/tscircuit/matchpack/issues/12/comments","events_url":"https://api.github.com/repos/tscircuit/matchpack/issues/12/events","html_url":"https://github.com/tscircuit/matchpack/issues/12","id":3369247508,"node_id":"I_kwDOPZhxF87I0qMU","number":12,"title":"Propose/implement a solution to bad layout","user":{"login":"seveibar","id":1910070,"node_id":"MDQ6VXNlcjE5MTAwNzA=","avatar_url":"https://avatars.githubusercontent.com/u/1910070?v=4","gravatar_id":"","url":"https://api.github.com/users/seveibar","html_url":"https://github.com/seveibar","followers_url":"https://api.github.com/users/seveibar/followers","following_url":"https://api.github.com/users/seveibar/following{/other_user}","gists_url":"https://api.github.com/users/seveibar/gists{/gist_id}","starred_url":"https://api.github.com/users/seveibar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/seveibar/subscriptions","organizations_url":"https://api.github.com/users/seveibar/orgs","repos_url":"https://api.github.com/users/seveibar/repos","events_url":"ht