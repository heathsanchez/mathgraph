hub.com/users/neil-marcellini/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"Krishna2323","id":85894871,"node_id":"MDQ6VXNlcjg1ODk0ODcx","avatar_url":"https://avatars.githubusercontent.com/u/85894871?v=4","gravatar_id":"","url":"https://api.github.com/users/Krishna2323","html_url":"https://github.com/Krishna2323","followers_url":"https://api.github.com/users/Krishna2323/followers","following_url":"https://api.github.com/users/Krishna2323/following{/other_user}","gists_url":"https://api.github.com/users/Krishna2323/gists{/gist_id}","starred_url":"https://api.github.com/users/Krishna2323/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Krishna2323/subscriptions","organizations_url":"https://api.github.com/users/Krishna2323/orgs","repos_url":"https://api.github.com/users/Krishna2323/repos","events_url":"https://api.github.com/users/Krishna2323/events{/privacy}","received_events_url":"https://api.github.com/users/Krishna2323/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":58,"created_at":"2026-06-01T15:06:25Z","updated_at":"2026-07-06T19:28:34Z","closed_at":null,"assignee":{"login":"Krishna2323","id":85894871,"node_id":"MDQ6VXNlcjg1ODk0ODcx","avatar_url":"https://avatars.githubusercontent.com/u/85894871?v=4","gravatar_id":"","url":"https://api.github.com/users/Krishna2323","html_url":"https://github.com/Krishna2323","followers_url":"https://api.github.com/users/Krishna2323/followers","following_url":"https://api.github.com/users/Krishna2323/following{/other_user}","gists_url":"https://api.github.com/users/Krishna2323/gists{/gist_id}","starred_url":"https://api.github.com/users/Krishna2323/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Krishna2323/subscriptions","organizations_url":"https://api.github.com/users/Krishna2323/orgs","repos_url":"https://api.github.com/users/Krishna2323/repos","events_url":"https://api.github.com/users/Krishna2323/events{/privacy}","received_events_url":"https://api.github.com/users/Krishna2323/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** v9.3.90-1\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/test-runs/TR-35861/folder/13176744/55971987/1449112331?sort=%2Bidentifier\n**Email or phone of affected tester (no customers):** n/a\n**Issue reported by:** Applause Internal Team\n**Bug source:** Regression TC Execution\n**Device used:** Mac 15.4.1 Safari/Chrome, iPhone 13 iOS 26.5\n**App Component:** Money Requests\n\n## Action Performed:\nPreconditions:The user is logged into an account with Admin privileges for an active workspace.\nSubmission frequency disabled in Workflows settings.\nThe workspace has Distance Tracking enabled and a default distance rate configured.\n\n1. Go to https://staging.new.expensify.com\n2. Navigate to the workspace chat\n3. Create a distance expense in the workspace chat \n4. Open the expense report\n5. Click \"Submit\" on the report header\n6. Click More  >  Reject\n7. Enter a reason for rejection and click \"Reject expense\"\n\n## Expected Result:\nWhen submission frequency is disabled, the rejected expense should be moved to selfDM, LHN should clearly display the associated distance rate\n\n## Actual Result:\nRejected expense is not moved to selfDM when submission frequency is disabled\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [x] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [x] MacOS: Chrome Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/cd9f16d9-d240-427d-b2e8-904bc425b29c\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n\n> **Applause Internal Information**\n> Exported by: Julia Ponikarchuk\n> Bug ID: 7166620\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022061466533218948128\">https://www.upwork.com/jobs/~022061466533218948128</a></li>\n        <li>Upwork Job ID: 2061466533218948128</li>\n        <li>Last Price Increase: 2026-07-06</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @neil-marcellini</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/92246/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/92246/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/398","id":3974807149,"node_id":"I_kwDORGgqa87s6r5t","number":398,"title":"[QUEST] Harden the Chain — Security Quest, 67 RTC Total","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":65,"created_at":"2026-02-22T15:25:06Z","updated_at":"2026-07-06T19:04:22Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Quest Chain: Harden the Chain\n\nFor security-minded contributors. Complete each step to earn up to **100 RTC** and the **Guardian** title.\n\n---\n\n### Step 1: Read the Architecture (10 RTC)\nRead the codebase and write a 500+ word security assessment covering:\n- How attestation works (the \\`/attest/submit\\` flow)\n- How hardware fingerprinting prevents VM farms\n- How epoch rewards are calculated and distributed\n- One potential attack vector you identified\n\n**Prove it:** Post your assessment as a comment or gist link.\n\n---\n\n### Step 2: Reproduce a Known Fix (15 RTC)\nPick one vulnerability from BuilderFred's audit (all 6 are fixed):\n1. VM Fingerprint Bypass\n2. Antiquity Spoofing\n3. Mock Signature Mode\n4. Inline PubKey Hijack\n5. SQL Schema Mismatch\n6. Hardware Binding Bypass\n\nSet up a local test environment and demonstrate you understand HOW the fix works by:\n- Describing the attack before the fix\n- Showing the fix in the code\n- Explaining why the fix is sufficient (or isn't)\n\n**Prove it:** Write-up with code references.\n\n---\n\n### Step 3: Find Something New (75 RTC)\nFind and report a previously unknown security issue. Must include:\n- Clear description of the vulnerability\n- Steps to reproduce\n- Severity assessment (Critical/High/Medium/Low)\n- Suggested fix\n\n**Prove it:** File a responsible disclosure via the SECURITY.md process. If confirmed, earn the full 75 RTC + Guardian title.\n\n---\n\n### Completion\n\n| Steps | Reward | Title |\n|-------|--------|-------|\n| Step 1 only | 10 RTC | Security Explorer |\n| Steps 1 + 2 | 25 RTC | Security Analyst |\n| Steps 1 + 2 + 3 | **100 RTC** | **Guardian** |\n\n*You don't have to find a new vulnerability to earn from Steps 1 and 2. Those reward understanding, not just discovery.*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/reactions","total_count":6,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/398/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/priyanshudumps/fuel-agent-kit/issues/1","repository_url":"https://api.github.com/repos/priyanshudumps/fuel-agent-kit","labels_url":"https://api.github.com/repos/priyanshudumps/fuel-agent-kit/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/priyanshudumps/fuel-agent-kit/issues/1/comments","events_url":"https://api.github.com/repos/priyanshudumps/fuel-agent-kit/issues/1/events","html_url":"https://github.com/priyanshudumps/fuel-agent-kit/issues/1","id":4252965132,"node_id":"I_kwDOPc9Jp879fxkM","number":1,"title":"add a python version of the kit","user":{"login":"priyanshudumps","id":117640363,"node_id":"U_kgDOBwMMqw","avatar_url":"https://avatars.githubusercontent.com/u/117640363?v=4","gravatar_id":"","url":"https://api.github.com/users/priyanshudumps","html_url":"https://github.com/priyanshudumps","followers_url":"https://api.github.com/users/priyanshudumps/followers","following_url":"https://api.github.com/users/priyanshudumps/following{/other_user}","gists_url":"https://api.github.com/users/priyanshudumps/gists{/gist_id}","starred_url":"https://api.github.com/users/priyanshudumps/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/priyanshudumps/subscriptions","organizations_url":"https://api.github.com/users/priyanshudumps/orgs","repos_url":"https://api.github.com/users/priyanshudumps/repos","events_url":"https://api.github.com/users/priyanshudumps/events{/privacy}","received_events_url":"https://api.github.com/users/priyanshudumps/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10679807504,"node_id":"LA_kwDOPc9Jp88AAAACfJDuEA","url":"https://api.github.com/repos/priyanshudumps/fuel-agent-kit/labels/bounty","name":"bounty","color":"f59e0b","default":false,"description":"Issue has a USDC bounty attached"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":16,"created_at":"2026-04-13T09:03:37Z","updated_at":"2026-07-06T18:20:34Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"add a python version of the kit ","reactions":{"url":"https://api.github.com/repos/priyanshudumps/fuel-agent-kit/issues/1/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/priyanshudumps/fuel-agent-kit/issues/1/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/443","id":3997949318,"node_id":"I_kwDORGgqa87uS92G","number":443,"title":"Write a Review of RustChain — 3 RTC (Good First Issue)","user":{"login":"sophiaeagent-beep","id":245112282,"node_id":"U_kgDODpwd2g","avatar_url":"https://avatars.githubusercontent.com/u/245112282?v=4","gravatar_id":"","url":"https://api.github.com/users/sophiaeagent-beep","html_url":"https://github.com/sophiaeagent-beep","followers_url":"https://api.github.com/users/sophiaeagent-beep/followers","following_url":"https://api.github.com/users/sophiaeagent-beep/following{/other_user}","gists_url":"https://api.github.com/users/sophiaeagent-beep/gists{/gist_id}","starred_url":"https://api.github.com/users/sophiaeagent-beep/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sophiaeagent-beep/subscriptions","organizations_url":"https://api.github.com/users/sophiaeagent-beep/orgs","repos_url":"https://api.github.com/users/sophiaeagent-beep/repos","events_url":"https://api.github.com/users/sophiaeagent-beep/events{/privacy}","received_events_url":"https://api.github.com/users/sophiaeagent-beep/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071047,"node_id":"LA_kwDORGgqa88AAAACXSuRxw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/easy","name":"easy","color":"0E8A16","default":false,"description":"Low difficulty bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":91,"created_at":"2026-02-26T21:54:17Z","updated_at":"2026-07-06T18:00:47Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: Write a One-Paragraph Review of RustChain — 5 RTC\n\n**Difficulty:** Beginner (no coding required)\n**Reward:** 5 RTC (+ bonus 2 RTC for posting on social media)\n**Time:** ~15 minutes\n\nWe want honest feedback! Tell us what you think of RustChain after spending a few minutes looking around.\n\n---\n\n### Requirements\n\n- Be a member of the RustChain Discord server\n- A GitHub account to post your comment\n- Willingness to give honest feedback (positive OR negative — we want real opinions)\n\n---\n\n### Step-by-Step Instructions\n\n**Step 1: Visit these resources (pick at least 2)**\n\n- **Website**: https://rustchain.org — Read about what RustChain is\n- **Block Explorer**: https://50.28.86.131/explorer — See the live blockchain\n- **Web Wallet**: http://50.28.86.131:8070/wallet.html — Try creating a wallet\n- **PyPI Package**: https://pypi.org/project/clawrtc/ — Read the miner description\n- **GitHub Repos**: https://github.com/Scottcjn/Rustchain — Browse the code\n\n**Step 2: Write your review**\n\nWrite **2-3 honest sentences** about your impression. Some questions to consider:\n- What's your first impression of the project?\n- Is anything confusing or unclear?\n- What do you find interesting or unique?\n- Would you recommend it to a friend? Why or why not?\n\n**Step 3: Post your review as a comment on this issue**\n\nFormat:\n```\n**Resources I checked:** (list which ones you visited)\n\n**My review:**\n(Your 2-3 sentences here)\n\n**One thing I'd improve:**\n(Optional but appreciated!)\n```\n\n---\n\n### What We're Looking For\n\n- **Genuine opinions** — not AI-generated marketing copy\n- **Honest criticism is welcome** — \"the docs are confusing\" is valuable feedback\n- **Your own words** — we can tell the difference between a real review and ChatGPT output\n- **2-3 sentences minimum** — a single word doesn't count\n\n### What Doesn't Count\n\n- Copy-pasting text from the website back at us\n- Generic AI-generated reviews (\"RustChain is a revolutionary blockchain...\")\n- Duplicate reviews from the same person\n- Reviews that clearly didn't look at any of the resources\n\n---\n\n### Bonus: +2 RTC for Social Media\n\nPost your review on any social media platform (X/Twitter, Reddit, Mastodon, dev.to, etc.) and link it in your comment for an extra **2 RTC**.\n\nTag us if you're on X: **@RustchainPOA**\n\n---\n\n### How to Get Paid\n\n1. Post your review as a comment below\n2. Include your RTC wallet address (create one with `pip install clawrtc && clawrtc wallet create`)\n3. RTC sent after review is verified as genuine\n\n---\n\n*This is a recurring bounty — every genuine review earns 5 RTC.*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/reactions","total_count":9,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/443/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/269","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/269/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/269/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/269/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/269","id":3953219900,"node_id":"I_kwDORGgqa87roVk8","number":269,"title":"[BOUNTY] Silicon Archaeology: Hardware Scanner Module (7 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029430,"node_id":"LA_kwDORGgqa88AAAACWucZtg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":28,"created_at":"2026-02-17T15:03:21Z","updated_at":"2026-07-06T17:55:56Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Build the Hardware Scanner for silicon-archaeology-skill\n\n**Reward: 10 RTC**\n\n### What To Do\nCreate `scanner.py` for [silicon-archaeology-skill](https://github.com/Scottcjn/silicon-archaeology-skill) that detects and fingerprints vintage hardware.\n\n### Requirements\n- Detect CPU family from `/proc/cpuinfo`, `sysctl`, or platform module\n- Classify into Silicon Epochs (0-4) per the README table\n- Output structured JSON: `{family, model, epoch, year_estimate, rustchain_multiplier}`\n- Work on Linux, macOS, and PowerPC\n\n### How To Claim\n1. Fork `silicon-archaeology-skill`, add `silicon_archaeology/scanner.py`\n2. Open a PR with working code + basic tests\n3. Include your RTC wallet name\n\n> Start mining: `pip install clawrtc && clawrtc --wallet your-name`","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/269/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/269/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/249","id":3950113827,"node_id":"I_kwDORGgqa87rcfQj","number":249,"title":"[BOUNTY] RustChain Telegram Community Bot (33 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10119175842,"node_id":"LA_kwDORGgqa88AAAACWyZeog","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/ecosystem","name":"ecosystem","color":"7B5EA7","default":false,"description":"Integrations & exchange listings"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":36,"created_at":"2026-02-17T00:20:10Z","updated_at":"2026-07-06T17:55:06Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## RustChain Telegram Community Bot\n\n**Reward: 50 RTC**\n\n### What To Build\nA Telegram bot for a RustChain community group that provides:\n- `/price` — Current wRTC price from Raydium\n- `/miners` — Active miner count from `/api/miners`\n- `/epoch` — Current epoch info from `/epoch`\n- `/balance <wallet>` — Check RTC balance\n- `/health` — Node health status\n\n### Requirements\n- Python (python-telegram-bot or aiogram)\n- Must use real RustChain API endpoints (50.28.86.131)\n- Include setup instructions and requirements.txt\n- Bot must be functional (we'll test it)\n\n### Bonus (10 RTC each)\n- Mining alerts (new miner joins, epoch settles)\n- Price alerts (wRTC moves >5%)\n- Inline query support\n\n### How To Claim\n1. Submit PR to Scottcjn/Rustchain with bot code in `tools/telegram_bot/`\n2. Include deployment instructions\n3. Reply here with PR link + wallet name\n\n> API docs: https://github.com/Scottcjn/Rustchain/blob/main/docs/api/REFERENCE.md","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/249/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/93772","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/93772/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/93772/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/93772/events","html_url":"https://github.com/Expensify/App/issues/93772","id":4680876469,"node_id":"I_kwDOEQqHYc8AAAABFwCBtQ","number":93772,"title":"[$250] Tax-Tax rate is not updated on the confirmation page after changing currency","user":{"login":"applause-bot[bot]","id":265651874,"node_id":"BOT_kgDOD9WGog","avatar_url":"https://avatars.githubusercontent.com/in/3009811?v=4","gravatar_id":"","url":"https://api.github.com/users/applause-bot%5Bbot%5D","html_url":"https://github.com/apps/applause-bot","followers_url":"https://api.github.com/users/applause-bot%5Bbot%5D/followers","following_url":"https://api.github.com/users/applause-bot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/applause-bot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/applause-bot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/applause-bot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/applause-bot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/applause-bot%5Bbot%5D/repos","events_url":"https://api.github.com/users/applause-bot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/applause-bot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[{"id":2283143991,"node_id":"MDU6TGFiZWwyMjgzMTQzOTkx","url":"https://api.github.com/repos/Expensify/App/labels/Reviewing","name":"Reviewing","color":"dddddd","default":false,"description":"Has a PR in review"},{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893515375,"node_id":"MDU6TGFiZWwyODkzNTE1Mzc1","url":"https://api.github.com/repos/Expensify/App/labels/Weekly","name":"Weekly","color":"009800","default":false,"description":"KSv2"},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"lakchote","id":21549771,"node_id":"MDQ6VXNlcjIxNTQ5Nzcx","avatar_url":"https://avatars.githubusercontent.com/u/21549771?v=4","gravatar_id":"","url":"https://api.github.com/users/lakchote","html_url":"https://github.com/lakchote","followers_url":"https://api.github.com/users/lakchote/followers","following_url":"https://api.github.com/users/lakchote/following{/other_user}","gists_url":"https://api.github.com/users/lakchote/gists{/gist_id}","starred_url":"https://api.github.com/users/lakchote/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lakchote/subscriptions","organizations_url":"https://api.github.com/users/lakchote/orgs","repos_url":"https://api.github.com/users/lakchote/repos","events_url":"https://api.github.com/users/lakchote/events{/privacy}","received_events_url":"https://api.github.com/users/lakchote/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"Eskalifer1","id":66723620,"node_id":"MDQ6VXNlcjY2NzIzNjIw","avatar_url":"https://avatars.githubusercontent.com/u/66723620?v=4","gravatar_id":"","url":"https://api.github.com/users/Eskalifer1","html_url":"https://github.com/Eskalifer1","followers_url":"https://api.github.com/users/Eskalifer1/followers","following_url":"https://api.github.com/users/Eskalifer1/following{/other_user}","gists_url":"https://api.github.com/users/Eskalifer1/gists{/gist_id}","starred_url":"https://api.github.com/users/Eskalifer1/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Eskalifer1/subscriptions","organizations_url":"https://api.github.com/users/Eskalifer1/orgs","repos_url":"https://api.github.com/users/Eskalifer1/repos","events_url":"https://api.github.com/users/Eskalifer1/events{/privacy}","received_events_url":"https://api.github.com/users/Eskalifer1/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":55,"created_at":"2026-06-17T06:55:25Z","updated_at":"2026-07-06T17:54:20Z","closed_at":null,"assignee":{"login":"Eskalifer1","id":66723620,"node_id":"MDQ6VXNlcjY2NzIzNjIw","avatar_url":"https://avatars.githubusercontent.com/u/66723620?v=4","gravatar_id":"","url":"https://api.github.com/users/Eskalifer1","html_url":"https://github.com/Eskalifer1","followers_url":"https://api.github.com/users/Eskalifer1/followers","following_url":"https://api.github.com/users/Eskalifer1/following{/other_user}","gists_url":"https://api.github.com/users/Eskalifer1/gists{/gist_id}","starred_url":"https://api.github.com/users/Eskalifer1/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Eskalifer1/subscriptions","organizations_url":"https://api.github.com/users/Eskalifer1/orgs","repos_url":"https://api.github.com/users/Eskalifer1/repos","events_url":"https://api.github.com/users/Eskalifer1/events{/privacy}","received_events_url":"https://api.github.com/users/Eskalifer1/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** 9.4.9-0\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://test-management.browserstack.com/projects/2219752/folder/13176868/test-cases/41237330\n**Email or phone of affected tester (no customers):** N/A\n**Issue reported by:** Applause Internal Team\n**Bug source:** Regression TC Execution\n**Device used:** MacBook Air 26.5 Chrome, iPhone 15 iOS 26.5\n**App Component:** Money Requests\n\n## Action Performed:\n1. Sign in to ND\n2. Create a collect workspace, enable Taxes\n3. Create a new tax, set the name to the Foreign and the value to 10%\n4. Change the 5% tax rate name to Default\n5. Set the Default rate for Workspace currency default and the Foreign for Foreign currency default in Tax settings\n6. Start creating a manual expense in the workspace chat\n7. Enter an amount, ensuring the initial currency is the workspace's default \n8. Click \"Next\"\n9. Scroll down and Verify that the Default rate is applied \n10. Click the back button \n11. Change the currency, click \"Next\"\n12. Verify that the tax rate is changed to the Foreign\n\n## Expected Result:\nThe Tax rate and the amount are changed according to a new currency\n\n## Actual Result:\nThe default workspace currency tax rate is still displayed on the confirmation page and on the expense details after changing the expense currency\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [x] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [ ] Windows: Chrome\n- [x] MacOS: Chrome Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/e5bcf7f7-c9d6-4ee0-a0fa-d7add6467ef3\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n\n> **Applause Internal Information**\n> Exported by: Mita Rachim\n> Bug ID: 7182979\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022067140356654241995\">https://www.upwork.com/jobs/~022067140356654241995</a></li>\n        <li>Upwork Job ID: 2067140356654241995</li>\n        <li>Last Price Increase: 2026-06-24</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @lakchote</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/93772/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/93772/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/66","id":3904273917,"node_id":"I_kwDORGgqa87otn39","number":66,"title":"[BOUNTY] 🔴 Red Team: x402 Payment Protocol Exploits (100 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10119173301,"node_id":"LA_kwDORGgqa88AAAACWyZUtQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/red-team","name":"red-team","color":"D93F0B","default":false,"description":"Adversarial security testing"},{"id":10119173491,"node_id":"LA_kwDORGgqa88AAAACWyZVcw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/hardening","name":"hardening","color":"0052CC","default":false,"description":"Security improvements"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":88,"created_at":"2026-02-06T01:03:30Z","updated_at":"2026-07-06T17:51:30Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Red Team Bounty: x402 Payment Protocol Exploits\n\n**Reward: 100 RTC** (~$10 at reference rate)\n\n### Target\nThe x402/8004 HTTP Payment Protocol implementation merged in Rustchain PR #5 by @erdogan98.\n\n**Code location:** `x402/` directory in Rustchain repo\n\n### What to Attack\n\n1. **Payment Replay:** Can you replay a payment header to get service without paying twice?\n2. **Amount Manipulation:** Can you modify payment amount after signing?\n3. **Receipt Forgery:** Can you forge a valid payment receipt?\n4. **Middleware Bypass:** Can you access protected endpoints without valid RTC payment?\n5. **Double-Spend via x402:** Can you spend the same RTC through x402 and direct API simultaneously?\n6. **Client Impersonation:** Can you use someone else's payment credentials?\n\n### Rules\n- Document each vulnerability with reproduction steps\n- Classify severity (Critical/High/Medium/Low)\n- Suggest fix for each finding\n- Do NOT exploit against production — test locally or on a test node\n- Responsible disclosure: report here first, don't publicize until fixed\n\n### Payout Scale\n| Severity | Bonus |\n|----------|-------|\n| Critical (fund drain) | +100 RTC |\n| High (auth bypass) | +50 RTC |\n| Medium (info leak) | +25 RTC |\n| Low (edge case) | Base 100 RTC |\n\n### Deliverables\n- Security report with PoC for each finding\n- Suggested fixes\n- PR with patches (bonus RTC)\n\n### Claiming\nComment with your security testing background.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/reactions","total_count":9,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":2,"rocket":2,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/66/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/58","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/58/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/58/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/58/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/58","id":3893861852,"node_id":"I_kwDORGgqa87oF53c","number":58,"title":"[BOUNTY] 🔴 Red Team: Cross-Node Consensus Attacks (100 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10119173301,"node_id":"LA_kwDORGgqa88AAAACWyZUtQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/red-team","name":"red-team","color":"D93F0B","default":false,"description":"Adversarial security testing"},{"id":10119173491,"node_id":"LA_kwDORGgqa88AAAACWyZVcw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/hardening","name":"hardening","color":"0052CC","default":false,"description":"Security improvements"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":97,"created_at":"2026-02-04T00:20:49Z","updated_at":"2026-07-06T17:50:30Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 🔴 Red Team Bounty — Consensus & Replication Attacks\n\n**Bounty: 200 RTC (~$20)**\n\n### Target\n\nRustChain runs 3 attestation nodes that should maintain consensus. Can you break it?\n\n### Attack Vectors to Test\n\n1. **Split Brain** — Can you make nodes disagree on balances/state?\n2. **Replay Across Nodes** — Replay valid attestation to different node?\n3. **Database Desync** — Force nodes out of sync?\n4. **Eclipse Attack** — Isolate a node and feed it false data?\n5. **Time Manipulation** — Exploit clock differences between nodes?\n\n### Node Addresses\n\n```\nNode 1: 50.28.86.131 (Primary)\nNode 2: 50.28.86.153 (Ergo Anchor)\nNode 3: 76.8.228.245:8099 (External)\n```\n\n### Deliverable\n\n- Attack methodology\n- Evidence of consensus break (screenshots, logs)\n- Impact assessment\n- Recommended mitigations\n\n### Rules\n\n- Do NOT permanently damage node state\n- Responsible disclosure\n- Document everything\n\n**200 RTC** for valid consensus attacks. Critical findings may earn bonus.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/58/reactions","total_count":4,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/58/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/91063","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/91063/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/91063/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/91063/events","html_url":"https://github.com/Expensify/App/issues/91063","id":4476809337,"node_id":"I_kwDOEQqHYc8AAAABCtaweQ","number":91063,"title":"[$250] Expense - Add bank account button shown even if we already have connected bank account","user":{"login":"jponikarchuk","id":141990088,"node_id":"U_kgDOCHaYyA","avatar_url":"https://avatars.githubusercontent.com/u/141990088?v=4","gravatar_id":"","url":"https://api.github.com/users/jponikarchuk","html_url":"https://github.com/jponikarchuk","followers_url":"https://api.github.com/users/jponikarchuk/followers","following_url":"https://api.github.com/users/jponikarchuk/following{/other_user}","gists_url":"https://api.github.com/users/jponikarchuk/gists{/gist_id}","starred_url":"https://api.github.com/users/jponikarchuk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jponikarchuk/subscriptions","organizations_url":"https://api.github.com/users/jponikarchuk/orgs","repos_url":"https://api.github.com/users/jponikarchuk/repos","events_url":"https://api.github.com/users/jponikarchuk/events{/privacy}","received_events_url":"https://api.github.com/users/jponikarchuk/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893455829,"node_id":"MDU6TGFiZWwyODkzNDU1ODI5","url":"https://api.github.com/repos/Expensify/App/labels/Daily","name":"Daily","color":"eb6420","default":fa