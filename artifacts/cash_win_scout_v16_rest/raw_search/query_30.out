rs/carlosmiceli/followers","following_url":"https://api.github.com/users/carlosmiceli/following{/other_user}","gists_url":"https://api.github.com/users/carlosmiceli/gists{/gist_id}","starred_url":"https://api.github.com/users/carlosmiceli/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/carlosmiceli/subscriptions","organizations_url":"https://api.github.com/users/carlosmiceli/orgs","repos_url":"https://api.github.com/users/carlosmiceli/repos","events_url":"https://api.github.com/users/carlosmiceli/events{/privacy}","received_events_url":"https://api.github.com/users/carlosmiceli/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"dmkt9","id":208698323,"node_id":"U_kgDODHB70w","avatar_url":"https://avatars.githubusercontent.com/u/208698323?v=4","gravatar_id":"","url":"https://api.github.com/users/dmkt9","html_url":"https://github.com/dmkt9","followers_url":"https://api.github.com/users/dmkt9/followers","following_url":"https://api.github.com/users/dmkt9/following{/other_user}","gists_url":"https://api.github.com/users/dmkt9/gists{/gist_id}","starred_url":"https://api.github.com/users/dmkt9/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dmkt9/subscriptions","organizations_url":"https://api.github.com/users/dmkt9/orgs","repos_url":"https://api.github.com/users/dmkt9/repos","events_url":"https://api.github.com/users/dmkt9/events{/privacy}","received_events_url":"https://api.github.com/users/dmkt9/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":72,"created_at":"2026-05-28T14:02:52Z","updated_at":"2026-07-07T02:53:16Z","closed_at":null,"assignee":{"login":"carlosmiceli","id":1166066,"node_id":"MDQ6VXNlcjExNjYwNjY=","avatar_url":"https://avatars.githubusercontent.com/u/1166066?v=4","gravatar_id":"","url":"https://api.github.com/users/carlosmiceli","html_url":"https://github.com/carlosmiceli","followers_url":"https://api.github.com/users/carlosmiceli/followers","following_url":"https://api.github.com/users/carlosmiceli/following{/other_user}","gists_url":"https://api.github.com/users/carlosmiceli/gists{/gist_id}","starred_url":"https://api.github.com/users/carlosmiceli/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/carlosmiceli/subscriptions","organizations_url":"https://api.github.com/users/carlosmiceli/orgs","repos_url":"https://api.github.com/users/carlosmiceli/repos","events_url":"https://api.github.com/users/carlosmiceli/events{/privacy}","received_events_url":"https://api.github.com/users/carlosmiceli/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Background\n\nWhen a report is submitted and the approver account no longer exists, the backend (`ReportAPI.php`) throws an `ExpError` with a descriptive message: _\"The approver account could not be found. A workspace admin must update the approver for this category or tag.\"_ (introduced in [Web-Expensify#51582](https://github.com/Expensify/Web-Expensify/pull/51582), commit [`005ac29`](https://github.com/Expensify/Web-Expensify/commit/005ac2986a67b4278a0f52e838b5c50116067228)).\n\nHowever, the NewDot frontend is **not passing this error message through to the user**. Instead, a generic _\"Unexpected error. Please try again later.\"_ message is displayed, giving the submitter no actionable information.\n\n## Steps to reproduce\n\n1. Have a workspace where an approver account has been deleted / no longer exists.\n2. As a member, open an expense report and click **Submit**.\n3. Observe the generic error toast — the specific approver error message from the backend is not shown.\n\n## Expected behaviour\n\nThe descriptive backend error message should be surfaced to the user (or a clear equivalent), e.g.:\n> _\"The approver account could not be found. A workspace admin must update the approver for this category or tag.\"_\n\n## Actual behaviour\n\nA generic _\"Unexpected error. Please try again later.\"_ is shown. The user has no idea why submission failed or how to fix it.\n\n## Context / references\n\n- Backend error location: [`ReportAPI.php#L3388-L3400`](https://github.com/Expensify/Web-Expensify/blob/151b35fd0fff2849bf7ff7c7c1100625853d87a3/lib/ReportAPI.php#L3388-L3400)\n- Backend change that introduced the new error: [Web-Expensify#51582](https://github.com/Expensify/Web-Expensify/pull/51582)\n- The error uses HTTP status code `666` which may be why the NewDot frontend doesn't recognise and display it correctly.\n\n## Platform\n\nWeb (NewDot)\n\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022060000152310746110\">https://www.upwork.com/jobs/~022060000152310746110</a></li>\n        <li>Upwork Job ID: 2060000152310746110</li>\n        <li>Last Price Increase: 2026-07-02</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @dmkt9</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/91973/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/91973/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/71","id":3904303864,"node_id":"I_kwDORGgqa87otvL4","number":71,"title":"[BOUNTY] Ongoing Bug Bounty Program — Find Bugs, Earn RTC (133 RTC Pool)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029408,"node_id":"LA_kwDORGgqa88AAAACWucZoA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bug","name":"bug","color":"d73a4a","default":true,"description":"Something isn't working"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":432,"created_at":"2026-02-06T01:13:53Z","updated_at":"2026-07-07T02:47:44Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Ongoing Bug Bounty Program\n\n**Pool: 750 RTC (ongoing, replenished as needed)**\n\n### Severity & Rewards\n| Severity | Description | Reward |\n|----------|-------------|--------|\n| **Critical** | Fund theft, consensus bypass, RCE | 100-200 RTC |\n| **High** | Data leak, auth bypass, significant logic error | 50-100 RTC |\n| **Medium** | DoS, info disclosure, moderate bugs | 15-50 RTC |\n| **Low** | UI bugs, minor leaks, doc errors | 5-15 RTC |\n\n### In-Scope\n- RustChain node software, attestation & fingerprint system\n- Epoch settlement & rewards, wallet endpoints\n- BoTTube web app, API, payment system\n- Python SDK, Block Explorer, Wallet GUI, Miner clients\n\n### Reporting\n1. Create GitHub issue with `[SECURITY]` prefix\n2. For critical: email first, issue after fix\n3. Include: steps to reproduce, impact, suggested fix\n\n### Rules\n- First reporter wins\n- Responsible disclosure required\n- Must not exploit on production\n\n---\n*Total RTC supply: 8.3M | RTC Reference Rate: 1 RTC = $0.10 USD*","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/reactions","total_count":11,"+1":5,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":3,"eyes":1},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/71/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2156","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2156/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2156/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2156/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2156","id":4084033846,"node_id":"I_kwDORGgqa87zbWk2","number":2156,"title":"[BOUNTY: 10 RTC] BoTTube — Video Page Customization","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":42,"created_at":"2026-03-16T18:15:08Z","updated_at":"2026-07-07T02:37:11Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 15 RTC\n\n### Task\nImplement the feature described in **Scottcjn/bottube#422**.\n\n### How to claim\n1. Read the full spec: https://github.com/Scottcjn/bottube/issues/422\n2. Open a PR on [Scottcjn/bottube](https://github.com/Scottcjn/bottube) implementing the feature\n3. Comment here with your PR link and wallet address\n4. Partial implementations welcome — bounty scales with scope delivered\n\n### Context\nThese features address real user feedback from [ToolPilot.ai reviews](https://www.toolpilot.ai/products/bottube-1) (currently 86% positive, 7 reviews). We're turning 4-star feedback into 5-star features.\n\n**RTC Value: 15 RTC (~$15.00 at $0.10/RTC reference)**","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2156/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2156/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/455","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/455/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/455/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/455/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/455","id":4002331192,"node_id":"I_kwDORGgqa87ujro4","number":455,"title":"[25 RTC] Dual-Mining: Ergo (Autolykos2) Integration","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":14,"created_at":"2026-02-27T18:34:38Z","updated_at":"2026-07-07T02:35:10Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Ergo Dual-Mining Integration — 25 RTC\n\n**Mine Ergo + earn RTC for free.** RIP-PoA attestation costs zero compute.\n\n### What to Build\n\nImplement and test the Ergo-specific proof path in `clawrtc/data/pow_miners.py`:\n\n1. **Node RPC proof** (1.5x bonus): Query local Ergo node at `localhost:9053/info` — verify `isMining: true`, extract chain height, peer count, best block hash\n2. **Pool account proof** (1.3x bonus): Verify hashrate via HeroMiners, WoolyPooly, Nanopool, or 2miners API\n3. **Server validation**: Add Ergo-specific validation in `validate_pow_proof()` on the RustChain node\n\n### Ergo Node API Reference\n- `GET /info` — node status, mining flag, height\n- `GET /mining/candidate` — current mining candidate (proves active mining)\n- Default port: 9053 (mainnet), 9052 (testnet)\n\n### Testing\n- Run an Ergo node with mining enabled\n- Run `clawrtc mine --pow ergo`\n- Verify proof is generated and accepted by RustChain node\n\n### Acceptance Criteria\n- [ ] Ergo node auto-detected by port + process\n- [ ] Node RPC proof includes chain height + mining status\n- [ ] Pool verification works for at least 2 pools\n- [ ] Nonce binding prevents proof replay\n- [ ] Unit tests pass\n\nSee master issue: #453","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/455/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/455/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/458","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/458/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/458/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/458/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/458","id":4002331744,"node_id":"I_kwDORGgqa87ujrxg","number":458,"title":"[25 RTC] Dual-Mining: Monero (RandomX) Integration","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":18,"created_at":"2026-02-27T18:34:43Z","updated_at":"2026-07-07T02:35:10Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Monero Dual-Mining Integration — 25 RTC\n\n**Mine XMR + earn RTC for free.** RandomX is CPU-optimized.\n\n### What to Build\n\n1. **Node RPC proof** (1.5x bonus): Query monerod at `localhost:18081/json_rpc`\n2. **P2Pool proof**: Query local P2Pool at `localhost:18083/local/stats`\n3. **Pool account proof** (1.3x bonus): Verify via HeroMiners or Nanopool\n4. **Process detection**: Detect `xmrig`, `monerod`, `p2pool`, `xmr-stak`\n\n### XMR API Reference\n- `POST /json_rpc` with `{\"method\": \"get_info\"}` — height, difficulty, tx pool\n- Default ports: 18081 (RPC), 18082 (restricted), 18083 (P2Pool)\n\n### Why Monero Miners Love This\nXMRig uses 100% of CPU for RandomX hashing. RIP-PoA runs during attestation windows (5 sec every 10 min) — negligible impact.\n\nSee master issue: #453","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/458/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/458/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/453","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/453/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/453/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/453/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/453","id":4001999654,"node_id":"I_kwDORGgqa87uiasm","number":453,"title":"[50 RTC] Dual-Mining Integration: Earn RTC While Mining PoW Coins","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":26,"created_at":"2026-02-27T17:08:00Z","updated_at":"2026-07-07T02:34:18Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Dual-Mining: Free RTC on Top of Your PoW Rewards\n\n### The Concept\n\nRustChain RIP-PoA (Proof of Antiquity) doesn't do algorithmic hashing — it just fingerprints your hardware to prove it's real. **If you're already mining Ergo, Warthog, Kaspa, Monero, or any CPU/GPU coin, you can earn RTC attestation rewards simultaneously at ZERO additional compute cost.**\n\nYour PoW miner keeps 100% of CPU/GPU for hashing. RTC is literally free money on top.\n\n### How It Works\n\n1. Run your normal PoW miner (xmrig, ergo node, wart-miner, etc.)\n2. Also run `clawrtc mine --pow` alongside it\n3. clawrtc auto-detects your running miner and generates a proof\n4. The proof gets submitted with your hardware attestation\n5. You earn a **bonus multiplier** on your RTC rewards:\n\n| Proof Type | Bonus | How |\n|------------|-------|-----|\n| Node RPC (full node) | **1.5x** | clawrtc queries your local node |\n| Pool account (verified) | **1.3x** | clawrtc checks pool API |\n| Process detection | **1.15x** | clawrtc detects miner process |\n\n### Supported Chains\n\n| Chain | Algorithm | Type |\n|-------|-----------|------|\n| Ergo | Autolykos2 | CPU/GPU |\n| Warthog | Janushash | CPU |\n| Kaspa | kHeavyHash | GPU |\n| Monero | RandomX | CPU |\n| Verus | VerusHash 2.2 | CPU |\n| Alephium | Blake3 | CPU/GPU |\n| Zephyr | RandomX | CPU |\n| Neoxa | KawPow | GPU |\n\n### Master Bounty (75 RTC) — Server-Side Validation\n\n1. Add `pow_mining_proofs` table to RustChain node DB\n2. Add `validate_pow_proof()` to `/attest/submit` endpoint\n3. Integrate PoW bonus into reward calculation\n4. Anti-cheat: nonce binding, proof expiration, rate limiting\n5. Tests for each proof type\n\n### Client Code (Already Started)\n\nDetection module: `clawrtc/data/pow_miners.py` — auto-detects 8 PoW chains.\n\n```bash\npip install clawrtc\npython -c \"from clawrtc.data.pow_miners import detect_running_miners, print_detection_report; print_detection_report(detect_running_miners())\"\n```\n\n### Why This Matters\n\n- **For miners**: Free RTC income with zero compute overhead\n- **For RustChain**: More attestation nodes = stronger network security\n- **For ecosystem**: Cross-pollination between PoW mining communities\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/453/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/453/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2161","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2161/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2161/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2161/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2161","id":4084034331,"node_id":"I_kwDORGgqa87zbWsb","number":2161,"title":"[BOUNTY: 17 RTC] BoTTube — Creator Collaboration Features","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":53,"created_at":"2026-03-16T18:15:15Z","updated_at":"2026-07-07T02:33:02Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: 25 RTC\n\n### Task\nImplement the feature described in **Scottcjn/bottube#427**.\n\n### How to claim\n1. Read the full spec: https://github.com/Scottcjn/bottube/issues/427\n2. Open a PR on [Scottcjn/bottube](https://github.com/Scottcjn/bottube) implementing the feature\n3. Comment here with your PR link and wallet address\n4. Partial implementations welcome — bounty scales with scope delivered\n\n### Context\nThese features address real user feedback from [ToolPilot.ai reviews](https://www.toolpilot.ai/products/bottube-1) (currently 86% positive, 7 reviews). We're turning 4-star feedback into 5-star features.\n\n**RTC Value: 25 RTC (~$25.00 at $0.10/RTC reference)**","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2161/reactions","total_count":5,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":2,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2161/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/64","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/64/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/64/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/64/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/64","id":3904246891,"node_id":"I_kwDORGgqa87othRr","number":64,"title":"[BOUNTY] RustChain <-> BoTTube Bridge — Earn RTC by Creating Content (67 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10115035932,"node_id":"LA_kwDORGgqa88AAAACWuczHA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/major","name":"major","color":"F9D0C4","default":false,"description":"50-200 RTC"},{"id":10119175842,"node_id":"LA_kwDORGgqa88AAAACWyZeog","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/ecosystem","name":"ecosystem","color":"7B5EA7","default":false,"description":"Integrations & exchange listings"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":11,"created_at":"2026-02-06T00:52:33Z","updated_at":"2026-07-07T02:29:28Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty: RustChain <-> BoTTube Bridge\n\n**Reward: 100 RTC** (~$10 at reference rate)\n\n### Background\nRustChain miners earn RTC through hardware attestation. BoTTube creators should also earn RTC through content creation.\n\n### Requirements\n\n1. **Content Rewards:** Video uploads, view/subscriber milestones earn RTC\n2. **Tipping System:** Viewers tip creators with RTC (min 0.001 RTC)\n3. **Bridge Service:** Daemon monitors BoTTube API, credits RTC via signed transfers\n4. **Anti-Abuse:** Rate limits, view verification, min video length\n\n### Deliverables\n- `bottube_bridge.py` — Bridge daemon\n- Config file for reward rates\n- Deployment instructions\n- PR to this repo\n\n### Claiming\nComment with your approach to anti-abuse.","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/64/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confuse