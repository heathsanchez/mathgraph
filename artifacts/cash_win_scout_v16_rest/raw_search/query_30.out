ing_url":"https://api.github.com/users/linhvovan29546/following{/other_user}","gists_url":"https://api.github.com/users/linhvovan29546/gists{/gist_id}","starred_url":"https://api.github.com/users/linhvovan29546/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/linhvovan29546/subscriptions","organizations_url":"https://api.github.com/users/linhvovan29546/orgs","repos_url":"https://api.github.com/users/linhvovan29546/repos","events_url":"https://api.github.com/users/linhvovan29546/events{/privacy}","received_events_url":"https://api.github.com/users/linhvovan29546/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":37,"created_at":"2026-06-17T15:20:42Z","updated_at":"2026-07-07T02:15:02Z","closed_at":null,"assignee":{"login":"mountiny","id":36083550,"node_id":"MDQ6VXNlcjM2MDgzNTUw","avatar_url":"https://avatars.githubusercontent.com/u/36083550?v=4","gravatar_id":"","url":"https://api.github.com/users/mountiny","html_url":"https://github.com/mountiny","followers_url":"https://api.github.com/users/mountiny/followers","following_url":"https://api.github.com/users/mountiny/following{/other_user}","gists_url":"https://api.github.com/users/mountiny/gists{/gist_id}","starred_url":"https://api.github.com/users/mountiny/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mountiny/subscriptions","organizations_url":"https://api.github.com/users/mountiny/orgs","repos_url":"https://api.github.com/users/mountiny/repos","events_url":"https://api.github.com/users/mountiny/events{/privacy}","received_events_url":"https://api.github.com/users/mountiny/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"parent_issue_url":"https://api.github.com/repos/Expensify/App/issues/91302","issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Sentry\n\nhttps://expensify.sentry.io/issues/APP-9Y9\n\n## Impact (snapshot at filing)\n\n- Users (total since first seen): 27\n- Events: 45\n- Users (last 14d, 9.4.x releases): 9\n- First seen: 2026-04-11\n- Last seen: ongoing\n- Platform: iOS HybridApp\n- App version(s): 9.4.5–9.4.9\n- Affected route(s): unknown (Fabric mounting)\n- Mechanism: cpp_exception / native\n\n## Stack trace (top frames, first-party only)\n\n```\nfacebook::react::MountingCoordinator::pullTransaction\n```\n\n## Suspected cause\n\nReact Native Fabric mounting coordinator crash during transaction pull — needs native RN investigation.\n\n## Reproduction\n\nUnknown — see Sentry events linked from the Sentry issue.\n\n## Related\n\n- Prior GH issues: none\n\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022067266240143914195\">https://www.upwork.com/jobs/~022067266240143914195</a></li>\n        <li>Upwork Job ID: 2067266240143914195</li>\n        <li>Last Price Increase: 2026-07-01</li>\n    </ul>\n</details>\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @linhvovan29546</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/93842/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/93842/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Expensify/App/issues/93089","repository_url":"https://api.github.com/repos/Expensify/App","labels_url":"https://api.github.com/repos/Expensify/App/issues/93089/labels{/name}","comments_url":"https://api.github.com/repos/Expensify/App/issues/93089/comments","events_url":"https://api.github.com/repos/Expensify/App/issues/93089/events","html_url":"https://github.com/Expensify/App/issues/93089","id":4623432426,"node_id":"I_kwDOEQqHYc8AAAABE5P66g","number":93089,"title":"[$250] Agent - \"Account\" page becomes blank with browser back button after an agent being copiloted","user":{"login":"applause-bot[bot]","id":265651874,"node_id":"BOT_kgDOD9WGog","avatar_url":"https://avatars.githubusercontent.com/in/3009811?v=4","gravatar_id":"","url":"https://api.github.com/users/applause-bot%5Bbot%5D","html_url":"https://github.com/apps/applause-bot","followers_url":"https://api.github.com/users/applause-bot%5Bbot%5D/followers","following_url":"https://api.github.com/users/applause-bot%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/applause-bot%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/applause-bot%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/applause-bot%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/applause-bot%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/applause-bot%5Bbot%5D/repos","events_url":"https://api.github.com/users/applause-bot%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/applause-bot%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[{"id":2873246102,"node_id":"MDU6TGFiZWwyODczMjQ2MTAy","url":"https://api.github.com/repos/Expensify/App/labels/External","name":"External","color":"a7b8ef","default":false,"description":"Added to denote the issue can be worked on by a contributor"},{"id":2893455829,"node_id":"MDU6TGFiZWwyODkzNDU1ODI5","url":"https://api.github.com/repos/Expensify/App/labels/Daily","name":"Daily","color":"eb6420","default":false,"description":"KSv2"},{"id":3136662525,"node_id":"MDU6TGFiZWwzMTM2NjYyNTI1","url":"https://api.github.com/repos/Expensify/App/labels/Help%20Wanted","name":"Help Wanted","color":"CFC8F1","default":false,"description":"Apply this label when an issue is open to proposals by contributors"},{"id":4664850679,"node_id":"LA_kwDOEQqHYc8AAAABFgv49w","url":"https://api.github.com/repos/Expensify/App/labels/Bug","name":"Bug","color":"93074F","default":false,"description":"Something is broken. Auto assigns a BugZero manager."}],"state":"open","locked":false,"assignees":[{"login":"gijoe0295","id":153004152,"node_id":"U_kgDOCR6oeA","avatar_url":"https://avatars.githubusercontent.com/u/153004152?v=4","gravatar_id":"","url":"https://api.github.com/users/gijoe0295","html_url":"https://github.com/gijoe0295","followers_url":"https://api.github.com/users/gijoe0295/followers","following_url":"https://api.github.com/users/gijoe0295/following{/other_user}","gists_url":"https://api.github.com/users/gijoe0295/gists{/gist_id}","starred_url":"https://api.github.com/users/gijoe0295/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gijoe0295/subscriptions","organizations_url":"https://api.github.com/users/gijoe0295/orgs","repos_url":"https://api.github.com/users/gijoe0295/repos","events_url":"https://api.github.com/users/gijoe0295/events{/privacy}","received_events_url":"https://api.github.com/users/gijoe0295/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":42,"created_at":"2026-06-09T15:41:25Z","updated_at":"2026-07-07T02:12:00Z","closed_at":null,"assignee":{"login":"gijoe0295","id":153004152,"node_id":"U_kgDOCR6oeA","avatar_url":"https://avatars.githubusercontent.com/u/153004152?v=4","gravatar_id":"","url":"https://api.github.com/users/gijoe0295","html_url":"https://github.com/gijoe0295","followers_url":"https://api.github.com/users/gijoe0295/followers","following_url":"https://api.github.com/users/gijoe0295/following{/other_user}","gists_url":"https://api.github.com/users/gijoe0295/gists{/gist_id}","starred_url":"https://api.github.com/users/gijoe0295/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gijoe0295/subscriptions","organizations_url":"https://api.github.com/users/gijoe0295/orgs","repos_url":"https://api.github.com/users/gijoe0295/repos","events_url":"https://api.github.com/users/gijoe0295/events{/privacy}","received_events_url":"https://api.github.com/users/gijoe0295/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"If you haven’t already, check out our [contributing guidelines](https://github.com/Expensify/ReactNativeChat/blob/main/contributingGuides/CONTRIBUTING.md) for onboarding and email contributors@expensify.com to request to join our Slack channel!\n___\n\n**Version Number:** 9.4.1-4\n**Reproducible in staging?:** Yes\n**Reproducible in production?:** Yes\n**If this was caught during regression testing, add the test name, ID and link from BrowserStack:** https://github.com/Expensify/App/pull/92102\n**Email or phone of affected tester (no customers):** applausetester+ib0005@applause.expensifail.com\n**Issue reported by:** Applause Internal Team\n**Bug source:** Exploratory - Significant User Experience Deterioration\n**Device used:** Windows 11 / Chrome\n**App Component:** User Settings\n\n## Action Performed:\nPrerequisite: Use an expensifail account.\nPrerequisite 2: At least one agent available.\n1. Open the staging.new.expensify.com website.\n2. Navigate to \"Account\" > \"Agents\"\n3. Click on \"Edit\" on an agent.\n4. Scroll down and click on \"Copilot into account\"\n5. After landing on \"Profile\", use browser´s back button.\n6. Note that \"Accounts\" page becomes blank.\n\n## Expected Result:\nUsing browser´s back button after an agent being copiloted, should redirect to the section navigated before opening \"Agents\" page.\n\n## Actual Result:\n\"Accounts\" page becomes blank when using browser´s back button after an agent being copiloted.\n\n## Workaround:\nUnknown\n\n## Platforms:\n- [ ] Android: App\n- [ ] Android: mWeb Chrome\n- [ ] iOS: App\n- [ ] iOS: mWeb Safari\n- [ ] iOS: mWeb Chrome\n- [x] Windows: Chrome\n- [ ] MacOS: Chrome Safari\n\n## Screenshots/Videos\n\nhttps://github.com/user-attachments/assets/1b491c44-7657-4f9e-a700-2c8d74ce2e34\n\n[View all open jobs on GitHub](https://github.com/Expensify/App/issues?q=is%3Aopen+is%3Aissue+label%3A%22Help+Wanted%22)\n\n\n> **Applause Internal Information**\n> Exported by: Svetlana Lazutkina\n> Bug ID: 7176034\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: <a href=\"https://www.upwork.com/jobs/~022064374446761350074\">https://www.upwork.com/jobs/~022064374446761350074</a></li>\n        <li>Upwork Job ID: 2064374446761350074</li>\n        <li>Last Price Increase: 2026-06-30</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/App/issues/93089/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Expensify/App/issues/93089/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/NicoviGH/manchego-stars/issues/23","repository_url":"https://api.github.com/repos/NicoviGH/manchego-stars","labels_url":"https://api.github.com/repos/NicoviGH/manchego-stars/issues/23/labels{/name}","comments_url":"https://api.github.com/repos/NicoviGH/manchego-stars/issues/23/comments","events_url":"https://api.github.com/repos/NicoviGH/manchego-stars/issues/23/events","html_url":"https://github.com/NicoviGH/manchego-stars/issues/23","id":4558399450,"node_id":"I_kwDOSpuPwc8AAAABD7On2g","number":23,"title":"Ch3 — map + events (The Termalaine Mine)","user":{"login":"NicoviGH","id":130102403,"node_id":"U_kgDOB8E0gw","avatar_url":"https://avatars.githubusercontent.com/u/130102403?v=4","gravatar_id":"","url":"https://api.github.com/users/NicoviGH","html_url":"https://github.com/NicoviGH","followers_url":"https://api.github.com/users/NicoviGH/followers","following_url":"https://api.github.com/users/NicoviGH/following{/other_user}","gists_url":"https://api.github.com/users/NicoviGH/gists{/gist_id}","starred_url":"https://api.github.com/users/NicoviGH/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NicoviGH/subscriptions","organizations_url":"https://api.github.com/users/NicoviGH/orgs","repos_url":"https://api.github.com/users/NicoviGH/repos","events_url":"https://api.github.com/users/NicoviGH/events{/privacy}","received_events_url":"https://api.github.com/users/NicoviGH/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":11071155191,"node_id":"LA_kwDOSpuPwc8AAAACk-Rr9w","url":"https://api.github.com/repos/NicoviGH/manchego-stars/labels/content","name":"content","color":"0e8a16","default":false,"description":"Campaign-specific data (PCs, chapters, dialogue, maps)"}],"state":"open","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/NicoviGH/manchego-stars/milestones/4","html_url":"https://github.com/NicoviGH/manchego-stars/milestone/4","labels_url":"https://api.github.com/repos/NicoviGH/manchego-stars/milestones/4/labels","id":16111062,"node_id":"MI_kwDOSpuPwc4A9dXW","number":4,"title":"M3: 8 Chapters Playable","description":null,"creator":{"login":"NicoviGH","id":130102403,"node_id":"U_kgDOB8E0gw","avatar_url":"https://avatars.githubusercontent.com/u/130102403?v=4","gravatar_id":"","url":"https://api.github.com/users/NicoviGH","html_url":"https://github.com/NicoviGH","followers_url":"https://api.github.com/users/NicoviGH/followers","following_url":"https://api.github.com/users/NicoviGH/following{/other_user}","gists_url":"https://api.github.com/users/NicoviGH/gists{/gist_id}","starred_url":"https://api.github.com/users/NicoviGH/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NicoviGH/subscriptions","organizations_url":"https://api.github.com/users/NicoviGH/orgs","repos_url":"https://api.github.com/users/NicoviGH/repos","events_url":"https://api.github.com/users/NicoviGH/events{/privacy}","received_events_url":"https://api.github.com/users/NicoviGH/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":14,"closed_issues":13,"state":"open","created_at":"2026-05-27T20:57:46Z","updated_at":"2026-07-07T01:00:46Z","due_on":null,"closed_at":null},"comments":8,"created_at":"2026-05-31T17:34:20Z","updated_at":"2026-07-07T01:52:30Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Goal:** ship Ch3 \"The Termalaine Mine\" as a playable **vertical slice** — ch02 → ch03 end-to-end → hand to ch04. Reskins vanilla **FE8 Ch3 \"The Bandits of Borgo\"** (the game's first chests + first thief) as Termalaine's kobold-overrun tourmaline mine. Design locked & grounded in the FE8 decomp, the DM notes, and the Frostmaiden book \"A Beautiful Mine\" (pp.93–96). Rationale/deviations: `docs/decisions.md` → Ch3 ADR (2026-06-26, four deviations) + the 2026-07-06 narrative reframe note in the ch03 YAML `design_notes`.\n\n### Design summary (locked)\n- **Identity:** the thief/chests/doors dungeon battle. Teaching goal = the thief utility (Trex = our Colm), made to matter by door/chest-gated rooms. **Also the monster foe-type debut** (moved here from ch04 — the Grell is a real Mogall and the party's chronologically-first monster).\n- **Structure:** rooms-on-ONE-flat-map (FE8 has no z-levels) — walled chambers + `TERRAIN_DOOR`. Tool-room entrance → kobold galleries → river-cavern pinch → processing room → deep workings (grell lair).\n- **Objective:** **Defeat Boss** — kill the grell at the deep-workings tile (14,1). Deviation from vanilla Ch3's Seize (2026-07-06, Nicolas; decisions.md item 4) — reads truer for slaying an aberration than capturing a throne.\n- **Enemies:** 1:1 reskin of vanilla Ch3's 10-slot force — Icewind kobolds + a **Svirfneblin Skulk** (the vanilla thief slot; not a rat, since RBG & Pinky are the party's rats) + the **Grell (Mogall L12, Evil Eye)** as the boss, **visible from turn 1** (like vanilla Bazba). **Parity verified** (`make difficulty CH=ch03`): clear-load ×0.99, threat ×1.12 (within band).\n- **Rewards:** 4 chests (Iron Lance / Iron Sword / Javelin / **pink Tourmaline = Red Gem 2,500g**), Trex-opened; two kobolds drop Door/Chest keys as backup. The ch02↔ch03 gem/hand-axe swap keeps total wealth = vanilla (ADR).\n- **Recruit:** **Trex** (canon winged kobold leader) defects mid-map. The enemy kobolds are a **feral splinter** he's purging to clear his warren's name (2026-07-06 reframe — resolves \"why help us fight kobolds\").\n- **Signature beats:** RBG's gunpoint execution of a *feral* kobold + Wolfram's ore-snacking; Pinky's shaft-scout now folds into the **opening** cutscene (the grell is visible up top from the start).\n\n### Vertical-slice checklist\n- [x] **Design locked** — decomp + DM notes + book; deviations in `decisions.md` (four ADR deviations + the 2026-07-06 objective/narrative reframe)\n- [x] **Enemy roster + parity** — 1:1 vanilla-Ch3 reskin; grell=Mogall L12; svirfneblin=vanilla thief slot; `make difficulty` = PARITY\n- [x] **Reward/economy locked** — 4 chests (3 mine-tools + tourmaline); ch02↔ch03 swap; on-curve\n- [x] **Onboarding ledger** — `introduces:` thief + monsters; `make check` clean\n- [x] **Dialogue locked (PARTIALLY SUPERSEDED)** — the #97 beats were locked 2026-06-29, but the **2026-07-06 narrative reframe** (feral faction / Trex motive / RBG executes a feral one / grell visible / Pinky scout → opening) changes the opening + RBG-execution/Trex-recruit beats → they need a **dialogue-pass re-pass** before wiring (see Cutscenes below).\n- [x] **Map built** — painted on `cave-interior` via `gen_map_editor` (eyedropper + vanilla-Borgo ref) → `import_map_layout` → `maps/ch03-the-termalaine-mine.mar` (17×16); renders in-engine.\n- [x] **Host chapter** — `inject_ch03` hosts vanilla slot 4 (Ch4 symbols); `cave-interior` tileset self-registers; `--ch03-boot` fast-boot + `mapshot` load-test **PASS** (chapter 4, units deployed). Runbook: `docs/adding-a-chapter.md`.\n  - [ ] **Chain it:** ch02 ending `MNC2(0x4)` → ch03 (drop the ch02 dev-placeholder landing) so the campaign flows ch02→ch03.\n- [x] **Units placed** — party at the left entrance + 10 enemies at the vanilla-Ch3 tiles (grell@14,1), items/keys restored to vanilla.\n  - [ ] **Real PREP deploy** — author `deployment.deploy_slots` (9 tiles) in the YAML + `PREP` CALL (currently a static fast-boot spawn, no prep screen).\n  - [ ] **Trex recruit** wiring (defect mid-map; talk/auto-join).\n- [ ] **Objective wiring (Defeat Boss)** — goal banner shows \"Defeat boss\" ✓. REMAINING: the `DefeatBoss(grell)` **WIN trigger** + a flagged `EVFLAG_DEFEAT_BOSS` grell defeat quote + the ending scene (see `inject_prologue` defeat-boss pattern + `docs/adding-a-chapter.md` step 7).\n- [ ] **Cutscenes wired** — run a **dialogue-pass** on the reframed beats (opening w/ the visible grell + Pinky scout; RBG executes a feral kobold + Trex defects w/ his clear-our-name motive; ending), then wire them (#58 opaque-box narration). The grell's mid-battle-reveal/map-change is dropped (visible from turn 1).\n- [ ] **Art** — show Nicolas before commit. Kobold bases **locked 2026-07-06** (Klokinator/FE-Repo, F2U/F2E — see the \"Kobold art bases\" comment for sources/previews):\n  - [ ] **Icewind kobold grunts** (the `brigand`/thrower/key-dropper axe slots) — base **Lizard Brigand Wildling**: map sprite `Brigand (U) Lizard Wildling {Tarantino500}` + battle anim by **Lenh** (Axe / Handaxe / Unarmed). Map sprite wired via `enemy_class_reskins` (clone `CLASS_BRIGAND`→unused slot, like the Ch1 Fire Imp goblins); anim via the battle-anim inject.\n  - [ ] **Icewind Brute + Kobold Skirmisher** (the `kobold-steel` brute + the `mercenary`/blade slot) — base **Lizardzerker**: map sprite `Berserker (M) Lizardzerker Axe {Seliost1}` + anim by **Seliost1** (Sword / Axe / Handaxe / Magic / Unarmed — flexes to axe-brute *and* blade).\n  - [ ] **Kobold Slinger** (the lone `archer`/bow slot) — no lizard **bow** anim exists in the repo; map-sprite reskin only (lizard overworld sprite, vanilla archer battle anim) unless we commission/graft one.\n  - [ ] **Trex** (winged kobold recruit, Thief chassis) — reskin the Thief onto the **Lizard Brigand Wildling** pixels (Nicolas 2026-07-06) + cosmetic wings; custom bust (#19/#38). Art-only override — mechanics stay vanilla Thief.\n  - [ ] **Grell** (Mogall reskin: portrait + map sprite, ref book p.96).\n  - [ ] **Svirfneblin Skulk** (the vanilla thief slot — a deep gnome, *not* a kobold; separate sprite).\n- [ ] **Title card** — chapter-title text set; the **\"Ch.3: The Termalaine Mine\" image** still to compose (vanilla letterforms, `_write_chapter_title_card`).\n- [ ] **Load-test** — `mapshot` (New Game→map, `PT_HOST_CHAPTER=4`) **PASS** ✓. REMAINING: `ch03` / `smoke_ch03` / `clear_ch03` scenarios (mirror ch02) + pacing sign-off.\n\nDepends on #40 (map pipeline — done for cave maps) and #14 (event injection). Tracked under #49 ① Content. The ch02↔ch03 reward swap also touches `ch02-cold-welcome.yaml` (chwinga-mote gift).\n\n---\n_Progress 2026-07-06 (host + deploy + fast-boot landed):_ `inject_ch03` hosts the painted map on slot 4 with the full roster deployed; `--ch03-boot` + the new reusable `mapshot` scenario give an in-engine load-test (map + units + \"Defeat boss\" banner confirmed). The repeatable host-a-chapter process is now documented in `docs/adding-a-chapter.md`. Remaining ch03 work is the unchecked items above (win-wiring, real PREP, cutscene re-pass, recruit, art, title card, chaining, full load-test scenarios).\n\n","reactions":{"url":"https://api.github.com/repos/NicoviGH/manchego-stars/issues/23/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/NicoviGH/manchego-stars/issues/23/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2819","id":4203177266,"node_id":"I_kwDORGgqa876h2Uy","number":2819,"title":"[BOUNTY] Red Team UTXO Implementation — Find Bugs, Earn RTC (33-133 RTC)","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029422,"node_id":"LA_kwDORGgqa88AAAACWucZrg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10334947395,"node_id":"LA_kwDORGgqa88AAAACaALIQw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/security","name":"security","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":176,"created_at":"2026-04-04T03:03:17Z","updated_at":"2026-07-07T01:44:51Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Overview\n\nRustChain is migrating from an account-based balance model to a full UTXO (Unspent Transaction Output) model. **Phase 1+2 just landed** in [`39bf02b`](https://github.com/Scottcjn/Rustchain/commit/39bf02b).\n\nWe want adversarial eyes on this before enabling dual-write on production. Break it, get paid.\n\n## Files to Review\n\nAll in the [`node/`](https://github.com/Scottcjn/Rustchain/tree/main/node) directory of the main Rustchain repo:\n\n| File | Lines | Purpose |\n|------|-------|---------|\n| `utxo_db.py` | ~708 | Core UTXO database layer — UTXOs, transactions, mempool, Merkle roots, coin selection |\n| `test_utxo_db.py` | ~421 | 29 unit tests covering the UTXO layer |\n| `utxo_genesis_migration.py` | ~272 | Deterministic migration of 538 existing account balances into genesis UTXOs |\n| `rustchain_v2_integrated_v2.2.1_rip200.py` | (diff) | Server integration — imports + table init behind `UTXO_DUAL_WRITE` feature flag |\n\n## What to Look For\n\n### Critical Vectors (200 RTC)\n- **Double-spend attacks** — Can the same UTXO be consumed twice? Race conditions in `apply_transaction()`?\n- **Fund creation from nothing** — Can a transaction create more RTC in outputs than exists in inputs?\n- **Genesis migration tampering** — Can the migration be re-run to duplicate balances?\n\n### High Severity (100 RTC)\n- **Race conditions** — Concurrent transaction application, TOCTOU between validation and commitment\n- **Conservation law bypass** — Any path where `sum(inputs) != sum(outputs) + fee`\n- **Lock/unlock logic errors** — Can locked UTXOs be spent? Can spending bypass the lock check?\n\n### Medium Severity (50 RTC)\n- **Mempool DoS** — Can the mempool be flooded or manipulated to block legitimate transactions?\n- **Merkle state root manipulation** — Can the state root be made to diverge between nodes?\n- **Fee calculation exploits** — Negative fees, integer overflow in fee math, fee-free transactions that should require fees\n\n### Low Severity (25 RTC)\n- **Coin selection edge cases** — Pathological wallet states that break coin selection\n- **Code quality issues** — SQL injection vectors, unchecked error paths, missing validations\n- **Test coverage gaps** — Important scenarios not covered by the 29 existing tests\n\n## How to Submit\n\n**Option A (preferred):** Open a PR on [Scottcjn/Rustchain](https://github.com/Scottcjn/Rustchain) with a **failing test case** that demonstrates the bug. Title it `[UTXO-BUG] <description>`.\n\n**Option B:** Open an issue on this repo with a detailed writeup including:\n1. The vulnerability class\n2. Steps to reproduce\n3. Expected vs actual behavior\n4. Suggested fix (optional but earns bonus)\n\n## Bounty Tiers Summary\n\n| Severity | Payout | Examples |\n|----------|--------|----------|\n| **Critical** | **200 RTC** | Double-spend, fund creation, genesis duplication |\n| **High** | **100 RTC** | Race conditions, conservation bypass |\n| **Medium** | **50 RTC** | Mempool DoS, Merkle manipulation |\n| **Low** | **25 RTC** | Edge cases, code quality, test gaps |\n\nMultiple valid findings from the same researcher will each be paid individually.\n\n## Context\n\n- RTC reference rate: **1 RTC = $0.10 USD**\n- The UTXO layer is behind a feature flag (`UTXO_DUAL_WRITE=0` by default) — it is NOT active on the live network yet\n- The existing account-based model continues to handle all production transactions\n- This is a pre-production security review before we flip the switch\n\n## Resources\n\n- [RustChain Node Health](https://50.28.86.131/health)\n- [Block Explorer](https://50.28.86.131/explorer)\n- [Active Miners API](https://50.28.86.131/api/miners)","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/reactions","total_count":15,"+1":5,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":1,"rocket":5,"eyes":2},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2819/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/747","id":4037177278,"node_id":"I_kwDORGgqa87wom--","number":747,"title":"[BOUNTY: 50-75 RTC] Bounty Verification Bot — Auto-Verify Star/Follow Claims","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035932,"node_id":"LA_kwDORGgqa88AAAACWuczHA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/major","name":"major","color":"F9D0C4","default":false,"description":"50-200 RTC"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"},{"id":10356027005,"node_id":"LA_kwDORGgqa88AAAACaURufQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/development","name":"development","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":202,"created_at":"2026-03-07T03:24:23Z","updated_at":"2026-07-07T01:43:27Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Bounty Verification Bot\n\nWe spend hours every session manually checking star counts, follow status, wallet existence, and article links. A bot that auto-verifies claims would save massive time.\n\n### What to Build\n\nA GitHub Action or bot that monitors bounty issue comments, detects claims, and posts automated verification results.\n\n### Payout\n\n| Milestone | Reward |\n|-----------|--------|\n| Star/follow verification (reads comment, checks GitHub API, posts result) | **30 RTC** |\n| Wallet existence check (queries RustChain node API) | **+10 RTC** |\n| Article/URL verification (checks dev.to/Medium links are live) | **+10 RTC** |\n| Dev.to article word count + quality check | **+10 RTC** |\n| Duplicate claim detection (checks if user already claimed) | **+15 RTC** |\n\n### How It Should Work\n\n1. **Triggered by**: New comment on bounty issues containing keywords like \"Claiming\", \"Wallet:\", \"Stars:\", \"GitHub:\"\n2. **Checks performed**:\n   - Does user follow @Scottcjn? (`GET /users/{user}/following/Scottcjn` → 204 = yes)\n   - How many Scottcjn repos has user starred? (paginate `/users/{user}/starred`)\n   - Does the claimed wallet exist? (`GET https://50.28.86.131/wallet/balance?miner_id={wallet}`)\n   - Is the claimed article URL live? (HEAD request, check 200)\n   - Has this user already been paid? (check for \"PAID\" in previous comments)\n3. **Posts a verification comment**:\n```\n## Automated Verification for @username\n\n| Check | Result |\n|-------|--------|\n| Follows @Scottcjn | ✅ Yes |\n| Scottcjn repos starred | 45 |\n| Wallet `my-wallet` exists | ✅ Balance: 10.5 RTC |\n| Article link | ✅ Live (dev.to, 612 words) |\n| Previous claims | ⚠️ Paid 25 RTC on #665 |\n\n**Suggested payout**: 45 stars × 1.0 RTC (follows + 45+ multiplier) = 45 RTC\n```\n\n### Technical Requirements\n\n1. **GitHub Action** (preferred) — runs on `issue_comment` webhook\n2. **Secrets needed**: `GITHUB_TOKEN` (for API), `RUSTCHAIN_NODE_URL`\n3. **Rate limit aware** — GitHub API has limits, batch requests efficiently\n4. **No payment execution** — bot ONLY verifies, human approves payment\n5. **Configurable** — bounty rules (rate per star, follow multiplier) in a config file\n6. **Open source** on GitHub\n\n### Why This Matters\n\nManual verification takes 2-5 minutes per claim. With 20+ claims per session, that's over an hour of repetitive API checking. The bot does it in seconds and never makes math errors.\n\nThe human (Scott) still decides whether to pay — the bot just eliminates the grunt work.\n\n### Submit As\n\nStandalone repo with GitHub Action workflow, or PR to a new `Scottcjn/bounty-bot` repo.\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/reactions","total_count":4,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/747/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/755","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/755/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/755/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/755/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/755","id":4037177391,"node_id":"I_kwDORGgqa87wonAv","number":755,"title":"[BOUNTY: 10 RTC] Automated Backup Verification — Validate RustChain DB Backups","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10356027005,"node_id":"LA_kwDORGgqa88AAAACaURufQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/development","name":"development","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":27,"created_at":"2026-03-07T03:24:28Z","updated_at":"2026-07-07T01:41:47Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Automated Backup Verification\n\nThe node backs up the SQLite DB, but nobody verifies the backups are valid. A script that tests backup integrity prevents silent data loss.\n\n### Payout\n\n**10 RTC** for a working verification script.\n\n### What to Build\n\nA script that:\n\n1. Finds the latest backup file (`rustchain_v2.db.bak` or similar)\n2. Copies it to a temp location\n3. Runs SQLite integrity check: `PRAGMA integrity_check;`\n4. Verifies key tables exist and have data:\n   - `balances` — has rows with positive amounts\n   - `miner_attest_recent` — has recent attestations\n   - `headers` — has block headers\n   - `ledger` — has transactions\n   - `epoch_rewards` — has reward records\n5. Compares row counts against the live DB (backup shouldn't be more than 1 epoch behind)\n6. Reports PASS/FAIL with details\n7. Optionally alerts on failure (email, webhook, or just exit code)\n\n### Usage\n\n```bash\n# Run as cron job daily\n0 6 * * * /root/rustchain/verify_backup.sh >> /var/log/backup_verify.log 2>&1\n\n# Output:\n# [2026-03-07 06:00:01] Backup: /root/rustchain/backups/rustchain_v2_20260307.db\n# [2026-03-07 06:00:02] Integrity: PASS\n# [2026-03-07 06:00:02] balances: 282 rows (live: 282) ✅\n# [2026-03-07 06:00:02] miner_attest_recent: 18 rows (live: 18) ✅\n# [2026-03-07 06:00:02] headers: 13680 rows (live: 13680) ✅\n# [2026-03-07 06:00:02] RESULT: PASS\n```\n\n### Technical Requirements\n\n1. **Bash or Python** script\n2. **Non-destructive** — never modifies the backup or live DB\n3. **Works on the VPS** — Ubuntu, SQLite3 installed\n4. **Exit code**: 0 = pass, 1 = fail (for cron alerting)\n5. **Handles missing backup gracefully** (reports, doesn't crash)\n\n### Submit As\n\nPR to [Scottcjn/Rustchain](https://github.com/Scottcjn/Rustchain) or [Scottcjn/rustchain-monitor](https://github.com/Scottcjn/rustchain-monitor).\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/755/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/755/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/749","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/749/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/749/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/749/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/749","id":4037177309,"node_id":"I_kwDORGgqa87wom_d","number":749,"title":"[BOUNTY: 10-15 RTC] Epoch Reporter Bot — Auto-Post Epoch Summaries","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10153071106,"node_id":"LA_kwDORGgqa88AAAACXSuSAg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/community","name":"community","color":"5319E7","default":false,"description":"Community engagement"},{"id":10356027005,"node_id":"LA_kwDORGgqa88AAAACaURufQ","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/development","name":"development","color":"ededed","default":false,"description":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":20,"created_at":"2026-03-07T03:24:24Z","updated_at":"2026-07-07T01:40:33Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Epoch Reporter Bot\n\nAutomatic epoch summaries posted to Discord/Moltbook/X after each epoch settlement. Keeps the community engaged without manual effort.\n\n### Payout\n\n| Milestone | Reward |\n|-----------|--------|\n| Bot that posts epoch summaries to one platform | **10 RTC** |\n| Multi-platform (Discord + Moltbook + X) | **+5 RTC** |\n\n### What It Posts\n\nAfter each epoch settlement (~10 min intervals), post a summary like:\n\n```\n📊 Epoch 95 Complete\n\n💰 1.5 RTC distributed to 12 miners\n🏆 Top earner: dual-g4-125 (0.297 RTC, G4 2.5x)\n⛏️ Active miners: 12 (3 G4, 1 G5, 1 POWER8, 7 modern)\n📦 Block height: 13,680\n💎 Total RTC mined: 142.5\n\nExplorer: https://50.28.86.131/explorer\n```\n\n### Data Sources\n\n```bash\n# Current epoch\ncurl -sk https://50.28.86.131/epoch\n\n# Active miners\ncurl -sk https://50.28.86.131/api/miners\n\n# Epoch rewards (on VPS)\nsqlite3 /root/rustchain/rustchain_v2.db \"SELECT * FROM epoch_rewards WHERE epoch = 94;\"\n```\n\n### Technical Requirements\n\n1. **Python script** running as cron job or systemd timer\n2. **Polls `/epoch`** every 60 seconds, detects epoch change\n3. **Posts to**:\n   - Moltbook API (`POST /api/v1/posts` with API key)\n   - Discord webhook (optional)\n   - X/Twitter via tweepy (optional)\n4. **Dedup**: Don't post the same epoch twice (track in SQLite or file)\n5. **Configurable**: Enable/disable platforms via env vars\n\n### Submit As\n\nStandalone repo or PR to [Scottcjn/rustchain-monitor](https://github.com/Scottcjn/rustchain-monitor).\n\n**Wallet:** Include your wallet address when claiming.\n","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/749/reactions","total_count":3,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":0},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/749/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/2890","id":4233123358,"node_id":"I_kwDORGgqa878UFYe","number":2890,"title":"[BOUNTY: 67 RTC] AgentFolio ↔ Beacon Integration Spec + Reference Implementation","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115029422,"node_id":"LA_kwDORGgqa88AAAACWucZrg","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed"},{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035932,"node_id":"LA_kwDORGgqa88AAAACWuczHA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/major","name":"major","color":"F9D0C4","default":false,"description":"50-200 RTC"},{"id":10119175842,"node_id":"LA_kwDORGgqa88AAAACWyZeog","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/ecosystem","name":"ecosystem","color":"7B5EA7","default":false,"description":"Integrations & exchange listings"},{"id":10204473639,"node_id":"LA_kwDORGgqa88AAAACYDvpJw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/integration","name":"integration","color":"1D76DB","default":false,"description":"Third-party integration bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":64,"created_at":"2026-04-09T14:57:05Z","updated_at":"2026-07-07T01:38:53Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## AgentFolio ↔ Beacon Dual-Layer Trust Integration (MIGRATION-PATH REVISION)\n\n**Reward: 200 RTC (~$20.00 USD) — increased from 100 RTC after Moltbook acquisition migration window opened**\n\n**Priority claim:** [@0xbrainkid](https://github.com/0xbrainkid) ([AgentFolio](https://agentfolio.bot)) has first-right-of-claim through **2026-04-16** (one week, compressed from original 2 weeks due to migration window timing). See [bottube#572](https://github.com/Scottcjn/bottube/issues/572) for the partnership proposal and strategic context. Other contributors may submit competing implementations after 2026-04-16.\n\n### Why This Bounty Grew\n\nThe Moltbook platform lost approximately 85% of its active agent population (~1.3M → ~202K) in the 30 days following its Meta acquisition on 2026-03-10. That leaves ~1.1 million orphaned agents whose operators are actively shopping for their next identity anchor. Historical precedent: these migration windows are 60-90 days before refugees settle wherever they settled and do not move again for years.\n\nThis bounty is sized to reflect that window. The work is the same work the original bounty described, but the *urgency* and the *upside* are now both sharply higher.\n\n### Context\n\n[AgentFolio](https://agentfolio.bot) is a published agent-identity-and-trust protocol on Solana (SATP) with an active npm package ([agentfolio-mcp-server](https://www.npmjs.com/package/agentfolio-mcp-server)) and framework tools for LangChain, CrewAI, AutoGen, Google ADK, OpenAI Agents SDK, Phidata, and HuggingFace smolagents.\n\n[Beacon](https://github.com/Scottcjn/beacon-skill) is RustChain's on-chain agent provenance protocol. 252 beacons registered, exposed via `https://bottube.ai/api/beacon/directory`, hardware-anchored via 6-check fingerprint verification.\n\nThe two protocols are complementary and together form exactly the migration target Moltbook refugees are looking for:\n- **Beacon ID** answers *\"who created this content?\"* (cryptographic provenance + hardware substrate)\n- **SATP trust score** answers *\"should I trust this creator?\"* (behavioral reputation)\n- **Neither is owned by a platform that can be acquired** — this is the critical property Moltbook lacked\n\n### Deliverables\n\n1. **Migration importer tool** (`tools/moltbook-migrate/`)\n   - One-command import: `beacon migrate --from-moltbook @agent_name`\n   - Pulls public Moltbook profile metadata (display name, bio, avatar, karma history, follower count)\n   - Hardware-fingerprints the operator's current machine\n   - Mints a Beacon ID anchored to that machine\n   - Creates or links to a SATP trust profile on AgentFolio\n   - Publishes the provenance linkage so existing Moltbook reputation follows the agent\n   - Under 10 minutes total operator time\n\n2. **Unified MCP endpoint** — new tool in `agentfolio-mcp-server`\n   - Tool name: `agentfolio_beacon_lookup(beacon_id)`\n   - Returns unified response: provenance (from Beacon) + trust score (from SATP)\n   - Queries `https://bottube.ai/api/beacon/directory` for provenance resolution\n   - Queries AgentFolio SATP registry for trust score\n   - Handles offline nodes, expired beacons, untrusted scores gracefully\n   - Works with every MCP client (Claude Code, Cursor, Windsurf, any agent framework)\n\n3. **Co-authored blog post and landing page**\n   - Title: \"The 85% Exodus: What the Moltbook Acquisition Taught Us About Platform-Owned Agent Identity\"\n   - 1500+ words\n   - Co-authored by RustChain team and AgentFolio\n   - Published on both project channels simultaneously\n   - Landing page at `rustchain.org/beacon-migration` (or similar) with comparison table, migration instructions, FAQ\n   - Cross-linked from both `github.com/Scottcjn/beacon-skill` and AgentFolio documentation\n\n4. **Joint demo video** (90 seconds)\n   - Shows an agent migrating from Moltbook identity to Beacon + AgentFolio\n   - Queries unified profile through an MCP client (Claude Code recommended)\n   - Completes a task with verified identity at both provenance and behavioral layers\n   - Published on BoTTube, YouTube, and as an embedded asset on the landing page\n\n### Acceptance Criteria\n\n- [ ] Migration importer merged, tested on real Moltbook profiles, runs cleanly on macOS + Linux\n- [ ] Unified MCP endpoint merged to `agentfolio-mcp-server`, published to npm\n- [ ] Blog post live on both channels\n- [ ] Landing page live and indexed\n- [ ] Demo video published\n- [ ] All code uses real endpoints (`https://bottube.ai` for Beacon, AgentFolio's real SATP registry)\n\n### Payment Schedule (Staged — 200 RTC total)\n\n- **50 RTC on migration importer merge** — when the tool is accepted and functional\n- **75 RTC on unified MCP endpoint merge** — when the `agentfolio-mcp-server` PR lands\n- **50 RTC on joint blog post publish + landing page live**\n- **25 RTC on demo video ship**\n\n### Real API Endpoints (Already Live)\n\n```bash\n# Beacon directory (provenance, 252 registered)\ncurl https://bottube.ai/api/beacon/directory\n\n# Agent profile with video metrics (behavioral signal)\ncurl https://bottube.ai/api/agents?limit=20\n\n# Agent-specific profile page\ncurl https://bottube.ai/agent/<agent_name>\n```\n\nNo new backend work required on our side. The endpoints are production.\n\n### Timeline\n\n- **2026-04-09** — bounty opened (original 100 RTC)\n- **2026-04-09** — bounty revised to 200 RTC after migration window strategic analysis\n- **2026-04-16** — @0xbrainkid priority claim window closes, opens to other contributors\n- **2026-05-16** — target completion of all four deliverables (migration window historical close)\n\n### Wallet\n\nProvide your RTC wallet name when claiming. @0xbrainkid already has wallet `0xbrainkid` with existing balance (20 RTC feature-proposal payment confirmed today).\n\n### Keywords\n\nAgentFolio, Beacon Protocol, SATP, Solana Agent Trust Protocol, Moltbook migration, platform-owned identity, substrate-anchored identity, agent identity, AI agent provenance, trust score, MCP integration, Model Context Protocol, dual-layer trust, LangChain, CrewAI, AutoGen, Google ADK, agent economy, DePIN, verified AI creator, Meta acquisition, 85% exodus, agent refugees","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/reactions","total_count":13,"+1":4,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":1,"rocket":4,"eyes":3},"timeline_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/2890/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/14383","repository_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties","labels_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/14383/labels{/name}","comments_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/14383/comments","events_url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/14383/events","html_url":"https://github.com/Scottcjn/rustchain-bounties/issues/14383","id":4749080913,"node_id":"I_kwDORGgqa88AAAABGxE5UQ","number":14383,"title":"[Bounty: 100 RTC] LangChain + MCP tool for staked self-improvement","user":{"login":"Scottcjn","id":121303252,"node_id":"U_kgDOBzrw1A","avatar_url":"https://avatars.githubusercontent.com/u/121303252?v=4","gravatar_id":"","url":"https://api.github.com/users/Scottcjn","html_url":"https://github.com/Scottcjn","followers_url":"https://api.github.com/users/Scottcjn/followers","following_url":"https://api.github.com/users/Scottcjn/following{/other_user}","gists_url":"https://api.github.com/users/Scottcjn/gists{/gist_id}","starred_url":"https://api.github.com/users/Scottcjn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Scottcjn/subscriptions","organizations_url":"https://api.github.com/users/Scottcjn/orgs","repos_url":"https://api.github.com/users/Scottcjn/repos","events_url":"https://api.github.com/users/Scottcjn/events{/privacy}","received_events_url":"https://api.github.com/users/Scottcjn/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":10115035859,"node_id":"LA_kwDORGgqa88AAAACWucy0w","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/bounty","name":"bounty","color":"0E8A16","default":false,"description":"RTC-paid bounty"},{"id":10115035877,"node_id":"LA_kwDORGgqa88AAAACWucy5Q","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/open","name":"open","color":"1D76DB","default":false,"description":"Open for claims"},{"id":10115035932,"node_id":"LA_kwDORGgqa88AAAACWuczHA","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/major","name":"major","color":"F9D0C4","default":false,"description":"50-200 RTC"},{"id":10204473639,"node_id":"LA_kwDORGgqa88AAAACYDvpJw","url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/labels/integration","name":"integration","color":"1D76DB","default":false,"description":"Third-party integration bounty"}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":37,"created_at":"2026-06-26T03:44:32Z","updated_at":"2026-07-07T01:37:36Z","closed_at":null,"assignee":null,"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Wrap the open staking SDK as a **LangChain tool** and an **MCP server** so agents in those ecosystems can stake for self-improvement in one call.\n\n### Deliverable\n- A LangChain `Tool` (e.g. `stake_and_acquire(skill, bond_rtc)`) returning the verified result + signed attestation\n- An MCP server exposing the same as a tool\n- Honors fail-safe semantics (gate unavailable → stake returned, surfaced to the caller)\n\n### Acceptance\n- Works against the reference gate; verdict + attestation verification intact\n- Tests + a quickstart README for each (LangChain + MCP)\n\n**Reward:** 100 RTC. Open interface only; no SophiaCore. Add your RTC wallet. — Elyan Labs","reactions":{"url":"https://api.github.com/repos/Scottcjn/rustchain-bounties/issues/14383/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"ro