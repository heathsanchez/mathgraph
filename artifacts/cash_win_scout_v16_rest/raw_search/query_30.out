github.com/users/truph01/following{/other_user}","gists_url":"https://api.github.com/users/truph01/gists{/gist_id}","starred_url":"https://api.github.com/users/truph01/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/truph01/subscriptions","organizations_url":"https://api.github.com/users/truph01/orgs","repos_url":"https://api.github.com/users/truph01/repos","events_url":"https://api.github.com/users/truph01/events{/privacy}","received_events_url":"https://api.github.com/users/truph01/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":63,"created_at":"2026-04-17T20:52:00Z","updated_at":"2026-07-06T21:54:03Z","closed_at":null,"assignee":{"login":"joekaufmanexpensify","id":54866469,"node_id":"MDQ6VXNlcjU0ODY2NDY5","avatar_url":"https://avatars.githubusercontent.com/u/54866469?v=4","gravatar_id":"","url":"https://api.github.com/users/joekaufmanexpensify","html_url":"https://github.com/joekaufmanexpensify","followers_url":"https://api.github.com/users/joekaufmanexpensify/followers","following_url":"https://api.github.com/users/joekaufmanexpensify/following{/other_user}","gists_url":"https://api.github.com/users/joekaufmanexpensify/gists{/gist_id}","starred_url":"https://api.github.com/users/joekaufmanexpensify/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joekaufmanexpensify/subscriptions","organizations_url":"https://api.github.com/users/joekaufmanexpensify/orgs","repos_url":"https://api.github.com/users/joekaufmanexpensify/repos","events_url":"https://api.github.com/users/joekaufmanexpensify/events{/privacy}","received_events_url":"https://api.github.com/users/joekaufmanexpensify/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"@JmillsExpensify and I have been discussing ways to improve the broken card connection experience. We realized recently that many customers leave broken connections indefinitely. We suspect this means they aren't aware that removing a card with a broken connection is a valid resolution path when it's no longer in use, expired, etc. \n\nWe already immediately send a concierge message in the #admins room when a company card connection breaks OR in the concierge DM when a personal card connection breaks. Now, we'd like to add an additional message sent in the same respective place for company cards and personal cards if the connection remains broken for 30+ days. \n\n### Broken company cards message \n\n- Concierge message sent in #admins room 30 days after company card feed connection breaks. \n- Draft copy: \n>The %feed name% connection has been broken for 30 days. [Log into your bank](link to workspace company cards page) to fix it or [remove the connection](link to workspace company cards settings page) if it's no longer in use. You won't lose any submitted expenses if you remove it.\n\n### Broken personal card message\n\n- Concierge message sent in concierge DM 30 days after personal card connection breaks.\n- Draft copy: \n>Your %bank - card number% connection has been broken for 30 days. [Log into your bank](link to personal card details) to fix it or [remove the card](link to personal card details) if it's no longer in use. You won't lose any submitted expenses if you remove it.\n\n<details><summary>Issue Owner</summary>Current Issue Owner: @allgandalf</details>\n<details><summary>Upwork Automation - Do Not Edit</summary>\n    <ul>\n        <li>Upwork Job URL: https://www.upwork.com/jobs/~022045243944603273641</li>\n        <li>Upwork Job ID: 2045243944603273641</li>\n        <li>Last Price Increase: 2026-05-22</li>\n    </ul>\n</details>","reactions":{"url":"https://api.github.com/repos/Expensify/A